+    /** Fails each queued command at the callback belonging to that command. */
+    private void handleConnectionFailure(int error) {
+        mConnecting = false;
+        // Retire the failed queue before running app callbacks, which can retry synchronously.
+        Queue<Message> failed = new java.util.ArrayDeque<>();
+        Message message;
+        while ((message = mPendingTasks.poll()) != null) failed.offer(message);
+        while ((message = failed.poll()) != null) {
+            try {
+                switch (message.what) {
+                    case MSG_START -> mListener.onError(error);
+                    case MSG_CHANGE_LISTENER -> handleChangeListener((RecognitionListener) message.obj);
+                    case MSG_CHECK_RECOGNITION_SUPPORT -> {
+                        CheckRecognitionSupportArgs args = (CheckRecognitionSupportArgs) message.obj;
+                        args.mCallbackExecutor.execute(() -> args.mCallback.onError(error));
+                    }
+                    case MSG_TRIGGER_MODEL_DOWNLOAD -> {
+                        ModelDownloadListenerArgs args = (ModelDownloadListenerArgs) message.obj;
+                        if (args.mModelDownloadListener == null) mListener.onError(error);
+                        else args.mExecutor.execute(() -> args.mModelDownloadListener.onError(error));
+                    }
+                    default -> { }
+                }
+            } catch (RuntimeException failure) {
+                Log.w(TAG, "Recognition connection failure callback rejected", failure);
+            } finally {
+                message.recycle();
+            }
         }
     }

