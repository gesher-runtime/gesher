     private void putMessage(Message msg) {
-        if (mService == null) {
-            mPendingTasks.offer(msg);
-        } else {
+        if (Looper.myLooper() != mHandler.getLooper()) {
+            mHandler.post(() -> putMessage(msg));
+            return;
+        }
+        if (msg.what == MSG_DESTROY && mConnecting) {
+            handleDestroy();
+            msg.recycle();
+            return;
+        }
+        if (mService != null) {
             mHandler.sendMessage(msg);
+            return;
+        }
+        if (mConnecting) {
+            if (msg.what == MSG_CANCEL) {
+                mPendingTasks.removeIf(pending -> {
+                    if (pending.what != MSG_START && pending.what != MSG_STOP) return false;
+                    pending.recycle();
+                    return true;
+                });
+                msg.recycle();
+            } else {
+                mPendingTasks.offer(msg);
+            }
+            return;
+        }
+        switch (msg.what) {
+            case MSG_START, MSG_CHECK_RECOGNITION_SUPPORT, MSG_TRIGGER_MODEL_DOWNLOAD -> {
+                mPendingTasks.offer(msg);
+                connectToSystemService();
+            }
+            case MSG_CANCEL -> msg.recycle();
+            default -> mHandler.sendMessage(msg);
         }
     }

