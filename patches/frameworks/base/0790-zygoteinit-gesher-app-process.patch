+    /**
+     * Gesher: the child's part of an app process (ZygoteConnection.handleChildProc), in a
+     * process the device's zygote started. The device's own setup and the child's
+     * specialization (android.app.GesherAppProcess.specializeChild, on the boot class path
+     * after this framework) return the command, its target SDK first; then, as
+     * ZygoteInit.zygoteInit does, RuntimeInit's application init gives the caller of its
+     * main.
+     */
+    private static Runnable gesherAppProcessInit(String[] argv) {
+        final String[] command;
+        try {
+            command = (String[]) Class.forName("android.app.GesherAppProcess")
+                    .getMethod("specializeChild", String[].class)
+                    .invoke(null, (Object) argv);
+        } catch (java.lang.reflect.InvocationTargetException ex) {
+            Throwable cause = ex.getCause();
+            if (cause instanceof RuntimeException) throw (RuntimeException) cause;
+            if (cause instanceof Error) throw (Error) cause;
+            throw new RuntimeException(cause);
+        } catch (ReflectiveOperationException ex) {
+            throw new RuntimeException("Gesher app process setup not found", ex);
+        }
+        String[] startArgs = new String[command.length - 1];
+        System.arraycopy(command, 1, startArgs, 0, startArgs.length);
+        return RuntimeInit.applicationInit(Integer.parseInt(command[0]),
+                /* disabledCompatChanges */ null, startArgs, /* classLoader */ null);
+    }
