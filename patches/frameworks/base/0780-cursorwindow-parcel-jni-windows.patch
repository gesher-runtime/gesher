From: Gesher Authors
Subject: [PATCH] Register CursorWindow Parcel JNI on Gesher

Gesher builds libbinder's Parcel and androidfw's CursorWindow parcel support,
but the Java natives were still excluded by their Linux-only guards. Enable
the matching JNI includes, implementations and registrations without changing
the Android parcel format or cursor ownership semantics.

diff --git a/core/jni/android_database_CursorWindow.cpp b/core/jni/android_database_CursorWindow.cpp
--- a/core/jni/android_database_CursorWindow.cpp
+++ b/core/jni/android_database_CursorWindow.cpp
@@ -38,7 +38,7 @@
 #define LOG_NDEBUG 1
 
 #include <androidfw/CursorWindow.h>
-#ifdef __linux__
+#if defined(__linux__) || defined(GESHER)
 #include "android_os_Parcel.h"
 #include "android_util_Binder.h"
 #endif
@@ -121,7 +121,7 @@ static void nativeDispose(JNIEnv* env, jclass clazz, jlong windowPtr) {
     }
 }
 
-#ifdef __linux__
+#if defined(__linux__) || defined(GESHER)
 static jlong nativeCreateFromParcel(JNIEnv* env, jclass clazz, jobject parcelObj) {
     Parcel* parcel = parcelForJavaObject(env, parcelObj);
 
@@ -525,7 +525,7 @@ static const JNINativeMethod sMethods[] = {
         /* name, signature, funcPtr */
         {"nativeCreate", "(Ljava/lang/String;I)J", GESHER_JNI(nativeCreate)},
         {"nativeDispose", "(J)V", GESHER_JNI(nativeDispose)},
-#ifdef __linux__
+#if defined(__linux__) || defined(GESHER)
         {"nativeCreateFromParcel", "(Landroid/os/Parcel;)J", GESHER_JNI(nativeCreateFromParcel)},
         {"nativeWriteToParcel", "(JLandroid/os/Parcel;)V", GESHER_JNI(nativeWriteToParcel)},
 #endif
