+#ifdef GESHER
+// Gesher: a buffer per frame, dequeued in getFrame (and here) and queued in
+// swapBuffers, as with a swap chain, so the window presents each frame.
+bool SkiaCpuPipeline::setSurface(ANativeWindow* surface, SwapBehavior swapBehavior) {
+    if (mWindow != nullptr && mBuffer != nullptr) {
+        mWindow->cancelBuffer(mWindow, mBuffer, -1);
+    }
+    mWindow = surface;
+    mBuffer = nullptr;
+    mPixels = nullptr;
+    mSurface = sk_sp<SkSurface>();
+    if (surface != nullptr) {
+        dequeueBuffer();
+    }
+    return true;
+}
+
+bool SkiaCpuPipeline::dequeueBuffer() {
+    ANativeWindowBuffer* buffer = nullptr;
+    if (mWindow->dequeueBuffer(mWindow, &buffer, nullptr) != 0 || buffer == nullptr) {
+        return false;
+    }
+    const int width = buffer->width;
+    const int height = buffer->height;
+    void* pixels = buffer->reserved[0];
+    if (mSurface.get() == nullptr || mSurface->width() != width || mSurface->height() != height ||
+        mPixels != pixels) {
+        SkImageInfo imageInfo =
+                SkImageInfo::Make(width, height, mSurfaceColorType,
+                                  SkAlphaType::kPremul_SkAlphaType, mSurfaceColorSpace);
+        size_t rowBytes = (buffer->stride > 0 ? buffer->stride : width) * imageInfo.bytesPerPixel();
+        mSurface = SkSurfaces::WrapPixels(imageInfo, pixels, rowBytes);
+        mPixels = pixels;
+    }
+    mBuffer = buffer;
+    return true;
+}
+
+bool SkiaCpuPipeline::swapBuffers(const Frame& frame, IRenderPipeline::DrawResult& drawResult,
+                                  const SkRect& screenDirty, FrameInfo* currentFrameInfo,
+                                  bool* requireSwap) {
+    if (mWindow == nullptr || mBuffer == nullptr) {
+        return false;
+    }
+    int err = mWindow->queueBuffer(mWindow, mBuffer, -1);
+    mBuffer = nullptr;
+    *requireSwap = true;
+    return err == 0;
+}
+#else
 bool SkiaCpuPipeline::setSurface(ANativeWindow* surface, SwapBehavior swapBehavior) {
     if (surface) {
         ANativeWindowBuffer* buffer;
@@ -126,6 +181,7 @@ bool SkiaCpuPipeline::setSurface(ANativeWindow* surface, SwapBehavior swapBehavi
     }
     return true;
 }
+#endif
 
