diff --git a/cpu_ref/rsCpuScript.cpp b/cpu_ref/rsCpuScript.cpp
index a495246..6f5b392 100644
--- a/cpu_ref/rsCpuScript.cpp
+++ b/cpu_ref/rsCpuScript.cpp
@@ -422,6 +422,16 @@ bool RsdCpuScriptImpl::init(char const *resName, char const *cacheDir,
 
     mBitcodeFilePath.assign(bcFileName.c_str());
 
+#elif defined(GESHER)
+    // Gesher: a script's kernels are compiled bitcode (bcc, libclcore), which
+    // Gesher does not have, and the compatibility library's precompiled
+    // librs.<name>.so is an Android ELF object a Windows process does not call
+    // into. The script is not created: ScriptC reports "Loading of ScriptC
+    // script failed." as Android does for a script that does not load
+    // (docs/renderscript.md).
+    ALOGE("ScriptC %s: Gesher has no RenderScript bitcode compiler; the script is not loaded",
+          resName);
+    goto error;
 #else  // RS_COMPATIBILITY_LIB is defined
     const char *nativeLibDir = mCtx->getContext()->getNativeLibDir();
     mScriptSO = SharedLibraryUtils::loadSharedLibrary(cacheDir, resName, nativeLibDir);
