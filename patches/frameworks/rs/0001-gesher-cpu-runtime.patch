+                      "USAGE_IO_INPUT and USAGE_IO_OUTPUT are not supported by this driver");
+        return nullptr;
+    }
+#endif
     // Allocation objects must use allocator specified by the driver
     void* allocMem = rsc->mHal.funcs.allocRuntimeMem(sizeof(Allocation), 0);
 
