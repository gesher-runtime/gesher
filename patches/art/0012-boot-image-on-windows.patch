+#if defined(GESHER)
+// Gesher: boot images are compiled with bare file names as dex locations
+// (`--dex-location=core-oj.jar`), as where Gesher is installed is not known at
+// compile time, and OatFileBase::Setup gives the dex files their actual paths.
+// An oat file's boot class path of bare names therefore matches the runtime's
+// boot class path locations by file name.
+static std::vector<std::string> GesherBcpLocationsAsCompiled(
+    std::string_view oat_boot_class_path, ArrayRef<const std::string> locations) {
+  std::vector<std::string> result(locations.begin(), locations.end());
+  if (oat_boot_class_path.find('/') == std::string_view::npos) {
+    for (std::string& location : result) {
+      size_t slash_pos = location.rfind('/');
+      if (slash_pos != std::string::npos) {
+        location.erase(0u, slash_pos + 1u);
+      }
+    }
+  }
+  return result;
+}
