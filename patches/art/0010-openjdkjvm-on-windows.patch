 JNIEXPORT int JVM_GetHostName(char* name, int namelen) {
+#if defined(GESHER)
+  // Gesher: gethostname clashes with Winsock's; see gesher-base's <unistd.h>.
+  return TEMP_FAILURE_RETRY(gesher_gethostname(name, namelen));
+#else
   return TEMP_FAILURE_RETRY(gethostname(name, namelen));
+#endif
 }
 
