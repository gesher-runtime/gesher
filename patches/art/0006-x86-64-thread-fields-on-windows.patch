--- a/runtime/arch/x86_64/asm_support_x86_64.S
+++ b/runtime/arch/x86_64/asm_support_x86_64.S
@@ -291,6 +291,76 @@ MACRO1(LOAD_THREAD_SELF, reg)
 #endif
 END_MACRO
 
+// Gesher: one instruction that reads or writes a Thread field, with no
+// register to spare. r11 is saved on the stack, holds Thread* for that
+// instruction and is restored; push/pop/mov leave the flags alone, so a
+// following conditional jump sees the instruction's result. Operands must
+// not be r11 or rsp-relative. (CFI is not adjusted for these three
+// instructions.)
+//   THREAD_SRC op, offset, dst   ==  op %gs:offset, dst
+//   THREAD_DST op, src, offset   ==  op src, %gs:offset
+MACRO3(THREAD_SRC, op, offset, dst)
+#if defined(GESHER)
+    pushq %r11
+    LOAD_THREAD_SELF r11
+    \op \offset(%r11), \dst
+    popq %r11
+#else
+    \op %gs:\offset, \dst
+#endif
+END_MACRO
+
+MACRO3(THREAD_DST, op, src, offset)
+#if defined(GESHER)
+    pushq %r11
+    LOAD_THREAD_SELF r11
+    \op \src, \offset(%r11)
+    popq %r11
+#else
+    \op \src, %gs:\offset
+#endif
+END_MACRO
+
+// Thread field := rsp (the value at this point), all registers and flags kept.
+MACRO1(STORE_RSP_TO_THREAD, offset)
+#if defined(GESHER)
+    pushq %r11
+    pushq %r10
+    LOAD_THREAD_SELF r11
+    leaq 16(%rsp), %r10
+    movq %r10, \offset(%r11)
+    popq %r10
+    popq %r11
+#else
+    movq %rsp, %gs:\offset
+#endif
+END_MACRO
+
+// pushq %gs:offset, all registers and flags kept.
+MACRO1(PUSH_THREAD_FIELD, offset)
+#if defined(GESHER)
+    leaq -8(%rsp), %rsp
+    pushq %r11
+    LOAD_THREAD_SELF r11
+    movq \offset(%r11), %r11
+    movq %r11, 8(%rsp)
+    popq %r11
+#else
+    pushq %gs:\offset
+#endif
+END_MACRO
+
+// call *%gs:offset. r11 is caller-saved and not an argument register, so
+// it is free at a call.
+MACRO1(CALL_THREAD_FIELD, offset)
+#if defined(GESHER)
+    LOAD_THREAD_SELF r11
+    call *\offset(%r11)
+#else
+    call *%gs:\offset
+#endif
+END_MACRO
+
 // reg := Thread::Current()->field (64-bit), clobbering only reg.
 MACRO2(LOAD_THREAD_FIELD, offset, reg)
 #if defined(GESHER)
