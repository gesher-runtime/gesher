+#if defined(GESHER)
+// Gesher (docs/compiled-code.md, ADR 0054): System.exit ends the process
+// without the runtime's shutdown (FastExit), as on Android, where the
+// profile saver's last save is the one before. Gesher's app processes end
+// with System.exit as soon as the system server tells them to, often before
+// a periodic save: the JIT profile is saved first, as the signal catcher does
+// on SIGUSR1. With GESHER_LOG_EXECUTION the runtime then says how the app's
+// own methods (those of non-boot class loaders) ran: with their AOT code, or
+// entering the interpreter (nterp, the switch interpreter) or the JIT.
+static void GesherBeforeExit(Runtime* runtime) {
+  Thread* self = Thread::Current();
+  if (self == nullptr) {
+    return;
+  }
+  const bool log = getenv("GESHER_LOG_EXECUTION") != nullptr;
+  ScopedThreadStateChange tsc(self, ThreadState::kNative);
+  if (runtime->GetJit() != nullptr && ProfileSaver::IsStarted()) {
+    ProfileSaver::ForceProcessProfiles();
+    if (log) {
+      LOG(INFO) << "gesher: JIT profile saved at exit";
+    }
+  }
+  if (!log) {
+    return;
+  }
+  ScopedObjectAccess soa(self);
+  ClassLinker* class_linker = runtime->GetClassLinker();
+  const PointerSize pointer_size = class_linker->GetImagePointerSize();
+  const uint16_t threshold = runtime->GetJITOptions()->GetWarmupThreshold();
+  jit::Jit* jit = runtime->GetJit();
+  size_t classes = 0u, methods = 0u, with_aot = 0u, interpreted = 0u, interpreted_with_aot = 0u;
+  class GesherClassVisitor : public ClassVisitor {
+   public:
+    explicit GesherClassVisitor(std::function<void(ObjPtr<mirror::Class>)> f) : f_(std::move(f)) {}
+    bool operator()(ObjPtr<mirror::Class> klass) override REQUIRES_SHARED(Locks::mutator_lock_) {
+      f_(klass);
+      return true;
+    }
+   private:
+    std::function<void(ObjPtr<mirror::Class>)> f_;
+  };
+  GesherClassVisitor visitor([&](ObjPtr<mirror::Class> klass)
+                                 NO_THREAD_SAFETY_ANALYSIS {
+    if (klass->GetClassLoader() == nullptr || !klass->IsResolved() || klass->IsProxyClass() ||
+        klass->IsArrayClass() || klass->IsPrimitive()) {
+      return;
+    }
+    ++classes;
+    for (ArtMethod& m : klass->GetDeclaredMethods(pointer_size)) {
+      if (m.IsAbstract() || m.IsNative() || !m.HasCodeItem()) {
+        continue;
+      }
+      ++methods;
+      const void* entry = m.GetEntryPointFromQuickCompiledCode();
+      const void* aot = m.GetOatMethodQuickCode(pointer_size);
+      bool jitted = jit != nullptr && jit->GetCodeCache()->ContainsPc(entry);
+      bool ran_interpreted = m.CounterHasChanged(threshold) || jitted;
+      if (aot != nullptr) {
+        ++with_aot;
+      }
+      if (ran_interpreted) {
+        ++interpreted;
+        if (aot != nullptr) {
+          ++interpreted_with_aot;
+        }
+      }
+    }
+  });
+  class_linker->VisitClasses(&visitor);
+  LOG(INFO) << "gesher: app methods at exit: " << classes << " classes, " << methods
+            << " methods, " << with_aot << " with AOT code, " << interpreted
+            << " entered the interpreter or the JIT (" << interpreted_with_aot
+            << " of them with AOT code)";
+}
+#endif  // GESHER
