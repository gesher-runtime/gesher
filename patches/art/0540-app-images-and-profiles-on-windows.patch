+// Gesher (ADR 0054): flock as Windows' byte-range lock of the whole file
+// (LockFileEx on the descriptor's handle), for the JIT's profile saver and
+// profman. The lock goes with the handle, when the file is closed. Windows'
+// locks are mandatory, not advisory: every user of a profile takes the lock
+// before it reads or writes, as ART's do.
+static bool GesherLock(int fd, bool block, std::string* error_msg, const std::string& name) {
+  HANDLE h = reinterpret_cast<HANDLE>(_get_osfhandle(fd));
+  if (h == INVALID_HANDLE_VALUE) {
+    *error_msg = StringPrintf("Failed to lock file '%s': bad descriptor", name.c_str());
+    return false;
+  }
+  OVERLAPPED overlapped = {};
+  DWORD flags = LOCKFILE_EXCLUSIVE_LOCK | (block ? 0 : LOCKFILE_FAIL_IMMEDIATELY);
+  if (!LockFileEx(h, flags, 0, MAXDWORD, MAXDWORD, &overlapped)) {
+    DWORD error = GetLastError();
+    *error_msg = StringPrintf("Failed to lock file '%s': Win32 error %lu", name.c_str(),
+                              static_cast<unsigned long>(error));
+    errno = (error == ERROR_LOCK_VIOLATION || error == ERROR_IO_PENDING) ? EWOULDBLOCK : EIO;
+    return false;
+  }
+  return true;
+}
+#endif
