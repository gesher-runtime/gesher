+#if defined(GESHER)
+// Gesher (docs/posix.md, ADR 0057): is any prefix of `path` a symbolic link?
+// realpath on Windows also normalizes the case of names and 8.3 short names,
+// which must not change the locations of ordinary dex files (oat and boot
+// image matching), so only a location with a link in it is resolved.
+static bool HasSymbolicLinkComponent(const std::string& path) {
+  for (size_t i = 1; i <= path.size(); ++i) {
+    if (i < path.size() && path[i] != '/') continue;
+    struct stat st;
+    if (lstat(path.substr(0, i).c_str(), &st) == 0 && S_ISLNK(st.st_mode)) return true;
+  }
+  return false;
+}
+#endif
