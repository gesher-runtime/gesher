+// assembly, which uses the System V AMD64 ABI. That is the platform ABI
+// everywhere except Windows, where Gesher has to ask for it.
+#if defined(GESHER)
+#define ART_SYSV_ABI __attribute__((sysv_abi))
+#else
+#define ART_SYSV_ABI
+#endif
