+#if defined(GESHER)
+void X86_64Assembler::GesherLoadThreadSelf(CpuRegister reg) {
+  gs()->movq(reg, Address::Absolute(kGesherThreadSelfTebOffset, /* no_rip= */ true));
+}
+
+Address X86_64Assembler::GesherThreadAddress(CpuRegister base, int32_t offset) {
+  GesherLoadThreadSelf(base);
+  return Address(base, offset);
+}
+
+void X86_64Assembler::GesherSaveRax() {
+  // LEA and MOV leave the flags alone; managed code keeps nothing below rsp.
+  leaq(CpuRegister(RSP), Address(CpuRegister(RSP), -16));
+  cfi().AdjustCFAOffset(16);
+  movq(Address(CpuRegister(RSP), 8), CpuRegister(RAX));
+  GesherLoadThreadSelf(CpuRegister(RAX));
+}
+
+void X86_64Assembler::GesherRestoreRax() {
+  movq(CpuRegister(RAX), Address(CpuRegister(RSP), 8));
+  leaq(CpuRegister(RSP), Address(CpuRegister(RSP), 16));
+  cfi().AdjustCFAOffset(-16);
+}
+
+void X86_64Assembler::GesherCallThreadPreservingRegisters(int32_t offset) {
+  // [rsp + 8] = RAX, [rsp] = the entrypoint; 16 bytes keep the alignment.
+  GesherSaveRax();
+  movq(CpuRegister(RAX), Address(CpuRegister(RAX), offset));
+  movq(Address(CpuRegister(RSP), 0), CpuRegister(RAX));
+  movq(CpuRegister(RAX), Address(CpuRegister(RSP), 8));
+  call(Address(CpuRegister(RSP), 0));
+  leaq(CpuRegister(RSP), Address(CpuRegister(RSP), 16));
+  cfi().AdjustCFAOffset(-16);
+}
+#endif  // GESHER
