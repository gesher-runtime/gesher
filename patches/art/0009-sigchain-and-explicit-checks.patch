+#if defined(GESHER)
+// Statically linked: gesher-base's implementations, which this file's
+// sigaction() and sigprocmask() replace, are reachable under other names.
+template <typename T>
+static void lookup_libc_symbol(T* output, [[maybe_unused]] T wrapper, const char* name) {
+  void* sym = nullptr;
+  if (strcmp(name, "sigaction") == 0) {
+    sym = reinterpret_cast<void*>(&gesher_sigaction_raw);
+  } else if (strcmp(name, "sigprocmask") == 0) {
+    sym = reinterpret_cast<void*>(&gesher_sigprocmask_raw);
+  } else {
+    fatal("Unable to find next %s in signal chain", name);
+  }
+  *output = reinterpret_cast<T>(sym);
+}
