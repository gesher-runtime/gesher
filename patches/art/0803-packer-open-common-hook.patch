+                                                                     base,
+                                                                     app_compat_size,
+                                                                     *location,
+                                                                     checksum,
+                                                                     oat_dex_file,
+                                                                     (verify & 0xff) != 0,
+                                                                     (verify_checksum & 0xff) != 0,
+                                                                     error_msg,
+                                                                     error_code));
+  --gesher_open_common_original;
+}
