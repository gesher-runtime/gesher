+// ClassLinker::LoadClass hook then fills in their method bodies. ART is not
+// libart.so and libdexfile.so here: compat/bionic/jni_bridge.cc loads stand-ins
+// for such an app (only then) and sets this to a System V entry into the
+// stand-in libdexfile.so (ADR 0086). The entry receives the result's storage
+// first, then this function's arguments: the shared_ptr and the string by
+// reference, the optional by value. The stand-in's own OpenCommon, unless the
+// packer replaced it, calls gesher_art_dex_file_loader_open_common below,
+// which runs this function as it is. Null otherwise.
+extern "C" std::atomic<void*> gesher_art_open_common_hook;
+std::atomic<void*> gesher_art_open_common_hook{nullptr};
+namespace {
+thread_local int gesher_open_common_original = 0;
+using GesherOpenCommonHook = void(ART_SYSV_ABI*)(std::unique_ptr<DexFile>* result,
+                                                 std::shared_ptr<DexFileContainer>* container,
+                                                 const uint8_t* base,
+                                                 size_t app_compat_size,
+                                                 const std::string* location,
+                                                 uint64_t location_checksum,
+                                                 const OatDexFile* oat_dex_file,
+                                                 uint64_t verify,
+                                                 uint64_t verify_checksum,
+                                                 std::string* error_msg,
+                                                 DexFileLoaderErrorCode* error_code);
+static_assert(sizeof(std::optional<uint32_t>) == sizeof(uint64_t));
+// OpenCommon is protected; the stand-in's call reaches it as a subclass would.
+struct GesherOpenCommon : DexFileLoader {
+  using DexFileLoader::OpenCommon;
+};
+}  // namespace
+
+// The function itself, for the stand-in's OpenCommon: constructs the result in
+// `result`, consuming `container` as a by-value argument is.
+extern "C" ART_SYSV_ABI void gesher_art_dex_file_loader_open_common(
+    std::unique_ptr<DexFile>* result,
