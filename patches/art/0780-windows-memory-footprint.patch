--- a/libartbase/base/mem_map.h
+++ b/libartbase/base/mem_map.h
@@ -47,7 +47,15 @@ namespace art {
 static constexpr bool kMadviseZeroes = true;
 #define HAVE_MREMAP_SYSCALL true
 #else
+#if defined(GESHER)
+// Gesher: gesher-base's madvise(MADV_DONTNEED) gives private anonymous pages
+// back and they read as zeros, as on Linux. Without it every release of GC
+// memory (bitmaps, card table, freed large objects, ...) was a memset that
+// kept all of those pages in the working set.
+static constexpr bool kMadviseZeroes = true;
+#else
 static constexpr bool kMadviseZeroes = false;
+#endif
 // We cannot ever perform MemMap::ReplaceWith on non-linux hosts since the syscall is not
 // present.
