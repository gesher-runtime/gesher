+#endif
+END_MACRO
+
+// Load the current Thread*. On Windows gs is the TEB, so Gesher keeps Thread*
+// in a TLS slot whose TEB offset is in gesher_thread_self_slot.
+MACRO1(LOAD_THREAD_SELF, reg)
+#if defined(GESHER)
+    movq SYMBOL(gesher_thread_self_slot)(%rip), REG_VAR(reg)
+    movq %gs:(REG_VAR(reg)), REG_VAR(reg)
+#else
+    movq %gs:THREAD_SELF_OFFSET, REG_VAR(reg)
+#endif
+END_MACRO
+
+// reg := Thread::Current()->field (64-bit), clobbering only reg.
+MACRO2(LOAD_THREAD_FIELD, offset, reg)
+#if defined(GESHER)
+    LOAD_THREAD_SELF \reg
+    movq \offset(REG_VAR(reg)), REG_VAR(reg)
+#else
+    movq %gs:\offset, REG_VAR(reg)
+#endif
+END_MACRO
+
+// reg32 := Thread::Current()->tls32_.thin_lock_thread_id, clobbering only the
+// 64-bit register containing reg32.
+MACRO1(LOAD_THREAD_ID, reg32)
+#if defined(GESHER)
+    .ifc \reg32, ecx
+        LOAD_THREAD_SELF rcx
+        movl THREAD_ID_OFFSET(%rcx), %ecx
+    .else
+    .ifc \reg32, ebp
+        LOAD_THREAD_SELF rbp
+        movl THREAD_ID_OFFSET(%rbp), %ebp
+    .else
+        .error "LOAD_THREAD_ID: unsupported register"
+    .endif
+    .endif
+#else
+    movl %gs:THREAD_ID_OFFSET, REG_VAR(reg32)
+#endif
 END_MACRO
 
