+#if defined(_WIN32) && defined(GESHER)
+// Diagnose native camera-array transitions independently of MF work. Declared
+// before ScopedObjectAccess, so its destructor also measures the SOA exit.
+class GesherCameraArrayTrace {
+ public:
+  GesherCameraArrayTrace(const char* api, size_t component_size)
+      : api_(api), active_(component_size == 1 && Active()) {
+    if (active_) {
+      start_ = NanoTime();
+      Thread* self = Thread::Current();
+      cpu_start_ = self->GetCpuNanoTime();
+      initial_state_ = static_cast<unsigned>(self->GetState());
+      suspend_ = self->ReadFlag(ThreadFlag::kSuspendRequest, std::memory_order_relaxed);
+      barrier_ = self->ReadFlag(ThreadFlag::kActiveSuspendBarrier, std::memory_order_relaxed);
+      pending_flip_ = self->ReadFlag(ThreadFlag::kPendingFlipFunction, std::memory_order_relaxed);
+      running_flip_ = self->ReadFlag(ThreadFlag::kRunningFlipFunction, std::memory_order_relaxed);
+      checkpoint_ = self->ReadFlag(ThreadFlag::kCheckpointRequest, std::memory_order_relaxed);
+      empty_checkpoint_ = self->ReadFlag(ThreadFlag::kEmptyCheckpointRequest, std::memory_order_relaxed);
+    }
+  }
+  void Entered() { if (active_) entered_ = NanoTime(); }
+  void Decoded() { if (active_) decoded_ = NanoTime(); }
+  void BodyDone() { if (active_) body_ = NanoTime(); }
+  ~GesherCameraArrayTrace() {
+    if (!active_) return;
+    const uint64_t end = NanoTime();
+    if (end - start_ < 2'000'000) return;
+    static thread_local unsigned emitted = 0;
+    if (emitted++ >= 64) return;
+    const uint64_t cpu_end = Thread::Current()->GetCpuNanoTime();
+    const int64_t cpu = cpu_start_ != UINT64_MAX && cpu_end != UINT64_MAX && cpu_end >= cpu_start_
+        ? static_cast<int64_t>(cpu_end - cpu_start_) / 1000 : -1;
+    if (entered_ == 0 || decoded_ == 0 || body_ == 0) {
+      fprintf(stderr, "camera JNI array trace: %s, tid %d, wall/cpu us %lld/%lld; "
+              "incomplete/error path, phase boundaries unavailable\n", api_,
+              static_cast<int>(Thread::Current()->GetTid()),
+              static_cast<long long>((end - start_) / 1000), static_cast<long long>(cpu));
+      fflush(stderr);
+      return;
+    }
+    const uint64_t entered = entered_ != 0 ? entered_ : end;
+    const uint64_t decoded = decoded_ != 0 ? decoded_ : entered;
+    const uint64_t body = body_ != 0 ? body_ : end;
+    fprintf(stderr, "camera JNI array trace: %s, tid %d, wall/cpu us %lld/%lld; "
+            "entry %lld, decode %lld, body %lld, exit %lld; initial state %u, "
+            "flags suspend/barrier/pending-flip/running-flip/checkpoint/empty %d/%d/%d/%d/%d/%d; "
+            "begin/end ns %llu/%llu\n", api_,
+            static_cast<int>(Thread::Current()->GetTid()),
+            static_cast<long long>((end - start_) / 1000), static_cast<long long>(cpu),
+            static_cast<long long>((entered - start_) / 1000),
+            static_cast<long long>((decoded - entered) / 1000),
+            static_cast<long long>((body - decoded) / 1000),
+            static_cast<long long>((end - body) / 1000), initial_state_,
+            suspend_, barrier_, pending_flip_, running_flip_, checkpoint_, empty_checkpoint_,
+            static_cast<unsigned long long>(start_), static_cast<unsigned long long>(end));
+    fflush(stderr);
+  }
+ private:
+  static bool Active() {
+    static const bool requested = [] {
+      const char* value = getenv("GESHER_MEDIA_TRACE_RECORD");
+      return value != nullptr && value[0] == '1' && value[1] == '\0';
+    }();
+    if (!requested) return false;
+    static thread_local const bool camera = [] {
+      std::string name;
+      // This overload requires no managed transition or locking.
+      Thread::Current()->GetThreadName(name);
+      return name.compare(0, 7, "camera-") == 0;
+    }();
+    return camera;
+  }
+  const char* api_;
+  const bool active_;
+  uint64_t start_ = 0, entered_ = 0, decoded_ = 0, body_ = 0, cpu_start_ = 0;
+  unsigned initial_state_ = 0;
+  bool suspend_ = false, barrier_ = false, pending_flip_ = false, running_flip_ = false;
+  bool checkpoint_ = false, empty_checkpoint_ = false;
+};
+#endif
 
