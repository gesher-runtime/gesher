diff --git a/runtime/thread.cc b/runtime/thread.cc
index 9ad0fc7..6b0fea2 100644
--- a/runtime/thread.cc
+++ b/runtime/thread.cc
@@ -799,11 +799,19 @@ void Thread::InstallImplicitProtection() {
         static_cast<void*>(pregion) << " to " <<
