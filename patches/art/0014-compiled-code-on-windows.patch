diff --git a/libartbase/base/membarrier.cc b/libartbase/base/membarrier.cc
index 07b132e..de9962b 100644
--- a/libartbase/base/membarrier.cc
+++ b/libartbase/base/membarrier.cc
@@ -65,6 +65,37 @@ int membarrier(MembarrierCommand command) {
   return syscall(__NR_membarrier, static_cast<int>(command), 0);
 }
 
+#elif defined(GESHER)
+
+}  // namespace art
+
+// Windows' process-wide memory barrier: every thread of the process runs a
+// full barrier (an inter-processor interrupt), as MEMBARRIER_CMD_PRIVATE_EXPEDITED
+// does. Code written by the JIT needs no instruction cache flush on x86-64.
+extern "C" __declspec(dllimport) void __stdcall FlushProcessWriteBuffers(void);
+
+namespace art {
+
+int membarrier(MembarrierCommand command) {
+  switch (command) {
+    case MembarrierCommand::kQuery:
+      return static_cast<int>(MembarrierCommand::kPrivateExpedited) |
+             static_cast<int>(MembarrierCommand::kRegisterPrivateExpedited) |
+             static_cast<int>(MembarrierCommand::kPrivateExpeditedSyncCore) |
+             static_cast<int>(MembarrierCommand::kRegisterPrivateExpeditedSyncCore);
+    case MembarrierCommand::kRegisterPrivateExpedited:
+    case MembarrierCommand::kRegisterPrivateExpeditedSyncCore:
+      return 0;
+    case MembarrierCommand::kPrivateExpedited:
+    case MembarrierCommand::kPrivateExpeditedSyncCore:
+      FlushProcessWriteBuffers();
+      return 0;
+    default:
+      errno = ENOSYS;
+      return -1;
+  }
+}
+
 #else  // __linux__
 
 int membarrier([[maybe_unused]] MembarrierCommand command) {
