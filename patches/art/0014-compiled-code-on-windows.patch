   if (ProtectStack<stack_type>(/* fatal_on_error= */ false)) {
+#if defined(GESHER)
+    // Gesher: the pages between the protected region and the stack's top are
+    // committed on demand (gesher-base's fault_signals.cc); a madvise over
+    // them would recommit the whole range with the protected pages'
+    // protection.
+    UNUSED(stack_top);
+#else
     // Tell the kernel that we won't be needing these pages any more.
     // NB. madvise will probably write zeroes into the memory (on linux it does).
     size_t unwanted_size =
