+#if defined(GESHER)
+// Gesher: gesher-base's <stdio.h> declares no asprintf; Conscrypt's error messages use it.
+#include <stdarg.h>
+#include <stdlib.h>
+
+inline int gesher_conscrypt_vasprintf(char** ret, const char* format, va_list args) {
+    va_list copy;
+    va_copy(copy, args);
+    *ret = nullptr;
+    int count = vsnprintf(nullptr, 0, format, args);
+    if (count >= 0) {
+        char* buffer = static_cast<char*>(malloc(static_cast<size_t>(count) + 1));
+        if (buffer == nullptr) {
+            count = -1;
+        } else if ((count = vsnprintf(buffer, static_cast<size_t>(count) + 1, format, copy)) < 0) {
+            free(buffer);
+        } else {
+            *ret = buffer;
+        }
+    }
+    va_end(copy);
+    return count;
+}
+
+inline int gesher_conscrypt_asprintf(char** strp, const char* fmt, ...) {
+    va_list ap;
+    va_start(ap, fmt);
+    int r = gesher_conscrypt_vasprintf(strp, fmt, ap);
+    va_end(ap);
+    return r;
+}
+#define vasprintf gesher_conscrypt_vasprintf
+#define asprintf gesher_conscrypt_asprintf
+#endif  // GESHER
+
 #endif  // CONSCRYPT_COMPAT_H_
