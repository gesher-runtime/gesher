package com.gesher.server;

import java.lang.management.ManagementFactory;
import java.lang.reflect.Method;
import java.util.ArrayDeque;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

public final class LegacyPreviewHost {
    private static final int MSG_ERROR = 1, MSG_PREVIEW_FRAME = 16;
    private static int checks, delivered, conversions, surfaces, nextSurfaceResult;
    private static boolean collect = true, recycle, autoAck = true, throwOnPost;
    private static Runnable onDeliver;
    private static Runnable onRead;
    private static Runnable onConvert;
    private static Runnable onPost;
    private static final List<byte[]> posted = new ArrayList<>();
    private static final List<Integer> frameIds = new ArrayList<>();
    private static final Map<Camera, Session> sessions = new LinkedHashMap<>();
    private static Camera activeCamera;
    private static int currentFrame;

    private static final class Size {
        final int width, height;
        Size(int width, int height) { this.width = width; this.height = height; }
        int getWidth() { return width; }
        int getHeight() { return height; }
    }
    private static final class Surface {}
    public static final class Camera {
        @SuppressWarnings("unused")
        public static void postEventFromNative(Object weakThis, int type, int first, int second, Object payload) {
            if (throwOnPost) throw new RuntimeException("simulated post failure");
            if (type == MSG_ERROR) return;
            if (type != MSG_PREVIEW_FRAME) throw new AssertionError("unexpected camera event " + type);
            if (onPost != null) onPost.run();
            ++delivered;
            byte[] frame = (byte[]) payload;
            if (collect) { posted.add(frame); frameIds.add(currentFrame); }
            Camera cam = (Camera) weakThis;
            if (autoAck && cam != null) {
                Session s = sessions.get(cam);
                if (s != null && !s.manualBuffers) setHasPreviewCallback(cam, true, false);
            }
            if (recycle && cam != null) {
                Session s = sessions.get(cam);
                if (s != null) s.buffers.add(frame);
            }
        }
    }
    private static Method sPost;
    private static Session session(Camera camera) {
        Session s = sessions.get(camera);
        if (s == null) throw new RuntimeException("unknown camera");
        return s;
    }
    private static final class WindowsCamera {
        static final class Device {}
        static final class Capture {
            final int width, height, frames;
            final Session session;
            int read, calls;
            Capture(Session session, int width, int height, int frames) {
                this.session = session; this.width = width; this.height = height; this.frames = frames;
                session.capture = this;
            }
            int read(byte[] frame) {
                ++calls;
                if (read == frames) {
                    synchronized (session) { if (session.capture == this) session.previewing = false; }
                    return 0;
                }
                currentFrame = ++read;
                Arrays.fill(frame, (byte) read);
                if (onRead != null) onRead.run();
                return 0;
            }
        }
    }
    private static final class CameraFrames {
        static final int OK = 0;
        static byte[] nv21(byte[] input, int cw, int ch, int w, int h) {
            ++conversions;
            if (onConvert != null) onConvert.run();
            byte[] result = new byte[w * h * 3 / 2];
            for (int i = 0; i < result.length; ++i) result[i] = value(currentFrame, i);
            return result;
        }
        static int deliver(Surface surface, byte[] input, int w, int h, long timestamp, byte[] jpeg) {
            int result = nextSurfaceResult;
            if (result == OK) ++surfaces;
            if (onDeliver != null) onDeliver.run();
            return result;
        }
    }
    private static void log(String message) {}

@PRODUCTION@

    private static void check(boolean ok, String description) {
        ++checks;
        if (!ok) throw new AssertionError(description);
    }
    private static byte value(int frame, int at) { return (byte) (frame * 13 + at * 37); }
    private static int bytes(String format, int w, int h) {
        int yStride = (w + 15) / 16 * 16;
        int cStride = (yStride / 2 + 15) / 16 * 16;
        return format.equals("yuv420p") ? yStride * h + 2 * cStride * (h / 2) : w * h * 3 / 2;
    }
    private static byte[] expected(String format, int w, int h, int frame) {
        byte[] result = new byte[bytes(format, w, h)];
        if (!format.equals("yuv420p")) {
            for (int i = 0; i < result.length; ++i) result[i] = value(frame, i);
            return result;
        }
        int yStride = (w + 15) / 16 * 16, cStride = (yStride / 2 + 15) / 16 * 16;
        for (int y = 0; y < h; ++y) for (int x = 0; x < w; ++x) result[y * yStride + x] = value(frame, y * w + x);
        for (int y = 0; y < h / 2; ++y) for (int x = 0; x < w / 2; ++x) {
            result[yStride * h + y * cStride + x] = value(frame, w * h + y * w + 2 * x);
            result[yStride * h + cStride * h / 2 + y * cStride + x] = value(frame, w * h + y * w + 2 * x + 1);
        }
        return result;
    }
    private static Session session(String format, boolean callback, boolean manual, boolean surface) {
        Camera cam = new Camera();
        Session result = new Session(cam, new WindowsCamera.Device());
        sessions.put(cam, result);
        activeCamera = cam;
        result.params.put("preview-format", format);
        result.callback = callback; result.manualBuffers = manual; result.previewing = true;
        result.previewSurface = surface ? new Surface() : null;
        return result;
    }
    private static void reset() {
        delivered = conversions = surfaces = 0;
        nextSurfaceResult = CameraFrames.OK;
        posted.clear(); frameIds.clear(); recycle = false; collect = true;
        autoAck = true; throwOnPost = false;
        onDeliver = null; onRead = null; onConvert = null; onPost = null;
    }
    private static void behavior() {
        for (int[] dimensions : new int[][] {{2, 2}, {16, 4}, {18, 6}, {32, 18}, {640, 480}}) {
            int w = dimensions[0], h = dimensions[1];
            for (String format : new String[] {"yuv420sp", "yuv420p"}) {
                int required = bytes(format, w, h);
                for (boolean manual : new boolean[] {false, true}) {
                    reset();
                    Session session = session(format, true, manual, true);
                    byte[] shortBuffer = new byte[required - 1], exact = new byte[required], large = new byte[required + 17];
                    Arrays.fill(exact, (byte) 0x5a); Arrays.fill(large, (byte) 0x5a);
                    session.buffers.add(shortBuffer); session.buffers.add(exact); session.buffers.add(large);
                    previewLoop(session, new WindowsCamera.Capture(session, w, h, 5), new Size(w, h));
                    check(surfaces == 5, "callback starvation suppressed surface delivery");
                    check(delivered == (manual ? 2 : 5), "wrong callback count");
                    if (manual) {
                        check(posted.get(0) == exact && posted.get(1) == large, "caller buffer identity/order changed");
                        check(session.buffers.isEmpty(), "queued undersized buffers were not consumed");
                        for (int i = required; i < large.length; ++i) check(large[i] == 0x5a, "oversized buffer suffix changed");
                    } else check(session.buffers.size() == 3, "automatic mode consumed manual buffers");
                    for (int i = 0; i < posted.size(); ++i) {
                        check(Arrays.equals(Arrays.copyOf(posted.get(i), required), expected(format, w, h, frameIds.get(i))),
                                "packed bytes or zero padding changed");
                    }
                }
                reset();
                Session noCallback = session(format, false, true, true);
                previewLoop(noCallback, new WindowsCamera.Capture(noCallback, w, h, 5), new Size(w, h));
                check(conversions == 0 && delivered == 0 && surfaces == 5, "disabled callback did unnecessary work");

                // Buffers queued while rendering the surface remain eligible for this callback.
                reset();
                Session late = session(format, true, true, true);
                byte[] buffer = new byte[required];
                onDeliver = () -> { if (currentFrame == 1) late.buffers.add(buffer); };
                previewLoop(late, new WindowsCamera.Capture(late, w, h, 2), new Size(w, h));
                check(delivered == 1 && posted.get(0) == buffer && frameIds.get(0) == 1, "surface-time buffer admission changed");
            }
        }
        reset();
        Session restarted = session("yuv420sp", true, false, true);
        WindowsCamera.Capture oldCapture = new WindowsCamera.Capture(restarted, 2, 2, 1);
        onRead = () -> {
            synchronized (restarted) { new WindowsCamera.Capture(restarted, 2, 2, 0); }
        }; // a restart installs a different capture while an old read is outstanding
        previewLoop(restarted, oldCapture, new Size(2, 2));
        check(delivered == 0 && surfaces == 0 && conversions == 0,
                "old read published into a stopped/restarted preview");
        check(restarted.previewing && restarted.capture != oldCapture,
                "old loop stopped or replaced the new preview");
        for (String format : new String[] {"yuv420sp", "yuv420p"}) {
            for (boolean duringConversion : new boolean[] {false, true}) {
                reset();
                Session changed = session(format, true, true, true);
                int required = bytes(format, 18, 6);
                byte[] oldBuffer = new byte[required], replacementBuffer = new byte[required];
                Arrays.fill(replacementBuffer, (byte) 0x5a);
                changed.buffers.add(oldBuffer);
                WindowsCamera.Capture previous = new WindowsCamera.Capture(changed, 18, 6, 1);
                Runnable restart = () -> {
                    synchronized (changed) {
                        new WindowsCamera.Capture(changed, 18, 6, 0);
                        changed.buffers.clear(); changed.buffers.add(replacementBuffer);
                    }
                };
                if (duringConversion) onConvert = restart; else onDeliver = restart;
                previewLoop(changed, previous, new Size(18, 6));
                check(delivered == 0, "old surface/conversion completion posted into replacement preview");
                check(surfaces == 1 && conversions == (duringConversion ? 1 : 0),
                        "superseded delivery admitted another conversion");
                check(changed.buffers.size() == 1 && changed.buffers.peek() == replacementBuffer,
                        "old loop consumed a replacement preview's callback buffer");
                for (byte value : replacementBuffer) check(value == 0x5a, "old loop modified replacement buffer contents");
                check(changed.previewing && changed.capture != previous, "old completion stopped the new capture");
                check(previous.calls == 1, "superseded loop began another native read after completion");
            }
        }
        reset();
        Session atomic = session("yuv420sp", true, false, false);
        onPost = () -> check(Thread.holdsLock(atomic), "preview callback admission raced stop/restart after final check");
        previewLoop(atomic, new WindowsCamera.Capture(atomic, 2, 2, 1), new Size(2, 2));
        check(delivered == 1, "normal preview callback was suppressed by generation admission");

        // Automatic callback backpressure: unacknowledged frame suppresses extra conversions
        // until setHasPreviewCallback acknowledges receipt.
        reset();
        autoAck = false;
        Session bp = session("yuv420sp", true, false, true);
        Camera bpCam = activeCamera;
        onRead = () -> {
            if (currentFrame == 4) setHasPreviewCallback(bpCam, true, false);
        };
        previewLoop(bp, new WindowsCamera.Capture(bp, 16, 4, 5), new Size(16, 4));
        check(surfaces == 5, "backpressure blocked surface delivery");
        check(delivered == 2 && conversions == 2 && frameIds.get(0) == 1 && frameIds.get(1) == 4,
                "backpressure did not throttle or resume on callback acknowledgment");

        // Post reflection failure clears frameInFlight so subsequent frames are not stuck.
        reset();
        autoAck = false;
        Session err = session("yuv420sp", true, false, false);
        throwOnPost = true;
        onRead = () -> {
            if (currentFrame == 2) throwOnPost = false;
        };
        previewLoop(err, new WindowsCamera.Capture(err, 16, 4, 2), new Size(16, 4));
        check(delivered == 1 && frameIds.get(0) == 2 && err.frameInFlight,
                "failed post left frameInFlight stuck");

        // Manual callback buffer cap and automatic-mode guard, plus surface recovery.
        reset();
        Session cap = session("yuv420sp", true, false, true);
        Camera capCam = activeCamera;
        addCallbackBuffer(capCam, new byte[8], MSG_PREVIEW_FRAME);
        check(cap.buffers.isEmpty(), "manual buffer accepted while non-manual callback active");
        setHasPreviewCallback(capCam, true, true);
        for (int i = 0; i < 20; ++i) addCallbackBuffer(capCam, new byte[8], MSG_PREVIEW_FRAME);
        check(cap.buffers.size() == 16, "manual buffer queue exceeded cap");
        nextSurfaceResult = -1;
        onDeliver = () -> {
            if (currentFrame == 1) nextSurfaceResult = CameraFrames.OK;
        };
        previewLoop(cap, new WindowsCamera.Capture(cap, 16, 4, 3), new Size(16, 4));
        check(surfaces == 2, "preview surface did not recover after transient delivery failure");
    }
    private static void measured(String format, boolean withBuffer, boolean gate) {
        reset(); collect = false; recycle = withBuffer;
        int w = 640, h = 480, frames = 200;
        Session session = session(format, true, true, false);
        if (withBuffer) session.buffers.add(new byte[bytes(format, w, h)]);
        WindowsCamera.Capture capture = new WindowsCamera.Capture(session, w, h, frames);
        com.sun.management.ThreadMXBean bean = (com.sun.management.ThreadMXBean) ManagementFactory.getThreadMXBean();
        bean.setThreadAllocatedMemoryEnabled(true);
        long before = bean.getThreadAllocatedBytes(Thread.currentThread().getId());
        previewLoop(session, capture, new Size(w, h));
        long allocated = bean.getThreadAllocatedBytes(Thread.currentThread().getId()) - before;
        System.out.println("Legacy preview: format=" + format + " manual_buffer=" + withBuffer + " frames=" + frames
                + " callbacks=" + delivered + " conversion_calls=" + conversions + " allocated_bytes=" + allocated);
        check(delivered == (withBuffer ? frames : 0), "measured callback count changed");
        if (gate) {
            check(conversions == (withBuffer ? frames : 0), "starved callbacks still perform NV21 conversion");
            long ceiling = withBuffer ? (long) frames * w * h * 3 / 2 + 1024 * 1024 : 1024 * 1024;
            check(allocated < ceiling, "manual preview allocated an avoidable full-frame array");
        }
    }
    public static void main(String[] args) {
        if (args[0].equals("behavior")) behavior();
        else for (String format : new String[] {"yuv420sp", "yuv420p"}) {
            measured(format, false, args[1].equals("gate"));
            measured(format, true, args[1].equals("gate"));
        }
        System.out.println("Legacy preview " + args[0] + " PASS: " + checks + " checks");
    }
}
