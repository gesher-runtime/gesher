/** JNI/native copying, file-resource loading, the UI thread and app callbacks are declared boundaries. */
@SuppressWarnings("deprecation")
public final class WebViewOwnedResponsesHost {
    private static final int CONTEXT_DOCUMENT = 1, CONTEXT_IMAGE = 3;
    private static final String TAG = "fixture", BASE = "https://owned.example/document";
    private static int checks;
    private volatile WebView2Host mHost = new WebView2Host();
    private volatile Runnable beforeClaim;
    private String mOriginalUrl;
    private boolean mInterceptsRequests;
    private volatile boolean mOverridesNavigation;
    private static final long WAIT_FOR_UI_MS = 5000;
    private final Ui mUi = new Ui();
    private final FixtureContext mContext = new FixtureContext();
    private final Settings mSettings = new Settings();
    private final WebViewClient mClient = new WebViewClient(this);
    private final Object mView = new Object();

    private static final class Delivery {
        final long id;
        final int status;
        final String reason, headers;
        final byte[] body;
        Delivery(long id, int status, String reason, String headers, byte[] body) {
            this.id = id; this.status = status; this.reason = reason; this.headers = headers; this.body = body;
        }
    }
    private static final class WebView2Host {
        final ArrayList<Delivery> deliveries = new ArrayList<>();
        Runnable beforeRespond;
        boolean nativeCopy = true, failRespond;
        String navigated, navigationHeaders, html;
        synchronized void respond(long id, int status, String reason, String headers, byte[] body) {
            // Native GetByteArrayRegion copies synchronously before the Java call
            // returns. Profile mode excludes that unchanged native allocation.
            if (beforeRespond != null) beforeRespond.run();
            if (failRespond) throw new IllegalStateException("native response fixture failure");
            deliveries.add(new Delivery(id, status, reason, headers,
                    body != null && nativeCopy ? body.clone() : body));
        }
        final ArrayList<String> navigations = new ArrayList<>();
        void navigate(String url, String headers) { navigate(url, headers, 0); }
        void navigate(String url, String headers, long number) {
            navigated = url; navigationHeaders = headers; navigations.add(url);
            queued.add(new Object[] {url, number});
        }
        void navigate(String url, String headers, String method, byte[] body, long number) {
            navigate(url, headers, number);
        }
        void navigateToString(String value) { html = value; }

        // webview_host.cc's navigation state, a declared boundary model: Host::Navigate
        // (after NumberNextNavigate) runs later on the WebView thread, its
        // NavigationStarting handler reports EVENT_PAGE_STARTED (arg 1 for the one API
        // navigation its flag covers) or asks the Listener, NavigationCompleted reports
        // the number the navigation started with, and WebResourceRequested's mainFrame
        // is url == main_document.
        static final int EVENT_FAILED = 2, EVENT_PAGE_STARTED = 3, EVENT_PAGE_FINISHED = 4,
                EVENT_SOURCE_CHANGED = 5, EVENT_SCRIPT_RESULT = 10, EVENT_CAPTURE = 17,
                EVENT_PARKED = 18, EVENT_DEVTOOLS_RESULT = 20;
        WebViewOwnedResponsesHost client;
        final ArrayDeque<Object[]> queued = new ArrayDeque<>();
        boolean apiNavigation;
        long apiNumber;
        final Map<Long, Long> startedNumbers = new HashMap<>();
        String mainDocument;
        long nextNavigation = 1;
        /** The Navigate calls issued so far run (before any NavigationStarting). */
        void execute() {
            while (!queued.isEmpty()) {
                long number = (Long) queued.removeFirst()[1];
                apiNavigation = true;
                apiNumber = Math.max(apiNumber, number);
            }
        }
        /** The next Navigate call runs and fails. */
        void executeFailing() {
            Object[] call = queued.removeFirst();
            long number = (Long) call[1];
            apiNavigation = true;
            apiNumber = Math.max(apiNumber, number);
            apiNavigation = false;
            client.onEvent(EVENT_FAILED, 0, 0x80004005, "Navigate " + call[0] + ": 0x80004005", null, null, null);
        }
        void reload() { apiNavigation = true; }
        /** NavigationStarting: the navigation's id, or -1 when the Listener took it. */
        long starting(String url, boolean user, boolean redirect) {
            boolean api = apiNavigation && !redirect;
            if (!redirect) apiNavigation = false;
            long navigation = nextNavigation++;
            if (!api && client.onNavigationStarting(url, user, redirect)) return -1;
            mainDocument = url;
            if (!redirect) {
                startedNumbers.put(navigation, apiNumber);
                client.onEvent(EVENT_PAGE_STARTED, navigation, api ? 1 : 0, url, null, null, null);
            }
            return navigation;
        }
        /** NavigationCompleted: status -1 for success, 14 for a superseded navigation. */
        void completed(long navigation, int status, String url) {
            Long started = startedNumbers.remove(navigation);
            client.onEvent(EVENT_PAGE_FINISHED, 200, status, url, String.valueOf(started == null ? 0 : started),
                    null, null);
        }
        void sourceChanged(String url, boolean newDocument) {
            client.onEvent(EVENT_SOURCE_CHANGED, 0, newDocument ? 1 : 0, url, null, null, null);
        }
        /** A WebResourceRequested for the main frame's or a frame's document. */
        void request(long id, String url, int context) {
            client.answerRequest(id, url, "GET", "X-Request: one\r\n", context,
                    context == CONTEXT_DOCUMENT && url.equals(mainDocument));
        }
    }
    { mHost.client = this; }
    // onEvent's other boundaries: the bridge, parking, synchronous results, the UI thread.
    private static final class Dispatcher { int started; void navigationStarted() { ++started; } }
    private final Dispatcher mBridgeDispatcher = new Dispatcher();
    private volatile CountDownLatch mParked;
    private static final class Sync {
        final CountDownLatch done = new CountDownLatch(1);
        volatile int hresult; volatile String text; volatile byte[] bytes;
    }
    private final Map<Long, Sync> mSync = new java.util.concurrent.ConcurrentHashMap<>();
    private final ArrayList<String> handled = new ArrayList<>();
    private void handleEvent(int type, long id, int arg, String a, String b, String c, byte[] bytes) {
        handled.add(type + " " + a);
    }
    private static final class Settings {
        boolean allowFile, blockLoads, blockImages, images = true;
        boolean getAllowFileAccess() { return allowFile; }
        boolean getBlockNetworkLoads() { return blockLoads; }
        boolean getBlockNetworkImage() { return blockImages; }
        boolean getLoadsImagesAutomatically() { return images; }
    }
    private static final class Request {
        final String url, method;
        final boolean mainFrame;
        final Map<String,String> headers;
        Request(String url, boolean mainFrame, boolean redirect, boolean gesture, String method, Map<String,String> headers) {
            this.url = url; this.mainFrame = mainFrame; this.method = method; this.headers = headers;
        }
    }
    /** The WebView's Looper: runs what is posted at once (the waiting WebView thread is the caller). */
    private static final class Ui { boolean post(Runnable r) { r.run(); return true; } }
    private static final class WebViewClient {
        final WebViewOwnedResponsesHost owner;
        final AtomicInteger calls = new AtomicInteger(), overrides = new AtomicInteger();
        volatile Supplier<WebResourceResponse> response;
        volatile Request request;
        volatile boolean takes;
        WebViewClient(WebViewOwnedResponsesHost owner) { this.owner = owner; }
        boolean shouldOverrideUrlLoading(Object view, Request request) {
            overrides.incrementAndGet(); this.request = request;
            return takes;
        }
        WebResourceResponse shouldInterceptRequest(Object view, Request request) {
            if (Thread.holdsLock(owner)) throw new AssertionError("app callback ran under a provider lock");
            calls.incrementAndGet(); this.request = request;
            return response == null ? null : response.get();
        }
    }
    private static final class FixtureContext {
        Supplier<WebResourceResponse> response;
        int files;
    }
    private static final class FileUrls {
        public static final String ORIGIN = "https://gesher-file.example";
        private static final String FILE = "file:///";
@URL_MAPPINGS@
        static WebResourceResponse load(FixtureContext context, String url, boolean allow) {
            ++context.files;
            return context.response == null ? null : context.response.get();
        }
    }
    private static final class GesherWebView { static void log(String message) {} }
    private static final class Log { static void e(String tag, String message, Exception exception) {} }

    private void fixtureBeforeClaim() {
        Runnable hook = beforeClaim;
        if (hook != null) hook.run();
    }
    private <T> T fixtureRead(AtomicReference<T> slot) {
        fixtureBeforeClaim();
        return slot.get();
    }
    private byte[] pendingBody() { @BODY@ }
    private String pendingMime() { @MIME@ }
    private String pendingUrl() { @URL@ }

@PRODUCTION@

    private static void check(boolean ok, String description) {
        ++checks;
        if (!ok) throw new AssertionError(description);
    }
    private static byte[] bytes(String value) { return value.getBytes(StandardCharsets.UTF_8); }
    private static Delivery last(WebViewOwnedResponsesHost provider) {
        return provider.mHost.deliveries.get(provider.mHost.deliveries.size() - 1);
    }
    private static WebViewOwnedResponsesHost pending(String url, String data, String mime, String encoding) {
        WebViewOwnedResponsesHost provider = new WebViewOwnedResponsesHost();
        provider.loadDataWithBaseURL(url, data, mime, encoding, "https://history.example/");
        return provider;
    }
    private static void answer(WebViewOwnedResponsesHost provider, long id, String url, int context) {
        provider.answerRequest(id, FileUrls.toWebView2(url), "GET", "X-Request: one\r\n", context, true);
    }
    private static void ownedCases() throws Exception {
        for (String data : new String[] {"", "a", "שלום🙂世界", "x".repeat(16385), "raw\u0000bytes\r\nline"}) {
            for (String encoding : new String[] {"UTF-8", "base64", "BaSe64"}) {
                byte[] expected = bytes(data);
                String input = encoding.equalsIgnoreCase("base64")
                        ? java.util.Base64.getMimeEncoder().encodeToString(expected) : data;
                for (String base : new String[] {BASE, "file:///android_asset/index.html"}) {
                    WebViewOwnedResponsesHost provider = pending(base, input, "text/custom", encoding);
                    provider.mInterceptsRequests = true;
                    provider.mClient.response = () -> { throw new AssertionError("private document invoked app interceptor"); };
                    check(provider.mHost.navigated.equals(FileUrls.toWebView2(base)), "base URL mapping changed");
                    check(provider.mOriginalUrl.equals(base), "owned document history/original URL changed");
                    byte[] privateBody = provider.pendingBody();
                    answer(provider, 31, base, CONTEXT_DOCUMENT);
                    Delivery reply = last(provider);
                    check(reply.id == 31 && reply.status == 200 && reply.reason.equals("OK"), "owned response status/id changed");
                    check(reply.headers.equals("Content-Type: text/custom; charset=UTF-8\r\n"), "owned response MIME/encoding changed");
                    check(Arrays.equals(reply.body, expected), "owned response bytes changed");
                    check(provider.mHost.deliveries.size() == 1 && provider.mClient.calls.get() == 0,
                            "owned response was duplicated or intercepted");
                    check(provider.pendingBody() == privateBody, "published document was not kept for a later request");
                    // A superseded navigation's request or a reload asks again: same document.
                    answer(provider, 32, base, CONTEXT_DOCUMENT);
                    check(last(provider).id == 32 && last(provider).status == 200 && Arrays.equals(last(provider).body, expected)
                            && provider.mClient.calls.get() == 0, "a second request for the published document lost it");
                    // JNI's snapshot must survive later source-array changes.
                    if (expected.length != 0) {
                        byte[] snapshot = reply.body.clone(); privateBody[0] ^= 0x7f;
                        check(Arrays.equals(reply.body, snapshot), "response aliased caller data after JNI return");
                    }
                }
            }
        }
        WebViewOwnedResponsesHost empty = pending(BASE, null, null, "ignored");
        answer(empty, 4, BASE, CONTEXT_DOCUMENT);
        check(last(empty).body.length == 0 && last(empty).headers.equals("Content-Type: text/html; charset=UTF-8\r\n"),
                "null data/default MIME changed");
        for (String base : new String[] {null, "", "data:text/html,", "about:blank"}) {
            WebViewOwnedResponsesHost about = pending(base,
                    "<script src=\"file:///android_asset/main.js\"></script><img src=\"file:///android_res/drawable/icon\">",
                    "text/html", "UTF-8");
            check(about.pendingBody() == null && about.mHost.navigated == null, "navigateToString path published an owned document");
            check(about.mHost.html.contains("https://gesher-file.example/android_asset/main.js")
                    && about.mHost.html.contains("https://gesher-file.example/android_res/drawable/icon"),
                    "navigateToString asset/resource rewriting changed");
            check(about.mOriginalUrl.equals("https://history.example/"), "navigateToString history URL changed");
        }
        WebViewOwnedResponsesHost image = pending(BASE, "private", "text/owned", "UTF-8");
        byte[] original = image.pendingBody();
        answer(image, 1, BASE, CONTEXT_IMAGE);
        check(image.pendingBody() == original && last(image).status == 0, "non-document request consumed private body");
        answer(image, 2, "https://other.example/", CONTEXT_DOCUMENT);
        check(image.pendingBody() == original && last(image).status == 0, "nonmatching URL consumed private body");
        answer(image, 3, BASE, CONTEXT_DOCUMENT);
        check(Arrays.equals(last(image).body, bytes("private")) && image.pendingBody() == original, "matching document lost deferred body");
        answer(image, 4, BASE, CONTEXT_DOCUMENT);
        check(Arrays.equals(last(image).body, bytes("private")) && image.pendingBody() == original,
                "a repeated request (superseded navigation, reload) lost the published document");
        // Another load of the WebView's own replaces it: the base URL is then the URL's own.
        image.navigate(FileUrls.toWebView2(BASE), "");
        answer(image, 5, BASE, CONTEXT_DOCUMENT);
        check(last(image).status == 0 && image.pendingBody() == null, "loadUrl of the base URL still answered the old document");
        WebView2Host saved = image.mHost;
        image.loadDataWithBaseURL(BASE, "not answered", "text/html", "UTF-8", null);
        original = image.pendingBody(); image.mHost = null;
        answer(image, 4, BASE, CONTEXT_DOCUMENT);
        check(image.pendingBody() == original, "unavailable host consumed a document");
        image.mHost = saved;
    }
    private static int scenarioFailures;
    /** Each scenario reports on its own, so an old-source control shows every one that fails. */
    private static void scenario(String name, Runnable body) {
        try {
            body.run();
            System.out.println("NAVIGATION_PASS " + name);
        } catch (AssertionError failure) {
            ++scenarioFailures;
            System.out.println("NAVIGATION_FAIL " + name + ": " + failure.getMessage());
        }
    }
    /** An app that opens its own folder's links itself: it takes every navigation it is asked about. */
    private static WebViewOwnedResponsesHost taking(WebViewOwnedResponsesHost provider) {
        provider.mOverridesNavigation = true;
        provider.mClient.takes = true;
        return provider;
    }
    private static void navigationCases() {
        String url = FileUrls.toWebView2(BASE);
        scenario("two overlapping loads both start: neither is the app's", () -> {
            WebViewOwnedResponsesHost provider = taking(pending(BASE, "first", "text/html", "UTF-8"));
            provider.loadDataWithBaseURL(BASE, "second", "text/html", "UTF-8", null);
            WebView2Host host = provider.mHost;
            check(host.navigations.size() == 2, "two loads were not both issued");
            host.execute();  // both Navigate calls run before WebView2 raises NavigationStarting
            long first = host.starting(url, false, false);   // WebView2Host's flag
            host.request(1, url, CONTEXT_DOCUMENT);
            host.completed(first, 14, url);  // superseded: it ends no other load
            long second = host.starting(url, false, false);  // the provider's ApiNavigations
            check(first > 0 && second > 0 && provider.mClient.overrides.get() == 0,
                    "shouldOverrideUrlLoading was asked about loadDataWithBaseURL");
            host.request(2, url, CONTEXT_DOCUMENT);
            check(Arrays.equals(last(provider).body, bytes("second")), "the second load's document was lost");
            host.completed(second, -1, url);
            // The page's own navigation to the same URL is the app's to take.
            check(host.starting(url, true, false) < 0 && provider.mClient.overrides.get() == 1
                    && provider.mClient.request.url.equals(BASE), "a page navigation did not reach shouldOverrideUrlLoading");
        });
        scenario("two identical loads, one NavigationStarting: a later page navigation is the app's", () -> {
            WebViewOwnedResponsesHost provider = taking(pending(BASE, "first", "text/html", "UTF-8"));
            provider.loadDataWithBaseURL(BASE, "second", "text/html", "UTF-8", null);
            WebView2Host host = provider.mHost;
            host.execute();
            long only = host.starting(url, false, false);  // WebView2 started the second only
            host.request(1, url, CONTEXT_DOCUMENT);
            check(only > 0 && Arrays.equals(last(provider).body, bytes("second")), "the load's document was lost");
            host.completed(only, -1, url);
            check(host.starting(url, true, false) < 0 && provider.mClient.overrides.get() == 1
                    && provider.mClient.request.url.equals(BASE),
                    "a page navigation to the URL of an unstarted duplicate load skipped shouldOverrideUrlLoading");
        });
        scenario("a load issued before a navigation finishes but handed over after it stays own", () -> {
            WebViewOwnedResponsesHost provider = taking(new WebViewOwnedResponsesHost());
            WebView2Host host = provider.mHost;
            provider.loadUrl0("https://first.example/");
            host.execute();
            long first = host.starting("https://first.example/", false, false);
            provider.loadUrl0("https://second.example/");  // still on its way to the WebView thread
            host.completed(first, -1, "https://first.example/");
            host.execute();
            host.apiNavigation = false;  // a page navigation took WebView2Host's flag first
            check(host.starting("https://second.example/", false, false) > 0 && provider.mClient.overrides.get() == 0,
                    "a load handed over after the finished navigation started was asked about");
        });
        scenario("a page navigation leaves the published document", () -> {
            WebViewOwnedResponsesHost provider = pending(BASE, "published", "text/html", "UTF-8");
            WebView2Host host = provider.mHost;
            host.execute();
            long own = host.starting(url, false, false);
            host.request(1, url, CONTEXT_DOCUMENT);
            check(Arrays.equals(last(provider).body, bytes("published")), "the own load's document was not answered");
            host.completed(own, -1, url);
            provider.mOverridesNavigation = true;  // asked, and lets the page load it
            check(host.starting(url, true, false) > 0 && provider.mClient.overrides.get() == 1,
                    "the page's navigation was not the app's");
            host.request(2, url, CONTEXT_DOCUMENT);
            check(last(provider).status == 0 && provider.pendingBody() == null,
                    "a page navigation to the base URL got loadDataWithBaseURL's document");
            check(provider.mBridgeDispatcher.started == 2, "the bridge did not see both navigations start");
        });
        scenario("a redirect of the WebView's own load is the app's", () -> {
            WebViewOwnedResponsesHost provider = taking(new WebViewOwnedResponsesHost());
            WebView2Host host = provider.mHost;
            provider.loadUrl0(BASE);
            host.execute();
            long own = host.starting(url, false, false);
            check(own > 0 && provider.mClient.overrides.get() == 0, "loadUrl was asked about");
            check(host.starting("https://redirect.example/", false, true) < 0
                    && provider.mClient.overrides.get() == 1, "a redirect skipped shouldOverrideUrlLoading");
        });
        scenario("loads that never start do not stay the WebView's own", () -> {
            WebViewOwnedResponsesHost provider = taking(new WebViewOwnedResponsesHost());
            WebView2Host host = provider.mHost;
            for (int i = 0; i < ApiNavigations.LIMIT + 4; ++i) provider.navigate("https://stale.example/" + i, "");
            check(provider.mApiNavigations.size() == ApiNavigations.LIMIT, "unstarted loads were kept without bound");
            host.execute();
            check(host.starting("https://stale.example/" + (ApiNavigations.LIMIT + 3), false, false) > 0
                    && provider.mApiNavigations.size() == 0, "a later load's start kept superseded ones");
            check(host.starting("https://stale.example/1", true, false) < 0, "a superseded load's URL stayed exempt");
        });
        scenario("a failed Navigate is not the WebView's own", () -> {
            WebViewOwnedResponsesHost provider = taking(new WebViewOwnedResponsesHost());
            WebView2Host host = provider.mHost;
            provider.navigate("https://fail.example/", "");
            host.executeFailing();
            check(provider.mApiNavigations.size() == 0, "the failed Navigate's report was not parsed");
            check(host.starting("https://fail.example/", true, false) < 0, "a failed load's URL stayed exempt");
        });
        scenario("a fragment load raises no NavigationStarting", () -> {
            WebViewOwnedResponsesHost provider = taking(new WebViewOwnedResponsesHost());
            WebView2Host host = provider.mHost;
            provider.loadUrl0(BASE + "#part");
            host.execute();
            host.apiNavigation = false;  // a same-document load takes no NavigationStarting
            host.sourceChanged(url + "#part", false);
            check(provider.mApiNavigations.size() == 0, "the fragment load stayed outstanding");
            check(host.starting(url + "#part", true, false) < 0, "a fragment load's URL stayed exempt");
        });
        if (scenarioFailures != 0) throw new AssertionError(scenarioFailures + " navigation scenarios failed");
    }
    private void loadUrl0(String url) { navigate(FileUrls.toWebView2(url), ""); }
    private static final class TrackingBytes extends ByteArrayInputStream {
        int reads, closes;
        boolean transform, failRead, failClose, zeroFirst;
        TrackingBytes(byte[] bytes) { super(bytes); }
        @Override public synchronized int read(byte[] bytes, int offset, int length) {
            ++reads;
            if (failRead) throw new IllegalStateException("app read failed");
            if (zeroFirst && reads == 1) return 0;
            int count = super.read(bytes, offset, length);
            if (transform && count > 0) for (int i = offset; i < offset + count; ++i) bytes[i] ^= 0x55;
            return count;
        }
        @Override public void close() throws IOException {
            ++closes;
            if (failClose) throw new IOException("app close failed");
        }
    }
    private static final class ChunkedStream extends InputStream {
        final byte[] data = bytes("small chunks שלום🙂");
        int offset, reads, closes;
        boolean fail, fatal;
        @Override public int read() throws IOException {
            byte[] one = new byte[1]; int count = read(one, 0, 1);
            return count < 0 ? -1 : one[0] & 0xff;
        }
        @Override public int read(byte[] bytes, int at, int length) throws IOException {
            ++reads;
            if (reads == 3 && fatal) throw new AssertionError("fatal stream fixture");
            if (reads == 3 && fail) throw new IOException("partial stream fixture");
            if (offset == data.length) return -1;
            int count = Math.min(3, Math.min(length, data.length - offset));
            System.arraycopy(data, offset, bytes, at, count); offset += count;
            return count;
        }
        @Override public void close() { ++closes; }
    }
    private static void streamsAndHeaders() throws Exception {
        for (int scenario = 0; scenario < 5; ++scenario) {
            WebViewOwnedResponsesHost provider = new WebViewOwnedResponsesHost();
            TrackingBytes stream = new TrackingBytes(bytes("app stream שלום🙂"));
            stream.transform = scenario == 0; stream.failRead = scenario == 1;
            stream.failClose = scenario == 2; stream.zeroFirst = scenario == 3;
            LinkedHashMap<String,String> headers = new LinkedHashMap<>();
            headers.put("Content-Type", "ignored/duplicate"); headers.put("X-App", "preserved");
            provider.mInterceptsRequests = true;
            provider.mClient.response = () -> new WebResourceResponse("text/app", "ISO-8859-1", 418, "Fixture", headers, stream);
            answer(provider, 8, "https://app.example/", CONTEXT_DOCUMENT);
            Delivery reply = last(provider);
            check(reply.status == 418 && reply.reason.equals("Fixture") && reply.id == 8, "app response metadata changed");
            check(reply.headers.equals("Content-Type: text/app; charset=ISO-8859-1\r\nX-App: preserved\r\n"), "app headers changed");
            check(stream.closes == 1 && stream.reads > 0, "app ByteArrayInputStream skipped read/close");
            byte[] expected = scenario >= 1 && scenario <= 3 ? new byte[0] : bytes("app stream שלום🙂");
            if (stream.transform) for (int i = 0; i < expected.length; ++i) expected[i] ^= 0x55;
            check(Arrays.equals(reply.body, expected), "app read/close/error/zero-read semantics changed");
            check(provider.mClient.request.method.equals("GET") && provider.mClient.request.headers.get("X-Request").equals("one"),
                    "app interception request changed");
        }
        for (int scenario = 0; scenario < 3; ++scenario) {
            WebViewOwnedResponsesHost provider = new WebViewOwnedResponsesHost();
            ChunkedStream stream = new ChunkedStream(); stream.fail = scenario == 1; stream.fatal = scenario == 2;
            provider.mInterceptsRequests = true;
            provider.mClient.response = () -> new WebResourceResponse("text/chunked", null, stream);
            if (stream.fatal) {
                try { answer(provider, 10, BASE, CONTEXT_DOCUMENT); throw new IllegalStateException("fatal stream error swallowed"); }
                catch (AssertionError expected) { check(provider.mHost.deliveries.isEmpty(), "fatal stream error published a partial response"); }
            } else {
                answer(provider, 10, BASE, CONTEXT_DOCUMENT);
                check(Arrays.equals(last(provider).body, stream.fail ? new byte[0] : stream.data), "partial-read/error response changed");
            }
            check(stream.closes == 1 && stream.reads >= 3, "partial stream read/close lifecycle changed");
        }
        WebViewOwnedResponsesHost noData = new WebViewOwnedResponsesHost();
        noData.mInterceptsRequests = true;
        Map<String,String> headers = new LinkedHashMap<>(); headers.put("Content-Type", "application/external");
        noData.mClient.response = () -> new WebResourceResponse(null, null, 204, "Empty", headers, null);
        answer(noData, 11, BASE, CONTEXT_DOCUMENT);
        check(last(noData).status == 204 && last(noData).body.length == 0
                && last(noData).headers.equals("Content-Type: application/external\r\n"), "null app body/explicit MIME header changed");
        WebViewOwnedResponsesHost file = new WebViewOwnedResponsesHost();
        TrackingBytes fileStream = new TrackingBytes(bytes("file response"));
        file.mContext.response = () -> new WebResourceResponse("text/file", null, fileStream);
        answer(file, 9, "file:///android_asset/sample.txt", CONTEXT_DOCUMENT);
        check(file.mContext.files == 1 && fileStream.closes == 1 && fileStream.reads > 0, "file stream lifecycle changed");
        check(Arrays.equals(last(file).body, bytes("file response")), "file response bytes changed");
        WebViewOwnedResponsesHost network = new WebViewOwnedResponsesHost();
        answer(network, 10, BASE, CONTEXT_DOCUMENT);
        check(last(network).status == 0 && last(network).body == null, "network fallthrough changed");
        network.mSettings.blockLoads = true;
        answer(network, 11, BASE, CONTEXT_DOCUMENT);
        check(last(network).status == 403 && last(network).body.length == 0, "blocked response changed");
        WebViewOwnedResponsesHost failure = pending(BASE, "one-shot", "text/html", "UTF-8");
        failure.mHost.failRespond = true;
        try { answer(failure, 12, BASE, CONTEXT_DOCUMENT); throw new AssertionError("native failure swallowed"); }
        catch (IllegalStateException expected) { check(failure.pendingBody() != null, "a failed response dropped the published document"); }
    }
    private static void fallback(WebViewOwnedResponsesHost provider) {
        provider.mInterceptsRequests = true;
        provider.mClient.response = () -> new WebResourceResponse("text/fallback", "UTF-8",
                new ByteArrayInputStream(bytes("app fallback")));
    }
    private static void barrier(CyclicBarrier barrier) {
        try { barrier.await(5, TimeUnit.SECONDS); }
        catch (Exception failure) { throw new AssertionError("claim barrier failed", failure); }
    }
    private static void concurrency() throws Exception {
        for (String replacementUrl : new String[] {BASE, "https://new.example/document"}) {
            WebViewOwnedResponsesHost provider = pending(BASE, "old", "text/old", "UTF-8");
            fallback(provider);
            provider.beforeClaim = () -> {
                provider.beforeClaim = null;
                provider.loadDataWithBaseURL(replacementUrl, "new", "text/new", "UTF-8", null);
            };
            answer(provider, 1, BASE, CONTEXT_DOCUMENT);
            boolean same = replacementUrl.equals(BASE);
            check(same ? last(provider).headers.equals("Content-Type: text/new; charset=UTF-8\r\n")
                            && Arrays.equals(last(provider).body, bytes("new"))
                    : last(provider).headers.equals("Content-Type: text/fallback; charset=UTF-8\r\n")
                            && Arrays.equals(last(provider).body, bytes("app fallback")),
                    "a request during a replacement mixed documents or skipped the ordinary fallback");
            check(Arrays.equals(provider.pendingBody(), bytes("new")) && provider.pendingMime().equals("text/new"),
                    "a request cleared/mixed a replacement document");
            answer(provider, 2, replacementUrl, CONTEXT_DOCUMENT);
            check(last(provider).headers.equals("Content-Type: text/new; charset=UTF-8\r\n")
                    && Arrays.equals(last(provider).body, bytes("new")), "replacement body/MIME snapshot changed");
            check(provider.mClient.calls.get() == (same ? 0 : 1), "replacement answer duplicated app callback");
        }
        for (int run = 0; run < 80; ++run) {
            WebViewOwnedResponsesHost provider = pending(BASE, "one owner", "text/owned", "UTF-8");
            fallback(provider);
            CyclicBarrier claim = new CyclicBarrier(2);
            provider.beforeClaim = () -> barrier(claim);
            AtomicReference<Throwable> failure = new AtomicReference<>();
            Thread[] requests = new Thread[2];
            for (int i = 0; i < requests.length; ++i) {
                final long id = i;
                requests[i] = new Thread(() -> {
                    try { answer(provider, id, BASE, CONTEXT_DOCUMENT); }
                    catch (Throwable problem) { failure.compareAndSet(null, problem); }
                });
                requests[i].start();
            }
            for (Thread request : requests) { request.join(5000); check(!request.isAlive(), "document worker deadlocked"); }
            if (failure.get() != null) throw new AssertionError(failure.get());
            check(provider.mHost.deliveries.size() == 2, "document response was lost/duplicated");
            long owners = provider.mHost.deliveries.stream().filter(d -> Arrays.equals(d.body, bytes("one owner"))).count();
            // Two navigations' requests (the first one superseded) both get the document.
            check(owners == 2 && provider.mClient.calls.get() == 0 && provider.pendingBody() != null,
                    "concurrent requests for the published document did not both get it");
        }
        WebViewOwnedResponsesHost admitted = pending(BASE, "old snapshot", "text/old", "UTF-8");
        admitted.mHost.beforeRespond = () -> {
            admitted.mHost.beforeRespond = null;
            admitted.loadDataWithBaseURL(BASE, "new snapshot", "text/new", "UTF-8", null);
        };
        answer(admitted, 3, BASE, CONTEXT_DOCUMENT);
        check(Arrays.equals(last(admitted).body, bytes("old snapshot")) && last(admitted).headers.contains("text/old;"),
                "admitted response changed during replacement before JNI copy");
        check(Arrays.equals(admitted.pendingBody(), bytes("new snapshot")), "admitted old request cleared a later publication");
        answer(admitted, 4, BASE, CONTEXT_DOCUMENT);
        check(Arrays.equals(last(admitted).body, bytes("new snapshot")) && last(admitted).headers.contains("text/new;"),
                "new publication was lost after admitted old response");
    }
    private static void measurement(boolean gate) throws Exception {
        WebViewOwnedResponsesHost warm = pending(BASE, "warmup", "text/html", "UTF-8");
        answer(warm, 0, BASE, CONTEXT_DOCUMENT);
        int length = 8 * 1024 * 1024;
        byte[] expected = new byte[length];
        for (int i = 0; i < length; ++i) expected[i] = (byte) (i * 37 + 13);
        WebViewOwnedResponsesHost provider = pending(BASE, java.util.Base64.getEncoder().encodeToString(expected),
                "application/octet-stream", "base64");
        provider.mHost.nativeCopy = false;
        provider.mHost.deliveries.ensureCapacity(4);
        byte[] privateBody = provider.pendingBody();
        com.sun.management.ThreadMXBean bean = (com.sun.management.ThreadMXBean) ManagementFactory.getThreadMXBean();
        bean.setThreadAllocatedMemoryEnabled(true);
        long before = bean.getThreadAllocatedBytes(Thread.currentThread().getId());
        answer(provider, 1, BASE, CONTEXT_DOCUMENT);
        long allocated = bean.getThreadAllocatedBytes(Thread.currentThread().getId()) - before;
        Delivery response = last(provider);
        check(Arrays.equals(response.body, expected), "large owned body changed");
        check(response.headers.equals("Content-Type: application/octet-stream; charset=UTF-8\r\n"), "large body metadata changed");
        System.out.println("WebView owned response: bytes=" + length + " allocated_bytes=" + allocated
                + " original_private_array=" + (response.body == privateBody)
                + " (unchanged native JNI/COM copies excluded)");
        if (gate) {
            check(response.body == privateBody, "owned private response was copied through an InputStream");
            check(allocated < 64 * 1024, "owned response allocated full-body aggregation storage");
        }
    }
    public static void main(String[] args) throws Exception {
        switch (args[0]) {
            case "behavior": ownedCases(); streamsAndHeaders(); navigationCases(); break;
            case "concurrency": concurrency(); break;
            case "measurement": measurement(args[1].equals("gate")); break;
            default: throw new IllegalArgumentException(args[0]);
        }
        System.out.println("WebView owned response " + args[0] + " PASS: " + checks + " checks");
    }
}
