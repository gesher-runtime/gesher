package com.gesher.server;

import java.util.*;

public final class Camera2CaptureDispatchHost {
    private static final boolean SCAN_GATE = @SCAN_GATE@;
    private static final List<String> EVENTS = new ArrayList<>();
    private static int checks;
    private static boolean record = true, openFails, readFails, deliverFails;
    private static int openWidth, openHeight, opens;

    @PRODUCTION@

    private final Object mLock = new Object();
    private final CountingMap mStreams = new CountingMap();
    private final ArrayDeque<Frame> frames = new ArrayDeque<>();
    private final String mCameraId = "test";
    private final Device mDevice = new Device();
    private final Callbacks mCallbacks = new Callbacks();
    private WindowsCamera.Capture mCapture;
    private Size mCaptureFor;

    private Frame next(CaptureTiming timing) { return frames.poll(); }
    private void fail(Frame f, int error) { f.callbacks.terminal = true; event("fail:" + f.frameNumber + ":" + error); }
    private static CaptureResultExtras extras(int request, int subsequence, long frame) {
        return extras(request, subsequence, frame, -1);
    }
    private static CaptureResultExtras extras(int request, int subsequence, long frame, int stream) {
        return new CaptureResultExtras(frame, stream);
    }
    private static CameraMetadataNative result(CameraMetadataNative settings, long timestamp) {
        return settings;
    }
    private static void event(String value) { if (record) EVENTS.add(value); }
    private static void check(boolean condition, String message) {
        checks++;
        if (!condition) throw new AssertionError(message + " events=" + EVENTS);
    }
    private static void events(String... expected) {
        check(EVENTS.equals(Arrays.asList(expected)), "capture transcript " + Arrays.toString(expected));
    }

    private static final class CountingMap extends HashMap<Integer, Stream> {
        int queries;
        @Override public Stream get(Object key) { queries++; return super.get(key); }
    }
    private static final class Stream {
        final List<Surface> surfaces = new ArrayList<>();
        final Size size;
        final int format;
        Stream(int width, int height, int format, int id) {
            size = new Size(width, height); this.format = format;
            surfaces.add(new Surface(id)); surfaces.add(new Surface(id + 10));
        }
    }
    private static final class Surface { final int id; Surface(int id) { this.id = id; } }
    private static final class Size {
        final int width, height;
        Size(int width, int height) { this.width = width; this.height = height; }
        int getWidth() { return width; } int getHeight() { return height; }
        @Override public boolean equals(Object o) {
            return o instanceof Size && ((Size) o).width == width && ((Size) o).height == height;
        }
        @Override public int hashCode() { return width * 31 + height; }
    }
    private static final class Device { final String id = "device", name = "fake"; }
    private static final class Request {
        final int requestId = 7;
        final CameraMetadataNative settings = new CameraMetadataNative();
        final int[] streamIds, surfaceIds;
        Request(int[] streams, int[] surfaces) { streamIds = streams; surfaceIds = surfaces; }
    }
    private final class Frame {
        final Request request;
        final int subsequenceId = 0;
        final long frameNumber;
        boolean imageCaptured;
        final FrameCallbacks callbacks = new FrameCallbacks();
        Frame(Request request, long number) { this.request = request; frameNumber = number; }
    }
    private static final class CameraMetadataNative {
        Byte quality = 81;
        Byte get(Object key) { return quality; }
    }
    private static final class CaptureRequest { static final Object JPEG_QUALITY = new Object(); }
    private static final class CaptureResultExtras {
        final long frame;
        final int stream;
        CaptureResultExtras(long frame, int stream) { this.frame = frame; this.stream = stream; }
    }
    private static final class PhysicalCaptureResultInfo {}
    private static final class CameraMetadataInfo {
        static CameraMetadataNative metadata(CameraMetadataNative value) { return value; }
    }
    private static final class RemoteException extends Exception {}
    private static final class ICameraDeviceCallbacks {
        static final int ERROR_CAMERA_DEVICE = 1, ERROR_CAMERA_BUFFER = 5, ERROR_CAMERA_REQUEST = 3, ERROR_CAMERA_RESULT = 4;
    }
    private static final class SystemClock {
        static long elapsedRealtimeNanos() { return 1234567; }
        static long elapsedRealtime() { return 0; }
    }
    private static final class CameraService {
        static final int HAL_BLOB = 33;
        static void log(String message) {}
    }
    private static final class WindowsCamera {
        static final class OpenException extends Exception {}
        static final class Capture {
            int width, height;
            int read(byte[] output) {
                event("read:" + output.length);
                if (readFails) { readFails = false; return -1; }
                output[0] = 42;
                return 0;
            }
            void close() { event("close:" + width + "x" + height); }
        }
        static Capture open(String device, int width, int height) throws OpenException {
            opens++; openWidth = width; openHeight = height;
            event("open:" + width + "x" + height);
            if (openFails) { openFails = false; throw new OpenException(); }
            Capture value = new Capture(); value.width = width; value.height = height; return value;
        }
    }
    private static final class CameraFrames {
        static final int OK = 0;
        static byte[] jpeg(byte[] data, int w, int h, int tw, int th, int quality) {
            event("jpeg:" + tw + "x" + th + ":" + quality);
            return new byte[] {1, 2, 3};
        }
        static int deliver(Surface target, byte[] data, int w, int h, long timestamp, byte[] jpeg) {
            check(data[0] == 42 && w == openWidth && h == openHeight && timestamp == 1234567,
                    "capture source published to delivery");
            event("deliver:" + target.id + ":" + (jpeg == null ? "raw" : jpeg.length));
            return deliverFails ? 1 : 0;
        }
    }
    private final class FrameCallbacks {
        boolean terminal;
        boolean terminal() { return terminal; }
        void close() {}
        void onCaptureStarted(CaptureResultExtras extras, long timestamp) {
            try { mCallbacks.onCaptureStarted(extras, timestamp); }
            catch (RemoteException e) { throw new RuntimeException(e); }
        }
        void onDeviceError(int error, CaptureResultExtras extras) {
            if (error != ICameraDeviceCallbacks.ERROR_CAMERA_BUFFER) terminal = true;
            try { mCallbacks.onDeviceError(error, extras); }
            catch (RemoteException e) { throw new RuntimeException(e); }
        }
        void onResultReceived(CameraMetadataNative metadata, CaptureResultExtras extras,
                PhysicalCaptureResultInfo[] physical) {
            terminal = true;
            try { mCallbacks.onResultReceived(metadata, extras, physical); }
            catch (RemoteException e) { throw new RuntimeException(e); }
        }
    }
    private final class Callbacks {
        boolean removeJpeg, throwOnce;
        void onCaptureStarted(CaptureResultExtras extras, long timestamp) throws RemoteException {
            event("started:" + extras.frame);
            if (removeJpeg) mStreams.remove(2);
            if (throwOnce) { throwOnce = false; throw new RemoteException(); }
        }
        void onDeviceError(int error, CaptureResultExtras extras) throws RemoteException {
            event("error:" + extras.frame + ":" + extras.stream + ":" + error);
        }
        void onResultReceived(CameraMetadataNative metadata, CaptureResultExtras extras,
                PhysicalCaptureResultInfo[] physical) throws RemoteException {
            event("result:" + extras.frame);
        }
    }

    private static Camera2CaptureDispatchHost fixture() {
        EVENTS.clear(); openWidth = 0; openHeight = 0; opens = 0;
        openFails = false; readFails = false; deliverFails = false; record = true;
        Camera2CaptureDispatchHost fixture = new Camera2CaptureDispatchHost();
        fixture.mStreams.put(0, new Stream(640, 480, 1, 0));
        fixture.mStreams.put(1, new Stream(1280, 720, 1, 1)); // not requested; sets native capture size
        fixture.mStreams.put(2, new Stream(320, 240, CameraService.HAL_BLOB, 2));
        return fixture;
    }
    private void enqueue(long number) {
        frames.add(new Frame(new Request(new int[] {0, 2, 99}, new int[] {1, 99}), number));
    }

    private static void behavior() {
        Camera2CaptureDispatchHost f = fixture(); f.captureFrames();
        check(opens == 0, "idle loop does not open camera"); events();
        f.enqueue(0); f.enqueue(1); f.captureFrames();
        check(opens == 1 && openWidth == 1280 && openHeight == 720, "largest configured stream chosen once");
        events("open:1280x720", "read:1382400", "started:0", "deliver:10:raw", "jpeg:320x240:81",
                "deliver:2:3", "result:0", "read:1382400", "started:1", "deliver:10:raw",
                "jpeg:320x240:81", "deliver:2:3", "result:1");

        f = fixture(); f.enqueue(0); f.mCallbacks.removeJpeg = true; f.captureFrames();
        events("open:1280x720", "read:1382400", "started:0", "deliver:10:raw", "result:0");

        f = fixture(); f.enqueue(0); f.enqueue(1); openFails = true; f.captureFrames();
        check(opens == 2, "failed open retries subsequent admitted frame");
        events("open:1280x720", "fail:0:1", "open:1280x720", "read:1382400", "started:1",
                "deliver:10:raw", "jpeg:320x240:81", "deliver:2:3", "result:1");

        f = fixture(); f.enqueue(0); f.enqueue(1); readFails = true; f.captureFrames();
        events("open:1280x720", "read:1382400", "fail:0:1", "read:1382400", "started:1",
                "deliver:10:raw", "jpeg:320x240:81", "deliver:2:3", "result:1");

        f = fixture(); f.enqueue(0); deliverFails = true; f.captureFrames();
        events("open:1280x720", "read:1382400", "started:0", "deliver:10:raw", "error:0:0:5",
                "jpeg:320x240:81", "deliver:2:3", "error:0:2:5", "result:0");

        f = fixture(); f.enqueue(0); f.enqueue(1); f.mCallbacks.throwOnce = true; f.captureFrames();
        events("open:1280x720", "read:1382400", "started:0", "error:0:-1:@POST_CAPTURE_ERROR@", "read:1382400", "started:1",
                "deliver:10:raw", "jpeg:320x240:81", "deliver:2:3", "result:1");

        // endConfigure's open: at the largest configured size, before any request;
        // kept for the same size, reopened for another; frames then need no open.
        f = fixture(); f.openForConfiguration();
        check(opens == 1 && openWidth == 1280 && openHeight == 720, "configuration opens at the largest stream");
        f.openForConfiguration();
        check(opens == 1, "the same configuration keeps the open device");
        f.mStreams.remove(1); f.openForConfiguration();
        check(opens == 2 && openWidth == 640 && openHeight == 480, "another size reopens the device");
        f.enqueue(0); f.captureFrames();
        events("open:1280x720", "close:1280x720", "open:640x480", "read:460800", "started:0",
                "deliver:10:raw", "jpeg:320x240:81", "deliver:2:3", "result:0");

        // A configuration-time failure is not reported there; the first request retries
        // the open (and reports its failure as before, checked above).
        f = fixture(); openFails = true; f.openForConfiguration();
        check(opens == 1 && f.mCapture == null, "failed configuration open leaves no device");
        f.enqueue(0); f.captureFrames();
        events("open:1280x720", "open:1280x720", "read:1382400", "started:0", "deliver:10:raw",
                "jpeg:320x240:81", "deliver:2:3", "result:0");

        f = fixture(); f.mStreams.clear(); f.enqueue(0); f.captureFrames();
        check(openWidth == 640 && openHeight == 480, "empty configuration preserves default capture dimensions");
        events("open:640x480", "read:460800", "started:0", "result:0");
    }

    private static void measurement() {
        Camera2CaptureDispatchHost f = fixture();
        f.mStreams.remove(2);
        for (int n = 0; n < 1000; n++) f.enqueue(n);
        record = false;
        f.captureFrames();
        System.out.println("1000 admitted frames / 3 requested stream ids: map queries=" + f.mStreams.queries);
        if (SCAN_GATE) check(f.mStreams.queries == 3000, "one live lookup per requested stream id");
    }

    public static void main(String[] args) {
        behavior(); measurement();
        System.out.println("Camera2 capture dispatch checks passed: " + checks);
    }
}
