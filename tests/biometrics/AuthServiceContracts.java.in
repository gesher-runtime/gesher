    CharSequence getSubtitle() { return subtitle; }
    CharSequence getDescription() { return description; }
}

class RemoteException extends Exception {
    private static final long serialVersionUID = 1L;
}

interface IBinder {
    int FIRST_CALL_TRANSACTION = 1;
    interface DeathRecipient { void binderDied(); }
    void linkToDeath(DeathRecipient recipient, int flags) throws RemoteException;
    boolean unlinkToDeath(DeathRecipient recipient, int flags);
}

class Binder implements IBinder {
    static int callingUid, callingPid;
    static int getCallingUid() { return callingUid; }
    static int getCallingPid() { return callingPid; }
    IInterface local;
    void attachInterface(IInterface owner, String descriptor) { local = owner; }
    public void linkToDeath(IBinder.DeathRecipient r, int flags) {}
    public boolean unlinkToDeath(IBinder.DeathRecipient r, int flags) { return true; }
}

interface IInterface {
    IBinder asBinder();
}

