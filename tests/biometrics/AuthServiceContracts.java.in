// Host contracts for com.gesher.server.AuthService (ADR 0094). The production
// AuthService, WindowsHello, WindowsHelloBackend and StandIn are inserted unchanged apart from
// their package, imports and public class visibility; everything else here is a
// boundary stand-in with android-16.0.0_r4's constant values. FakeBackend is an
// isolated test double: production's only backend is WindowsHello. DeviceCredential (the
// availability decision), ConfirmCredential (ACTION_CONFIRM_DEVICE_CREDENTIAL) and
// OwnerWatch (the prompt's owner leaving the foreground) are production classes too.
import java.lang.reflect.*;
import java.util.*;
import java.util.concurrent.ConcurrentHashMap;
import java.util.function.*;
import java.util.concurrent.atomic.AtomicInteger;

public final class AuthServiceContracts {
    private static int failures, checks;

    static void check(boolean condition, String description) {
        checks++;
        System.out.println((condition ? "PASS " : "FAIL ") + description);
        if (!condition) failures++;
    }

    static boolean throwsSecurity(Runnable call, String fragment) {
        try {
            call.run();
            return false;
        } catch (SecurityException expected) {
            return fragment == null || String.valueOf(expected.getMessage()).contains(fragment);
        }
    }

    // --- the system server boundary -----------------------------------------------------

    static final class TestHost implements AuthService.Host {
        final Set<String> granted = new HashSet<>(Set.of(Manifest.permission.USE_BIOMETRIC));
        boolean appOpAllowed = true, foreground = true, deviceSecure;
        DeviceCredential trust;  // when set, isDeviceSecure is trust's answer: production's wiring
        final ArrayDeque<Runnable> queue = new ArrayDeque<>();
        public boolean hasPermission(String permission, int pid, int uid) {
            return pid == Binder.callingPid && uid == Binder.callingUid && granted.contains(permission);
        }
        public boolean noteUseBiometric(int uid, String packageName) { return packageName != null && appOpAllowed; }
        public boolean isForeground(int uid, int pid) { return foreground; }
        public boolean isDeviceSecure(int userId) { return trust != null ? trust.available() : deviceSecure; }
        public CharSequence string(String name) { return "res:" + name; }
        public synchronized void post(Runnable work) { queue.add(work); }
        void drain() {
            for (Runnable r; (r = poll()) != null; ) r.run();
        }
        synchronized Runnable poll() { return queue.poll(); }
        synchronized int pending() { return queue.size(); }
    }

    static final class FakeBackend implements WindowsHelloBackend {
        int availability = AVAILABLE;
        /** Answers handed out first, one per availability() call, before {@link #availability}. */
        final java.util.ArrayDeque<Integer> script = new java.util.ArrayDeque<>();
        int queries;
        RuntimeException verifyThrows;
        final List<Request> requests = new ArrayList<>();
        final List<WindowsHelloBackend.Completion> completions = new ArrayList<>();
        final AtomicInteger cancels = new AtomicInteger();
        public int availability() {
            queries++;
            return script.isEmpty() ? availability : script.poll();
        }
        public Verification verify(Request request, Completion completion) {
            if (verifyThrows != null) throw verifyThrows;
            requests.add(request);
            completions.add(completion);
            return cancels::incrementAndGet;
        }
        void complete(int index, int result) { completions.get(index).onResult(result); }
    }

    static final List<String> events = new ArrayList<>();

    static final class Receiver implements IBiometricServiceReceiver, IBinder {
        final String name;
        final List<String> calls = new ArrayList<>();
        IBinder.DeathRecipient recipient;
        boolean dead;
        int unlinks;
        Receiver(String name) { this.name = name; }
        private void record(String call) { calls.add(call); events.add(name + ":" + call); }
        public void onAuthenticationSucceeded(int type) { record("succeeded(" + type + ")"); }
        public void onAuthenticationFailed() { record("failed"); }
        public void onError(int modality, int error, int vendorCode) {
            record("error(" + modality + "," + error + "," + vendorCode + ")");
        }
        public void onAcquired(int info, String message) { record("acquired"); }
        public void onDialogDismissed(int reason) { record("dismissed(" + reason + ")"); }
        public void onSystemEvent(int event) { record("event"); }
        public IBinder asBinder() { return this; }
        public void linkToDeath(IBinder.DeathRecipient r, int flags) throws RemoteException {
            if (dead) throw new RemoteException();
            recipient = r;
        }
        public boolean unlinkToDeath(IBinder.DeathRecipient r, int flags) {
            unlinks++;
            boolean was = recipient == r;
            recipient = null;
            return was;
        }
        void die() { dead = true; if (recipient != null) recipient.binderDied(); }
    }

    static final class Token implements IBinder {
        public void linkToDeath(IBinder.DeathRecipient r, int flags) {}
        public boolean unlinkToDeath(IBinder.DeathRecipient r, int flags) { return true; }
    }

    static PromptInfo prompt(int authenticators) {
        PromptInfo info = new PromptInfo();
        info.authenticators = authenticators;
        info.title = "Sign in";
        info.subtitle = "Bank";
        info.description = "Confirm it's you";
        return info;
    }

    static final int WEAK = Authenticators.BIOMETRIC_WEAK, STRONG = Authenticators.BIOMETRIC_STRONG,
            CRED = Authenticators.DEVICE_CREDENTIAL, ID = Authenticators.IDENTITY_CHECK;

    static TestHost host;
    static FakeBackend backend;
    static AuthService service;
    static DeviceCredential credential;
    static final int WINDOWS_10 = 19045, WINDOWS_11 = 22000;

    /** Production's wiring: trust and auth read one DeviceCredential. */
    static void wired(int availabilityAtStart, int windowsBuild) {
        host = new TestHost();
        backend = new FakeBackend();
        backend.availability = availabilityAtStart;
        credential = new DeviceCredential(backend, windowsBuild);
        host.trust = credential;
        service = new AuthService(host, credential);
        Binder.callingUid = 10123;
        Binder.callingPid = 4321;
        events.clear();
    }

    static void fresh(boolean secure, boolean withBackend) {
        host = new TestHost();
        host.deviceSecure = secure;
        backend = withBackend ? new FakeBackend() : null;
        credential = new DeviceCredential(backend, WINDOWS_11);
        service = new AuthService(host, credential);
        Binder.callingUid = 10123;
        Binder.callingPid = 4321;
        events.clear();
    }

    static long start(Receiver receiver, IBinder token, PromptInfo info) {
        return service.authenticate(token, 0L, 0, receiver, "com.example.bank", info);
    }

    // --- unavailable backend: AOSP's sensor-less, unsecured device ------------------------

    static void unavailable() {
        fresh(false, false);
        check(service.canAuthenticate("p", 0, WEAK) == 12, "no sensors: BIOMETRIC_WEAK is NO_HARDWARE (12)");
        check(service.canAuthenticate("p", 0, STRONG) == 12, "no sensors: BIOMETRIC_STRONG is NO_HARDWARE (12)");
        check(service.canAuthenticate("p", 0, CRED) == 11, "unsecured: DEVICE_CREDENTIAL is NONE_ENROLLED (11)");
        check(service.canAuthenticate("p", 0, STRONG | CRED) == 11, "unsecured: STRONG|CREDENTIAL is NONE_ENROLLED (11)");
        check(service.canAuthenticate("p", 0, WEAK | CRED) == 11, "unsecured: WEAK|CREDENTIAL is NONE_ENROLLED (11)");
        check(service.canAuthenticate("p", 0, 0) == 12, "no authenticators: NO_HARDWARE, as PreAuthInfo");
        check(throwsSecurity(() -> service.canAuthenticate("p", 0, Authenticators.BIOMETRIC_CONVENIENCE),
                "Invalid authenticator configuration"), "BIOMETRIC_CONVENIENCE is an invalid configuration");
        check(throwsSecurity(() -> service.canAuthenticate("p", 0, 1 << 20), "Invalid authenticator"),
                "unknown authenticator bits are invalid");
        check(throwsSecurity(() -> service.canAuthenticate("p", 0, ID), "SET_BIOMETRIC_DIALOG_ADVANCED"),
                "IDENTITY_CHECK needs SET_BIOMETRIC_DIALOG_ADVANCED (androidx's probe)");
        host.granted.add(AuthService.SET_BIOMETRIC_DIALOG_ADVANCED);
        check(service.canAuthenticate("p", 0, ID) == 20, "IDENTITY_CHECK is never active (20)");
        host.granted.remove(AuthService.SET_BIOMETRIC_DIALOG_ADVANCED);

        host.granted.clear();
        check(throwsSecurity(() -> service.canAuthenticate("p", 0, WEAK), "USE_BIOMETRIC"),
                "canAuthenticate needs USE_BIOMETRIC or USE_FINGERPRINT");
        host.granted.add(Manifest.permission.USE_FINGERPRINT);
        check(service.canAuthenticate("p", 0, WEAK) == 12, "USE_FINGERPRINT is accepted for USE_BIOMETRIC");
        check(throwsSecurity(() -> service.canAuthenticate("p", 10, WEAK), "USE_BIOMETRIC_INTERNAL"),
                "another user needs USE_BIOMETRIC_INTERNAL");
        check(service.getAuthenticatorIds(0).length == 0,
                "getAuthenticatorIds for the caller's user: unchecked and empty");
        check(throwsSecurity(() -> service.hasEnrolledBiometrics(0, "p"), "USE_BIOMETRIC_INTERNAL"),
                "hasEnrolledBiometrics is internal");
        check(throwsSecurity(() -> service.getEnrollmentStatusList(0, "p"), "SET_BIOMETRIC_DIALOG_ADVANCED"),
                "getEnrollmentStatusList needs SET_BIOMETRIC_DIALOG_ADVANCED");
        host.granted.add(AuthService.SET_BIOMETRIC_DIALOG_ADVANCED);
        check(service.getEnrollmentStatusList(0, "p").isEmpty(), "no enrollments without sensors");
        host.granted.add(Manifest.permission.USE_BIOMETRIC);

        check(service.getLastAuthenticationTime(0, CRED) == -1L,
                "getLastAuthenticationTime: BIOMETRIC_NO_AUTHENTICATION");
        check("res:screen_lock_app_setting_name".equals(String.valueOf(service.getButtonLabel(0, "p", WEAK | CRED))),
                "Strings: credential button label is screen_lock_app_setting_name");
        check(service.getButtonLabel(0, "p", STRONG) == null, "Strings: biometric-only label is null");
        check("res:screen_lock_dialog_default_subtitle".equals(String.valueOf(service.getPromptMessage(0, "p", CRED))),
                "Strings: credential prompt message");
        check("res:screen_lock_app_setting_name".equals(String.valueOf(service.getSettingName(0, "p", CRED))),
                "Strings: credential setting name");
        check(throwsSecurity(() -> service.getSettingName(0, "p", 0x3), "Invalid"),
                "Strings validate the configuration");

        Receiver r = new Receiver("a");
        long id = start(r, new Token(), prompt(WEAK));
        check(id > 0 && r.calls.isEmpty(), "authenticate returns a request id; the outcome is posted");
        host.drain();
        check(r.calls.equals(List.of("error(0,12,0)")), "biometric prompt: onError(TYPE_NONE, HW_NOT_PRESENT)");

        r = new Receiver("b");
        start(r, new Token(), prompt(STRONG | CRED));
        host.drain();
        check(r.calls.equals(List.of("error(1,14,0)")), "credential, unsecured: onError(TYPE_CREDENTIAL, NO_DEVICE_CREDENTIAL)");

        r = new Receiver("c");
        PromptInfo legacy = prompt(0);
        legacy.deviceCredentialAllowed = true;
        start(r, new Token(), legacy);
        host.drain();
        check(r.calls.equals(List.of("error(1,14,0)")) && legacy.authenticators == 0,
                "setDeviceCredentialAllowed: CREDENTIAL|WEAK, without changing the app's PromptInfo");
        r = new Receiver("d");
        start(r, new Token(), prompt(0));
        host.drain();
        check(r.calls.equals(List.of("error(0,12,0)")), "no authenticators set: BIOMETRIC_WEAK");

        check(throwsSecurity(() -> start(new Receiver("e"), new Token(), prompt(0x3)), "Invalid"),
                "authenticate rejects an invalid configuration");
        PromptInfo internal = prompt(CRED);
        internal.internal = true;
        check(throwsSecurity(() -> start(new Receiver("f"), new Token(), internal), "USE_BIOMETRIC_INTERNAL"),
                "internal prompt options need USE_BIOMETRIC_INTERNAL");

        host.foreground = false;
        r = new Receiver("g");
        check(start(r, new Token(), prompt(CRED)) == -1 && r.calls.equals(List.of("error(0,5,0)")),
                "not foreground: synchronous onError(TYPE_NONE, CANCELED), -1");
        host.foreground = true;
        host.appOpAllowed = false;
        r = new Receiver("h");
        check(start(r, new Token(), prompt(CRED)) == -1 && r.calls.equals(List.of("error(0,5,0)")),
                "OP_USE_BIOMETRIC denied: onError(TYPE_NONE, CANCELED), -1");
        host.appOpAllowed = true;
        r = new Receiver("i");
        check(start(r, new Token(), null) == -1 && r.calls.equals(List.of("error(0,5,0)")),
                "null PromptInfo: onError(TYPE_NONE, CANCELED), -1");
        host.drain();
        check(host.pending() == 0, "fast failures post no work");

        // trust secure, but no natives: nothing may succeed.
        fresh(true, false);
        check(service.canAuthenticate("p", 0, CRED) == 0, "secured: DEVICE_CREDENTIAL is SUCCESS (trust decides)");
        check(service.canAuthenticate("p", 0, STRONG) == 12, "secured: biometrics stay NO_HARDWARE");
        r = new Receiver("j");
        start(r, new Token(), prompt(CRED));
        host.drain();
        check(r.calls.equals(List.of("error(1,1,0)")), "no backend: onError(TYPE_CREDENTIAL, HW_UNAVAILABLE), never success");
    }

    // --- an available backend (test double) ----------------------------------------------

    static void available() throws Exception {
        fresh(true, true);
        Receiver r = new Receiver("a");
        start(r, new Token(), prompt(STRONG | CRED));
        host.drain();
        check(backend.requests.size() == 1, "STRONG|CREDENTIAL on a secured device: one Windows Hello verification");
        WindowsHelloBackend.Request q = backend.requests.get(0);
        check(q.uid == 10123 && q.pid == 4321 && "com.example.bank".equals(q.packageName)
                && "Sign in\nBank\nConfirm it's you".equals(q.message),
                "the request names the caller and carries title, subtitle and description");
        check(r.recipient != null, "the session links to the client's death");
        backend.complete(0, WindowsHelloBackend.VERIFIED);
        check(r.calls.isEmpty(), "a backend result is posted, not delivered on Windows' thread");
        host.drain();
        check(r.calls.equals(List.of("succeeded(1)")), "Verified: onAuthenticationSucceeded(DEVICE_CREDENTIAL)");
        check(r.unlinks == 1, "the finished session unlinks from the client");
        backend.complete(0, WindowsHelloBackend.VERIFIED);
        host.drain();
        check(r.calls.size() == 1, "a second result for a finished request is dropped");

        int[][] outcomes = {
                {WindowsHelloBackend.CANCELED, 10}, {WindowsHelloBackend.RETRIES_EXHAUSTED, 7},
                {WindowsHelloBackend.NOT_CONFIGURED_FOR_USER, 14}, {WindowsHelloBackend.DEVICE_BUSY, 1},
                {WindowsHelloBackend.DEVICE_NOT_PRESENT, 1}, {WindowsHelloBackend.DISABLED_BY_POLICY, 1},
                {WindowsHelloBackend.FAILED, 1}};
        String[] names = {"user Canceled → USER_CANCELED", "RetriesExhausted → LOCKOUT",
                "NotConfiguredForUser → NO_DEVICE_CREDENTIAL", "DeviceBusy → HW_UNAVAILABLE",
                "DeviceNotPresent → HW_UNAVAILABLE", "DisabledByPolicy → HW_UNAVAILABLE",
                "failure → HW_UNAVAILABLE"};
        for (int i = 0; i < outcomes.length; i++) {
            fresh(true, true);
            r = new Receiver("o");
            start(r, new Token(), prompt(CRED));
            host.drain();
            backend.complete(0, outcomes[i][0]);
            host.drain();
            check(r.calls.equals(List.of("error(1," + outcomes[i][1] + ",0)")), names[i]);
        }

        // The app cancels: CANCELED now, Windows' later Canceled is dropped.
        fresh(true, true);
        r = new Receiver("a");
        Token token = new Token();
        long id = start(r, token, prompt(CRED));
        host.drain();
        service.cancelAuthentication(new Token(), "com.example.bank", id);
        service.cancelAuthentication(token, "com.example.bank", id + 1);
        host.drain();
        check(r.calls.isEmpty() && backend.cancels.get() == 0, "cancel for another token or request id is ignored");
        service.cancelAuthentication(token, "com.example.bank", id);
        host.drain();
        check(backend.cancels.get() == 1 && r.calls.equals(List.of("error(1,5,0)")),
                "cancelAuthentication: Windows' prompt closed, onError(TYPE_CREDENTIAL, CANCELED)");
        backend.complete(0, WindowsHelloBackend.CANCELED);
        host.drain();
        check(r.calls.size() == 1, "Windows' Canceled after the app's cancel is not a USER_CANCELED");
        host.granted.clear();
        check(throwsSecurity(() -> service.cancelAuthentication(token, "p", id), "USE_BIOMETRIC"),
                "cancelAuthentication needs USE_BIOMETRIC");

        // Cancel issued before the posted start ran still ends that request.
        fresh(true, true);
        r = new Receiver("a");
        Token early = new Token();
        long earlyId = start(r, early, prompt(CRED));
        service.cancelAuthentication(early, "com.example.bank", earlyId);
        host.drain();
        check(r.calls.equals(List.of("error(1,5,0)")) && backend.cancels.get() == 1,
                "cancel right after authenticate: the request still ends with CANCELED");

        // A new prompt replaces the current one.
        fresh(true, true);
        Receiver first = new Receiver("first"), second = new Receiver("second");
        start(first, new Token(), prompt(CRED));
        host.drain();
        start(second, new Token(), prompt(CRED));
        host.drain();
        check(first.calls.equals(List.of("error(1,5,0)")) && backend.cancels.get() == 1
                && backend.requests.size() == 2, "a new prompt cancels the current one (CANCELED) and starts");
        check(events.indexOf("first:error(1,5,0)") == 0, "the replaced client hears CANCELED before anything else");
        backend.complete(0, WindowsHelloBackend.VERIFIED);
        backend.complete(1, WindowsHelloBackend.VERIFIED);
        host.drain();
        check(first.calls.size() == 1 && second.calls.equals(List.of("succeeded(1)")),
                "the replaced request's late Verified is dropped; the new one succeeds");

        // A prompt that cannot start leaves the current one running (getPreAuthenticateStatus).
        fresh(true, true);
        first = new Receiver("first");
        second = new Receiver("second");
        start(first, new Token(), prompt(CRED));
        host.drain();
        start(second, new Token(), prompt(WEAK));
        host.drain();
        check(first.calls.isEmpty() && second.calls.equals(List.of("error(0,12,0)")),
                "a biometric-only prompt fails with NO_HARDWARE and does not cancel the current one");
        backend.complete(0, WindowsHelloBackend.VERIFIED);
        host.drain();
        check(first.calls.equals(List.of("succeeded(1)")), "the current prompt still completes");

        // The client dies.
        fresh(true, true);
        r = new Receiver("a");
        start(r, new Token(), prompt(CRED));
        host.drain();
        r.die();
        host.drain();
        check(backend.cancels.get() == 1 && r.calls.isEmpty(), "client death: Windows' prompt closed, no callback");
        backend.complete(0, WindowsHelloBackend.VERIFIED);
        host.drain();
        check(r.calls.isEmpty(), "a result after the client died is dropped");
        Receiver next = new Receiver("next");
        start(next, new Token(), prompt(CRED));
        host.drain();
        check(backend.requests.size() == 2 && next.calls.isEmpty() && backend.cancels.get() == 1,
                "after a death the next prompt starts without cancelling anything");

        fresh(true, true);
        r = new Receiver("a");
        r.dead = true;
        start(r, new Token(), prompt(CRED));
        host.drain();
        check(backend.requests.isEmpty(), "a client already dead gets no Windows prompt");

        // Requests the backend cannot honour.
        fresh(true, true);
        backend.availability = WindowsHelloBackend.NOT_CONFIGURED_FOR_USER;
        r = new Receiver("a");
        start(r, new Token(), prompt(CRED));
        host.drain();
        check(backend.requests.isEmpty() && r.calls.equals(List.of("error(1,14,0)")),
                "Hello not configured: NO_DEVICE_CREDENTIAL without a prompt");
        backend.availability = WindowsHelloBackend.DEVICE_BUSY;
        r = new Receiver("b");
        start(r, new Token(), prompt(CRED));
        host.drain();
        check(backend.requests.isEmpty() && r.calls.equals(List.of("error(1,1,0)")),
                "Hello busy: HW_UNAVAILABLE without a prompt");
        backend.availability = WindowsHelloBackend.AVAILABLE;
        r = new Receiver("c");
        service.authenticate(new Token(), 0x1234L, 0, r, "com.example.bank", prompt(CRED));
        host.drain();
        check(backend.requests.isEmpty() && r.calls.equals(List.of("error(1,1,0)")),
                "a keystore-bound request (operationId) is never confirmed: HW_UNAVAILABLE");
        backend.verifyThrows = new IllegalStateException("no window");
        r = new Receiver("d");
        start(r, new Token(), prompt(CRED));
        host.drain();
        check(r.calls.equals(List.of("error(1,1,0)")), "a verification that cannot start: HW_UNAVAILABLE");
        backend.verifyThrows = null;
        Receiver after = new Receiver("e");
        start(after, new Token(), prompt(CRED));
        host.drain();
        check(backend.requests.size() == 1 && after.calls.isEmpty(), "the service recovers after a failed start");

        // A result from Windows' own thread.
        fresh(true, true);
        r = new Receiver("a");
        start(r, new Token(), prompt(CRED));
        host.drain();
        Thread windows = new Thread(() -> backend.complete(0, WindowsHelloBackend.VERIFIED));
        windows.start();
        windows.join();
        check(r.calls.isEmpty() && host.pending() == 1, "a completion on another thread is queued");
        host.drain();
        check(r.calls.equals(List.of("succeeded(1)")), "and delivered once on the service's thread");

        // Biometric results never appear.
        check(!events.toString().contains("succeeded(2)"), "AUTHENTICATION_RESULT_TYPE_BIOMETRIC is never reported");
    }

    // --- keystore operations (ADR 0095): isolated test double of KeystoreOperations --------

    static final class FakeKeys implements KeystoreOperations {
        final Map<Long, Integer> pending = new HashMap<>();
        final List<String> authorizations = new ArrayList<>();
        final List<WindowsHelloBackend.Completion> completions = new ArrayList<>();
        final AtomicInteger cancels = new AtomicInteger();
        public boolean isPending(int uid, long operationId) {
            Integer owner = pending.get(operationId);
            return owner != null && owner == uid;
        }
        public WindowsHelloBackend.Verification authorize(WindowsHelloBackend.Request request,
                long operationId, WindowsHelloBackend.Completion completion) {
            authorizations.add(request.uid + ":" + request.pid + ":" + operationId);
            completions.add(completion);
            return cancels::incrementAndGet;
        }
    }

    static void keystore() {
        fresh(true, true);
        FakeKeys keys = new FakeKeys();
        service = new AuthService(host, credential, keys);
        Receiver r = new Receiver("a");
        service.authenticate(new Token(), 0x1234L, 0, r, "com.example.bank", prompt(CRED));
        host.drain();
        check(backend.requests.isEmpty() && keys.authorizations.isEmpty()
                        && r.calls.equals(List.of("error(1,1,0)")),
                "an operation id the keystore does not hold is never confirmed: HW_UNAVAILABLE, no prompt");
        keys.pending.put(0x1234L, 10999);
        r = new Receiver("b");
        service.authenticate(new Token(), 0x1234L, 0, r, "com.example.bank", prompt(CRED));
        host.drain();
        check(keys.authorizations.isEmpty() && r.calls.equals(List.of("error(1,1,0)")),
                "another uid's operation is never confirmed: HW_UNAVAILABLE, no prompt");
        keys.pending.put(0x1234L, 10123);
        r = new Receiver("c");
        service.authenticate(new Token(), 0x1234L, 0, r, "com.example.bank", prompt(STRONG));
        host.drain();
        check(keys.authorizations.isEmpty() && r.calls.equals(List.of("error(0,12,0)")),
                "a biometric-only crypto prompt stays HW_NOT_PRESENT: no sensor, no prompt");
        r = new Receiver("d");
        service.authenticate(new Token(), 0x1234L, 0, r, "com.example.bank", prompt(STRONG | CRED));
        host.drain();
        check(keys.authorizations.equals(List.of("10123:4321:" + 0x1234L)) && backend.requests.isEmpty()
                        && r.calls.isEmpty(),
                "the caller's pending operation: one prompt, the key's, and not the verifier's too");
        keys.completions.get(0).onResult(WindowsHelloBackend.VERIFIED);
        host.drain();
        check(r.calls.equals(List.of("succeeded(1)")),
                "authorized operation: onAuthenticationSucceeded(DEVICE_CREDENTIAL), never BIOMETRIC");
        int[][] outcomes = {{WindowsHelloBackend.CANCELED, 10}, {WindowsHelloBackend.FAILED, 1},
                {-2, 1}, {WindowsHelloBackend.RETRIES_EXHAUSTED, 7}};
        for (int[] outcome : outcomes) {
            r = new Receiver("e");
            service.authenticate(new Token(), 0x1234L, 0, r, "com.example.bank", prompt(CRED));
            host.drain();
            keys.completions.get(keys.completions.size() - 1).onResult(outcome[0]);
            host.drain();
            check(r.calls.equals(List.of("error(1," + outcome[1] + ",0)")),
                    "key authorization result " + outcome[0] + " is error " + outcome[1] + ", never success");
        }
        r = new Receiver("f");
        IBinder token = new Token();
        long id = service.authenticate(token, 0x1234L, 0, r, "com.example.bank", prompt(CRED));
        host.drain();
        int before = keys.cancels.get();
        service.cancelAuthentication(token, "com.example.bank", id);
        host.drain();
        check(keys.cancels.get() == before + 1 && r.calls.equals(List.of("error(1,5,0)")),
                "cancelAuthentication closes the key's prompt and reports CANCELED");
        keys.completions.get(keys.completions.size() - 1).onResult(WindowsHelloBackend.VERIFIED);
        host.drain();
        check(r.calls.size() == 1, "a late authorization after cancel is dropped");
        // No verifier natives at all: no device credential, so no key prompt either (#471 review).
        service = new AuthService(host, new DeviceCredential(null, WINDOWS_11), keys);
        r = new Receiver("g");
        service.authenticate(new Token(), 0x1234L, 0, r, "com.example.bank", prompt(CRED));
        host.drain();
        check(r.calls.equals(List.of("error(1,1,0)")) && keys.authorizations.size() == 6,
                "a pending operation without the device credential's backend: HW_UNAVAILABLE, no key prompt");
        r = new Receiver("h");
        service.authenticate(new Token(), 0L, 0, r, "com.example.bank", prompt(CRED));
        host.drain();
        check(r.calls.equals(List.of("error(1,1,0)")), "and a plain prompt without the verifier stays HW_UNAVAILABLE");
    }

    // --- combined head (#470 + #471): keys follow the device credential -----------------

    /** A CryptoObject prompt on the system's wiring: trust and auth read one DeviceCredential. */
    static void keystoreCredential() {
        int[][] cases = {
            // Windows' answer now, then the expected onError(TYPE_CREDENTIAL, error)
            {WindowsHelloBackend.DEVICE_BUSY, 1},
            {WindowsHelloBackend.FAILED, 1},
            {WindowsHelloBackend.DISABLED_BY_POLICY, 14},
            {WindowsHelloBackend.NOT_CONFIGURED_FOR_USER, 14},
        };
        for (int[] c : cases) {
            wired(WindowsHelloBackend.AVAILABLE, WINDOWS_11);
            FakeKeys keys = new FakeKeys();
            keys.pending.put(0x1234L, 10123);
            service = new AuthService(host, credential, keys);
            backend.availability = c[0];
            Receiver r = new Receiver("k" + c[0]);
            service.authenticate(new Token(), 0x1234L, 0, r, "com.example.bank", prompt(CRED));
            host.drain();
            check(keys.authorizations.isEmpty() && backend.requests.isEmpty()
                            && r.calls.equals(List.of("error(1," + c[1] + ",0)")),
                    "Windows answers " + c[0] + ": the caller's pending operation gets error " + c[1]
                            + ", no key prompt, never success");
        }
        wired(WindowsHelloBackend.AVAILABLE, 21999);
        FakeKeys keys = new FakeKeys();
        keys.pending.put(0x1234L, 10123);
        service = new AuthService(host, credential, keys);
        Receiver r = new Receiver("old");
        service.authenticate(new Token(), 0x1234L, 0, r, "com.example.bank", prompt(CRED));
        host.drain();
        check(keys.authorizations.isEmpty() && r.calls.size() == 1
                        && !r.calls.get(0).startsWith("succeeded"),
                "Windows older than build 22000 (no device credential): no key prompt, never success");
        wired(WindowsHelloBackend.AVAILABLE, WINDOWS_11);
        keys = new FakeKeys();
        keys.pending.put(0x1234L, 10123);
        service = new AuthService(host, credential, keys);
        r = new Receiver("ok");
        service.authenticate(new Token(), 0x1234L, 0, r, "com.example.bank", prompt(CRED));
        host.drain();
        check(keys.authorizations.equals(List.of("10123:4321:" + 0x1234L)) && backend.requests.isEmpty(),
                "Windows Hello available: the pending operation gets one prompt, the key's");
    }

    // --- #470 review: a busy Windows Hello is not "no credential" -------------------------

    static long now;  // the credential's clock, in milliseconds

    static void busyWired(int availabilityAtStart) {
        wired(availabilityAtStart, WINDOWS_11);
        now = 1_000_000;
        host = new TestHost();
        credential = new DeviceCredential(backend, WINDOWS_11, () -> now, millis -> now += millis);
        host.trust = credential;
        service = new AuthService(host, credential);
    }

    static void windowsAvailabilityCache() {
        ArrayDeque<Integer> replies = new ArrayDeque<>(List.of(WindowsHelloBackend.DEVICE_BUSY,
                WindowsHelloBackend.AVAILABLE, WindowsHelloBackend.DEVICE_NOT_PRESENT));
        long[] clockMs = {0};
        WindowsHello hello = new WindowsHello(replies::removeFirst, () -> clockMs[0]);
        DeviceCredential device = new DeviceCredential(hello, WINDOWS_11, () -> clockMs[0],
                millis -> clockMs[0] += millis);
        check(device.supported() && device.available() && replies.size() == 1,
                "startup retries bypass the production Hello availability cache");
        check(hello.availability() == WindowsHelloBackend.AVAILABLE && replies.size() == 1,
                "a fresh startup reply updates the normal availability cache");
        clockMs[0] += 5000;
        check(hello.availability() == WindowsHelloBackend.DEVICE_NOT_PRESENT && replies.isEmpty(),
                "regular availability still refreshes when the cache expires");
    }

    static void busy() {
        for (int transientState : new int[] {WindowsHelloBackend.DEVICE_BUSY, WindowsHelloBackend.FAILED}) {
            String what = "Windows answers " + transientState + " (a prompt cannot start now): ";
            backend = new FakeBackend();
            busyWired(WindowsHelloBackend.AVAILABLE);
            check(credential.supported() && credential.available(), what + "baseline: secure");
            backend.availability = transientState;
            // Every consumer of the one decision keeps saying "a credential exists".
            check(credential.supported() && credential.available() && host.isDeviceSecure(0),
                    what + "FEATURE_SECURE_LOCK_SCREEN and isDeviceSecure/isKeyguardSecure stay true");
            check(can(CRED) == BiometricManager.BIOMETRIC_SUCCESS
                    && can(CRED | WEAK) == BiometricManager.BIOMETRIC_SUCCESS,
                    what + "canAuthenticate(DEVICE_CREDENTIAL) is not NONE_ENROLLED");
            // A prompt cannot start: AOSP's temporarily-unavailable error, no Windows prompt.
            Receiver r = new Receiver("busy");
            start(r, new Token(), prompt(CRED));
            host.drain();
            check(r.calls.equals(List.of("error(1,1,0)")) && backend.requests.isEmpty(),
                    what + "a prompt ends with HW_UNAVAILABLE (1), never NO_DEVICE_CREDENTIAL (14)");
            List<Integer> results = new ArrayList<>();
            confirm(confirmIntent(), results);
            host.drain();
            check(results.equals(List.of(Activity.RESULT_CANCELED)) && backend.requests.isEmpty(),
                    what + "confirm-credential: RESULT_CANCELED without a Windows prompt");
            // It passes: the prompt works again, with no restart.
            backend.availability = WindowsHelloBackend.AVAILABLE;
            now += 10_000;
            r = new Receiver("again");
            start(r, new Token(), prompt(CRED));
            host.drain();
            check(backend.requests.size() == 1 && r.calls.isEmpty(),
                    what + "afterwards a prompt starts");
        }

        // The last known state is bounded: a busy reading is trusted for TRUST_MS only.
        busyWired(WindowsHelloBackend.AVAILABLE);
        backend.availability = WindowsHelloBackend.DEVICE_BUSY;
        now += DeviceCredential.BUSY_TRUST_MS - 1;
        check(credential.available(), "busy just inside the trust window: still enrolled");
        now += 2;
        check(!credential.available() && credential.supported()
                && can(CRED) == BiometricManager.BIOMETRIC_ERROR_HW_UNAVAILABLE,
                "busy beyond the trust window reports unknown enrollment as HW_UNAVAILABLE");

        // A definite answer always wins over the remembered one.
        busyWired(WindowsHelloBackend.AVAILABLE);
        backend.availability = WindowsHelloBackend.DEVICE_BUSY;
        check(credential.available(), "busy: enrolled");
        backend.availability = WindowsHelloBackend.NOT_CONFIGURED_FOR_USER;
        check(!credential.available(), "the user removed Hello: not enrolled at once");
        backend.availability = WindowsHelloBackend.DEVICE_BUSY;
        check(!credential.available() && credential.supported()
                && can(CRED) == BiometricManager.BIOMETRIC_ERROR_NONE_ENROLLED,
                "busy after a removal: still not enrolled, a busy reading never creates a credential");
        backend.availability = WindowsHelloBackend.DISABLED_BY_POLICY;
        check(!credential.available(), "disabled by policy while enrolled: not enrolled at once");

        // Busy while the system server starts: retried, and a late answer decides the feature.
        busyWired(WindowsHelloBackend.AVAILABLE);
        backend.script.add(WindowsHelloBackend.DEVICE_BUSY);
        backend.script.add(WindowsHelloBackend.FAILED);
        credential = new DeviceCredential(backend, WINDOWS_11, () -> now, millis -> now += millis);
        check(credential.supported() && credential.available() && backend.queries >= 4,
                "busy twice at start, then Available: the secure lock screen is declared");
        backend.script.clear();
        backend.script.add(WindowsHelloBackend.DEVICE_BUSY);
        backend.script.add(WindowsHelloBackend.NOT_CONFIGURED_FOR_USER);
        backend.availability = WindowsHelloBackend.NOT_CONFIGURED_FOR_USER;
        credential = new DeviceCredential(backend, WINDOWS_11, () -> now, millis -> now += millis);
        check(credential.supported() && !credential.available(),
                "busy at start, then NotConfiguredForUser: supported, not secure");
        backend.script.clear();
        backend.availability = WindowsHelloBackend.DEVICE_BUSY;
        credential = new DeviceCredential(backend, WINDOWS_11, () -> now, millis -> now += millis);
        host.trust = credential;
        service = new AuthService(host, credential);
        check(credential.supported() && !credential.available()
                && can(CRED) == BiometricManager.BIOMETRIC_ERROR_HW_UNAVAILABLE,
                "busy throughout start: verifier supported, enrollment unknown");
        Receiver busy = new Receiver("busy at startup");
        start(busy, new Token(), prompt(CRED));
        host.drain();
        check(busy.calls.equals(List.of("error(1,1,0)")) && backend.requests.isEmpty(),
                "a prompt while initial enrollment is unknown fails without opening Windows Hello");

        backend.availability = WindowsHelloBackend.AVAILABLE;
        check(credential.available() && can(CRED) == BiometricManager.BIOMETRIC_SUCCESS,
                "verifier recovery after startup activates the credential without a restart");

        Receiver active = new Receiver("already verifying");
        start(active, new Token(), prompt(CRED));
        host.drain();
        backend.availability = WindowsHelloBackend.DEVICE_BUSY;
        Receiver next = new Receiver("busy replacement");
        start(next, new Token(), prompt(CRED));
        host.drain();
        check(active.calls.isEmpty() && next.calls.equals(List.of("error(1,1,0)"))
                && backend.cancels.get() == 0 && backend.requests.size() == 1,
                "a busy replacement fails without canceling the existing verification");
        backend.complete(0, WindowsHelloBackend.VERIFIED);
        host.drain();
        check(active.calls.equals(List.of("succeeded(1)")), "the active verification can complete");

        busyWired(WindowsHelloBackend.AVAILABLE);
        backend.script.add(WindowsHelloBackend.DEVICE_BUSY);
        backend.availability = WindowsHelloBackend.FAILED;
        DeviceCredential busyThenFailed = new DeviceCredential(backend, WINDOWS_11,
                () -> now, millis -> now += millis);
        check(busyThenFailed.supported() && !busyThenFailed.available(),
                "a failed final sample does not erase evidence that a verifier was busy");
        backend.script.add(WindowsHelloBackend.DEVICE_BUSY);
        backend.availability = WindowsHelloBackend.DISABLED_BY_POLICY;
        DeviceCredential busyThenDisabled = new DeviceCredential(backend, WINDOWS_11,
                () -> now, millis -> now += millis);
        check(!busyThenDisabled.supported() && !busyThenDisabled.available(),
                "a definite policy denial takes precedence over previous busy evidence");
    }

    // --- phase 2b: one availability decision ---------------------------------------------

    static int can(int authenticators) { return service.canAuthenticate("com.example.bank", 0, authenticators); }

    static void availability() {
        DeviceCredential none = new DeviceCredential(null, WINDOWS_11);
        check(!none.supported() && !none.available() && none.backend() == null
                && none.state() == WindowsHelloBackend.FAILED,
                "no Windows Hello natives: no secure lock screen, no credential");

        wired(WindowsHelloBackend.AVAILABLE, WINDOWS_10);
        check(!credential.supported() && !credential.available() && credential.backend() == null,
                "Windows below build 22000: no secure lock screen, no credential, Hello set up or not");
        check(can(CRED) == BiometricManager.BIOMETRIC_ERROR_NONE_ENROLLED
                && can(CRED | WEAK) == BiometricManager.BIOMETRIC_ERROR_NONE_ENROLLED
                && can(STRONG) == BiometricManager.BIOMETRIC_ERROR_NO_HARDWARE,
                "below build 22000 canAuthenticate answers as an unsecured device");
        Receiver r = new Receiver("old");
        start(r, new Token(), prompt(CRED));
        host.drain();
        check(r.calls.equals(List.of("error(1,14,0)")) && backend.requests.isEmpty(),
                "below build 22000 a credential prompt is NO_DEVICE_CREDENTIAL and reaches no Windows prompt");
        check(new DeviceCredential(new FakeBackend(), 21999).backend() == null
                && new DeviceCredential(new FakeBackend(), 22000).available(),
                "the floor is exactly build 22000");

        wired(WindowsHelloBackend.AVAILABLE, WINDOWS_11);
        check(credential.supported() && credential.available() && credential.backend() == backend,
                "Windows 11 with Hello available: secure lock screen supported, device secure");
        check(can(CRED) == BiometricManager.BIOMETRIC_SUCCESS
                && can(CRED | WEAK) == BiometricManager.BIOMETRIC_SUCCESS
                && can(CRED | STRONG) == BiometricManager.BIOMETRIC_SUCCESS
                && can(WEAK) == BiometricManager.BIOMETRIC_ERROR_NO_HARDWARE
                && can(STRONG) == BiometricManager.BIOMETRIC_ERROR_NO_HARDWARE
                && can(0) == BiometricManager.BIOMETRIC_ERROR_NO_HARDWARE,
                "PreAuthInfo's answers on a secure device without sensors");
        backend.availability = WindowsHelloBackend.NOT_CONFIGURED_FOR_USER;
        check(credential.supported() && !credential.available()
                && can(CRED) == BiometricManager.BIOMETRIC_ERROR_NONE_ENROLLED,
                "the user removed Hello: still supported, no longer secure");
        backend.availability = WindowsHelloBackend.AVAILABLE;
        check(credential.available() && can(CRED) == BiometricManager.BIOMETRIC_SUCCESS,
                "the user set Hello up again: secure again");

        wired(WindowsHelloBackend.NOT_CONFIGURED_FOR_USER, WINDOWS_11);
        check(credential.supported() && !credential.available(),
                "Hello not set up at start: supported, not secure");
        backend.availability = WindowsHelloBackend.AVAILABLE;
        check(credential.available(), "and secure once the user sets it up");

        for (int state : new int[] {WindowsHelloBackend.DEVICE_NOT_PRESENT,
                WindowsHelloBackend.DISABLED_BY_POLICY, WindowsHelloBackend.FAILED}) {
            wired(state, WINDOWS_11);
            boolean absent = !credential.supported() && !credential.available()
                    && credential.backend() == null && credential.state() == state;
            backend.availability = WindowsHelloBackend.AVAILABLE;
            check(absent && !credential.available() && credential.state() == state
                    && can(CRED) == BiometricManager.BIOMETRIC_ERROR_NONE_ENROLLED,
                    "Windows answered " + state + " at start: no secure lock screen for this run,"
                    + " whatever it answers later");
        }

        // A biometric-only request stays on the sensor-less path on a secure device.
        wired(WindowsHelloBackend.AVAILABLE, WINDOWS_11);
        r = new Receiver("bio");
        start(r, new Token(), prompt(STRONG));
        host.drain();
        check(r.calls.equals(List.of("error(0,12,0)")) && backend.requests.isEmpty(),
                "a biometric-only prompt on a secure device: HW_NOT_PRESENT, no Windows prompt");
        r = new Receiver("crypto");
        service.authenticate(new Token(), 77L, 0, r, "com.example.bank", prompt(CRED | STRONG));
        host.drain();
        check(r.calls.equals(List.of("error(1,1,0)")) && backend.requests.isEmpty(),
                "a CryptoObject request on a secure device: HW_UNAVAILABLE, no Windows prompt");
        r = new Receiver("both");
        start(r, new Token(), prompt(CRED | STRONG));
        host.drain();
        check(backend.requests.size() == 1 && r.calls.isEmpty(),
                "biometric | credential falls to the credential: one Windows prompt");
        backend.complete(0, WindowsHelloBackend.VERIFIED);
        host.drain();
        check(r.calls.equals(List.of("succeeded(1)")), "confirmed as a device credential");
    }

    // --- phase 2b: ACTION_CONFIRM_DEVICE_CREDENTIAL --------------------------------------

    static Intent confirmIntent() {
        Intent intent = new Intent(ConfirmCredential.ACTION);
        intent.pkg = "com.android.settings";
        intent.extras.put(ConfirmCredential.EXTRA_TITLE, "Unlock vault");
        intent.extras.put(ConfirmCredential.EXTRA_DESCRIPTION, "Confirm it is you");
        return intent;
    }

    static AuthService.Confirmation confirm(Intent intent, List<Integer> results) {
        return ConfirmCredential.request(service, intent, 10123, 4321, "com.example.bank", results::add);
    }

    static void confirmCredential() {
        check(ConfirmCredential.handles(confirmIntent(), null), "the KeyguardManager intent is handled");
        Intent intent = confirmIntent();
        intent.pkg = null;
        intent.categories = Set.of(Intent.CATEGORY_DEFAULT);
        check(ConfirmCredential.handles(intent, null), "also without a package, with CATEGORY_DEFAULT");
        intent = confirmIntent();
        intent.pkg = "com.example.other";
        check(!ConfirmCredential.handles(intent, null), "not for another package");
        intent = confirmIntent();
        intent.component = new Object();
        check(!ConfirmCredential.handles(intent, null), "not for an explicit component");
        intent = confirmIntent();
        intent.data = new Object();
        check(!ConfirmCredential.handles(intent, null) && !ConfirmCredential.handles(confirmIntent(), "text/plain"),
                "not with data or a type");
        intent = confirmIntent();
        intent.categories = Set.of("android.intent.category.LAUNCHER");
        check(!ConfirmCredential.handles(intent, null), "not with another category");
        boolean others = false;
        for (String action : new String[] {"android.app.action.CONFIRM_FRP_CREDENTIAL",
                "android.app.action.CONFIRM_DEVICE_CREDENTIAL_WITH_USER",
                "android.app.action.CONFIRM_REMOTE_DEVICE_CREDENTIAL",
                "android.app.action.CONFIRM_REPAIR_MODE_DEVICE_CREDENTIAL",
                "android.app.action.PREPARE_REPAIR_MODE_DEVICE_CREDENTIAL", null}) {
            Intent other = confirmIntent();
            other.action = action;
            others |= ConfirmCredential.handles(other, null);
        }
        check(!others && !ConfirmCredential.handles(null, null),
                "the factory-reset, per-user, remote and repair-mode actions stay unresolved");

        wired(WindowsHelloBackend.AVAILABLE, WINDOWS_11);
        List<Integer> results = new ArrayList<>();
        confirm(confirmIntent(), results);
        check(results.isEmpty() && backend.requests.isEmpty(), "the request returns before any work");
        host.drain();
        WindowsHelloBackend.Request request = backend.requests.get(0);
        check(request.pid == 4321 && request.uid == 10123 && request.packageName.equals("com.example.bank")
                && request.message.equals("Unlock vault\nConfirm it is you"),
                "Windows' prompt: the caller's process as owner, the intent's title and description");
        check(results.isEmpty(), "no result while Windows' prompt shows");
        backend.complete(0, WindowsHelloBackend.VERIFIED);
        host.drain();
        check(results.equals(List.of(Activity.RESULT_OK)), "Verified: RESULT_OK, once");

        for (int outcome : new int[] {WindowsHelloBackend.CANCELED, WindowsHelloBackend.RETRIES_EXHAUSTED,
                WindowsHelloBackend.NOT_CONFIGURED_FOR_USER, WindowsHelloBackend.DEVICE_BUSY,
                WindowsHelloBackend.FAILED}) {
            wired(WindowsHelloBackend.AVAILABLE, WINDOWS_11);
            results = new ArrayList<>();
            confirm(confirmIntent(), results);
            host.drain();
            backend.complete(0, outcome);
            host.drain();
            check(results.equals(List.of(Activity.RESULT_CANCELED)),
                    "Windows' result " + outcome + ": RESULT_CANCELED, once");
        }

        wired(WindowsHelloBackend.NOT_CONFIGURED_FOR_USER, WINDOWS_11);
        results = new ArrayList<>();
        confirm(confirmIntent(), results);
        host.drain();
        check(results.equals(List.of(Activity.RESULT_CANCELED)) && backend.requests.isEmpty(),
                "no credential to confirm: RESULT_CANCELED without a Windows prompt, never RESULT_OK");
        wired(WindowsHelloBackend.AVAILABLE, WINDOWS_10);
        results = new ArrayList<>();
        confirm(confirmIntent(), results);
        host.drain();
        check(results.equals(List.of(Activity.RESULT_CANCELED)) && backend.requests.isEmpty(),
                "below build 22000: RESULT_CANCELED without a Windows prompt");

        wired(WindowsHelloBackend.AVAILABLE, WINDOWS_11);
        results = new ArrayList<>();
        intent = confirmIntent();
        intent.extras.put(ConfirmCredential.EXTRA_AUTHENTICATORS, STRONG);
        AuthService.Confirmation none = confirm(intent, results);
        host.drain();
        check(none == null && results.equals(List.of(Activity.RESULT_CANCELED)) && backend.requests.isEmpty(),
                "authenticators without DEVICE_CREDENTIAL: RESULT_CANCELED, no Windows prompt");
        results = new ArrayList<>();
        intent = confirmIntent();
        intent.unreadable = true;
        check(confirm(intent, results) == null && results.equals(List.of(Activity.RESULT_CANCELED)),
                "unreadable extras: RESULT_CANCELED");
        results = new ArrayList<>();
        intent = confirmIntent();
        intent.extras.put(ConfirmCredential.EXTRA_TITLE, new StringBuilder("not a String"));
        intent.extras.remove(ConfirmCredential.EXTRA_DESCRIPTION);
        confirm(intent, results);
        host.drain();
        check(backend.requests.get(0).message.isEmpty(),
                "a title that is not a String is not shown, as Settings reads it");
        backend.complete(0, WindowsHelloBackend.CANCELED);
        host.drain();

        // The activity going away cancels Windows' prompt; a late result is dropped.
        wired(WindowsHelloBackend.AVAILABLE, WINDOWS_11);
        results = new ArrayList<>();
        AuthService.Confirmation confirmation = confirm(confirmIntent(), results);
        host.drain();
        confirmation.cancel();
        host.drain();
        check(backend.cancels.get() == 1 && results.equals(List.of(Activity.RESULT_CANCELED)),
                "cancel: Windows' prompt is closed and the result is RESULT_CANCELED");
        backend.complete(0, WindowsHelloBackend.VERIFIED);
        confirmation.cancel();
        host.drain();
        check(results.equals(List.of(Activity.RESULT_CANCELED)) && backend.cancels.get() == 1,
                "a Verified after the cancel is dropped: never RESULT_OK, nothing twice");

        // One session at a time, as BiometricService: the activity's prompt and an app's replace each other.
        wired(WindowsHelloBackend.AVAILABLE, WINDOWS_11);
        Receiver app = new Receiver("app");
        start(app, new Token(), prompt(CRED));
        host.drain();
        results = new ArrayList<>();
        confirm(confirmIntent(), results);
        host.drain();
        check(app.calls.equals(List.of("error(1,5,0)")) && backend.cancels.get() == 1 && backend.requests.size() == 2,
                "the activity's confirmation replaces a running prompt (its client: CANCELED)");
        Receiver next = new Receiver("next");
        start(next, new Token(), prompt(CRED));
        host.drain();
        check(results.equals(List.of(Activity.RESULT_CANCELED)) && backend.cancels.get() == 2,
                "a new prompt replaces the activity's confirmation: RESULT_CANCELED");
        backend.complete(1, WindowsHelloBackend.VERIFIED);
        backend.complete(2, WindowsHelloBackend.VERIFIED);
        host.drain();
        check(results.equals(List.of(Activity.RESULT_CANCELED)) && next.calls.equals(List.of("succeeded(1)")),
                "the replaced confirmation's late Verified is dropped; the new prompt completes");
        check(ConfirmCredential.request(null, confirmIntent(), 1, 2, "p", results::add) == null
                && results.equals(List.of(Activity.RESULT_CANCELED, Activity.RESULT_CANCELED)),
                "without an auth service: RESULT_CANCELED");
    }

    // --- phase 2b: the prompt's owner leaving the foreground -----------------------------

    static boolean[] samples(int... relations) {
        OwnerWatch watch = new OwnerWatch();
        boolean[] cancel = new boolean[relations.length];
        for (int i = 0; i < relations.length; i++) cancel[i] = watch.sample(relations[i]);
        return cancel;
    }

    static void ownerWatch() {
        final int owner = OwnerWatch.OWNER, owned = OwnerWatch.OWNED, other = OwnerWatch.OTHER,
                gone = OwnerWatch.GONE, none = OwnerWatch.NONE;
        check(Arrays.equals(samples(owner, owned, owned, owner, owned),
                new boolean[] {false, false, false, false, false}),
                "the app and Windows' prompt in the foreground: no cancel");
        check(Arrays.equals(samples(owner, owned, other, other), new boolean[] {false, false, false, true}),
                "another window in the foreground for two samples after the prompt was seen: cancel");
        check(Arrays.equals(samples(owned, other, owned, other, none, owner, other),
                new boolean[] {false, false, false, false, false, false, false}),
                "a passing activation does not cancel: the count restarts");
        check(Arrays.equals(samples(owned, other, none, other), new boolean[] {false, false, false, true}),
                "no foreground window between two samples of another window does not restart it");
        check(Arrays.equals(samples(owner, other, other, other, other), new boolean[5]),
                "before the prompt was seen as an owned window, another window does not cancel");
        check(Arrays.equals(samples(gone), new boolean[] {true})
                && Arrays.equals(samples(owner, owned, gone), new boolean[] {false, false, true}),
                "the owner's window gone (its process exited): cancel at once");
        OwnerWatch watch = new OwnerWatch();
        watch.sample(other);
        boolean before = watch.promptSeen();
        watch.sample(owned);
        check(!before && watch.promptSeen(), "the prompt counts as seen only as an owned window");

        // What the cancel becomes: Windows' Canceled, which the service reports as the user's.
        wired(WindowsHelloBackend.AVAILABLE, WINDOWS_11);
        Receiver r = new Receiver("left");
        start(r, new Token(), prompt(CRED));
        host.drain();
        backend.complete(0, WindowsHelloBackend.CANCELED);
        host.drain();
        check(r.calls.equals(List.of("error(1,10,0)")),
                "a verification canceled for its owner ends BIOMETRIC_ERROR_USER_CANCELED, as SystemUI's");
    }

    // --- the Binder-facing path: IAuthService through StandIn, as apps reach it ----------

    interface Call { Object run() throws Exception; }

    static Object binder(Call call) {
        try {
            return call.run();
        } catch (SecurityException e) {
            return e;
        } catch (Exception e) {
            return e;
        }
    }

    static boolean denied(Object result, String permission) {
        return result instanceof SecurityException
                && String.valueOf(((SecurityException) result).getMessage()).contains(permission);
    }

    static void binderPermissions() {
        fresh(true, false);
        StandIn.setStrict(false);  // production's default mode
        IAuthService auth = StandIn.of(IAuthService.class, service).asInterface();
        final String test = AuthService.TEST_BIOMETRIC, internal = AuthService.USE_BIOMETRIC_INTERNAL;
        List<Integer> completed = new ArrayList<>();
        IInvalidationCallback invalidation = () -> completed.add(1);

        // Denied: an app holding only USE_BIOMETRIC (AOSP's @EnforcePermission / checkInternalPermission).
        check(denied(binder(() -> auth.getSensorProperties("com.example.bank")), test),
                "getSensorProperties without TEST_BIOMETRIC: SecurityException");
        check(denied(binder(() -> auth.createTestSession(0, new ITestSessionCallback() {}, "p")), test),
                "createTestSession without TEST_BIOMETRIC: SecurityException");
        check(denied(binder(() -> { auth.setIdentityCheckTestStatus(new IdentityCheckStatus()); return null; }), test),
                "setIdentityCheckTestStatus without TEST_BIOMETRIC: SecurityException");
        check(denied(binder(() -> auth.getUiPackage()), test),
                "getUiPackage without TEST_BIOMETRIC: SecurityException");
        check(denied(binder(() -> { auth.registerEnabledOnKeyguardCallback(new IBiometricEnabledOnKeyguardCallback() {}); return null; }), internal),
                "registerEnabledOnKeyguardCallback without USE_BIOMETRIC_INTERNAL: SecurityException");
        check(denied(binder(() -> { auth.registerAuthenticationStateListener(new AuthenticationStateListener()); return null; }), internal),
                "registerAuthenticationStateListener without USE_BIOMETRIC_INTERNAL: SecurityException");
        check(denied(binder(() -> { auth.unregisterAuthenticationStateListener(new AuthenticationStateListener()); return null; }), internal),
                "unregisterAuthenticationStateListener without USE_BIOMETRIC_INTERNAL: SecurityException");
        check(denied(binder(() -> { auth.registerIdentityCheckStateListener(new IIdentityCheckStateListener() {}); return null; }), internal),
                "registerIdentityCheckStateListener without USE_BIOMETRIC_INTERNAL: SecurityException");
        check(denied(binder(() -> { auth.unregisterIdentityCheckStateListener(new IIdentityCheckStateListener() {}); return null; }), internal),
                "unregisterIdentityCheckStateListener without USE_BIOMETRIC_INTERNAL: SecurityException");
        check(denied(binder(() -> { auth.invalidateAuthenticatorIds(0, 1, invalidation); return null; }), internal)
                && completed.isEmpty(),
                "invalidateAuthenticatorIds without USE_BIOMETRIC_INTERNAL: SecurityException, no callback");
        check(denied(binder(() -> { auth.resetLockoutTimeBound(new Token(), "p", 1, 0, new byte[0]); return null; }), internal),
                "resetLockoutTimeBound without USE_BIOMETRIC_INTERNAL: SecurityException");
        check(denied(binder(() -> { auth.resetLockout(0, new byte[0]); return null; }), internal),
                "resetLockout without USE_BIOMETRIC_INTERNAL: SecurityException");
        check(denied(binder(() -> auth.hasEnrolledBiometrics(0, "p")), internal),
                "hasEnrolledBiometrics without USE_BIOMETRIC_INTERNAL: SecurityException");
        host.granted.clear();
        check(denied(binder(() -> auth.getLastAuthenticationTime(0, WEAK)), "USE_BIOMETRIC"),
                "getLastAuthenticationTime without USE_BIOMETRIC: SecurityException");
        check(denied(binder(() -> { auth.cancelAuthentication(new Token(), "p", 1); return null; }), "USE_BIOMETRIC"),
                "cancelAuthentication without USE_BIOMETRIC: SecurityException");

        // Allowed: the sensor-less device's answers (BiometricService with mSensors empty).
        host.granted.addAll(Set.of(Manifest.permission.USE_BIOMETRIC, test));
        Object sensors = binder(() -> auth.getSensorProperties("com.example.bank"));
        check(sensors instanceof List && ((List<?>) sensors).isEmpty(),
                "getSensorProperties with TEST_BIOMETRIC: an empty list");
        check(binder(() -> auth.createTestSession(0, new ITestSessionCallback() {}, "p")) == null,
                "createTestSession with TEST_BIOMETRIC: null, no sensor has that id");
        check(binder(() -> auth.getUiPackage()) instanceof CharSequence
                && binder(() -> auth.getUiPackage()).toString().equals("res:config_biometric_prompt_ui_package"),
                "getUiPackage with TEST_BIOMETRIC: config_biometric_prompt_ui_package");
        Object identity = binder(() -> { auth.setIdentityCheckTestStatus(new IdentityCheckStatus()); return null; });
        check(identity instanceof UnsupportedOperationException,
                "setIdentityCheckTestStatus with TEST_BIOMETRIC: unsupported, not a silent success");
        host.granted.add(internal);
        check(binder(() -> { auth.registerEnabledOnKeyguardCallback(new IBiometricEnabledOnKeyguardCallback() {}); return "ok"; }).equals("ok"),
                "registerEnabledOnKeyguardCallback with USE_BIOMETRIC_INTERNAL: accepted");
        check(binder(() -> { auth.registerAuthenticationStateListener(new AuthenticationStateListener()); return "ok"; }).equals("ok")
                && binder(() -> { auth.unregisterAuthenticationStateListener(new AuthenticationStateListener()); return "ok"; }).equals("ok"),
                "(un)registerAuthenticationStateListener with USE_BIOMETRIC_INTERNAL: accepted, no fingerprint or face service");
        check(binder(() -> { auth.registerIdentityCheckStateListener(new IIdentityCheckStateListener() {}); return "ok"; }).equals("ok")
                && binder(() -> { auth.unregisterIdentityCheckStateListener(new IIdentityCheckStateListener() {}); return "ok"; }).equals("ok"),
                "(un)registerIdentityCheckStateListener with USE_BIOMETRIC_INTERNAL: accepted");
        check(binder(() -> { auth.invalidateAuthenticatorIds(0, 1, invalidation); return "ok"; }).equals("ok")
                && completed.equals(List.of(1)),
                "invalidateAuthenticatorIds with USE_BIOMETRIC_INTERNAL: onCompleted at once, no sensor to invalidate");
        check(binder(() -> { auth.resetLockoutTimeBound(new Token(), "p", 1, 0, new byte[0]); return "ok"; }).equals("ok")
                && binder(() -> { auth.resetLockout(0, new byte[0]); return "ok"; }).equals("ok"),
                "resetLockout(TimeBound) with USE_BIOMETRIC_INTERNAL: accepted, nothing locked out");

        // Every IAuthService method is the service's own: none falls through to Default's answer.
        List<String> inherited = new ArrayList<>();
        for (Method m : IAuthService.class.getDeclaredMethods()) {
            if (m.getName().equals("asBinder")) continue;
            try {
                if (AuthService.class.getMethod(m.getName(), m.getParameterTypes()).getDeclaringClass()
                        != AuthService.class) inherited.add(m.getName());
            } catch (NoSuchMethodException e) {
                inherited.add(m.getName());
            }
        }
        Collections.sort(inherited);
        check(inherited.isEmpty(), "no IAuthService method is inherited from Default: " + inherited);
        check(events.isEmpty() && host.pending() == 0, "no prompt or callback came out of these calls");
    }

    static void keyRequestCancellation() {
        AtomicInteger starts = new AtomicInteger();
        HelloKeyBackend.Result absentOwner = WindowsHelloKey.startOwned(0, () -> {
            starts.incrementAndGet();
            return 7;
        }).await();
        check(absentOwner.status == HelloKeyBackend.NOT_FOREGROUND && starts.get() == 0,
                "a key signature without a captured owner never starts an unwatched native prompt");
        AtomicInteger cancels = new AtomicInteger(), releases = new AtomicInteger();
        byte[] signature = {1, 2, 3};
        WindowsHelloKey.Request[] pending = new WindowsHelloKey.Request[1];
        pending[0] = new WindowsHelloKey.Request(() -> {
            // The owner watch or the app cancels while nativeAwait is finishing.
            pending[0].cancel();
            return new HelloKeyBackend.Result(HelloKeyBackend.SUCCESS, signature);
        }, cancels::incrementAndGet, releases::incrementAndGet);
        HelloKeyBackend.Result result = pending[0].await();
        pending[0].cancel();
        check(result.status == HelloKeyBackend.USER_CANCELED && result.data == null
                        && Arrays.equals(signature, new byte[3]),
                "a canceled native key request discards a late successful signature");
        check(cancels.get() == 1 && releases.get() == 1,
                "a canceled native key request cancels and releases exactly once");

        cancels.set(0);
        releases.set(0);
        WindowsHelloKey.Request completed = new WindowsHelloKey.Request(
                () -> new HelloKeyBackend.Result(HelloKeyBackend.SUCCESS, new byte[] {4}),
                cancels::incrementAndGet, releases::incrementAndGet);
        result = completed.await();
        completed.cancel();
        check(result.status == HelloKeyBackend.SUCCESS && result.data[0] == 4
                        && cancels.get() == 0 && releases.get() == 1,
                "a completed native key request keeps its result and is never canceled after release");

        WindowsHelloKey.Request failed = new WindowsHelloKey.Request(() -> {
            throw new IllegalStateException("native wait failed");
        }, cancels::incrementAndGet, releases::incrementAndGet);
        boolean threw = false;
        try {
            failed.await();
        } catch (IllegalStateException expected) {
            threw = true;
        }
        check(threw && releases.get() == 2,
                "a failed native key wait still releases its request");
    }

    static void keyCreateOwnership() throws Exception {
        final int PID = 42;
        AtomicInteger starts = new AtomicInteger(), watches = new AtomicInteger();
        WindowsHelloKey noOwner = new WindowsHelloKey(pid -> 0, (name, pid) -> {
            starts.incrementAndGet();
            return new WindowsHelloKey.Request(
                    () -> new HelloKeyBackend.Result(HelloKeyBackend.SUCCESS, new byte[] {1}),
                    () -> { }, accepted -> { });
        }, (owner, pid, cancel, done) -> watches.incrementAndGet());
        check(noOwner.create("missing-owner", PID).result.status == HelloKeyBackend.NOT_FOREGROUND
                        && starts.get() == 0 && watches.get() == 0,
                "key enrollment without an owner never starts a native create or watcher");

        for (boolean canceled : new boolean[] {false, true}) {
            java.util.concurrent.CountDownLatch waiting = new java.util.concurrent.CountDownLatch(1);
            java.util.concurrent.CountDownLatch watched = new java.util.concurrent.CountDownLatch(1);
            java.util.concurrent.CountDownLatch stopped = new java.util.concurrent.CountDownLatch(1);
            java.util.concurrent.atomic.AtomicBoolean watchedIdentity =
                    new java.util.concurrent.atomic.AtomicBoolean();
            AtomicInteger cancelCalls = new AtomicInteger(), releaseCalls = new AtomicInteger();
            List<Boolean> accepted = Collections.synchronizedList(new ArrayList<>());
            byte[] publicKey = {7, 8, 9};
            WindowsHelloKey hello = new WindowsHelloKey(pid -> 73, (name, pid) -> {
                starts.incrementAndGet();
                return new WindowsHelloKey.Request(() -> {
                    waiting.countDown();
                    try {
                        watched.await(2, java.util.concurrent.TimeUnit.SECONDS);
                    } catch (InterruptedException e) {
                        throw new AssertionError(e);
                    }
                    return new HelloKeyBackend.Result(HelloKeyBackend.SUCCESS, publicKey);
                }, cancelCalls::incrementAndGet, keep -> {
                    accepted.add(keep);
                    releaseCalls.incrementAndGet();
                });
            }, (owner, pid, cancel, done) -> {
                watchedIdentity.set(owner == 73 && pid == PID);
                watches.incrementAndGet();
                try {
                    if (waiting.await(2, java.util.concurrent.TimeUnit.SECONDS) && canceled) {
                        cancel.run();
                        cancel.run();
                    }
                    watched.countDown();
                    long deadline = System.nanoTime() + 2_000_000_000L;
                    while (!done.get() && System.nanoTime() < deadline) Thread.yield();
                    if (done.get()) stopped.countDown();
                } catch (InterruptedException e) {
                    throw new AssertionError(e);
                }
            });
            HelloKeyBackend.Creation creation = hello.create("owned-create", PID);
            HelloKeyBackend.Result result = creation.result;
            boolean watchStopped = stopped.await(3, java.util.concurrent.TimeUnit.SECONDS);
            check(watchedIdentity.get() && watchStopped,
                    "key enrollment watches its captured owner during await and stops after completion");
            check(canceled ? accepted.equals(List.of(false)) : accepted.isEmpty(),
                    "successful public-key delivery retains native creation until enrollment commits");
            if (!canceled) creation.commit();
            creation.close();
            creation.close();
            check(releaseCalls.get() == 1 && accepted.equals(List.of(!canceled)),
                    "native create receives exactly one final committed/rejected enrollment disposition");
            check(canceled
                            ? result.status == HelloKeyBackend.USER_CANCELED && result.data == null
                                    && cancelCalls.get() == 1 && Arrays.equals(publicKey, new byte[3])
                            : result.status == HelloKeyBackend.SUCCESS && result.data == publicKey
                                    && cancelCalls.get() == 0,
                    "owner loss rejects a racing successful create; a live owner keeps its public key");
        }

        for (boolean commit : new boolean[] {false, true}) {
            AtomicInteger cancels = new AtomicInteger();
            List<Boolean> accepted = new ArrayList<>();
            WindowsHelloKey.Request request = new WindowsHelloKey.Request(
                    () -> new HelloKeyBackend.Result(HelloKeyBackend.SUCCESS, new byte[] {8}),
                    cancels::incrementAndGet, accepted::add);
            WindowsHelloKey hello = new WindowsHelloKey(pid -> 73,
                    (name, pid) -> request, (owner, pid, cancel, done) -> { },
                    (work, name) -> work.run());
            HelloKeyBackend.Creation creation = hello.create("retained-enrollment", PID);
            // The old create watch may still be returning while the first signature
            // has started its separate owner watch. Its late cancel cannot revoke
            // the already delivered creation behind that enrollment's back.
            request.cancel();
            check(creation.result.status == HelloKeyBackend.SUCCESS && accepted.isEmpty()
                            && cancels.get() == 0,
                    "a delivered creation retains ownership and ignores its finished watch's late cancel");
            if (commit) {
                creation.commit();
                creation.commit();
            }
            creation.close();
            creation.close();
            check(accepted.equals(List.of(commit)),
                    "closing an uncommitted creation rejects it; a committed creation stays accepted");
            if (!commit) {
                boolean rejected = false;
                try { creation.commit(); } catch (IllegalStateException expected) { rejected = true; }
                check(rejected && accepted.equals(List.of(false)),
                        "a closed creation cannot later accept a key being cleaned up");
            }
        }

        List<Boolean> disposition = new ArrayList<>();
        WindowsHelloKey.Request canceledBeforeAwait = new WindowsHelloKey.Request(
                () -> new HelloKeyBackend.Result(HelloKeyBackend.SUCCESS, new byte[] {5}),
                () -> { }, disposition::add);
        canceledBeforeAwait.cancel();
        check(canceledBeforeAwait.await().status == HelloKeyBackend.USER_CANCELED
                        && disposition.equals(List.of(false)),
                "a create canceled before awaiting never accepts the native key");
        disposition.clear();
        WindowsHelloKey.Request handoffFailed = new WindowsHelloKey.Request(() -> {
            throw new OutOfMemoryError("scripted JNI public-key allocation failure");
        }, () -> { }, disposition::add);
        try {
            handoffFailed.await();
        } catch (OutOfMemoryError expected) {
            check(disposition.equals(List.of(false)),
                    "failed JNI result handoff rejects native creation for cleanup");
        }
    }

    static void keyWatchFailures() {
        for (Throwable original : new Throwable[] {
                new IllegalStateException("scripted watcher startup failure"),
                new OutOfMemoryError("scripted watcher allocation failure")}) {
            AtomicInteger waits = new AtomicInteger(), cancels = new AtomicInteger();
            List<Boolean> released = new ArrayList<>();
            java.util.concurrent.atomic.AtomicReference<Runnable> unstarted =
                    new java.util.concurrent.atomic.AtomicReference<>();
            java.util.concurrent.atomic.AtomicBoolean observedDone =
                    new java.util.concurrent.atomic.AtomicBoolean();
            byte[] publicKey = {1, 2, 3};
            WindowsHelloKey hello = new WindowsHelloKey(pid -> 73, (name, pid) ->
                    new WindowsHelloKey.Request(() -> {
                        waits.incrementAndGet();
                        return new HelloKeyBackend.Result(HelloKeyBackend.SUCCESS, publicKey);
                    }, cancels::incrementAndGet, released::add),
                    (owner, pid, cancel, done) -> observedDone.set(done.get()),
                    (work, name) -> {
                        unstarted.set(work);
                        if (original instanceof Error) throw (Error) original;
                        throw (RuntimeException) original;
                    });
            Throwable caught = null;
            try {
                hello.create("unwatched", 42);
            } catch (RuntimeException | Error failure) {
                caught = failure;
            }
            check(caught == original,
                    "watch allocation/start failure preserves its original exception");
            check(waits.get() == 1 && cancels.get() == 1 && released.equals(List.of(false))
                            && Arrays.equals(publicKey, new byte[3]),
                    "failed watch startup cancels, awaits and rejects native creation exactly once");
            unstarted.get().run();
            check(observedDone.get(),
                    "failed watch startup marks its lifetime done even for a delayed watcher");
        }

        for (Throwable watchFailure : new Throwable[] {
                new IllegalStateException("scripted watch body failure"),
                new AssertionError("scripted watch body error")}) {
            AtomicInteger waits = new AtomicInteger(), cancels = new AtomicInteger();
            List<Boolean> released = new ArrayList<>();
            java.util.concurrent.atomic.AtomicReference<java.util.concurrent.atomic.AtomicBoolean>
                    watchedDone = new java.util.concurrent.atomic.AtomicReference<>();
            WindowsHelloKey hello = new WindowsHelloKey(pid -> 73, (name, pid) ->
                    new WindowsHelloKey.Request(() -> {
                        waits.incrementAndGet();
                        return new HelloKeyBackend.Result(HelloKeyBackend.SUCCESS, new byte[] {4});
                    }, cancels::incrementAndGet, released::add),
                    (owner, pid, cancel, done) -> {
                        watchedDone.set(done);
                        if (watchFailure instanceof Error) throw (Error) watchFailure;
                        throw (RuntimeException) watchFailure;
                    }, (work, name) -> work.run());
            HelloKeyBackend.Result result = null;
            Throwable escaped = null;
            try {
                result = hello.create("failed-watch", 42).result;
            } catch (RuntimeException | Error failure) {
                escaped = failure;
            }
            check(escaped == null && result != null
                            && result.status == HelloKeyBackend.USER_CANCELED && result.data == null,
                    "watcher body failure rejects its request without escaping on the server thread");
            check(waits.get() == 1 && cancels.get() == 1 && released.equals(List.of(false))
                            && watchedDone.get().get(),
                    "a failed watcher still awaits and rejects once, then ends its lifetime");
        }

        IllegalStateException original = new IllegalStateException("watch did not start");
        IllegalArgumentException cancelFailure = new IllegalArgumentException("cancel boundary failed");
        OutOfMemoryError awaitFailure = new OutOfMemoryError("native handoff failed");
        AtomicInteger waits = new AtomicInteger();
        List<Boolean> released = new ArrayList<>();
        WindowsHelloKey hello = new WindowsHelloKey(pid -> 73, (name, pid) ->
                new WindowsHelloKey.Request(() -> {
                    waits.incrementAndGet();
                    throw awaitFailure;
                }, () -> { throw cancelFailure; }, released::add),
                (owner, pid, cancel, done) -> { }, (work, name) -> { throw original; });
        Throwable caught = null;
        try {
            hello.create("cleanup-failure", 42);
        } catch (RuntimeException | Error failure) {
            caught = failure;
        }
        check(caught == original && Arrays.equals(original.getSuppressed(),
                        new Throwable[] {cancelFailure, awaitFailure}),
                "watch startup failure stays primary when cancellation and awaiting also fail");
        check(waits.get() == 1 && released.equals(List.of(false)),
                "cleanup exceptions cannot skip the rejected native disposition or await twice");
    }

    static void keySignatureWaiterFailures() {
        for (Throwable original : new Throwable[] {
                new IllegalStateException("scripted signature thread startup failure"),
                new OutOfMemoryError("scripted signature thread allocation failure")}) {
            AtomicInteger starts = new AtomicInteger(), waits = new AtomicInteger();
            AtomicInteger cancels = new AtomicInteger(), callbacks = new AtomicInteger();
            List<Boolean> released = new ArrayList<>();
            byte[] signature = {3, 4, 5};
            WindowsHelloKey hello = new WindowsHelloKey(pid -> 73, (name, pid) -> {
                throw new AssertionError("signature started a creation");
            }, (owner, pid, cancel, done) -> {
                throw new AssertionError("unstarted signature started an owner watch");
            }, (work, name) -> {
                if (original instanceof Error) throw (Error) original;
                throw (RuntimeException) original;
            }, (name, pid, data) -> {
                starts.incrementAndGet();
                return new WindowsHelloKey.Request(() -> {
                    waits.incrementAndGet();
                    return new HelloKeyBackend.Result(HelloKeyBackend.SUCCESS, signature);
                }, cancels::incrementAndGet, released::add);
            });
            Throwable caught = null;
            try {
                hello.sign("unwatched-signature", 42, new byte[] {9},
                        result -> callbacks.incrementAndGet());
            } catch (RuntimeException | Error failure) {
                caught = failure;
            }
            check(caught == original && starts.get() == 1 && callbacks.get() == 0,
                    "signature waiter startup failure preserves its original exception without a callback");
            check(waits.get() == 1 && cancels.get() == 1 && released.equals(List.of(false))
                            && Arrays.equals(signature, new byte[3]),
                    "unstarted signature waiter cancels, awaits and rejects the native signature exactly once");
        }

        IllegalStateException startFailure = new IllegalStateException("signature waiter did not start");
        IllegalArgumentException cancelFailure = new IllegalArgumentException("signature cancel failed");
        OutOfMemoryError awaitFailure = new OutOfMemoryError("signature handoff failed");
        AtomicInteger waits = new AtomicInteger();
        List<Boolean> released = new ArrayList<>();
        WindowsHelloKey unstarted = new WindowsHelloKey(pid -> 73, (name, pid) -> null,
                (owner, pid, cancel, done) -> { }, (work, name) -> { throw startFailure; },
                (name, pid, data) -> new WindowsHelloKey.Request(() -> {
                    waits.incrementAndGet();
                    throw awaitFailure;
                }, () -> { throw cancelFailure; }, released::add));
        Throwable caught = null;
        try {
            unstarted.sign("cleanup-failure", 42, new byte[0], result -> {
                throw new AssertionError("unstarted waiter called back");
            });
        } catch (RuntimeException | Error failure) {
            caught = failure;
        }
        check(caught == startFailure && Arrays.equals(startFailure.getSuppressed(),
                        new Throwable[] {cancelFailure, awaitFailure})
                        && waits.get() == 1 && released.equals(List.of(false)),
                "signature startup failure stays primary and cleanup failures cannot skip release");

        for (boolean failOwnerStart : new boolean[] {true, false}) {
            AtomicInteger awaited = new AtomicInteger(), canceled = new AtomicInteger();
            List<Boolean> dispositions = new ArrayList<>();
            List<HelloKeyBackend.Result> results = new ArrayList<>();
            java.util.concurrent.atomic.AtomicReference<Runnable> waiter =
                    new java.util.concurrent.atomic.AtomicReference<>();
            java.util.concurrent.atomic.AtomicReference<Runnable> watch =
                    new java.util.concurrent.atomic.AtomicReference<>();
            java.util.concurrent.atomic.AtomicBoolean watchDone =
                    new java.util.concurrent.atomic.AtomicBoolean();
            byte[] signature = {8, 9};
            WindowsHelloKey hello = new WindowsHelloKey(pid -> 73, (name, pid) -> null,
                    (owner, pid, cancel, done) -> watchDone.set(done.get()),
                    (work, name) -> {
                        if (name.startsWith("keystore-hello-owner-")) {
                            watch.set(work);
                            if (failOwnerStart) throw new OutOfMemoryError("owner thread did not start");
                        } else {
                            waiter.set(work);
                        }
                    }, (name, pid, data) -> new WindowsHelloKey.Request(() -> {
                        awaited.incrementAndGet();
                        if (!failOwnerStart) throw new IllegalStateException("signature native await failed");
                        return new HelloKeyBackend.Result(HelloKeyBackend.SUCCESS, signature);
                    }, canceled::incrementAndGet, dispositions::add));
            HelloKeyBackend.Operation operation = hello.sign("waiter-failure", 42,
                    new byte[] {1}, results::add);
            check(results.isEmpty() && waiter.get() != null,
                    "a signature waits for its scheduled waiter before delivering a result");
            Throwable escaped = null;
            try {
                waiter.get().run();
            } catch (RuntimeException | Error failure) {
                escaped = failure;
            }
            check(escaped == null && results.size() == 1
                            && results.get(0).status == HelloKeyBackend.FAILED
                            && results.get(0).data == null,
                    "signature await or owner-start failure completes FAILED once without escaping its server thread");
            operation.cancel();
            watch.get().run();
            check(awaited.get() == 1 && canceled.get() == (failOwnerStart ? 1 : 0)
                            && dispositions.equals(List.of(false)) && watchDone.get()
                            && (!failOwnerStart || Arrays.equals(signature, new byte[2])),
                    "failed signature completion never re-awaits a released handle and ends its owner watch");
        }

        for (boolean hasOwner : new boolean[] {false, true}) {
            AtomicInteger starts = new AtomicInteger(), watches = new AtomicInteger();
            AtomicInteger cancels = new AtomicInteger();
            List<Boolean> dispositions = new ArrayList<>();
            List<HelloKeyBackend.Result> results = new ArrayList<>();
            java.util.concurrent.atomic.AtomicReference<Runnable> waiter =
                    new java.util.concurrent.atomic.AtomicReference<>();
            WindowsHelloKey hello = new WindowsHelloKey(pid -> hasOwner ? 73 : 0,
                    (name, pid) -> null, (owner, pid, cancel, done) -> watches.incrementAndGet(),
                    (work, name) -> {
                        if (name.startsWith("keystore-hello-owner-")) work.run();
                        else waiter.set(work);
                    }, (name, pid, data) -> {
                        starts.incrementAndGet();
                        return new WindowsHelloKey.Request(
                                () -> new HelloKeyBackend.Result(HelloKeyBackend.SUCCESS, new byte[] {7}),
                                cancels::incrementAndGet, dispositions::add);
                    });
            HelloKeyBackend.Operation operation = hello.sign("ordinary-signature", 42,
                    new byte[] {1}, results::add);
            check(results.isEmpty(), "ordinary signature completion uses the scheduled waiter");
            waiter.get().run();
            operation.cancel();
            check(results.size() == 1 && results.get(0).status == (hasOwner
                            ? HelloKeyBackend.SUCCESS : HelloKeyBackend.NOT_FOREGROUND)
                            && starts.get() == (hasOwner ? 1 : 0)
                            && watches.get() == (hasOwner ? 1 : 0) && cancels.get() == 0
                            && dispositions.equals(hasOwner ? List.of(true) : List.of()),
                    "signature waiter preserves successful delivery and refuses native entry without an owner");
        }
    }

    public static void main(String[] args) throws Exception {
        keyRequestCancellation();
        keyCreateOwnership();
        keyWatchFailures();
        keySignatureWaiterFailures();
        unavailable();
        available();
        keystore();
        keystoreCredential();
        availability();
        windowsAvailabilityCache();
        busy();
        confirmCredential();
        ownerWatch();
        binderPermissions();
        System.out.println(checks + " checks, " + failures + " failures");
        if (failures != 0) System.exit(1);
    }
}

