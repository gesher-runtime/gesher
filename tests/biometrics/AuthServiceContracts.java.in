    void onDialogDismissed(int reason) throws RemoteException;
    void onSystemEvent(int event) throws RemoteException;
    IBinder asBinder();
}

interface IAuthService extends IInterface {
    // android-16.0.0_r4 IAuthService.aidl, in its order.
    ITestSession createTestSession(int sensorId, ITestSessionCallback callback, String opPackageName)
            throws RemoteException;
    void setIdentityCheckTestStatus(IdentityCheckStatus identityCheckStatus) throws RemoteException;
    List<SensorPropertiesInternal> getSensorProperties(String opPackageName) throws RemoteException;
    String getUiPackage() throws RemoteException;
    long authenticate(IBinder token, long sessionId, int userId, IBiometricServiceReceiver receiver,
            String opPackageName, PromptInfo promptInfo) throws RemoteException;
    void cancelAuthentication(IBinder token, String opPackageName, long requestId) throws RemoteException;
    int canAuthenticate(String opPackageName, int userId, int authenticators) throws RemoteException;
    long getLastAuthenticationTime(int userId, int authenticators) throws RemoteException;
    boolean hasEnrolledBiometrics(int userId, String opPackageName) throws RemoteException;
    List<BiometricEnrollmentStatusInternal> getEnrollmentStatusList(int userId, String opPackageName)
            throws RemoteException;
    void registerEnabledOnKeyguardCallback(IBiometricEnabledOnKeyguardCallback callback)
            throws RemoteException;
    void registerAuthenticationStateListener(AuthenticationStateListener listener) throws RemoteException;
    void unregisterAuthenticationStateListener(AuthenticationStateListener listener) throws RemoteException;
    void registerIdentityCheckStateListener(IIdentityCheckStateListener listener) throws RemoteException;
    void unregisterIdentityCheckStateListener(IIdentityCheckStateListener listener) throws RemoteException;
    void invalidateAuthenticatorIds(int userId, int fromSensorId, IInvalidationCallback callback)
            throws RemoteException;
    long[] getAuthenticatorIds(int userId) throws RemoteException;
    void resetLockoutTimeBound(IBinder token, String opPackageName, int fromSensorId, int userId,
            byte[] hardwareAuthToken) throws RemoteException;
    void resetLockout(int userId, byte[] hardwareAuthToken) throws RemoteException;
    CharSequence getButtonLabel(int userId, String opPackageName, int authenticators) throws RemoteException;
    CharSequence getPromptMessage(int userId, String opPackageName, int authenticators) throws RemoteException;
    CharSequence getSettingName(int userId, String opPackageName, int authenticators) throws RemoteException;

    /** The AIDL-generated Default: null, 0, false and no-op answers. */
    class Default implements IAuthService {
        public ITestSession createTestSession(int s, ITestSessionCallback c, String p) { return null; }
        public void setIdentityCheckTestStatus(IdentityCheckStatus s) {}
        public List<SensorPropertiesInternal> getSensorProperties(String p) { return null; }
        public String getUiPackage() { return null; }
        public long authenticate(IBinder t, long s, int u, IBiometricServiceReceiver r, String p, PromptInfo i) { return 0; }
        public void cancelAuthentication(IBinder t, String p, long id) {}
        public int canAuthenticate(String p, int u, int a) { return 0; }
        public long getLastAuthenticationTime(int u, int a) { return 0; }
        public boolean hasEnrolledBiometrics(int u, String p) { return false; }
        public List<BiometricEnrollmentStatusInternal> getEnrollmentStatusList(int u, String p) { return null; }
        public void registerEnabledOnKeyguardCallback(IBiometricEnabledOnKeyguardCallback c) {}
        public void registerAuthenticationStateListener(AuthenticationStateListener l) {}
        public void unregisterAuthenticationStateListener(AuthenticationStateListener l) {}
        public void registerIdentityCheckStateListener(IIdentityCheckStateListener l) {}
        public void unregisterIdentityCheckStateListener(IIdentityCheckStateListener l) {}
        public void invalidateAuthenticatorIds(int u, int s, IInvalidationCallback c) {}
        public long[] getAuthenticatorIds(int u) { return null; }
        public void resetLockoutTimeBound(IBinder t, String p, int s, int u, byte[] h) {}
        public void resetLockout(int u, byte[] h) {}
        public CharSequence getButtonLabel(int u, String p, int a) { return null; }
        public CharSequence getPromptMessage(int u, String p, int a) { return null; }
        public CharSequence getSettingName(int u, String p, int a) { return null; }
        public IBinder asBinder() { return null; }
    }

    class Stub {
        public static final String DESCRIPTOR = "android.hardware.biometrics.IAuthService";
    }
}

final class Activity {
    static final int RESULT_CANCELED = 0;
    static final int RESULT_OK = -1;
}

final class Intent {
    static final String CATEGORY_DEFAULT = "android.intent.category.DEFAULT";
    String action, pkg;
    Object component, selector, data;
    String type;
    Set<String> categories;
    boolean unreadable;
    final Map<String, Object> extras = new HashMap<>();
    Intent(String action) { this.action = action; }
    String getAction() { return action; }
    String getPackage() { return pkg; }
    Object getComponent() { return component; }
    Object getSelector() { return selector; }
    Object getData() { return data; }
    String getType() { return type; }
    Set<String> getCategories() { return categories; }
    private Object extra(String name) {
        if (unreadable) throw new RuntimeException("BadParcelableException");
        return extras.get(name);
    }
    String getStringExtra(String name) { return extra(name) instanceof String s ? s : null; }
    CharSequence getCharSequenceExtra(String name) { return extra(name) instanceof CharSequence c ? c : null; }
    int getIntExtra(String name, int fallback) { return extra(name) instanceof Integer i ? i : fallback; }
}

