#include <algorithm>
#include <cstdint>
#include <cwchar>
#include <cwctype>
#include <iostream>
#include <map>
#include <stdexcept>
#include <string>
#include <vector>

// Host-only Win32 boundaries, not a replacement Windows filesystem.
using DWORD = uint32_t;
constexpr DWORD INVALID_FILE_ATTRIBUTES = 0xffffffffu, FILE_ATTRIBUTE_DIRECTORY = 16;
static std::map<std::wstring, std::wstring> environment;
static std::map<std::wstring, DWORD> attributes;
static std::wstring expanded;
static int expansions = 0;
static std::wstring Env(const wchar_t* name) { return environment[name]; }
static DWORD GetFileAttributesW(const wchar_t* path) {
  auto found = attributes.find(path);
  return found == attributes.end() ? INVALID_FILE_ATTRIBUTES : found->second;
}
static void CharLowerBuffW(wchar_t* value, DWORD count) {
  for (DWORD i = 0; i < count; ++i) value[i] = std::towlower(value[i]);
}
static DWORD GetFullPathNameW(const wchar_t* path, DWORD size, wchar_t* output, void*) {
  ++expansions;
  if (environment[L"GESHER_PROFILE"] != path) throw std::runtime_error("wrong profile expanded");
  if (expanded.empty()) return 0;
  if (size <= expanded.size()) return static_cast<DWORD>(expanded.size() + 1);
  std::copy(expanded.begin(), expanded.end(), output); output[expanded.size()] = 0;
  return static_cast<DWORD>(expanded.size());
}
@PRODUCTION_METHODS@
static int checks = 0;
static void expect(const std::wstring& here, const std::wstring& expected, const char* message) {
  if (GetDataDirectory(here) != expected) throw std::runtime_error(message);
  ++checks;
}
int main() {
  environment[L"LOCALAPPDATA"] = L"C:\\User\\Local";
  expect(L"U:\\Portable", L"C:\\User\\Local\\Gesher\\data", "ordinary profile");
  attributes[L"U:\\Portable\\Data"] = FILE_ATTRIBUTE_DIRECTORY;
  expect(L"U:\\Portable", L"C:\\User\\Local\\Gesher\\data", "bare Data is not portable");
  attributes[L"U:\\Portable\\portable.marker"] = FILE_ATTRIBUTE_DIRECTORY;
  expect(L"U:\\Portable", L"C:\\User\\Local\\Gesher\\data", "marker directory is not a file");
  attributes[L"U:\\Portable\\portable.marker"] = 0;
  expect(L"U:\\Portable", L"U:\\Portable\\Data\\data", "flat portable root");
  expect(L"U:\\Portable\\App", L"U:\\Portable\\Data\\data", "archive runtime App layout");
  expect(L"U:\\Portable\\aPP", L"U:\\Portable\\Data\\data", "App is case insensitive");
  expect(L"U:\\Portable\\Other", L"C:\\User\\Local\\Gesher\\data", "parent marker requires App layout");
  attributes[L"U:\\Portable\\App\\portable.marker"] = 0;
  expect(L"U:\\Portable\\App", L"U:\\Portable\\App\\Data\\data", "own marker takes precedence");
  environment[L"ANDROID_DATA"] = L"/mnt/z/old-profile/data";
  expect(L"U:\\Portable", L"U:\\Portable\\Data\\data", "inherited Android path cannot override runtime profile");
  environment[L"GESHER_PROFILE"] = L"..\\new-profile";
  expanded = L"C:\\Caller\\new-profile";
  expect(L"U:\\Portable", expanded + L"\\data", "explicit new profile takes precedence");
  if (expansions != 2) throw std::runtime_error("explicit profile did not use Win32 full path API");
  ++checks;
  expanded.clear();
  expect(L"U:\\Portable", L"", "invalid profile must not use another profile");
  std::cout << "PASS: production native profile selection (" << checks << " checks)\n";
}
