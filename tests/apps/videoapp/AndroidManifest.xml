<?xml version="1.0" encoding="utf-8"?>
<!-- Video (docs/media.md "Video", ADR 0051): MediaExtractor, MediaCodecList and MediaCodec
     on short generated clips of known colors, each checked from what the APIs report
     (tests/windows/tracks/38-media.ps1). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gesher.videoapp"
    android:versionCode="1"
    android:versionName="1.0">
    <application android:label="@string/app_name">
        <activity
            android:name=".VideoActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
