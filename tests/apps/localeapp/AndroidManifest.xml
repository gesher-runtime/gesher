<?xml version="1.0" encoding="utf-8"?>
<!-- The locale track's test app (tests/windows/tracks/49-locale.ps1, docs/locale.md): what an
     app sees of the locale (its locales, resources, layout direction, numbers, dates and
     times, android:localeConfig), per-app locales (LocaleManager.setApplicationLocales: the
     activity recreated, kept across an app restart, cleared), and Windows' settings changing
     while it runs (an activity that handles locale changes gets onConfigurationChanged; one
     that does not is relaunched; the Application and receivers are told). Each activity
     reports on stdout ("localeapp: ") and finishes; no text is laid out. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gesher.localeapp"
    android:versionCode="1"
    android:versionName="1.0">
    <application
        android:name=".LocaleApp"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".SetLocalesActivity" android:exported="true" />
        <activity android:name=".ClearLocalesActivity" android:exported="true" />
        <activity android:name=".WaitActivity" android:exported="true" />
        <activity
            android:name=".HandlesActivity"
            android:configChanges="locale|layoutDirection"
            android:exported="true" />
        <receiver android:name=".LocaleReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
