<?xml version="1.0" encoding="utf-8"?>
<!-- A test app for device-credential confirmation (ADR 0094, tests/windows/tracks/61-hello-credential.ps1,
     and by hand: HUMAN_TEST.md of the change): what BiometricManager, BiometricPrompt,
     KeyguardManager and the confirm-credential intent answer an ordinary app. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gesher.hellocred"
    android:versionCode="1"
    android:versionName="1.0">
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <application
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
