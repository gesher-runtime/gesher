<?xml version="1.0" encoding="utf-8"?>
<!-- The WebView test app (docs/webview.md, tests/windows/tracks/37-webview.ps1): one
     Activity with two WebViews, one on the APK's assets, one on a remote page. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gesher.webapp"
    android:versionCode="1"
    android:versionName="1.0">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:label="@string/app_name"
        android:theme="@style/WebTheme">
        <activity
            android:name=".WebActivity"
            android:label="@string/activity_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
