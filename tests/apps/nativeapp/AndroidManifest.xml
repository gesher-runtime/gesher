<?xml version="1.0" encoding="utf-8"?>
<!-- A test app for gesher-app with native code: its launcher Activity loads
     lib/x86_64/libnativeapp.so (C++, against libc++_shared.so, both in the
     APK) and calls into it from onCreate. Its .so opens TCP sockets and
     resolves names, which take Android's INTERNET permission. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gesher.nativeapp"
    android:versionCode="1"
    android:versionName="1.0">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:label="@string/app_name"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".NativeActivity"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
