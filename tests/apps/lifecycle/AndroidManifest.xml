<?xml version="1.0" encoding="utf-8"?>
<!-- A test app for gesher-app: one launcher Activity that reports each lifecycle
     callback, a string resource and an attribute of its theme. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gesher.lifecycle"
    android:versionCode="1"
    android:versionName="1.0">
    <application
        android:name=".LifecycleApplication"
        android:label="@string/app_name"
        android:theme="@style/LifecycleTheme">
        <activity
            android:name=".LifecycleActivity"
            android:label="@string/activity_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
