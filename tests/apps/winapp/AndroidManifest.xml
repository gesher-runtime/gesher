<?xml version="1.0" encoding="utf-8"?>
<!-- The windows3 track's test app (docs/windows3.md, tests/windows/tracks/51-windows3.ps1):
     MainActivity (portrait or not, as it asks; it handles no configuration change, so a
     rotation relaunches it) has buttons that start LandActivity (screenOrientation landscape)
     in its task, OtherTaskActivity in a task of its own (multi-resume), turn its own
     orientation (setRequestedOrientation) and move its task to the back, an EditText at the
     bottom (adjustResize: the touch keyboard's IME insets; the clipboard shortcuts), and a
     clipboard listener. PanActivity's EditText is under the keyboard with adjustPan. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gesher.winapp"
    android:versionCode="1"
    android:versionName="1.0">
    <application
        android:label="@string/app_name"
        android:theme="@style/WinTheme">
        <activity
            android:name=".MainActivity"
            android:label="@string/main_label"
            android:windowSoftInputMode="adjustResize|stateUnspecified"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".LandActivity"
            android:label="@string/land_label"
            android:screenOrientation="landscape"
            android:exported="true" />
        <activity
            android:name=".OtherTaskActivity"
            android:label="@string/other_label"
            android:taskAffinity="com.gesher.winapp.other"
            android:exported="true" />
        <activity
            android:name=".PanActivity"
            android:label="@string/pan_label"
            android:windowSoftInputMode="adjustPan|stateUnspecified"
            android:exported="true" />
        <activity android:name=".DisplayActivity" android:label="Gesher windows4 display"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:exported="true" />
        <activity android:name=".DisplayLandActivity" android:label="Gesher windows4 landscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="landscape" android:taskAffinity="com.gesher.winapp.displayland"
            android:exported="true" />
    </application>
</manifest>
