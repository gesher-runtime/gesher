<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No action bar: the content starts at the window's top. -->
    <style name="WinTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
    <!-- A whole-screen application style may still declare windowIsFloating. -->
    <style name="FloatingRootTheme" parent="WinTheme">
        <item name="android:windowIsFloating">true</item>
    </style>
</resources>
