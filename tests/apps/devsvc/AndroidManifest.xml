<?xml version="1.0" encoding="utf-8"?>
<!-- The device services' test app (devsvc track, tests/windows/tracks/57-devsvc.ps1): each
     activity runs one service's checks and finishes, launched with gesher-app's
     activity option: alarms (a manifest receiver and a service reached with the app's
     process stopped, a listener, a repeating alarm, an alarm clock, a cancelled alarm), jobs
     (a one-off and a periodic JobService), the clipboard with Windows', notifications
     (toasts, a notification listener), wake locks and the battery, clock changes; and the
     hwsvc2 track's: toast clicks after the device stopped, the vibrator, content URI job
     triggers, sleep and resume, a time zone change; accounts through the app's own
     authenticator. No
     action bar: no text to lay out while app processes have no system fonts. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gesher.devsvc"
    android:versionCode="1"
    android:versionName="1.0">
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <application
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".AlarmActivity" android:exported="true" />
        <activity android:name=".JobActivity" android:exported="true" />
        <activity android:name=".ClipActivity" android:exported="true" />
        <activity android:name=".NotifyActivity" android:exported="true" />
        <activity android:name=".ProgressNotifyActivity" android:exported="true" />
        <activity android:name=".PowerActivity" android:exported="true" />
        <activity android:name=".TimeActivity" android:exported="true" />
        <activity android:name=".ClickActivity" android:exported="true" />
        <activity android:name=".VibrateActivity" android:exported="true" />
        <activity android:name=".ContentActivity" android:exported="true" />
        <activity android:name=".SleepActivity" android:exported="true" />
        <activity android:name=".ZoneActivity" android:exported="true" />
        <activity android:name=".NetJobActivity" android:exported="true" />
        <activity android:name=".AccountActivity" android:exported="true" />
        <activity android:name=".AccountTokenActivity" android:exported="false" />
        <service android:name=".PrivateAccountService" android:exported="false" />
        <service android:name=".TestPrivateAuthenticator" android:exported="false">
            <intent-filter><action android:name="android.accounts.AccountAuthenticator" /></intent-filter>
            <meta-data android:name="android.accounts.AccountAuthenticator" android:resource="@xml/authenticator_private" />
            <meta-data android:name="android.accounts.AccountAuthenticator.customTokens" android:value="true" />
        </service>
        <service android:name=".TestDisabledAuthenticator" android:exported="false" android:enabled="false">
            <intent-filter><action android:name="android.accounts.AccountAuthenticator" /></intent-filter>
            <meta-data android:name="android.accounts.AccountAuthenticator" android:resource="@xml/authenticator_disabled" />
        </service>
        <!-- Negative authenticator descriptor fixtures; never requested by AccountActivity. -->
        <service android:name=".TestUnprotectedAuthenticator" android:exported="true">
            <intent-filter><action android:name="android.accounts.AccountAuthenticator" /></intent-filter>
            <meta-data android:name="android.accounts.AccountAuthenticator" android:resource="@xml/authenticator_unprotected" />
        </service>
        <service android:name=".TestForgedGoogleAuthenticator" android:exported="false">
            <intent-filter><action android:name="android.accounts.AccountAuthenticator" /></intent-filter>
            <meta-data android:name="android.accounts.AccountAuthenticator" android:resource="@xml/authenticator_forged_google" />
        </service>
        <service android:name=".TestCustomAuthenticator" android:exported="true"
            android:permission="android.permission.BIND_ACCOUNT_AUTHENTICATOR">
            <intent-filter><action android:name="android.accounts.AccountAuthenticator" /></intent-filter>
            <meta-data android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/authenticator_custom" />
        </service>
        <service android:name=".TestAuthenticator" android:exported="true"
            android:permission="android.permission.BIND_ACCOUNT_AUTHENTICATOR">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/authenticator" />
        </service>
        <receiver android:name=".ClickReceiver" android:exported="false" />
        <provider
            android:name=".NotesProvider"
            android:authorities="com.gesher.devsvc.notes"
            android:grantUriPermissions="true"
            android:exported="false" />
        <service android:name=".TestSyncAdapter" android:exported="true"
            android:permission="android.permission.BIND_SYNC_ADAPTER">
            <intent-filter><action android:name="android.content.SyncAdapter" /></intent-filter>
            <meta-data android:name="android.content.SyncAdapter" android:resource="@xml/sync_adapter" />
        </service>
        <receiver android:name=".AlarmReceiver" android:exported="false" />
        <receiver android:name=".TimeReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
        <service android:name=".AlarmService" android:exported="false" />
        <service
            android:name=".TestJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />
        <service
            android:name=".TestListener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
