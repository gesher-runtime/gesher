package android.os;

/**
 * Host stand-in for android.os.SystemClock, whose clocks are native methods in
 * android-all (ApplicationInfo's constructor reads uptimeMillis). Monotonic JVM time;
 * no contract depends on the values.
 */
public final class SystemClock {
    private static final long BASE = System.nanoTime();

    private SystemClock() {
    }

    public static long uptimeMillis() {
        return (System.nanoTime() - BASE) / 1_000_000L;
    }

    public static long uptimeNanos() {
        return System.nanoTime() - BASE;
    }

    public static long elapsedRealtime() {
        return uptimeMillis();
    }

    public static long elapsedRealtimeNanos() {
        return uptimeNanos();
    }

    public static long currentThreadTimeMillis() {
        return uptimeMillis();
    }
}
