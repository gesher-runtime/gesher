// Production OwnedStream, Host::Navigate, Host::RespondToRequest, Do and
// NavigationStarting, with declared COM/WebView/task-queue adapters.
// No browser, network or JNI is used.
#include <objbase.h>
#include <algorithm>
#include <array>
#include <atomic>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <functional>
#include <limits>
#include <map>
#include <memory>
#include <mutex>
#include <new>
#include <set>
#include <string>
#include <thread>
#include <utility>
#include <vector>

std::atomic<bool> tracking{false}, fail_nothrow{false};
std::atomic<uint64_t> allocation_count{0}, allocation_bytes{0}, payload_count{0}, payload_bytes{0};
constexpr size_t kPayload = 4u << 20;

void* operator new(size_t size) {
  void* p = std::malloc(std::max<size_t>(size, 1));
  if (p == nullptr) std::abort();
  if (tracking.load(std::memory_order_relaxed)) {
    ++allocation_count;
    allocation_bytes += size;
    if (size >= kPayload) { ++payload_count; payload_bytes += size; }
  }
  return p;
}
void* operator new(size_t n, const std::nothrow_t&) noexcept {
  if (fail_nothrow.exchange(false)) return nullptr;
  return ::operator new(n);
}
void* operator new[](size_t size) { return ::operator new(size); }
void operator delete(void* p) noexcept { std::free(p); }
void operator delete[](void* p) noexcept { std::free(p); }
void operator delete(void* p, size_t) noexcept { std::free(p); }
void operator delete[](void* p, size_t) noexcept { std::free(p); }
void operator delete(void* p, const std::nothrow_t&) noexcept { std::free(p); }

std::atomic<int> failures{0}, checks{0}, marshal_created{0}, marshal_destroyed{0};
HRESULT marshal_error = S_OK;
void Check(bool value, const char* label) {
  ++checks;
  if (!value) { ++failures; std::fprintf(stderr, "FAIL: %s\n", label); }
}

// The portable seam models aggregation identity and reference ownership only;
// it does not claim Windows COM marshaling execution.
class TestMarshaler final : public IUnknown {
 public:
  class Face final : public IUnknown {
   public:
    explicit Face(IUnknown* outer) : outer_(outer) {}
    HRESULT QueryInterface(REFIID iid, void** out) override { return outer_->QueryInterface(iid, out); }
    ULONG AddRef() override { return outer_->AddRef(); }
    ULONG Release() override { return outer_->Release(); }
   private:
    IUnknown* outer_;
  };
  explicit TestMarshaler(IUnknown* outer) : face_(outer) { ++marshal_created; }
  HRESULT QueryInterface(REFIID iid, void** out) override {
    if (out == nullptr) return E_POINTER;
    *out = nullptr;
    if (!IsEqualIID(iid, IID_IMarshal)) return E_NOINTERFACE;
    *out = &face_; face_.AddRef(); return S_OK;
  }
  ULONG AddRef() override { return ++refs_; }
  ULONG Release() override { ULONG n = --refs_; if (!n) delete this; return n; }
 private:
  ~TestMarshaler() { ++marshal_destroyed; }
  ULONG refs_ = 1;
  Face face_;
};
HRESULT CoCreateFreeThreadedMarshaler(IUnknown* outer, IUnknown** out) {
  *out = nullptr;
  if (FAILED(marshal_error)) return marshal_error;
  *out = new TestMarshaler(outer);
  return S_OK;
}

