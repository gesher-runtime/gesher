namespace gesher::webview {
@COM_POINTER@

constexpr IID IID_ICoreWebView2_2{10}, IID_ICoreWebView2Environment2{11};
constexpr int kFailed = 7, kPageStarted = 3;
using UINT64 = uint64_t;
using BOOL = int;
constexpr BOOL FALSE = 0, TRUE = 1;
#define NUMBERED_NAVIGATION @NUMBERED_NAVIGATION@
constexpr size_t kBridgeBodyLimit = 1024 * 1024;
uint64_t tick = 100;
ULONGLONG GetTickCount64() { return tick; }
std::wstring Hex(HRESULT) { return L"HRESULT"; }
template <typename T> struct RecordedObject {
  ULONG refs = 1;
  bool available = true;
  HRESULT QueryInterface(REFIID, void** out) {
    *out = nullptr;
    if (!available) return E_NOINTERFACE;
    *out = static_cast<T*>(this); AddRef(); return S_OK;
  }
  ULONG AddRef() { return ++refs; }
  ULONG Release() { ULONG n = --refs; if (!n) delete static_cast<T*>(this); return n; }
};
struct ICoreWebView2WebResourceRequest : RecordedObject<ICoreWebView2WebResourceRequest> {
  Com<IStream> content;
  std::wstring url, method, headers;
};
struct ICoreWebView2WebResourceResponse : RecordedObject<ICoreWebView2WebResourceResponse> {
  Com<IStream> content;
  int status = 0;
  std::wstring reason, headers;
};
struct ICoreWebView2Environment2 : RecordedObject<ICoreWebView2Environment2> {
  int requests = 0, responses = 0;
  HRESULT result = S_OK;
  HRESULT CreateWebResourceRequest(LPCWSTR url, LPCWSTR method, IStream* stream,
                                   LPCWSTR headers, ICoreWebView2WebResourceRequest** out) {
    ++requests; *out = nullptr;
    if (FAILED(result)) return result;
    auto* r = new ICoreWebView2WebResourceRequest;
    r->url = url; r->method = method; r->headers = headers; r->content = Com<IStream>(stream);
    *out = r; return S_OK;
  }
  HRESULT CreateWebResourceResponse(IStream* stream, int status, LPCWSTR reason,
                                    LPCWSTR headers, ICoreWebView2WebResourceResponse** out) {
    ++responses; *out = nullptr;
    if (FAILED(result)) return result;
    auto* r = new ICoreWebView2WebResourceResponse;
    r->status = status; r->reason = reason; r->headers = headers; r->content = Com<IStream>(stream);
    *out = r; return S_OK;
  }
};
struct ICoreWebView2_2 : RecordedObject<ICoreWebView2_2> {
  int plain = 0, sent = 0;
  HRESULT result = S_OK;
  std::wstring url;
  Com<ICoreWebView2WebResourceRequest> request;
  std::function<void()> on_navigate;
  HRESULT Navigate(LPCWSTR value) {
    ++plain; url = value; if (on_navigate) on_navigate(); return result;
  }
  HRESULT NavigateWithWebResourceRequest(ICoreWebView2WebResourceRequest* value) {
    ++sent; request = Com<ICoreWebView2WebResourceRequest>(value);
    if (on_navigate) on_navigate();
    return result;
  }
};
using ICoreWebView2 = ICoreWebView2_2;
struct CoString {
  wchar_t* value = nullptr;
  wchar_t** Put() { return &value; }
  std::wstring str() const { return value ? value : L""; }
};
// SDK ownership is an explicit adapter: get_Uri lends the argument's stable
// string for this call. Production callback statements are extracted unchanged.
struct ICoreWebView2NavigationStartingEventArgs {
  std::wstring url;
  UINT64 id;
  BOOL user = FALSE, redirect = FALSE, cancelled = FALSE;
  HRESULT get_Uri(wchar_t** out) { *out = url.data(); return S_OK; }
  HRESULT get_IsUserInitiated(BOOL* out) { *out = user; return S_OK; }
  HRESULT get_IsRedirected(BOOL* out) { *out = redirect; return S_OK; }
  HRESULT get_NavigationId(UINT64* out) { *out = id; return S_OK; }
  HRESULT put_Cancel(BOOL value) { cancelled = value; return S_OK; }
};
struct StartListener {
  int calls = 0;
  int64_t handed = -1;
  std::function<bool()> callback;
  // The default preserves the old three-argument handler in negative controls.
  bool OnNavigationStarting(const std::wstring&, bool, bool, int64_t number = -1) {
    ++calls; handed = number; return callback ? callback() : false;
  }
};
struct Deferral { int completed = 0; void Complete() { ++completed; } };
struct RequestArgs {
  int published = 0;
  Com<ICoreWebView2WebResourceResponse> response;
  void put_Response(ICoreWebView2WebResourceResponse* r) { ++published; response = Com<ICoreWebView2WebResourceResponse>(r); }
};
struct Impl {
  struct Request {
    bool bridge = false;
    uint64_t generation = 7, deadline = 200;
    std::shared_ptr<Deferral> deferral = std::make_shared<Deferral>();
    std::shared_ptr<RequestArgs> args = std::make_shared<RequestArgs>();
  };
  bool api_navigation = false, destroyed = false, closing = false, failed = false, ready = true;
@NAVIGATION_STATE@
  std::wstring main_document, auth_retry;
  std::set<UINT64> cancelled;
  StartListener* listener = nullptr;
  int bridge_cancellations = 0;
  bool bridge_guarded = true;
  uint64_t bridge_generation = 7;
  int reports = 0;
  HRESULT reported = S_OK;
  std::vector<std::function<void(Impl*)>> pending;
  std::map<int64_t, Request> requests;
  Com<ICoreWebView2_2> webview{new ICoreWebView2_2, false};
  Com<ICoreWebView2Environment2> env{new ICoreWebView2Environment2, false};
  struct Event { int type; int64_t id; int32_t arg; std::wstring a, b; };
  std::vector<Event> events;
  void Report(int type, int64_t id, int32_t error, const std::wstring& a,
              const std::wstring& b = L"") {
    ++reports; reported = error; events.push_back({type, id, error, a, b});
  }
};
struct Host {
  explicit Host(std::shared_ptr<Impl> impl) : impl_(std::move(impl)) {}
  @NAVIGATE_DECLARATION@
  @NUMBER_DECLARATION@
  void RespondToRequest(int64_t, int32_t, const std::wstring&, const std::wstring&, std::vector<uint8_t>);
  std::shared_ptr<Impl> impl_;
};
std::vector<std::function<void()>> tasks;
bool copy_posted = false, reject_posted = false;
void PostToWebViewThread(std::function<void()> task) {
  if (reject_posted) return;
  if (copy_posted) tasks.push_back(task);
  else tasks.push_back(std::move(task));
}
void RunTasks() {
  auto running = std::move(tasks);
  for (auto& task : running) task();
}
void RunOneTask() {
  Check(!tasks.empty(), "one queued task is available");
  if (tasks.empty()) return;
  auto task = std::move(tasks.front()); tasks.erase(tasks.begin()); task();
}
@DO@

// SHCreateMemStream's documented copied-buffer boundary, adapted only for the
// exact baseline dispatch; its Windows allocator/COM internals are not measured.
[[maybe_unused]] IStream* SHCreateMemStream(const BYTE* input, UINT length) {
  if (FAILED(marshal_error)) return nullptr;
  std::vector<uint8_t> bytes;
  if (length != 0) bytes.assign(input, input + length);
  IStream* stream = nullptr;
  auto body = std::make_shared<const std::vector<uint8_t>>(std::move(bytes));
  if (FAILED(OwnedStream::Create(std::move(body), &stream))) return nullptr;
  return stream;
}

@NAVIGATE@
@NUMBER_FUNCTION@
@RESPOND@
@DOCUMENT_MATCH@
bool MainResource(Impl* impl, const std::wstring& url, bool document) {
  // The exact production WebResourceRequested main-frame predicate.
  return @RESOURCE_MATCH@;
}
void CancelBridgeRequests(Impl* impl) { ++impl->bridge_cancellations; }
@NAV_START_CALLBACK@
#if NUMBERED_NAVIGATION
void NavigateNumbered(Host& host, const std::wstring& url, const std::wstring& headers,
                       const std::wstring& method, std::vector<uint8_t> body, int64_t number) {
  @NUMBERED_CALL@
}
#endif
