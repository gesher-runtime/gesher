namespace pipe_fault {
inline std::atomic<HANDLE> descriptor{nullptr};
inline std::atomic<size_t> max_chunk{std::numeric_limits<size_t>::max()};
inline std::atomic<size_t> remaining{std::numeric_limits<size_t>::max()};
}
bool BoundaryWriteFile(HANDLE handle, const void* input, DWORD wanted, DWORD* wrote, OVERLAPPED* overlapped) {
  size_t amount = wanted;
  const bool fault = handle == pipe_fault::descriptor.load();
  if (fault) {
    amount = std::min(amount, pipe_fault::max_chunk.load());
    amount = std::min(amount, pipe_fault::remaining.load());
    if (amount == 0) { *wrote = 0; SetLastError(ERROR_WRITE_FAULT); return false; }
  }
  const bool okay = ::WriteFile(handle, input, static_cast<DWORD>(amount), wrote, overlapped) != FALSE;
  if (fault && *wrote && pipe_fault::remaining.load() != std::numeric_limits<size_t>::max())
    pipe_fault::remaining.fetch_sub(*wrote);
  return okay;
}
#define WriteFile BoundaryWriteFile
#else
#include "binder_output_io_boundary.h"
#endif
#include <linux/android/binder.h>
#include "binder_wire.h"
#include "binder_file_descriptions.h"
#include "binder_sg.h"

#ifndef BINDER_OUTPUT_COUNTING
#define BINDER_OUTPUT_COUNTING 1
#endif
namespace accounting {
struct Counters { size_t calls = 0, bytes = 0, live = 0, peak = 0, copied = 0; };
inline Counters counters;
inline thread_local bool enabled = false;
inline void Copy(size_t bytes) {
#if BINDER_OUTPUT_COUNTING
  if (enabled) counters.copied += bytes;
#else
  (void)bytes;
#endif
}
inline void Begin() { counters = {}; enabled = true; }
inline Counters End() { enabled = false; return counters; }
}
#if BINDER_OUTPUT_COUNTING
struct alignas(std::max_align_t) Allocation {
  size_t size;
  bool counted;
};
void* operator new(size_t size) {
  auto* allocation = static_cast<Allocation*>(std::malloc(sizeof(Allocation) + std::max<size_t>(size, 1)));
  if (!allocation) std::abort();
  allocation->size = size;
  allocation->counted = accounting::enabled;
  if (allocation->counted) {
    auto& c = accounting::counters;
    ++c.calls;
    c.bytes += size;
    c.live += size;
    c.peak = std::max(c.peak, c.live);
  }
  return allocation + 1;
}
void operator delete(void* value) noexcept {
  if (!value) return;
  auto* allocation = static_cast<Allocation*>(value) - 1;
  if (allocation->counted) accounting::counters.live -= allocation->size;
  std::free(allocation);
}
void operator delete(void* value, size_t) noexcept { ::operator delete(value); }
void* operator new[](size_t size) { return ::operator new(size); }
void operator delete[](void* value) noexcept { ::operator delete(value); }
void operator delete[](void* value, size_t) noexcept { ::operator delete(value); }
#endif

namespace gesher::binder { class ProtectedPeer; }
// Admission is excluded from this component on both platforms. Keep the actual
// core's handle lifetime, but fail immediately if a test starts using a peer
// registry instead of the explicitly tested legacy self-process boundary.
namespace gesher::process_identity { struct Sid {}; }
namespace gesher::binder_launch {}
namespace gesher::binder_peer {
struct HandleCloser {
  void operator()(void* handle) const { if (handle) CloseHandle(handle); }
};
using OwnedHandle = std::unique_ptr<void, HandleCloser>;
enum class Role { kServiceManager };
struct Peer {
  const OwnedHandle process;
  const Role role;
  // Keep excluded connection declarations well-formed; admission still aborts.
  const std::array<uint8_t, 16> installation{};
};
struct Registry {
  using Lease = std::shared_ptr<const Peer>;
  bool Live(const Lease&) const { std::abort(); }
  Lease Authenticate(HANDLE) const { std::abort(); }
};
}

@PRODUCTION@

#ifdef _WIN32
#undef WriteFile
#endif

namespace {
unsigned checks = 0;
void Check(bool condition, const char* message) {
  ++checks;
  if (!condition) { std::fprintf(stderr, "FAIL broker output: %s\n", message); std::exit(1); }
}

void SetWriteFault(HANDLE descriptor, size_t chunk = std::numeric_limits<size_t>::max(),
                   size_t remaining = std::numeric_limits<size_t>::max()) {
  pipe_fault::max_chunk.store(chunk);
  pipe_fault::remaining.store(remaining);
#ifdef _WIN32
  pipe_fault::descriptor.store(descriptor);
#else
  pipe_fault::descriptor.store(descriptor ? HostFd(descriptor) : -1);
#endif
}

bool HandleOpen(HANDLE handle) {
#ifdef _WIN32
  DWORD flags = 0;
  return GetHandleInformation(handle, &flags) != FALSE;
#else
  return fcntl(HostFd(handle), F_GETFD) != -1;
#endif
}

HANDLE DuplicateForReceiver(HANDLE source) {
  HANDLE result = nullptr;
#ifdef _WIN32
  const auto self = GetCurrentProcess();
#else
  const auto self = HostProcess();
#endif
  Check(DuplicateHandle(self, source, self, &result, 0, FALSE, DUPLICATE_SAME_ACCESS),
        "receiver adopts a distinct actual OS handle");
  return result;
}

// The broker owns opaque handles; events/host pipes test its real duplication
// and retirement. Full native-fence/socket/OFD adoption remains in the SG gates.
struct Resource {
  HANDLE handle = nullptr;
#ifndef _WIN32
  int writer = -1;
#endif
  Resource() {
#ifdef _WIN32
    handle = CreateEventW(nullptr, TRUE, FALSE, nullptr);
    Check(handle != nullptr, "create real transfer resource");
#else
    int endpoints[2];
    Check(pipe(endpoints) == 0, "create real transfer resource");
    handle = HostHandle(endpoints[0]);
    writer = endpoints[1];
#endif
  }
  ~Resource() {
    if (handle) CloseHandle(handle);
#ifndef _WIN32
    if (writer != -1) close(writer);
#endif
  }
  void Verify(HANDLE adopted) {
#ifdef _WIN32
    Check(SetEvent(handle) && WaitForSingleObject(adopted, 0) == WAIT_OBJECT_0,
          "adopted real resource survives broker staging retirement");
#else
    const uint8_t token = 0x6b;
    uint8_t actual = 0;
    Check(write(writer, &token, 1) == 1 && read(HostFd(adopted), &actual, 1) == 1 && actual == token,
          "adopted real resource survives broker staging retirement");
#endif
  }
};

template<class T> T At(const std::vector<uint8_t>& bytes, size_t offset) {
  Check(offset <= bytes.size() && sizeof(T) <= bytes.size() - offset, "independent reply reader bounds");
  T value;
  std::memcpy(&value, bytes.data() + offset, sizeof(value));
  return value;
}

struct Process {
  std::shared_ptr<Proc> proc = std::make_shared<Proc>();
  Process() {
    std::lock_guard<std::mutex> lock(g_lock);
    proc->id = g_next_proc_id++;
    proc->key = uint64_t{0x9a54'1234'0000'0000} + proc->id;
    proc->pid = static_cast<int>(GetCurrentProcessId());
    proc->uid = 10000 + proc->id;
    g_procs[proc->id] = proc;
  }
  ~Process() { ProcRelease(proc.get()); }
};

struct DirectThread {
  Process process;
  std::shared_ptr<Thread> thread = std::make_shared<Thread>();
  DirectThread() {
    thread->proc = process.proc;
    thread->tid = 200 + process.proc->id;
    process.proc->threads.push_back(thread.get());
  }
  ~DirectThread() {
    std::lock_guard<std::mutex> lock(g_lock);
    ThreadRelease(thread.get());
  }
  std::vector<uint8_t> Run(const Out& input) {
    WireReply reply;
    Check(DispatchWriteRead(process.proc.get(), thread.get(),
          In{input.bytes.data(), input.bytes.data() + input.bytes.size()}, reply), "actual write/read dispatch completes");
    return std::move(reply.bytes);
  }
  int Finish(uint64_t id, bool claim, bool accepted) {
    Out input;
    input.Put(id);
    if (!claim) input.Put<uint32_t>(accepted);
    WireReply reply;
    Check(DispatchBufferFinish(thread.get(), claim ? wire::kClaimBuffer : wire::kFinishBuffer,
          In{input.bytes.data(), input.bytes.data() + input.bytes.size()}, reply),
          "actual direct claim/finish dispatch completes");
    Check(reply.bytes.size() == 8, "direct claim/finish has only a status header");
    return At<int32_t>(reply.bytes, 4);
  }
};

struct Connection {
  HANDLE client = nullptr;
  HANDLE server_handle = nullptr;
  std::thread worker;
  Process& process;
  uint32_t tid;
  explicit Connection(Process& owner) : process(owner) {
    static std::atomic<uint32_t> next{300};
    tid = next++;
#ifdef _WIN32
    std::wstring name = L"\\\\.\\pipe\\gesher-binder-output-" + std::to_wstring(GetCurrentProcessId())
        + L"-" + std::to_wstring(tid);
    server_handle = CreateNamedPipeW(name.c_str(), PIPE_ACCESS_DUPLEX,
        PIPE_TYPE_BYTE | PIPE_READMODE_BYTE | PIPE_WAIT | PIPE_REJECT_REMOTE_CLIENTS,
        1, 65536, 65536, 0, nullptr);
    Check(server_handle != INVALID_HANDLE_VALUE, "create actual Windows byte-mode pipe");
    client = CreateFileW(name.c_str(), GENERIC_READ | GENERIC_WRITE, 0, nullptr, OPEN_EXISTING, 0, nullptr);
    Check(client != INVALID_HANDLE_VALUE, "connect actual Windows byte-mode pipe");
    Check(ConnectNamedPipe(server_handle, nullptr) || GetLastError() == ERROR_PIPE_CONNECTED,
          "accept actual Windows byte-mode pipe");
#else
    int pair[2];
    Check(socketpair(AF_UNIX, SOCK_STREAM, 0, pair) == 0, "create actual host byte-stream pair");
    client = HostHandle(pair[0]);
    server_handle = HostHandle(pair[1]);
#endif
    worker = std::thread([this] {
      Out hello;
      hello.Put<uint32_t>(wire::kVersion);
      hello.Put(process.proc->id);
      hello.Put(process.proc->key);
      hello.Put(tid);
      ServeThread(server_handle, In{hello.bytes.data(), hello.bytes.data() + hello.bytes.size()});
      CloseHandle(server_handle);
    });
    auto hello = Read();
    Check(hello.size() == 4 && At<int32_t>(hello, 0) == 0, "actual broker admits connection owner");
  }
  ~Connection() { Close(); }
  void Close() {
    if (client) { CloseHandle(client); client = nullptr; }
    if (worker.joinable()) worker.join();
  }
  std::vector<uint8_t> Read() {
    std::vector<uint8_t> bytes;
    Check(ReadMessage(client, &bytes), "read a complete actual framed reply");
    return bytes;
  }
  std::vector<uint8_t> Exchange(WireReply& request) {
    Check(WriteMessage(client, request), "write actual framed broker request");
    return Read();
  }
  std::vector<uint8_t> WriteRead(const Out& commands, uint64_t limit, bool first, bool nonblocking) {
    WireReply request;
    request.Put<uint32_t>(wire::kWriteRead);
    request.Put(limit);
    request.Put<uint32_t>(first);
    request.Put<uint32_t>(nonblocking);
    request.Write(commands.bytes.data(), commands.bytes.size());
    return Exchange(request);
  }
  int Control(uint32_t command, const Out& arguments = {}) {
    WireReply request;
    request.Put<uint32_t>(wire::kIoctl);
    request.Put(command);
    request.Write(arguments.bytes.data(), arguments.bytes.size());
    auto bytes = Exchange(request);
    return At<int32_t>(bytes, 0);
  }
  int Claim(uint64_t id) {
    WireReply request;
    request.Put<uint32_t>(wire::kClaimBuffer);
    request.Put(id);
    auto bytes = Exchange(request);
    Check(bytes.size() == 4, "claim reply has no nested command bytes");
    return At<int32_t>(bytes, 0);
  }
  int Finish(uint64_t id, bool accepted) {
    WireReply request;
    request.Put<uint32_t>(wire::kFinishBuffer);
    request.Put(id);
    request.Put<uint32_t>(accepted);
    auto bytes = Exchange(request);
    Check(bytes.size() == 4, "finish reply has no nested command bytes");
    return At<int32_t>(bytes, 0);
  }
  void Free(uint64_t id) {
    Out commands;
    commands.Put<uint32_t>(BC_FREE_BUFFER);
    commands.Put(id);
    auto bytes = WriteRead(commands, 0, false, true);
    Check(bytes.size() == 8 && At<int32_t>(bytes, 0) == 0 && At<uint32_t>(bytes, 4) == 1,
          "actual BC_FREE_BUFFER consumes once");
  }
};

std::vector<uint8_t> Pattern(size_t size, uint32_t seed) {
  std::vector<uint8_t> bytes(size);
  for (size_t i = 0; i < size; ++i) bytes[i] = static_cast<uint8_t>((i * 31 + (i >> 8) * 7 + seed) & 255);
  return bytes;
}

struct Payload {
  std::vector<uint8_t> data;
  std::vector<uint64_t> offsets;
  std::vector<uint8_t> extra;
  std::vector<wire::FileDescription> descriptions;
};

Out TransactionCommand(const Payload& payload, uint32_t code, uint32_t flags, bool reply = false,
                       int32_t copy_error = 0, uint32_t target = 0) {
  Out command;
  binder_transaction_data tr{};
  tr.code = code;
  tr.target.handle = target;
  tr.flags = flags;
  tr.data_size = payload.data.size();
  tr.offsets_size = payload.offsets.size() * sizeof(uint64_t);
  if (payload.extra.empty()) {
    command.Put<uint32_t>(reply ? BC_REPLY : BC_TRANSACTION);
    command.Put(tr);
  } else {
    command.Put<uint32_t>(reply ? BC_REPLY_SG : BC_TRANSACTION_SG);
    binder_transaction_data_sg sg{};
    sg.transaction_data = tr;
    sg.buffers_size = payload.extra.size();
    command.Put(sg);
  }
  command.Put(copy_error);
  if (copy_error == 0) {
    command.Put<uint32_t>(static_cast<uint32_t>(payload.descriptions.size()));
    command.Write(payload.data.data(), payload.data.size());
    command.Write(payload.offsets.data(), payload.offsets.size() * sizeof(uint64_t));
    command.Write(payload.extra.data(), payload.extra.size());
    command.Write(payload.descriptions.data(), payload.descriptions.size() * sizeof(wire::FileDescription));
  }
  return command;
}

Payload ScatterGather(size_t child_size = 64) {
  Payload payload;
  // The pinned driver's parent-fixup sentinel rejects a parent at data offset 0.
  payload.data.resize(8 + sizeof(binder_buffer_object) * 2);
  payload.offsets = {8, 8 + sizeof(binder_buffer_object)};
  payload.extra = Pattern(32 + child_size, 59);
  binder_buffer_object parent{}, child{};
  parent.hdr.type = BINDER_TYPE_PTR;
  parent.buffer = 0;
  parent.length = 32;
  child.hdr.type = BINDER_TYPE_PTR;
  child.flags = BINDER_BUFFER_FLAG_HAS_PARENT;
  child.buffer = 32;
  child.length = child_size;
  child.parent = 0;
  child.parent_offset = 8;
  std::memcpy(payload.data.data() + 8, &parent, sizeof(parent));
  std::memcpy(payload.data.data() + 8 + sizeof(parent), &child, sizeof(child));
  // The wire representation owns the pointed-to bytes at relative offsets.
  uint64_t relative_child = 32;
  std::memcpy(payload.extra.data() + 8, &relative_child, sizeof(relative_child));
  return payload;
}

struct Delivery {
  uint64_t id;
  binder_transaction_data transaction;
  Payload payload;
};

Delivery DecodeDelivery(const std::vector<uint8_t>& bytes, uint32_t expected_command, uint32_t code,
                        uint32_t flags, uint32_t sender_uid) {
  Check(At<int32_t>(bytes, 0) == 0 && At<uint32_t>(bytes, 4) == 0, "transaction read status and consumed are independent");
  size_t at = 8;
  uint32_t command = At<uint32_t>(bytes, at);
  at += 4;
  if (command == BR_NOOP || command == BR_SPAWN_LOOPER) { command = At<uint32_t>(bytes, at); at += 4; }
  while (command == BR_TRANSACTION_COMPLETE || command == BR_INCREFS || command == BR_ACQUIRE
         || command == BR_RELEASE || command == BR_DECREFS) {
    if (command != BR_TRANSACTION_COMPLETE) {
      Check(at <= bytes.size() && sizeof(binder_ptr_cookie) <= bytes.size() - at,
            "node notification is bounded before a nested transaction");
      at += sizeof(binder_ptr_cookie);
    }
    command = At<uint32_t>(bytes, at);
    at += 4;
  }
  Check(command == expected_command, "actual transaction/reply command ordering");
  Delivery result{};
  result.transaction = At<binder_transaction_data>(bytes, at);
  at += sizeof(binder_transaction_data);
  const auto& tr = result.transaction;
  Check(tr.code == code && tr.flags == flags && tr.sender_euid == sender_uid
        && tr.sender_pid == static_cast<int>(GetCurrentProcessId()), "transaction origin and flags preserved");
  Check(tr.data.ptr.buffer == 0 && tr.data.ptr.offsets == 0, "wire reply invents no process pointers");
  result.id = At<uint64_t>(bytes, at); at += 8;
  uint64_t extra_size = At<uint64_t>(bytes, at); at += 8;
  uint32_t description_count = At<uint32_t>(bytes, at); at += 4;
  Check(tr.offsets_size % 8 == 0 && result.id != 0, "delivery identity and offset shape");
  Check(tr.data_size + tr.offsets_size + extra_size + uint64_t{description_count} * sizeof(wire::FileDescription)
        == bytes.size() - at, "independent complete wire payload size");
  result.payload.data.assign(bytes.begin() + at, bytes.begin() + at + tr.data_size); at += tr.data_size;
  result.payload.offsets.resize(tr.offsets_size / 8);
  if (tr.offsets_size) std::memcpy(result.payload.offsets.data(), bytes.data() + at, tr.offsets_size);
  at += tr.offsets_size;
  result.payload.extra.assign(bytes.begin() + at, bytes.begin() + at + extra_size); at += extra_size;
  result.payload.descriptions.resize(description_count);
  if (description_count) std::memcpy(result.payload.descriptions.data(), bytes.data() + at,
                                    description_count * sizeof(wire::FileDescription));
  return result;
}

void SamePayload(const Payload& got, const Payload& expected) {
  Check(got.data == expected.data, "every delivered payload byte matches");
  Check(got.offsets == expected.offsets, "every delivered object offset matches");
  Check(got.extra == expected.extra, "every owned scatter-gather byte matches");
  Check(got.descriptions.size() == expected.descriptions.size(), "complete descriptor side table count");
  if (!got.descriptions.empty()) Check(std::memcmp(got.descriptions.data(), expected.descriptions.data(),
      got.descriptions.size() * sizeof(wire::FileDescription)) == 0, "complete descriptor side table bytes");
}

struct Pair {
  Process source, target;
  Connection caller{source}, receiver{target};
  Pair() {
    flat_binder_object node{};
    node.binder = 0x10002000;
    node.cookie = 0x30004000;
    node.flags = FLAT_BINDER_FLAG_ACCEPTS_FDS;
    Out arguments;
    arguments.Put(node);
    Check(receiver.Control(BINDER_SET_CONTEXT_MGR_EXT, arguments) == 0, "actual context-manager node creation");
    Out enter;
    enter.Put<uint32_t>(BC_ENTER_LOOPER);
    auto bytes = receiver.WriteRead(enter, 0, false, true);
    Check(At<int32_t>(bytes, 0) == 0 && At<uint32_t>(bytes, 4) == 1, "actual receiving looper entry");
  }
  void Send(const Payload& payload, uint32_t code, uint32_t flags) {
    auto command = TransactionCommand(payload, code, flags);
    auto bytes = caller.WriteRead(command, 0, false, true);
    Check(bytes.size() == 8 && At<int32_t>(bytes, 0) == 0 && At<uint32_t>(bytes, 4) == 1,
          "actual sender command was consumed once");
  }
};

void TransactionContracts() {
  for (size_t size : {size_t{0}, size_t{1}, size_t{63}, size_t{4096}, size_t{65536}, size_t{1024 * 1024}}) {
    Pair pair;
    Payload payload;
    payload.data = Pattern(size, 3);
    pair.Send(payload, 0x12345678, TF_ONE_WAY);
    auto bytes = pair.receiver.WriteRead({}, 4096, true, true);
    auto delivery = DecodeDelivery(bytes, BR_TRANSACTION, 0x12345678, TF_ONE_WAY, pair.source.proc->uid);
    SamePayload(delivery.payload, payload);
    Check(pair.receiver.Finish(delivery.id, true) == -EINVAL, "unclaimed output cannot be published");
    Check(pair.receiver.Claim(delivery.id + 1) == -EINVAL, "foreign delivery cannot be claimed");
    Check(pair.receiver.Claim(delivery.id) == 0, "actual pending delivery can be claimed");
    Check(pair.receiver.Finish(delivery.id, true) == 0, "claimed output publishes once");
    Check(pair.receiver.Finish(delivery.id, true) == -EINVAL, "duplicate finish preserves delivery state");
    pair.receiver.Free(delivery.id);
  }
  {
    Pair pair;
    auto payload = ScatterGather();
    pair.Send(payload, 0x45, TF_ONE_WAY);
    auto first = DecodeDelivery(pair.receiver.WriteRead({}, 4096, true, true),
                               BR_TRANSACTION, 0x45, TF_ONE_WAY, pair.source.proc->uid);
    SamePayload(first.payload, payload);
    Payload second;
    second.data = Pattern(97, 211);
    pair.Send(second, 0x46, TF_ONE_WAY);
    Check(pair.receiver.Finish(first.id, false) == 0, "abandoned oneway output rolls back");
    auto next = DecodeDelivery(pair.receiver.WriteRead({}, 4096, true, true),
                              BR_TRANSACTION, 0x46, TF_ONE_WAY, pair.source.proc->uid);
    SamePayload(next.payload, second);
    Check(pair.receiver.Finish(next.id, false) == 0, "rollback releases the next oneway owner");
  }
  {
    Pair pair;
    Payload request;
    request.data = Pattern(257, 31);
    pair.Send(request, 0x77, 0);
    auto delivered = DecodeDelivery(pair.receiver.WriteRead({}, 4096, true, true),
                                   BR_TRANSACTION, 0x77, 0, pair.source.proc->uid);
    SamePayload(delivered.payload, request);
    Check(pair.receiver.Claim(delivered.id) == 0 && pair.receiver.Finish(delivered.id, true) == 0,
          "synchronous request is published through its actual owner");
    Payload response;
    response.data = Pattern(4099, 101);
    auto command = TransactionCommand(response, 0x88, 0, true);
    auto written = pair.receiver.WriteRead(command, 0, false, true);
    Check(At<int32_t>(written, 0) == 0 && At<uint32_t>(written, 4) == 1, "actual synchronous reply command");
    auto answer = DecodeDelivery(pair.caller.WriteRead({}, 4096, true, true),
                                BR_REPLY, 0x88, 0, pair.target.proc->uid);
    SamePayload(answer.payload, response);
    Check(pair.caller.Claim(answer.id) == 0 && pair.caller.Finish(answer.id, true) == 0,
          "synchronous answer uses the original waiting caller");
    pair.caller.Free(answer.id);
    pair.receiver.Free(delivered.id);
  }
  {
    Pair pair;
    Payload request;
    request.data = Pattern(71, 53);
    pair.Send(request, 0x91, 0);
    auto delivered = DecodeDelivery(pair.receiver.WriteRead({}, 4096, true, true),
                                   BR_TRANSACTION, 0x91, 0, pair.source.proc->uid);
    Check(pair.receiver.Finish(delivered.id, false) == 0, "failed receiver publication abandons sync output");
    auto failed = pair.caller.WriteRead({}, 4096, true, true);
    Check(At<int32_t>(failed, 0) == 0 && At<uint32_t>(failed, failed.size() - 4) == BR_FAILED_REPLY,
          "abandoned sync output returns genuine failed reply");
  }
}

void NestedAndErrorContracts() {
  for (bool publish_nested : {false, true}) {
    Pair pair;
    flat_binder_object callback{};
    callback.hdr.type = BINDER_TYPE_BINDER;
    callback.flags = FLAT_BINDER_FLAG_ACCEPTS_FDS;
    callback.binder = 0x87650000;
    callback.cookie = 0x43210000;
    Payload outer;
    outer.data = Pattern(sizeof(callback) + 51, 83);
    std::memcpy(outer.data.data(), &callback, sizeof(callback));
    outer.offsets = {0};
    pair.Send(outer, 0x410, 0);
    const auto retained_outer_bytes = pair.receiver.WriteRead({}, 4096, true, true);
    auto delivered = DecodeDelivery(retained_outer_bytes, BR_TRANSACTION, 0x410, 0, pair.source.proc->uid);
    auto handle = At<flat_binder_object>(delivered.payload.data, 0);
    Check(handle.hdr.type == BINDER_TYPE_HANDLE && handle.handle != 0 && handle.cookie == 0,
          "actual callback object translation supplies a live remote handle");
    auto translated = outer;
    std::memcpy(translated.data.data(), &handle, sizeof(handle));
    SamePayload(delivered.payload, translated);
    Check(pair.receiver.Claim(delivered.id) == 0 && pair.receiver.Finish(delivered.id, true) == 0,
          "outer call publishes before its nested callback");

    Payload nested;
    nested.data = Pattern(4097, 203);
    auto call = TransactionCommand(nested, 0x411, 0, false, 0, handle.handle);
    auto call_status = pair.receiver.WriteRead(call, 0, false, true);
    Check(At<int32_t>(call_status, 0) == 0 && At<uint32_t>(call_status, 4) == 1,
          "actual nested callback targets the translated owner");
    const auto nested_bytes = pair.caller.WriteRead({}, 4096, true, true);
    Check(At<uint32_t>(nested_bytes, 12) == BR_INCREFS && At<uint32_t>(nested_bytes, 32) == BR_ACQUIRE,
          "real node ownership commands precede the nested transaction");
    for (size_t at : {size_t{16}, size_t{36}}) {
      auto owner = At<binder_ptr_cookie>(nested_bytes, at);
      Check(owner.ptr == callback.binder && owner.cookie == callback.cookie,
            "nested read preserves the exact callback owner identity");
    }
    auto received = DecodeDelivery(nested_bytes, BR_TRANSACTION, 0x411, 0, pair.target.proc->uid);
    SamePayload(received.payload, nested);
    Check(received.transaction.target.ptr == callback.binder && received.transaction.cookie == callback.cookie,
          "nested transaction returns to the original waiting caller thread");

    Out acknowledge;
    binder_ptr_cookie owner{callback.binder, callback.cookie};
    acknowledge.Put<uint32_t>(BC_INCREFS_DONE); acknowledge.Put(owner);
    acknowledge.Put<uint32_t>(BC_ACQUIRE_DONE); acknowledge.Put(owner);
    Payload nested_answer;
    nested_answer.data = Pattern(63, 109);
    if (publish_nested) {
      Check(pair.caller.Claim(received.id) == 0 && pair.caller.Finish(received.id, true) == 0,
            "nested caller publishes its own pending delivery");
      auto reply = TransactionCommand(nested_answer, 0x412, 0, true);
      acknowledge.Write(reply.bytes.data(), reply.bytes.size());
    } else {
      Check(pair.caller.Finish(received.id, false) == 0, "nested output failure rolls back its actual stack entry");
    }
    auto ack_status = pair.caller.WriteRead(acknowledge, 0, false, true);
    Check(At<int32_t>(ack_status, 0) == 0 && At<uint32_t>(ack_status, 4) == (publish_nested ? 3u : 2u),
          "node acknowledgments and optional reply retain exact consumed count");
    auto answer_bytes = pair.receiver.WriteRead({}, 4096, true, true);
    if (publish_nested) {
      auto answer = DecodeDelivery(answer_bytes, BR_REPLY, 0x412, 0, pair.source.proc->uid);
      SamePayload(answer.payload, nested_answer);
      Check(pair.receiver.Claim(answer.id) == 0 && pair.receiver.Finish(answer.id, true) == 0,
            "nested reply publishes to its original callback caller");
      pair.receiver.Free(answer.id);
      pair.caller.Free(received.id);
    } else {
      Check(At<int32_t>(answer_bytes, 0) == 0 && At<uint32_t>(answer_bytes, answer_bytes.size() - 4) == BR_FAILED_REPLY,
            "failed nested publication reaches the actual nested caller");
    }

    Payload outer_answer;
    outer_answer.data = Pattern(65539, 151);
    auto reply = TransactionCommand(outer_answer, 0x413, 0, true);
    auto reply_status = pair.receiver.WriteRead(reply, 0, false, true);
    Check(At<int32_t>(reply_status, 0) == 0 && At<uint32_t>(reply_status, 4) == 1,
          "outer reply still uses the preserved outer transaction stack");
    auto final = DecodeDelivery(pair.caller.WriteRead({}, 4096, true, true),
                                BR_REPLY, 0x413, 0, pair.target.proc->uid);
    SamePayload(final.payload, outer_answer);
    Check(pair.caller.Claim(final.id) == 0 && pair.caller.Finish(final.id, true) == 0,
          "outer answer publishes after nested success or rollback");
    pair.caller.Free(final.id);
    pair.receiver.Free(delivered.id);
    auto retained = DecodeDelivery(retained_outer_bytes, BR_TRANSACTION, 0x410, 0, pair.source.proc->uid);
    SamePayload(retained.payload, translated);
    {
      std::lock_guard<std::mutex> lock(g_lock);
      Check(pair.source.proc->buffers.empty() && pair.target.proc->buffers.empty(),
            "all nested and outer buffer owners retire");
    }
  }
  for (bool copy_error : {false, true}) {
    Pair pair;
    Payload payload = ScatterGather();
    if (!copy_error) payload.extra.clear(); // pointer objects without their owned bytes are invalid.
    auto command = TransactionCommand(payload, 0x414, TF_ONE_WAY, false, copy_error ? -EFAULT : 0);
    auto status = pair.caller.WriteRead(command, 4096, true, true);
    Check(At<int32_t>(status, 0) == 0 && At<uint32_t>(status, 4) == 1
          && At<uint32_t>(status, status.size() - 4) == BR_FAILED_REPLY,
          "real copy/layout failure reports failed transaction with exact consumed count");
    std::lock_guard<std::mutex> lock(g_lock);
    Check(pair.target.proc->buffers.empty(), "invalid input creates no receiver buffer owner");
  }
}

Payload FilePayload(const Resource& file, const Resource& shared) {
  Payload payload;
  binder_fd_object object{};
  object.hdr.type = BINDER_TYPE_FD;
  object.pad_binder = reinterpret_cast<uintptr_t>(file.handle);
  payload.data = Pattern(sizeof(object) + 19, 93);
  std::memcpy(payload.data.data(), &object, sizeof(object));
  payload.offsets = {0};
  payload.descriptions.push_back({0, reinterpret_cast<uintptr_t>(shared.handle), 0, 0});
  return payload;
}

std::pair<HANDLE, HANDLE> StagingHandles(const Delivery& delivery, const Payload& original) {
  Check(delivery.payload.descriptions.size() == 1 && delivery.payload.offsets == original.offsets,
        "actual translated FD side table and object order retained");
  auto object = At<binder_fd_object>(delivery.payload.data, 0);
  const auto& description = delivery.payload.descriptions[0];
  Check(object.hdr.type == BINDER_TYPE_FD && object.pad_flags == 0 && description.object_offset == 0
        && description.kind == 0 && description.reserved == 0, "FD type and metadata preserved");
  auto handle = reinterpret_cast<HANDLE>(static_cast<uintptr_t>(object.pad_binder));
  auto shared = reinterpret_cast<HANDLE>(static_cast<uintptr_t>(description.shared_handle));
  Check(handle && shared && HandleOpen(handle) && HandleOpen(shared), "real staged handles exist until finish");
  auto expected = original;
  std::memcpy(expected.data.data(), &object, sizeof(object));
  expected.descriptions[0].shared_handle = description.shared_handle;
  SamePayload(delivery.payload, expected);
  return {handle, shared};
}

void FileAndFailureContracts() {
  for (bool accepted : {false, true}) {
    Resource file, shared;
    Pair pair;
    const auto payload = FilePayload(file, shared);
    pair.Send(payload, 0x301, TF_ONE_WAY);
    // Exercise production WriteExact's repeated writes, each backed by real I/O.
    SetWriteFault(pair.receiver.server_handle, 3);
    auto delivery = DecodeDelivery(pair.receiver.WriteRead({}, 4096, true, true),
                                   BR_TRANSACTION, 0x301, TF_ONE_WAY, pair.source.proc->uid);
    SetWriteFault(nullptr);
    auto [staged, staged_shared] = StagingHandles(delivery, payload);
    Check(staged != file.handle && staged_shared != shared.handle, "staging duplicates never steal source ownership");
    HANDLE adopted = nullptr, adopted_shared = nullptr;
    if (accepted) {
      Check(pair.receiver.Claim(delivery.id) == 0, "FD delivery is claimed before publication");
      adopted = DuplicateForReceiver(staged);
      adopted_shared = DuplicateForReceiver(staged_shared);
    }
    Check(pair.receiver.Finish(delivery.id, accepted) == 0, "actual FD finish/abort completes");
    Check(!HandleOpen(staged) && !HandleOpen(staged_shared), "finish/abort closes both real staging handles");
    Check(HandleOpen(file.handle) && HandleOpen(shared.handle), "source handles remain owned by the sender");
    if (accepted) {
      pair.receiver.Free(delivery.id);
      file.Verify(adopted);
      shared.Verify(adopted_shared);
      Check(pair.receiver.Finish(delivery.id, true) == -EINVAL, "late finish cannot retire adopted handles");
      Check(HandleOpen(adopted) && HandleOpen(adopted_shared), "late protocol message retains adopted resources");
      CloseHandle(adopted);
      CloseHandle(adopted_shared);
    }
    Check(pair.target.proc->buffers.empty(), "FD buffer ownership is fully retired");
  }
  {
    Resource file, shared;
    Pair pair;
    auto payload = FilePayload(file, shared);
    payload.data.resize(65536, 0x37);
    pair.Send(payload, 0x302, TF_ONE_WAY);
    HANDLE staged = nullptr, staged_shared = nullptr;
    {
      std::lock_guard<std::mutex> lock(g_lock);
      Check(pair.target.proc->buffers.size() == 1, "in-flight FD buffer exists before failed transport");
      Buffer* buffer = pair.target.proc->buffers.begin()->second;
      binder_fd_object object{};
      std::memcpy(&object, buffer->data.data(), sizeof(object));
      staged = reinterpret_cast<HANDLE>(static_cast<uintptr_t>(object.pad_binder));
      staged_shared = reinterpret_cast<HANDLE>(static_cast<uintptr_t>(buffer->descriptions[0].shared_handle));
    }
    SetWriteFault(pair.receiver.server_handle, 7, 79);
    WireReply request;
    request.Put<uint32_t>(wire::kWriteRead);
    request.Put<uint64_t>(4096);
    request.Put<uint32_t>(1);
    request.Put<uint32_t>(1);
    Check(WriteMessage(pair.receiver.client, request), "submit real read before injected partial-write failure");
    std::vector<uint8_t> incomplete;
    Check(!ReadMessage(pair.receiver.client, &incomplete), "partial output failure is never reported as a complete reply");
    pair.receiver.Close();
    SetWriteFault(nullptr);
    Check(pair.target.proc->threads.empty() && pair.target.proc->buffers.empty(),
          "failed transport retires the pending thread and unpublished buffer");
    Check(!HandleOpen(staged) && !HandleOpen(staged_shared), "failed transport releases both staging owners");
    Check(HandleOpen(file.handle) && HandleOpen(shared.handle), "failed transport preserves source ownership");
  }
}

Out Request(uint64_t limit, bool first, bool nonblocking) {
  Out input;
  input.Put(limit);
  input.Put<uint32_t>(first);
  input.Put<uint32_t>(nonblocking);
  return input;
}

void HeaderContracts() {
  uint8_t input_bytes[] = {0x12, 0x34, 0x56};
  In empty_view{nullptr, nullptr};
  Check(empty_view.Read(nullptr, 0) && empty_view.p == nullptr, "zero-byte empty view neither dereferences nor advances null");
  In near_end{input_bytes + 2, input_bytes + 3};
  uint8_t value = 0xa5;
  Check(near_end.Read(nullptr, 0) && near_end.p == input_bytes + 2,
        "zero-byte copy preserves a nonempty cursor");
  Check(!near_end.Read(&value, 2) && value == 0xa5 && near_end.p == input_bytes + 2,
        "failed bounded read preserves output and cursor");
  Check(near_end.Read(&value, 1) && value == 0x56 && near_end.p == input_bytes + 3,
        "final available byte is read exactly once");
  Check(near_end.Read(nullptr, 0) && near_end.p == input_bytes + 3
        && !near_end.Read(&value, 1) && value == 0x56,
        "zero-byte end read does not admit a subsequent nonzero overrun");
  DirectThread fixture;
  auto empty = Request(0, false, false);
  auto bytes = fixture.Run(empty);
  Check(bytes.size() == 12 && At<int32_t>(bytes, 4) == 0 && At<uint32_t>(bytes, 8) == 0,
        "empty reply retains exact status and consumed fields");

  auto enter = empty;
  enter.Put<uint32_t>(BC_ENTER_LOOPER);
  bytes = fixture.Run(enter);
  Check(bytes.size() == 12 && At<int32_t>(bytes, 4) == 0 && At<uint32_t>(bytes, 8) == 1,
        "one actual command is consumed exactly once");

  auto truncated = enter;
  truncated.Put<uint32_t>(BC_FREE_BUFFER);
  bytes = fixture.Run(truncated);
  Check(bytes.size() == 12 && At<int32_t>(bytes, 4) == -EFAULT && At<uint32_t>(bytes, 8) == 1,
        "partial command failure retains earlier consumed count");

  auto invalid = empty;
  invalid.Put<uint32_t>(BC_ATTEMPT_ACQUIRE);
  bytes = fixture.Run(invalid);
  Check(At<int32_t>(bytes, 4) == -EINVAL && At<uint32_t>(bytes, 8) == 0,
        "write failure is not replaced by a successful read status");

  fixture.thread->looper_need_return = false;
  auto read = Request(4096, true, true);
  bytes = fixture.Run(read);
  Check(bytes.size() == 16 && At<int32_t>(bytes, 4) == -EAGAIN
        && At<uint32_t>(bytes, 8) == 0 && At<uint32_t>(bytes, 12) == BR_NOOP,
        "actual read failure updates status after the header was reserved");

  fixture.thread->pending_buffer = 12345;
  bytes = fixture.Run(enter);
  Check(bytes.size() == 12 && At<int32_t>(bytes, 4) == -EINVAL && At<uint32_t>(bytes, 8) == 0,
        "pending delivery blocks subsequent writes without consuming commands");
  fixture.thread->pending_buffer = 0;

  ErrorWork error;
  error.cmd = BR_FAILED_REPLY;
  EnqueueThreadWork(fixture.thread.get(), &error);
  const size_t limit = 4 + sizeof(binder_transaction_data_secctx) + 4;
  bytes = fixture.Run(Request(limit - 1, true, true));
  Check(bytes.size() == 16 && error.list != nullptr, "one-byte-short client read limit leaves work queued");
  bytes = fixture.Run(Request(limit, true, true));
  Check(bytes.size() == 20 && At<uint32_t>(bytes, 16) == BR_FAILED_REPLY && error.list == nullptr,
        "wire status header consumes no Android read-buffer budget");

  fixture.thread->looper_need_return = true;
  fixture.process.proc->max_threads = 1;
  auto spawn = Request(4096, true, true);
  spawn.Put<uint32_t>(BC_ENTER_LOOPER);
  bytes = fixture.Run(spawn);
  Check(bytes.size() == 16 && At<int32_t>(bytes, 4) == 0 && At<uint32_t>(bytes, 8) == 1
        && At<uint32_t>(bytes, 12) == BR_SPAWN_LOOPER && fixture.process.proc->requested_threads == 1,
        "spawn replaces the first command without overwriting status or consumed");
  bytes = fixture.Run(Request(4096, true, true));
  Check(At<uint32_t>(bytes, 12) == BR_NOOP && fixture.process.proc->requested_threads == 1,
        "pending spawn is not requested twice");
}

// A single-thread driver boundary for reproducible CPU/allocation measurements.
// The actual ThreadWrite/ThreadRead/claim/finish/free code is unchanged. Pipe I/O,
// process admission, and Windows scheduling are covered above, not timed here.
struct DirectPair {
  DirectThread caller, receiver;
  Out send, read = Request(4096, true, true);
  const size_t payload_bytes;
  explicit DirectPair(const Payload& payload)
      : payload_bytes(payload.data.size() + payload.offsets.size() * sizeof(uint64_t)
                      + payload.extra.size() + payload.descriptions.size() * sizeof(wire::FileDescription)) {
    flat_binder_object node{};
    node.binder = 0x60002000;
    node.cookie = 0x70004000;
    node.flags = FLAT_BINDER_FLAG_ACCEPTS_FDS;
    Out arguments, output;
    arguments.Put(node);
    {
      std::lock_guard<std::mutex> lock(g_lock);
      Check(DoIoctl(receiver.process.proc.get(), receiver.thread.get(), BINDER_SET_CONTEXT_MGR_EXT,
                    In{arguments.bytes.data(), arguments.bytes.data() + arguments.bytes.size()}, &output) == 0,
            "actual context manager for direct serializer measurement");
    }
    auto enter = Request(0, false, true);
    enter.Put<uint32_t>(BC_ENTER_LOOPER);
    receiver.Run(enter);
    send = Request(4096, true, true);
    auto command = TransactionCommand(payload, 0x456789ab, TF_ONE_WAY);
    send.Write(command.bytes.data(), command.bytes.size());
  }
  void Queue() {
    auto bytes = caller.Run(send);
    Check(bytes.size() == 20 && At<int32_t>(bytes, 4) == 0 && At<uint32_t>(bytes, 8) == 1
          && At<uint32_t>(bytes, 16) == BR_TRANSACTION_COMPLETE,
          "actual sender parser completes and consumes the queued transaction");
  }
  uint64_t Validate(const std::vector<uint8_t>& bytes) const {
    Check(bytes.size() == 40 + sizeof(binder_transaction_data) + payload_bytes
          && At<int32_t>(bytes, 4) == 0 && At<uint32_t>(bytes, 8) == 0
          && At<uint32_t>(bytes, 12) == BR_NOOP && At<uint32_t>(bytes, 16) == BR_TRANSACTION,
          "direct output framing and complete payload length");
    auto transaction = At<binder_transaction_data>(bytes, 20);
    Check(transaction.code == 0x456789ab && transaction.flags == TF_ONE_WAY
          && transaction.sender_euid == caller.process.proc->uid,
          "direct output origin and command are actual broker results");
    return At<uint64_t>(bytes, 20 + sizeof(binder_transaction_data));
  }
  void Retire(uint64_t id) {
    Check(receiver.Finish(id, true, false) == 0 && receiver.Finish(id, false, true) == 0,
          "direct output uses actual claim followed by successful finish");
    auto free = Request(0, false, true);
    free.Put<uint32_t>(BC_FREE_BUFFER);
    free.Put(id);
    auto bytes = receiver.Run(free);
    Check(bytes.size() == 12 && At<int32_t>(bytes, 4) == 0 && At<uint32_t>(bytes, 8) == 1,
          "direct output buffer is released through actual BC_FREE_BUFFER");
  }
  uint64_t Transfer() {
    Queue();
    auto bytes = receiver.Run(read);
    const auto id = Validate(bytes);
    const auto checksum = bytes.size() + bytes.back();
    Retire(id);
    return checksum;
  }
  accounting::Counters OutputCounts(bool require_direct) {
    Queue();
    uint64_t id;
    size_t serialized_body;
    accounting::Begin();
    {
      auto bytes = receiver.Run(read);
      id = Validate(bytes);
      serialized_body = bytes.size() - sizeof(uint32_t);
    }
    auto result = accounting::End();
    Retire(id);
#if BINDER_OUTPUT_COUNTING
    Check(result.live == 0, "every output allocation is retired after its request");
    if (require_direct) Check(result.copied == serialized_body,
                              "one serialized body pass; no complete nested-output recopy");
#else
    (void)require_direct;
    (void)serialized_body;
#endif
    return result;
  }
};

void OutputOwnershipContracts(bool require_direct) {
  for (size_t size : {size_t{0}, size_t{64}, size_t{4096}, size_t{65536}, size_t{1024 * 1024}}) {
    Payload payload;
    payload.data = Pattern(size, 17);
    DirectPair pair(payload);
    pair.OutputCounts(require_direct);
    pair.Transfer();
  }
  DirectPair pair(ScatterGather(256 * 1024));
  pair.OutputCounts(require_direct);
  pair.Transfer();
}

void Measure(const std::string& selected, unsigned samples) {
  struct Case { const char* name; size_t size; unsigned iterations; bool sg; };
  const Case cases[] = {{"tiny64", 64, 50000, false}, {"page4k", 4096, 20000, false},
                        {"parcel64k", 65536, 4000, false}, {"parcel1m", 1024 * 1024, 300, false},
                        {"sg256k", 256 * 1024, 1200, true}};
  for (const auto& item : cases) {
    if (selected != "all" && selected != item.name) continue;
    Payload payload;
    if (item.sg) payload = ScatterGather(item.size);
    else payload.data = Pattern(item.size, 17);
    DirectPair pair(payload);
    auto counts = pair.OutputCounts(false);
    for (int sample = -2; sample < static_cast<int>(samples); ++sample) {
      uint64_t checksum = 0;
      auto started = std::chrono::steady_clock::now();
      auto cpu = std::clock();
      for (unsigned i = 0; i < item.iterations; ++i) checksum += pair.Transfer();
      double cpu_ms = 1000.0 * static_cast<double>(std::clock() - cpu) / CLOCKS_PER_SEC;
      double wall_ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - started).count();
      std::printf("BINDER_OUTPUT_SAMPLE {\"case\":\"%s\",\"sample\":%d,\"iterations\":%u,\"cpu_ms\":%.6f,"
                  "\"wall_ms\":%.6f,\"checksum\":%llu,\"output_allocations\":%zu,\"output_requested_bytes\":%zu,"
                  "\"output_peak_bytes\":%zu,\"output_copy_bytes\":%zu,\"output_live_after\":%zu}\n",
                  item.name, sample, item.iterations, cpu_ms, wall_ms, static_cast<unsigned long long>(checksum),
                  counts.calls, counts.bytes, counts.peak, counts.copied, counts.live);
    }
  }
  if (selected == "all" || selected == "empty") {
    DirectThread fixture;
    auto input = Request(0, false, true);
    constexpr unsigned iterations = 500000;
    for (int sample = -2; sample < static_cast<int>(samples); ++sample) {
      uint64_t checksum = 0;
      auto started = std::chrono::steady_clock::now();
      auto cpu = std::clock();
      for (unsigned i = 0; i < iterations; ++i) checksum += fixture.Run(input).size();
      double cpu_ms = 1000.0 * static_cast<double>(std::clock() - cpu) / CLOCKS_PER_SEC;
      double wall_ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - started).count();
      std::printf("BINDER_OUTPUT_SAMPLE {\"case\":\"empty\",\"sample\":%d,\"iterations\":%u,\"cpu_ms\":%.6f,"
                  "\"wall_ms\":%.6f,\"checksum\":%llu}\n", sample, iterations, cpu_ms, wall_ms,
                  static_cast<unsigned long long>(checksum));
    }
  }
}
}

int main(int argc, char** argv) {
  const std::string mode = argc > 1 ? argv[1] : "gate";
  if (mode == "measure") {
    Measure(argc > 2 ? argv[2] : "all", argc > 3 ? static_cast<unsigned>(std::strtoul(argv[3], nullptr, 10)) : 3);
    Check(g_procs.empty(), "all measured owners retire");
    return 0;
  }
  HeaderContracts();
  TransactionContracts();
  NestedAndErrorContracts();
  FileAndFailureContracts();
  OutputOwnershipContracts(mode != "reference");
  Check(g_procs.empty(), "all direct broker process owners retire");
  std::printf("BINDER_OUTPUT_PASS checks=%u\n", checks);
}
