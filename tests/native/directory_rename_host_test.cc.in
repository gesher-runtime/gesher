// Production Rename and its volume guard are inserted unchanged. The Win32
// boundary records mutation and metadata errors without touching real files.
#include <cerrno>
#include <cstdint>
#include <cstdio>
#include <cstring>
#include <cwchar>
#include <string>

using DWORD = uint32_t;
using BOOL = int;
using HANDLE = int*;
static constexpr HANDLE INVALID_HANDLE_VALUE = nullptr;
static constexpr DWORD DELETE = 0x10000, SYNCHRONIZE = 0x100000, FILE_READ_ATTRIBUTES = 0x80,
    FILE_SHARE_READ = 1, FILE_SHARE_WRITE = 2, FILE_SHARE_DELETE = 4, OPEN_EXISTING = 3,
    FILE_FLAG_BACKUP_SEMANTICS = 0x02000000, FILE_FLAG_OPEN_REPARSE_POINT = 0x00200000,
    FILE_ATTRIBUTE_DIRECTORY = 0x10, INVALID_FILE_ATTRIBUTES = 0xffffffff,
    ERROR_NOT_SAME_DEVICE = EXDEV, ERROR_ALREADY_EXISTS = EEXIST, MOVEFILE_REPLACE_EXISTING = 1;
enum FILE_INFO_BY_HANDLE_CLASS { Placeholder };
struct BY_HANDLE_FILE_INFORMATION {
  DWORD dwFileAttributes, dwVolumeSerialNumber, nFileIndexHigh, nFileIndexLow;
};
struct FILE_RENAME_INFO {
  DWORD Flags;
  HANDLE RootDirectory;
  DWORD FileNameLength;
  wchar_t FileName[1];
};
static int checks, failures;
static int source_handle, destination_handle, live_handles, deletes, renames, moves;
static int inspect_error, destination_open_error, delete_error;
static DWORD source_volume, destination_volume, last_error;
static bool source_directory, destination_directory, destination_exists, destination_link, empty, same;
static void Check(bool value, const char* what) {
  ++checks;
  if (!value) { ++failures; std::fprintf(stderr, "FAIL directory rename: %s (errno=%d)\n", what, errno); }
}
static void Reset() {
  source_handle = 1; destination_handle = 2;
  live_handles = deletes = renames = moves = inspect_error = destination_open_error = delete_error = 0;
  source_volume = 11; destination_volume = 22; last_error = 0;
  source_directory = destination_directory = destination_exists = empty = true;
  destination_link = same = false;
  errno = 0;
}
static DWORD GetLastError() { return last_error; }
static void SetLastError(DWORD error) { last_error = error; }
static HANDLE CreateFileW(const wchar_t* path, DWORD, DWORD, void*, DWORD, DWORD, void*) {
  const bool destination = std::wcscmp(path, L"to") == 0;
  if (destination && destination_open_error) { last_error = destination_open_error; return INVALID_HANDLE_VALUE; }
  ++live_handles;
  return destination ? &destination_handle : &source_handle;
}
static BOOL CloseHandle(HANDLE) { --live_handles; return 1; }
static BOOL GetFileInformationByHandle(HANDLE handle, BY_HANDLE_FILE_INFORMATION* info) {
  const bool destination = handle == &destination_handle;
  if (destination && inspect_error) { last_error = inspect_error; return 0; }
  *info = {(destination ? destination_directory : source_directory) ? FILE_ATTRIBUTE_DIRECTORY : 0,
           destination ? destination_volume : source_volume, 0, destination ? 2u : 1u};
  return 1;
}
static BOOL SetFileInformationByHandle(HANDLE, FILE_INFO_BY_HANDLE_CLASS, void*, DWORD) {
  ++renames;
  if (source_volume != destination_volume) { last_error = EXDEV; return 0; }
  return 1;
}
static BOOL MoveFileExW(const wchar_t*, const wchar_t*, DWORD) { ++moves; last_error = EACCES; return 0; }
static int _wcsicmp(const wchar_t* a, const wchar_t* b) { return wcscasecmp(a, b); }
static int _wcsnicmp(const wchar_t* a, const wchar_t* b, size_t n) { return wcsncasecmp(a, b, n); }
namespace gesher {
static int FailWithLastError() { errno = last_error; return -1; }
static bool DiskPath(const char* path, std::wstring* result, int) {
  if (!path) { errno = EFAULT; return false; }
  result->assign(path, path + std::strlen(path)); return true;
}
static bool IsSymlinkHandle(HANDLE handle) { return handle == &destination_handle && destination_link; }
static int PosixDelete(const std::wstring&, bool) {
  ++deletes;
  if (delete_error) { errno = delete_error; return -1; }
  destination_exists = false;
  return 0;
}
}
static bool SameFile(HANDLE, const std::wstring&) { return same; }
static DWORD AttributesNoFollow(const std::wstring&, bool* link) {
  *link = false;
  return destination_exists ? (destination_directory ? FILE_ATTRIBUTE_DIRECTORY : 0) : INVALID_FILE_ATTRIBUTES;
}
static bool IsEmptyDirectory(const std::wstring&) { return empty; }
static std::wstring NtPath(const std::wstring& path) { return path; }

@PRODUCTION_RENAME@

static void Preservation(const char* label) {
  Check(destination_exists && deletes == 0, label);
  Check(live_handles == 0, "all opened handles are released");
}
int main() {
  Reset();
  Check(Rename("from", "to", 0) == -1 && errno == EXDEV, "cross-volume directory rename rejects");
  Preservation("cross-volume directory rejection does not delete destination");

  Reset(); empty = false;
  Check(Rename("from", "to", 0) == -1 && errno == EXDEV, "volume boundary precedes target contents");
  Preservation("nonempty cross-volume destination stays intact");

  Reset(); destination_open_error = EACCES;
  Check(Rename("from", "to", 0) == -1 && errno == EACCES, "destination inspection open error is retained");
  Preservation("inaccessible target is not deleted");

  Reset(); inspect_error = EIO;
  Check(Rename("from", "to", 0) == -1 && errno == EIO, "destination metadata error is retained");
  Preservation("failed metadata inspection is nondestructive");

  Reset(); destination_volume = source_volume; destination_link = true;
  Check(Rename("from", "to", 0) == -1 && errno == ENOTDIR, "changed link destination is rejected");
  Preservation("changed destination is not deleted");

  Reset(); destination_volume = source_volume;
  Check(Rename("from", "to", 0) == 0 && deletes == 1 && renames == 1,
        "existing same-volume empty-directory replacement remains available");
  Check(live_handles == 0, "successful replacement releases metadata handles");

  Reset(); destination_volume = source_volume; empty = false;
  Check(Rename("from", "to", 0) == -1 && errno == ENOTEMPTY, "same-volume nonempty directory still rejects");
  Preservation("same-volume nonempty directory stays intact");

  Reset(); destination_volume = source_volume; delete_error = EACCES;
  Check(Rename("from", "to", 0) == -1 && errno == EACCES && renames == 0,
        "existing same-volume delete denial precedes rename");
  Check(destination_exists && live_handles == 0, "denied replacement retains directory and closes handles");

  Reset(); same = true;
  Check(Rename("from", "to", 0) == 0, "same-file rename stays a no-op");
  Preservation("same-file no-op is nondestructive");

  Reset();
  Check(Rename("from", "to", kRenameNoReplace) == -1 && errno == EEXIST,
        "no-replace still rejects an existing target");
  Preservation("no-replace keeps target");

  Reset(); source_directory = destination_directory = false;
  Check(Rename("from", "to", 0) == -1 && errno == EXDEV, "ordinary file volume boundary still rejects");
  Preservation("ordinary cross-volume file rename keeps target");
  Check(moves == 0, "cross-volume errors cannot enter copy-based fallback");

  std::printf("directory rename contracts: %d checks, %d failures\n", checks, failures);
  return failures != 0;
}
