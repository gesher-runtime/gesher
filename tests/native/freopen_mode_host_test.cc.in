// The mode parsers and reopen bodies below come from the production files.
// Native Windows path/CRT/record-lock boundaries are explicitly adapted here.
// The CRT adapter translates only N -> e before calling real Linux freopen;
// it does not infer exclusive creation or inheritance from the requested mode.
#include <cerrno>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <string>
#include <fcntl.h>
#include <unistd.h>

static int failures;
static int checks;
static void check(const char* name, int ok) {
  ++checks;
  if (!ok) { ++failures; std::fprintf(stderr, "FAIL: %s\n", name); }
}

static int stream_depth;
static int transactions;
static int completions;
static int crt_calls;
static int admission_error;
static bool fail_close_after_consuming;
static bool expect_reset;
static FILE* reset_stream;
static int resets;
struct StreamLock {
  explicit StreamLock(FILE*) { ++stream_depth; }
  ~StreamLock() { --stream_depth; }
};
enum class PathKind { kFile, kNull, kMissing };
namespace gesher {
PathKind MapPath(const char* path, std::wstring* out) {
  *out = std::wstring(path, path + std::strlen(path));
  return PathKind::kFile;
}
namespace record_locks {
class ClosingDescriptor {
 public:
  explicit ClosingDescriptor(int) {
    check("freopen descriptor transaction starts inside its stream lock", stream_depth == 1);
    ++transactions;
  }
  int Error() const { return admission_error; }
  int Finish(bool) {
    check("freopen descriptor transaction completes once inside its stream lock",
          !finished_ && stream_depth == 1);
    finished_ = true;
    ++completions;
    return 0;
  }
  ~ClosingDescriptor() { check("freopen completes descriptor transaction", admission_error || finished_); }
 private:
  bool finished_ = false;
};
}  // namespace record_locks
}  // namespace gesher

static int _fileno(FILE* stream) { return fileno(stream); }
static int _fclose_nolock(FILE* stream) {
  if (expect_reset) check("stream state retires before fclose", reset_stream == stream);
  int result = std::fclose(stream);
  return fail_close_after_consuming ? (errno = EIO, EOF) : result;
}
static int gesher_errno_from_crt(int error) { return error; }
static bool HasNonDirectoryParent(const std::wstring&) { return false; }
static FILE* _wfreopen(const wchar_t* path, const wchar_t* mode, FILE* stream) {
  ++crt_calls;
  if (expect_reset) check("stream state retires before CRT freopen", reset_stream == stream);
  check("freopen keeps the CRT reopen inside its stream transaction", stream_depth == 1);
  std::wstring wide_path(path), wide_mode(mode);
  std::string narrow_path(wide_path.begin(), wide_path.end());
  std::string linux_mode(wide_mode.begin(), wide_mode.end());
  for (char& option : linux_mode) if (option == 'N') option = 'e';
  return std::freopen(narrow_path.c_str(), linux_mode.c_str(), stream);
}

namespace host {
@HOST_PARSE_MODE@
@HOST_FCLOSE@
@HOST_FREOPEN@
}  // namespace host

namespace guest {
#define BIONIC_SYSV
static FILE* F(void* stream) { return static_cast<FILE*>(stream); }
static void ResetStream(FILE* stream) {
  check("guest state reset while the CRT stream lock is held", stream_depth == 1);
  reset_stream = stream;
  ++resets;
}
@GUEST_FCLOSE@
@GUEST_FREOPEN@
}  // namespace guest

static void CheckGuestStreamLifecycle() {
  FILE* stream = std::tmpfile();
  if (!stream) std::abort();
  int before = resets;
  admission_error = EBUSY;
  check("rejected close leaves the original stream open and state intact",
        guest::CloseBionicStream(stream) == EOF && errno == EBUSY && resets == before &&
        std::fputc('c', stream) == 'c');
  check("rejected reopen leaves the original stream open and state intact",
        guest::Freopen("/dev/null", "w", stream) == nullptr && errno == EBUSY &&
        resets == before && std::fputc('r', stream) == 'r');
  admission_error = 0;
  expect_reset = fail_close_after_consuming = true;
  check("error after CRT close still retires guest state exactly once",
        guest::CloseBionicStream(stream) == EOF && errno == EIO && resets == before + 1);
  expect_reset = fail_close_after_consuming = false;

  stream = std::tmpfile();
  if (!stream) std::abort();
  reset_stream = nullptr;
  expect_reset = true;
  check("invalid mode consumes the original stream and retires guest state",
        guest::Freopen("/dev/null", "x", stream) == nullptr && errno == EINVAL && resets == before + 2);
  expect_reset = false;

  stream = std::tmpfile();
  if (!stream) std::abort();
  reset_stream = nullptr;
  expect_reset = true;
  check("successful native reopen resets state",
        guest::Freopen("/dev/null", "w", stream) == stream && resets == before + 3);
  expect_reset = false;
  check("successfully reopened stream remains usable", std::fputc('s', stream) == 's');
  std::fclose(stream);
}

static FILE* GuestReopen(const char* path, const char* mode, FILE* stream) {
  return guest::Freopen(path, mode, stream);
}
static FILE* (*reopen_call)(const char*, const char*, FILE*);
static FILE* (*reopen64_call)(const char*, const char*, FILE*);
#define FREOPEN_CONTRACT_CALL reopen_call
#define FREOPEN64_CONTRACT_CALL reopen64_call
#include "freopen_mode_contract_test.inc"

int main(int argc, char** argv) {
  if (argc != 2) return 2;
  if (std::strcmp(argv[1], "host") == 0) {
    reopen_call = host::freopen;
    reopen64_call = host::freopen64;
  } else if (std::strcmp(argv[1], "guest") == 0) {
    reopen_call = reopen64_call = GuestReopen;
  } else {
    return 2;
  }
  test_freopen_mode_contracts();
  check("freopen leaves no stream lock or descriptor transaction active",
        stream_depth == 0 && transactions == completions && completions == crt_calls);
  if (reopen_call == GuestReopen) CheckGuestStreamLifecycle();
  std::printf("freopen %s: %d checks, %d failures\n", argv[1], checks, failures);
  return failures ? 1 : 0;
}
