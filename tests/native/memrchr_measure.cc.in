// Ordinary separate-TU measurements of complete public search calls.
// Construction and the independent forward oracle precede every timed region.
#include <algorithm>
#include <cerrno>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <ctime>
#include <sys/resource.h>
#include <vector>

namespace production {
void* Memrchr(const void*, int, size_t);
void* MemrchrChk(const void*, int, size_t, size_t);
}

struct Case { const char* name; size_t size; int match; size_t offset; bool checked; };
static const Case cases[] = {
  {"empty", 0, -1, 0, false}, {"one_miss", 1, -1, 0, false},
  {"one_hit", 1, 0, 0, false}, {"tiny7_miss", 7, -1, 3, false},
  {"tiny8_miss", 8, -1, 3, false}, {"tiny9_miss", 9, -1, 3, false},
  {"tiny15_miss", 15, -1, 3, false}, {"word16_miss", 16, -1, 3, false},
  {"word17_miss", 17, -1, 3, false}, {"word31_miss", 31, -1, 3, false},
  {"word32_miss", 32, -1, 3, false}, {"word32_first", 32, 0, 3, false},
  {"word32_last", 32, -2, 3, false}, {"word32_penultimate", 32, -3, 3, false},
  {"word32_frequent", 32, -5, 3, false}, {"block256_miss", 256, -1, 3, false},
  {"page_miss", 4096, -1, 0, false}, {"page_first", 4096, 0, 0, false},
  {"page_middle", 4096, 2048, 0, false}, {"page_last", 4096, -2, 0, false},
  {"page_penultimate", 4096, -3, 0, false}, {"page_near_end", 4096, -4, 0, false},
  {"page_unaligned", 4096, -1, 7, false}, {"mib_miss", 1048576, -1, 3, false},
  {"mib_first", 1048576, 0, 3, false}, {"mib_middle", 1048576, 524288, 3, false},
  {"mib_last", 1048576, -2, 3, false}, {"mib_near_end", 1048576, -4, 3, false},
  {"checked_page_miss", 4096, -1, 3, true}, {"mixed_ranges", 4096, -6, 3, false},
};

static uint64_t Now(clockid_t clock) {
  timespec value{};
  if (clock_gettime(clock, &value)) std::abort();
  return uint64_t(value.tv_sec) * UINT64_C(1000000000) + value.tv_nsec;
}

struct Input {
  std::vector<uint8_t> storage;
  size_t offset, length;
  const uint8_t* expected = nullptr;
  Input(size_t count, size_t alignment, int match)
      : storage(count + 32, 0x31), offset(alignment), length(count) {
    uint8_t* bytes = storage.data() + offset;
    if (match >= 0) bytes[static_cast<size_t>(match)] = 0x71;
    if (match == -2) bytes[count - 1] = 0x71;
    if (match == -3) bytes[count - 2] = 0x71;
    if (match == -4) bytes[count - 5] = 0x71;
    if (match == -5) for (size_t i = 0; i < count; i += 4) bytes[i] = 0x71;
    for (size_t i = 0; i < count; ++i) if (bytes[i] == 0x71) expected = bytes + i;
  }
};

template<bool Checked> static const uint8_t* Invoke(const Input& input) {
  const uint8_t* bytes = input.storage.data() + input.offset;
  if constexpr (Checked) return static_cast<const uint8_t*>(
      production::MemrchrChk(bytes, 0x171, input.length, input.storage.size() - input.offset));
  else return static_cast<const uint8_t*>(production::Memrchr(bytes, 0x171, input.length));
}

template<bool Checked> static int Measure(const Case& item) {
  std::vector<Input> inputs;
  inputs.reserve(32);
  if (item.match == -6) {
    const size_t sizes[] = {7, 17, 256, 4096};
    for (size_t i = 0; i != 32; ++i) {
      const size_t length = sizes[(i / 4) % 4];
      const int matches[] = {-1, 0, static_cast<int>(length / 2), -2};
      inputs.emplace_back(length, i % 16, matches[i % 4]);
    }
  } else {
    inputs.emplace_back(item.size, item.offset, item.match);
  }
  const size_t count = item.size <= 64 || (item.match <= -2 && item.match >= -5)
      ? 2000000 : std::max<size_t>(64, (size_t(64) * 1024 * 1024) / item.size);
  errno = EDOM;
  const uint64_t first_cpu_start = Now(CLOCK_PROCESS_CPUTIME_ID);
  const uint64_t first_wall_start = Now(CLOCK_MONOTONIC);
  const uint8_t* first = Invoke<Checked>(inputs[0]);
  const uint64_t first_wall = Now(CLOCK_MONOTONIC) - first_wall_start;
  const uint64_t first_cpu = Now(CLOCK_PROCESS_CPUTIME_ID) - first_cpu_start;
  if (first != inputs[0].expected || errno != EDOM) return 3;

  uint64_t expected_checksum = 0;
  for (size_t i = 0; i != count; ++i) {
    const auto& input = inputs[i & (inputs.size() - 1)];
    if (input.expected) expected_checksum +=
        static_cast<uint64_t>(input.expected - input.storage.data() - input.offset) + 1;
  }
  uint64_t checksum = 0;
  const uint64_t cpu_start = Now(CLOCK_PROCESS_CPUTIME_ID);
  const uint64_t wall_start = Now(CLOCK_MONOTONIC);
  for (size_t i = 0; i != count; ++i) {
    const auto& input = inputs[i & (inputs.size() - 1)];
    const uint8_t* got = Invoke<Checked>(input);
    if (got != input.expected) return 4;
    if (got) checksum += static_cast<uint64_t>(got - input.storage.data() - input.offset) + 1;
  }
  const uint64_t wall = Now(CLOCK_MONOTONIC) - wall_start;
  const uint64_t cpu = Now(CLOCK_PROCESS_CPUTIME_ID) - cpu_start;
  if (checksum != expected_checksum || errno != EDOM) return 5;
  rusage usage{};
  if (getrusage(RUSAGE_SELF, &usage)) return 6;
  std::printf("{\"case\":\"%s\",\"size\":%zu,\"inputs\":%zu,\"calls\":%zu,"
      "\"cpu_ns\":%llu,\"wall_ns\":%llu,\"first_cpu_ns\":%llu,\"first_wall_ns\":%llu,"
      "\"checksum\":%llu,\"expected_checksum\":%llu,\"max_rss_kib\":%ld}\n",
      item.name, item.size, inputs.size(), count,
      static_cast<unsigned long long>(cpu), static_cast<unsigned long long>(wall),
      static_cast<unsigned long long>(first_cpu), static_cast<unsigned long long>(first_wall),
      static_cast<unsigned long long>(checksum), static_cast<unsigned long long>(expected_checksum),
      usage.ru_maxrss);
  return 0;
}

int main(int argc, char** argv) {
  if (argc == 2 && std::strcmp(argv[1], "--list") == 0) {
    for (const auto& item : cases) std::puts(item.name);
    return 0;
  }
  if (argc != 2) return 2;
  for (const auto& item : cases) if (std::strcmp(argv[1], item.name) == 0) {
    return item.checked ? Measure<true>(item) : Measure<false>(item);
  }
  return 2;
}
