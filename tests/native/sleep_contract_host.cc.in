// Production guest wrappers and signal-wait adapter, with controlled Win32
// clock/wait boundaries. The separate C fixture uses real Linux/Windows waits.
#include "shim_internal.h"
#include <algorithm>
#include <atomic>
#include <cerrno>
#include <chrono>
#include <climits>
#include <condition_variable>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <mutex>
#include <time.h>
#include <vector>

static int checks, failures;
static void check(const char* name, bool ok) {
  ++checks;
  if (!ok) { ++failures; std::fprintf(stderr, "FAIL %s\n", name); }
}
struct LARGE_INTEGER { int64_t QuadPart; };
static bool controlled;
static int64_t fake_ns;
static bool dynamic_alive = true;
static bool QueryPerformanceFrequency(LARGE_INTEGER* value) {
  value->QuadPart = 1000000000;
  return true;
}
static bool QueryPerformanceCounter(LARGE_INTEGER* value) {
  value->QuadPart = controlled ? fake_ns :
      std::chrono::duration_cast<std::chrono::nanoseconds>(
          std::chrono::steady_clock::now().time_since_epoch()).count();
  return true;
}
struct Action {
  int64_t advance_ns;
  bool interrupt;
  int64_t handler_ns = 0;
};
static std::vector<Action> actions;
static std::vector<uint32_t> waits;
static gesher::bionic::LinuxTimespec* mutate_request;
static bool use_signal_boundary;
static uint32_t signal_wait_ms;
static bool sleep_at_signal_boundary(uint32_t, uint32_t*, void (*)(void*), void*);
static void deliver_at_signal_boundary();

namespace gesher {
// Clock transport seam. The shared Win32 readers are covered by clock_domains.
int64_t MonotonicNanos() { LARGE_INTEGER value; QueryPerformanceCounter(&value); return value.QuadPart; }
int64_t BoottimeNanos() { return MonotonicNanos(); }
// These ordinary-sleep cases never invoke the BOOTTIME entry. Its real resume
// dispatcher/condition-variable integration is in test_boottime_resume.py.
struct ResumeSubscription { int Start(void (*)(void*), void*) { return 0; } };
}

namespace gesher::bionic {
LinuxTimespec RealtimeNow() { return {123456789, 12345}; }
int ReadPthreadCpuClock(int clock, int64_t* value) {
  if (clock != -65536 || !dynamic_alive) return kEINVAL;
  *value = 123000000001;
  return 0;
}
bool TestSleep(uint32_t ms, uint32_t* left, void (*observe)(void*), void* context) {
  if (use_signal_boundary) return sleep_at_signal_boundary(ms, left, observe, context);
  if (!controlled) {
    const timespec request{ms / 1000, static_cast<long>(ms % 1000) * 1000000};
    // Real host runs here only use positive/zero durations, without signals.
    int result = ::nanosleep(&request, nullptr);
    check("unexpected host signal", result == 0);
    if (left) *left = 0;
    return false;
  }
  const size_t index = waits.size();
  if (index >= 16) { std::fputs("FAIL unbounded wait loop\n", stderr); std::abort(); }
  waits.push_back(ms);
  const Action action = index < actions.size() ? actions[index] :
      Action{static_cast<int64_t>(ms) * 1000000, false};
  fake_ns += action.advance_ns;
  if (left) *left = static_cast<uint32_t>(
      std::max<int64_t>(0, static_cast<int64_t>(ms) - action.advance_ns / 1000000));
  if (mutate_request) { *mutate_request = {0, 0}; mutate_request = nullptr; }
  if (action.interrupt && observe) observe(context);
  fake_ns += action.handler_ns;
  errno = ERANGE;  // Windows/backend calls must not leak into success errno.
  return action.interrupt;
}
bool InterruptibleSleep(uint32_t ms, uint32_t* left) {
  return TestSleep(ms, left, nullptr, nullptr);
}
bool InterruptibleSleepObserved(uint32_t ms, void (*observe)(void*), void* context) {
  return TestSleep(ms, nullptr, observe, context);
}
void DeliverPendingSignals() {
  if (use_signal_boundary) deliver_at_signal_boundary();
}
namespace {
@QPC_IMPLEMENTATION@
static int64_t ThreadCpuNanos() { return 9000000008; }
static int64_t ProcessCpuNanos() { return 11000000012; }
@CLOCK_IMPLEMENTATION@
@SLEEP_IMPLEMENTATION@
}
void RegisterSleep(SymbolTable& table) {
#define ENTRY(name, function) table[name] = reinterpret_cast<void*>(&function)
@REGISTRATIONS@
#undef ENTRY
}
}

static void* symbol(const char* name) {
  static gesher::bionic::SymbolTable table = [] {
    gesher::bionic::SymbolTable value;
    gesher::bionic::RegisterSleep(value);
    return value;
  }();
  auto it = table.find(name);
  if (it == table.end()) { std::fprintf(stderr, "missing export %s\n", name); std::abort(); }
  return it->second;
}
static int nano(const timespec* req, timespec* rem) {
  using F = int(BIONIC_SYSV*)(const gesher::bionic::LinuxTimespec*, gesher::bionic::LinuxTimespec*);
  static_assert(sizeof(timespec) == sizeof(gesher::bionic::LinuxTimespec));
  return reinterpret_cast<F>(symbol("nanosleep"))(
      reinterpret_cast<const gesher::bionic::LinuxTimespec*>(req),
      reinterpret_cast<gesher::bionic::LinuxTimespec*>(rem));
}
static int micro(useconds_t us) {
  return reinterpret_cast<int(BIONIC_SYSV*)(uint32_t)>(symbol("usleep"))(us);
}
static unsigned seconds(unsigned s) {
  return reinterpret_cast<unsigned(BIONIC_SYSV*)(unsigned)>(symbol("sleep"))(s);
}
static int resolution(clockid_t id, timespec* value) {
  return reinterpret_cast<int(BIONIC_SYSV*)(int, gesher::bionic::LinuxTimespec*)>(
      symbol("clock_getres"))(id, reinterpret_cast<gesher::bionic::LinuxTimespec*>(value));
}
static int read_clock(clockid_t id, timespec* value) {
  return reinterpret_cast<int(BIONIC_SYSV*)(int, gesher::bionic::LinuxTimespec*)>(
      symbol("clock_gettime"))(id, reinterpret_cast<gesher::bionic::LinuxTimespec*>(value));
}
#define SLEEP_NANOSLEEP nano
#define SLEEP_USLEEP micro
#define SLEEP_SECONDS seconds
#define SLEEP_CLOCK_GETRES resolution
#define SLEEP_SKIP_PUBLIC_SIGNALS
#include "sleep_contract_test.inc"

static void reset(std::initializer_list<Action> script = {}) {
  controlled = true;
  fake_ns = 1000000000;
  actions = script;
  waits.clear();
  mutate_request = nullptr;
  errno = EDOM;
}
static void budgets() {
  reset({{150000, false}, {350000, false}});
  timespec request{0, 500000}, remain{111, 222};
  check("early Windows wake cannot complete nanosleep", nano(&request, &remain) == 0 &&
        fake_ns == 1000500000 && waits == std::vector<uint32_t>({1, 1}));
  check("success retains remainder and errno", remain.tv_sec == 111 && remain.tv_nsec == 222 && errno == EDOM);

  reset();
  request = {2147483, 647000000};  // Exactly one millisecond beyond maximum slice.
  check("full long duration spans wait slices", nano(&request, nullptr) == 0 &&
        waits == std::vector<uint32_t>({2147483646u, 1u}));
  reset({{2000000, false}, {3000000, false}});
  request = {0, 5000000};
  mutate_request = reinterpret_cast<gesher::bionic::LinuxTimespec*>(&request);
  check("request captured before a callback changes its storage", nano(&request, nullptr) == 0 &&
        waits == std::vector<uint32_t>({5, 3}));

  reset();
  check("UINT32_MAX usleep does not wrap", micro(UINT32_MAX) == 0 &&
        waits == std::vector<uint32_t>({4294968u}) && fake_ns >= 4295967295000LL);
  reset({{5000000, true}});
  check("full unsigned sleep duration retained on interruption", seconds(UINT32_MAX) == UINT32_MAX - 1 && errno == EINTR);
  reset({{5000000, true}});
  check("Android sleep returns floor of unslept seconds", seconds(2) == 1 && errno == EINTR);
  reset({{250000000, true}});
  check("Android subsecond sleep remainder is zero", seconds(1) == 0 && errno == EINTR);
}
static void interruptions() {
  reset({{1234567, true, 3000000000}});
  timespec request{2, 987654321}, remain{111, 222};
  check("signal interrupts nanosleep even after a long handler", nano(&request, &remain) == -1 && errno == EINTR);
  check("remaining duration excludes handler and keeps nanoseconds",
        remain.tv_sec == 2 && remain.tv_nsec == 986419754);
  reset({{1234567, true, 3000000000}});
  request = {2, 987654321};
  check("aliased request/remainder is safe", nano(&request, &request) == -1 &&
        request.tv_sec == 2 && request.tv_nsec == 986419754);
  reset({{3000000, true}});
  request = {0, 2000000};
  check("late signal produces normalized zero remainder", nano(&request, &remain) == -1 &&
        remain.tv_sec == 0 && remain.tv_nsec == 0 && errno == EINTR);
  reset({{0, true}});
  check("usleep propagates signal error", micro(UINT32_MAX) == -1 && errno == EINTR &&
        waits == std::vector<uint32_t>({4294968u}));
  reset({{2147483646000000LL, false}, {1234567, true}});
  request = {2147484, 123456789};
  check("later slice interruption keeps all unslept time", nano(&request, &remain) == -1 &&
        remain.tv_sec == 0 && remain.tv_nsec == 476222222 && waits.size() == 2);
}
static void clocks() {
  timespec value;
  reset();
  for (int id = 0; id <= 7; ++id) {
    value = {111, 222};
    check("supported clocks return normalized resolution", resolution(id, &value) == 0 &&
          value.tv_sec == 0 && value.tv_nsec > 0 && value.tv_nsec < 1000000000);
    check("supported clocks allow omitted resolution", resolution(id, nullptr) == 0);
    value = {-1, -1};
    check("supported clocks return normalized timestamp", read_clock(id, &value) == 0 &&
          value.tv_sec >= 0 && value.tv_nsec >= 0 && value.tv_nsec < 1000000000);
#if !BASELINE_CONTROL
    errno = EDOM;
    check("valid clock with null timestamp returns EFAULT", read_clock(id, nullptr) == -1 && errno == EFAULT);
#endif
  }
  for (int id : {999, INT_MAX, -1, -65535, -65537}) {
    value = {111, 222}; errno = EDOM;
    check("unknown clock gettime fails without writing", read_clock(id, &value) == -1 &&
          errno == EINVAL && value.tv_sec == 111 && value.tv_nsec == 222);
    errno = EDOM;
    check("unknown clock precedes null timestamp", read_clock(id, nullptr) == -1 && errno == EINVAL);
    errno = EDOM;
    check("unknown clock getres fails without writing", resolution(id, &value) == -1 &&
          errno == EINVAL && value.tv_sec == 111 && value.tv_nsec == 222);
  }
  dynamic_alive = true;
  check("live retained pthread clock has a resolution", resolution(-65536, &value) == 0);
  check("live retained pthread clock returns its timestamp", read_clock(-65536, &value) == 0 && value.tv_sec == 123);
#if !BASELINE_CONTROL
  errno = EDOM;
  check("live retained pthread clock validates output", read_clock(-65536, nullptr) == -1 && errno == EFAULT);
#endif
  dynamic_alive = false; errno = EDOM;
  check("retired pthread clock is rejected", resolution(-65536, nullptr) == -1 && errno == EINVAL);
  dynamic_alive = true;
}
static void extremes() {
  // The baseline has signed multiplication overflow here, deliberately not
  // executed by the old-source control. The candidate is checked with UBSan.
  reset({{1234567, true, 4000000000}});
  timespec request{INT64_MAX, 999999999}, remain{0, 0};
  check("extreme seconds stay interruptible without overflow", nano(&request, &remain) == -1 && errno == EINTR);
  const int64_t expected = INT64_MAX - 1001234567;
  check("Android hrtimer saturation is preserved", remain.tv_sec == expected / 1000000000 &&
        remain.tv_nsec == expected % 1000000000);
  reset({{0, true}});
  request = {INT64_MAX / 1000000000, INT64_MAX % 1000000000};
  check("relative deadline addition saturates safely", nano(&request, &remain) == -1 &&
        remain.tv_sec == (INT64_MAX - 1000000000) / 1000000000 &&
        remain.tv_nsec == (INT64_MAX - 1000000000) % 1000000000);
}

// Verbatim production signal-wait bridge. Its queue/condition boundary injects
// a signal; the observer sees the same phase the handler later consumes.
namespace signal_boundary {
constexpr int kNsig = 65;
constexpr int kEINTR = EINTR;
struct BionicSiginfo { int value = 0; };
struct PendingFlag { void store(bool, std::memory_order) {} };
struct ThreadState {
  uint64_t pending = 0, mask = 0, waiting_for = 0;
  PendingFlag any_pending;
  BionicSiginfo info[kNsig];
} thread;
static int deliveries, waits_count;
static int received_info;
static std::vector<int> delivered_info;
static bool inject;
static bool inject_on_timeout;
static int64_t handler_elapsed_ns;
constexpr uintptr_t kSigDfl = 0, kSigIgn = 1;
static uint64_t Bit(int sig) { return uint64_t{1} << (sig - 1); }
static bool DefaultIgnores(int sig) { return sig == 17; }
static std::atomic<bool> g_process_pending{false};
struct Condition {
  void notify_all() {}
  template<typename T> std::cv_status wait_for(std::unique_lock<std::mutex>& lock, T value) {
    return wait_until(lock, value);
  }
  template<typename T> std::cv_status wait_until(std::unique_lock<std::mutex>&, T) {
    ++waits_count;
    if (inject) { thread.pending = 1; inject = false; return std::cv_status::no_timeout; }
    if (inject_on_timeout) { thread.pending = 1; inject_on_timeout = false; }
    if (use_signal_boundary) fake_ns += static_cast<int64_t>(signal_wait_ms) * 1000000;
    return std::cv_status::timeout;
  }
};
struct ActionState { uintptr_t handler = 2; };
struct State {
  std::mutex mutex;
  uint64_t process_pending = 0;
  Condition sent;
  ActionState actions[kNsig];
  BionicSiginfo process_info[kNsig];
} state;
static ThreadState* Self() { return &thread; }
static State& S() { return state; }
static void Run(ThreadState*, int sig, const BionicSiginfo& info) {
  if (S().actions[sig].handler == kSigIgn ||
      (S().actions[sig].handler == kSigDfl && DefaultIgnores(sig))) return;
  ++deliveries; received_info = info.value; errno = ERANGE;
  delivered_info.push_back(info.value);
  if (use_signal_boundary) fake_ns += handler_elapsed_ns;
}
static void DeliverAll(ThreadState* value) {
  for (int sig = 1; sig < kNsig; ++sig) {
    if ((value->mask & Bit(sig)) != 0) continue;
    if ((value->pending & Bit(sig)) != 0) {
      value->pending &= ~Bit(sig);
      Run(value, sig, value->info[sig]);
    }
    if ((S().process_pending & Bit(sig)) != 0) {
      S().process_pending &= ~Bit(sig);
      Run(value, sig, S().process_info[sig]);
    }
  }
}
@SIGNAL_WAIT_IMPLEMENTATION@
struct Observation {
  int calls = 0, delivered = -1;
  bool unlocked = false, signal_claimed = false;
};
static void observer(void* data) {
  auto* value = static_cast<Observation*>(data);
  ++value->calls;
  value->delivered = deliveries;
  value->unlocked = S().mutex.try_lock();
  if (value->unlocked) {
    value->signal_claimed = thread.pending == 0 && S().process_pending == 0;
    S().mutex.unlock();
  }
}
static void test() {
#if HAS_OBSERVED_WAIT
  thread = {}; deliveries = waits_count = 0; inject = true;
  Observation value;
  check("production signal adapter reports interruption", InterruptibleSleepObserved(20, observer, &value));
  check("observer runs once before handler with no signal lock", value.calls == 1 && value.delivered == 0 && value.unlocked);
  check("handler still delivered before return", deliveries == 1 && thread.waiting_for == 0);
  thread = {}; deliveries = waits_count = 0; inject = false;
  value = {};
  check("timeout does not report interruption", !InterruptibleSleepObserved(0, observer, &value));
  check("timeout does not call observer", value.calls == 0 && deliveries == 0);
  thread = {}; deliveries = waits_count = 0; inject = true;
  uint32_t left = 0;
  check("legacy sleep entry still delivers handler", InterruptibleSleep(20, &left) && deliveries == 1 && left <= 20);
  thread = {}; deliveries = waits_count = 0; inject = false; thread.pending = 1;
  check("legacy pending entry runs handler before its timeout without EINTR",
        !InterruptibleSleep(0, &left) && deliveries == 1 && thread.pending == 0);
  thread = {}; deliveries = waits_count = 0; inject = false; thread.pending = 1;
  value = {};
  check("pending signal interrupts before any wait", InterruptibleSleepObserved(20, observer, &value) &&
        waits_count == 0 && value.delivered == 0 && deliveries == 1);
  thread = {}; deliveries = waits_count = 0; inject = false; S().process_pending = 1;
  S().process_info[1].value = 1234;
  value = {};
  check("process-pending signal interrupts before any wait", InterruptibleSleepObserved(20, observer, &value) &&
        waits_count == 0 && value.delivered == 0 && deliveries == 1);
  check("process signal claimed with its payload before unlocking", value.signal_claimed && received_info == 1234);
  thread = {}; deliveries = waits_count = 0; inject = true;
  S().actions[1].handler = kSigIgn;
  value = {};
  check("ignored signal does not interrupt observed sleep", !InterruptibleSleepObserved(20, observer, &value) &&
        waits_count == 2 && value.calls == 0 && deliveries == 0 && thread.pending == 0);
  S().actions[1].handler = 2;
  thread = {}; deliveries = waits_count = 0; inject = false;
  S().actions[17].handler = kSigDfl;
  S().process_pending = Bit(17);
  value = {};
  check("default-ignored pending signal is discarded", !InterruptibleSleepObserved(0, observer, &value) &&
        value.calls == 0 && deliveries == 0 && S().process_pending == 0);
  S().actions[17].handler = 2;
  thread = {}; deliveries = waits_count = 0; inject = false;
  thread.pending = thread.mask = 1;
  value = {};
  check("blocked pending signal remains pending", !InterruptibleSleepObserved(0, observer, &value) &&
        value.calls == 0 && deliveries == 0 && thread.pending == 1);
#else
  check("baseline lacks pre-handler interruption observation", false);
#endif
}
static void reset_boundary() {
  reset();
  thread = {};
  S().process_pending = 0;
  for (auto& action : S().actions) action = {};
  deliveries = waits_count = received_info = 0;
  delivered_info.clear();
  inject = inject_on_timeout = false;
  handler_elapsed_ns = 0;
  use_signal_boundary = true;
}
static void combined_test() {
  // Exercise actual public wrappers and the production wait adapter together.
  // Queue insertion and handler execution remain controlled boundary doubles.
  for (int kind = 0; kind < 3; ++kind) {
    reset_boundary();
    thread.pending = 1;
    thread.info[1].value = 77;
    handler_elapsed_ns = 3000000000;
    const timespec zero{};
    timespec remain{111, 222};
    int result = kind == 0 ? nano(&zero, &remain) :
                 kind == 1 ? micro(0) : static_cast<int>(seconds(0));
    const char* labels[] = {"zero nanosleep delivers its pending handler",
                            "zero usleep delivers its pending handler",
                            "zero sleep delivers its pending handler"};
    check(labels[kind],
          result == 0 && deliveries == 1 && received_info == 77 &&
          thread.pending == 0);
    check("zero ordinary sleep retains success errno and remainder after handler",
          errno == EDOM && remain.tv_sec == 111 && remain.tv_nsec == 222);
  }

  reset_boundary();
  thread.pending = thread.mask = 1;
  const timespec zero{};
  check("zero sleep leaves masked pending signal queued", nano(&zero, nullptr) == 0 &&
        deliveries == 0 && thread.pending == 1 && errno == EDOM);

  reset_boundary();
  inject_on_timeout = true;
  handler_elapsed_ns = 3000000000;
  timespec request{0, 1000000}, remain{111, 222};
  check("completed sleep delivers a signal queued at its timeout boundary",
        nano(&request, &remain) == 0 && deliveries == 1 && thread.pending == 0 &&
        waits_count == 1 && errno == EDOM && remain.tv_sec == 111 && remain.tv_nsec == 222);

  reset_boundary();
  thread.pending = 1;
  handler_elapsed_ns = 3000000000;
  request = {2, 987654321};
  check("combined pending interruption observes time before running the handler",
        nano(&request, &remain) == -1 && errno == EINTR && deliveries == 1 &&
        waits_count == 0 && remain.tv_sec == 2 && remain.tv_nsec == 987654321);

  reset_boundary();
  thread.pending = S().process_pending = 1;
  thread.info[1].value = 77;
  S().process_info[1].value = 88;
  check("claim retains separate thread and process payloads for the same signal",
        nano(&request, &remain) == -1 && errno == EINTR &&
        delivered_info == std::vector<int>({77, 88}) && thread.pending == 0 &&
        S().process_pending == 0);
  use_signal_boundary = false;
}
}

static bool sleep_at_signal_boundary(uint32_t ms, uint32_t* left,
                                     void (*observe)(void*), void* context) {
  signal_wait_ms = ms;
#if HAS_OBSERVED_WAIT
  if (observe) return signal_boundary::InterruptibleSleepObserved(ms, observe, context);
#else
  (void)observe; (void)context;
#endif
  return signal_boundary::InterruptibleSleep(ms, left);
}
static void deliver_at_signal_boundary() { signal_boundary::DeliverAll(&signal_boundary::thread); }

int main(int argc, char** argv) {
  if (argc != 2) return 2;
  const std::string group = argv[1];
  if (group == "public") { controlled = false; test_sleep_contracts(); }
  else if (group == "budgets") budgets();
  else if (group == "interruptions") interruptions();
  else if (group == "clocks") clocks();
  else if (group == "extremes") extremes();
  else if (group == "signal-observer") signal_boundary::test();
  else if (group == "combined-signals") signal_boundary::combined_test();
  else return 2;
  std::printf("sleep %s: %d checks, %d failures\n", argv[1], checks, failures);
  return failures != 0;
}
