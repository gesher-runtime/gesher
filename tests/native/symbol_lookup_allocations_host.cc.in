#include <atomic>
#include <chrono>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <new>
#include <mutex>
#include <string>
#include <string_view>
#include <thread>
#include <unordered_map>
#include <vector>
#include "@HASH_HEADER@"

static std::atomic<bool> tracking{false};
static std::atomic<size_t> allocations{0};
static std::atomic<size_t> bytes{0};
void* operator new(size_t n) {
  if (tracking.load(std::memory_order_relaxed)) {
    allocations.fetch_add(1, std::memory_order_relaxed);
    bytes.fetch_add(n, std::memory_order_relaxed);
  }
  if (void* p = std::malloc(n ? n : 1)) return p;
  std::abort();
}
void* operator new[](size_t n) { return ::operator new(n); }
void operator delete(void* p) noexcept { std::free(p); }
void operator delete[](void* p) noexcept { std::free(p); }
void operator delete(void* p, size_t) noexcept { std::free(p); }
void operator delete[](void* p, size_t) noexcept { std::free(p); }

@IMPLEMENTATION@

static unsigned checks = 0;
static void Check(bool ok) {
  ++checks;
  if (!ok) {
    std::fprintf(stderr, "symbol lookup check %u failed\n", checks);
    std::exit(1);
  }
}

int main(int argc, char** argv) {
  const bool enforce = argc < 2 || std::strcmp(argv[1], "measure") != 0;
  int first = 1, second = 2;
  char owned[] = "a_symbol_with_a_name_longer_than_small_string_storage";
  const std::string original(owned);
  AddBionicSymbol(owned, &first);
  owned[0] = 'x';
  Check(LookupBionicSymbol(original.c_str()) == &first);
  Check(LookupBionicSymbol(owned) == nullptr);
  AddBionicSymbol(original.c_str(), &second);
  Check(LookupBionicSymbol(original.c_str()) == &second);
  AddBionicSymbol("", &first);
  Check(LookupBionicSymbol("") == &first);
  AddBionicSymbol("short", &second);
  Check(LookupBionicSymbol("short") == &second);
  Check(LookupBionicSymbol("Short") == nullptr);
  AddBionicSymbol("a_null_symbol_with_a_long_name", nullptr);
  Check(LookupBionicSymbol("a_null_symbol_with_a_long_name") == nullptr);
  Check(LookupBionicSymbol("a_missing_symbol_with_a_long_name") == nullptr);
  std::vector<std::string> names;
  for (int i = 0; i < 4096; ++i) {
    names.push_back("a_registered_symbol_name_with_long_suffix_" + std::to_string(i));
    AddBionicSymbol(names.back().c_str(), (i & 1) ? &first : &second);
  }
  // Rehashing must preserve value identity and owned keys.
  Table().rehash(65537);
  for (size_t i = 0; i < names.size(); ++i)
    Check(LookupBionicSymbol(names[i].c_str()) == ((i & 1) ? &first : &second));
  constexpr size_t calls = 200000;
  allocations = 0;
  bytes = 0;
  const auto start = std::chrono::steady_clock::now();
  tracking = true;
  for (size_t i = 0; i < calls; ++i) {
    const size_t index = i % names.size();
    if (LookupBionicSymbol(names[index].c_str()) != ((index & 1) ? &first : &second)) std::abort();
    if (LookupBionicSymbol("a_missing_symbol_with_a_long_name") != nullptr) std::abort();
  }
  tracking = false;
  const auto elapsed = std::chrono::duration_cast<std::chrono::microseconds>(
      std::chrono::steady_clock::now() - start).count();
  std::printf("@TARGET@ symbol lookups=%zu allocations=%zu bytes=%zu elapsed_us=%lld\n",
              calls * 2, allocations.load(), bytes.load(), static_cast<long long>(elapsed));
  if (enforce) Check(allocations == 0);
  // Multiple readers share only immutable registration state.
  std::atomic<bool> valid{true};
  std::vector<std::thread> readers;
  for (int t = 0; t < 4; ++t) readers.emplace_back([&] {
    for (size_t i = 0; i < 25000; ++i)
      if (LookupBionicSymbol(names[i % names.size()].c_str()) !=
          (((i % names.size()) & 1) ? &first : &second)) valid = false;
  });
  for (auto& thread : readers) thread.join();
  Check(valid);
  std::printf("symbol lookup contracts: %u PASS\n", checks);
}
