// Included only in the declared Linux adapter envelope. The guest Fgetc,
// shared owner, buffering, registration and retirement are production bodies.
// File creation and thread startup are outside timing. Every byte and EOF are
// checked; this measures host-envelope cost, not Windows application speed.
static int OwnerCacheBenchmark(size_t bytes, int thread_count) {
  std::vector<FILE*> files;
  std::vector<int> descriptors;
  const std::string data(bytes, 'q');
  for (int i = 0; i < thread_count; ++i) {
    char path[] = "stdio-owner-bench-XXXXXX";
    const int fd = mkstemp(path);
    if (fd < 0 || unlink(path) != 0 ||
        write(fd, data.data(), bytes) != static_cast<ssize_t>(bytes) ||
        lseek(fd, 0, SEEK_SET) != 0) return 2;
    FILE* stream = adapter_fdopen(fd, "r");
    if (!stream) return 2;
    files.push_back(stream);
    descriptors.push_back(fd);
  }
  struct Observation { uint64_t sum = 0; bool bytes_ok = true; int end = 0; };
  std::vector<Observation> observations(thread_count);
  std::atomic<int> ready{0};
  std::atomic<bool> start{false};
  std::vector<std::thread> workers;
  for (int t = 0; t < thread_count; ++t) workers.emplace_back([&, t] {
    ready.fetch_add(1, std::memory_order_release);
    while (!start.load(std::memory_order_acquire)) std::this_thread::yield();
    auto& observation = observations[t];
    for (size_t i = 0; i < bytes; ++i) {
      const int value = guest::Fgetc(files[t]);
      observation.bytes_ok = observation.bytes_ok && value == 'q';
      observation.sum += value;
    }
    observation.end = guest::Fgetc(files[t]);
  });
  while (ready.load(std::memory_order_acquire) != thread_count) std::this_thread::yield();
  const auto began = std::chrono::steady_clock::now();
  start.store(true, std::memory_order_release);
  for (auto& worker : workers) worker.join();
  const double elapsed = std::chrono::duration<double, std::milli>(
      std::chrono::steady_clock::now() - began).count();
  uint64_t checksum = 0;
  int errors = 0;
  for (int t = 0; t < thread_count; ++t) {
    checksum += observations[t].sum;
    if (!observations[t].bytes_ok || observations[t].end != EOF ||
        adapter_fclose(files[t]) != 0 || fcntl(descriptors[t], F_GETFD) != -1) ++errors;
  }
  if (checksum != static_cast<uint64_t>(thread_count) * bytes * 'q') ++errors;
  char result[256];
  const int count = snprintf(result, sizeof(result),
      "{\"threads\":%d,\"bytes_each\":%zu,\"milliseconds\":%.6f,\"checksum\":%llu,\"errors\":%d}\n",
      thread_count, bytes, elapsed, static_cast<unsigned long long>(checksum), errors);
  if (count < 0 || static_cast<size_t>(count) >= sizeof(result) ||
      write(STDOUT_FILENO, result, static_cast<size_t>(count)) != count) return 2;
  return errors ? 1 : 0;
}
