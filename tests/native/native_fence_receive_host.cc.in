// Exact production receive, reservation, adoption, registration and retirement
// bodies; Linux adapters explicitly model the Win32/CRT/event-validation edge.
#include <array>
#include <algorithm>
#include <atomic>
#include <cerrno>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <fcntl.h>
#include <memory>
#include <mutex>
#include <new>
#include <sys/eventfd.h>
#include <unistd.h>
#include <vector>

static bool fail_allocation;
void* operator new(size_t size) {
  if (fail_allocation) { fail_allocation = false; throw std::bad_alloc(); }
  if (void* value = std::malloc(size ? size : 1)) return value;
  throw std::bad_alloc();
}
void operator delete(void* value) noexcept { std::free(value); }
void operator delete(void* value, size_t) noexcept { std::free(value); }

using HANDLE = void*;
using DWORD = unsigned long;
constexpr unsigned GENERIC_READ=1, GENERIC_WRITE=2, FILE_SHARE_READ=1, FILE_SHARE_WRITE=2, OPEN_EXISTING=3;
constexpr unsigned HANDLE_FLAG_INHERIT=1;
constexpr int _O_RDWR=O_RDWR, _O_NOINHERIT=O_CLOEXEC;
const HANDLE INVALID_HANDLE_VALUE=reinterpret_cast<HANDLE>(-1);
static int ToFd(HANDLE h) { return static_cast<int>(reinterpret_cast<intptr_t>(h))-1; }
static HANDLE ToHandle(int fd) { return fd<0 ? INVALID_HANDLE_VALUE : reinterpret_cast<HANDLE>(static_cast<intptr_t>(fd)+1); }
enum class Kind { kNone, kNul, kFence, kOrdinary };
static std::array<Kind, 16384> handles{};
static std::array<bool, 16384> ofd_owners{};
static int live_handles, live_ofds, flags_calls, cleanup_calls;
static bool fail_flags, fail_reserve, fail_kind;
static DWORD last_error;
static int failures, checks;
static void Check(bool good, const char* what) {
  ++checks;
  if (!good) { ++failures; std::printf("FAIL native-fence receive: %s (errno=%d)\n", what, errno); }
}
static HANDLE OpenHandle(Kind kind, bool close_on_exec=true) {
  int fd=kind==Kind::kFence ? eventfd(1, EFD_NONBLOCK | (close_on_exec?EFD_CLOEXEC:0))
                           : ::open("/dev/null", O_RDWR | (close_on_exec?O_CLOEXEC:0));
  if (fd>=0) { handles.at(fd)=kind; ++live_handles; }
  return ToHandle(fd);
}
bool CloseHandle(HANDLE h) {
  int fd=ToFd(h);
  if (fd<0 || static_cast<size_t>(fd)>=handles.size() || handles[fd]==Kind::kNone)
    return errno=EBADF,false;
  int result=::close(fd);
  if (result==0) { handles[fd]=Kind::kNone; --live_handles; }
  return result==0;
}
HANDLE CreateFileW(const wchar_t*,unsigned,unsigned,void*,unsigned,unsigned,void*) {
  if (fail_reserve) { fail_reserve=false; last_error=ENOMEM; return INVALID_HANDLE_VALUE; }
  return OpenHandle(Kind::kNul);
}
int _open_osfhandle(intptr_t handle,int flags) {
  int fd=ToFd(reinterpret_cast<HANDLE>(handle));
  if (!(flags&_O_NOINHERIT)) ::fcntl(fd,F_SETFD,0);
  return fd;
}
int _close(int fd) { return CloseHandle(ToHandle(fd)) ? 0 : -1; }
bool SetHandleInformation(HANDLE h,DWORD mask,DWORD flags) {
  Check(mask==HANDLE_FLAG_INHERIT,"only the descriptor inheritance bit is changed");
  ++flags_calls;
  if (fail_flags) { fail_flags=false; last_error=EACCES; return false; }
  return ::fcntl(ToFd(h),F_SETFD,flags&HANDLE_FLAG_INHERIT ? 0 : FD_CLOEXEC)==0;
}
DWORD GetLastError() { return last_error; }
struct ID3D11Device {};
template<class T> struct ComPtr { T* p=nullptr; };
namespace gesher {
namespace record_locks {
static std::recursive_mutex descriptors;
struct DescriptorGuard { std::lock_guard<std::recursive_mutex> lock{descriptors}; };
}
enum class DescriptorKind { kFile=0,kZero=1,kRandom=2,kUnshareable=3 };
enum class FenceStatus { kPending,kSignaled,kFailed };
int FailWithLastError() { return errno=static_cast<int>(last_error),-1; }
int ErrnoFromWin32(DWORD error) { return static_cast<int>(error); }
int CrtResult(int value) { return value; }
HANDLE HandleFromFd(int fd) { return ToHandle(fd); }
int SetDescriptorKind(int fd,DescriptorKind kind) {
  Check(kind==DescriptorKind::kUnshareable,"fence placeholder remains unshareable at launch");
  if (fail_kind) { fail_kind=false; return errno=ENOMEM,-1; }
  Check(!ofd_owners[fd],"reservation installs one OFD owner");
  ofd_owners[fd]=true; ++live_ofds;
  return 0;
}
// Declared CRT/OFD cleanup adapter: the tested Register must call the production
// private-duplicate cleanup boundary, not abandon its reserved descriptor.
int CloseUnpublishedDuplicate(int fd) {
  ++cleanup_calls;
  if (ofd_owners[fd]) { ofd_owners[fd]=false; --live_ofds; }
  return _close(fd);
}
constexpr uint64_t kTransferredCompletedFence=4,kTransferredSocket=1;
namespace wire { constexpr unsigned kRightsMaxInFlight=8192,kSocketFileDescription=4,kNativeFenceFileDescription=5; }
bool CompletedEvent(HANDLE h) {
  int fd=ToFd(h);
  return fd>=0 && static_cast<size_t>(fd)<handles.size() && handles[fd]==Kind::kFence;
}
void WakePollers() {}
// Ordinary-file and socket adoption are declared boundaries here. The Windows
// mixed SCM test below exercises the genuine production implementations.
int AdoptSocket(uintptr_t owned,uint64_t) { CloseHandle(reinterpret_cast<HANDLE>(owned)); return errno=EOPNOTSUPP,-1; }
int AdoptFileDescription(HANDLE file,HANDLE shared,DescriptorKind,bool close_on_exec) {
  CloseHandle(shared);
  int fd=ToFd(file);
  ::fcntl(fd,F_SETFD,close_on_exec?FD_CLOEXEC:0);
  return fd;
}
@PRODUCTION@

template<class T> void Put(Reply& reply,T value) {
  auto* p=reinterpret_cast<unsigned char*>(&value); reply.bytes.insert(reply.bytes.end(),p,p+sizeof(value));
}
void Entry(Reply& reply,HANDLE h,uint64_t metadata,HANDLE shared,unsigned kind) {
  Put<uint64_t>(reply,reinterpret_cast<uintptr_t>(h)); Put<uint64_t>(reply,metadata);
  Put<uint64_t>(reply,reinterpret_cast<uintptr_t>(shared)); Put<uint32_t>(reply,kind);
}
Reply Incoming(bool fence,bool sender_flags=true,unsigned kind=5,uint64_t metadata=4,bool extra_shared=false) {
  Reply reply; Put<int32_t>(reply,0); Put<uint32_t>(reply,1);
  Entry(reply,OpenHandle(fence?Kind::kFence:Kind::kOrdinary,sender_flags),metadata,
        extra_shared?OpenHandle(Kind::kOrdinary):nullptr,kind);
  return reply;
}
void Retire(int fd) {
  ForgetNativeFence(fd);
  if (ofd_owners[fd]) { ofd_owners[fd]=false; --live_ofds; }
  Check(_close(fd)==0,"received descriptor closes");
}
void Clean(int before_handles,int before_ofds) {
  Check(live_handles==before_handles,"every native handle has its owner or is closed");
  Check(live_ofds==before_ofds,"no unpublished OFD reservation remains");
  Check(std::all_of(members.begin(),members.end(),[](auto& word) { return word.load()==0; }),
        "no retired fence membership remains");
}
void ReceiveFlags() {
  for (bool fence:{false,true}) for (bool sender:{false,true}) for(bool requested:{false,true}) {
    int before=live_handles, owners=live_ofds;
    Reply reply=Incoming(fence,sender,fence?5:0,fence?4:0,!fence);
    std::vector<int> fds;
    Check(ReadDelivered(reply,&fds,true,requested) && fds.size()==1 && fds[0]>=0,"actual receive/adoption succeeds");
    if(fds.size()==1 && fds[0]>=0) {
      Check((::fcntl(fds[0],F_GETFD)&FD_CLOEXEC)==(requested?FD_CLOEXEC:0),
            "receiver flag is independent of sender flag");
      Check((LookupNativeFence(fds[0])!=nullptr)==fence,"received descriptor retains its actual fence/file type");
      Retire(fds[0]);
    }
    Clean(before,owners);
  }
  int before=live_handles, owners=live_ofds, calls=flags_calls;
  HANDLE event=OpenHandle(Kind::kFence);
  int fd=AdoptNativeFence(event,kTransferredCompletedFence);
  Check(fd>=0 && (::fcntl(fd,F_GETFD)&FD_CLOEXEC),"Binder/direct-adoption default stays CLOEXEC");
  Check(flags_calls==calls,"default noninheritable registration adds no flag mutation");
  if(fd>=0)Retire(fd);
  Clean(before,owners);
}
void Rejection() {
  for(unsigned kind:{0u,3u,6u,5u}) {
    int before=live_handles,owners=live_ofds;
    Reply reply=Incoming(true,true,kind,kind==5?0:4);
    std::vector<int> fds;
    Check(ReadDelivered(reply,&fds,true,false) && fds==std::vector<int>{-1},"wrong type/metadata is rejected");
    Clean(before,owners);
  }
  for(bool extra_shared:{false,true}) {
    int before=live_handles,owners=live_ofds;
    Reply reply=Incoming(extra_shared,true,5,4,extra_shared);
    std::vector<int> fds;
    Check(ReadDelivered(reply,&fds,true,true) && fds==std::vector<int>{-1},"wrong event or unexpected shared handle is rejected");
    Clean(before,owners);
  }
  int before=live_handles,owners=live_ofds;
  Reply dropped=Incoming(true);
  Check(ReadDelivered(dropped,nullptr,false,false),"discarding unread rights closes delivered native handles");
  Clean(before,owners);
}
void Failures() {
  for(int mode=0;mode<4;++mode) {
    int before=live_handles,owners=live_ofds,cleanup=cleanup_calls;
    Reply reply=Incoming(true);
    if(mode==0)fail_allocation=true;
    if(mode==1)fail_reserve=true;
    if(mode==2)fail_kind=true;
    if(mode==3)fail_flags=true;
    std::vector<int> fds;
    Check(ReadDelivered(reply,&fds,true,false) && fds==std::vector<int>{-1},"failed adoption never publishes a successful fd");
    Check(errno==(mode==3?EACCES:ENOMEM),"the failing operation's errno is preserved");
    if(mode==3)Check(cleanup_calls==cleanup+1,"flag failure retires the unpublished reservation once");
    // Keep a failing immutable-source/mutation control bounded as well: an
    // unexpectedly successful adoption still belongs to this test caller.
    for(int fd:fds)if(fd>=0)Retire(fd);
    fail_flags=fail_reserve=fail_kind=fail_allocation=false;
    Clean(before,owners);
  }
}
}
int main() {
  gesher::ReceiveFlags(); gesher::Rejection(); gesher::Failures();
  std::printf("NATIVE_FENCE_RECEIVE checks=%d failures=%d (declared Linux Win32/CRT adapter)\n",checks,failures);
  return failures?1:0;
}

