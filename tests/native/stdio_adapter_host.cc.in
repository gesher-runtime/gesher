// Production stdio adapter with explicit Linux replacements for Win32 owner
// lookup and the native FILE-token allocator. I/O and test files are real.
// Native MinGW parser/formatter linkage still requires the Windows CI target.
#define _GNU_SOURCE 1
@OWNER_CACHE_CAPABILITY@
#include <algorithm>
#include <atomic>
#include <cerrno>
#include <climits>
#include <chrono>
#include <cstdarg>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <cwchar>
#include <fcntl.h>
#include <map>
#include <memory>
#include <mutex>
#include <new>
#include <pthread.h>
#include <string>
#include <sys/socket.h>
#include <unordered_map>
#include <thread>
#include <unistd.h>
#include <vector>

#include "@STDIO_INTERNAL_HEADER@"
#include "@STREAM_BUFFER_HEADER@"

static int checks;
static int failures;
static void check(const char* name, int ok) {
  ++checks;
  if (!ok) { ++failures; std::fprintf(stderr, "FAIL: %s (errno=%d)\n", name, errno); }
}
static bool fail_fdopen;
static std::atomic<int> allocation_failure{-1};
void* operator new(size_t count) {
  int remaining = allocation_failure.load();
  if (remaining >= 0 && allocation_failure.fetch_sub(1) == 0) throw std::bad_alloc();
  void* result = std::malloc(count ? count : 1);
  if (!result) throw std::bad_alloc();
  return result;
}
void operator delete(void* value) noexcept { std::free(value); }
void operator delete(void* value, size_t) noexcept { std::free(value); }

static FILE* HostFdopen(int fd, const char* mode) {
  if (fail_fdopen) { fail_fdopen = false; return errno = EMFILE, nullptr; }
  return ::fdopen(fd, mode);
}
static int HostFclose(FILE* stream) { return ::fclose(stream); }
static int HostVasprintf(char** text, const char* format, va_list ap) { return ::vasprintf(text, format, ap); }
static int HostVfscanf(FILE* stream, const char* format, va_list ap) { return ::vfscanf(stream, format, ap); }
static int HostVfwprintf(FILE* stream, const wchar_t* format, va_list ap) { return ::vfwprintf(stream, format, ap); }
static int HostSetvbuf(FILE* stream, char* bytes, int mode, size_t count) { return ::setvbuf(stream, bytes, mode, count); }
static int _fileno(FILE* stream) { return ::fileno(stream); }
static int _fclose_nolock(FILE* stream) { return HostFclose(stream); }
static FILE* _fdopen(int fd, const char* mode) { return HostFdopen(fd, mode); }

// The Windows CRT retains FILE lock storage after fclose. glibc frees FILE,
// so model that documented lock lifetime separately from the real Linux I/O.
// Production locking/retirement code below is unchanged by this boundary.
static std::atomic<unsigned> crt_lock_attempts{0};
static std::shared_ptr<std::recursive_mutex> CrtLock(FILE* stream) {
  struct Locks {
    std::mutex mutex;
    std::map<FILE*, std::shared_ptr<std::recursive_mutex>> streams;
  };
  // As with the production CRT, lock storage outlives application atexit I/O.
  static auto* registry = new Locks;
  std::lock_guard<std::mutex> guard(registry->mutex);
  auto& lock = registry->streams[stream];
  if (!lock) lock = std::make_shared<std::recursive_mutex>();
  return lock;
}
static void _lock_file(FILE* stream) {
  auto lock = CrtLock(stream);
  ++crt_lock_attempts;
  lock->lock();
}
static void _unlock_file(FILE* stream) { CrtLock(stream)->unlock(); }
namespace gesher::bionic::stdio_windows {
enum class TryLockResult { kAcquired, kBusy, kUnsupported };
inline TryLockResult TryLock(FILE* stream) {
  return CrtLock(stream)->try_lock() ? TryLockResult::kAcquired : TryLockResult::kBusy;
}
}

namespace socket_boundary {
// Only native socket representation is a boundary here. Registry construction,
// insertion, lookup and static lifetime below are the actual production code.
static std::atomic<int> destroyed{0};
struct Description {
  size_t descriptor_refs = 0;
  ~Description() { ++destroyed; }
};
struct SocketFd { int socket; std::shared_ptr<Description> description; };
@SOCKET_REGISTRY@
@SOCKET_INSERT@
@SOCKET_LOOKUP@
static bool probing, ordinary_destroyed, reported;
static int socket_fd = -1;
struct OrdinaryShutdown {
  ~OrdinaryShutdown() { ordinary_destroyed = true; }
} ordinary_shutdown;
static bool Begin() {
  int sockets[2];
  if (socketpair(AF_UNIX, SOCK_STREAM, 0, sockets) != 0) return false;
  socket_fd = sockets[0];
  Insert(socket_fd, SocketFd{socket_fd, std::make_shared<Description>()});
  // Deliberately leave both real descriptors live through process shutdown,
  // as an application may do. The OS owns final process resource reclamation.
  probing = true;
  return true;
}
}
static void WriteShutdownDiagnostic(const char* bytes, size_t count) {
  // Use real descriptor I/O: stdio ownership may already be tearing down.
  // A missing or partial diagnostic must not be reported as a successful probe.
  while (count != 0) {
    const ssize_t written = ::write(STDERR_FILENO, bytes, count);
    if (written < 0 && errno == EINTR) continue;
    if (written <= 0) std::_Exit(89);
    bytes += written;
    count -= static_cast<size_t>(written);
  }
}
static ssize_t HostDescriptorWrite(int fd, const void* bytes, size_t count) {
  if (socket_boundary::probing && socket_boundary::ordinary_destroyed) {
    // A negative control uses the old destructible registry. Diagnose its
    // destroyed description before invoking undefined access to its dead map.
    if (socket_boundary::destroyed.load() != 0) {
      const char message[] = "SOCKET_EXIT_RETIRED before_final_stdio_write=1\n";
      WriteShutdownDiagnostic(message, sizeof(message) - 1);
      std::_Exit(87);
    }
    socket_boundary::SocketFd observed{};
    if (!socket_boundary::LookupSocket(socket_boundary::socket_fd, &observed) ||
        observed.socket != socket_boundary::socket_fd || observed.description->descriptor_refs != 1)
      std::_Exit(88);
    if (!socket_boundary::reported) {
      const char message[] = "SOCKET_EXIT_RETAINED after_ordinary_destructors=1\n";
      WriteShutdownDiagnostic(message, sizeof(message) - 1);
      socket_boundary::reported = true;
    }
  }
  socket_boundary::SocketFd unrelated{};
  if (socket_boundary::LookupSocket(fd, &unrelated)) return errno = ENOSYS, -1;
  return ::write(fd, bytes, count);
}

using HANDLE = void*;
using HMODULE = HANDLE;
using LPCWSTR = const wchar_t*;
static const HANDLE INVALID_HANDLE_VALUE = reinterpret_cast<HANDLE>(intptr_t{-1});
using BOOL = int;
struct INIT_ONCE { std::mutex mutex; bool ready = false; };
using PINIT_ONCE = INIT_ONCE*;
#define INIT_ONCE_STATIC_INIT {}
#define CALLBACK
#define TRUE 1
#define FALSE 0
#define __declspec(x)
static constexpr int ERROR_NOT_ENOUGH_MEMORY = 8;
static constexpr unsigned DUPLICATE_SAME_ACCESS = 2;
static constexpr unsigned HANDLE_FLAG_INHERIT = 1;
static constexpr int _O_BINARY = 0;
static constexpr int _O_NOINHERIT = 0;
static thread_local int last_error;
static void SetLastError(int value) { last_error = value; }
static int InitOnceExecuteOnce(PINIT_ONCE once, int (*callback)(PINIT_ONCE, void*, void**), void*, void**) {
  std::lock_guard<std::mutex> lock(once->mutex);
  if (once->ready) return TRUE;
  once->ready = callback(once, nullptr, nullptr) != FALSE;
  return once->ready;
}
static HANDLE GetModuleHandleW(const wchar_t*) { return reinterpret_cast<HANDLE>(1); }
static constexpr unsigned GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS = 4;
static constexpr unsigned GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT = 2;
static int GetModuleHandleExW(unsigned, LPCWSTR, HMODULE* module) { *module = GetModuleHandleW(nullptr); return TRUE; }
static void* GetProcAddress(HANDLE, const char*);
static HANDLE GetCurrentProcess() { return reinterpret_cast<HANDLE>(1); }
static HANDLE FileHandle(int fd) { return reinterpret_cast<HANDLE>(static_cast<intptr_t>(fd) + 1); }
static int HandleFd(HANDLE handle) { return static_cast<int>(reinterpret_cast<intptr_t>(handle) - 1); }
static int DuplicateHandle(HANDLE, HANDLE handle, HANDLE, HANDLE* result, unsigned, bool inherit, unsigned) {
  int fd = fcntl(HandleFd(handle), inherit ? F_DUPFD : F_DUPFD_CLOEXEC, 0);
  if (fd < 0) return FALSE;
  *result = FileHandle(fd);
  return TRUE;
}
static int CloseHandle(HANDLE handle) { return close(HandleFd(handle)) == 0; }
static int _open_osfhandle(intptr_t handle, int) { return HandleFd(reinterpret_cast<HANDLE>(handle)); }
static int _dup2(int from, int to) { return dup2(from, to) < 0 ? -1 : 0; }
static int _close(int fd) { return close(fd); }
static int SetHandleInformation(HANDLE handle, unsigned, unsigned bits) {
  return fcntl(HandleFd(handle), F_SETFD, (bits & HANDLE_FLAG_INHERIT) ? 0 : FD_CLOEXEC) == 0;
}
static int gesher_errno_from_crt(int error) { return error; }
namespace gesher {
// Device/OFD identity is exercised by test_stream_device_lifetime.py and the complete OFD corpus.
void ForgetStreamDevice(int, bool) {}
int GetFileStatusFlags(int fd) { return fcntl(fd, F_GETFL); }
int SetFileStatusFlags(int fd, int flags) { return fcntl(fd, F_SETFL, flags); }
int FailWithLastError() { return errno = last_error == ERROR_NOT_ENOUGH_MEMORY ? ENOMEM : EIO, -1; }
HANDLE HandleFromFd(int fd) { return fcntl(fd, F_GETFD) >= 0 ? FileHandle(fd) : INVALID_HANDLE_VALUE; }
// This FILE envelope treats snapshot registry identity as a declared boundary;
// actual capture/reuse and global-lock behavior use the complete OFD corpus.
struct DescriptorSnapshot {
  HANDLE handle = nullptr;
  uintptr_t description = 0;
  ~DescriptorSnapshot() { if (handle) CloseHandle(handle); }
};
using DescriptorSnapshotPtr = std::shared_ptr<DescriptorSnapshot>;
DescriptorSnapshotPtr CaptureDescriptor(int fd) try {
  if (HandleFromFd(fd) == INVALID_HANDLE_VALUE) return errno = EBADF, DescriptorSnapshotPtr{};
  auto value = std::make_shared<DescriptorSnapshot>();
  if (!DuplicateHandle(GetCurrentProcess(), FileHandle(fd), GetCurrentProcess(), &value->handle,
                       0, false, DUPLICATE_SAME_ACCESS)) return {};
  value->description = static_cast<uintptr_t>(fd) + 1;
  return value;
} catch (const std::bad_alloc&) {
  return errno = ENOMEM, DescriptorSnapshotPtr{};
}
int FileDescriptionFlags(const DescriptorSnapshotPtr& snapshot) {
  if (!snapshot) return errno = EBADF, -1;
  return fcntl(HandleFd(snapshot->handle), F_GETFL);
}
int FileDescriptionIoFlags(const DescriptorSnapshotPtr& snapshot) {
  return FileDescriptionFlags(snapshot);
}
int SetFileDescriptionFlags(const DescriptorSnapshotPtr& snapshot, int flags) {
  return fcntl(HandleFd(snapshot->handle), F_SETFL, flags);
}
void ForgetOfd(int) {}
// This envelope tests FILE ownership. The Windows virtual-resource corpus in
// stdio_virtual_contract.inc exercises the real resource registries.
struct RetiredDescriptor {
  void Retire(int fd) { ForgetOfd(fd); }
  int Finish() { return 0; }
};
namespace record_locks {
class DescriptorGuard { public: DescriptorGuard() {} ~DescriptorGuard() {} };
class ClosingDescriptor {
 public:
  explicit ClosingDescriptor(int) {}
  int Error() const { return 0; }
  int Finish(bool) { return 0; }
};
}
}

@RENAME_PUBLIC_SYMBOLS@
// The Windows fpos_t ABI is one signed 64-bit file position.
#define fpos_t int64_t
int adapter_fprintf(FILE*, const char*, ...);
FILE* adapter_fdopen(int, const char*);

@STDIO_ADAPTER@

static void* GetProcAddress(HANDLE, const char* name) {
  if (strcmp(name, "gesher_stdio_output_owner_v1") != 0) std::abort();
  return reinterpret_cast<void*>(&gesher::stdio::gesher_stdio_output_owner_v1);
}
using StreamLock = gesher::stdio::StreamGuard;
@PARSE_MODE@
@OPEN_CLOSE@

namespace guest {
#define BIONIC_SYSV
static FILE* F(void* stream) { return static_cast<FILE*>(stream); }
@BIONIC_ORIENT@
@BIONIC_READ_STREAM@
@BIONIC_UNLOCKED@
@BIONIC_GETC_UNLOCKED@
@BIONIC_GETC@
}

// The envelope's formatting backend uses the host formatter, then the exact
// fputc/fputwc callbacks used by MinGW's formatter in production.
extern "C" int __mingw_pformat(int, void* destination, int, const char* format, va_list ap) {
  char* text = nullptr;
  int length = HostVasprintf(&text, format, ap);
  if (length < 0) return length;
  // The real stream callback can block and cancel this caller. Retain the
  // formatter's allocation through unwinding, not only the normal return.
  std::unique_ptr<char, decltype(&std::free)> allocation(text, std::free);
  for (int i = 0; i < length; ++i) adapter_fputc(static_cast<unsigned char>(text[i]), static_cast<FILE*>(destination));
  return length;
}
extern "C" int __mingw_wpformat(int, void* destination, int, const wchar_t* format, va_list ap) {
  wchar_t* text = nullptr;
  gesher::CancellationCleanup allocation([](void* raw) {
    std::free(*static_cast<wchar_t**>(raw));
  }, &text);
  size_t count = 0;
  std::unique_ptr<FILE, decltype(&HostFclose)> memory(open_wmemstream(&text, &count), HostFclose);
  if (!memory) return -1;
  int result = HostVfwprintf(memory.get(), format, ap);
  memory.reset();  // Finalize text before transferring it or freeing it.
  if (result >= 0) for (size_t i = 0; i < count; ++i) adapter_fputwc(text[i], static_cast<FILE*>(destination));
  return result;
}
static ssize_t HostScanRead(void* cookie, char* bytes, size_t count) {
  if (!count) return 0;
  int value = adapter_fgetc(static_cast<FILE*>(cookie));
  if (value == EOF) return adapter_ferror(static_cast<FILE*>(cookie)) ? -1 : 0;
  bytes[0] = static_cast<char>(value);
  return 1;
}
extern "C" int __real___mingw_vfscanf(FILE* stream, const char* format, va_list ap) {
  cookie_io_functions_t io{};
  io.read = HostScanRead;
  std::unique_ptr<FILE, decltype(&HostFclose)> proxy(fopencookie(stream, "r", io), HostFclose);
  if (!proxy) return EOF;
  HostSetvbuf(proxy.get(), nullptr, _IONBF, 0);
  int result = HostVfscanf(proxy.get(), format, ap);
  const int saved = errno;
  // This is an explicitly glibc-only envelope. Preserve scanner look-ahead
  // held by its proxy stream before the native allocation is released.
  while (proxy->_IO_read_ptr < proxy->_IO_read_end) {
    adapter_ungetc(static_cast<unsigned char>(*--proxy->_IO_read_end), stream);
  }
  proxy.reset();
  errno = saved;
  return result;
}
extern "C" int __real___mingw_vfwscanf(FILE*, const wchar_t*, va_list) { return errno = ENOSYS, EOF; }

#define GESHER_STDIO_HOST_ENVELOPE 1
#include "stdio_ofd_contract.inc"
#include "stdio_cancel_contract.inc"

static void TestAllocationOwnership() {
  char path[] = "stdio-allocation-XXXXXX";
  int fd = mkstemp(path);
  check("stdio ownership fixture opens", fd >= 0);
  if (fd < 0) return;
  fail_fdopen = true;
  check("native fdopen failure retains descriptor", adapter_fdopen(fd, "r+") == nullptr && errno == EMFILE && fcntl(fd, F_GETFD) >= 0);
  // The two snapshot allocations now precede the existing State and registry
  // node allocations. Keep fault coverage of every pre-ownership allocation.
  for (int allocation = 0; allocation != 4; ++allocation) {
    allocation_failure = allocation;
    FILE* stream = adapter_fdopen(fd, "r+");
    allocation_failure = -1;
    check("metadata allocation fails before descriptor ownership transfer", stream == nullptr && errno == ENOMEM && fcntl(fd, F_GETFD) >= 0);
    if (stream) { adapter_fclose(stream); fd = open(path, O_RDWR); }
  }
  check("descriptor remains usable after every failed fdopen", write(fd, "ok", 2) == 2);
  FILE* raw = HostFdopen(fd, "r+");
  check("unregistered native stream opens for status queries", raw != nullptr);
  if (raw) {
    // Preparing only the declared CRT lock boundary is allocation-free in
    // production. The actual shared registry has no record for this FILE.
    CrtLock(raw);
    allocation_failure = 0;
    int error = adapter_ferror(raw);
    bool error_no_allocation = allocation_failure == 0;
    allocation_failure = 0;
    int eof = adapter_feof(raw);
    bool eof_no_allocation = allocation_failure == 0;
    allocation_failure = 0;
    adapter_clearerr(raw);
    bool clear_no_allocation = allocation_failure == 0;
    allocation_failure = 0;
    errno = 0;
    int value = adapter_fgetc(raw);
    bool capture_error_preserved = value == EOF && errno == ENOMEM;
    allocation_failure = -1;
    check("fresh-stream error query does not allocate or invent an error", error == 0 && error_no_allocation);
    check("fresh-stream EOF query does not allocate", eof == 0 && eof_no_allocation);
    check("fresh-stream clearerr does not allocate", clear_no_allocation);
    check("first-I/O snapshot allocation failure retains ENOMEM", capture_error_preserved);
    check("native stream remains usable after allocation-free queries", HostFclose(raw) == 0);
  } else close(fd);
  unlink(path);
}

static FILE* exit_stream;
static void ExitOutput() { adapter_fputs("late", exit_stream); }
static void TestBionicOwnerLifetime() {
  char path[] = "stdio-bionic-state-XXXXXX";
  int fd = mkstemp(path);
  if (fd < 0) std::abort();
  FILE* stream = adapter_fdopen(fd, "r+");
  if (!stream) std::abort();
  {
    gesher::stdio::StreamGuard lock(stream);
    auto* state = gesher::stdio::BionicMetadata(stream);
    check("Bionic metadata belongs to an actual locked stream", lock && state);
    state->conversion_error = true;
    state->pushback = 0x1f642;
    state->input_state[3] = 0x5a;
  }
  check("host error query sees Bionic conversion failure", adapter_ferror(stream) != 0);
  adapter_clearerr(stream);
  {
    gesher::stdio::StreamGuard lock(stream);
    auto* state = gesher::stdio::BionicMetadata(stream);
    check("host clearerr clears Bionic error without discarding unread wide state",
          !state->conversion_error && state->pushback == 0x1f642 && state->input_state[3] == 0x5a);
  }
  check("failed seek retains the stream", adapter_fseek(stream, 0, -99) == -1 && errno == EINVAL);
  {
    gesher::stdio::StreamGuard lock(stream);
    auto* state = gesher::stdio::BionicMetadata(stream);
    check("failed seek preserves pending Bionic input", state->pushback == 0x1f642 && state->input_state[3] == 0x5a);
  }
  check("successful seek reaches the real file", adapter_fseek(stream, 0, SEEK_SET) == 0);
  {
    gesher::stdio::StreamGuard lock(stream);
    auto* state = gesher::stdio::BionicMetadata(stream);
    check("successful seek discards Bionic pushback and partial decoder state",
          state->pushback == 0xffffffffu && state->input_state == std::array<uint8_t, 8>{});
    state->conversion_error = true;
    state->pushback = 'Q';
    state->input_state[0] = 0x7f;
  }
  check("reinitializing the actual owner succeeds", gesher::stdio::Register(stream, O_RDWR) == 0);
  {
    gesher::stdio::StreamGuard lock(stream);
    auto* state = gesher::stdio::BionicMetadata(stream);
    check("reinitialization retires every old Bionic metadata field",
          !state->conversion_error && state->pushback == 0xffffffffu && state->input_state == std::array<uint8_t, 8>{});
  }
  check("host fclose releases its real descriptor", adapter_fclose(stream) == 0 && fcntl(fd, F_GETFD) == -1 && errno == EBADF);
  check("host fclose leaves no Bionic metadata for a recycled token",
        gesher::stdio::BionicMetadata(stream, false) == nullptr);
  unlink(path);
}
static void TestCrtLockComposition() {
  char path[] = "stdio-crt-lock-XXXXXX";
  int fd = mkstemp(path);
  check("CRT composition fixture opens", fd >= 0);
  if (fd < 0) return;
  FILE* stream = adapter_fdopen(fd, "w+");
  check("CRT composition stream opens", stream != nullptr);
  if (!stream) { close(fd); unlink(path); return; }
  _lock_file(stream);
  std::atomic<int> try_result{-1};
  std::thread try_guest([&] {
    int result = adapter_ftrylockfile(stream);
    try_result = result;
    if (result == 0) adapter_funlockfile(stream);
  });
  try_guest.join();
  check("public trylock observes the native CRT owner", try_result == EBUSY);
  check("public trylock is recursive for the native CRT owner", adapter_ftrylockfile(stream) == 0);
  adapter_funlockfile(stream);
  const unsigned attempts = crt_lock_attempts.load();
  std::atomic<bool> done{false};
  int result = EOF;
  std::thread closer([&] { result = adapter_fclose(stream); done = true; });
  auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(1);
  while (crt_lock_attempts.load() == attempts && !done && std::chrono::steady_clock::now() < deadline)
    std::this_thread::yield();
  check("descriptor-backed fclose waits for the native CRT owner",
        crt_lock_attempts.load() > attempts && !done && fcntl(fd, F_GETFD) >= 0);
  _unlock_file(stream);
  closer.join();
  check("descriptor-backed fclose completes after native CRT unlock",
        done && result == 0 && fcntl(fd, F_GETFD) == -1);
  unlink(path);
}
static void TestBionicUnlockedProgress() {
  for (bool writing : {false, true}) {
    char path[] = "stdio-bionic-unlocked-XXXXXX";
    int fd = mkstemp(path);
    check("guest unlocked fixture opens", fd >= 0);
    if (fd < 0) continue;
    FILE* stream = adapter_fdopen(fd, "r+");
    check("guest unlocked fixture attaches the real stream owner", stream != nullptr);
    if (!stream) { close(fd); unlink(path); continue; }
    check("guest unlocked fixture writes real source bytes", write(fd, "R", 1) == 1 && lseek(fd, 0, SEEK_SET) == 0);
    adapter_flockfile(stream);
    std::atomic<bool> entered{false}, completed{false};
    size_t result = 0;
    char byte = 0;
    std::thread worker([&] {
      entered.store(true, std::memory_order_release);
      result = writing ? guest::FwriteUnlocked("W", 1, 1, stream)
                       : guest::FreadUnlocked(&byte, 1, 1, stream);
      completed.store(true, std::memory_order_release);
    });
    // The lock holder performs no stream access until the worker has finished.
    // A bounded failure releases the real lock and joins, so the old source
    // reports the regression instead of hanging the entire host test job.
    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(2);
    while (!completed.load(std::memory_order_acquire) && std::chrono::steady_clock::now() < deadline)
      std::this_thread::yield();
    const bool before_unlock = completed.load(std::memory_order_acquire);
    adapter_funlockfile(stream);
    worker.join();
    check(writing ? "Bionic fwrite_unlocked completes while another thread owns flockfile"
                  : "Bionic fread_unlocked completes while another thread owns flockfile",
          entered.load(std::memory_order_acquire) && before_unlock && result == 1 && (writing || byte == 'R'));
    check("guest unlocked operation retains actual byte effects",
          adapter_fflush(stream) == 0 && pread(fd, &byte, 1, 0) == 1 && byte == (writing ? 'W' : 'R'));
    check("guest unlocked stream retires normally", adapter_fclose(stream) == 0);
    unlink(path);
  }
}
static bool Await(const std::atomic<bool>& flag) {
  const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(2);
  while (!flag.load(std::memory_order_acquire) && std::chrono::steady_clock::now() < deadline)
    std::this_thread::yield();
  return flag.load(std::memory_order_acquire);
}
static void TestOwnerCacheProgress() {
  char path[] = "stdio-owner-cache-XXXXXX";
  int fd = mkstemp(path);
  if (fd < 0) std::abort();
  std::string bytes(16384, 'q');
  if (write(fd, bytes.data(), bytes.size()) != static_cast<ssize_t>(bytes.size()) ||
      lseek(fd, 0, SEEK_SET) != 0) std::abort();
  FILE* stream = adapter_fdopen(fd, "r");
  if (!stream) std::abort();
  std::atomic<bool> warm{false}, start{false}, done{false};
  uint64_t sum = 0;
  int end = 0;
  std::thread reader([&] {
    sum = guest::Fgetc(stream);  // Warm this thread's actual positive owner lookup.
    warm.store(true, std::memory_order_release);
    while (!start.load(std::memory_order_acquire)) std::this_thread::yield();
    for (size_t i = 1; i < bytes.size(); ++i) sum += guest::Fgetc(stream);
    end = guest::Fgetc(stream);
    done.store(true, std::memory_order_release);
  });
  const bool warmed = Await(warm);
  bool before_unlock;
  {
    // This is the actual production registry mutex, held by another thread.
    // A cache miss must wait; a valid positive lookup must keep doing real I/O.
    std::unique_lock<std::mutex> lock(gesher::stdio::registry->mutex);
    start.store(true, std::memory_order_release);
    before_unlock = Await(done);
  }
  reader.join();  // The counterfactual always gets its lock back before joining.
  check("positive owner cache reads while another thread holds the registry mutex", warmed && before_unlock);
  check("cached guest Fgetc preserves every byte and EOF", sum == bytes.size() * uint64_t('q') && end == EOF);
  check("cached stream closes its real descriptor", adapter_fclose(stream) == 0 && fcntl(fd, F_GETFD) == -1);
  unlink(path);
}
static void TestOwnerCacheLifetime() {
#ifdef GESHER_STDIO_OWNER_CACHE
  char path[] = "stdio-owner-generation-XXXXXX";
  int fd = mkstemp(path);
  if (fd < 0) std::abort();
  std::array<uint64_t, 32> before{};
  for (size_t i = 0; i < before.size(); ++i)
    before[i] = gesher::stdio::registry->generations[i].value.load();
  FILE* stream = adapter_fdopen(fd, "r+");
  if (!stream) std::abort();
  auto& epoch = gesher::stdio::OwnerGeneration(stream);
  const size_t bucket = (reinterpret_cast<uintptr_t>(stream) >> 4) % before.size();
  check("native token registration invalidates the positive cache bucket", epoch.load() == before[bucket] + 1);
  _lock_file(stream);
  auto old = gesher::stdio::Find(stream, false);
  old->bionic.conversion_error = true;
  old->bionic.pushback = 'Q';
  old->bionic.input_state[2] = 7;
  const uint64_t generation = epoch.load();
  gesher::stdio::Forget(stream);
  const bool invalidated = epoch.load() != generation;
  check("retirement invalidates cached map slots before release", invalidated && !old->live);
  // A deliberately broken retirement must report the invariant failure before
  // the counterfactual could dereference its now-freed map slot. Cleanup does
  // not turn that failure into a pass or replace a production lookup.
  if (!invalidated) gesher::stdio::t_stream_owners = {};
  check("retired FILE has no shared metadata", gesher::stdio::BionicMetadata(stream, false) == nullptr);
  check("same live FILE can register a new owner", gesher::stdio::Register(stream, O_RDWR) == 0);
  auto current = gesher::stdio::Find(stream, false);
  check("new owner does not reuse the retained retired state", current && current != old && current->live);
  check("new owner resets all guest codec metadata", !current->bionic.conversion_error &&
        current->bionic.pushback == 0xffffffffu && current->bionic.input_state == std::array<uint8_t, 8>{});
  // Reach the otherwise impractical overflow boundary on the actual counter.
  // The permanent-zero state must survive further retirement and registration.
  epoch.store(UINT64_MAX);
  check("positive lookup works at the final generation", gesher::stdio::Find(stream, false) == current);
  for (int i = 0; i < 3; ++i) {
    gesher::stdio::Forget(stream);
    check("generation wrap permanently disables cached pointers", epoch.load() == 0);
    if (epoch.load() != 0) gesher::stdio::t_stream_owners = {};  // Failed-control cleanup before another lookup.
    check("locked lookup still registers after generation wrap", gesher::stdio::Register(stream, O_RDWR) == 0);
    auto found = gesher::stdio::Find(stream, false);
    check("uncached owner remains live after generation wrap", found && found->live && found != current);
  }
  _unlock_file(stream);
  check("wrapped-cache stream retires its real descriptor", adapter_fclose(stream) == 0 && fcntl(fd, F_GETFD) == -1);
  unlink(path);
#endif
}
static void TestCrossThreadOwnerCache() {
#ifdef GESHER_STDIO_OWNER_CACHE
  char path[] = "stdio-owner-publish-XXXXXX";
  int fd = mkstemp(path);
  if (fd < 0) std::abort();
  FILE* stream = HostFdopen(fd, "r+");  // A real native FILE, initially unregistered.
  if (!stream) std::abort();
  std::atomic<bool> missed{false}, publish{false}, warmed{false}, retire{false};
  std::atomic<bool> safe_lookup{true};
  bool initial_absent = false, observed_publish = false, observed_retirement = false;
  std::thread observer([&] {
    _lock_file(stream);
    initial_absent = gesher::stdio::BionicMetadata(stream, false) == nullptr;
    _unlock_file(stream);
    missed.store(true, std::memory_order_release);
    while (!publish.load(std::memory_order_acquire)) std::this_thread::yield();
    _lock_file(stream);
    auto cached = gesher::stdio::Find(stream, false);
    observed_publish = cached && cached->bionic.conversion_error && cached->bionic.pushback == 'P';
    _unlock_file(stream);
    warmed.store(true, std::memory_order_release);
    while (!retire.load(std::memory_order_acquire)) std::this_thread::yield();
    _lock_file(stream);
    if (safe_lookup.load(std::memory_order_acquire)) {
      auto current = gesher::stdio::Find(stream, false);
      observed_retirement = cached && !cached->live && current && current != cached &&
          current->live && !current->bionic.conversion_error &&
          current->bionic.pushback == 0xffffffffu && current->bionic.input_state == std::array<uint8_t, 8>{};
    } else {
      gesher::stdio::t_stream_owners = {};  // Cleanup after an already detected broken invalidation.
    }
    _unlock_file(stream);
  });
  const bool saw_miss = Await(missed);
  _lock_file(stream);
  const int first_registration = gesher::stdio::Register(stream, O_RDWR);
  auto* metadata = gesher::stdio::BionicMetadata(stream);
  if (!metadata) std::abort();
  metadata->conversion_error = true;
  metadata->pushback = 'P';
  metadata->input_state[1] = 0x55;
  _unlock_file(stream);
  publish.store(true, std::memory_order_release);
  const bool saw_warm = Await(warmed);
  _lock_file(stream);
  auto& epoch = gesher::stdio::OwnerGeneration(stream);
  const uint64_t before = epoch.load();
  gesher::stdio::Forget(stream);
  const bool invalidated = before == 0 || epoch.load() != before;
  if (!invalidated) gesher::stdio::t_stream_owners = {};
  const int second_registration = gesher::stdio::Register(stream, O_RDWR);
  safe_lookup.store(invalidated, std::memory_order_release);
  _unlock_file(stream);
  retire.store(true, std::memory_order_release);
  observer.join();
  check("unregistered lookup is not a negative cache entry", saw_miss && initial_absent);
  check("another thread sees registration after its earlier miss", first_registration == 0 && observed_publish && saw_warm);
  check("retirement invalidates another thread's positive cache", invalidated && second_registration == 0 && observed_retirement);
  check("cross-thread cache stream closes its real descriptor", adapter_fclose(stream) == 0 && fcntl(fd, F_GETFD) == -1);
  unlink(path);
#endif
}
@OWNER_CACHE_BENCHMARK@

int main(int argc, char** argv) {
  if (argc == 4 && std::strcmp(argv[1], "--owner-cache-benchmark") == 0) {
    char* end = nullptr;
    const unsigned long long bytes = std::strtoull(argv[2], &end, 10);
    if (!end || *end || bytes == 0 || bytes > 16u * 1024u * 1024u) return 2;
    const unsigned long threads = std::strtoul(argv[3], &end, 10);
    if (!end || *end || (threads != 1 && threads != 4)) return 2;
    return OwnerCacheBenchmark(static_cast<size_t>(bytes), static_cast<int>(threads));
  }
  if (argc == 2 && std::strcmp(argv[1], "--owner-cache") == 0) {
    TestOwnerCacheProgress();
    TestCrossThreadOwnerCache();
    TestOwnerCacheLifetime();
    char summary[128];
    const int count = snprintf(summary, sizeof(summary), "Shared owner cache: %d checks, %d failures\n", checks, failures);
    if (count < 0 || static_cast<size_t>(count) >= sizeof(summary) ||
        ::write(STDOUT_FILENO, summary, static_cast<size_t>(count)) != count) return 2;
    return failures != 0;
  }
  if (argc == 2 && std::strcmp(argv[1], "--bionic-unlocked") == 0) {
    TestBionicUnlockedProgress();
    char summary[128];
    const int count = snprintf(summary, sizeof(summary), "Bionic unlocked production path: %d checks, %d failures\n", checks, failures);
    if (count < 0 || static_cast<size_t>(count) >= sizeof(summary) ||
        ::write(STDOUT_FILENO, summary, static_cast<size_t>(count)) != count) return 2;
    return failures != 0;
  }
  if (argc == 3 && (std::strcmp(argv[1], "--exit-output") == 0 ||
                    std::strcmp(argv[1], "--exit-socket") == 0)) {
    // This is deliberately registered before the first application stdio use.
    std::atexit(ExitOutput);
    if (std::strcmp(argv[1], "--exit-socket") == 0 && !socket_boundary::Begin()) return 3;
    exit_stream = adapter_fopen(argv[2], "w");
    if (!exit_stream || adapter_fputs("early", exit_stream) < 0) return 2;
    return 0;
  }
  test_stdio_ofd_contracts();
  TestAllocationOwnership();
  TestBionicOwnerLifetime();
  TestOwnerCacheProgress();
  TestCrossThreadOwnerCache();
  TestOwnerCacheLifetime();
  test_stdio_cancel_contracts();
  TestCrtLockComposition();
  TestBionicUnlockedProgress();
  char summary[128];
  int count = snprintf(summary, sizeof(summary), "stdio production adapter: %d checks, %d failures\n", checks, failures);
  if (count < 0 || static_cast<size_t>(count) >= sizeof(summary) ||
      write(STDOUT_FILENO, summary, static_cast<size_t>(count)) != count) return 2;
  return failures ? 1 : 0;
}
