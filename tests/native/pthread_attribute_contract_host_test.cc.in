namespace gesher::elf { bool SetupThreadTls() { return true; } }
// The ELF loader's lifetime pins (gesher/elf_loader.h). This fixture loads no
// library: no address has an owning library, so a destructor holds no pin.
namespace gesher::elf {
struct Library;
inline Library* RetainForAddress(const void*) { return nullptr; }
inline void ReleaseLifetimePin(Library*) {}
}  // namespace gesher::elf
// gesher/fork.h (ADR 0092): this fixture never forks. A leaving thread passes
// the fork's exit gate (counted here), and key destructors take their lock.
namespace gesher {
std::atomic<int> threads_left{0};
void ThreadLeaving() { threads_left.fetch_add(1); }
template <typename Lock>
bool LockUnlessForkHolds(Lock& lock) {
  lock.lock();
  return true;
}
}  // namespace gesher
namespace gesher::bionic {
namespace {
int32_t SelfTid() { return static_cast<int32_t>(GetCurrentThreadId()); }
@KEY_STATE@
@THREAD_STATE@
}
extern "C" {
@THREAD_API@
}
namespace {
@ATTR_EXTRAS@
}
void AttributeSymbols(SymbolTable& t) {
  (void)g_next_cpu_clock;  // The extracted shared registry also owns clock IDs.
#define P(name) t[#name] = reinterpret_cast<void*>(&gesher_bionic_##name)
@THREAD_REGISTRATIONS@
#undef P
#define E(name, fn) t[name] = reinterpret_cast<void*>(&fn)
@EXTRA_REGISTRATIONS@
#undef E
}
}

#ifndef GESHER_ATTRIBUTE_BASELINE
#define GESHER_SYSV BIONIC_SYSV
namespace gesher_arm64 {
static std::atomic<bool> hold_attach{false}, attach_started{false};
static thread_local uint32_t current_fpcr = 0, current_fpsr = 0;
static thread_local std::vector<uint8_t> translated_stack;
static void* ResolveHost(const char* name) {
  if (std::strcmp(name, "__gesher_arm64_set_thread_stack") == 0)
    return reinterpret_cast<void*>(&gesher::bionic::gesher_bionic___gesher_arm64_set_thread_stack);
  return nullptr;
}
static struct { void* (*resolve)(const char*); } host{ResolveHost}, *g_host = &host;
static uint32_t GuestFpcr() { return current_fpcr; }
static uint32_t GuestFpsr() { return current_fpsr; }
static void SetGuestFpcr(uint32_t value) {
  current_fpcr = value;
  attach_started.store(true);
  while (hold_attach.load()) std::this_thread::yield();
  constexpr size_t kStackSize = 32768, kGuardSize = 4096;
  translated_stack.resize(kStackSize);
  uint8_t* stack_base_ = translated_stack.data();
@GUEST_STACK_PUBLICATION@
}
static void SetGuestFpsr(uint32_t value) { current_fpsr = value; }
@GUEST_START_STATE@
@GUEST_START_API@
}
#endif

using namespace pthread_attributes_test;
static Api api;
static void* Symbol(const char* name) {
  static gesher::bionic::SymbolTable table = [] {
    gesher::bionic::SymbolTable value;
    gesher::bionic::AttributeSymbols(value);
    return value;
  }();
  auto found = table.find(name);
  return found == table.end() ? nullptr : found->second;
}
template<class Predicate>
static void Await(Predicate ready, const char* label) {
  auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(5);
  while (!ready()) {
    if (std::chrono::steady_clock::now() >= deadline) {
      Check(false, label);
      std::_Exit(1);  // Do not destroy state that an unfinished worker still owns.
    }
    std::this_thread::yield();
  }
}
struct Worker {
  std::atomic<bool> ready{false};
  std::atomic<bool> stop{false};
  Thread id = 0;
  Attr own{};
  int own_result = -1;
  uintptr_t local = 0;
  ULONG_PTR low = 0, high = 0;
  std::shared_ptr<test_windows::Thread> native;
  bool translated = false;
  uintptr_t translated_base = 0;
  uint32_t fpcr = 0, fpsr = 0;
};
static void* BIONIC_SYSV RunWorker(void* raw) {
  auto& worker = *static_cast<Worker*>(raw);
  worker.id = api.self();
  worker.own_result = api.getattr(worker.id, &worker.own);
  worker.local = reinterpret_cast<uintptr_t>(__builtin_frame_address(0));
  GetCurrentThreadStackLimits(&worker.low, &worker.high);
  worker.native = test_windows::Self();
#ifndef GESHER_ATTRIBUTE_BASELINE
  if (worker.translated) {
    worker.translated_base = reinterpret_cast<uintptr_t>(gesher_arm64::translated_stack.data());
    worker.fpcr = gesher_arm64::GuestFpcr();
    worker.fpsr = gesher_arm64::GuestFpsr();
  }
#endif
  worker.ready.store(true);
  while (!worker.stop.load()) std::this_thread::yield();
  return reinterpret_cast<void*>(0x1234);
}
static void CheckTarget(Thread target, const Worker& worker, uintptr_t caller) {
  Attr attr{};
  int result = api.getattr(target, &attr);
  Check(result == 0 && attr.stack_base == reinterpret_cast<void*>(worker.low) &&
            attr.stack_size == worker.high - worker.low,
        "peer stack exactly matches target OS observation");
  Check(result == 0 && Contains(attr, worker.local) && !Contains(attr, caller),
        "peer interval contains target local and excludes caller local");
  Check(worker.own_result == 0 && worker.own.stack_base == attr.stack_base &&
            worker.own.stack_size == attr.stack_size,
        "peer and self stack queries agree");
}
static void WaitNative(const Worker& worker) {
  test_windows::Handle owned{worker.native};
  if (WaitForSingleObject(&owned, 5000) != WAIT_OBJECT_0) {
    Check(false, "worker terminates within deadline");
    std::_Exit(1);
  }
}
static void TargetContracts() {
  uintptr_t caller = reinterpret_cast<uintptr_t>(__builtin_frame_address(0));
  Thread self = api.self();
  Attr attr{};
  Check(api.getattr(self, &attr) == 0 && Contains(attr, caller),
        "external calling thread has its own stack");
  int baseline_handles = test_windows::handles.load();
  for (bool detached : {false, true}) {
    Worker worker;
    Attr requested{};
    api.init(&requested);
    api.size_set(&requested, detached ? 3 * 1024 * 1024 : 2 * 1024 * 1024);
    api.detach_set(&requested, detached ? 1 : 0);
    Thread target = 0;
    Check(api.create(&target, &requested, RunWorker, &worker) == 0, "create guest target");
    Await([&] { return worker.ready.load(); }, "target enters user callback without registry lock");
    CheckTarget(target, worker, caller);
    int mode = -1;
    Check(api.getattr(target, &attr) == 0 && api.detach_get(&attr, &mode) == 0 &&
              mode == (detached ? 1 : 0), "runtime detach mode matches creation");
    bool stable = true;
    for (int i = 0; i < 512; ++i) {
      Attr snapshot{};
      stable &= api.getattr(target, &snapshot) == 0 && snapshot.stack_base == worker.own.stack_base &&
                  snapshot.stack_size == worker.own.stack_size;
    }
    Check(stable, "512 peer snapshots retain exact target interval");
    worker.stop.store(true);
    if (!detached) {
      void* result = nullptr;
      Check(api.join(target, &result) == 0 && result == reinterpret_cast<void*>(0x1234),
            "join retains callback result");
    }
    WaitNative(worker);
    Attr untouched;
    std::memset(&untouched, 0x5a, sizeof untouched);
    Attr before = untouched;
    Check(api.getattr(target, &untouched) == 3 &&
              std::memcmp(&untouched, &before, sizeof untouched) == 0,
          "retired identity returns ESRCH without writing output");
  }
  Worker changing;
  Thread target = 0;
  Check(api.create(&target, nullptr, RunWorker, &changing) == 0, "create target for live detach");
  Await([&] { return changing.ready.load(); }, "live-detach target starts");
  Check(api.detach(target) == 0, "detach a live target");
  int mode = -1;
  Check(api.getattr(target, &attr) == 0 && api.detach_get(&attr, &mode) == 0 && mode == 1 &&
            attr.stack_base == changing.own.stack_base,
        "query observes live detach without changing stack");
  changing.stop.store(true);
  WaitNative(changing);

  Worker external;
  std::thread host([&] { RunWorker(&external); });
  Await([&] { return external.ready.load(); }, "external thread registers its own identity");
  CheckTarget(external.id, external, caller);
  external.stop.store(true);
  host.join();
  Check(api.getattr(external.id, &attr) == 3, "terminated external thread is reaped");
  Check(test_windows::handles.load() == baseline_handles,
        "queries and target retirement leak no retained handles");
  Attr before = attr;
  Check(api.getattr(UINT64_MAX, &attr) == 3 && std::memcmp(&attr, &before, sizeof attr) == 0,
        "unknown identity preserves output");
#ifndef GESHER_ATTRIBUTE_BASELINE
  Check(api.getattr(self, nullptr) == 22, "null output is rejected before waiting");
#endif
}
static void DelayedStartup() {
  Worker worker;
  Thread target = 0;
  test_windows::hold_start.store(true);
  Check(api.create(&target, nullptr, RunWorker, &worker) == 0,
        "creation may return before target starts");
  std::atomic<bool> querying{false}, finished{false};
  Attr result{};
  int status = -1;
  std::thread query([&] {
    querying.store(true);
    status = api.getattr(target, &result);
    finished.store(true);
  });
  Await([&] { return querying.load(); }, "observer starts");
  std::this_thread::sleep_for(std::chrono::milliseconds(30));
  Check(!finished.load(), "query waits for target snapshot instead of inventing caller bounds");
  test_windows::hold_start.store(false);
  Await([&] { return finished.load(); }, "target publication wakes waiting query");
  query.join();
  Await([&] { return worker.ready.load(); }, "delayed target reaches callback");
  Check(status == 0 && result.stack_base == worker.own.stack_base &&
            result.stack_size == worker.own.stack_size,
        "waiting query receives the target's published bounds");
  worker.stop.store(true);
  Check(api.join(target, nullptr) == 0, "delayed target remains joinable");
  int handles = test_windows::handles.load();
  Thread unchanged = 0x12345678;
  test_windows::fail_create.store(true);
  int error = api.create(&unchanged, nullptr, RunWorker, &worker);
  test_windows::fail_create.store(false);
  Check(error == 11 && unchanged == 0x12345678 && test_windows::handles.load() == handles,
        "CreateThread failure leaves output and ownership unchanged");
}
static void DetachBeforePublication() {
  Worker worker;
  Thread target = 0;
  test_windows::hold_start.store(true);
  Check(api.create(&target, nullptr, RunWorker, &worker) == 0,
        "create target whose publication can be detached concurrently");
  std::atomic<bool> querying{false}, finished{false};
  Attr result{};
  int status = -1;
  std::thread query([&] {
    querying.store(true);
    status = api.getattr(target, &result);
    finished.store(true);
  });
  Await([&] { return querying.load(); }, "pre-publication detach observer starts");
  std::this_thread::sleep_for(std::chrono::milliseconds(30));
  bool pending = !finished.load();
  int detach_result = api.detach(target);
  Check(pending && detach_result == 0,
        "pending query releases the registry lock for detach");
  test_windows::hold_start.store(false);
  Await([&] { return finished.load(); }, "detached target publication wakes its observer");
  query.join();
  Await([&] { return worker.ready.load(); }, "pre-publication detached target reaches callback");
  int detached = -1;
  Check(status == 0 && result.stack_base == worker.own.stack_base &&
            result.stack_size == worker.own.stack_size &&
            api.detach_get(&result, &detached) == 0 && detached == 1,
        "waiting query observes target bounds and concurrent detach together");
  worker.stop.store(true);
  WaitNative(worker);
  Check(api.getattr(target, &result) == 3,
        "pre-publication detached target retires after callback completion");
}
static void FailedExternalRetention() {
  int handles = test_windows::handles.load();
  Worker worker;
  test_windows::fail_duplicate.store(true);
  std::thread external([&] { RunWorker(&worker); });
  Await([&] { return worker.ready.load(); }, "external thread survives retained-handle exhaustion");
  test_windows::fail_duplicate.store(false);
  Check(worker.own_result == 0 && Contains(worker.own, worker.local),
        "external self query remains authoritative without a retained handle");
  Attr result;
  std::memset(&result, 0x5a, sizeof result);
  Attr before = result;
  Check(api.getattr(worker.id, &result) == 11 &&
            std::memcmp(&result, &before, sizeof result) == 0,
        "external peer query reports EAGAIN without trusting an unretained identity");
  worker.stop.store(true);
  external.join();
  Check(test_windows::handles.load() <= handles,
        "external registration failure creates no retained handle to leak");
}
#ifndef GESHER_ATTRIBUTE_BASELINE
static void TranslatedContracts() {
  using gesher::bionic::gesher_bionic___gesher_arm64_pthread_getattr_np;
  using gesher::bionic::gesher_bionic___gesher_arm64_set_thread_stack;
  auto guest_getattr = gesher_bionic___gesher_arm64_pthread_getattr_np;
  Attr unknown;
  std::memset(&unknown, 0x5a, sizeof unknown);
  Attr before = unknown;
  Check(guest_getattr(api.self(), &unknown) == 11 &&
            std::memcmp(&unknown, &before, sizeof unknown) == 0,
        "translated query does not invent a native stack before publication");
  Check(gesher_bionic___gesher_arm64_set_thread_stack(nullptr, 100, 0) == 22 &&
            gesher_bionic___gesher_arm64_set_thread_stack(reinterpret_cast<void*>(0x1000), 10, 10) == 22 &&
            gesher_bionic___gesher_arm64_set_thread_stack(reinterpret_cast<void*>(UINTPTR_MAX), 100, 0) == 22,
        "invalid translated stack publication is rejected");
  gesher_arm64::g_pthread_create = reinterpret_cast<gesher_arm64::ThreadCreate>(api.create);
  gesher_arm64::hold_attach.store(true);
  gesher_arm64::attach_started.store(false);
  Worker worker;
  worker.translated = true;
  Thread target = 0;
  std::atomic<bool> returned{false};
  int created = -1;
  std::thread creator([&] {
    gesher_arm64::current_fpcr = 0x400000;
    gesher_arm64::current_fpsr = 0x20;
    created = gesher_arm64::GuestPthreadCreate(&target, nullptr, RunWorker, &worker);
    returned.store(true);
  });
  Await([&] { return gesher_arm64::attach_started.load(); }, "translated target begins attachment");
  std::this_thread::sleep_for(std::chrono::milliseconds(30));
  Check(!returned.load(), "translated creation waits for stack publication");
  gesher_arm64::hold_attach.store(false);
  Await([&] { return returned.load(); }, "translated stack publication releases creator");
  creator.join();
  Await([&] { return worker.ready.load(); }, "translated user callback starts");
  Attr guest{}, native{};
  Check(created == 0 && guest_getattr(target, &guest) == 0 &&
            reinterpret_cast<uintptr_t>(guest.stack_base) == worker.translated_base &&
            guest.stack_size == 32768 && guest.guard_size == 4096,
        "translated snapshot matches actual provider stack and guard values");
  Check(api.getattr(target, &native) == 0 && native.stack_base == worker.own.stack_base &&
            native.stack_base != guest.stack_base,
        "native and translated views retain distinct stack authorities");
  Check(worker.fpcr == 0x400000 && worker.fpsr == 0x20,
        "startup handshake preserves inherited guest FPCR and FPSR");
  Check(api.detach(target) == 0 && guest_getattr(target, &guest) == 0 && (guest.flags & 1),
        "translated snapshot follows current guest detach state");
  worker.stop.store(true);
  WaitNative(worker);
  Check(guest_getattr(target, &guest) == 3, "retired guest cannot retain translated stack identity");
  Worker external;
  external.translated = true;
  std::thread provider([&] {
    gesher_arm64::SetGuestFpcr(0);
    RunWorker(&external);
  });
  Await([&] { return external.ready.load(); }, "external provider publishes before callback");
  Check(guest_getattr(external.id, &guest) == 0 &&
            reinterpret_cast<uintptr_t>(guest.stack_base) == external.translated_base,
        "external translated thread is found through retained identity");
  external.stop.store(true);
  provider.join();
  Check(guest_getattr(external.id, &guest) == 3,
        "external translated identity is reaped with its retained thread");
  Thread unchanged = 0x12345678;
  test_windows::fail_create.store(true);
  int error = gesher_arm64::GuestPthreadCreate(&unchanged, nullptr, RunWorker, &worker);
  test_windows::fail_create.store(false);
  Check(error == 11 && unchanged == 0x12345678,
        "translated creation failure does not wait on unpublished startup");
}
#endif
int main() {
  if (!Load(api, Symbol)) return 1;
  ValueContracts(api);
  TargetContracts();
  DelayedStartup();
  DetachBeforePublication();
  FailedExternalRetention();
#ifndef GESHER_ATTRIBUTE_BASELINE
  TranslatedContracts();
#endif
  // Windows closes remaining process handles at process exit. Dispose of the
  // Linux boundary's heap-backed wrappers for that same final teardown, after
  // every per-thread ownership assertion; leave LSan enabled in ordinary CI.
  {
    std::lock_guard<std::mutex> lock(gesher::bionic::g_threads_mutex);
    for (auto& [id, external] : gesher::bionic::g_external_threads) {
      (void)id;
#ifdef GESHER_ATTRIBUTE_BASELINE
      HANDLE handle = external;
#else
      HANDLE handle = external.handle;
#endif
      if (handle) CloseHandle(handle);
    }
    gesher::bionic::g_external_threads.clear();
  }
  std::printf("pthread attributes: %d checks, %d failures\n", checks, failures);
  return failures == 0 ? 0 : 1;
}
