// Production JNI installation and dispatch; only the Windows/ART boundaries
// below are controlled. Each scenario runs in a fresh process for static state.
#include <atomic>
#include <array>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <limits>
#include <map>
#include <mutex>
#include <string>
#include <thread>
#include <type_traits>
#include <vector>
#include <elf.h>
#include <sys/mman.h>

using DWORD = unsigned long;
constexpr int MEM_COMMIT = 1, MEM_RESERVE = 2, MEM_RELEASE = 4;
constexpr int PAGE_READWRITE = 1, PAGE_EXECUTE_READ = 2, PAGE_READONLY = 3;
constexpr size_t kPage = 4096, kEnvSlots = 7;
struct IMAGE_DOS_HEADER { int e_lfanew; };
struct IMAGE_NT_HEADERS64 { struct { uint64_t SizeOfImage; } OptionalHeader; };
alignas(64) uint8_t g_image[kPage]{};
struct JNINativeInterface { void* entries[kEnvSlots]{}; };
struct JNIEnv { void* const* functions; };
@PROXY_ENV@
// Pinned ART16r4 JNIEnvExt derives from JNIEnv, then stores const self_ and vm_
// pointers before locals and further runtime state. Represent that prefix with
// distinct live objects and sufficient storage, not the old two-word envelope
// or a synthetic proxy tag. This boundary performs no ART operations.
// https://android.googlesource.com/platform/art/+/android-16.0.0_r4/runtime/jni/jni_env_ext.h
struct ArtThreadBoundary { uintptr_t state = 0x5678; };
struct ArtVmBoundary { uintptr_t state = 0x9abc; };
struct ArtEnvBoundary : JNIEnv {
  ArtThreadBoundary* const self_;
  ArtVmBoundary* const vm_;
  uintptr_t locals_storage[4]{};
  ArtEnvBoundary(void* const* table, ArtThreadBoundary* thread, ArtVmBoundary* vm)
      : JNIEnv{table}, self_(thread), vm_(vm) {}
};
static_assert(sizeof(void*) == 8 && sizeof(ArtEnvBoundary) >= sizeof(ProxyEnv));
static_assert(alignof(ArtEnvBoundary) >= alignof(ProxyEnv));
template <typename Proxy>
Proxy NewProxy(void* const* table, bool guest) {
  if constexpr (std::is_constructible_v<Proxy, void* const*, bool>) {
    return Proxy(table, guest);  // The actual production constructor owns its tag.
  } else {
    // Historical --source-ref controls retain their actual old representation.
    return Proxy{table, nullptr};
  }
}
void* g_env_table[kEnvSlots]{};
void* g_env_table_guest[kEnvSlots]{};
JNINativeInterface g_real;
const JNINativeInterface* g_override = nullptr;
int g_publications = 0, g_allocations = 0, g_protections = 0, g_flushes = 0;
std::map<void*, size_t> g_live;
std::string g_failure;

void Require(bool condition, const char* message) {
  if (!condition) {
    std::fprintf(stderr, "FAIL %s: %s\n", g_failure.c_str(), message);
    std::exit(1);
  }
}
void* GetModuleHandleW(const void*) { return g_image; }
void* GetCurrentProcess() { return nullptr; }
void* VirtualAlloc(void*, size_t bytes, int, int) {
  ++g_allocations;
  if ((g_failure == "first-allocation" && g_allocations == 1) ||
      (g_failure == "second-allocation" && g_allocations == 2)) return nullptr;
  size_t size = (bytes + kPage - 1) / kPage * kPage;
  void* p = mmap(nullptr, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
  Require(p != MAP_FAILED, "fixture allocation");
  g_live.emplace(p, size);
  return p;
}
bool VirtualFree(void* p, size_t, int) {
  auto it = g_live.find(p);
  Require(it != g_live.end(), "free owns a live allocation");
  Require(munmap(p, it->second) == 0, "fixture release");
  g_live.erase(it);
  return true;
}
bool VirtualProtect(void* p, size_t, int protection, DWORD*) {
  ++g_protections;
  if ((g_failure == "code-protection" && g_protections == 1) ||
      (g_failure == "table-protection" && g_protections == 2)) return false;
  auto it = g_live.find(p);
  Require(it != g_live.end(), "protect owns a live allocation");
  int flags = PROT_READ | (protection == PAGE_EXECUTE_READ ? PROT_EXEC : 0);
  return mprotect(p, it->second, flags) == 0;
}
bool FlushInstructionCache(void*, void*, size_t) {
  ++g_flushes;
  return g_failure != "cache-flush";
}
const JNINativeInterface* gesher_art_jni_function_table() {
  return g_failure == "null-table" ? nullptr : &g_real;
}
void gesher_art_set_jni_table_override(const JNINativeInterface* table) {
  Require(g_override == nullptr, "table published once");
  g_override = table;
  ++g_publications;
}
void HookEntry() {}
namespace gesher::bionic {
bool IsArtHookingPacker(const char* path) { return std::strcmp(path, "libexec.so") == 0; }
void* LoadArtShim(const std::string&, std::string* path, std::string*) {
  *path = "fixture/libart.so";
  return reinterpret_cast<void*>(&HookEntry);
}
}  // namespace gesher::bionic

@HOOK_DECLARATION@
@HOOK_DEFINITION@
@REAL_ENV@
@GUEST_ENV@
@INSTALLER@

void* ReadHook() {
  @HOOK_READ@
  return hook;
}

uint64_t IntegerResult(void* env, uint64_t a, uint64_t b, uint64_t c,
                       uint64_t d, uint64_t e, uint64_t f) {
  return reinterpret_cast<uintptr_t>(env) + a + b * 3 + c * 5 + d * 7 + e * 11 + f * 13;
}
uint64_t __attribute__((sysv_abi)) SysvInteger(void* env, uint64_t a, uint64_t b,
    uint64_t c, uint64_t d, uint64_t e, uint64_t f) { return IntegerResult(env, a, b, c, d, e, f); }
uint64_t __attribute__((ms_abi)) MsInteger(void* env, uint64_t a, uint64_t b,
    uint64_t c, uint64_t d, uint64_t e, uint64_t f) { return IntegerResult(env, a, b, c, d, e, f) + 1; }
double FloatingResult(void* env, double a, double b, double c, double d,
                       double e, double f, double g, double h, double i) {
  return reinterpret_cast<uintptr_t>(env) + a + b*2 + c*3 + d*4 + e*5 + f*6 + g*7 + h*8 + i*9;
}
double __attribute__((sysv_abi)) SysvFloating(void* env, double a, double b, double c, double d,
    double e, double f, double g, double h, double i) { return FloatingResult(env,a,b,c,d,e,f,g,h,i); }
double __attribute__((ms_abi)) MsFloating(void* env, double a, double b, double c, double d,
    double e, double f, double g, double h, double i) { return FloatingResult(env,a,b,c,d,e,f,g,h,i)+1; }
extern "C" uint64_t VectorCount(void*, ...);
asm(".text\n.globl VectorCount\nVectorCount:\nmovzbl %al, %eax\nret\n");

// Select bounds covering or excluding the caller so the emitted dispatch code
// executes both branches. This changes only the fixture's generated pages.
void SetCallerRange(bool inside) {
  void* page = g_override->entries[4];
  page = reinterpret_cast<void*>(reinterpret_cast<uintptr_t>(page) & ~(kPage - 1));
  Require(mprotect(page, kPage, PROT_READ | PROT_WRITE) == 0, "fixture data update");
  for (size_t i = 4; i < kEnvSlots; ++i) {
    auto* stub = static_cast<uint8_t*>(g_override->entries[i]);
    uint64_t data_address = 0;
    std::memcpy(&data_address, stub + 6, sizeof(data_address));
    const uint64_t bounds[2] = {inside ? 0 : std::numeric_limits<uint64_t>::max(),
                                inside ? std::numeric_limits<uint64_t>::max() : 0};
    std::memcpy(reinterpret_cast<void*>(data_address), bounds, sizeof(bounds));
  }
  Require(mprotect(page, kPage, PROT_READ | PROT_EXEC) == 0, "fixture data sealed");
}

void CheckDispatch() {
  Require(g_override->entries[0] == nullptr && g_override->entries[1] == g_real.entries[1] &&
              g_override->entries[2] == nullptr, "reserved/missing slots preserved");
  ArtThreadBoundary thread;
  ArtVmBoundary vm;
  ArtEnvBoundary real{g_override->entries, &thread, &vm};
  ProxyEnv proxy = NewProxy<ProxyEnv>(g_env_table, false);
  ProxyEnv guest = NewProxy<ProxyEnv>(g_env_table_guest, true);
  proxy.real = &real; guest.real = &real;
  Require(Real(&real) == &real && Real(reinterpret_cast<JNIEnv*>(&proxy)) == &real &&
              Real(reinterpret_cast<JNIEnv*>(&guest)) == &real, "real and both proxy environments");
  using SysvInt = uint64_t(__attribute__((sysv_abi)) *)(void*, uint64_t, uint64_t, uint64_t,
                                                      uint64_t, uint64_t, uint64_t);
  using MsInt = uint64_t(__attribute__((ms_abi)) *)(void*, uint64_t, uint64_t, uint64_t,
                                                  uint64_t, uint64_t, uint64_t);
  using SysvFloat = double(__attribute__((sysv_abi)) *)(void*, double,double,double,double,
                                                       double,double,double,double,double);
  using MsFloat = double(__attribute__((ms_abi)) *)(void*, double,double,double,double,
                                                   double,double,double,double,double);
  auto* env = reinterpret_cast<void*>(0x1234);
  const uint64_t expected = IntegerResult(env, 1, 2, 3, 4, 5, 6);
  const double fp = FloatingResult(env, 1, 2, 3, 4, 5, 6, 7, 8, 9);
  SetCallerRange(false);
  Require(reinterpret_cast<SysvInt>(g_override->entries[4])(env,1,2,3,4,5,6) == expected,
          "System V integer and stack arguments");
  Require(reinterpret_cast<SysvFloat>(g_override->entries[5])(env,1,2,3,4,5,6,7,8,9) == fp,
          "System V floating and stack arguments");
  auto varargs = reinterpret_cast<uint64_t(*)(void*, ...)>(g_override->entries[6]);
  Require(varargs(env, 1.0, 2.0, 3.0) == 3, "variadic vector-register count survives");
  SetCallerRange(true);
  Require(reinterpret_cast<MsInt>(g_override->entries[4])(env,1,2,3,4,5,6) == expected + 1,
          "Microsoft integer and stack arguments");
  Require(reinterpret_cast<MsFloat>(g_override->entries[5])(env,1,2,3,4,5,6,7,8,9) == fp + 1,
          "Microsoft floating and stack arguments");
}

void CheckProxyIdentity() {
  ArtThreadBoundary thread;
  ArtVmBoundary vm;
  ArtEnvBoundary real{g_override->entries, &thread, &vm};
  Require(reinterpret_cast<void*>(&real) == reinterpret_cast<void*>(static_cast<JNIEnv*>(&real)) &&
              reinterpret_cast<uintptr_t>(&real.self_) - reinterpret_cast<uintptr_t>(&real) == sizeof(void*) &&
              reinterpret_cast<uintptr_t>(&real.vm_) - reinterpret_cast<uintptr_t>(&real) == 2 * sizeof(void*),
          "real environment retains the pinned ART thread and VM prefix");
  Require(Real(&real) == &real && !IsGuestEnv(&real),
          "real ART boundary is neither unwrapped nor classified as guest");
  ProxyEnv proxy = NewProxy<ProxyEnv>(g_env_table, false);
  ProxyEnv guest = NewProxy<ProxyEnv>(g_env_table_guest, true);
  proxy.real = &real; guest.real = &real;
  std::array<void*, kEnvSlots> host_copy{}, guest_copy{};
  std::memcpy(host_copy.data(), g_env_table, sizeof(g_env_table));
  std::memcpy(guest_copy.data(), g_env_table_guest, sizeof(g_env_table_guest));
  proxy.functions = host_copy.data(); guest.functions = guest_copy.data();
  Require(Real(reinterpret_cast<JNIEnv*>(&proxy)) == &real,
          "copied host proxy table retains the real association");
  Require(Real(reinterpret_cast<JNIEnv*>(&guest)) == &real,
          "copied guest proxy table retains the real association");
  Require(!IsGuestEnv(reinterpret_cast<JNIEnv*>(&proxy)) && IsGuestEnv(reinterpret_cast<JNIEnv*>(&guest)),
          "copied tables retain distinct host and guest identity");
  proxy.functions = g_env_table; guest.functions = g_env_table_guest;
  Require(Real(reinterpret_cast<JNIEnv*>(&proxy)) == &real &&
              Real(reinterpret_cast<JNIEnv*>(&guest)) == &real &&
              !IsGuestEnv(reinterpret_cast<JNIEnv*>(&proxy)) && IsGuestEnv(reinterpret_cast<JNIEnv*>(&guest)),
          "restored tables retain both real associations and guest identity");
  Require(Real(nullptr) == nullptr && !IsGuestEnv(nullptr), "null environment is not a proxy");
  Require(real.self_ == &thread && real.vm_ == &vm && thread.state == 0x5678 && vm.state == 0x9abc,
          "identity checks preserve real thread and VM state");
}

void WriteShell(const Elf64_Ehdr& header, size_t size = sizeof(Elf64_Ehdr)) {
  std::FILE* file = std::fopen("libexec.so", "wb");
  Require(file != nullptr, "fixture shell file");
  Require(std::fwrite(&header, 1, size, file) == size, "fixture shell header");
  Require(std::fclose(file) == 0, "fixture shell close");
}

int main(int argc, char** argv) {
  if (argc != 2) return 2;
  const std::string scenario = argv[1];
  g_failure = scenario;
  auto* dos = reinterpret_cast<IMAGE_DOS_HEADER*>(g_image);
  dos->e_lfanew = 64;
  reinterpret_cast<IMAGE_NT_HEADERS64*>(g_image + 64)->OptionalHeader.SizeOfImage = sizeof(g_image);
  g_real.entries[1] = reinterpret_cast<void*>(&MsInteger); // no System V counterpart
  g_env_table[2] = reinterpret_cast<void*>(&SysvInteger); // no Microsoft counterpart
  g_real.entries[4] = reinterpret_cast<void*>(&MsInteger);
  g_real.entries[5] = reinterpret_cast<void*>(&MsFloating);
  g_real.entries[6] = reinterpret_cast<void*>(&VectorCount);
  g_env_table[4] = reinterpret_cast<void*>(&SysvInteger);
  g_env_table[5] = reinterpret_cast<void*>(&SysvFloating);
  g_env_table[6] = reinterpret_cast<void*>(&VectorCount);
  Elf64_Ehdr shell{};
  std::memcpy(shell.e_ident, ELFMAG, SELFMAG);
  shell.e_ident[EI_CLASS] = ELFCLASS64;
  shell.e_ident[EI_DATA] = ELFDATA2LSB;
  shell.e_machine = EM_X86_64;
  shell.e_type = ET_DYN;
  if (scenario == "architecture") {
    for (int variant = 0; variant < 6; ++variant) {
      Elf64_Ehdr unsupported = shell;
      if (variant == 0) unsupported.e_machine = EM_AARCH64;
      if (variant == 1) unsupported.e_ident[EI_CLASS] = ELFCLASS32;
      if (variant == 2) unsupported.e_ident[EI_DATA] = ELFDATA2MSB;
      if (variant == 3) unsupported.e_ident[0] = 0;
      if (variant == 4) unsupported.e_type = ET_EXEC;
      WriteShell(unsupported, variant == 5 ? sizeof(unsupported) - 1 : sizeof(unsupported));
      LoadArtShimFor("libexec.so");
      Require(g_live.empty() && ReadHook() == nullptr,
              variant == 0 ? "ARM64 shell leaves runtime unchanged before constructors"
                           : "unsupported shell leaves runtime unchanged before constructors");
    }
    Require(std::remove("libexec.so") == 0, "fixture unsupported shell removed");
    LoadArtShimFor("libexec.so");
    Require(g_live.empty() && ReadHook() == nullptr, "missing shell leaves runtime unchanged");
  }
  WriteShell(shell);
  LoadArtShimFor("ordinary.so");
  Require(g_live.empty() && ReadHook() == nullptr, "ordinary library leaves runtime unchanged");
  Require(setenv("GESHER_ART_SHIM", "0", 1) == 0, "fixture disables shim");
  LoadArtShimFor("libexec.so");
  Require(g_live.empty() && ReadHook() == nullptr, "disabled shim leaves runtime unchanged");
  unsetenv("GESHER_ART_SHIM");
  if (scenario != "success" && scenario != "concurrent" && scenario != "architecture" &&
      scenario != "proxy-identity") {
    LoadArtShimFor("libexec.so");
    Require(g_override == nullptr && ReadHook() == nullptr && g_live.empty(),
            "failed setup neither publishes nor leaks");
    g_failure.clear();
  }
  if (scenario == "concurrent") {
    std::vector<std::thread> threads;
    std::atomic<bool> ready{false};
    for (int i = 0; i < 16; ++i) threads.emplace_back([&] {
      while (!ready.load(std::memory_order_acquire)) std::this_thread::yield();
      LoadArtShimFor("libexec.so");
      Require(ReadHook() != nullptr && g_override != nullptr, "concurrent hook sees prepared table");
    });
    ready.store(true, std::memory_order_release);
    for (auto& thread : threads) thread.join();
  } else {
    LoadArtShimFor("libexec.so");
  }
  Require(ReadHook() == reinterpret_cast<void*>(&HookEntry) && g_publications == 1 &&
              g_live.size() == 2, "successful setup publishes once, including after failure");
  const int allocations = g_allocations;
  LoadArtShimFor("libexec.so");
  Require(g_allocations == allocations && g_publications == 1, "repeated setup reuses table");
  CheckDispatch();
  if (scenario == "proxy-identity") CheckProxyIdentity();
  Require(std::remove("libexec.so") == 0, "fixture shell removed");
  while (!g_live.empty()) VirtualFree(g_live.begin()->first, 0, MEM_RELEASE);
  std::printf("PASS ART JNI %s: publication, cleanup, retry, proxies and both ABIs\n", scenario.c_str());
}
