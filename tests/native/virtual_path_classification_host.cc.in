static thread_local bool counting = false;
static thread_local size_t allocations = 0, allocated_bytes = 0;
void* operator new(size_t size) {
  void* result = std::malloc(size ? size : 1);
  if (!result) std::abort();
  if (counting) { ++allocations; allocated_bytes += size; }
  return result;
}
void* operator new[](size_t size) { return ::operator new(size); }
void operator delete(void* value) noexcept { std::free(value); }
void operator delete[](void* value) noexcept { std::free(value); }
void operator delete(void* value, size_t) noexcept { std::free(value); }
void operator delete[](void* value, size_t) noexcept { std::free(value); }

@PATH_KIND@
#ifdef _WIN32
@WIDEN@
#else
static std::wstring Widen(const char* value) {
  std::wstring result;
  for (; *value; ++value) result += static_cast<unsigned char>(*value);
  return result;
}
#endif
static thread_local bool binder_exists = false;
static thread_local size_t binder_queries = 0;
static bool BinderDeviceExists() { ++binder_queries; return binder_exists; }

// The changed font suffix traversal is real; installation/environment lookup
// and final Win32 path publication are explicit, unchanged boundaries.
struct NativeFontFiles { std::string xml, directory; };
static thread_local bool fonts_available = true;
static NativeFontFiles SystemFontFiles() {
  return fonts_available ? NativeFontFiles{"C:/runtime/fonts/fonts.xml", "C:/runtime/fonts"} : NativeFontFiles{};
}
namespace unc_paths {
enum class Match { kInvalid, kUnrelated };
static Match ToWindows(const std::wstring&, std::wstring*) { return Match::kUnrelated; }
}
static bool DrivePath(const char*, std::wstring*) { return false; }
namespace reserved_names { static void Encode(std::wstring*) {} }
static void Lengthen(std::wstring*) {}

// Only attachment state is an explicit fixture boundary; the number conversion
// and canonical-name checks below come unchanged from the production header.
namespace usb_block {
@USB_BLOCK_HELPERS@
static thread_local bool attached = false;
[[maybe_unused]] static bool Attached() { return attached; }
}

@PRODUCTION@
@REFERENCE@

static size_t checks = 0;
static void Check(bool ok, const char* why) {
  ++checks;
  if (!ok) { std::fprintf(stderr, "virtual-path check %zu failed: %s\n", checks, why); std::exit(1); }
}

// Independent normalization: index the original string rather than consuming
// views; keep '..' and backslashes literally, as the virtual namespace does.
static std::vector<std::string> Components(const std::string& path) {
  std::vector<std::string> parts;
  for (size_t at = 0; at < path.size();) {
    if (path[at] == '/') { ++at; continue; }
    size_t end = at;
    while (end < path.size() && path[end] != '/') ++end;
    auto part = path.substr(at, end - at);
    if (part != ".") parts.push_back(std::move(part));
    at = end;
  }
  return parts;
}
struct Expected { PathKind kind; std::wstring name; size_t binder_queries; };
static Expected Oracle(const std::string& path, bool binder) {
  auto parts = Components(path);
  Expected expected{PathKind::kFile, L"X", 0};
  if (parts.empty()) return expected;
  std::string normalized;
  for (auto& part : parts) { if (!normalized.empty()) normalized += '/'; normalized += part; }
  if (parts.front() == "proc" || normalized == "etc/timezone" ||
      normalized == "sys/devices/system/cpu/possible" || normalized == "sys/devices/system/cpu/present" ||
      normalized == "sys/devices/system/cpu/online") {
    expected.kind = PathKind::kVirtual;
    expected.name = Widen(normalized.c_str());
  } else if (parts.front() == "dev" || parts.front() == "sys") {
    expected.kind = PathKind::kMissing;
    if (normalized == "dev/null") expected.kind = PathKind::kNull;
    else if (normalized == "dev/zero") expected.kind = PathKind::kZero;
    else if (normalized == "dev/random" || normalized == "dev/urandom") expected.kind = PathKind::kRandom;
    else if (normalized == "dev/binder") {
      expected.binder_queries = 1;
      if (binder) expected.kind = PathKind::kBinder;
    }
  }
  return expected;
}
static bool Matches(const std::string& path, bool binder) {
  auto expected = Oracle(path, binder);
  binder_exists = binder;
  binder_queries = 0;
  std::wstring actual = L"X";
  if (production::VirtualKind(path, &actual) != expected.kind || actual != expected.name ||
      binder_queries != expected.binder_queries) return false;
#if @HAS_REFERENCE@
  binder_queries = 0;
  std::wstring previous = L"X";
  if (reference::VirtualKind(path, &previous) != expected.kind || previous != expected.name ||
      binder_queries != expected.binder_queries) return false;
#endif
  return true;
}
static void Compare(const std::string& path) {
  for (bool binder : {false, true}) {
    if (!Matches(path, binder)) {
      std::fprintf(stderr, "path mismatch: [%s], binder=%d\n", path.c_str(), binder);
      Check(false, "oracle / previous-source differential");
    }
    ++checks;
  }
}
static uint32_t state = 0x923abc55;
static uint32_t Random() {
  state ^= state << 13; state ^= state >> 17; state ^= state << 5;
  return state;
}

static bool ReservedFontStem(std::string_view component) {
  std::string stem(component.substr(0, component.find('.')));
  for (auto& c : stem) if (c >= 'a' && c <= 'z') c = static_cast<char>(c - 'a' + 'A');
  for (const char* word : {"CON", "PRN", "AUX", "NUL", "CONIN$", "CONOUT$"}) if (stem == word) return true;
  for (const char* prefix : {"COM", "LPT"}) {
    for (const char* digit : {"1", "2", "3", "4", "5", "6", "7", "8", "9", "\xc2\xb9", "\xc2\xb2", "\xc2\xb3"}) {
      if (stem == std::string(prefix) + digit) return true;
    }
  }
  return false;
}

static std::pair<int, std::wstring> FontOracle(const std::string& path, bool available) {
  const auto unchanged = std::wstring(L"untouched");
  if (path == "/system/etc/fonts.xml")
    return available ? std::make_pair(1, Widen("C:/runtime/fonts/fonts.xml")) : std::make_pair(-1, unchanged);
  for (const char* invalid : {"/system/etc/fonts.xml/", "/system/etc/fonts.xml\\", "/system/etc/fonts.xml:"})
    if (path.find(invalid) == 0) return {-1, unchanged};
  constexpr std::string_view prefix = "/system/fonts";
  if (path.compare(0, prefix.size(), prefix) != 0) return {0, unchanged};
  const std::string suffix = path.substr(prefix.size());
  if (!suffix.empty() && suffix[0] != '/' && suffix[0] != '\\') return {0, unchanged};
  if (suffix.find('\\') != std::string::npos || suffix.find(':') != std::string::npos) return {-1, unchanged};
  for (const auto& component : Components(suffix)) {
    if (component.back() == '.' || component.back() == ' ' || ReservedFontStem(component)) return {-1, unchanged};
  }
  return available ? std::make_pair(1, Widen(("C:/runtime/fonts" + suffix).c_str())) : std::make_pair(-1, unchanged);
}

static void FontPaths() {
  std::vector<std::string> paths = {"", "/system/fonts", "/system/fonts/", "/system/fonts////", "/system/fonts/./a.ttf",
      "/system/fonts/../a.ttf", "/system/fonts-not-here/a.ttf", "/system/etc/fonts.xml", "/system/etc/fonts.xml/",
      "/system/etc/fonts.xml:stream", "/system/etc/fonts.xml\\a", "/system/fonts\\a.ttf", "/system/fonts/a:stream"};
  const char* components[] = {"", ".", "..", "a.ttf", "filename.", "file ", "NUL", "nul.ttf", "COM1.ttf", "LPT9",
                            "COM0.ttf", "conout$.ttf", "lpt\xc2\xb2.ttf", "\xd7\x90.ttf", "space name.ttf", "a\\b", "a:b"};
  for (const auto& first : components) for (const auto& second : components)
    paths.push_back(std::string("/system/fonts/") + first + '/' + second);
  for (size_t i = 0; i < 10000; ++i) {
    std::string path = "/system/fonts";
    for (size_t n = Random() % 12; n > 0; --n) path += std::string(Random() % 3 + 1, '/') + components[Random() % std::size(components)];
    paths.push_back(std::move(path));
  }
  for (bool available : {false, true}) {
    fonts_available = available;
    for (const auto& path : paths) {
      auto expected = FontOracle(path, available);
      std::wstring output = L"untouched";
      Check(production::SystemFontPath(path.c_str(), &output) == expected.first && output == expected.second,
            "font suffix validation and exact target suffix match independent oracle");
#if @HAS_REFERENCE@
      output = L"untouched";
      Check(reference::SystemFontPath(path.c_str(), &output) == expected.first && output == expected.second,
            "font suffix oracle agrees with upstream source");
#endif
    }
  }
}

static void BlockAliases() {
  // Exact device-number contract at each range edge; no disk or media is
  // created by the fixture. Actual node existence is checked when it is opened.
  for (const auto& [number, node] : std::array<std::pair<const char*, const char*>, 7>{{
      {"8:16", "sdb"}, {"8:17", "sdb1"}, {"8:30", "sdb14"}, {"8:31", "sdb15"},
      {"259:0", "sdb16"}, {"259:1", "sdb17"}, {"259:112", "sdb128"}}}) {
    Check(usb_block::NodeFromDeviceNumber(number) == node, "real device-number helper accepts canonical range edge");
    Check(usb_block::DeviceNumberName(node) == number, "real node-number helper returns canonical range edge");
  }
  for (const char* invalid : {"", ":", "8", "8:", ":16", "8:0", "8:15", "8:32", "259:113", "260:0",
      "08:16", "8:016", "259:00", "+8:16", "8:+16", "8:-16", "-8:16", "8:16:0", "8:16/size",
      " 8:16", "8:16 ", "4294967296:16", "8:4294967296", "259:999999999999999999999"}) {
    Check(usb_block::NodeFromDeviceNumber(invalid).empty(), "real device-number helper rejects malformed or foreign media identity");
  }
  for (const char* invalid : {"", "sda", "sdc", "sdb0", "sdb01", "sdb129", "sdb-1", "sdb+1", "sdb1/size",
      "sdb4294967296", "sdb999999999999999999999"}) {
    Check(usb_block::DeviceNumberName(invalid).empty(), "real node-number helper rejects noncanonical or unsupported nodes");
  }
  Check(usb_block::NodeFromDeviceNumber(std::string_view("8:16\0suffix", 11)).empty(), "device-number helper rejects embedded NUL suffix");

  struct Case { const char* path; const wchar_t* name; };
  const Case paths[] = {
      {"/dev/block", L"dev/block"}, {"/dev/block/sdb", L"dev/block/sdb"},
      {"/dev/block/sdb128", L"dev/block/sdb128"}, {"/sys/dev/block", L"sys/dev/block"},
      {"/sys/dev/block/8:16", L"sys/dev/block/8:16"}, {"/sys/dev/block/8:17", L"sys/dev/block/8:17"},
      {"/sys/dev/block/259:0", L"sys/dev/block/259:0"}, {"/sys/dev/block/259:112", L"sys/dev/block/259:112"},
      {"/sys/dev/block/8:16//./size", L"sys/block/sdb/size"},
      {"/sys/dev/block/8:17/../size", L"sys/block/sdb/size"},
      {"/sys/dev/block/259:0/../size", L"sys/block/sdb/size"},
      {"/sys/dev/block/259:112/size", L"sys/block/sdb/sdb128/size"},
      {"/sys/block/sdb/sdb1/../size", L"sys/block/sdb/size"},
      {"/sys/devices/gesher/usb/sdb", L"sys/devices/gesher/usb/sdb"},
  };
  usb_block::attached = true;
  for (const auto& entry : paths) {
    std::wstring output = L"untouched";
    Check(production::VirtualKind(entry.path, &output) == PathKind::kVirtual && output == entry.name,
          "attached namespace resolves actual helper aliases and relative sysfs traversal");
  }
  for (const char* invalid : {"/sys/dev/block/8:15", "/sys/dev/block/8:32", "/sys/dev/block/259:113",
      "/sys/dev/block/08:16", "/sys/dev/block/8:016", "/sys/dev/block/8:16:0",
      "/dev/block/sda", "/dev/block/sdb0", "/dev/block/sdb01", "/dev/block/sdb1/extra"}) {
    std::wstring output = L"untouched";
    Check(production::VirtualKind(invalid, &output) == PathKind::kMissing && output == L"untouched",
          "attached namespace rejects malformed aliases without publishing a path");
  }
  usb_block::attached = false;
  for (const auto& entry : paths) {
    std::wstring output = L"untouched";
    Check(production::VirtualKind(entry.path, &output) == PathKind::kMissing && output == L"untouched",
          "detached namespace does not expose previous block aliases");
  }
}

static void Measurements(bool enforce) {
  constexpr size_t count = 100000;
  const char* paths[] = {"/data/app/com.example.sample/lib/x86_64/libexample.so", "/dev/null",
                        "/sys/devices/system/cpu/unknown", "/etc/not-timezone", "/proc/self/status",
                        "/sys/dev/block/8:17/size", "/dev/block/sdb1"};
  for (const char* path : paths) {
    std::wstring output;
    allocations = allocated_bytes = 0;
    counting = true;
    for (size_t i = 0; i < count; ++i) {
      output.clear();
      (void)production::VirtualKind(path, &output);
    }
    counting = false;
    std::printf("classification [%s]: %zu calls, %zu allocations / %zu bytes\n", path, count, allocations, allocated_bytes);
    if (enforce && std::strncmp(path, "/proc", 5) != 0) Check(allocations == 0, "non-owning classification requires no heap scratch");
    // /proc still owns its normalized output; do not claim it is allocation-free.
  }
}
int main(int argc, char** argv) {
  const bool enforce = argc < 2 || std::strcmp(argv[1], "measure") != 0;
  const char* explicit_paths[] = {"", "/", "//", "/././", "/dev", "/dev/", "/dev/./null//.",
      "/dev/null/extra", "/dev/../null", "/DEV/null", "/dev/null\\", "/dev/binder", "/dev/binder/more",
      "/proc", "/proc/./self//status/", "/proc/../dev/null", "/etc/timezone", "/etc/./timezone/.",
      "/etc/timezone/other", "/etc/timezone..", "/sys/devices/system/cpu/possible",
      "/sys/devices/system/cpu/present", "/sys/devices/system/cpu/online",
      "/sys//devices/./system/cpu/./present/", "/sys//devices/./system/cpu/./online/", "/sys/devices/system/cpu/present/other",
      "/system/fonts/../font.ttf", "/proc/\xe0\xa4\x95/\xd7\x90", "/proc/\xf0\x9f\x98\x80", "/proc/\xff"};
  for (const char* path : explicit_paths) Compare(path);
  const char* roots[] = {"", "dev", "proc", "sys", "etc", "data", "system", "mnt", "..", "."};
  const char* pieces[] = {"", ".", "..", "null", "zero", "random", "urandom", "binder", "devices", "system",
                          "cpu", "possible", "present", "online", "timezone", "self", "status", "a\\b", "a:b", "file", "\xd7\x90"};
  for (const char* root : roots) {
    for (const char* first : pieces) for (const char* second : pieces) for (const char* third : pieces)
      Compare(std::string("/") + root + '/' + first + '/' + second + '/' + third);
  }
  for (size_t sample = 0; sample < 50000; ++sample) {
    std::string path = std::string("/") + roots[Random() % std::size(roots)];
    for (size_t i = Random() % 20; i; --i) path += std::string(Random() % 2 + 1, '/') + pieces[Random() % std::size(pieces)];
    Compare(path);
  }
  for (const char* root : roots) {
    std::string path = "/";
    path += root;
    for (size_t i = 0; i < 4096; ++i) path += i % 3 == 0 ? "/./" : "/segment";
    Compare(path);
  }
  std::atomic<bool> parallel_ok{true};
  std::array<std::thread, 6> workers;
  for (size_t i = 0; i < workers.size(); ++i) workers[i] = std::thread([&, i] {
    for (size_t j = 0; j < 10000; ++j)
      if (!Matches(explicit_paths[(i + j) % std::size(explicit_paths)], (j & 1) != 0)) parallel_ok = false;
  });
  for (auto& worker : workers) worker.join();
  Check(parallel_ok, "concurrent callers retain independent path/output/Binder state");
  FontPaths();
  BlockAliases();
  Measurements(enforce);
  std::printf("PASS virtual-path classification: %zu checks plus 60000 concurrent samples\n", checks);
}
