// Exact production OFD/launch code follows a declared OS boundary. Linux
// kernel files, shared sections and spawned children remain real resources.
#include <algorithm>
#include <array>
#include <atomic>
#include <cerrno>
#include <climits>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <charconv>
#include <cwchar>
