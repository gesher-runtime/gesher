// Production timer core, guest adapters and event registry, with explicit host
// replacements for Win32 clocks/threadpool/events and CRT fd allocation only.
// The controlled threadpool can leave an admitted callback pending after
// disable, as Windows does. No test accesses a destroyed native object.
#include <algorithm>
#include <atomic>
#include <chrono>
#include <condition_variable>
#include <cstdint>
#include <cstdio>
#include <cstring>
#include <future>
#include <limits>
#include <map>
#include <memory>
#include <mutex>
#include <set>
#include <string>
#include <thread>
#include <unordered_map>
#include <vector>
#include <cerrno>
#include <poll.h>
#include <sys/eventfd.h>
#include <gesher/timerfd.h>

using DWORD = uint32_t;
using VOID = void;
using PVOID = void*;
using PTP_CALLBACK_INSTANCE = void*;
#define CALLBACK
#define TRUE 1
#define FALSE 0
#define BIONIC_SYSV
struct LARGE_INTEGER { int64_t QuadPart; };
struct FILETIME { DWORD dwLowDateTime, dwHighDateTime; };
struct Event { std::atomic<bool> signaled{false}; };
using HANDLE = Event*;
#define INVALID_HANDLE_VALUE reinterpret_cast<HANDLE>(static_cast<intptr_t>(-1))

static std::atomic<int64_t> monotonic_ns{10000000000LL};
static std::atomic<int64_t> realtime_ns{1700000000000000000LL};
static int QueryPerformanceFrequency(LARGE_INTEGER* out) { out->QuadPart = 1000000000; return 1; }
static int QueryPerformanceCounter(LARGE_INTEGER* out) { out->QuadPart = monotonic_ns; return 1; }
[[maybe_unused]] static void GetSystemTimePreciseAsFileTime(FILETIME* out) {
  const uint64_t ticks = static_cast<uint64_t>(realtime_ns.load() / 100 + 116444736000000000LL);
  *out = {static_cast<DWORD>(ticks), static_cast<DWORD>(ticks >> 32)};
}
static HANDLE CreateEventW(void*, int, int initial, void*) {
  auto* result = new Event; result->signaled = initial != 0; return result;
}
static void SetEvent(HANDLE event) { event->signaled = true; }
static void ResetEvent(HANDLE event) { event->signaled = false; }
static void CloseHandle(HANDLE event) { delete event; }

struct ThreadpoolTimer;
using PTP_TIMER = ThreadpoolTimer*;
using TimerCallback = void(*)(PTP_CALLBACK_INSTANCE, PVOID, PTP_TIMER);
struct ThreadpoolTimer {
  TimerCallback callback;
  void* context;
  std::mutex mutex;
  std::condition_variable changed;
  int active = 0;
  bool armed = false;
  bool hold_callback = false;
  bool callback_admitted = false;
  bool waiter_entered = false;
  int64_t due = 0;
  DWORD period = 0;
};
static std::mutex timers_mutex;
static std::set<PTP_TIMER> timers;
static PTP_TIMER latest_timer;
static std::atomic<int> created{0}, destroyed{0};
static PTP_TIMER CreateThreadpoolTimer(TimerCallback callback, void* context, void*) {
  auto* timer = new ThreadpoolTimer{callback, context, {}, {}, 0, false, false, false, false, 0, 0};
  std::lock_guard<std::mutex> lock(timers_mutex);
  timers.insert(timer); latest_timer = timer; ++created; return timer;
}
static void SetThreadpoolTimer(PTP_TIMER timer, const FILETIME* due, DWORD period, DWORD) {
  std::lock_guard<std::mutex> lock(timer->mutex);
  timer->armed = due != nullptr;
  if (due) {
    uint64_t bits = static_cast<uint64_t>(due->dwHighDateTime) << 32 | due->dwLowDateTime;
    std::memcpy(&timer->due, &bits, sizeof(bits));
  }
  timer->period = period;
  // Deliberately leave an admitted callback active on disable.
}
static void WaitForThreadpoolTimerCallbacks(PTP_TIMER timer, int) {
  std::unique_lock<std::mutex> lock(timer->mutex);
  timer->waiter_entered = true; timer->changed.notify_all();
  timer->changed.wait(lock, [&] { return timer->active == 0; });
}
static void CloseThreadpoolTimer(PTP_TIMER timer) {
  { std::lock_guard<std::mutex> lock(timers_mutex); timers.erase(timer); ++destroyed; }
  delete timer;
}
static void Fire(PTP_TIMER timer) {
  {
    std::unique_lock<std::mutex> lock(timer->mutex);
    ++timer->active; timer->callback_admitted = true; timer->changed.notify_all();
    timer->changed.wait(lock, [&] { return !timer->hold_callback; });
  }
  timer->callback(nullptr, timer->context, timer);
  { std::lock_guard<std::mutex> lock(timer->mutex); --timer->active; timer->changed.notify_all(); }
}
static bool WaitCallback(PTP_TIMER timer) {
  std::unique_lock<std::mutex> lock(timer->mutex);
  return timer->changed.wait_for(lock, std::chrono::seconds(2), [&] { return timer->callback_admitted; });
}
static bool WaitQuiescence(PTP_TIMER timer) {
  std::unique_lock<std::mutex> lock(timer->mutex);
  return timer->changed.wait_for(lock, std::chrono::milliseconds(200), [&] { return timer->waiter_entered; });
}
static void ReleaseCallback(PTP_TIMER timer) {
  std::lock_guard<std::mutex> lock(timer->mutex);
  timer->hold_callback = false; timer->changed.notify_all();
}

namespace gesher {
namespace record_locks {
static std::recursive_mutex descriptors;
struct DescriptorGuard {
  DescriptorGuard() { descriptors.lock(); }
  ~DescriptorGuard() { descriptors.unlock(); }
};
}
static std::set<int> allocated;
int ReserveFd() {
  record_locks::DescriptorGuard guard;
  int fd = 10; while (allocated.count(fd)) ++fd;
  allocated.insert(fd); return fd;
}
HANDLE HandleFromFd(int fd) {
  record_locks::DescriptorGuard guard;
  return allocated.count(fd) ? reinterpret_cast<HANDLE>(static_cast<intptr_t>(fd)) : INVALID_HANDLE_VALUE;
}
int FailWithLastError() { return errno = ENOMEM, -1; }
void WakePollers() {}
struct Inotify {};
int ReadInotify(Inotify&, void*, unsigned int) { return errno = EINVAL, -1; }
struct TimerFd;
struct EventFd;
int ReadTimerFd(TimerFd&, void*, unsigned int);
std::shared_ptr<TimerFd> LookupTimerFd(int);
int RegisterTimerFd(std::shared_ptr<TimerFd>, std::shared_ptr<EventFd>);
@EVENT_FD@
namespace {
struct Epoll {};
@OBJECT_REGISTRY@
@OBJECT_LOOKUP@
@OBJECT_INSERT@
@EVENT_IO@
}
@OBJECT_OPERATIONS@
}

namespace host_event {
using gesher::EventFd;
@EVENT_CREATE@
}

static int Close(int fd) {
  gesher::record_locks::DescriptorGuard guard;
  if (!gesher::allocated.count(fd)) return errno = EBADF, -1;
  gesher::ForgetEventObject(fd); gesher::allocated.erase(fd); return 0;
}
static int Duplicate(int fd, int target = -1) {
  gesher::record_locks::DescriptorGuard guard;
  if (!gesher::allocated.count(fd)) return errno = EBADF, -1;
  if (target == fd) return target;
  if (target < 0) target = gesher::ReserveFd();
  else { gesher::ForgetEventObject(target); gesher::allocated.insert(target); }
  gesher::DupEventObject(fd, target); return target;
}
static int Read(int fd, void* buffer, unsigned int count) {
  int result = -1;
  return gesher::ReadEventObject(fd, buffer, count, &result) ? result : (errno = EBADF, -1);
}
static int Write(int fd, const void* buffer, unsigned int count) {
  int result = -1;
  return gesher::WriteEventObject(fd, buffer, count, &result) ? result : (errno = EBADF, -1);
}
static short Poll(int fd, short events) {
  auto ready = gesher::LookupEventFd(fd);
  return ready ? gesher::PollEventFd(*ready, events, nullptr) : POLLNVAL;
}

@TIMER_CORE@

namespace gesher::bionic {
using LinuxTimespec = gesher::TimerFdTime;
namespace {
[[maybe_unused]] constexpr int kEBADF = EBADF, kEINVAL = EINVAL, kEFAULT = EFAULT, kENOMEM = ENOMEM;
[[maybe_unused]] LinuxTimespec RealtimeNow() {
  return {realtime_ns.load() / 1000000000, realtime_ns.load() % 1000000000};
}
[[maybe_unused]] int eventfd(unsigned initial, int flags) { return host_event::eventfd(initial, flags); }
[[maybe_unused]] int eventfd_write(int fd, uint64_t value) { return Write(fd, &value, sizeof(value)) == 8 ? 0 : -1; }
[[maybe_unused]] int close(int fd) { return Close(fd); }
@TIMER_ADAPTER@
}
@TIMER_DISPATCH@
}

using Spec = gesher::TimerFdSpec;
static int Create(int clock = 1, int flags = 04000) {
  int64_t value = -2;
  gesher::bionic::DispatchTimerfdSyscall(283, clock, flags, 0, 0, &value);
  return static_cast<int>(value);
}
static int Get(int fd, Spec* spec) {
  int64_t value = -2;
  gesher::bionic::DispatchTimerfdSyscall(287, fd, reinterpret_cast<int64_t>(spec), 0, 0, &value);
  return static_cast<int>(value);
}
static int Set(int fd, int flags, const Spec* spec, Spec* previous = nullptr) {
  int64_t value = -2;
  gesher::bionic::DispatchTimerfdSyscall(286, fd, flags, reinterpret_cast<int64_t>(spec),
                                      reinterpret_cast<int64_t>(previous), &value);
  return static_cast<int>(value);
}
static int assertions, failures;
static void Check(const char* what, bool ok) {
  ++assertions;
  if (!ok) { ++failures; std::printf("FAIL: %s (errno %d)\n", what, errno); }
}

static void Ownership() {
  int before = destroyed;
  int fd = Create(); Check("create", fd >= 0);
  auto native = latest_timer;
  int alias = Duplicate(fd); Spec current{}, old{};
  Check("alias gettime", Get(alias, &current) == 0);
  Spec arm{{1, 0}, {2, 0}};
  Check("alias settime", Set(alias, 0, &arm, &old) == 0);
  Check("old shared state disarmed", old.it_value.tv_sec == 0 && old.it_value.tv_nsec == 0);
  Check("original sees alias setting", Get(fd, &current) == 0 && current.it_interval.tv_sec == 1 &&
                                        current.it_value.tv_sec == 2);
  Check("close original", Close(fd) == 0);
  Check("surviving alias retains timer", destroyed == before && Get(alias, &current) == 0);
  errno = 0; Check("closed fd is EBADF", Get(fd, &current) == -1 && errno == EBADF);
  int replacement = gesher::ReserveFd(); Check("reuse same fd number", replacement == fd);
  errno = 0; Check("reused ordinary fd is EINVAL", Get(replacement, &current) == -1 && errno == EINVAL);
  errno = 0; Check("settime rejects reused ordinary fd", Set(replacement, 0, &arm) == -1 && errno == EINVAL);
  monotonic_ns += 2000000000LL; Fire(native);
  uint64_t ticks = 0;
  Check("original callback delivers to surviving alias", Read(alias, &ticks, sizeof(ticks)) == 8 && ticks >= 1);
  Check("callback does not turn replacement into event", Poll(replacement, POLLIN) == POLLNVAL);
  Close(replacement); Close(alias);
  Check("last alias releases one timer", destroyed == before + 1);

  before = destroyed;
  int first = Create(), second = Create();
  Check("dup2 replaces timer with shared source", Duplicate(first, second) == second);
  Check("dup2 retires replaced timer", destroyed == before + 1);
  Close(first); Check("dup2 alias remains usable", Get(second, &current) == 0);
  Close(second); Check("dup2 final alias retires source", destroyed == before + 2);
  first = Create(); int ordinary = gesher::ReserveFd(); before = destroyed;
  Check("dup2 ordinary replaces timer", Duplicate(ordinary, first) == first);
  Check("ordinary replacement retires timer", destroyed == before + 1);
  errno = 0; Check("ordinary replacement is not a timer", Get(first, &current) == -1 && errno == EINVAL);
  Close(first); Close(ordinary);
}

static void Contracts() {
  const int fd = Create(); auto native = latest_timer; uint64_t ticks = 0;
  Check("unarmed timer is neither readable nor writable", Poll(fd, POLLIN | POLLOUT) == 0);
  errno = 0; Check("timer write rejected", Write(fd, &ticks, sizeof(ticks)) == -1 && errno == EINVAL);
  errno = 0; Check("short read rejected before wait", Read(fd, &ticks, 7) == -1 && errno == EINVAL);
  errno = 0; Check("empty nonblocking read", Read(fd, &ticks, 8) == -1 && errno == EAGAIN);
  Spec arm{{0, 0}, {0, 1000}}, current{}, previous{};
  Check("arm one shot", Set(fd, 0, &arm) == 0);
  monotonic_ns += 1000; Fire(native);
  Check("expired timer readable only", Poll(fd, POLLIN | POLLOUT) == POLLIN);
  Spec disarm{};
  Check("disarm clears unread expiration", Set(fd, 0, &disarm) == 0 && Poll(fd, POLLIN) == 0);
  errno = 0; Check("read after disarm does not consume stale ticks", Read(fd, &ticks, 8) == -1 && errno == EAGAIN);
  Set(fd, 0, &arm); monotonic_ns += 1000; Fire(native);
  arm.it_value = {3, 0};
  Check("rearm clears unread expiration", Set(fd, 0, &arm) == 0 && Poll(fd, POLLIN) == 0);
  errno = 0; Check("read after rearm is empty", Read(fd, &ticks, 8) == -1 && errno == EAGAIN);
  arm.it_interval = {7, 0}; arm.it_value = {0, 0};
  Check("disarm preserves requested interval", Set(fd, 0, &arm) == 0 && Get(fd, &current) == 0 &&
                                               current.it_interval.tv_sec == 7 && current.it_value.tv_sec == 0);
  Check("ignored monotonic cancellation flag accepted", Set(fd, 2, &disarm) == 0);
  Check("ignored monotonic absolute cancellation flag accepted", Set(fd, 3, &disarm) == 0);
  errno = 0; Check("raw monotonic clock rejected", Create(4) == -1 && errno == EINVAL);
  errno = 0; Check("bad create flags rejected", Create(1, 1) == -1 && errno == EINVAL);
  arm = {{2, 0}, {3, 0}}; Set(fd, 0, &arm);
  Spec invalid = arm; invalid.it_value.tv_sec = -1;
  errno = 0; Check("negative value seconds rejected", Set(fd, 0, &invalid) == -1 && errno == EINVAL);
  invalid = arm; invalid.it_interval.tv_sec = -1;
  errno = 0; Check("negative interval seconds rejected", Set(fd, 0, &invalid) == -1 && errno == EINVAL);
  invalid = arm; invalid.it_value.tv_nsec = 1000000000;
  errno = 0; Check("invalid value nanoseconds rejected", Set(fd, 0, &invalid) == -1 && errno == EINVAL);
  invalid = arm; invalid.it_interval.tv_nsec = -1;
  errno = 0; Check("invalid interval nanoseconds rejected", Set(fd, 0, &invalid) == -1 && errno == EINVAL);
  errno = 0; Check("bad settime flags rejected", Set(fd, 4, &arm) == -1 && errno == EINVAL);
  Check("invalid setters preserve schedule", Get(fd, &current) == 0 && current.it_value.tv_sec == 3 &&
                                            current.it_interval.tv_sec == 2);
  Spec replace{{5, 0}, {6, 0}};
  Check("old value captured with replacement", Set(fd, 0, &replace, &previous) == 0 &&
              previous.it_interval.tv_sec == 2 && previous.it_value.tv_sec == 3);
  Check("new setting visible after replacement", Get(fd, &current) == 0 && current.it_interval.tv_sec == 5 &&
                                                current.it_value.tv_sec == 6);
  Spec aliased{{9, 0}, {8, 0}};
  Check("new and old pointers may alias", Set(fd, 0, &aliased, &aliased) == 0 &&
            aliased.it_interval.tv_sec == 5 && Get(fd, &current) == 0 && current.it_interval.tv_sec == 9 &&
            current.it_value.tv_sec == 8);
  Close(fd);
}

static void Deadlines() {
  const int fd = Create(); auto native = latest_timer; Spec value{{0, 10}, {0, 10}}, current{};
  Check("sub-millisecond periodic arm", Set(fd, 0, &value) == 0);
  monotonic_ns += 45; Fire(native); uint64_t ticks = 0;
  Check("delayed callback counts elapsed periods", Read(fd, &ticks, 8) == 8 && ticks == 4);
  Check("periodic gettime returns next deadline", Get(fd, &current) == 0 && current.it_value.tv_sec == 0 &&
                                               current.it_value.tv_nsec == 5);
  Check("backend uses one shot instead of rounded millisecond period", native->period == 0);
  monotonic_ns += 30;
  Check("gettime forwards unprocessed periodic deadline", Get(fd, &current) == 0 && current.it_value.tv_nsec == 5);
  Check("gettime preserves elapsed ticks for read", Read(fd, &ticks, 8) == 8 && ticks == 3);
  Fire(native);
  errno = 0; Check("late callback cannot double count forwarded ticks", Read(fd, &ticks, 8) == -1 && errno == EAGAIN);
  value = {{0, 0}, {monotonic_ns / 1000000000, monotonic_ns % 1000000000 - 1}};
  if (value.it_value.tv_nsec < 0) { --value.it_value.tv_sec; value.it_value.tv_nsec += 1000000000; }
  Check("absolute expired deadline accepted", Set(fd, 1, &value) == 0);
  Fire(native);
  Check("absolute expired one shot read once", Read(fd, &ticks, 8) == 8 && ticks == 1);
  Check("absolute one shot disarmed afterwards", Get(fd, &current) == 0 && current.it_value.tv_sec == 0 &&
                                                current.it_value.tv_nsec == 0);
  value = {{std::numeric_limits<int64_t>::max(), 999999999},
           {std::numeric_limits<int64_t>::max(), 999999999}};
  Check("large valid times are accepted without overflow", Set(fd, 0, &value) == 0);
  const int64_t max = std::numeric_limits<int64_t>::max();
  Check("large interval saturates like Linux ktime", Get(fd, &current) == 0 &&
        current.it_interval.tv_sec == max / 1000000000 && current.it_interval.tv_nsec == max % 1000000000);
  Check("large duration remains in future", current.it_value.tv_sec > 8000000000LL && native->due < 0);
  value = {{max / 1000000000, 0}, {0, 0}};
  Check("Linux final-second saturation threshold", Set(fd, 0, &value) == 0 && Get(fd, &current) == 0 &&
        current.it_interval.tv_sec == max / 1000000000 && current.it_interval.tv_nsec == max % 1000000000);
  Close(fd);

  const int real = Create(0); auto real_native = latest_timer;
  value = {{0, 0}, {2, 0}}; Set(real, 0, &value); realtime_ns += 100000000000LL;
  Check("relative realtime uses elapsed time, not wall jumps", Get(real, &current) == 0 && current.it_value.tv_sec == 2);
  Check("relative realtime CANCEL_ON_SET is ignored", Set(real, 2, &value) == 0);
  value.it_value = {realtime_ns / 1000000000 + 2, realtime_ns % 1000000000};
  Check("absolute realtime accepted", Set(real, 1, &value) == 0);
  Check("absolute realtime uses absolute FILETIME", real_native->due > 0);
  realtime_ns += 3000000000LL; Fire(real_native);
  Check("absolute realtime tracks advanced wall clock", Read(real, &ticks, 8) == 8 && ticks == 1);
  value = {{4, 0}, {realtime_ns / 1000000000 + 2, 0}}; Set(real, 1, &value);
  errno = 0;
  Check("unsupported realtime cancellation is explicit", Set(real, 3, &value) == -1 && errno == EOPNOTSUPP);
  Check("rejected realtime cancellation preserves setting", Get(real, &current) == 0 &&
        current.it_interval.tv_sec == 4 && current.it_value.tv_sec == 2);
  Close(real);
}

static void Quiescence() {
  int fd = Create(); auto native = latest_timer;
  Spec arm{{0, 100}, {0, 100}}; Set(fd, 0, &arm);
  { std::lock_guard<std::mutex> lock(native->mutex); native->hold_callback = true; native->waiter_entered = false; }
  monotonic_ns += 100;
  std::thread callback([&] { Fire(native); });
  Check("old callback admitted", WaitCallback(native));
  Spec later{{0, 0}, {10, 0}}; std::atomic<bool> finished{false};
  std::thread setter([&] { Set(fd, 0, &later); finished = true; });
  const bool waited = WaitQuiescence(native);
  Check("rearm joins admitted old callback", waited && !finished);
  ReleaseCallback(native); callback.join(); setter.join();
  uint64_t ticks = 0; Spec current{};
  Check("stale callback cannot publish after rearm", Read(fd, &ticks, 8) == -1 && errno == EAGAIN);
  Check("stale callback cannot change next setting", Get(fd, &current) == 0 && current.it_value.tv_sec == 10);
  Set(fd, 0, &arm);
  { std::lock_guard<std::mutex> lock(native->mutex);
    native->hold_callback = true; native->waiter_entered = false; native->callback_admitted = false; }
  monotonic_ns += 100;
  std::thread disarm_callback([&] { Fire(native); });
  Check("callback admitted before disarm", WaitCallback(native));
  Spec disarm{}; finished = false;
  std::thread disarmer([&] { Set(fd, 0, &disarm); finished = true; });
  const bool disarm_waited = WaitQuiescence(native);
  Check("disarm joins admitted callback", disarm_waited && !finished);
  ReleaseCallback(native); disarm_callback.join(); disarmer.join();
  errno = 0;
  Check("disarmed callback cannot restore readiness", Read(fd, &ticks, 8) == -1 && errno == EAGAIN && Poll(fd, POLLIN) == 0);
  Close(fd);

  fd = Create(); native = latest_timer; Set(fd, 0, &arm);
  { std::lock_guard<std::mutex> lock(native->mutex); native->hold_callback = true; native->waiter_entered = false; }
  std::thread closing_callback([&] { Fire(native); });
  Check("callback admitted before final close", WaitCallback(native));
  const int before = destroyed; finished = false;
  std::thread closer([&] { Close(fd); finished = true; });
  const bool close_waited = WaitQuiescence(native);
  Check("last close waits for admitted callback", close_waited && !finished && destroyed == before);
  // Registry readers must stay independent of the callback join; this checks
  // actual Object/ForgetEventObject destruction order, not a duplicate registry.
  auto lookup = std::async(std::launch::async, [&] { return gesher::LookupEventFd(fd) == nullptr; });
  const bool unlocked = lookup.wait_for(std::chrono::seconds(1)) == std::future_status::ready;
  Check("registry unlocked during callback quiescence", unlocked && lookup.get());
  ReleaseCallback(native); closing_callback.join(); closer.join();
  Check("last close releases after callback exit", destroyed == before + 1 && finished);
}

int main(int argc, char** argv) {
  const std::string group = argc > 1 ? argv[1] : "all";
  if (group == "all" || group == "ownership") Ownership();
  if (group == "all" || group == "contracts") Contracts();
  if (group == "all" || group == "deadlines") Deadlines();
  if (group == "all" || group == "quiescence") Quiescence();
  // The baseline's global map intentionally retains timers; clear it only after
  // recording lifetime assertions so the negative control itself cleans up.
@BASELINE_CLEANUP@
  std::printf("timerfd %s: %d assertions, %d failures\n", group.c_str(), assertions, failures);
  return failures ? 1 : 0;
}
