// Exact production functions are inserted below. Win32 storage calls are
// modeled with real Linux temporary files; this is not a Windows runtime.
#include <cerrno>
#include <cstdarg>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <cwchar>
