// Production sections are inserted unchanged. Windows device data, CRT path
// encoding and lock transactions are explicit host-only test boundaries.
#include <atomic>
#include <array>
#include <cerrno>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <cstdint>
#include <memory>
#include <mutex>
#include <new>
#include <stdexcept>
#include <string>
#include <unordered_map>
#include <unordered_set>
#include <fcntl.h>
#include <sys/stat.h>
#include <unistd.h>

static int checks, failures;
static void check(const char* name, int ok) {
  ++checks;
  if (!ok) { ++failures; std::fprintf(stderr, "FAIL: %s\n", name); }
}
static int stream_depth, descriptor_depth, transaction_error, close_mode, crt_calls;
struct StreamLock {
  explicit StreamLock(FILE*) { ++stream_depth; }
  ~StreamLock() { --stream_depth; }
};
using HANDLE = intptr_t;
constexpr HANDLE INVALID_HANDLE_VALUE = -1;
enum class PathKind { kFile, kNull, kMissing };
namespace gesher {
// Native registry is an explicit boundary; the inserted production stream
// retirement helper must remove it only when CRT really closes/replaces fd.
struct NativeFence {};
static std::unordered_map<int, std::shared_ptr<NativeFence>> fences;
static int fence_epoll_retirements;
static std::shared_ptr<NativeFence> LookupNativeFence(int fd) {
  auto found = fences.find(fd); return found == fences.end() ? nullptr : found->second;
}
static void ForgetNativeFence(int fd) {
  check("fence retirement stays under descriptor guard", descriptor_depth == 1);
  fences.erase(fd);
}
static void ForgetEpollEntries(int) {
  check("fence epoll retirement stays under descriptor guard", descriptor_depth == 1);
  ++fence_epoll_retirements;
}
// Seals/EA behavior is covered separately; this boundary records only the
// process-local memfd membership that CRT stream retirement must clear.
static std::unordered_set<int> memfds;
static bool IsRegisteredMemfd(int fd) { return memfds.count(fd) != 0; }
static void ForgetMemfd(int fd) {
  check("memfd retirement stays under descriptor guard", descriptor_depth == 1);
  memfds.erase(fd);
}
enum class Device { kZero, kRandom };
static HANDLE HandleFromFd(int fd) {
  check("device failure inspection stays under the descriptor guard", descriptor_depth == 1);
  return fcntl(fd, F_GETFD) < 0 ? INVALID_HANDLE_VALUE : fd + 1;
}
namespace {
std::mutex table_mutex;
@DEVICE_MAP@
}
@DEVICE_REGISTRATION@
PathKind MapPath(const char* path, std::wstring* out) {
  *out = std::wstring(path, path + std::strlen(path));
  return PathKind::kFile;
}
namespace record_locks {
class ClosingDescriptor {
 public:
  explicit ClosingDescriptor(int) : error_(transaction_error), calls_(crt_calls) {
    check("stream locks precede descriptor guards", stream_depth == 1 && descriptor_depth == 0);
    ++descriptor_depth;
  }
  ~ClosingDescriptor() {
    check("descriptor transaction completes or rejects before mutation",
          error_ || finished_ || calls_ == crt_calls);
    --descriptor_depth;
  }
  int Error() const { return error_; }
  int Finish(bool) {
    check("descriptor transaction completes once", !finished_ && descriptor_depth == 1);
    finished_ = true;
    return 0;
  }
 private:
  int error_;
  int calls_;
  bool finished_ = false;
};
}
}
static int _fileno(FILE* stream) { return fileno(stream); }
static int gesher_errno_from_crt(int error) { return error; }
static bool HasNonDirectoryParent(const std::wstring&) { return false; }
static int _fclose_nolock(FILE* stream) {
  ++crt_calls;
  check("CRT close stays under stream and descriptor guards", stream_depth == 1 && descriptor_depth == 1);
  if (close_mode == 2) return errno = EIO, EOF;  // Native close leaves fd live.
  int result = std::fclose(stream);
  return close_mode == 1 ? (errno = EIO, EOF) : result;  // A flush error can still close fd.
}
static FILE* _wfreopen(const wchar_t* path, const wchar_t* mode, FILE* stream) {
  ++crt_calls;
  check("CRT reopen stays under stream and descriptor guards", stream_depth == 1 && descriptor_depth == 1);
  std::wstring wide_path(path), wide_mode(mode);
  std::string narrow_path(wide_path.begin(), wide_path.end());
  std::string narrow_mode(wide_mode.begin(), wide_mode.end());
  for (char& option : narrow_mode) if (option == 'N') option = 'e';
  // glibc 2.39 closes the descriptor but leaves the FILE allocated after a
  // failed freopen. Model _wfreopen's failure using the real path error and
  // fclose to keep sanitizer findings attributable to the production wrapper.
  struct stat metadata{};
  if (stat(narrow_path.c_str(), &metadata) < 0 && errno == ENOTDIR) {
    check("failed CRT reopen closes the original stream", std::fclose(stream) == 0);
    errno = ENOTDIR;
    return nullptr;
  }
  return std::freopen(narrow_path.c_str(), narrow_mode.c_str(), stream);
}
namespace host {
@PARSE_MODE@
@FCLOSE@
@FREOPEN@
}
static int gesher_is_device_fd(int fd) {
  gesher::Device device;
  return gesher::DeviceFromFd(fd, &device);
}
namespace shim {
#define BIONIC_SYSV
constexpr int kENOMEM = ENOMEM;
static FILE* F(void* stream) { return static_cast<FILE*>(stream); }
static int read(int fd, void* buffer, unsigned int count) {
  gesher::Device device;
  if (gesher::DeviceFromFd(fd, &device)) {
    // Isolated Windows device-data boundary, with distinguishable bytes.
    std::memset(buffer, device == gesher::Device::kZero ? 0 : 0xa5, count);
    return static_cast<int>(count);
  }
  return static_cast<int>(::read(fd, buffer, count));
}
static size_t _fread_nolock(void* buffer, size_t size, size_t count, FILE* stream) {
  return std::fread(buffer, size, count, stream);
}
static int _getc_nolock(FILE* stream) { return getc_unlocked(stream); }
@STREAM_STATE@
@READ_STREAM@
@GETC_UNLOCKED@
@FREAD_UNLOCKED@
@FGETC@
@FREAD@
}
static FILE* DeviceOpen(const char* path, const char* mode) {
  FILE* stream = std::fopen(path, mode);
  if (stream && std::strcmp(path, "/dev/zero") == 0)
    gesher::RegisterDevice(fileno(stream), gesher::Device::kZero);
  if (stream && std::strcmp(path, "/dev/urandom") == 0)
    gesher::RegisterDevice(fileno(stream), gesher::Device::kRandom);
  return stream;
}
#define STREAM_DEVICE_FOPEN DeviceOpen
#define STREAM_DEVICE_FCLOSE host::fclose
#define STREAM_DEVICE_FREOPEN host::freopen
#define STREAM_DEVICE_FGETC shim::Fgetc
#define STREAM_DEVICE_FREAD shim::Fread
#include "stream_device_contract_test.inc"

static void test_failed_closes(void) {
  for (int mode : {1, 2}) {
    FILE* stream = DeviceOpen("/dev/zero", "rb");
    check("close error fixture opens", stream != nullptr);
    if (!stream) continue;
    int fd = fileno(stream);
    close_mode = mode;
    errno = 0;
    int result = host::fclose(stream);
    check("failed close preserves the CRT error", result == EOF && errno == EIO);
    check("device marker follows actual descriptor closure", gesher_is_device_fd(fd) == (mode == 2));
    close_mode = 0;
    if (mode == 2) host::fclose(stream);
  }
  FILE* stream = DeviceOpen("/dev/zero", "rb");
  check("rejected close fixture opens", stream != nullptr);
  if (!stream) return;
  int fd = fileno(stream);
  transaction_error = EBUSY;
  check("rejected close keeps its error and live device",
        host::fclose(stream) == EOF && errno == EBUSY && gesher_is_device_fd(fd));
  transaction_error = 0;
  check("null-path reopen retains the existing device identity",
        host::freopen(nullptr, "rb", stream) == stream && gesher_is_device_fd(fd));
  check("early rejected reopen closes and forgets the old device",
        host::freopen("unused", "", stream) == nullptr && errno == EINVAL && !gesher_is_device_fd(fd));

  stream = DeviceOpen("/dev/zero", "rb");
  check("device alias fixture opens", stream != nullptr);
  if (!stream) return;
  int alias = dup(fileno(stream));
  check("device alias fixture duplicates", alias >= 0);
  if (alias >= 0) gesher::RegisterDevice(alias, gesher::Device::kZero);
  host::fclose(stream);
  if (alias >= 0) {
    check("closing one device does not forget its live alias", gesher_is_device_fd(alias));
    FILE* aliased = fdopen(alias, "rb");
    check("device alias wraps in a stream", aliased != nullptr);
    if (aliased) host::fclose(aliased);
  }
}
static FILE* FenceOpen() {
  FILE* stream = std::fopen("/dev/null", "rb");
  if (stream) gesher::fences[fileno(stream)] = std::make_shared<gesher::NativeFence>();
  return stream;
}
static void test_fence_stream_lifetime() {
  for (int mode : {0, 1, 2}) {
    FILE* stream = FenceOpen();
    check("native fence stream fixture opens", stream != nullptr);
    if (!stream) continue;
    const int fd = fileno(stream), before = gesher::fence_epoll_retirements;
    std::weak_ptr<gesher::NativeFence> lifetime = gesher::LookupNativeFence(fd);
    close_mode = mode;
    const int result = host::fclose(stream);
    check("native fclose preserves CRT result", mode == 0 ? result == 0 : result == EOF && errno == EIO);
    check("native descriptor identity follows actual CRT closure", lifetime.expired() == (mode != 2));
    check("native epoll retirement occurs exactly on closure",
          gesher::fence_epoll_retirements == before + (mode != 2));
    close_mode = 0;
    if (mode == 2) host::fclose(stream);
  }
  FILE* stream = FenceOpen();
  check("native reopen fixture opens", stream != nullptr);
  if (stream) {
    const int fd = fileno(stream);
    FILE* reopened = host::freopen("/dev/null", "rb", stream);
    check("native reopen yields an ordinary stream", reopened != nullptr && !gesher::LookupNativeFence(fd));
    if (reopened) host::fclose(reopened);
  }
  stream = FenceOpen();
  check("native rejected reopen fixture opens", stream != nullptr);
  if (stream) {
    const int fd = fileno(stream);
    check("early rejected reopen consumes native ownership",
          host::freopen("unused", "", stream) == nullptr && errno == EINVAL && !gesher::LookupNativeFence(fd));
  }
  stream = FenceOpen();
  check("native stream alias fixture opens", stream != nullptr);
  if (stream) {
    const int fd = fileno(stream), alias = ::dup(fd);
    check("native stream alias duplicates", alias >= 0);
    if (alias >= 0) gesher::fences[alias] = gesher::LookupNativeFence(fd);
    host::fclose(stream);
    if (alias >= 0) {
      check("native stream alias retains its own identity", gesher::LookupNativeFence(alias) != nullptr);
      FILE* aliased = ::fdopen(alias, "rb");
      check("native alias wraps in a stream", aliased != nullptr);
      if (aliased) host::fclose(aliased);
    }
  }
  check("all native stream identities retired", gesher::fences.empty());
}
static FILE* MemfdOpen() {
  FILE* stream = std::tmpfile();
  if (stream) gesher::memfds.insert(fileno(stream));
  return stream;
}
static void test_memfd_stream_lifetime() {
  for (int mode : {0, 1, 2}) {
    FILE* stream = MemfdOpen();
    check("memfd stream fixture opens", stream != nullptr);
    if (!stream) continue;
    const int fd = fileno(stream);
    close_mode = mode;
    const int result = host::fclose(stream);
    check("memfd fclose preserves CRT result", mode == 0 ? result == 0 : result == EOF && errno == EIO);
    check("memfd membership follows actual CRT closure", gesher::IsRegisteredMemfd(fd) == (mode == 2));
    close_mode = 0;
    if (mode == 2) host::fclose(stream);
  }
  FILE* stream = MemfdOpen();
  check("memfd reopen fixture opens", stream != nullptr);
  if (stream) {
    const int fd = fileno(stream);
    check("null-path reopen retains memfd membership",
          host::freopen(nullptr, "rb", stream) == stream && gesher::IsRegisteredMemfd(fd));
    FILE* reopened = host::freopen("/dev/null", "rb", stream);
    check("memfd reopen clears old membership", reopened != nullptr && !gesher::IsRegisteredMemfd(fd));
    if (reopened) host::fclose(reopened);
  }
  stream = MemfdOpen();
  check("memfd rejected reopen fixture opens", stream != nullptr);
  if (stream) {
    const int fd = fileno(stream);
    check("early rejected reopen clears memfd membership",
          host::freopen("unused", "", stream) == nullptr && errno == EINVAL && !gesher::IsRegisteredMemfd(fd));
  }
  stream = MemfdOpen();
  check("memfd stream alias fixture opens", stream != nullptr);
  if (stream) {
    const int alias = ::dup(fileno(stream));
    check("memfd stream alias duplicates", alias >= 0);
    if (alias >= 0) gesher::memfds.insert(alias);
    host::fclose(stream);
    if (alias >= 0) {
      check("memfd stream alias retains its own membership", gesher::IsRegisteredMemfd(alias));
      FILE* aliased = ::fdopen(alias, "rb");
      check("memfd alias wraps in a stream", aliased != nullptr);
      if (aliased) host::fclose(aliased);
    }
  }
  check("all memfd stream memberships retired", gesher::memfds.empty());
}
int main() {
  test_stream_device_contracts();
  test_failed_closes();
  test_fence_stream_lifetime();
  test_memfd_stream_lifetime();
  check("all device markers and guards retire", gesher::device_count == 0 && stream_depth == 0 && descriptor_depth == 0);
  std::printf("stream devices production adapters: %d checks, %d failures\n", checks, failures);
  return failures != 0;
}
