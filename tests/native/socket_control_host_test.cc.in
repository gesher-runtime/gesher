// The implementation and bionic registrations below are extracted verbatim.
// Only guarded-copy and Winsock payload transport have host implementations;
// real Linux socket pairs witness the production path's actual transmission.
#include "shim_internal.h"
#include "socket_internal.h"

#include <cerrno>
#include <cstdio>
#include <cstring>
#include <dlfcn.h>
#include <memory>
#include <fcntl.h>
#include <pthread.h>
#include <sys/socket.h>
#include <sys/uio.h>
#include <unistd.h>
#include <vector>

namespace gesher::ws {
bool CopyFromUser(void* to, const void* from, size_t size) {
  if (from == nullptr && size != 0) return false;
  std::memcpy(to, from, size);
  return true;
}
UnixCredentials LocalCredentials() {
  UnixCredentials self;
  self.pid = static_cast<int32_t>(getpid());
  self.uid = getuid();
  self.gid = getgid();
  return self;
}
}

// The host has no descriptor broker ($GESHER_BINDER): SCM_RIGHTS on a
// socketpair fails with EOPNOTSUPP, as production does without one.
namespace gesher {
bool UnixRightsAvailable() { return errno = EOPNOTSUPP, false; }
bool DepositRights(const std::vector<int>&, uint64_t, ws::RightsToken*) {
  return errno = EOPNOTSUPP, false;
}
void CancelRights(const ws::RightsToken&) {}
}

namespace socket_contract {
namespace ws = gesher::ws;
using gesher::SocketFd;

// Every fixture fd is an AF_UNIX socketpair end, described as socketpair
// describes Gesher's: a stream pair or a datagram pair.
bool Lookup(int fd, SocketFd* state) {
  int type = 0;
  socklen_t length = sizeof(type);
  if (getsockopt(fd, SOL_SOCKET, SO_TYPE, &type, &length) != 0) return false;
  state->description = std::make_shared<ws::SocketDescription>();
  state->description->unix_stream_pair = type == SOCK_STREAM;
  state->description->unix_datagram_pair = type != SOCK_STREAM;
  return true;
}

bool StreamPorts(const SocketFd&, uint16_t*, uint16_t*) { return errno = EOPNOTSUPP, false; }

ssize_t SendBuffers(int fd, ws::Buffer* buffers, size_t count, int flags,
                    const sockaddr* address, socklen_t length, const ws::RightsToken* rights) {
  if (rights != nullptr) return errno = EOPNOTSUPP, -1;
  std::vector<iovec> payload;
  for (size_t i = 0; i < count; ++i) payload.push_back({buffers[i].data, buffers[i].len});
  msghdr message{};
  message.msg_name = const_cast<sockaddr*>(address);
  message.msg_namelen = length;
  message.msg_iov = payload.data();
  message.msg_iovlen = payload.size();
  return ::sendmsg(fd, &message, flags);
}

@SOCKET_HELPERS@
@SENDMSG_IMPLEMENTATION@
}

#define sendmsg socket_contract::sendmsg
namespace gesher::bionic {
namespace {
@SOCKET_ADAPTERS@
}
void RegisterSocketContracts(SymbolTable& t) {
#define E(name, fn) t[name] = reinterpret_cast<void*>(&fn)
@SOCKET_REGISTRATIONS@
#undef E
}
}
#undef sendmsg

static void* socket_symbol(void*, const char* name) {
  static gesher::bionic::SymbolTable table = [] {
    gesher::bionic::SymbolTable result;
    gesher::bionic::RegisterSocketContracts(result);
    return result;
  }();
  auto found = table.find(name);
  return found == table.end() ? nullptr : found->second;
}

static int failures;
static void check(const char* label, int ok) {
  std::printf("%-76s %s\n", label, ok ? "ok" : "FAIL");
  if (!ok) ++failures;
  std::fflush(stdout);
}

#define dlsym socket_symbol
#include "socket_control_test.inc"

int main() {
  test_socket_control_contracts();
  return failures == 0 ? 0 : 1;
}
