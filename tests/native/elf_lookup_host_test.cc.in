// The production graph walk with observing symbol tables. Real ELF parsing,
// relocations and Android guest calls are exercised by lookup_graph.c in CI.
#include <mutex>
#include <algorithm>
#include <cstdint>
#include <cstdio>
#include <map>
#include <set>
#include <string>
#include <vector>

std::recursive_mutex g_mutex;
struct Elf64_Sym { int value; };
struct Library {
  std::vector<Library*> dependencies;
  std::map<std::string, Elf64_Sym> symbols;
};
static std::vector<Library*> visited;
static Library* resolved;
static int checks, failures, hashes, resolutions;
static void Check(const char* label, bool ok) {
  ++checks;
  if (!ok) { ++failures; std::fprintf(stderr, "FAIL %s\n", label); }
}
static uint32_t GnuHash(const char*) { ++hashes; return 123; }
static uint32_t SysvHash(const char*) { ++hashes; return 456; }
static const Elf64_Sym* FindDefinedSymbol(Library* lib, const char* name,
                                         uint32_t gh, uint32_t sh) {
  Check("cached symbol hashes", gh == 123 && sh == 456);
  visited.push_back(lib);
  const auto it = lib->symbols.find(name);
  return it == lib->symbols.end() ? nullptr : &it->second;
}
static void* SymbolAddress(Library* lib, const Elf64_Sym* sym) {
  resolved = lib;
  ++resolutions;
  return const_cast<Elf64_Sym*>(sym);
}

@LOOKUP_IMPLEMENTATION@

static void* Find(Library* root, const char* name) {
  visited.clear(); resolved = nullptr; hashes = resolutions = 0;
  return Lookup(root, name);
}

int main() {
  Library root, left, right, leaf, shared, tail;
  root.dependencies = {&left, &right};
  left.dependencies = {&leaf, &shared};
  right.dependencies = {&shared};
  leaf.dependencies = {&root, &tail};
  shared.dependencies = {&tail};
  root.symbols["root"] = {11}; left.symbols["root"] = {21};
  left.symbols["direct"] = {22}; leaf.symbols["deep"] = {31};
  right.symbols["breadth"] = {41}; leaf.symbols["breadth"] = {32};
  leaf.symbols["order"] = {33}; shared.symbols["order"] = {51};
  tail.symbols["tail"] = {61};
  Check("root first", Find(&root, "root") == &root.symbols["root"]);
  Check("root needs no graph walk", visited == std::vector<Library*>{&root});
  Check("root resolves once", resolved == &root && resolutions == 1 && hashes == 2);
  Check("direct dependency", Find(&root, "direct") == &left.symbols["direct"]);
  Check("grandchild", Find(&root, "deep") == &leaf.symbols["deep"]);
  Check("grandchild ownership", resolved == &leaf);
  Check("direct dependency before grandchild",
        Find(&root, "breadth") == &right.symbols["breadth"]);
  Check("DT_NEEDED order within depth", Find(&root, "order") == &leaf.symbols["order"]);
  Check("third depth", Find(&root, "tail") == &tail.symbols["tail"]);
  Check("missing symbol", Find(&root, "absent") == nullptr);
  Check("cycle and diamond visited once in breadth-first order",
        visited == std::vector<Library*>{&root, &left, &right, &leaf, &shared, &tail});
  Check("no resolver call for missing symbol", resolutions == 0 && hashes == 2);
  Check("null handle", Find(nullptr, "root") == nullptr && visited.empty());
  std::vector<Library> deep(1024);
  for (size_t i = 1; i < deep.size(); ++i) deep[i - 1].dependencies = {&deep[i]};
  deep.back().dependencies = {&deep.front()};
  deep.back().symbols["last"] = {99};
  Check("deep nonrecursive lookup", Find(&deep.front(), "last") == &deep.back().symbols["last"]);
  Check("deep missing cycle", Find(&deep.front(), "absent") == nullptr);
  Check("deep nodes each visited once", visited.size() == deep.size());
  std::printf("elf lookup contract: %d checks, %d failures\n", checks, failures);
  return failures != 0;
}
