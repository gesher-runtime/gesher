// Verbatim guest synchronization code; only the Win32 wait/wake, thread ID
// and clock boundaries are adapted. Host pthreads drive genuine contention.
#include "shim_internal.h"
#include <atomic>
#include <cerrno>
#include <chrono>
#include <climits>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <dlfcn.h>
#include <functional>
#include <linux/futex.h>
#include <sys/syscall.h>
#include <thread>
#include <unistd.h>

using DWORD = uint32_t;
constexpr DWORD INFINITE = 0xffffffffu, ERROR_TIMEOUT = 1460;
static thread_local DWORD last_error;
static std::function<bool(void*, int32_t, DWORD)> wait_hook;
static int wait_calls;
static std::atomic<int> wake_calls{0};
static bool WaitOnAddress(volatile void* address, void* compare, size_t size, DWORD ms) {
  if (size != 4) std::abort();
  int32_t expected;
  std::memcpy(&expected, compare, 4);
  if (wait_hook) {
    ++wait_calls;
    bool woke = wait_hook(const_cast<void*>(address), expected, ms);
    last_error = woke ? 0 : ERROR_TIMEOUT;
    return woke;
  }
  int saved = errno;
  timespec timeout{static_cast<time_t>(ms / 1000), static_cast<long>((ms % 1000) * 1000000)};
  long result = syscall(SYS_futex, address, FUTEX_WAIT_PRIVATE, expected,
                        ms == INFINITE ? nullptr : &timeout, nullptr, 0);
  last_error = result == -1 && errno == ETIMEDOUT ? ERROR_TIMEOUT : 0;
  bool woke = result == 0 || errno == EAGAIN;
  errno = saved;
  return woke;
}
static DWORD GetLastError() { return last_error; }
static void WakeByAddressSingle(void* address) {
  int saved = errno;
  ++wake_calls;
  syscall(SYS_futex, address, FUTEX_WAKE_PRIVATE, 1, nullptr, nullptr, 0);
  errno = saved;
}
static void WakeByAddressAll(void* address) {
  int saved = errno;
  ++wake_calls;
  syscall(SYS_futex, address, FUTEX_WAKE_PRIVATE, INT_MAX, nullptr, nullptr, 0);
  errno = saved;
}
static DWORD GetCurrentThreadId() {
  int saved = errno;
  DWORD id = static_cast<DWORD>(syscall(SYS_gettid));
  errno = saved;
  return id;
}
static void SwitchToThread() { std::this_thread::yield(); }
static void Sleep(DWORD ms) { std::this_thread::sleep_for(std::chrono::milliseconds(ms)); }

namespace gesher::bionic {
static bool fixed_clock;
static LinuxTimespec realtime{1000000, 0};
static int64_t monotonic_ns = 100000000000;
LinuxTimespec RealtimeNow() {
  if (fixed_clock) return realtime;
  timespec ts;
  clock_gettime(CLOCK_REALTIME, &ts);
  return {ts.tv_sec, ts.tv_nsec};
}
int64_t MonotonicNanos() {
  if (fixed_clock) return monotonic_ns;
  return std::chrono::duration_cast<std::chrono::nanoseconds>(
      std::chrono::steady_clock::now().time_since_epoch()).count();
}
void DeliverPendingSignals() {}
@DEADLINE@
void* LookupBionicSymbol(const char*);
namespace pthread_code {
@FUTEX_HELPERS@
@MUTEX_HELPERS@
extern "C" {
@PTHREAD_API@
}
}
namespace extra_code {
template <class Fn> Fn Shim(const char* name) {
  return reinterpret_cast<Fn>(LookupBionicSymbol(name));
}
static int64_t NowRealtimeNs() {
  auto ts = RealtimeNow();
  return ts.tv_sec * 1000000000 + ts.tv_nsec;
}
static int64_t NowMonotonicNs() { return MonotonicNanos(); }
@EXTRA_WORD@
@SEMAPHORES@
@LEGACY_TIMED@
}
static SymbolTable BuildTable() {
  SymbolTable t;
#define E(name, fn) t[name] = reinterpret_cast<void*>(&extra_code::fn)
@EXTRA_REGISTRATIONS@
#undef E
#define P(name) t[#name] = reinterpret_cast<void*>(&pthread_code::gesher_bionic_##name)
@PTHREAD_REGISTRATIONS@
#undef P
  return t;
}
void* LookupBionicSymbol(const char* name) {
  static SymbolTable table = BuildTable();
  auto found = table.find(name);
  return found == table.end() ? nullptr : found->second;
}
}

static int checks, failures;
static void check(const char* label, int ok) {
  ++checks;
  if (!ok) { ++failures; std::printf("FAIL %s\n", label); }
}
static void* clock_symbol(void*, const char* name) {
  return gesher::bionic::LookupBionicSymbol(name);
}
#define dlsym clock_symbol
#include "pthread_clock_contract_test.inc"
#undef dlsym

static void test_clock_matrix() {
  using namespace gesher::bionic;
  auto a = pc_load();
  fixed_clock = true;
  for (int attr = 0; attr <= 1; ++attr) {
    for (int explicit_clock = -1; explicit_clock <= 1; ++explicit_clock) {
      realtime = {1000000, 0};
      monotonic_ns = 100000000000;
      int clock = explicit_clock < 0 ? attr : explicit_clock;
      timespec deadline{clock == 0 ? 1000000 : 100, 2500000};
      int64_t attribute = attr;
      pthread_mutex_t m;
      pthread_cond_t c;
      a.mutex_init(&m, nullptr);
      a.cond_init(&c, &attribute);
      a.mutex_lock(&m);
      wait_calls = 0;
      DWORD observed_ms = 0;
      wait_hook = [&](void*, int32_t, DWORD ms) {
        observed_ms = ms;
        // Both clocks advance beyond this test's deadline after one bounded
        // fake wait, so an incorrect clock choice cannot hang the control.
        realtime = {1000001, 0};
        monotonic_ns = 1000001000000000;
        return false;
      };
      int result = explicit_clock < 0 ? a.cond_timed(&c, &m, &deadline)
          : a.cond_clock(&c, &m, clock, &deadline);
      check("cond attribute/explicit clock matrix returns timeout", result == ETIMEDOUT);
      check("cond attribute/explicit clock matrix uses selected 3ms budget",
            wait_calls == 1 && observed_ms == 3);
      check("explicit wait does not rewrite condvar clock attribute",
            pthread_code::W(&c, 1)->load() == attr);
      check("timed condvar reacquires mutex", a.mutex_try(&m) == EBUSY);
      a.mutex_unlock(&m);
    }
  }
  wait_hook = {};
  fixed_clock = false;
}

static void test_validation_preserves_lock() {
  using namespace gesher::bionic;
  auto a = pc_load();
  const timespec invalid[] = {{1000001, -1}, {1000001, 1000000000}, {-1, 0}, {-1, -1}};
  fixed_clock = true;
  realtime = {1000000, 0};
  monotonic_ns = 100000000000;
  wait_hook = [](void*, int32_t, DWORD) { return false; };
  for (const auto& deadline : invalid) {
    pthread_mutex_t m;
    pthread_cond_t c;
    a.mutex_init(&m, nullptr);
    a.cond_init(&c, nullptr);
    a.mutex_lock(&m);
    // A declared white-box waiter bit exposes an unlock even when the
    // rejected deadline is already past and would otherwise never sleep.
    pthread_code::W(&m, 1)->store(2);
    int before = wake_calls;
    wait_calls = 0;
    int result = a.cond_timed(&c, &m, &deadline);
    int expected = deadline.tv_nsec < 0 || deadline.tv_nsec >= 1000000000 ? EINVAL : ETIMEDOUT;
    check("cond validation reports Android error precedence", result == expected);
    check("invalid cond deadline neither releases nor waits",
          wake_calls == before && wait_calls == 0 && pthread_code::W(&m, 1)->load() == 2);
    a.mutex_unlock(&m);
  }
  wait_hook = {};
  fixed_clock = false;
}

static void test_wait_slices() {
  using namespace gesher::bionic;
  auto a = pc_load();
  for (int clock = 0; clock <= 1; ++clock) {
    fixed_clock = true;
    realtime = {1000000, 0};
    monotonic_ns = 100000000000;
    timespec deadline{(clock == 0 ? 1000000 : 100) + 2147489, 0};
    pthread_mutex_t m;
    pthread_cond_t c;
    int64_t attr = clock;
    a.mutex_init(&m, nullptr);
    a.cond_init(&c, &attr);
    a.mutex_lock(&m);
    wait_calls = 0;
    wait_hook = [&](void*, int32_t, DWORD ms) {
      if (wait_calls == 1) {
        if (clock == 0) {
          realtime.tv_sec += ms / 1000;
          realtime.tv_nsec += (ms % 1000) * 1000000;
        } else {
          monotonic_ns += static_cast<int64_t>(ms) * 1000000;
        }
        return false;
      }
      return true;  // a subsequent signal, before the real absolute deadline
    };
    check("finite Windows timeout slice is not the Android deadline",
          a.cond_timed(&c, &m, &deadline) == 0 && wait_calls == 2);
    a.mutex_unlock(&m);
  }
  wait_hook = {};
  fixed_clock = false;
}

static void test_nullable_mutexes() {
  auto a = pc_load();
  for (int route = 0; route < 4; ++route) {
    pthread_mutex_t m;
    a.mutex_init(&m, nullptr);
    a.mutex_lock(&m);
    std::atomic<bool> entered{false}, completed{false};
    int result = -1;
    std::thread waiter([&] {
      entered = true;
      result = route == 0 ? a.mutex_timed(&m, nullptr) : route == 1
          ? a.mutex_mono(&m, nullptr) : a.mutex_clock(&m, route - 2, nullptr);
      completed = true;
      if (result == 0) a.mutex_unlock(&m);
    });
    while (!entered.load()) std::this_thread::yield();
    // Observe the real production contended state, not a scheduling delay.
    auto expires = std::chrono::steady_clock::now() + std::chrono::seconds(2);
    while (gesher::bionic::pthread_code::W(&m, 1)->load() != 2 && !completed.load() &&
           std::chrono::steady_clock::now() < expires) std::this_thread::yield();
    check("nullable mutex actually waits while the owner holds it",
          gesher::bionic::pthread_code::W(&m, 1)->load() == 2 && !completed.load());
    a.mutex_unlock(&m);
    waiter.join();
    check("nullable pthread deadline acquires after release", result == 0);
  }
}

static void test_rwlock_concurrency() {
  using namespace gesher::bionic;
  auto a = pc_load();
  pthread_rwlock_t rw;
  a.rw_init(&rw, nullptr);
  a.rw_write(&rw);
  check("blocking owner read returns EDEADLK", a.rw_read(&rw) == EDEADLK);
  check("blocking owner write returns EDEADLK", a.rw_write(&rw) == EDEADLK);
  a.rw_unlock(&rw);
  // Deterministic private-state boundary: no billion-iteration stress loop.
  pthread_code::W(&rw, 0)->store((1 << 29) - 1);
  check("reader count limit returns EAGAIN", a.rw_tryread(&rw) == EAGAIN);
  check("reader count limit is unchanged", pthread_code::W(&rw, 0)->load() == (1 << 29) - 1);
  pthread_code::W(&rw, 0)->store(0);
  int protected_count = 0;
  std::atomic<int> errors{0};
  std::vector<std::thread> workers;
  for (int i = 0; i < 4; ++i) {
    workers.emplace_back([&] {
      for (int j = 0; j < 1000; ++j) {
        if (a.rw_write(&rw) != 0) { ++errors; continue; }
        ++protected_count;
        if (a.rw_unlock(&rw) != 0) ++errors;
        if (a.rw_read(&rw) != 0) { ++errors; continue; }
        if (protected_count <= 0) ++errors;
        if (a.rw_unlock(&rw) != 0) ++errors;
      }
    });
  }
  for (auto& worker : workers) worker.join();
  check("writer ownership transfers through concurrent readers and writers",
        errors.load() == 0 && protected_count == 4000);
}

int main(int argc, char** argv) {
  if (argc != 2) return 2;
  if (std::strcmp(argv[1], "public") == 0) test_pthread_clock_public();
  else if (std::strcmp(argv[1], "clocks") == 0) {
    test_clock_matrix();
    test_pthread_clock_runtime();
  }
  else if (std::strcmp(argv[1], "validation") == 0) {
    test_pthread_deadline_validation();
    test_validation_preserves_lock();
  } else if (std::strcmp(argv[1], "ownership") == 0) test_pthread_writer_ownership();
  else if (std::strcmp(argv[1], "slices") == 0) test_wait_slices();
  else if (std::strcmp(argv[1], "nullable") == 0) {
    test_nullable_mutexes();
    test_pthread_nullable_runtime();
  }
  else if (std::strcmp(argv[1], "concurrency") == 0) test_rwlock_concurrency();
  else return 2;
  std::printf("pthread %s: %d checks, %d failures\n", argv[1], checks, failures);
  return failures ? 1 : 0;
}
