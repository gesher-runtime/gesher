// The actual DLL loader is Windows-specific. Only this fixture's exercised
// no-TLS routes are connected to the actual methods above; other routes abort.
namespace gesher::arm64 {
bool EnsureLoaded() {
  static const bool loaded = [] { gesher_arm64::InitializeFixtureBridge(); return true; }();
  return loaded;
}
bool Available() { return EnsureLoaded(); }
void AddCode(const void* start, size_t size, const char*) { gesher_arm64::AddGuestCode(start, size); }
void RemoveCode(const void*, size_t) { std::abort(); }
void* BindHostFunction(void* function) { return gesher_arm64::BindHost(function); }
void UnbindHostFunction(void*) { std::abort(); }
void* HostEntry(const void* function) { return gesher_arm64::MakeHostEntry(function); }
uint64_t Call(const void* function, const uint64_t* args, size_t count) {
  return gesher_arm64::ApiCall(function, args, count);
}
int64_t TlsRegister(size_t, size_t) { std::abort(); }
bool TlsPrepare(int64_t, const void*, size_t, size_t) { std::abort(); }
void TlsPublish(int64_t, const void*, size_t, size_t) { std::abort(); }
bool TlsRollback(int64_t, size_t) { std::abort(); }
void* TlsAddress(int64_t, size_t) { std::abort(); }
void AddVaListFunction(const void*, int) { std::abort(); }
bool IsGuestCode(const void* address) { return gesher_arm64::InGuestCode(reinterpret_cast<uintptr_t>(address)); }
uint64_t RunProgram(const void*, const uint64_t*, size_t) { std::abort(); }
void* GuestSymbol(const char* name) { return gesher_arm64::GuestSymbol(name); }
void* TlsDescStatic() { std::abort(); }
