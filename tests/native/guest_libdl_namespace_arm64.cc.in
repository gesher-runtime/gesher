// The unchanged assembly thunk has a Microsoft entry (RCX), even on Linux.
extern "C" uint64_t __attribute__((ms_abi)) gesher_call_host_sysv(HostCall*);
extern "C" void gesher_guest_entry_shim();

namespace gesher_arm64 {
const gesher_arm64_host* g_host = nullptr;
[[noreturn]] void GuestCrash(int, int, const char*, uint64_t pc, const char* text) {
  std::fprintf(stderr, "actual ARM libdl fixture: %s at 0x%llx\n", text,
               static_cast<unsigned long long>(pc));
  std::abort();
}
int64_t GuestRawSyscall(uint64_t, const uint64_t[6]) { std::abort(); }
