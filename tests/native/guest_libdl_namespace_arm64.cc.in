bool FastmemEnabled() { return false; }
bool ProfilePreciseEnabled() { return false; }
uint64_t QpcFrequency() { return 1000000000; }
DWORD GetEnvironmentVariableA(const char*, char*, DWORD) { return 0; }
@FENV@
@CODE_REGIONS@
@MONITOR@
@VA_LIST@
@COUNTERS@
uintptr_t g_return_stub = 0;
thread_local int t_guest_running = 0;
class Env;
thread_local Env* t_env = nullptr;

class Env final : public A64TestEnv {
 public:
  Env() : stack_data_(8 << 20) {
    stack_base_ = stack_data_.data();
    stack_top_ = reinterpret_cast<uint64_t>(stack_base_ + stack_data_.size()) & ~uint64_t{15};
    stack_cur_ = stack_top_;
  }
  ~Env() override {
    jits_.clear();
    for (size_t id : ids_) ReleaseProcessorId(id);
  }
  std::optional<uint32_t> MemoryReadCode(uint64_t address) override {
    if (!InGuestCode(address)) return std::nullopt;
    uint32_t result;
    std::memcpy(&result, reinterpret_cast<const void*>(address), sizeof(result));
    return result;
  }
  uint8_t MemoryRead8(uint64_t address) override {
    return *reinterpret_cast<const uint8_t*>(address);
  }
  void MemoryWrite8(uint64_t address, uint8_t value) override {
    *reinterpret_cast<uint8_t*>(address) = value;
  }
@JIT_AT@
  A64::Jit* CurrentJit() { return depth_ ? jits_[depth_ - 1].get() : nullptr; }
@CALL_SVC@
@ENTER@
@RESULT_GETTERS@
  uint64_t host_caller() const { return host_caller_; }
@HOST_DISPATCH@
  std::vector<std::unique_ptr<A64::Jit>> jits_;
  std::vector<uint64_t> code_generations_;
  std::vector<size_t> ids_;
  std::vector<uint8_t> stack_data_;
  PendingHostCall pending_call_;
  uint32_t fpcr_ = 0, fpsr_ = 0;
  size_t depth_ = 0;
  uint64_t tls_pointer_ = 0;
  uint8_t* stack_base_ = nullptr;
  uint64_t stack_top_ = 0, stack_cur_ = 0;
  uint64_t last_fp_result_ = 0, last_x1_ = 0;
  void* host_fn_ = nullptr;
  uint64_t host_caller_ = 0;
  ThreadCounters counters_;
  std::atomic<A64::Jit*> running_jit_{nullptr};
  std::atomic<void*> sampled_host_fn_{nullptr};
  std::atomic<uint64_t> last_syscall_{0};
};
Env* ThreadEnv() {
  static thread_local Env environment;
  t_env = &environment;
  return t_env;
}
