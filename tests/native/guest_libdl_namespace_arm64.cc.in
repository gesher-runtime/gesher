void InitializeFixtureBridge() {
  static const gesher_arm64_host host{GESHER_ARM64_API_VERSION, gesher::elf::ResolveBionic, nullptr};
  g_host = &host;
@RETURN_STUB@
  InitGuestLibc();
}
