#include <sys/stat.h>
#include <unistd.h>
static int checks, failures, lock_depth, descriptor_depth, admission_error, finish_error, crt_calls;
static bool close_error_after;
static bool fail_allocations;
static int allocation_attempts, io_calls;
// Only C++ allocations fail. The real FILE and its host CRT storage already
// exist, so this targets insertion in the production StreamState registry.
[[gnu::noinline]] static void* allocate(size_t size) {
  if (fail_allocations) { ++allocation_attempts; throw std::bad_alloc(); }
  if (void* p = std::malloc(size ? size : 1)) return p;
  throw std::bad_alloc();
}
[[gnu::noinline]] static void release(void* p) { std::free(p); }
void* operator new(size_t size) { return allocate(size); }
void operator delete(void* p) noexcept { release(p); }
void operator delete(void* p, size_t) noexcept { release(p); }
static void check(const char* name,bool value) {
  ++checks; if(!value){++failures;std::fprintf(stderr,"FAIL %s\n",name);}
}
struct StreamLock {
  explicit StreamLock(FILE*) { ++lock_depth; }
  ~StreamLock() { --lock_depth; }
  explicit operator bool() const { return true; }
};
static constexpr int INVALID_HANDLE_VALUE = -1;
enum class PathKind { kFile, kNull, kMissing };
namespace gesher {
void ForgetStreamDevice(int,bool) {}
int HandleFromFd(int fd) { return fcntl(fd, F_GETFD) >= 0 ? fd : INVALID_HANDLE_VALUE; }
void ForgetOfd(int) {}
int RegisterOfd(int,int) { return 0; }
struct RetiredDescriptor { void Retire(int) {} int Finish() { return 0; } };
namespace stdio {
// The shared buffer and CRT-lock composition run in test_stdio_contracts.py.
// This envelope supplies only bounded orientation/retirement and I/O counters.
struct Orientation { FILE* stream = nullptr; int mode = 0; };
static std::array<Orientation, 32> orientations;
static bool fail_orientation;
int Orient(FILE* stream, int mode, bool) {
  if (mode && fail_orientation) return errno = ENOMEM, 0;
  for (auto& item : orientations) if (item.stream == stream) {
    if (item.mode == 0 && mode) item.mode = mode > 0 ? 1 : -1;
    return item.mode;
  }
  if (mode) for (auto& item : orientations) if (!item.stream) {
    item = {stream, mode > 0 ? 1 : -1}; return item.mode;
  }
  return 0;
}
int FlushOutput(FILE*) { return 0; }
void Forget(FILE* stream) {
  for (auto& item : orientations) if (item.stream == stream) item = {};
}
int PrepareReopenedStream(FILE* stream, int) { Forget(stream); return 0; }
int Get(FILE* stream, bool) { ++io_calls; return getc_unlocked(stream); }
int Put(int value, FILE* stream, bool) { ++io_calls; return putc_unlocked(value, stream); }
int Error(FILE* stream, bool unlocked) {
  check("guest status uses the unlocked shared boundary", unlocked);
  return ferror_unlocked(stream);
}
void Clear(FILE* stream, bool unlocked) {
  check("guest clear uses the unlocked shared boundary", unlocked);
  clearerr_unlocked(stream);
}
size_t Write(const void* data, size_t size, size_t count, FILE* stream, bool) {
  ++io_calls; return fwrite_unlocked(data, size, count, stream);
}
}
PathKind MapPath(const char* path,std::wstring* output) {
  if(std::strcmp(path,"missing:")==0)return PathKind::kMissing;
  *output=std::wstring(path,path+std::strlen(path));return PathKind::kFile;
}
namespace record_locks {
struct ClosingDescriptor {
  int error=admission_error; bool finished=false;
  explicit ClosingDescriptor(int) {
    check("guest and host own the recursive FILE lock before the descriptor guard",lock_depth==2 && descriptor_depth==0);
    ++descriptor_depth;
  }
  int Error() const {return error;}
  int Finish(bool) { check("descriptor completion is under both guards",!finished && lock_depth==2 && descriptor_depth==1);finished=true;return finish_error; }
  ~ClosingDescriptor(){--descriptor_depth;}
};
}
}
static int _fileno(FILE* stream){return fileno(stream);}
static int gesher_errno_from_crt(int error){return error;}
static bool HasNonDirectoryParent(const std::wstring&){return false;}
static int _fclose_nolock(FILE* stream){
  check("real close stays under both guards",lock_depth==2 && descriptor_depth==1);++crt_calls;
  int result=std::fclose(stream);return close_error_after?(errno=EIO,EOF):result;
}
static FILE* _wfreopen(const wchar_t* path,const wchar_t* mode,FILE* stream){
  check("real reopen stays under both guards",lock_depth==2 && descriptor_depth==1);++crt_calls;
  std::wstring wp(path),wm(mode);std::string p(wp.begin(),wp.end()),m(wm.begin(),wm.end());
  for(char& c:m)if(c=='N')c='e';
  // A failed glibc freopen closes the descriptor but can leave the FILE
  // allocation live. Model the UCRT read-only missing-path failure with the
  // real filesystem error and release the original stream with fclose.
  struct stat metadata{};
  if (m == "rb" && stat(p.c_str(), &metadata) < 0 && errno == ENOENT) {
    check("failed CRT reopen closes the original stream", std::fclose(stream) == 0);
    errno = ENOENT;
    return nullptr;
  }
  return std::freopen(p.c_str(),m.c_str(),stream);
}
namespace host {
@PARSE@
@HOST_CLOSE@
@HOST_REOPEN@
}
namespace shim {
#define BIONIC_SYSV
constexpr int kEINVAL=EINVAL;
constexpr int kENOMEM=ENOMEM;
constexpr int kEilseq=EILSEQ;
static FILE* F(void* f){return static_cast<FILE*>(f);}
@STATE@
// Wide codec boundaries are deliberately not reimplemented here. These
// witnesses establish that failed metadata allocation reaches no codec/I/O.
static uint32_t ReadWide(FILE*, StreamState&) { ++io_calls; return 'A'; }
static bool WriteWide(FILE*, StreamState&, uint32_t) { ++io_calls; return true; }
[[maybe_unused]] static int _getc_nolock(FILE* f) { ++io_calls; return getc_unlocked(f); }
[[maybe_unused]] static int _putc_nolock(int c, FILE* f) { ++io_calls; return putc_unlocked(c, f); }
[[maybe_unused]] static int _ungetc_nolock(int c, FILE* f) { ++io_calls; return std::ungetc(c, f); }
[[maybe_unused]] static size_t _fwrite_nolock(const void* p, size_t size, size_t n, FILE* f) {
  ++io_calls; return fwrite_unlocked(p, size, n, f);
}
static size_t ReadStream(void* p, size_t size, size_t n, FILE* f) {
  ++io_calls; return fread_unlocked(p, size, n, f);
}
[[maybe_unused]] static bool gesher_is_device_fd(int) { return false; }
@WIDE@
@BYTE@
@UNGETC@
@STATUS@
@GETDELIM@
@PERROR@
@MODE@
@CLOSE@
@REOPEN@
// Process-wait boundary: count whether production pclose waits, and preserve
// its real child-association map. No child process execution is claimed here.
static std::mutex g_popen_mutex;
static std::unordered_map<void*,int> g_popen;
static int collect_calls;
static int CollectOne(int pid,int* status,int) { ++collect_calls;*status=0x2300;return pid; }
@PCLOSE@
}
static bool recorded(FILE* f){
  auto& b=shim::StreamBucket(f);std::lock_guard<std::mutex> lock(b.mutex);return b.streams.contains(f);
}
static bool intact(FILE* f){
  auto& b=shim::StreamBucket(f);std::lock_guard<std::mutex> lock(b.mutex);auto it=b.streams.find(f);
  if(it==b.streams.end())return false;
  const auto& s=it->second;
  return s.orientation==1 && s.conversion_error && s.pushback==0x1f642 && s.input_state[3]==0x5a;
}
static FILE* prepared(){
  FILE* f=std::tmpfile();if(!f)std::abort();auto& s=*shim::State(f);
  s.orientation=1;s.conversion_error=true;s.pushback=0x1f642;s.input_state[3]=0x5a;return f;
}
static void allocation_contracts() {
  FILE* f = std::tmpfile();
  if (!f) std::abort();
  check("allocation probe has real unread input", std::fputs("Q", f) >= 0);
  std::rewind(f);
  auto must_fail = [&](const char* name, auto operation) {
    errno = 0; allocation_attempts = 0; io_calls = 0;
    fail_allocations = true;
    bool result = false;
    try { result = operation(); } catch (const std::bad_alloc&) {}
    fail_allocations = false;
    check(name, result && errno == ENOMEM && allocation_attempts == 1 &&
                io_calls == 0 && !recorded(f) && lock_depth == 0);
  };
  uint32_t wide[3] = {0xfeed, 0xbeef, 0};
  char bytes[3] = {'X', 'Y', 0};
  char* line = nullptr;
  size_t capacity = 0;
  must_fail("fgetwc reports metadata ENOMEM before reading", [&] { return shim::Fgetwc(f) == shim::kWeof; });
  must_fail("fgetws reports metadata ENOMEM without modifying the buffer", [&] {
    return shim::Fgetws(wide, 3, f) == nullptr && wide[0] == 0xfeed;
  });
  must_fail("ungetwc reports metadata ENOMEM before pushback", [&] { return shim::Ungetwc('A', f) == shim::kWeof; });
  must_fail("fputwc reports metadata ENOMEM before writing", [&] { return shim::Fputwc('A', f) == shim::kWeof; });
  must_fail("fputws reports metadata ENOMEM before writing", [&] { return shim::Fputws(wide, f) == -1; });
  must_fail("fwide leaves a new stream unoriented on metadata ENOMEM", [&] { return shim::Fwide(f, 1) == 0; });
  must_fail("getc reports metadata ENOMEM before reading", [&] { return shim::GetcUnlocked(f) == EOF; });
  must_fail("putc reports metadata ENOMEM before writing", [&] { return shim::PutcUnlocked('A', f) == EOF; });
  must_fail("fread reports metadata ENOMEM before reading", [&] { return shim::Fread(bytes, 1, 1, f) == 0; });
  must_fail("fwrite reports metadata ENOMEM before writing", [&] { return shim::Fwrite(bytes, 1, 1, f) == 0; });
  must_fail("fputs reports metadata ENOMEM before writing", [&] { return shim::Fputs(bytes, f) == EOF; });
  must_fail("unlocked fgets reports metadata ENOMEM before reading", [&] {
    return shim::FgetsUnlocked(bytes, 3, f) == nullptr && bytes[0] == 'X';
  });
  must_fail("fgets reports metadata ENOMEM before reading", [&] {
    return shim::Fgets(bytes, 3, f) == nullptr && bytes[0] == 'X';
  });
  must_fail("ungetc reports metadata ENOMEM before pushback", [&] { return shim::Ungetc('A', f) == EOF; });
  must_fail("getdelim reports metadata ENOMEM before consuming input", [&] {
    return shim::Getdelim(&line, &capacity, '\n', f) == -1 && line == nullptr && capacity == 0;
  });
  must_fail("puts reports metadata ENOMEM before writing", [&] { return shim::Puts(bytes) == EOF; });
  must_fail("perror returns on metadata ENOMEM", [&] { shim::Perror("probe"); return true; });
  check("failed metadata allocation did not consume input", std::ftell(f) == 0 && std::fgetc(f) == 'Q');

  // Queries and clearerr must work even when every new allocation fails.
  errno = EDOM; allocation_attempts = 0; fail_allocations = true;
  bool queries_worked = false;
  try {
    queries_worked = shim::Fwide(f, 0) == 0 && shim::Ferror(f) == 0;
    shim::Clearerr(f);
    queries_worked = queries_worked && shim::Ungetwc(shim::kWeof, f) == shim::kWeof &&
                     shim::Ungetc(EOF, f) == EOF && shim::Fread(bytes, 0, 1, f) == 0 &&
                     shim::Fwrite(bytes, 1, 0, f) == 0;
  } catch (const std::bad_alloc&) {}
  fail_allocations = false;
  check("status queries and no-op I/O do not allocate or change errno",
        queries_worked && allocation_attempts == 0 && errno == EDOM && !recorded(f));

  check("allocation recovery can orient the same live stream", shim::Fwide(f, 1) > 0);
  auto* state = shim::State(f);
  state->conversion_error = true;
  errno = EDOM; allocation_attempts = 0; fail_allocations = true;
  bool existing_worked = false;
  try {
    existing_worked = shim::Fwide(f, 0) > 0 && shim::Ferror(f) != 0;
    shim::Clearerr(f);
    existing_worked = existing_worked && shim::Ferror(f) == 0 && shim::Fputwc('A', f) == 'A';
  } catch (const std::bad_alloc&) {}
  fail_allocations = false;
  check("existing state works under allocation pressure",
        existing_worked && allocation_attempts == 0 && errno == EDOM && lock_depth == 0);
  check("recovered stream closes normally", shim::CloseBionicStream(f) == 0 && !recorded(f));
}
static void shared_orientation_contracts() {
  FILE* f = std::tmpfile();
  if (!f) std::abort();
  auto* state = shim::State(f);
  if (!state) std::abort();
  uint32_t wide[3] = {0xfeed, 0xbeef, 0};
  gesher::stdio::fail_orientation = true;
  auto rejected = [&](const char* name, auto operation) {
    errno = 0; io_calls = 0;
    bool result = operation();
    check(name, result && errno == ENOMEM && io_calls == 0 &&
        state->pushback == shim::kWeof && state->orientation == 0 && lock_depth == 0);
  };
  rejected("fgetwc stops before I/O if shared orientation fails", [&] { return shim::Fgetwc(f) == shim::kWeof; });
  rejected("fgetws preserves output if shared orientation fails", [&] {
    return shim::Fgetws(wide, 3, f) == nullptr && wide[0] == 0xfeed;
  });
  rejected("ungetwc preserves pushback if shared orientation fails", [&] { return shim::Ungetwc('B', f) == shim::kWeof; });
  rejected("fputwc stops before I/O if shared orientation fails", [&] { return shim::Fputwc('B', f) == shim::kWeof; });
  rejected("fputws stops before I/O if shared orientation fails", [&] { return shim::Fputws(wide, f) == -1; });
  gesher::stdio::fail_orientation = false;
  check("shared orientation failure permits a later successful retry", shim::Fgetwc(f) == 'A' && state->orientation == 1);
  check("shared orientation failure preserves stream ownership", shim::CloseBionicStream(f) == 0 && !recorded(f));
}
int main(){
  FILE* f=prepared();int fd=fileno(f);int calls=crt_calls;admission_error=EBUSY;
  check("pre-close failure is returned",shim::CloseBionicStream(f)==EOF && errno==EBUSY);
  check("pre-close failure never invokes the CRT",crt_calls==calls);
  check("pre-close failure preserves all wide state",intact(f));
  check("pre-close failure leaves its real descriptor open",fcntl(fd,F_GETFD)>=0);
  admission_error=0;check("successful retry closes",shim::CloseBionicStream(f)==0);
  check("successful retry retires state",!recorded(f));

  f=prepared();close_error_after=true;
  check("CRT error after actual close is returned",shim::CloseBionicStream(f)==EOF && errno==EIO);
  check("CRT error after close retires state",!recorded(f));close_error_after=false;
  f=prepared();finish_error=EROFS;
  check("metadata failure after close is returned",shim::CloseBionicStream(f)==EOF && errno==EROFS);
  check("metadata failure after close retires state",!recorded(f));finish_error=0;

  f=prepared();fd=fileno(f);calls=crt_calls;admission_error=EBUSY;
  check("pre-reopen failure is returned",shim::Freopen("/dev/null","rb",f)==nullptr && errno==EBUSY);
  check("pre-reopen failure never invokes the CRT",crt_calls==calls);
  check("pre-reopen failure preserves all wide state",intact(f));
  check("pre-reopen failure leaves its real descriptor open",fcntl(fd,F_GETFD)>=0);admission_error=0;
  check("successful retry reopens the FILE",shim::Freopen("/dev/null","rb",f)==f);
  check("successful reopen retires all previous wide state",!recorded(f));
  check("next state starts unoriented",shim::State(f)->orientation==0);
  shim::CloseBionicStream(f);

  f=prepared();
  check("invalid mode closes original stream",shim::Freopen("/dev/null","bad",f)==nullptr && errno==EINVAL);
  check("invalid-mode retirement is recorded",!recorded(f));
  f=prepared();
  check("path rejection closes original stream",shim::Freopen("missing:","rb",f)==nullptr && errno==ENOENT);
  check("path-rejection retirement is recorded",!recorded(f));
  f=prepared();fd=fileno(f);calls=crt_calls;
  check("CRT reopen returns the missing-target error",
        shim::Freopen("absent/destination","rb",f)==nullptr && errno==ENOENT);
  check("missing-target failure reaches the CRT once",crt_calls==calls+1);
  check("CRT reopen failure closes the original descriptor",fcntl(fd,F_GETFD)<0 && errno==EBADF);
  check("CRT reopen failure retires closed FILE state",!recorded(f));

  f=prepared();finish_error=EROFS;
  check("metadata failure after replacement is returned",shim::Freopen("/dev/null","rb",f)==nullptr && errno==EROFS);
  check("metadata failure does not resurrect old FILE state",!recorded(f));finish_error=0;
  shim::CloseBionicStream(f);

  f=prepared();fd=fileno(f);shim::g_popen.emplace(f,42);admission_error=EBUSY;
  check("pclose returns a pre-close error",shim::Pclose(f)==-1 && errno==EBUSY);
  check("pclose does not wait while the writer is still open",shim::collect_calls==0);
  check("pclose preserves the child association for retry",shim::g_popen.contains(f));
  check("pclose preserves live descriptor and wide state",fcntl(fd,F_GETFD)>=0 && intact(f));
  admission_error=0;
  check("pclose retry returns the child status",shim::Pclose(f)==0x2300);
  check("pclose retry waits once and removes its association",shim::collect_calls==1 && !shim::g_popen.contains(f));
  check("pclose retry retires the state",!recorded(f));
  f=prepared();shim::g_popen.emplace(f,43);close_error_after=true;
  check("pclose still reaps its child after a retired-stream close error",shim::Pclose(f)==0x2300);
  check("retired pclose removes the association and wide state",shim::collect_calls==2 && !shim::g_popen.contains(f) && !recorded(f));
  close_error_after=false;
  check("all guards released",lock_depth==0 && descriptor_depth==0);
  size_t remaining=0;for(auto& bucket:shim::g_stream_states)remaining+=bucket.streams.size();
  check("no retired state accumulates",remaining==0);
  allocation_contracts();
  shared_orientation_contracts();
  std::printf("stdio lifetime: %d checks, %d failures\n",checks,failures);return failures?1:0;
}
