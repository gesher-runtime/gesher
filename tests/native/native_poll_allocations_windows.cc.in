#include <winsock2.h>
#include <ws2tcpip.h>
#include <algorithm>
#include <atomic>
#include <cerrno>
#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <memory>
#include <mutex>
#include <new>
#include <thread>
#include <vector>
#include "@HEADER@"

static thread_local bool tracking = false;
static thread_local size_t allocations = 0, allocated_bytes = 0;
static std::atomic<size_t> live_tracked_bytes{0};
struct alignas(std::max_align_t) AllocationHeader { size_t size; bool tracked; };
void* operator new(size_t n) {
  if (n > SIZE_MAX - sizeof(AllocationHeader)) std::abort();
  auto* header = static_cast<AllocationHeader*>(std::malloc((n ? n : 1) + sizeof(AllocationHeader)));
  if (header == nullptr) std::abort();
  header->size = n;
  header->tracked = tracking;
  if (tracking) {
    ++allocations;
    allocated_bytes += n;
    live_tracked_bytes.fetch_add(n, std::memory_order_relaxed);
  }
  return header + 1;
}
void operator delete(void* p) noexcept {
  if (p == nullptr) return;
  auto* header = static_cast<AllocationHeader*>(p) - 1;
  if (header->tracked) live_tracked_bytes.fetch_sub(header->size, std::memory_order_relaxed);
  std::free(header);
}
void* operator new[](size_t n) { return ::operator new(n); }
void operator delete[](void* p) noexcept { ::operator delete(p); }
void operator delete(void* p, size_t) noexcept { ::operator delete(p); }
void operator delete[](void* p, size_t) noexcept { ::operator delete(p); }

static std::atomic<int> inject_native_error{0};
// These scripts control only the native call boundary around the extracted
// production Poll. Socket identity/queries, zero-time confirmation, and the
// remaining UDP/TCP controls still execute real Winsock operations.
struct NativeStep {
  int timeout;
  std::vector<WSAPOLLFD> input;
  std::vector<SHORT> add_revents{};
  int error = 0;
  SOCKET retire_socket = INVALID_SOCKET;
  gesher::ws::SocketDescription* retire_description = nullptr;
  SOCKET drain_socket = INVALID_SOCKET;
};
struct NativeScript {
  std::vector<NativeStep> steps;
  size_t calls = 0;
  bool valid = true;
};
static thread_local NativeScript* native_script = nullptr;
static int NativePoll(WSAPOLLFD* fds, ULONG count, INT milliseconds) {
  if (native_script != nullptr) {
    auto& script = *native_script;
    const size_t call = script.calls++;
    if (call >= script.steps.size()) {
      script.valid = false;
      WSASetLastError(WSAEINVAL);
      return SOCKET_ERROR;
    }
    const auto& step = script.steps[call];
    script.valid &= milliseconds == step.timeout && count == step.input.size() &&
        (step.add_revents.empty() || step.add_revents.size() == count);
    for (size_t i = 0; i < count && i < step.input.size(); ++i)
      script.valid &= fds[i].fd == step.input[i].fd && fds[i].events == step.input[i].events;
    if (!script.valid) {
      WSASetLastError(WSAEINVAL);
      return SOCKET_ERROR;
    }
    if (step.retire_socket != INVALID_SOCKET) {
      script.valid &= ::closesocket(step.retire_socket) == 0 && step.retire_description != nullptr;
      if (step.retire_description != nullptr) {
        std::lock_guard<std::mutex> lock(step.retire_description->error_mutex);
        step.retire_description->native_closed = true;
      }
    }
    if (step.drain_socket != INVALID_SOCKET) {
      char byte = 0;
      script.valid &= ::recv(step.drain_socket, &byte, 1, 0) == 1 && byte == 'x';
    }
    if (step.error != 0) { WSASetLastError(step.error); return SOCKET_ERROR; }
    const int result = ::WSAPoll(fds, count, milliseconds);
    if (result == SOCKET_ERROR) return result;
    int ready = 0;
    for (size_t i = 0; i < count; ++i) {
      if (!step.add_revents.empty()) fds[i].revents |= step.add_revents[i];
      ready += fds[i].revents != 0;
    }
    return ready;
  }
  const int error = inject_native_error.exchange(0);
  if (error) { WSASetLastError(error); return SOCKET_ERROR; }
  return ::WSAPoll(fds, count, milliseconds);
}

namespace gesher::ws {
// Completion transport is unchanged and is tested by the full TCP contracts.
struct ConnectOperation {};
void RefreshConnect(const std::shared_ptr<SocketDescription>&) {}
struct FixtureApi {
  decltype(&::getsockopt) getsockopt = ::getsockopt;
  decltype(&::getpeername) getpeername = ::getpeername;
};
const FixtureApi& Api() { static FixtureApi api; return api; }
int ErrnoFromWsa(int error) {
  switch (error) {
    case WSAEINVAL: return EINVAL;
    case WSAENOTSOCK: return ENOTSOCK;
    case WSAEWOULDBLOCK: return EAGAIN;
    case WSAECONNRESET: return ECONNRESET;
    default: return EIO;
  }
}
ptrdiff_t Recv(Socket socket, Buffer* buffers, size_t count, int flags, Address*, int*) {
  if (count != 1 || flags != kMsgPeek) std::abort();
  const int result = ::recv(static_cast<SOCKET>(socket), static_cast<char*>(buffers[0].data),
                            static_cast<int>(buffers[0].len), MSG_PEEK);
  if (result == SOCKET_ERROR) { errno = ErrnoFromWsa(WSAGetLastError()); return -1; }
  return result;
}
#define WSAPoll NativePoll
@IMPLEMENTATION@
#undef WSAPoll
}  // namespace gesher::ws

static size_t checks = 0;
static void Check(bool ok, const char* message) {
  ++checks;
  if (!ok) {
    std::fprintf(stderr, "native poll check %zu failed: %s errno=%d WSA=%d\n", checks, message, errno, WSAGetLastError());
    std::exit(1);
  }
}
static SOCKET Udp(sockaddr_in* address) {
  SOCKET socket = ::socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
  Check(socket != INVALID_SOCKET, "create native UDP socket");
  u_long mode = 1;
  Check(ioctlsocket(socket, FIONBIO, &mode) == 0, "nonblocking UDP");
  *address = {};
  address->sin_family = AF_INET;
  address->sin_addr.s_addr = htonl(INADDR_LOOPBACK);
  Check(::bind(socket, reinterpret_cast<sockaddr*>(address), sizeof(*address)) == 0, "bind native loopback");
  int size = sizeof(*address);
  Check(::getsockname(socket, reinterpret_cast<sockaddr*>(address), &size) == 0, "bound native address");
  return socket;
}
static void Queue(SOCKET sender, const sockaddr_in& destination) {
  Check(::sendto(sender, "x", 1, 0, reinterpret_cast<const sockaddr*>(&destination), sizeof(destination)) == 1,
        "queue native datagram");
}
static void Empty(SOCKET receiver) {
  char bytes[64];
  while (::recv(receiver, bytes, sizeof(bytes), 0) >= 0) {}
  Check(WSAGetLastError() == WSAEWOULDBLOCK, "drain native UDP queue");
}
struct TcpPair { SOCKET sender, receiver; };
static SOCKET TcpSocket() {
  const SOCKET socket = WSASocketW(AF_INET, SOCK_STREAM, IPPROTO_TCP, nullptr, 0,
                                   WSA_FLAG_OVERLAPPED | WSA_FLAG_NO_HANDLE_INHERIT);
  Check(socket != INVALID_SOCKET, "create native TCP socket");
  return socket;
}
static TcpPair Tcp() {
  const SOCKET listener = TcpSocket();
  sockaddr_in address{};
  address.sin_family = AF_INET;
  address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
  Check(::bind(listener, reinterpret_cast<sockaddr*>(&address), sizeof(address)) == 0, "bind native TCP listener");
  int length = sizeof(address);
  Check(::getsockname(listener, reinterpret_cast<sockaddr*>(&address), &length) == 0, "native TCP listener address");
  Check(::listen(listener, 1) == 0, "listen native TCP");
  const SOCKET sender = TcpSocket();
  Check(::connect(sender, reinterpret_cast<sockaddr*>(&address), sizeof(address)) == 0, "connect native TCP");
  const SOCKET receiver = ::accept(listener, nullptr, nullptr);
  Check(receiver != INVALID_SOCKET, "accept native TCP");
  const DWORD timeout = 2000;
  Check(::setsockopt(receiver, SOL_SOCKET, SO_RCVTIMEO,
                     reinterpret_cast<const char*>(&timeout), sizeof(timeout)) == 0, "bound native TCP receive");
  Check(::closesocket(listener) == 0, "close native TCP listener");
  return {sender, receiver};
}
static void CloseTcp(TcpPair pair) {
  Check(::closesocket(pair.sender) == 0 && ::closesocket(pair.receiver) == 0, "close native TCP pair");
}
static int ScriptedPoll(NativeScript& script, gesher::ws::PollEntry* entries, size_t count,
                        int timeout, SOCKET wake = INVALID_SOCKET, bool* woken = nullptr,
                        gesher::ws::NativePollObserver observer = nullptr, void* context = nullptr) {
  Check(native_script == nullptr, "native script starts outside another sample");
  native_script = &script;
  const int result = gesher::ws::Poll(entries, count, timeout, observer, context, wake, woken);
  native_script = nullptr;
  return result;
}
static bool ScriptComplete(const NativeScript& script) {
  return script.valid && script.calls == script.steps.size();
}
struct PriorityObserver { unsigned before = 0, after = 0; int result = 0, error = 0; };
static void ObservePriority(bool before, int result, int error, void* context) {
  auto& observed = *static_cast<PriorityObserver*>(context);
  if (before) ++observed.before;
  else { ++observed.after; observed.result = result; observed.error = error; }
}
static void PriorityConfirmationControls(SOCKET queued, SOCKET sender) {
  using namespace gesher::ws;
  TcpPair tcp = Tcp();
  PollEntry priority{tcp.receiver, kPollPri, 123, {}};
  const std::vector<WSAPOLLFD> input{{tcp.receiver, POLLRDBAND, 0}};
  NativeScript early{{{10, input, {POLLRDBAND}}, {0, input}}};
  PriorityObserver observed;
  const int early_result = ScriptedPoll(early, &priority, 1, 10, INVALID_SOCKET, nullptr,
                                        ObservePriority, &observed);
  // This unique assertion is the old-source negative-control signature.
  Check(early_result == 0 && priority.revents == 0 && ScriptComplete(early),
        "early TCP priority wake must be confirmed before exposing readiness");
  Check(observed.before == 1 && observed.after == 1 && observed.result == 1 && observed.error == 0,
        "priority observer describes only the original native sample");

  NativeScript confirmed{{{10, input, {POLLRDBAND}}, {0, input, {POLLRDBAND}}}};
  Check(ScriptedPoll(confirmed, &priority, 1, 10) == 1 && priority.revents == kPollPri &&
            ScriptComplete(confirmed), "confirmed priority performs exactly one zero-time sample");
  NativeScript immediate{{{0, input, {POLLRDBAND}}}};
  Check(ScriptedPoll(immediate, &priority, 1, 0) == 1 && priority.revents == kPollPri &&
            ScriptComplete(immediate), "caller zero-time priority sample is not confirmed again");

  PollEntry ordinary{queued, kPollIn, 0, {}};
  NativeScript normal{{{10, {{queued, POLLRDNORM, 0}}}}};
  Check(ScriptedPoll(normal, &ordinary, 1, 10) == 1 && ordinary.revents == kPollIn &&
            ScriptComplete(normal), "ordinary readable wait performs only its native sample");
  NativeScript unrequested{{{10, {{queued, POLLRDNORM, 0}}, {POLLRDBAND}}}};
  Check(ScriptedPoll(unrequested, &ordinary, 1, 10) == 1 && ordinary.revents == kPollIn &&
            ScriptComplete(unrequested), "unrequested priority bits do not trigger confirmation");

  for (int error : {WSAENETDOWN, WSAENOTSOCK, WSAEINVAL}) {
    NativeScript failure{{{10, input, {POLLRDBAND}}, {0, input}}};
    failure.steps[1].error = error;
    errno = 0;
    Check(ScriptedPoll(failure, &priority, 1, 10) == -1 && errno == ErrnoFromWsa(error) &&
              ScriptComplete(failure), "genuine confirmation error is preserved without an unowned retry");
  }

  sockaddr_in wake_address;
  const SOCKET wake = Udp(&wake_address);
  Queue(sender, wake_address);
  WSAPOLLFD wake_ready{wake, POLLRDNORM, 0};
  Check(::WSAPoll(&wake_ready, 1, 2000) == 1 && wake_ready.revents == POLLRDNORM,
        "queued wake is readable before the mixed confirmation observation");
  const std::vector<WSAPOLLFD> mixed_input{
      {tcp.receiver, POLLRDBAND, 0}, {queued, POLLRDNORM, 0},
      {tcp.sender, POLLWRNORM, 0}, {wake, POLLRDNORM, 0}};
  NativeScript mixed{{{10, mixed_input, {POLLRDBAND, 0, 0, 0}}, {0, mixed_input}}};
  // Another consumer drains the already-observed wake before confirmation.
  // Ordinary readiness remains real and must survive on its original entry.
  mixed.steps[1].drain_socket = wake;
  PollEntry mixed_entries[] = {{tcp.receiver, kPollPri, 0, {}}, {queued, kPollIn, 0, {}},
                               {tcp.sender, kPollOut, 0, {}}};
  bool woken = false;
  Check(ScriptedPoll(mixed, mixed_entries, 3, 10, wake, &woken) == 2 &&
            mixed_entries[0].revents == 0 && mixed_entries[1].revents == kPollIn &&
            mixed_entries[2].revents == kPollOut && woken &&
            ScriptComplete(mixed), "confirmation preserves mixed readiness and an already-observed wake");
  Check(::closesocket(wake) == 0, "close confirmation wake socket");

  sockaddr_in retired_address;
  const SOCKET retiring = Udp(&retired_address);
  auto description = std::make_shared<SocketDescription>();
  const std::vector<WSAPOLLFD> retiring_input{
      {retiring, POLLRDBAND, 0}, {tcp.receiver, POLLRDBAND, 0},
      {retiring, POLLRDBAND, 0}, {queued, POLLRDNORM, 0}};
  NativeScript retired{{{10, retiring_input, {POLLRDBAND, 0, POLLRDBAND, 0}}, {0, retiring_input},
                       {0, {{tcp.receiver, POLLRDBAND, 0}, {queued, POLLRDNORM, 0}}}}};
  retired.steps[1].retire_socket = retiring;
  retired.steps[1].retire_description = description.get();
  retired.steps[1].error = WSAENOTSOCK;
  PollEntry retirement[] = {{retiring, kPollPri, 0, description},
                            {tcp.receiver, kPollPri, 0, {}}, {retiring, kPollPri, 0, description},
                            {queued, kPollIn, 0, {}}};
  Check(ScriptedPoll(retired, retirement, 4, 10) == 3 &&
            retirement[0].revents == kPollNval && retirement[1].revents == 0 &&
            retirement[2].revents == kPollNval && retirement[3].revents == kPollIn && ScriptComplete(retired),
        "confirmation error retires owned aliases and preserves compacted identities");
  CloseTcp(tcp);
  std::puts("native priority confirmation: early/current/zero/read/error/wake/retirement PASS");
}
static void RealDelayedPriority() {
  using namespace gesher::ws;
  for (int cycle = 0; cycle < 64; ++cycle) {
    TcpPair pair = Tcp();
    std::atomic<bool> sent{false};
    std::thread sender([&] {
      Sleep(40);
      char byte = '?';
      WSABUF buffer{1, &byte};
      DWORD bytes = 0;
      sent = WSASendTo(pair.sender, &buffer, 1, &bytes, MSG_OOB,
                       nullptr, 0, nullptr, nullptr) == 0 && bytes == 1;
    });
    PollEntry priority{pair.receiver, kPollPri, 0, {}};
    // fd.cc owns the public deadline and bounds native socket waits to 10ms.
    // Exercise that interface here without changing the full TCP contract.
    const ULONGLONG deadline = GetTickCount64() + 2000;
    int result = 0;
    for (;;) {
      const ULONGLONG now = GetTickCount64();
      const int wait = now >= deadline ? 0 : static_cast<int>(std::min<ULONGLONG>(10, deadline - now));
      result = Poll(&priority, 1, wait);
      if (result != 0 || GetTickCount64() >= deadline) break;
    }
    Check(result == 1 && priority.revents == kPollPri, "real delayed urgent arrival meets original deadline");
    Check(Poll(&priority, 1, 0) == 1 && priority.revents == kPollPri,
          "real delayed urgent level survives immediate zero sample before sender join");
    sender.join();
    Check(sent, "real delayed urgent send completed exactly one byte");
    char byte = 0;
    WSABUF buffer{1, &byte};
    DWORD bytes = 0, flags = MSG_OOB;
    Check(WSARecvFrom(pair.receiver, &buffer, 1, &bytes, &flags, nullptr, nullptr, nullptr, nullptr) == 0 &&
              bytes == 1 && byte == '?', "real delayed urgent byte is preserved until receive");
    Check(Poll(&priority, 1, 0) == 0 && priority.revents == 0, "real consumed urgent level is not cached");
    CloseTcp(pair);
  }
  std::puts("native priority confirmation: 64 real delayed arrivals and strict before-join repolls PASS");
}
struct Reentry {
  SOCKET queued, empty;
  bool when_before = true;
  bool valid = true;
  unsigned before = 0, after = 0;
};
static void Reenter(bool before, int, int, void* raw) {
  auto& state = *static_cast<Reentry*>(raw);
  if (before) ++state.before;
  else ++state.after;
  if (before != state.when_before) return;
  gesher::ws::PollEntry nested[7];
  for (auto& p : nested) p = {state.empty, gesher::ws::kPollIn, 0, {}};
  nested[3].socket = state.queued;
  const int ready = gesher::ws::Poll(nested, 7, 0);
  state.valid &= ready == 1;
  for (unsigned i = 0; i < 7; ++i)
    state.valid &= nested[i].revents == (i == 3 ? gesher::ws::kPollIn : 0);
}
struct Retirement {
  SOCKET socket;
  std::shared_ptr<gesher::ws::SocketDescription> description;
  bool closed = false;
};
static void Retire(bool before, int, int, void* raw) {
  if (!before) return;
  auto& state = *static_cast<Retirement*>(raw);
  state.closed = ::closesocket(state.socket) == 0;
  std::lock_guard<std::mutex> lock(state.description->error_mutex);
  state.description->native_closed = true;
  // Deterministically enter recovery; the subsequent WSAPoll is real.
  inject_native_error = WSAENOTSOCK;
}

int main(int argc, char** argv) {
  using namespace gesher::ws;
  const bool enforce = argc < 2 || std::strcmp(argv[1], "measure") != 0;
  WSADATA data;
  Check(WSAStartup(MAKEWORD(2, 2), &data) == 0, "Winsock startup");
  sockaddr_in queued_address, empty_address, sender_address;
  const SOCKET queued = Udp(&queued_address), empty = Udp(&empty_address), sender = Udp(&sender_address);
  Queue(sender, queued_address);
  PriorityConfirmationControls(queued, sender);
  RealDelayedPriority();
  PollEntry pair[] = {{queued, kPollIn, 0, {}}, {empty, kPollIn, 0, {}}};
  Check(Poll(pair, 2, 0) == 1 && pair[0].revents == kPollIn && pair[1].revents == 0, "real native readiness order");
  for (int mask = 0; mask < 8; ++mask) {
    PollEntry p{queued, mask, 123, {}};
    Check(Poll(&p, 1, 0) >= 0, "native mask sample");
    Check((p.revents & (kPollIn | kPollOut | kPollPri)) == (mask & (kPollIn | kPollOut)), "requested mask only");
  }
  bool woken = false;
  Check(Poll(nullptr, 0, 0, nullptr, nullptr, queued, &woken) == 0 && woken, "wake socket is not a result entry");
  Reentry reentry{queued, empty};
  Check(Poll(pair, 2, 0, Reenter, &reentry) == 1, "outer sample survives reentrant observer");
  Check(reentry.valid && reentry.before == 1 && reentry.after == 1 &&
        pair[0].revents == kPollIn && pair[1].revents == 0, "nested storage and outer identities isolated");
  // Independent QA: reentry after WSAPoll has written readiness must not
  // overwrite the outer active[] results before they are mapped back.
  Reentry after_reentry{queued, empty, false};
  Check(Poll(pair, 2, 0, Reenter, &after_reentry) == 1 && after_reentry.valid &&
            after_reentry.before == 1 && after_reentry.after == 1 &&
            pair[0].revents == kPollIn && pair[1].revents == 0,
        "post-native observer reentry preserves completed outer readiness");

  auto description = std::make_shared<SocketDescription>();
  description->native_nonblocking_datagram = true;
  PollEntry owned{queued, kPollIn, 0, description};
  Check(Poll(&owned, 1, 0) == 1 && owned.revents == kPollIn, "owned datagram readiness");
  char peek = 0;
  Check(::recv(queued, &peek, 1, MSG_PEEK) == 1 && peek == 'x', "readiness peek does not consume datagram");
  PollEntry no_interest{queued, 0, 123, description};
  Check(Poll(&no_interest, 1, 0) == 0 && no_interest.revents == 0, "unrequested datagram readability suppressed");
  description->native_closing = true;
  Check(Poll(&owned, 1, 0) == 1 && owned.revents == kPollNval, "closing description reports invalid");
  description->native_closing = false;
  Check(Poll(&owned, 1, 0) == 1 && owned.revents == kPollIn, "scratch closed flags reset on next sample");
  // Completion transport is deliberately a boundary in this fixture, but a
  // pending entry must still be excluded without leaving a cached flag behind.
  description->connect_operation = std::make_shared<ConnectOperation>();
  Check(Poll(&owned, 1, 0) == 0 && owned.revents == 0, "pending owned entry excluded from native readiness");
  description->connect_operation.reset();
  Check(Poll(&owned, 1, 0) == 1 && owned.revents == kPollIn, "scratch pending flags reset after completion");

  sockaddr_in retired_address;
  const SOCKET retired_socket = Udp(&retired_address);
  auto retired_description = std::make_shared<SocketDescription>();
  Retirement retirement{retired_socket, retired_description};
  PollEntry retiring[] = {{empty, kPollIn, 0, {}}, {retired_socket, kPollIn, 0, retired_description}, {queued, kPollIn, 0, {}}};
  Check(Poll(retiring, 3, 0, Retire, &retirement) == 2 && retirement.closed, "retired native entry is removed on retry");
  Check(retiring[0].revents == 0 && retiring[1].revents == kPollNval && retiring[2].revents == kPollIn,
        "stable retry compaction preserves original indices");

  for (size_t count : {size_t(1), size_t(8), size_t(64), size_t(256)}) {
    std::vector<PollEntry> entries(count, {queued, kPollIn, 0, {}});
    Check(Poll(entries.data(), count, 0) == static_cast<int>(count), "warm native scratch");
    allocations = allocated_bytes = 0;
    tracking = true;
    bool valid = true;
    for (int i = 0; i < 100; ++i) valid &= Poll(entries.data(), count, 0) == static_cast<int>(count);
    tracking = false;
    Check(valid, "warmed native result count");
    std::printf("native poll sockets=%zu samples=100 allocations=%zu bytes=%zu\n", count, allocations, allocated_bytes);
    if (enforce) Check(allocations == 0, "warmed bounded scratch has no C++ allocation");
  }
  // Calls above the bound may allocate, and must release their large arrays.
  std::vector<PollEntry> large(257, {queued, kPollIn, 0, {}});
  const size_t retained_before = live_tracked_bytes.load();
  allocations = allocated_bytes = 0;
  tracking = true;
  const int large_result = Poll(large.data(), large.size(), 0);
  tracking = false;
  Check(large_result == 257 && allocations > 0, "large call uses local fallback");
  Check(live_tracked_bytes == retained_before, "large call releases every newly allocated scratch byte");
  Check(Poll(&owned, 1, 0) == 1, "return to small scratch after large call");

  // Unrequested queued data must not hide later requested readiness on a
  // different socket, and recursive samples should reuse the released cache.
  PollEntry delayed[] = {{queued, 0, 0, description}, {empty, kPollIn, 0, {}}};
  Check(Poll(delayed, 2, 0) == 0, "warm suppressed-read sample");
  std::atomic<bool> later_sent{false};
  std::thread later([&] {
    Sleep(25);
    later_sent = ::sendto(sender, "y", 1, 0, reinterpret_cast<const sockaddr*>(&empty_address), sizeof(empty_address)) == 1;
  });
  allocations = allocated_bytes = 0;
  tracking = true;
  const int resumed = Poll(delayed, 2, 1000);
  tracking = false;
  later.join();
  Check(resumed == 1 && delayed[0].revents == 0 && delayed[1].revents == kPollIn && later_sent,
        "recursive datagram resampling eventually reports current readiness");
  if (enforce) Check(allocations == 0, "recursive samples release and reuse bounded scratch");
  Empty(empty);
  Check(Poll(&no_interest, 1, 15) == 0 && no_interest.revents == 0, "suppressed-read timeout preserves empty result");

  std::atomic<bool> threads_valid{true};
  std::vector<std::thread> readers;
  for (int t = 0; t < 4; ++t) readers.emplace_back([&] {
    PollEntry input{queued, kPollIn, 0, {}};
    if (Poll(&input, 1, 0) != 1) threads_valid = false;
    allocations = allocated_bytes = 0;
    tracking = true;
    for (int i = 0; i < 100; ++i)
      if (Poll(&input, 1, 0) != 1 || input.revents != kPollIn) threads_valid = false;
    tracking = false;
    if (enforce && allocations != 0) threads_valid = false;
  });
  for (auto& reader : readers) reader.join();
  Check(threads_valid, "separate polling threads have isolated warmed scratch");
  // Track a cold cache inside a short-lived thread, after its fixture inputs
  // are allocated. Destruction at thread exit must release retained arrays.
  const size_t thread_bytes_before = live_tracked_bytes.load();
  std::atomic<bool> retired_thread_valid{true};
  size_t retained_arrays = 0, retained_object = 0;
  size_t fds_capacity = 0, active_capacity = 0, index_capacity = 0;
  std::thread retired_reader([&] {
    std::vector<PollEntry> input(256, {queued, kPollIn, 0, {}});
    tracking = true;
    bool valid = true;
    // Grow a cold cache incrementally, including a wake socket alongside the
    // largest entry set. This observes retained capacities, not just warmed
    // allocation counts; the optional wake must not double the native array.
    for (size_t count = 1; count <= input.size(); ++count) {
      bool awakened = false;
      valid &= Poll(input.data(), count, 0, nullptr, nullptr, queued, &awakened) == static_cast<int>(count);
      valid &= awakened;
    }
    tracking = false;
    retained_arrays = live_tracked_bytes.load() - thread_bytes_before;
#ifdef GESHER_NATIVE_POLL_CACHED_SCRATCH
    if (enforce) {
      PollScratchLease snapshot(0);
      const auto& scratch = snapshot.get();
      fds_capacity = scratch.fds.capacity();
      active_capacity = scratch.active.capacity();
      index_capacity = scratch.active_index.capacity();
      retained_object = sizeof(PollScratch);
      valid &= retained_arrays ==
          (fds_capacity + active_capacity) * sizeof(NativePollFd) + index_capacity * sizeof(size_t) +
          (scratch.lifecycle_hup.capacity() + scratch.owned_pending.capacity() + scratch.closed.capacity()) / 8;
      valid &= retained_arrays + retained_object <= 12 * 1024;
    }
#endif
    if (!valid || (enforce && retained_arrays == 0))
      retired_thread_valid = false;
  });
  retired_reader.join();
  std::printf("native poll cold incremental+wake retained_arrays=%zu tls_object=%zu fds_capacity=%zu active_capacity=%zu index_capacity=%zu\n",
              retained_arrays, retained_object, fds_capacity, active_capacity, index_capacity);
  Check(retired_thread_valid && live_tracked_bytes == thread_bytes_before,
        "polling thread exit releases every retained scratch byte");
  Empty(queued);
  Check(Poll(&owned, 1, 0) == 0 && owned.revents == 0, "consumed readiness is not cached");
  ::closesocket(queued);
  ::closesocket(empty);
  ::closesocket(sender);
  WSACleanup();
  std::printf("native poll scratch contracts: %zu PASS\n", checks);
}
