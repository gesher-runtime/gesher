// Actual parsing/public admission with a recording deletion-queue boundary;
// actual quota dispatch with a recording COM boundary. No browser is created.
// Backend deletion/lifecycle is tested by --storage-delete, not this recorder.
#include "com_util.h"
#include <urlmon.h>
#include <shlwapi.h>
#include <cstdio>
#include <memory>
#include <string>
#include <vector>

using namespace gesher::webview;

namespace {
int checks, failures, submissions, completions, live_work;
bool accept = true, available = true;
HRESULT completed_status = S_OK;
int64_t completed_id = 0;
constexpr int32_t kGlobalDone = 2, kGlobalStorage = 3;
int32_t expected_type = kGlobalDone;
std::wstring completed_payload;

void Check(bool condition, const char* description) {
  ++checks;
  if (!condition) {
    ++failures;
    std::fprintf(stderr, "FAIL: %s\n", description);
  }
}

struct GlobalOperation {
  GlobalOperation() { ++live_work; }
  ~GlobalOperation() { --live_work; }
};
using GlobalWork = std::shared_ptr<GlobalOperation>;
struct GlobalCompletion {
  explicit GlobalCompletion(const GlobalWork& work) : operation(work) {}
  GlobalWork operation;
};

void ReportGlobal(int32_t type, int64_t id, int32_t status, const std::wstring& value) {
  Check(type == expected_type, "completion event type");
  completed_payload = value;
  ++completions;
  completed_status = status;
  completed_id = id;
}

struct RecordingCore {
  HRESULT result = S_OK;
  int calls = 0;
  std::wstring method, parameters;
  Com<ICoreWebView2CallDevToolsProtocolMethodCompletedHandler> callback;
  HRESULT CallDevToolsProtocolMethod(LPCWSTR name, LPCWSTR params,
      ICoreWebView2CallDevToolsProtocolMethodCompletedHandler* handler) {
    ++calls;
    method = name;
    parameters = params;
    callback = Com<ICoreWebView2CallDevToolsProtocolMethodCompletedHandler>(handler);
    return result;
  }
} core;

void WithCoreWebView(std::function<void(RecordingCore*)> fn) {
  fn(available ? &core : nullptr);
}
bool PostGlobal(std::function<void(const GlobalWork&)> fn) {
  ++submissions;
  if (!accept) return false;
  GlobalWork operation = std::make_shared<GlobalOperation>();
  fn(operation);
  return true;
}

struct RecordedDeletion {
  std::wstring origin;
  int64_t id;
  GlobalWork lease;
};
std::vector<RecordedDeletion> recorded_deletions;
[[maybe_unused]] void QueueOriginStorageDelete(const GlobalWork& operation,
                                               std::wstring origin, int64_t id) {
  recorded_deletions.push_back({std::move(origin), id, operation});
}

// These helpers are extracted byte-for-byte from webview_host.cc.
@JSON_STRING@
@ORIGIN_STORAGE_KEY@

class Host {
 public:
  static bool ClearOriginData(const std::wstring& origin, int64_t callback_id);
  static bool QueryOriginStorage(const std::wstring& origin, int64_t callback_id);
};

// The only source substitution changes COM receiver types to RecordingCore.
// The actual public deletion method must validate before its recording queue.
// Quota dispatch, callback/HRESULT handling and leases remain actual code.
@CLEAR_ORIGIN_DATA@
@QUERY_ORIGIN_STORAGE@

void Reset() {
  core.callback.Reset();
  recorded_deletions.clear();
  Check(live_work == 0, "recording boundary released retained admission leases");
  core.result = S_OK;
  core.calls = 0;
  core.method.clear();
  core.parameters.clear();
  submissions = completions = 0;
  expected_type = kGlobalDone;
  completed_payload.clear();
  accept = available = true;
}

void ValidOrigins() {
  struct Case { const wchar_t* input; const wchar_t* key; };
  const Case cases[] = {
      {L"http://example.invalid", L"http://example.invalid/"},
      {L"HTTPS://EXAMPLE.INVALID:443/", L"https://example.invalid/"},
      {L"http://example.invalid:80", L"http://example.invalid/"},
      {L"https://example.invalid:8443", L"https://example.invalid:8443/"},
      {L"http://localhost:0", L"http://localhost:0/"},
      {L"http://127.0.0.1:8080/", L"http://127.0.0.1:8080/"},
      {L"https://[::1]", L"https://[::1]/"},
      {L"https://[::1]:8443", L"https://[::1]:8443/"},
      {L"https://[2001:db8::1]:443/", L"https://[2001:db8::1]/"},
      {L"https://xn--bcher-kva.invalid", L"https://xn--bcher-kva.invalid/"},
  };
  for (const auto& item : cases) {
    Reset();
    std::wstring key;
    Check(OriginStorageKey(item.input, &key), "valid origin accepted by native parser");
    Check(key == item.key, "canonical first-party storage key");
    Check(Host::ClearOriginData(item.input, 41), "valid origin dispatched");
    Check(submissions == 1 && recorded_deletions.size() == 1, "exactly one queued deletion");
    Check(!recorded_deletions.empty() && recorded_deletions.front().origin == item.key &&
          recorded_deletions.front().id == 41, "canonical origin and callback passed to backend");
    Check(completions == 0 && live_work == 1, "queued operation receives its admission lease");
    Check(core.calls == 0, "admission does not bypass the full deletion backend");
  }
}

void InvalidOrigins() {
  const std::vector<std::wstring> cases = {
      L"", L"null", L"not an origin\"\n", L"https://", L"https:example.invalid",
      L"//example.invalid", L"about:blank", L"data:text/plain,hello",
      L"blob:https://example.invalid/id", L"file://", L"file:///", L"file://localhost/",
      L"custom://example.invalid", L"content://example.invalid", L"ftp://example.invalid",
      L"https://example.invalid/path", L"https://example.invalid/?q=1",
      L"https://example.invalid/#fragment", L"https://user@example.invalid",
      L"https://example.invalid:65536", L"https://example.invalid:-1",
      L"https://example.invalid:bad", L"https://[invalid]", L"https://exa mple.invalid",
      L"https://example.invalid\\", L"https://example.invalid%00", L"https://example.invalid/^0",
      L"https://example.invalid\n", L" https://example.invalid", L"https://b\u00fccher.invalid",
      std::wstring(L"https://example.invalid\0ignored", 31),
  };
  for (const auto& input : cases) {
    Reset();
    std::wstring key = L"old key";
    Check(!OriginStorageKey(input, &key) && key.empty(), "invalid origin has no storage key");
    Check(!Host::ClearOriginData(input, 17), "direct Host rejects invalid origin");
    Check(submissions == 0 && core.calls == 0 && recorded_deletions.empty(),
          "invalid origin never enters work queue");
    Check(completions == 0 && live_work == 0, "rejection has no callback or lease");
  }
}

void FailuresAndEncoding() {
  Reset();
  accept = false;
  Check(!Host::ClearOriginData(L"https://example.invalid", 8), "admission failure propagated");
  Check(recorded_deletions.empty() && core.calls == 0 && completions == 0 && live_work == 0,
        "rejected admission is inert");

  Reset();
  Check(Host::ClearOriginData(L"https://example.invalid", 10), "first independent deletion admitted");
  Check(Host::ClearOriginData(L"http://other.invalid:8080", 11), "second independent deletion admitted");
  Check(recorded_deletions.size() == 2 && live_work == 2 && completions == 0,
        "separate admissions retain separate operation leases");
  Check(recorded_deletions.size() == 2 && recorded_deletions[0].id == 10 && recorded_deletions[1].id == 11 &&
        recorded_deletions[1].origin == L"http://other.invalid:8080/",
        "queued origins and callbacks remain paired");

  Check(JsonString(std::wstring(L"\"\\\n\r\t\0", 6)) == L"\"\\\"\\\\\\n\\r\\t\\u0000\"",
        "JSON string escapes preserve property boundaries");
  Reset();
}
void QueryMeasurements() {
  Reset();
  expected_type = kGlobalStorage;
  Check(Host::QueryOriginStorage(L"HTTPS://EXAMPLE.INVALID:443", 91), "real quota query admitted");
  Check(core.method == L"Storage.getUsageAndQuota", "query uses actual Chromium quota manager");
  Check(core.parameters == L"{\"origin\":\"https://example.invalid/\"}", "canonical first-party origin passed");
  Check(live_work == 1 && completions == 0, "query owns asynchronous work lease");
  if (core.callback) {
    core.callback->Invoke(S_OK, L"{\"usage\":1234,\"quota\":99999}");
    Check(completed_payload == L"{\"usage\":1234,\"quota\":99999}" &&
          completed_id == 91 && completed_status == S_OK && live_work == 0,
          "real measurement forwarded without invented values");
    core.callback->Invoke(S_OK, L"{\"usage\":7}");
    Check(completions == 1, "duplicate query completion ignored");
  }
  Reset();
  Check(!Host::QueryOriginStorage(L"https://example.invalid/path", 92), "query rejects non-origin before dispatch");
  Check(submissions == 0 && core.calls == 0, "invalid query never starts work");
  Reset();
  expected_type = kGlobalStorage;
  available = false;
  Check(Host::QueryOriginStorage(L"https://example.invalid", 93), "unavailable query admitted");
  Check(completions == 1 && FAILED(completed_status) && completed_payload.empty() && live_work == 0,
        "unavailable query reports failure and releases lease");
  Reset();
  expected_type = kGlobalStorage;
  core.result = E_FAIL;
  Check(Host::QueryOriginStorage(L"https://example.invalid", 94), "failed query submission admitted");
  Check(completions == 1 && completed_status == E_FAIL && completed_payload.empty() && live_work == 0,
        "COM query failure releases lease");
  if (core.callback) core.callback->Invoke(S_OK, L"{\"usage\":1234}");
  Check(completions == 1, "late callback after submission failure ignored");
  Reset();
  expected_type = kGlobalStorage;
  Check(Host::QueryOriginStorage(L"https://example.invalid", 95), "async failed query admitted");
  if (core.callback) core.callback->Invoke(E_FAIL, L"{\"usage\":1234}");
  Check(completions == 1 && completed_payload.empty() && live_work == 0,
        "failure never reports a spurious measurement");
  Reset();
}
}  // namespace

int main() {
  ValidOrigins();
  InvalidOrigins();
  FailuresAndEncoding();
  QueryMeasurements();
  std::printf("WebStorage native contracts: %d checks, %d failures\n", checks, failures);
  return failures == 0 ? 0 : 1;
}
