#include <algorithm>
#include <cerrno>
#include <climits>
#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <string>
#include <vector>
#ifdef _WIN32
#include <windows.h>
#else
#include <sys/mman.h>
#include <unistd.h>
#endif

namespace production {
void* Memrchr(const void*, int, size_t);
void* MemrchrChk(const void*, int, size_t, size_t);
}

static size_t assertions = 0;
static void check(const char* label, bool success) {
  ++assertions;
  if (!success) {
    std::fprintf(stderr, "FAIL %s\n", label);
    std::exit(1);
  }
}
#include "memrchr_contract.inc"

struct Guarded {
  uint8_t* memory;
  size_t page;
  Guarded() {
#ifdef _WIN32
    SYSTEM_INFO info;
    GetSystemInfo(&info);
    page = info.dwPageSize;
    memory = static_cast<uint8_t*>(VirtualAlloc(nullptr, page * 3,
        MEM_RESERVE | MEM_COMMIT, PAGE_NOACCESS));
    DWORD previous;
    check("guard pages allocated", memory &&
          VirtualProtect(memory + page, page, PAGE_READWRITE, &previous));
#else
    page = static_cast<size_t>(sysconf(_SC_PAGESIZE));
    memory = static_cast<uint8_t*>(mmap(nullptr, page * 3, PROT_NONE,
                                      MAP_PRIVATE | MAP_ANONYMOUS, -1, 0));
    check("guard pages allocated", memory != MAP_FAILED &&
          mprotect(memory + page, page, PROT_READ | PROT_WRITE) == 0);
#endif
  }
  ~Guarded() {
#ifdef _WIN32
    VirtualFree(memory, 0, MEM_RELEASE);
#else
    munmap(memory, page * 3);
#endif
  }
};

static size_t GuardChecks() {
  Guarded allocation;
  size_t cases = 0;
  // Start/end placement includes every length and alignment through 256,
  // then larger page-edge ranges. PROT_NONE pages make under/overreads fatal.
  std::vector<size_t> lengths;
  for (size_t length = 0; length <= 256; ++length) lengths.push_back(length);
  for (size_t length : {size_t(511), size_t(512), size_t(513),
                       allocation.page - 1, allocation.page}) lengths.push_back(length);
  for (bool end : {false, true}) for (size_t length : lengths) {
    uint8_t* bytes = allocation.memory + allocation.page + (end ? allocation.page - length : 0);
    std::memset(bytes, 0x81, length);
    check("guarded range miss", production::Memrchr(bytes, 0x80, length) == nullptr);
    ++cases;
    for (size_t position = 0; position < length; ++position) {
      bytes[position] = 0x80;
      check("guarded exact last occurrence", production::Memrchr(bytes, 0x180, length) == bytes + position);
      bytes[position] = 0x81;
      ++cases;
    }
  }
  // Preserve the pre-existing shim's zero-length null behavior without
  // treating it as a promise made by Android's nonnull public declaration.
  check("existing shim null empty range", production::Memrchr(nullptr, 0, 0) == nullptr);
  return cases + 1;
}

int main(int argc, char** argv) {
  if (argc == 2 && std::strcmp(argv[1], "tail-boundary") == 0) {
    uint8_t bytes[17];
    std::memset(bytes, 0x81, sizeof(bytes));
    bytes[0] = 0x80;
    check("word search preserves the remaining first byte",
          production::Memrchr(bytes, 0x80, sizeof(bytes)) == bytes);
    return 0;
  }
  if (argc == 2 && std::strcmp(argv[1], "guard-boundary") == 0) {
    Guarded allocation;
    uint8_t* bytes = allocation.memory + allocation.page;
    std::memset(bytes, 0x81, 16);
    check("complete word at the lower range bound", production::Memrchr(bytes, 0x80, 16) == nullptr);
    return 0;
  }
  if (argc == 2 && std::strcmp(argv[1], "fortify") == 0) {
    const uint8_t bytes[16] = {};
    production::MemrchrChk(bytes, 0, sizeof(bytes), sizeof(bytes) - 1);
    std::fprintf(stderr, "FAIL FORTIFY did not reject the oversized range\n");
    return 44;
  }
  if (argc == 2 && std::strcmp(argv[1], "guard") == 0) {
    const size_t cases = GuardChecks();
    std::printf("memrchr guard: %zu exact calls, %zu assertions passed\n", cases, assertions);
    return 0;
  }
  if (argc != 1) return 2;
  const size_t shared = test_memrchr_contracts(production::Memrchr, production::MemrchrChk);
  const size_t guarded = GuardChecks();
  std::printf("memrchr: %zu shared and %zu guarded exact calls, %zu assertions passed\n",
              shared, guarded, assertions);
  return 0;
}
