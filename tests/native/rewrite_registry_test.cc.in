// Production Rewriter::Finish with native allocation/cache boundaries omitted.
// Repeated registration must redirect to the current stub and keep other sites.
#include <algorithm>
#include <cstdint>
#include <cstdio>
#include <map>
#include <set>
#include <string>
#include <vector>
using DWORD = unsigned long;
constexpr uintptr_t kPage = 4096, kStubChunk = 65536;
constexpr size_t kFingerprintSide = 16, kFingerprintMin = 12;
constexpr int PAGE_EXECUTE_READ = 32;
uintptr_t PageOf(uintptr_t value) { return value & ~(kPage - 1); }
bool VirtualProtect(void*, size_t, int, DWORD*) { return true; }
void* GetCurrentProcess() { return nullptr; }
void FlushInstructionCache(void*, void*, size_t) {}
int g_lock;
void AcquireSRWLockExclusive(int*) {}
void ReleaseSRWLockExclusive(int*) {}
void EnsureHandler() {}
bool ReadSafely(uintptr_t, void*, size_t) { return false; }
struct TrapSite { uintptr_t addr, stub; };
struct StubArena { uint8_t* base; size_t used; };
struct CodeRange { uintptr_t start, end; const char* name; uintptr_t bias; bool stub; };
struct LazyObject { const char* name = "test"; uintptr_t bias = 0; std::vector<StubArena> arenas; };
struct SyscallFingerprint { const LazyObject* owner; uint8_t length, before, after, bytes[47]; };
std::vector<TrapSite>& Traps() { static std::vector<TrapSite> value; return value; }
std::map<uintptr_t, uint8_t>& SyscallSites() { static std::map<uintptr_t, uint8_t> value; return value; }
std::vector<SyscallFingerprint>& Fingerprints() { static std::vector<SyscallFingerprint> value; return value; }
std::vector<CodeRange>& Ranges() { static std::vector<CodeRange> value; return value; }
struct Rewriter {
  bool deferred_ = true;
  LazyObject* o_;
  std::string* error_ = nullptr;
  std::vector<TrapSite> traps_;
  std::vector<std::pair<uintptr_t, uint8_t>> syscalls_;
  size_t first_new_arena_ = 0;
  bool Finish(const std::vector<CodeRange>&);
};

@PRODUCTION_FINISH@

int main() {
  LazyObject object;
  Rewriter first;
  first.o_ = &object;
  first.traps_ = {{0x10010, 11}, {0x10020, 22}};
  if (!first.Finish({})) return 1;
  Rewriter second;
  second.o_ = &object;
  second.traps_ = {{0x10010, 33}, {0x10030, 44}};
  if (!second.Finish({})) return 1;
  bool ok = Traps().size() == 3 && Traps()[0].addr == 0x10010 && Traps()[0].stub == 33 &&
            Traps()[1].addr == 0x10020 && Traps()[1].stub == 22 &&
            Traps()[2].addr == 0x10030 && Traps()[2].stub == 44;
  std::printf("rewrite registry: current stub replaces old, unrelated sites remain %s\n", ok ? "PASS" : "FAIL");
  return !ok;
}
