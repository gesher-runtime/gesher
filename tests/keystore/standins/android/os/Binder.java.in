// Host stand-in of the Android boundary for tools/test_keystore_auth_contracts.py (ADR 0092):
// only what the production classes under test call, with android-16.0.0_r4 values.
package android.os;

import java.util.ArrayList;
import java.util.List;

/** A local binder: transact runs onTransact in the caller's thread, as in one process. */
public class Binder implements IBinder {
    /** The identity the next transactions arrive with (the tests set them). */
    public static volatile int callingUid = 10123;
    public static volatile int callingPid = 4321;

    private final String mDescriptor;
    private final List<DeathRecipient> mRecipients = new ArrayList<>();

    public Binder() {
        this(null);
    }

    public Binder(String descriptor) {
        mDescriptor = descriptor;
    }

    public static int getCallingUid() {
        return callingUid;
    }

    public static int getCallingPid() {
        return callingPid;
    }

    public String getInterfaceDescriptor() {
        return mDescriptor;
    }

    protected boolean onTransact(int code, Parcel data, Parcel reply, int flags)
            throws RemoteException {
        return false;
    }

    @Override
    public final boolean transact(int code, Parcel data, Parcel reply, int flags)
            throws RemoteException {
        data.setDataPosition(0);
        boolean handled = onTransact(code, data, reply, flags);
        reply.setDataPosition(0);
        return handled;
    }

    @Override
    public synchronized void linkToDeath(DeathRecipient recipient, int flags) {
        mRecipients.add(recipient);
    }

    /** Test control: the process that owns this binder died. */
    public void die() {
        List<DeathRecipient> recipients;
        synchronized (this) {
            recipients = new ArrayList<>(mRecipients);
            mRecipients.clear();
        }
        for (DeathRecipient r : recipients) r.binderDied();
    }
}
