// Host stand-in of the Android boundary for tools/test_keystore_auth_contracts.py (ADR 0092):
// only what the production classes under test call, with android-16.0.0_r4 values.
package android.app;

public final class ActivityThread {
    /** The app the tests run as. */
    public static Application application;

    private ActivityThread() {
    }

    public static Application currentApplication() {
        return application;
    }
}
