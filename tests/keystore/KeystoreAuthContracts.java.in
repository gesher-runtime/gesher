public final class KeystoreAuthContracts {
    private static int failures, checks;

    static void check(boolean condition, String description) {
        checks++;
        System.out.println((condition ? "PASS " : "FAIL ") + description);
        if (!condition) failures++;
    }

    interface Action {
        void run() throws Exception;
    }

    /** The exception {@code action} throws, or null. */
    static Throwable thrown(Action action) {
        try {
            action.run();
            return null;
        } catch (Throwable t) {
            return t;
        }
    }

    static boolean causedBy(Throwable t, Class<?> type, String fragment) {
        Throwable cause = t != null ? t.getCause() : null;
        return type.isInstance(cause) && (fragment == null
                || String.valueOf(cause.getMessage()).contains(fragment));
    }

    // --- the isolated Windows Hello key store ---------------------------------------------

    static final class TestHelloKeys implements HelloKeyBackend {
        final Map<String, KeyPair> keys = new HashMap<>();
        boolean supported = true;
        boolean pss;              // sign as RSASSA-PSS, the other documented possibility
        boolean hold;             // signatures wait for complete()
        int createStatus = SUCCESS;
        int signStatus = SUCCESS;
        int creates, signs, opens, deletes, cancels;
        final List<Integer> pids = new ArrayList<>();
        final List<Runnable> held = new ArrayList<>();

        public synchronized boolean isSupported() {
            return supported;
        }

        public synchronized Result create(String name, int pid) {
            creates++;
            pids.add(pid);
            if (createStatus != SUCCESS) return new Result(createStatus, null);
            if (keys.containsKey(name)) return new Result(CREDENTIAL_ALREADY_EXISTS, null);
            try {
                KeyPairGenerator g = KeyPairGenerator.getInstance("RSA");
                g.initialize(2048);
                KeyPair pair = g.generateKeyPair();
                keys.put(name, pair);
                return new Result(SUCCESS, pair.getPublic().getEncoded());
            } catch (Exception e) {
                throw new IllegalStateException(e);
            }
        }

        public synchronized Result open(String name) {
            opens++;
            KeyPair pair = keys.get(name);
            return pair == null ? new Result(NOT_FOUND, null)
                    : new Result(SUCCESS, pair.getPublic().getEncoded());
        }

        public synchronized Operation sign(String name, int pid, byte[] data,
                Completion completion) {
            signs++;
            pids.add(pid);
            final Result result = signNow(name, data);
            Runnable deliver = () -> completion.onResult(result);
            if (hold) {
                held.add(deliver);
            } else {
                Thread t = new Thread(deliver, "test-hello-key");
                t.setDaemon(true);
                t.start();
            }
            return () -> {
                synchronized (TestHelloKeys.this) {
                    cancels++;
                }
            };
        }

        private Result signNow(String name, byte[] data) {
            KeyPair pair = keys.get(name);
            if (pair == null) return new Result(NOT_FOUND, null);
            if (signStatus != SUCCESS) return new Result(signStatus, null);
            try {
                Signature s;
                if (pss) {
                    s = Signature.getInstance("RSASSA-PSS");
                    s.setParameter(new PSSParameterSpec("SHA-256", "MGF1",
                            MGF1ParameterSpec.SHA256, 32, 1));
                } else {
                    s = Signature.getInstance("SHA256withRSA");
                }
                s.initSign(pair.getPrivate());
                s.update(data);
                return new Result(SUCCESS, s.sign());
            } catch (Exception e) {
                throw new IllegalStateException(e);
            }
        }

        public synchronized int delete(String name) {
            deletes++;
            return keys.remove(name) != null ? SUCCESS : NOT_FOUND;
        }

        /** A Windows Hello reset: Windows forgets every key. */
        synchronized void reset() {
            keys.clear();
        }

        void complete() {
            List<Runnable> work;
            synchronized (this) {
                work = new ArrayList<>(held);
                held.clear();
            }
            for (Runnable r : work) r.run();
        }

        synchronized int prompts() {
            return creates + signs;
        }
    }

    static final class TestVerifier implements WindowsHelloBackend {
        final List<Completion> completions = new ArrayList<>();
        int cancels;
        public int availability() { return AVAILABLE; }
        public Verification verify(Request request, Completion completion) {
            completions.add(completion);
            return () -> cancels++;
        }
    }

    // --- fixtures -------------------------------------------------------------------------

    static final int UID = 10123, PID = 4321;
    static final int CRED = KeyProperties.AUTH_DEVICE_CREDENTIAL;
    static final int BOTH = KeyProperties.AUTH_DEVICE_CREDENTIAL | KeyProperties.AUTH_BIOMETRIC_STRONG;
    static final AtomicLong clock = new AtomicLong(1_000_000);
    static File dir;
    static int sequence;
    static TestHelloKeys hello;
    static File bindingFile;
    static KeystoreAuthorization keys;
    /** DeviceCredential.available(): isDeviceSecure as trust reports it to apps. */
    static final java.util.concurrent.atomic.AtomicBoolean secure =
            new java.util.concurrent.atomic.AtomicBoolean(true);

    static void fresh() {
        hello = new TestHelloKeys();
        bindingFile = new File(dir, "binding-" + (sequence++) + "/gesher-keystore-binding");
        secure.set(true);
        keys = new KeystoreAuthorization(hello, bindingFile, clock::get, secure::get);
    }

    /** The system server restarted: the same file and Windows keys, nothing in memory. */
    static void restart() {
        keys = new KeystoreAuthorization(hello, bindingFile, clock::get, secure::get);
    }

    static final WindowsHelloBackend.Request REQUEST =
            new WindowsHelloBackend.Request(UID, PID, "com.example.bank", "message");

    /** A confirmation through the binding's key, waited for; its result. */
    static int confirm(KeystoreAuthorization k, int uid, long operationId) throws Exception {
        CountDownLatch done = new CountDownLatch(1);
        int[] result = {Integer.MIN_VALUE};
        k.authorize(new WindowsHelloBackend.Request(uid, PID, "com.example.bank", "m"),
                operationId, r -> {
                    result[0] = r;
                    done.countDown();
                });
        if (!done.await(20, TimeUnit.SECONDS)) throw new IllegalStateException("no completion");
        return result[0];
    }

    static boolean contains(byte[] haystack, byte[] needle) {
        outer:
        for (int i = 0; i + needle.length <= haystack.length; i++) {
            for (int j = 0; j < needle.length; j++) {
                if (haystack[i + j] != needle[j]) continue outer;
            }
            return true;
        }
        return false;
    }

    static final byte[] MATERIAL = "0123456789abcdef0123456789abcdef".getBytes();

    // --- the system server's authorization ------------------------------------------------

    static void unavailable() throws Exception {
        KeystoreAuthorization none = new KeystoreAuthorization(null, new File(dir, "none"), clock::get, () -> true);
        check(none.availability() == KeystoreAuthorization.UNAVAILABLE
                        && none.seal(PID, MATERIAL, 0, CRED).status == KeystoreAuthorization.UNAVAILABLE,
                "no Windows Hello natives: unavailable, nothing is sealed");
        check(confirm(none, UID, 7) == KeystoreAuthorization.NO_BINDING && !none.isPending(UID, 7),
                "no natives: an authorization never verifies");
        fresh();
        hello.supported = false;
        check(keys.availability() == KeystoreAuthorization.UNAVAILABLE
                        && keys.seal(PID, MATERIAL, 0, CRED).status == KeystoreAuthorization.UNAVAILABLE
                        && hello.prompts() == 0 && !bindingFile.exists(),
                "Windows Hello not set up: unavailable, no prompt, no binding");
        hello.supported = true;
        check(keys.seal(PID, MATERIAL, 0, KeyProperties.AUTH_BIOMETRIC_STRONG).status
                        == KeystoreAuthorization.FAILED && hello.prompts() == 0,
                "a biometric-only key is never sealed (Windows Hello is a device credential only)");
    }

    /**
     * Combined head (#470 + #471): a key that requires user authentication is made only
     * while the device has a secure lock screen as Android reports it (DeviceCredential,
     * trust's isDeviceSecure), not merely because Windows supports Hello keys.
     */
    static void deviceCredential() throws Exception {
        fresh();
        secure.set(false);
        check(keys.availability() == KeystoreAuthorization.UNAVAILABLE
                        && keys.seal(PID, MATERIAL, 0, CRED).status == KeystoreAuthorization.UNAVAILABLE
                        && keys.seal(PID, MATERIAL, 30, CRED).status == KeystoreAuthorization.UNAVAILABLE
                        && hello.prompts() == 0 && !bindingFile.exists(),
                "Hello keys supported but the device is not secure: unavailable, no prompt, no binding");
        secure.set(true);
        check(keys.availability() == KeystoreAuthorization.OK
                        && keys.seal(PID, MATERIAL, 0, CRED).status == KeystoreAuthorization.OK,
                "the device secure: a key is sealed");
        int prompts = hello.prompts();
        secure.set(false);
        check(keys.availability() == KeystoreAuthorization.UNAVAILABLE
                        && keys.seal(PID, MATERIAL, 0, CRED).status == KeystoreAuthorization.UNAVAILABLE
                        && hello.prompts() == prompts,
                "the credential no longer reported: no new key, even with a binding, and no prompt");
    }

    static void enrollment() throws Exception {
        fresh();
        check(keys.availability() == KeystoreAuthorization.OK, "Windows Hello set up: available");
        KeystoreAuthorization.Reply sealed = keys.seal(PID, MATERIAL, 0, CRED);
        check(sealed.status == KeystoreAuthorization.OK && hello.creates == 1 && hello.signs == 1
                        && hello.pids.equals(List.of(PID, PID)),
                "the first key enrolls the binding: one key creation and one signature, for the caller's window");
        byte[] record = Files.readAllBytes(bindingFile.toPath());
        byte[] privateKey = hello.keys.values().iterator().next().getPrivate().getEncoded();
        check(!contains(sealed.data, MATERIAL) && !contains(record, MATERIAL)
                        && !contains(record, Arrays.copyOf(privateKey, 64)),
                "neither the blob nor the binding record holds the key material");
        KeystoreAuthorization.Reply second = keys.seal(PID, MATERIAL, 0, BOTH);
        check(second.status == KeystoreAuthorization.OK && hello.prompts() == 2
                        && !Arrays.equals(second.data, sealed.data),
                "later keys are sealed without any prompt, each blob different");
        check(!keys.holdsBindingKey(), "with no key that has a timeout, the binding key is not kept in memory");

        // Windows signs with PSS (the API reference's claim): no binding can be made.
        fresh();
        hello.pss = true;
        check(keys.seal(PID, MATERIAL, 0, CRED).status == KeystoreAuthorization.FAILED
                        && !bindingFile.exists() && hello.keys.isEmpty() && hello.deletes == 1,
                "a randomized (PSS) signature is refused: no binding, the Hello key is deleted again");
        fresh();
        hello.createStatus = HelloKeyBackend.USER_CANCELED;
        check(keys.seal(PID, MATERIAL, 0, CRED).status == KeystoreAuthorization.CANCELED
                        && !bindingFile.exists(), "the user cancels the key creation: CANCELED, no binding");
        hello.createStatus = HelloKeyBackend.NOT_FOREGROUND;
        check(keys.seal(PID, MATERIAL, 0, CRED).status == KeystoreAuthorization.NOT_FOREGROUND,
                "a background caller cannot enroll: NOT_FOREGROUND");
        hello.createStatus = HelloKeyBackend.SUCCESS;
        hello.signStatus = HelloKeyBackend.USER_CANCELED;
        check(keys.seal(PID, MATERIAL, 0, CRED).status == KeystoreAuthorization.CANCELED
                        && !bindingFile.exists() && hello.keys.isEmpty(),
                "the user cancels the first signature: CANCELED, no binding, no Hello key left");
    }

    static void perOperation() throws Exception {
        fresh();
        byte[] blob = keys.seal(PID, MATERIAL, 0, BOTH).data;
        Object client = new Object();
        check(keys.release(blob).status == KeystoreAuthorization.FAILED,
                "a key without a timeout is never released by time");
        KeystoreAuthorization.Reply begun = keys.begin(UID, client, blob);
        check(begun.status == KeystoreAuthorization.OK && begun.handle != 0
                        && keys.isPending(UID, begun.handle) && !keys.isPending(UID + 1, begun.handle),
                "begin gives a nonzero operation handle, pending for its uid only");
        check(keys.finish(UID, begun.handle).status == KeystoreAuthorization.NOT_AUTHENTICATED
                        && keys.finish(UID, begun.handle).status == KeystoreAuthorization.FAILED,
                "finish before authorization: NOT_AUTHENTICATED, and the operation is over");
        long handle = keys.begin(UID, client, blob).handle;
        int before = hello.signs;
        check(confirm(keys, UID + 1, handle) == WindowsHelloBackend.FAILED
                        && keys.finish(UID + 1, handle).status == KeystoreAuthorization.FAILED,
                "another uid cannot authorize or finish the operation");
        check(confirm(keys, UID, handle) == WindowsHelloBackend.VERIFIED && hello.signs == before + 2
                        && !keys.isPending(UID, handle),
                "authorization is one Windows Hello signature per request and verifies");
        KeystoreAuthorization.Reply finished = keys.finish(UID, handle);
        check(finished.status == KeystoreAuthorization.OK && Arrays.equals(finished.data, MATERIAL),
                "the authorized operation gets exactly the sealed key material");
        check(keys.finish(UID, handle).status == KeystoreAuthorization.FAILED,
                "an operation's key is released once");
        long other = keys.begin(UID, client, blob).handle;
        check(keys.finish(UID, other).status == KeystoreAuthorization.NOT_AUTHENTICATED,
                "the authorization of one operation does not authorize the next");
        check(!keys.holdsBindingKey(), "the binding key is dropped after a per-operation authorization");
        check(confirm(keys, UID, 0x7777) == WindowsHelloBackend.FAILED,
                "an unknown operation id never verifies");

        long canceled = keys.begin(UID, client, blob).handle;
        hello.signStatus = HelloKeyBackend.USER_CANCELED;
        check(confirm(keys, UID, canceled) == WindowsHelloBackend.CANCELED
                        && keys.finish(UID, canceled).status == KeystoreAuthorization.NOT_AUTHENTICATED,
                "the user cancels Windows Hello: CANCELED, the operation stays unauthorized");
        hello.signStatus = HelloKeyBackend.NOT_FOREGROUND;
        check(confirm(keys, UID, keys.begin(UID, client, blob).handle) == WindowsHelloBackend.CANCELED,
                "a caller that left the foreground: CANCELED, as the verifier's");
        hello.signStatus = HelloKeyBackend.SECURITY_DEVICE_LOCKED;
        check(confirm(keys, UID, keys.begin(UID, client, blob).handle) == WindowsHelloBackend.FAILED,
                "another Windows status: FAILED, never verified");
        hello.signStatus = HelloKeyBackend.SUCCESS;

        // Bounds and cleanup.
        int base = keys.operations();
        long first = keys.begin(UID, client, blob).handle;
        for (int i = 0; i < KeystoreAuthorization.MAX_OPERATIONS_PER_UID + 4; i++) keys.begin(UID, client, blob);
        long foreign = keys.begin(UID + 1, new Object(), blob).handle;
        check(keys.operations() <= KeystoreAuthorization.MAX_OPERATIONS_PER_UID + 1
                        && !keys.isPending(UID, first) && keys.isPending(UID + 1, foreign) && base >= 0,
                "at most " + KeystoreAuthorization.MAX_OPERATIONS_PER_UID + " operations per uid: the oldest is pruned, other uids untouched");
        keys.clientDied(client);
        check(keys.operations() == 1 && keys.isPending(UID + 1, foreign),
                "a dead client's operations are dropped, others stay");
        keys.abort(UID, foreign);
        keys.abort(UID + 1, foreign);
        check(keys.operations() == 0, "abort ends the caller's own operation only");

        // A cancel from the app reaches Windows.
        hello.hold = true;
        long held = keys.begin(UID, client, blob).handle;
        int[] result = {Integer.MIN_VALUE};
        WindowsHelloBackend.Verification v = keys.authorize(REQUEST, held, r -> result[0] = r);
        check(result[0] == Integer.MIN_VALUE, "authorize never completes before it returns");
        v.cancel();
        check(hello.cancels == 1, "cancel asks Windows to close the prompt");
        hello.complete();
        check(result[0] == WindowsHelloBackend.VERIFIED, "and the completion still reports Windows' own result");
        hello.hold = false;
    }

    static void timeouts() throws Exception {
        fresh();
        byte[] thirty = keys.seal(PID, MATERIAL, 30, BOTH).data;
        check(keys.confirmsWithKey() && keys.holdsBindingKey()
                        && Arrays.equals(keys.release(thirty).data, MATERIAL),
                "enrollment is a Windows Hello confirmation: a key with a timeout is usable within it");
        byte[] ten = keys.seal(PID, "ten-second-key!!".getBytes(), 10, CRED).data;
        restart();
        check(keys.release(thirty).status == KeystoreAuthorization.NOT_AUTHENTICATED && !keys.holdsBindingKey(),
                "after a restart nothing is unlocked: NOT_AUTHENTICATED");
        int before = hello.signs;
        check(confirm(keys, UID, 0) == WindowsHelloBackend.VERIFIED && hello.signs == before + 1,
                "a confirmation without an operation is one Windows Hello signature");
        check(Arrays.equals(keys.release(thirty).data, MATERIAL)
                        && Arrays.equals(keys.release(ten).data, "ten-second-key!!".getBytes()),
                "after it, keys with a timeout are released");
        clock.addAndGet(10_999);
        check(keys.release(ten).status == KeystoreAuthorization.OK,
                "10 s timeout, 10.999 s later: still released (keystore2 compares whole seconds)");
        clock.addAndGet(1);
        check(keys.release(ten).status == KeystoreAuthorization.NOT_AUTHENTICATED
                        && keys.release(thirty).status == KeystoreAuthorization.OK,
                "11 s later: the 10 s key is NOT_AUTHENTICATED, the 30 s key is still released");
        clock.addAndGet(20_000);
        check(keys.release(thirty).status == KeystoreAuthorization.NOT_AUTHENTICATED && !keys.holdsBindingKey(),
                "31 s later: NOT_AUTHENTICATED, and the binding key is gone from memory");

        // A per-operation authorization is also a confirmation for keys with a timeout.
        byte[] perUse = keys.seal(PID, MATERIAL, 0, BOTH).data;
        long handle = keys.begin(UID, "client", perUse).handle;
        check(confirm(keys, UID, handle) == WindowsHelloBackend.VERIFIED
                        && keys.release(thirty).status == KeystoreAuthorization.OK,
                "an operation's authorization also releases keys with a timeout, as an auth token with a challenge");

        // The authorizations are bound to the blob.
        byte[] longer = thirty.clone();
        longer[4 + 16 + 3] = 100;  // the timeout in the header: 30 -> 100 seconds
        check(keys.release(longer).status == KeystoreAuthorization.FAILED,
                "a blob whose timeout was edited does not open");
        byte[] asTimed = perUse.clone();
        asTimed[4 + 16 + 3] = 30;
        check(keys.release(asTimed).status == KeystoreAuthorization.FAILED,
                "a per-operation blob edited into a timed one does not open");
        check(keys.release(new byte[] {1, 2, 3}).status == KeystoreAuthorization.FAILED
                        && keys.begin(UID, "c", null).status == KeystoreAuthorization.FAILED,
                "garbage is not a blob");
    }

    static void invalidation() throws Exception {
        fresh();
        byte[] timed = keys.seal(PID, MATERIAL, 30, BOTH).data;
        byte[] perUse = keys.seal(PID, MATERIAL, 0, BOTH).data;
        long pending = keys.begin(UID, "c", perUse).handle;
        hello.reset();
        clock.addAndGet(6_000);  // past the liveness cache
        check(keys.release(timed).status == KeystoreAuthorization.INVALIDATED
                        && keys.begin(UID, "c", perUse).status == KeystoreAuthorization.INVALIDATED
                        && !bindingFile.exists() && !keys.isPending(UID, pending) && !keys.holdsBindingKey(),
                "after a Windows Hello reset keys are INVALIDATED, the binding and pending operations are gone");
        int before = hello.prompts();
        byte[] renewed = keys.seal(PID, MATERIAL, 30, BOTH).data;
        check(renewed != null && hello.prompts() == before + 2
                        && Arrays.equals(keys.release(renewed).data, MATERIAL),
                "a new key enrolls a new binding");
        check(keys.release(timed).status == KeystoreAuthorization.INVALIDATED
                        && keys.begin(UID, "c", perUse).status == KeystoreAuthorization.INVALIDATED,
                "keys of the old binding stay INVALIDATED under the new one");
        restart();
        check(keys.release(timed).status == KeystoreAuthorization.INVALIDATED
                        && keys.release(renewed).status == KeystoreAuthorization.NOT_AUTHENTICATED,
                "and after a restart: old INVALIDATED, new merely NOT_AUTHENTICATED");

        // The reset happens between the liveness check and the prompt.
        fresh();
        timed = keys.seal(PID, MATERIAL, 30, BOTH).data;
        restart();
        hello.reset();
        check(confirm(keys, UID, 0) == KeystoreAuthorization.NO_BINDING && !bindingFile.exists(),
                "a confirmation that finds the Hello key gone: NO_BINDING, binding invalidated");
        // Windows has another key under the binding's name.
        fresh();
        timed = keys.seal(PID, MATERIAL, 30, BOTH).data;
        restart();
        String name = hello.keys.keySet().iterator().next();
        hello.keys.clear();
        hello.create(name, PID);
        check(confirm(keys, UID, 0) == WindowsHelloBackend.FAILED && !bindingFile.exists()
                        && keys.release(timed).status == KeystoreAuthorization.INVALIDATED,
                "a different Hello key under the same name never unlocks: FAILED, INVALIDATED");
        // A corrupted record is not silently replaced by success.
        fresh();
        timed = keys.seal(PID, MATERIAL, 30, BOTH).data;
        Files.write(bindingFile.toPath(), new byte[] {1, 2, 3, 4, 5});
        restart();
        check(keys.release(timed).status == KeystoreAuthorization.INVALIDATED,
                "an unreadable binding record: its keys are INVALIDATED");
    }

    static void keyBoundHello() throws Exception {
        fresh();
        TestVerifier verifier = new TestVerifier();
        KeyBoundHello backend = new KeyBoundHello(verifier, keys);
        backend.verify(REQUEST, r -> { });
        check(verifier.completions.size() == 1 && hello.prompts() == 0,
                "no binding: a credential confirmation is the plain verifier's");
        byte[] perUse = keys.seal(PID, MATERIAL, 0, BOTH).data;
        int prompts = hello.prompts();
        backend.verify(REQUEST, r -> { });
        check(verifier.completions.size() == 2 && hello.prompts() == prompts && perUse != null,
                "only per-operation keys: still the plain verifier's");
        byte[] timed = keys.seal(PID, MATERIAL, 30, BOTH).data;
        restart();
        backend = new KeyBoundHello(verifier, keys);
        CountDownLatch done = new CountDownLatch(1);
        int[] result = {Integer.MIN_VALUE};
        backend.verify(REQUEST, r -> {
            result[0] = r;
            done.countDown();
        });
        check(done.await(20, TimeUnit.SECONDS) && result[0] == WindowsHelloBackend.VERIFIED
                        && verifier.completions.size() == 2 && hello.prompts() == prompts + 1
                        && keys.release(timed).status == KeystoreAuthorization.OK,
                "keys with a timeout: the confirmation is the key's signature, one prompt, and it releases them");
        restart();
        backend = new KeyBoundHello(verifier, keys);
        hello.reset();
        CountDownLatch fell = new CountDownLatch(1);
        int[] fallback = {Integer.MIN_VALUE};
        WindowsHelloBackend.Verification v = backend.verify(REQUEST, r -> {
            fallback[0] = r;
            fell.countDown();
        });
        for (int i = 0; i < 200 && verifier.completions.size() < 3; i++) Thread.sleep(10);
        check(verifier.completions.size() == 3 && fallback[0] == Integer.MIN_VALUE,
                "the Hello key is gone before Windows asked anything: the plain verifier takes over");
        v.cancel();
        check(verifier.cancels == 1, "and a cancel reaches the verification that is running");
        verifier.completions.get(2).onResult(WindowsHelloBackend.CANCELED);
        check(fell.await(1, TimeUnit.SECONDS) && fallback[0] == WindowsHelloBackend.CANCELED,
                "its result is reported once");

        fresh();
        keys.seal(PID, MATERIAL, 30, BOTH);
        hello.reset();
        hello.hold = true;
        TestVerifier canceledVerifier = new TestVerifier();
        List<Integer> canceledResults = new ArrayList<>();
        WindowsHelloBackend.Verification canceled = new KeyBoundHello(canceledVerifier, keys)
                .verify(REQUEST, canceledResults::add);
        canceled.cancel();
        hello.complete();
        check(canceledVerifier.completions.isEmpty(),
                "a canceled key request never opens a replacement credential prompt");
        check(canceledResults.equals(List.of(WindowsHelloBackend.CANCELED)),
                "the canceled key request delivers CANCELED once when the key is gone");
    }

    // --- the app's provider, through JCA --------------------------------------------------

    static KeyStore store;

    static KeyGenParameterSpec.Builder spec(String alias) {
        return new KeyGenParameterSpec.Builder(alias, 3);
    }

    static SecretKey aes(KeyGenParameterSpec spec) throws Exception {
        KeyGenerator g = KeyGenerator.getInstance("AES", "AndroidKeyStore");
        g.init(spec);
        return g.generateKey();
    }

    /** AndroidKeyStoreProvider.getKeyStoreOperationHandle over the JDK's fields. */
    static long operationHandle(Object primitive) throws Exception {
        Object spi;
        if (primitive instanceof Signature) {
            Field f = primitive.getClass().getDeclaredField("sigSpi");
            f.setAccessible(true);
            spi = f.get(primitive);
        } else {
            Field f = primitive.getClass().getDeclaredField("spi");
            f.setAccessible(true);
            spi = f.get(primitive);
        }
        if (!(spi instanceof KeyStoreCryptoOperation)) {
            throw new IllegalArgumentException("Crypto primitive not backed by AndroidKeyStore provider: "
                    + primitive + ", spi: " + spi);
        }
        return ((KeyStoreCryptoOperation) spi).getOperationHandle();
    }

    static byte[] gks1(String alias, byte[] raw) throws Exception {
        ByteArrayOutputStream bytes = new ByteArrayOutputStream();
        DataOutputStream out = new DataOutputStream(bytes);
        out.writeInt(0x474b5331);
        out.writeInt(1);
        out.writeUTF(alias);
        out.writeByte(1);
        out.writeLong(1_700_000_000_000L);
        out.writeUTF("AES");
        out.writeInt(raw.length);
        out.write(raw);
        out.writeInt(0);
        return bytes.toByteArray();
    }

    static void provider() throws Exception {
        File data = new File(dir, "app");
        data.mkdirs();
        File file = new File(data, ".gesher-keystore");
        byte[] legacyRaw = "legacy-aes-key-1".getBytes();
        Files.write(file.toPath(), gks1("legacy", legacyRaw));
        android.app.ActivityThread.application = new android.app.Application(data);
        Security.addProvider(new AndroidKeyStore());
        store = KeyStore.getInstance("AndroidKeyStore");
        store.load(null);

        // No gesher.keystore service on this device.
        Throwable t = thrown(() -> aes(spec("t0").setUserAuthenticationRequired(true)
                .setUserAuthenticationParameters(30, BOTH).build()));
        check(t instanceof InvalidAlgorithmParameterException
                        && causedBy(t, IllegalStateException.class, "Secure lock screen must be enabled"),
                "no keystore authorization service: KeyGenerator.init fails as without a secure lock screen");

        fresh();
        ServiceManager.services.put(KeystoreAuthorizationService.NAME, new KeystoreAuthorizationService(keys));
        Binder.callingUid = UID;
        Binder.callingPid = PID;

        // Migration: a GKS1 key keeps working, as a plain key, and is marked legacy.
        Key legacy = store.getKey("legacy", null);
        check(legacy instanceof SecretKeySpec && Arrays.equals(legacy.getEncoded(), legacyRaw),
                "migration: a key of the old file is still there and usable");

        // Keys that do not require user authentication: unchanged.
        SecretKey plain = aes(spec("plain").setKeySize(256).build());
        Cipher c = Cipher.getInstance("AES/GCM/NoPadding");
        c.init(Cipher.ENCRYPT_MODE, plain);
        byte[] plainIv = c.getIV();
        byte[] plainText = c.doFinal("hello".getBytes());
        Cipher d = Cipher.getInstance("AES/GCM/NoPadding");
        d.init(Cipher.DECRYPT_MODE, store.getKey("plain", null), new GCMParameterSpec(128, plainIv));
        check(plain instanceof SecretKeySpec && plain.getEncoded().length == 32
                        && Arrays.equals(d.doFinal(plainText), "hello".getBytes())
                        && !c.getProvider().getName().equals("AndroidKeyStore") && hello.prompts() == 0,
                "a key without the requirement is a plain key used by the other providers, with no prompt");
        check(thrown(() -> operationHandle(c)) instanceof IllegalArgumentException,
                "and its Cipher is not a keystore operation (getOpId throws, as before)");
        byte[] written = Files.readAllBytes(file.toPath());
        check(written[3] == '2' && contains(written, legacyRaw) && flags(written, "legacy") == 2,
                "the rewritten file is GKS2 and keeps the old key, marked legacy");
        check(flags(written, "plain") == 0, "a new plain key is not marked legacy or sealed");

        // What cannot be made.
        t = thrown(() -> aes(spec("b1").setUserAuthenticationRequired(true).build()));
        check(t instanceof InvalidAlgorithmParameterException
                        && causedBy(t, IllegalStateException.class, "At least one biometric must be enrolled")
                        && !store.containsAlias("b1"),
                "setUserAuthenticationRequired(true) alone (biometric, every use): init fails as with no enrolled biometric");
        t = thrown(() -> aes(spec("b2").setUserAuthenticationRequired(true)
                .setUserAuthenticationValidityDurationSeconds(-1).build()));
        check(causedBy(t, IllegalStateException.class, "At least one biometric must be enrolled"),
                "validity -1: the same");
        t = thrown(() -> aes(spec("b3").setUserAuthenticationRequired(true)
                .setUserAuthenticationParameters(0, 0).build()));
        check(causedBy(t, IllegalStateException.class, "Invalid or no authentication type specified"),
                "no authentication type: AOSP's IllegalStateException");
        hello.supported = false;
        t = thrown(() -> aes(spec("b4").setUserAuthenticationRequired(true)
                .setUserAuthenticationValidityDurationSeconds(30).build()));
        check(t instanceof InvalidAlgorithmParameterException
                        && causedBy(t, IllegalStateException.class, "Secure lock screen must be enabled"),
                "Windows Hello not set up: init fails as without a secure lock screen");
        t = thrown(() -> {
            KeyPairGenerator g = KeyPairGenerator.getInstance("RSA", "AndroidKeyStore");
            g.initialize(spec("b5").setUserAuthenticationRequired(true)
                    .setUserAuthenticationParameters(0, CRED).build());
        });
        check(t instanceof InvalidAlgorithmParameterException
                        && causedBy(t, IllegalStateException.class, "Secure lock screen must be enabled"),
                "the same for KeyPairGenerator.initialize");
        t = thrown(() -> store.setEntry("b6", new KeyStore.SecretKeyEntry(new SecretKeySpec(new byte[16], "AES")),
                new KeyProtection.Builder(3).setUserAuthenticationRequired(true)
                        .setUserAuthenticationParameters(30, CRED).build()));
        check(t instanceof KeyStoreException && causedBy(t, IllegalStateException.class, "Secure lock screen")
                        && !store.containsAlias("b6"),
                "and an import with KeyProtection: KeyStoreException with that cause, nothing stored");
        hello.supported = true;
        hello.createStatus = HelloKeyBackend.USER_CANCELED;
        t = thrown(() -> aes(spec("b7").setUserAuthenticationRequired(true)
                .setUserAuthenticationParameters(30, BOTH).build()));
        check(t instanceof ProviderException && !store.containsAlias("b7"),
                "the user cancels the enrollment: generateKey throws ProviderException, no key");
        hello.createStatus = HelloKeyBackend.SUCCESS;

        // A key with a timeout.
        SecretKey timed = aes(spec("timed").setKeySize(256).setUserAuthenticationRequired(true)
                .setUserAuthenticationValidityDurationSeconds(30).build());
        Key again = store.getKey("timed", null);
        check(timed.getEncoded() == null && timed.getFormat() == null && timed.equals(again)
                        && "AES".equals(timed.getAlgorithm()) && !(timed instanceof SecretKeySpec),
                "a key that requires user authentication is opaque: no format, no encoding");
        written = Files.readAllBytes(file.toPath());
        check(flags(written, "timed") == 1, "and is stored sealed");
        Cipher e1 = Cipher.getInstance("AES/GCM/NoPadding");
        e1.init(Cipher.ENCRYPT_MODE, timed);
        check(e1.getProvider().getName().equals("AndroidKeyStore") && operationHandle(e1) == 0,
                "JCA selects the keystore's Cipher for it; a key with a timeout has no operation challenge");
        byte[] iv = e1.getIV();
        byte[] secret = e1.doFinal("timed secret".getBytes());
        clock.addAndGet(31_000);
        // (A JDK Cipher whose provider selection failed cannot be initialized again; libcore's
        // can. A new Cipher each time works on both.)
        t = thrown(() -> Cipher.getInstance("AES/GCM/NoPadding")
                .init(Cipher.DECRYPT_MODE, again, new GCMParameterSpec(128, iv)));
        Cipher d1 = Cipher.getInstance("AES/GCM/NoPadding");
        check(t instanceof UserNotAuthenticatedException,
                "31 s after the last confirmation Cipher.init throws UserNotAuthenticatedException");
        check(confirm(keys, UID, 0) == WindowsHelloBackend.VERIFIED, "the user confirms with Windows Hello");
        d1.init(Cipher.DECRYPT_MODE, again, new GCMParameterSpec(128, iv));
        check(Arrays.equals(d1.doFinal(secret), "timed secret".getBytes()),
                "after which the key decrypts what it encrypted");
        clock.addAndGet(31_000);
        t = thrown(() -> d1.doFinal(secret));
        check(t instanceof IllegalBlockSizeException && t.getCause() instanceof UserNotAuthenticatedException,
                "reusing the Cipher after the timeout fails: every operation is authorized anew");

        // A key for which every use is authorized, with BiometricPrompt.CryptoObject's flow.
        SecretKey perUse = aes(spec("peruse").setUserAuthenticationRequired(true)
                .setUserAuthenticationParameters(0, BOTH).build());
        Cipher e2 = Cipher.getInstance("AES/GCM/NoPadding");
        e2.init(Cipher.ENCRYPT_MODE, perUse);
        long handle = operationHandle(e2);
        byte[] iv2 = e2.getIV();
        check(handle != 0 && iv2 != null && iv2.length == 12 && keys.isPending(UID, handle),
                "every-use key: init succeeds, getOpId is a pending operation, the IV is readable");
        check(e2.update("x".getBytes()) == null, "used before authorization: update returns null");
        t = thrown(() -> e2.doFinal());
        check(t instanceof IllegalBlockSizeException && t.getCause() instanceof android.security.KeyStoreException
                        && ((android.security.KeyStoreException) t.getCause()).getErrorCode() == -26,
                "and doFinal throws IllegalBlockSizeException caused by KeyStoreException(-26)");
        e2.init(Cipher.ENCRYPT_MODE, perUse);
        long handle2 = operationHandle(e2);
        check(handle2 != 0 && handle2 != handle, "a new init is a new operation");
        check(confirm(keys, UID, handle2) == WindowsHelloBackend.VERIFIED, "the user authorizes it");
        byte[] iv3 = e2.getIV();
        byte[] sealedText = e2.doFinal("per-use secret".getBytes());
        t = thrown(() -> e2.doFinal("again".getBytes()));
        check(sealedText.length == 14 + 16 && t instanceof IllegalBlockSizeException,
                "the authorized operation works once; the next use of the Cipher is not authorized");
        Cipher d2 = Cipher.getInstance("AES/GCM/NoPadding");
        d2.init(Cipher.DECRYPT_MODE, store.getKey("peruse", null), new GCMParameterSpec(128, iv3));
        check(confirm(keys, UID, operationHandle(d2)) == WindowsHelloBackend.VERIFIED
                        && Arrays.equals(d2.doFinal(sealedText), "per-use secret".getBytes()),
                "decryption, authorized the same way, gives the plaintext");
        check(thrown(() -> Cipher.getInstance("AES/GCM/NoPadding").init(Cipher.DECRYPT_MODE, perUse))
                        instanceof java.security.GeneralSecurityException,
                "decrypting without an IV is refused at init");

        // RSA: every use, Signature.
        KeyPairGenerator rsa = KeyPairGenerator.getInstance("RSA", "AndroidKeyStore");
        rsa.initialize(spec("rsa").setKeySize(2048).setUserAuthenticationRequired(true)
                .setUserAuthenticationParameters(0, BOTH).build());
        KeyPair pair = rsa.generateKeyPair();
        PrivateKey rsaKey = (PrivateKey) store.getKey("rsa", null);
        check(pair.getPrivate().equals(rsaKey) && rsaKey.getEncoded() == null && rsaKey instanceof RSAKey
                        && !(rsaKey instanceof RSAPrivateKey) && pair.getPublic().getEncoded() != null
                        && store.getCertificate("rsa").getPublicKey().equals(pair.getPublic()),
                "RSA pair: an opaque private key (RSAKey, not RSAPrivateKey), a normal public key and certificate");
        Signature s = Signature.getInstance("SHA256withRSA");
        s.initSign(rsaKey);
        long signHandle = operationHandle(s);
        t = thrown(() -> s.update("m".getBytes()));
        check(signHandle != 0 && t instanceof SignatureException
                        && t.getCause() instanceof android.security.KeyStoreException,
                "Signature before authorization: SignatureException caused by KeyStoreException");
        s.initSign(rsaKey);
        check(confirm(keys, UID, operationHandle(s)) == WindowsHelloBackend.VERIFIED, "authorized");
        s.update("message".getBytes());
        byte[] signature = s.sign();
        Signature verify = Signature.getInstance("SHA256withRSA");
        verify.initVerify(pair.getPublic());
        verify.update("message".getBytes());
        check(verify.verify(signature), "the signature verifies under the public key, with another provider");
        Cipher rsaCipher = Cipher.getInstance("RSA/ECB/PKCS1Padding");
        rsaCipher.init(Cipher.ENCRYPT_MODE, pair.getPublic());
        byte[] wrapped = rsaCipher.doFinal("rsa secret".getBytes());
        Cipher rsaDecrypt = Cipher.getInstance("RSA/ECB/PKCS1Padding");
        rsaDecrypt.init(Cipher.DECRYPT_MODE, rsaKey);
        check(confirm(keys, UID, operationHandle(rsaDecrypt)) == WindowsHelloBackend.VERIFIED
                        && Arrays.equals(rsaDecrypt.doFinal(wrapped), "rsa secret".getBytes()),
                "RSA decryption with the private key, authorized per use");

        // EC with a timeout, and HMAC for every use.
        KeyPairGenerator ec = KeyPairGenerator.getInstance("EC", "AndroidKeyStore");
        ec.initialize(spec("ec").setUserAuthenticationRequired(true)
                .setUserAuthenticationParameters(30, CRED).build());
        KeyPair ecPair = ec.generateKeyPair();
        check(ecPair.getPrivate() instanceof ECKey && !(ecPair.getPrivate() instanceof ECPrivateKey),
                "EC pair: an opaque private key (ECKey, not ECPrivateKey)");
        check(confirm(keys, UID, 0) == WindowsHelloBackend.VERIFIED, "confirmed");
        Signature ecdsa = Signature.getInstance("SHA256withECDSA");
        ecdsa.initSign(ecPair.getPrivate());
        ecdsa.update("message".getBytes());
        byte[] ecSignature = ecdsa.sign();
        Signature ecVerify = Signature.getInstance("SHA256withECDSA");
        ecVerify.initVerify(ecPair.getPublic());
        ecVerify.update("message".getBytes());
        check(ecVerify.verify(ecSignature) && operationHandle(ecdsa) == 0,
                "ECDSA with a timeout key signs within the timeout");
        clock.addAndGet(31_000);
        check(thrown(() -> ecdsa.initSign(ecPair.getPrivate())) instanceof UserNotAuthenticatedException,
                "and Signature.initSign throws UserNotAuthenticatedException after it");

        KeyGenerator hmacGenerator = KeyGenerator.getInstance("HmacSHA256", "AndroidKeyStore");
        hmacGenerator.init(spec("hmac").setUserAuthenticationRequired(true)
                .setUserAuthenticationParameters(0, CRED).build());
        SecretKey hmacKey = hmacGenerator.generateKey();
        Mac mac = Mac.getInstance("HmacSHA256");
        mac.init(hmacKey);
        long macHandle = operationHandle(mac);
        t = thrown(() -> mac.update("m".getBytes()));
        check(macHandle != 0 && t instanceof ProviderException
                        && t.getCause() instanceof android.security.KeyStoreException,
                "Mac before authorization: ProviderException caused by KeyStoreException");
        byte[][] tags = new byte[2][];
        for (int i = 0; i < 2; i++) {
            mac.init(hmacKey);
            check(confirm(keys, UID, operationHandle(mac)) == WindowsHelloBackend.VERIFIED, "Mac authorized");
            tags[i] = mac.doFinal("message".getBytes());
        }
        check(tags[0].length == 32 && Arrays.equals(tags[0], tags[1]),
                "two authorized operations of the same HMAC key give the same tag");

        // Import with KeyProtection.
        byte[] imported = "imported-aes-key".getBytes();
        store.setEntry("imported", new KeyStore.SecretKeyEntry(new SecretKeySpec(imported, "AES")),
                new KeyProtection.Builder(3).setUserAuthenticationRequired(true)
                        .setUserAuthenticationParameters(30, BOTH).build());
        written = Files.readAllBytes(file.toPath());
        Key importedKey = store.getKey("imported", null);
        check(importedKey.getEncoded() == null && !contains(written, imported) && flags(written, "imported") == 1,
                "an imported key with KeyProtection user authentication is sealed: its bytes are not in the file");
        t = thrown(() -> store.setEntry("imported2",
                new KeyStore.SecretKeyEntry(new SecretKeySpec(imported, "AES")),
                new KeyProtection.Builder(3).setUserAuthenticationRequired(true).build()));
        check(t instanceof KeyStoreException && causedBy(t, IllegalStateException.class, "At least one biometric"),
                "an import that only a biometric may authorize: KeyStoreException, as with no enrolled biometric");
        store.setEntry("imported3", new KeyStore.SecretKeyEntry(new SecretKeySpec(imported, "AES")),
                new KeyProtection.Builder(3).build());
        check(Arrays.equals(store.getKey("imported3", null).getEncoded(), imported),
                "an import without the requirement stays a plain key");
        check(confirm(keys, UID, 0) == WindowsHelloBackend.VERIFIED, "confirmed");
        Cipher ecb = Cipher.getInstance("AES/ECB/NoPadding");
        ecb.init(Cipher.ENCRYPT_MODE, importedKey);
        Cipher reference = Cipher.getInstance("AES/ECB/NoPadding");
        reference.init(Cipher.ENCRYPT_MODE, new SecretKeySpec(imported, "AES"));
        check(Arrays.equals(ecb.doFinal(new byte[16]), reference.doFinal(new byte[16])),
                "the sealed imported key computes what the imported key computes");

        // A Windows Hello reset.
        hello.reset();
        clock.addAndGet(6_000);
        t = thrown(() -> Cipher.getInstance("AES/GCM/NoPadding").init(Cipher.ENCRYPT_MODE, again));
        Throwable t2 = thrown(() -> Cipher.getInstance("AES/GCM/NoPadding").init(Cipher.ENCRYPT_MODE, perUse));
        Throwable t3 = thrown(() -> Signature.getInstance("SHA256withRSA").initSign(rsaKey));
        Throwable t4 = thrown(() -> Mac.getInstance("HmacSHA256").init(hmacKey));
        check(t instanceof KeyPermanentlyInvalidatedException && t2 instanceof KeyPermanentlyInvalidatedException
                        && t3 instanceof KeyPermanentlyInvalidatedException
                        && t4 instanceof KeyPermanentlyInvalidatedException,
                "after a Windows Hello reset, init throws KeyPermanentlyInvalidatedException for every such key");
        Cipher after = Cipher.getInstance("AES/GCM/NoPadding");
        after.init(Cipher.ENCRYPT_MODE, store.getKey("plain", null));
        check(after.doFinal("still".getBytes()).length == 21 && store.getKey("legacy", null) != null,
                "plain and legacy keys are untouched by it");
        store.deleteEntry("timed");
        check(thrown(() -> Cipher.getInstance("AES/GCM/NoPadding").init(Cipher.ENCRYPT_MODE, again))
                        instanceof KeyPermanentlyInvalidatedException && !store.containsAlias("timed"),
                "a deleted key's object: KeyPermanentlyInvalidatedException (keystore2's KEY_NOT_FOUND)");
    }

    /** The flags byte of {@code alias} in a GKS2 file: 1 sealed, 2 legacy. */
    static int flags(byte[] file, String alias) throws Exception {
        java.io.DataInputStream in = new java.io.DataInputStream(new java.io.ByteArrayInputStream(file));
        if (in.readInt() != 0x474b5332) return -1;
        int n = in.readInt();
        for (int i = 0; i < n; i++) {
            String name = in.readUTF();
            in.readByte();
            in.readLong();
            in.readUTF();
            int flags = in.readByte();
            in.skipBytes(in.readInt());
            if ((flags & 1) != 0) in.skipBytes(8);
            for (int c = in.readInt(); c > 0; c--) in.skipBytes(in.readInt());
            if (name.equals(alias)) return flags;
        }
        return -1;
    }

    public static void main(String[] args) throws Exception {
        dir = new File(args[0]);
        unavailable();
        deviceCredential();
        enrollment();
        perOperation();
        timeouts();
        invalidation();
        keyBoundHello();
        provider();
        System.out.println(checks + " checks, " + failures + " failures");
        if (failures != 0) System.exit(1);
    }
}
