+package com.gesher.app.webview;
+
+import android.os.Handler;
+import android.os.SystemClock;
+import android.util.Log;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+import java.util.function.Consumer;
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+/** Unqualified, opt-in CDP listener experiment. All engine events enter on the WebView STA. */
+final class EngineListenerCoordinator {
+    private static final String TAG = "GesherWeb4";
+    private static final String[] EVENTS = {"Runtime.executionContextCreated",
+            "Runtime.executionContextDestroyed", "Runtime.executionContextsCleared",
+            "Runtime.bindingCalled", "Page.frameAttached", "Page.frameDetached",
+            "Page.frameStartedNavigating", "Page.frameStoppedLoading", "Page.frameNavigated", "Target.attachedToTarget", "Target.detachedFromTarget"};
+    private final WebView2Host host;
+    private final GesherWebViewProvider provider;
+    private final Handler ui;
+    final String binding = "__gesher_binding_" + UUID.randomUUID().toString().replace("-", "");
+    final String dispatch = "__gesher_reply_" + UUID.randomUUID().toString().replace("-", "");
+    private final Map<Long, String> subscriptions = new HashMap<>();
+    private final Map<Long, Consumer<String>> calls = new HashMap<>();
+    private final Map<String, Context> contexts = new HashMap<>();
+    private final Set<String> seenUnique = new HashSet<>(), seenNumeric = new HashSet<>(),
+            seenSessions = new HashSet<>();
+    private final Set<String> pausedSessions = new HashSet<>();
+    private final Set<String> activeSessions = new HashSet<>();
+    private final Set<String> navigatingFrames = new HashSet<>();
+    private final Map<String, String> parents = new HashMap<>();
+    private final Map<Long, Ticket> tickets = new HashMap<>();
+    private final Map<String, Ticket> ticketKeys = new HashMap<>();
+    private final List<Runnable> waiting = new ArrayList<>();
+    private final List<PendingBinding> pendingBindings = new ArrayList<>();
+    private int pendingBindingUnits;
+    private String rootFrame;
+    private long nextId = 1, nextTicket = 1, deadline;
+    private int registrations, pendingDeliveries, pendingUnits, activeCallbacks;
+    private Runnable closeCompletion;
+    private boolean started, ready, failed, closed;
+
+    private static final class Context {
+        final String session, unique, frame, origin;
+        final long numeric;
+        final Map<String, GesherWebViewProvider.MessageListener> listeners;
+        boolean live = true;
+        Context(String session, long numeric, String unique, String frame, String origin,
+                Map<String, GesherWebViewProvider.MessageListener> listeners) {
+            this.session = session; this.numeric = numeric; this.unique = unique;
+            this.frame = frame; this.origin = origin; this.listeners = listeners;
+        }
+    }
+    private static final class PendingBinding {
+        final Context context;
+        final JSONObject event;
+        final int units;
+        PendingBinding(Context context, JSONObject event, int units) {
+            this.context = context; this.event = event; this.units = units;
+        }
+    }
+    private static final class Ticket {
+        final long id;
+        final Context context;
+        final GesherWebViewProvider.MessageListener listener;
+        int inFlight, pending;
+        boolean live = true;
+        Ticket(long id, Context context, GesherWebViewProvider.MessageListener listener) {
+            this.id = id; this.context = context; this.listener = listener;
+        }
+    }
+
+    EngineListenerCoordinator(WebView2Host host, GesherWebViewProvider provider, Handler ui) {
+        this.host = host; this.provider = provider; this.ui = ui;
+        seenSessions.add("");
+    }
+
+    synchronized void start() {
+        if (started || closed || failed) return;
+        started = true;
+        deadline = SystemClock.uptimeMillis() + 3000;
+        if (!ui.postDelayed(() -> { synchronized (this) {
+            if (!ready && !failed && !closed) fail("setup timeout");
+        } }, 3000)) { fail("setup timeout could not be scheduled"); return; }
+        for (String event : EVENTS) {
+            long id = allocateId();
+            if (id == 0) { fail("id exhaustion"); return; }
+            subscriptions.put(id, event);
+            int accepted = host.subscribeSession(id, event, remaining(deadline));
+            if (accepted != 0) { fail("subscription admission " + accepted); return; }
+        }
+    }
+
+    synchronized void navigate(Runnable navigation) {
+        if (closed) return;
+        if (ready || failed) { if (!ui.post(navigation)) fail("navigation dispatch"); return; }
+        if (waiting.size() >= 32) { fail("navigation queue full");
+            if (!ui.post(navigation)) Log.e(TAG, "navigation dispatch failed"); return; }
+        boolean first = waiting.isEmpty();
+        waiting.add(navigation);
+        if (first && !started && !ui.postDelayed(() -> { synchronized (this) {
+            if (!started && !closed && !failed) fail("host readiness timeout");
+        } }, 3000)) fail("host readiness timer could not be scheduled");
+    }
+
+    private int remaining(long until) {
+        long left = until - SystemClock.uptimeMillis();
+        return (int) Math.max(1, Math.min(left, 3000));
+    }
+
+    private long allocateId() {
+        if (nextId <= 0 || nextId == Long.MAX_VALUE) return 0;
+        return nextId++;
+    }
+
+    private void request(String session, String method, JSONObject params, long until,
+            Consumer<String> done) {
+        if (closed || failed) return;
+        if (SystemClock.uptimeMillis() >= until) { fail("protocol deadline " + method); return; }
+        long id = allocateId();
+        if (id == 0 || calls.size() >= 128) { fail("request limit"); return; }
+        calls.put(id, done);
+        int accepted = host.submitSession(id, session, method, params.toString(), remaining(until));
+        if (accepted != 0) { calls.remove(id); fail("protocol admission " + method + ": " + accepted); }
+    }
+
+    private void rootSetup() {
+        request("", "Runtime.enable", new JSONObject(), deadline, a ->
+            request("", "Page.enable", new JSONObject(), deadline, b ->
+                request("", "Page.getFrameTree", new JSONObject(), deadline, tree -> {
+                    try {
+                        JSONObject frameTree = new JSONObject(tree).getJSONObject("frameTree");
+                        seedTree(frameTree, null);
+                        JSONObject bindingParam = new JSONObject().put("name", binding);
+                        request("", "Runtime.addBinding", bindingParam, deadline, c -> {
+                            try {
+                                JSONObject attach = new JSONObject().put("autoAttach", true)
+                                        .put("waitForDebuggerOnStart", true).put("flatten", true);
+                                request("", "Target.setAutoAttach", attach, deadline, d -> {
+                                    activeSessions.add("");
+                                    ready = true;
+                                    flushBindings();
+                                    GesherWebView.log("web4 CDP ready root=" + rootFrame);
+                                    ArrayList<Runnable> copy = new ArrayList<>(waiting);
+                                    waiting.clear();
+                                    for (Runnable task : copy) if (!ui.post(task)) fail("navigation dispatch");
+                                });
+                            } catch (Exception e) { fail("root attach setup " + e); }
+                        });
+                    } catch (Exception e) { fail("frame tree " + e); }
+                })));
+    }
+
+    private void seedTree(JSONObject tree, String parent) throws Exception {
+        JSONObject frame = tree.getJSONObject("frame");
+        String id = frame.getString("id");
+        if (parent == null) {
+            if (rootFrame != null && !rootFrame.equals(id)) throw new IllegalStateException("root changed");
+            rootFrame = id;
+            recordFrame(id, "");
+        } else recordFrame(id, parent);
+        JSONArray children = tree.optJSONArray("childFrames");
+        if (children != null) for (int i = 0; i < children.length(); i++) seedTree(children.getJSONObject(i), id);
+    }
+
+    private void recordFrame(String frame, String parent) {
+        if (frame.isEmpty() || parent == null || frame.equals(parent)) { fail("invalid frame ancestry"); return; }
+        String previous = parents.get(frame);
+        if (previous != null && !previous.equals(parent)) { fail("ambiguous frame ancestry"); return; }
+        if (!parents.containsKey(frame) && parents.size() >= 4096) { fail("frame limit"); return; }
+        parents.put(frame, parent);
+    }
+
+    private boolean mainOrDescendant(String frame) {
+        if (rootFrame == null) return false;
+        Set<String> seen = new HashSet<>();
+        while (!frame.equals(rootFrame)) {
+            if (!seen.add(frame)) return false;
+            frame = parents.get(frame);
+            if (frame == null || frame.isEmpty()) return false;
+        }
+        return true;
+    }
+
+    private static String key(String session, long id) { return session.length() + ":" + session + id; }
+    private static String frameKey(String session, String frame) {
+        return session.length() + ":" + session + frame;
+    }
+
+    synchronized boolean onEvent(int type, long id, int hr, String a, String b, String c) {
+        if (type == WebView2Host.EVENT_SESSION_RESULT) {
+            Consumer<String> done = calls.remove(id);
+            if (done == null) return true;
+            if (hr < 0 || closed || failed) { if (!closed && !failed) fail("CDP HRESULT " + hr); return true; }
+            try {
+                JSONObject result = new JSONObject(a);
+                if (result.has("error")) { fail("CDP error " + result.optString("error")); return true; }
+                done.accept(a);
+            } catch (Exception e) { fail("CDP result " + e); }
+            return true;
+        }
+        if (type != WebView2Host.EVENT_SESSION_SUBSCRIPTION) return false;
+        String name = subscriptions.get(id);
+        if (name == null || closed || failed) return true;
+        if ("registered".equals(a)) {
+            if (hr < 0) { fail("subscription HRESULT " + hr); return true; }
+            if (++registrations == EVENTS.length) rootSetup();
+        } else if ("error".equals(a) || hr < 0) {
+            fail("subscription error " + name + ": " + hr);
+        } else if ("event".equals(a)) {
+            try { process(name, b == null ? "" : b, new JSONObject(c)); }
+            catch (Exception e) { fail("event " + name + ": " + e); }
+        }
+        return true;
+    }
+
+    private void process(String event, String session, JSONObject p) throws Exception {
+        if (!seenSessions.contains(session)) { fail("event from unknown session"); return; }
+        if ("Target.attachedToTarget".equals(event)) {
+            String child = p.getString("sessionId");
+            if (child.isEmpty() || seenSessions.size() >= 4096 || pausedSessions.size() >= 64 ||
+                    !seenSessions.add(child)) { fail("duplicate or excess session"); return; }
+            pausedSessions.add(child);
+            long childDeadline = SystemClock.uptimeMillis() + 3000;
+            String type = p.getJSONObject("targetInfo").getString("type");
+            if (!type.equals("iframe") && !type.equals("page")) {
+                request(child, "Runtime.runIfWaitingForDebugger", new JSONObject(), childDeadline,
+                        ignored -> pausedSessions.remove(child));
+                return;
+            }
+            request(child, "Runtime.enable", new JSONObject(), childDeadline, a ->
+                request(child, "Page.enable", new JSONObject(), childDeadline, b -> {
+                    try {
+                        request(child, "Runtime.addBinding", new JSONObject().put("name", binding), childDeadline, c -> {
+                            try {
+                                JSONObject attach = new JSONObject().put("autoAttach", true)
+                                        .put("waitForDebuggerOnStart", true).put("flatten", true);
+                                request(child, "Target.setAutoAttach", attach, childDeadline, d -> {
+                                    activeSessions.add(child);
+                                    flushBindings();
+                                    request(child, "Runtime.runIfWaitingForDebugger", new JSONObject(), childDeadline,
+                                        e -> pausedSessions.remove(child));
+                                });
+                            } catch (Exception ex) { fail("attach setup " + ex); }
+                        });
+                    } catch (Exception ex) { fail("binding setup " + ex); }
+                }));
+        } else if ("Target.detachedFromTarget".equals(event)) {
+            String detached = p.getString("sessionId");
+            pausedSessions.remove(detached);
+            activeSessions.remove(detached);
+            retireSession(detached);
+        } else if ("Page.frameAttached".equals(event)) {
+            recordFrame(p.getString("frameId"), p.getString("parentFrameId"));
+        } else if ("Page.frameDetached".equals(event)) {
+            String frame = p.getString("frameId");
+            if (frame.equals(rootFrame)) { fail("root detached"); return; }
+            retireFrame(frame);
+            ArrayList<String> removed = new ArrayList<>();
+            for (String candidate : parents.keySet()) if (descendsFrom(candidate, frame)) removed.add(candidate);
+            for (String candidate : removed) parents.remove(candidate);
+            // Session/frame identities are independent; on detach, conservatively
+            // discard pending commit evidence rather than infer cross-session mapping.
+            navigatingFrames.clear();
+        } else if ("Page.frameStartedNavigating".equals(event)) {
+            String frame = p.getString("frameId");
+            if (navigatingFrames.size() >= 4096) { fail("navigation limit"); return; }
+            navigatingFrames.add(frameKey(session, frame));
+        } else if ("Page.frameStoppedLoading".equals(event)) {
+            navigatingFrames.remove(frameKey(session, p.getString("frameId")));
+        } else if ("Page.frameNavigated".equals(event)) {
+            JSONObject frame = p.getJSONObject("frame");
+            String frameId = frame.getString("id");
+            retireFrame(frameId);
+            navigatingFrames.remove(frameKey(session, frameId));
+            String parent = frame.optString("parentId", "");
+            if (parent.isEmpty()) {
+                if (session.isEmpty() && rootFrame != null && rootFrame.equals(frameId)) recordFrame(frameId, "");
+            } else recordFrame(frameId, parent);
+        } else if ("Runtime.executionContextCreated".equals(event)) {
+            JSONObject ctx = p.getJSONObject("context"), aux = ctx.optJSONObject("auxData");
+            if (aux == null || !aux.optBoolean("isDefault", false)) return;
+            long number = ctx.getLong("id");
+            String unique = ctx.optString("uniqueId", ""), frame = aux.optString("frameId", "");
+            if (!(ctx.opt("origin") instanceof String)) { fail("missing context origin"); return; }
+            String origin = ctx.getString("origin");
+            if (contexts.size() >= 4096 || seenUnique.size() >= 8192 || seenNumeric.size() >= 8192 ||
+                    number <= 0 || unique.isEmpty() || frame.isEmpty() ||
+                    !seenUnique.add(unique) || !seenNumeric.add(key(session, number))) {
+                fail("ambiguous execution context"); return;
+            }
+            Map<String, GesherWebViewProvider.MessageListener> snapshot = provider.cdpListenerSnapshot();
+            contexts.put(key(session, number), new Context(session, number, unique, frame, origin, snapshot));
+        } else if ("Runtime.executionContextDestroyed".equals(event)) {
+            long number = p.optLong("executionContextId", -1);
+            String unique = p.optString("executionContextUniqueId", "");
+            Context byNumber = number > 0 ? contexts.get(key(session, number)) : null;
+            Context byUnique = null;
+            if (!unique.isEmpty()) {
+                for (Context candidate : contexts.values()) {
+                    if (candidate.session.equals(session) && candidate.unique.equals(unique)) {
+                        byUnique = candidate; break;
+                    }
+                }
+            }
+            if (byNumber != null && !unique.isEmpty() && !byNumber.unique.equals(unique)) {
+                fail("ambiguous context destruction"); return;
+            }
+            Context old = byUnique != null ? byUnique : byNumber;
+            if (old != null) { contexts.remove(key(session, old.numeric)); retire(old); }
+            else if (number <= 0 && unique.isEmpty()) fail("unidentified context destruction");
+        } else if ("Runtime.executionContextsCleared".equals(event)) {
+            retireSession(session);
+        } else if ("Runtime.bindingCalled".equals(event) && binding.equals(p.optString("name"))) {
+            Context context = contexts.get(key(session, p.getLong("executionContextId")));
+            if (context == null || !context.live) {
+                GesherWebView.log("web4 CDP binding denied: unknown or retired context"); return;
+            }
+            if (!ready || !activeSessions.contains(session)) {
+                int units = p.toString().length();
+                if (pendingBindings.size() >= 128 || units > 4194304 - pendingBindingUnits) {
+                    fail("early binding queue limit"); return;
+                }
+                pendingBindings.add(new PendingBinding(context, p, units));
+                pendingBindingUnits += units;
+                return;
+            }
+            admitBinding(context, p);
+        }
+    }
+
+    private void flushBindings() {
+        for (int i = 0; i < pendingBindings.size();) {
+            PendingBinding item = pendingBindings.get(i);
+            if (!ready || !activeSessions.contains(item.context.session)) { ++i; continue; }
+            pendingBindings.remove(i);
+            pendingBindingUnits -= item.units;
+            if (item.context.live) {
+                try { admitBinding(item.context, item.event); }
+                catch (Exception e) { fail("early binding " + e); return; }
+            }
+        }
+    }
+
+    private void admitBinding(Context context, JSONObject p) throws Exception {
+            if (!context.live || !mainOrDescendant(context.frame)) {
+                GesherWebView.log("web4 CDP binding denied: retired context or unknown ancestry"); return;
+            }
+            String session = context.session;
+            String origin = context.origin;
+            if (!(origin.startsWith("http://") || origin.startsWith("https://")) ||
+                    origin.equalsIgnoreCase(FileUrls.ORIGIN) || FileUrls.isFile(origin)) {
+                GesherWebView.log("web4 CDP binding denied: engine origin " + origin); return;
+            }
+            JSONObject payload = new JSONObject(p.getString("payload"));
+            String name = payload.optString("name", "");
+            GesherWebViewProvider.MessageListener listener = context.listeners.get(name);
+            if (listener == null || listener != provider.cdpListener(name) ||
+                    !listener.capability.equals(payload.optString("capability", "")) ||
+                    !ListenerOrigins.allows(listener.rules, origin)) {
+                GesherWebView.log("web4 CDP binding denied: registration or origin"); return;
+            }
+            GesherWebView.log("web4 CDP binding admitted session=" + session + " context="
+                    + context.unique + " frame=" + context.frame + " origin=" + origin);
+            String ticketKey = context.unique.length() + ":" + context.unique + name;
+            Ticket ticket = ticketKeys.get(ticketKey);
+            if (ticket != null && (ticket.listener != listener || !ticket.live)) {
+                ticket.live = false;
+                cleanupTicket(ticket);
+                ticketKeys.remove(ticketKey);
+                ticket = null;
+            }
+            if (ticket == null) {
+                if (nextTicket <= 0 || nextTicket == Long.MAX_VALUE || tickets.size() >= 4096) {
+                    fail("ticket exhaustion"); return;
+                }
+                ticket = new Ticket(nextTicket++, context, listener);
+                tickets.put(ticket.id, ticket);
+                ticketKeys.put(ticketKey, ticket);
+            }
+            Ticket target = ticket;
+            boolean mainFrame = context.frame.equals(rootFrame);
+            JSONObject message = payload.getJSONObject("payload");
+            int units = p.optString("payload", "").length();
+            if (pendingDeliveries >= 128 || units > 4194304 - pendingUnits) {
+                fail("listener queue limit"); return;
+            }
+            ++pendingDeliveries;
+            ++target.pending;
+            pendingUnits += units;
+            if (!ui.post(() -> deliver(target, message, units, mainFrame))) {
+                --pendingDeliveries; --target.pending; pendingUnits -= units; fail("listener dispatch");
+            }
+    }
+
+    private void deliver(Ticket ticket, JSONObject payload, int units, boolean mainFrame) {
+        synchronized (this) {
+            --pendingDeliveries;
+            --ticket.pending;
+            pendingUnits -= units;
+            if (pendingDeliveries < 0 || ticket.pending < 0 || pendingUnits < 0)
+                throw new IllegalStateException("queue accounting");
+            // A message observed from the live original context may already be queued
+            // when it navigates; its reply ticket is separately revoked on retirement.
+            if (closed || failed || provider.cdpListener(ticket.listener.name) != ticket.listener) {
+                cleanupTicket(ticket);
+                return;
+            }
+            ++ticket.inFlight;
+            ++activeCallbacks;
+        }
+        try {
+            provider.cdpDeliver(ticket.listener, payload, ticket.context.origin, ticket.id, mainFrame);
+        } finally {
+            Runnable completion = null;
+            synchronized (this) {
+                --ticket.inFlight;
+                --activeCallbacks;
+                cleanupTicket(ticket);
+                if (closed && activeCallbacks == 0) { completion = closeCompletion; closeCompletion = null; }
+            }
+            if (completion != null) completion.run();
+        }
+    }
+
+    synchronized void reply(long ticketId, String name, String json) {
+        Ticket ticket = tickets.get(ticketId);
+        if (ticket == null || closed || failed || !ticket.live || !ticket.context.live ||
+                ticket.listener != provider.cdpListener(name)) return;
+        try {
+            String expression = "globalThis[" + JSONObject.quote(dispatch) + "](" +
+                    JSONObject.quote(name) + "," + JSONObject.quote(json) + ")";
+            JSONObject params = new JSONObject().put("expression", expression)
+                    .put("uniqueContextId", ticket.context.unique).put("returnByValue", true);
+            // Replies have their own bounded budget, never a URI/top-frame fallback.
+            long replyDeadline = SystemClock.uptimeMillis() + 3000;
+            GesherWebView.log("web4 CDP reply session=" + ticket.context.session + " context="
+                    + ticket.context.unique + " frame=" + ticket.context.frame);
+            request(ticket.context.session, "Runtime.evaluate", params, replyDeadline, ignored -> {});
+        } catch (Exception e) { fail("reply " + e); }
+    }
+
+    synchronized void changeListeners(Runnable mutation) {
+        // A navigation already in flight may use the previous document script.
+        // Do not attribute a later-created context to the new registration.
+        navigatingFrames.clear();
+        mutation.run();
+    }
+
+    synchronized void remove(String name, Runnable mutation) {
+        navigatingFrames.clear();
+        mutation.run();
+        for (Ticket ticket : tickets.values()) if (ticket.listener.name.equals(name)) ticket.live = false;
+        ticketKeys.entrySet().removeIf(e -> !e.getValue().live);
+        for (Ticket ticket : new ArrayList<>(tickets.values())) cleanupTicket(ticket);
+    }
+
+    synchronized void processFailed() { fail("WebView2 process failure"); }
+
+    void close(Runnable completion) {
+        Runnable readyToClose = null;
+        synchronized (this) {
+            if (closed) return;
+            resumePaused();
+            closed = true;
+            for (Context context : contexts.values()) context.live = false;
+            for (Ticket ticket : tickets.values()) ticket.live = false;
+            ticketKeys.clear();
+            for (Ticket ticket : new ArrayList<>(tickets.values())) cleanupTicket(ticket);
+            waiting.clear(); calls.clear(); pendingBindings.clear(); pendingBindingUnits = 0;
+            closeCompletion = completion;
+            if (activeCallbacks == 0) { readyToClose = closeCompletion; closeCompletion = null; }
+        }
+        // Never wait for or hold a monitor across an app callback or host destruction.
+        if (readyToClose != null) readyToClose.run();
+    }
+
+    private boolean descendsFrom(String frame, String ancestor) {
+        Set<String> seen = new HashSet<>();
+        while (frame != null && !frame.isEmpty() && seen.add(frame)) {
+            if (frame.equals(ancestor)) return true;
+            frame = parents.get(frame);
+        }
+        return false;
+    }
+    private void retireFrame(String frame) {
+        for (Context context : contexts.values()) {
+            // Unknown ancestry is denied, and revocation is conservative on uncertainty.
+            if (descendsFrom(context.frame, frame) || !mainOrDescendant(context.frame)) retire(context);
+        }
+    }
+    private void retireSession(String session) {
+        for (Context context : contexts.values()) if (context.session.equals(session)) retire(context);
+        contexts.entrySet().removeIf(e -> e.getValue().session.equals(session));
+    }
+    private void cleanupTicket(Ticket ticket) {
+        if (!ticket.live && ticket.inFlight == 0 && ticket.pending == 0) {
+            tickets.remove(ticket.id);
+            ticket.listener.replyProxies.remove(ticket.id);
+        }
+    }
+    private void retire(Context context) {
+        context.live = false;
+        for (Ticket ticket : tickets.values()) if (ticket.context == context) ticket.live = false;
+        ticketKeys.entrySet().removeIf(e -> !e.getValue().live);
+        for (Ticket ticket : new ArrayList<>(tickets.values())) cleanupTicket(ticket);
+    }
+    private void resumePaused() {
+        for (String session : pausedSessions) {
+            long id = allocateId();
+            if (id == 0 || host.submitSession(id, session, "Runtime.runIfWaitingForDebugger", "{}", 3000) != 0)
+                Log.e(TAG, "Unable to resume paused target " + session);
+        }
+        pausedSessions.clear();
+    }
+
+    private void fail(String reason) {
+        if (failed || closed) return;
+        failed = true;
+        Log.e(TAG, "CDP listener disabled: " + reason);
+        GesherWebView.log("web4 CDP listener disabled: " + reason);
+        resumePaused();
+        for (Context context : contexts.values()) context.live = false;
+        for (Ticket ticket : tickets.values()) ticket.live = false;
+        ticketKeys.clear();
