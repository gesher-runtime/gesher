std::shared_ptr<CaptureStream> stream;
std::shared_ptr<CaptureStream> GetStream(JNIEnv*, jobject) { return stream; }
void TraceRecord(const std::shared_ptr<CaptureStream>&, const char*, size_t, ssize_t) {}
@READ_INTO@
