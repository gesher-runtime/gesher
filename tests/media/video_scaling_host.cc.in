namespace android {
struct VirtualLightRefBase { virtual ~VirtualLightRefBase() = default; };
constexpr int OK = 0, BAD_VALUE = -EINVAL, NO_INIT = -ENODEV;
}
int ANativeWindow_setBuffersGeometry(ANativeWindow* w, int width, int height, int format) {
  return w->perform(w, NATIVE_WINDOW_SET_BUFFERS_GEOMETRY, width, height, format);
}
int ANativeWindow_lock(ANativeWindow* w, ANativeWindow_Buffer* b, ARect* dirty) {
  return static_cast<android::Surface*>(w)->lock(b, dirty);
}
int ANativeWindow_unlockAndPost(ANativeWindow* w) {
  return static_cast<android::Surface*>(w)->unlockAndPost();
}
namespace gesher::media {
struct VideoFrame {
  int width, height;
  std::vector<uint32_t> pixels;
  int visible_width() const { return width; }
  int visible_height() const { return height; }
};
// Color conversion is unchanged by this patch and covered by codec/reader tests.
// This boundary supplies recognizable decoded pixels to the actual RenderFrame.
void I420ToRgba(const VideoFrame& f, uint32_t* out, int stride, int width, int height) {
  for (int y = 0; y < height; ++y)
    for (int x = 0; x < width; ++x)
      out[y * stride + x] = f.pixels[y * f.width + x];
}
}
@RENDER@
@CROP@
@IMAGE_BOUNDARY@
@CACHE@

// Skia boundary records exact source/destination/paint operations. Its simple
// nearest-pixel readback checks stripe interiors, not Skia's filtering accuracy.
struct SkRect {
  float left, top, right, bottom;
  static SkRect MakeLTRB(float l, float t, float r, float b) { return {l, t, r, b}; }
  static SkRect MakeIWH(int w, int h) { return {0, 0, float(w), float(h)}; }
};
struct SkMatrix { int token = 0; static SkMatrix I() { return {}; } };
enum class SkBlendMode { kSrcOver, kSrc };
struct SkColorFilter {};
using U8CPU = unsigned;
struct SkPaint {
  float alpha = 1;
  SkBlendMode mode = SkBlendMode::kSrcOver;
  sk_sp<SkColorFilter> filter;
  void setAlpha(U8CPU a) { alpha = a / 255.f; }
  void setAlphaf(float a) { alpha = a; }
  void setBlendMode(SkBlendMode m) { mode = m; }
  void setColorFilter(sk_sp<SkColorFilter> f) { filter = std::move(f); }
};
struct SkRRect {
  SkRect rect;
  float radius;
  static SkRRect MakeRectXY(SkRect r, float x, float) { return {r, x}; }
};
enum class SkFilterMode { kLinear };
struct SkSamplingOptions { explicit SkSamplingOptions(SkFilterMode) {} };
struct BitmapPixels { int w, h; std::vector<uint32_t> pixels; int changes = 0; };
struct SkBitmap {
  std::shared_ptr<BitmapPixels> storage;
  int width() const { return storage->w; }
  int height() const { return storage->h; }
  void notifyPixelsChanged() { ++storage->changes; }
};
struct Draw {
  SkRect src = {}, dst = {};
  SkPaint paint;
  int constraint = -1, calls = 0, transform = 0, saves = 0, restores = 0;
  float radius = 0;
  std::vector<uint32_t> pixels;
  const void* source_pixels = nullptr;
};
Draw bitmap_draw;
class SkCanvas {
 public:
  enum SrcRectConstraint { kStrict_SrcRectConstraint, kFast_SrcRectConstraint };
  Draw draw;
  SkCanvas() = default;
  explicit SkCanvas(SkBitmap& b) : bitmap_(b.storage) {}
  void save() { ++draw.saves; }
  void restore() { ++draw.restores; }
  void concat(SkMatrix m) { draw.transform = m.token; }
  void clipRRect(SkRRect r, bool) { draw.radius = r.radius; }
  void drawImageRect(SkImage* image, SkRect src, SkRect dst, SkSamplingOptions,
                     const SkPaint* paint, SrcRectConstraint constraint) {
    draw.src = src; draw.dst = dst; ++draw.calls; draw.constraint = constraint;
    if (paint) draw.paint = *paint;
    draw.source_pixels = image->data->pixels;
    const int w = int(dst.right - dst.left), h = int(dst.bottom - dst.top);
    draw.pixels.assign(std::max(w, 0) * std::max(h, 0), 0);
    if (src.right > src.left && src.bottom > src.top) {
      for (int y = 0; y < h; ++y) {
        for (int x = 0; x < w; ++x) {
          int sx = int(src.left + (x + .5f) * (src.right - src.left) / w);
          int sy = int(src.top + (y + .5f) * (src.bottom - src.top) / h);
          draw.pixels[y * w + x] = static_cast<const uint32_t*>(image->data->pixels)[sy * image->width() + sx];
        }
      }
    }
    if (bitmap_) { bitmap_->pixels = draw.pixels; bitmap_draw = draw; }
  }
  void drawImageRect(SkImage* image, SkRect dst, SkSamplingOptions options) {
    drawImageRect(image, SkRect::MakeIWH(image->width(), image->height()), dst,
                  options, nullptr, kFast_SrcRectConstraint);
  }
 private:
  std::shared_ptr<BitmapPixels> bitmap_;
};
struct SkDrawable {
  virtual ~SkDrawable() = default;
  void draw(SkCanvas* canvas) { onDraw(canvas); }
  SkRect bounds() { return onGetBounds(); }
  virtual SkRect onGetBounds() = 0;
  virtual void onDraw(SkCanvas*) = 0;
};
@SOURCE_RECT@
