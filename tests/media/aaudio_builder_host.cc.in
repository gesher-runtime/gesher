// Verbatim production builders/callback loops/queries with a deterministic
// device boundary. No Windows hardware or audio samples are emulated here.
#include <algorithm>
#include <atomic>
#include <chrono>
#include <condition_variable>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <limits>
#include <memory>
#include <mutex>
#include <new>
#include <string>
#include <thread>
#include <vector>
#include <sys/types.h>

// <gesher/perf_trace.h>'s timing sites as production runs them without
// GESHER_PERF_TRACE (docs/media.md, "Measuring playback"): off.
namespace gesher::perf {
inline bool Enabled() { return false; }
inline int64_t Now() { return 0; }
struct Site {
  constexpr explicit Site(const char*, int64_t = 0) {}
  void Add(int64_t, int64_t = 0) {}
};
}  // namespace gesher::perf
#define SYSV
#define MEDIA_LOGE(...) ((void)0)
#define MEDIA_LOGI(...) ((void)0)
namespace gesher::bionic { void EnterLoadedCode() {} }
void RaiseAudioThreadPriority(bool) {}
constexpr int kInputDeviceId = 3, kOutputDeviceId = 2;
enum class PcmFormat { kFloat, kS16, kS24Packed, kS32 };
size_t BytesPerSample(PcmFormat pcm) { return pcm == PcmFormat::kS16 ? 2 : pcm == PcmFormat::kS24Packed ? 3 : 4; }
struct TrackParams {
  uint32_t sample_rate = 0, channels = 0; PcmFormat format = PcmFormat::kFloat;
  int stream_type = 0, session_id = 0; size_t capacity_frames = 0; std::string name;
};
struct CaptureParams {
  uint32_t sample_rate = 0, channels = 0; PcmFormat format = PcmFormat::kFloat;
  size_t capacity_frames = 0; std::string name;
};
struct OutputInfo { uint32_t sample_rate = 48000, period_frames = 480; };
struct InputInfo { uint32_t sample_rate = 48000; };
OutputInfo output_info;
OutputInfo GetOutputInfo() { return output_info; }
InputInfo GetInputInfo() { return {}; }
bool allowed = true;
bool RecordingAllowed() { return allowed; }
int factories = 0, timestamp_calls = 0;
bool timestamp_ready = false;
int last_session = 0;
int NewSessionId() { return 1234; }
struct Track {
  size_t capacity = 0; uint32_t size = 0;
  uint32_t buffer_capacity_frames() const { return static_cast<uint32_t>(capacity); }
  uint32_t buffer_size_frames() const { return size; }
  int32_t SetBufferSizeFrames(uint32_t frames) { size = static_cast<uint32_t>(std::min<size_t>(capacity, frames)); return size; }
  bool Timestamp(int64_t* frames, int64_t* ns) { ++timestamp_calls; *frames = 42; *ns = 555; return timestamp_ready; }
  uint32_t underrun_count() const { return 0; }
  int64_t Position() const { return 0; }
  bool WaitForRoom(size_t, int) { return true; }
  ssize_t Write(void*, size_t bytes, bool) { return static_cast<ssize_t>(bytes); }
  int Start() { return 0; }
  void Pause() {}
  void Flush() {}
  void Stop() {}
  void Release() {}
};
constexpr int kCaptureDeadObject = -32;
constexpr int kCaptureUnavailable = -19;
struct CaptureStream {
  std::atomic<uint64_t> state_wake_sequence{0};
  uint64_t StateWakeSequence() const { return state_wake_sequence.load(); }
  void WaitForStateWake(uint64_t observed) const { state_wake_sequence.wait(observed); }
  void NotifyStateWake() { ++state_wake_sequence; state_wake_sequence.notify_all(); }
  int error() const { return 0; }
  size_t capacity = 0;
  size_t capacity_frames() const { return capacity; }
  uint32_t overrun_count() const { return 0; }
  int64_t frames_captured() const { return 0; }
  int64_t frames_read() const { return 0; }
  bool Timestamp(int64_t* frames, int64_t* ns) { ++timestamp_calls; *frames = 84; *ns = 777; return timestamp_ready; }
  bool WaitForData(size_t, int) { return true; }
  ssize_t Read(void*, size_t bytes, bool) { return static_cast<ssize_t>(bytes); }
  int Start() { return 0; }
  void Stop() { NotifyStateWake(); }
  void Release() { NotifyStateWake(); }
};
std::shared_ptr<Track> CreateTrack(const TrackParams& p, std::string*) {
  ++factories; last_session = p.session_id;
  auto track = std::make_shared<Track>(); track->capacity = p.capacity_frames + 64;
  track->size = static_cast<uint32_t>(track->capacity); return track;
}
std::shared_ptr<CaptureStream> OpenCapture(const CaptureParams& p, std::string*) {
  ++factories;
  auto capture = std::make_shared<CaptureStream>(); capture->capacity = p.capacity_frames + 16; return capture;
}
struct AAudioStream;
void TraceInput(AAudioStream*, const char*, int32_t, int32_t) {}
@TYPES@
@STREAM@
@CALLBACKS@
@BUILDERS@
@CLOSE@
@QUERIES@
int checks = 0, failures = 0;
void Check(bool condition, const char* name) { ++checks; if (!condition) { ++failures; std::fprintf(stderr, "FAIL %s\n", name); } }
void Bad(Builder b, int expected, const char* name) {
  const int before = factories;
  AAudioStream* out = reinterpret_cast<AAudioStream*>(uintptr_t{1});
  int result = OpenStream(&b, &out);
  Check(result == expected, name);
  Check(result < 0 && out == nullptr && factories == before, "failed open clears output before reaching backend");
  if (out != nullptr && out != reinterpret_cast<AAudioStream*>(uintptr_t{1})) Close(out);
}
std::atomic<int> callback_count{0}, callback_frames{0};
int32_t OnData(AAudioStream*, void*, void*, int32_t frames) {
  callback_frames = frames; ++callback_count; return 1;
}
int main() {
  Builder* created = nullptr;
  Check(CreateStreamBuilder(&created) == 0 && created != nullptr, "builder created");
  Check(BuilderDelete(created) == 0, "builder deleted");
  Check(CreateStreamBuilder(nullptr) == -886, "null builder output rejected");
  AAudioStream* out = reinterpret_cast<AAudioStream*>(uintptr_t{1});
  Check(OpenStream(nullptr, &out) == -886 && out == nullptr, "null builder clears stream output");
  Builder base;
  Check(OpenStream(&base, nullptr) == -886, "null stream output rejected");
  for (int direction : {-1, 2, std::numeric_limits<int32_t>::max()}) { Builder b; b.direction = direction; Bad(b, -898, "invalid direction"); }
  for (int channels : {-1, 13, std::numeric_limits<int32_t>::max()}) { Builder b; b.channels = channels; Bad(b, -882, "invalid channel count"); }
  for (int rate : {-1, 7999, 1600001}) { Builder b; b.sample_rate = rate; Bad(b, -880, "invalid sample rate"); }
  for (int frames : {-1, 1048577, std::numeric_limits<int32_t>::max()}) { Builder b; b.frames_per_callback = frames; Bad(b, -882, "invalid callback frame count"); }
  for (int sharing : {-1, 2}) { Builder b; b.sharing = sharing; Bad(b, -898, "invalid sharing enum"); }
  for (int performance : {0, 9, 14}) { Builder b; b.performance = performance; Bad(b, -898, "invalid performance enum"); }
  { Builder b; b.performance = 13; Bad(b, -889, "offload unavailable"); }
  { Builder b; b.format = 6; Bad(b, -883, "unsupported compressed format"); }
  { Builder b; b.capacity = -1; Bad(b, -882, "negative capacity"); }
  { Builder b; b.device_id = -1; Bad(b, -882, "negative device id"); }
  { Builder b; b.device_id = 99; Bad(b, -889, "unavailable device id"); }
  { Builder b; b.usage = 7; Bad(b, -898, "invalid usage enum"); }
  { Builder b; b.content_type = 5; Bad(b, -898, "invalid content enum"); }
  { Builder b; b.input_preset = 2; Bad(b, -898, "invalid input preset enum"); }
  { Builder b; b.capacity = std::numeric_limits<int32_t>::max(); Bad(b, -887, "huge output ring rejected before allocation"); }
  { Builder b; b.direction = 1; b.capacity = std::numeric_limits<int32_t>::max(); Bad(b, -887, "huge input ring rejected before allocation"); }
  { Builder b; b.direction = 1; b.sample_rate = 192001; Bad(b, -880, "capture rate limit"); }
  { Builder b; b.direction = 1; b.channels = 9; Bad(b, -889, "capture channel limit"); }
  { Builder b; b.channels = 12; b.frames_per_callback = 1048576; Bad(b, -887, "callback-derived byte budget checked with channels"); }
  { Builder b; b.direction = 1; allowed = false; Bad(b, -889, "capture permission failure clears output"); allowed = true; }
  output_info = {1, std::numeric_limits<uint32_t>::max()};
  { Builder b; b.sample_rate = 1600000; Bad(b, -882, "unrepresentable device burst is rejected before narrowing"); }
  output_info = {};
  for (int direction : {0, 1}) {
    Builder b; b.direction = direction; b.performance = 12; b.sharing = 0; b.session_id = 0;
    b.frames_per_callback = 123;
    AAudioStream* stream = nullptr;
    Check(OpenStream(&b, &stream) == 0 && stream != nullptr, "valid stream opens");
    if (stream == nullptr) continue;
    Check(GetPerformanceMode(stream) == 10 && GetSharingMode(stream) == 1, "actual shared mixer performance reported");
    Check(GetFramesPerBurst(stream) == 480 && GetFramesPerDataCallback(stream) == 123, "hardware burst distinct from callback size");
    Check(GetBufferCapacityInFrames(stream) == (direction == 0 ? 480 * 4 + 64 : 480 * 8 + 16), "actual backend capacity reported");
    Check(GetSampleRate(stream) == 48000 && GetChannelCount(stream) == (direction == 0 ? 2 : 1), "default format negotiated");
    Check(GetFormat(stream) == 2 && GetDeviceId(stream) == (direction == 0 ? 2 : 3), "actual format and device");
    Check(GetSessionId(stream) == 1234 && (direction != 0 || last_session == 1234), "allocated session reaches track");
    int old_size = GetBufferSizeInFrames(stream);
    Check(SetBufferSizeInFrames(stream, -1) == -882 && GetBufferSizeInFrames(stream) == old_size, "negative buffer size preserves old size");
    int64_t frame = 91, ns = 92;
    Check(GetTimestamp(stream, 1, &frame, &ns) == -895 && frame == 91 && ns == 92, "stopped timestamp leaves outputs unchanged");
    stream->state = kStateStarted;
    timestamp_ready = false;
    Check(GetTimestamp(stream, 1, &frame, &ns) == -895 && frame == 91 && ns == 92, "backend failure cannot publish partial timestamp");
    int calls = timestamp_calls;
    Check(GetTimestamp(stream, 0, &frame, &ns) == -898 && frame == 91 && ns == 92 && timestamp_calls == calls, "unsupported clock rejected before backend");
    Check(GetTimestamp(stream, 7, &frame, &ns) == -890 && frame == 91 && ns == 92 && timestamp_calls == calls, "unqualified suspend clock is explicitly unsupported");
    timestamp_ready = true;
    Check(GetTimestamp(stream, 1, &frame, &ns) == 0 && frame == (direction == 0 ? 42 : 84) && ns == (direction == 0 ? 555 : 777), "monotonic timestamp output published together");
    Close(stream);
  }
  for (int direction : {0, 1}) {
    Builder b; b.direction = direction; b.data_cb = OnData; b.frames_per_callback = 123;
    AAudioStream* stream = nullptr;
    Check(OpenStream(&b, &stream) == 0 && stream != nullptr, "callback stream opens");
    if (stream == nullptr) continue;
    callback_count = 0; callback_frames = 0;
    Check(RequestStart(stream) == 0, "callback stream starts through the production lifecycle");
    auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(2);
    while (callback_count == 0 && std::chrono::steady_clock::now() < deadline) std::this_thread::yield();
    Check(callback_count == 1 && callback_frames == 123, "real production callback loop uses negotiated callback frames");
    Close(stream);
  }
  { Builder b; b.data_cb = OnData; AAudioStream* stream = nullptr;
    Check(OpenStream(&b, &stream) == 0 && stream != nullptr, "unspecified callback size opens");
    if (stream != nullptr) { Check(GetFramesPerDataCallback(stream) == GetFramesPerBurst(stream), "default callback getter reports actual frame count"); Close(stream); }
  }
  Check(GetDeviceId(nullptr) == -886 && GetSharingMode(nullptr) == -886, "null query handles are rejected");
  Check(std::strcmp(ResultToText(-887), "AAUDIO_ERROR_NO_MEMORY") == 0 &&
        std::strcmp(ResultToText(-882), "AAUDIO_ERROR_OUT_OF_RANGE") == 0 &&
        std::strcmp(ResultToText(-880), "AAUDIO_ERROR_INVALID_RATE") == 0, "new errors have Android names");
  std::printf("AAudio builder contracts: %d checks, %d failures\n", checks, failures);
  return failures == 0 ? 0 : 1;
}
