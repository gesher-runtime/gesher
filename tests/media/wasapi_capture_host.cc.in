// Complete production WASAPI implementation. Only class visibility permits
// injecting the documented IAudioCaptureClient COM boundary; no device opens.
#include <cstdlib>
@WASAPI@
class CaptureBoundary final : public IAudioCaptureClient {
 public:
  HRESULT next = S_OK, result = S_OK;
  UINT32 frames = 2;
  DWORD flags = 0;
  BYTE* data = nullptr;
  float samples[2]{.25f, -.5f};
  bool consumed = false;
  int releases = 0;
  HRESULT STDMETHODCALLTYPE QueryInterface(REFIID, void**) override { return E_NOINTERFACE; }
  ULONG STDMETHODCALLTYPE AddRef() override { return 1; }
  ULONG STDMETHODCALLTYPE Release() override { return 1; }
  HRESULT STDMETHODCALLTYPE GetNextPacketSize(UINT32* count) override {
    *count = consumed ? 0 : frames > 0 ? frames : 1;
    return next;
  }
  HRESULT STDMETHODCALLTYPE GetBuffer(BYTE** pointer, UINT32* count, DWORD* output_flags, UINT64*, UINT64*) override {
    *pointer = data; *count = frames; *output_flags = flags; return result;
  }
  HRESULT STDMETHODCALLTYPE ReleaseBuffer(UINT32) override { ++releases; consumed = true; return S_OK; }
};
class ClientBoundary final : public IAudioClient {
 public:
  CaptureBoundary* capture = nullptr;
  HRESULT reset_result = S_OK, start_result = S_OK;
  bool running = false;
  int starts = 0, stops = 0, resets = 0;
  HRESULT STDMETHODCALLTYPE QueryInterface(REFIID, void**) override { return E_NOINTERFACE; }
  ULONG STDMETHODCALLTYPE AddRef() override { return 1; }
  ULONG STDMETHODCALLTYPE Release() override { return 1; }
  HRESULT STDMETHODCALLTYPE Initialize(AUDCLNT_SHAREMODE, DWORD, REFERENCE_TIME, REFERENCE_TIME,
                                        const WAVEFORMATEX*, LPCGUID) override { return E_NOTIMPL; }
  HRESULT STDMETHODCALLTYPE GetBufferSize(UINT32*) override { return E_NOTIMPL; }
  HRESULT STDMETHODCALLTYPE GetStreamLatency(REFERENCE_TIME*) override { return E_NOTIMPL; }
  HRESULT STDMETHODCALLTYPE GetCurrentPadding(UINT32*) override { return E_NOTIMPL; }
  HRESULT STDMETHODCALLTYPE IsFormatSupported(AUDCLNT_SHAREMODE, const WAVEFORMATEX*, WAVEFORMATEX**) override {
    return E_NOTIMPL;
  }
  HRESULT STDMETHODCALLTYPE GetMixFormat(WAVEFORMATEX**) override { return E_NOTIMPL; }
  HRESULT STDMETHODCALLTYPE GetDevicePeriod(REFERENCE_TIME*, REFERENCE_TIME*) override { return E_NOTIMPL; }
  HRESULT STDMETHODCALLTYPE Start() override {
    ++starts;
    if (running) return AUDCLNT_E_NOT_STOPPED;
    if (SUCCEEDED(start_result)) running = true;
    return start_result;
  }
  HRESULT STDMETHODCALLTYPE Stop() override { ++stops; running = false; return S_OK; }
  HRESULT STDMETHODCALLTYPE Reset() override {
    ++resets;
    if (running) return AUDCLNT_E_NOT_STOPPED;
    if (SUCCEEDED(reset_result)) capture->consumed = true;
    return reset_result;
  }
  HRESULT STDMETHODCALLTYPE SetEventHandle(HANDLE) override { return E_NOTIMPL; }
  HRESULT STDMETHODCALLTYPE GetService(REFIID, void**) override { return E_NOTIMPL; }
};
int checks = 0;
void Check(bool ok, const char* message) {
  ++checks;
  if (!ok) { std::fprintf(stderr, "FAIL WASAPI capture: %s\n", message); std::exit(1); }
}
int main() {
  for (int kind = 0; kind < 7; ++kind) {
    CaptureBoundary boundary;
    if (kind == 0) { boundary.result = AUDCLNT_S_BUFFER_EMPTY; boundary.frames = 0; }
    if (kind == 1) boundary.result = AUDCLNT_E_BUFFER_ERROR;
    if (kind == 2) boundary.result = AUDCLNT_E_SERVICE_NOT_RUNNING;
    if (kind == 3) boundary.next = AUDCLNT_E_DEVICE_INVALIDATED;
    if (kind == 4) boundary.flags = AUDCLNT_BUFFERFLAGS_SILENT;
    if (kind == 5) boundary.data = reinterpret_cast<BYTE*>(boundary.samples);
    gesher::media::WasapiCapture source;
    source.capture_ = &boundary;
    source.channels_ = 1; source.rate_ = 48000; source.bits_ = 32; source.is_float_ = true;
    std::vector<float> output{.75f};
    const bool result = source.Pull(&output);
    Check(result == (kind == 0 || kind == 1 || kind == 4 || kind == 5), "COM result classification");
    if (kind == 4) Check(output == std::vector<float>({.75f, 0, 0}), "genuine hardware silent flag preserves captured silence");
    else if (kind == 5) Check(output == std::vector<float>({.75f, .25f, -.5f}), "genuine float packet copied exactly");
    else Check(output == std::vector<float>({.75f}), "empty/error/null payload cannot create samples");
    Check(boundary.releases == (kind >= 4 ? 1 : 0), "successful packets released exactly once");
  }
  {
    CaptureBoundary capture;
    capture.data = reinterpret_cast<BYTE*>(capture.samples);
    ClientBoundary client;
    client.capture = &capture;
    gesher::media::WasapiCapture source;
    source.client_ = &client; source.capture_ = &capture;
    source.channels_ = 1; source.rate_ = 48000; source.bits_ = 32; source.is_float_ = true;
    Check(source.Start(), "first start admits a stopped initialized stream");
    capture.consumed = false;  // Endpoint packet queued before stopping.
    source.Stop();
    source.Stop();
    Check(source.Start(), "restart admits a stopped source");
    std::vector<float> output;
    Check(source.Pull(&output) && output.empty() && capture.releases == 0, "restart cannot return queued pre-stop packets");
    Check(client.stops == 1 && client.resets == 2 && client.starts == 2, "initial and restarted capture reset only while stopped");
    Check(source.Start() && client.resets == 2 && client.starts == 2, "idempotent start never resets a running source");
    capture.consumed = false;  // Genuine packet arriving after the new start.
    Check(source.Pull(&output) && output == std::vector<float>({.25f, -.5f}), "new capture packets remain unchanged");
    source.Stop();
    client.reset_result = AUDCLNT_E_DEVICE_INVALIDATED;
    Check(!source.Start() && client.starts == 2 && !client.running, "failed reset never calls Start or claims success");
    client.reset_result = S_FALSE;  // Already-reset streams are successful.
    client.start_result = AUDCLNT_E_SERVICE_NOT_RUNNING;
    Check(!source.Start() && client.starts == 3 && !client.running, "successful reset still propagates failed Start");
    client.start_result = S_OK;
    Check(source.Start() && client.starts == 4 && client.resets == 5, "failed start remains stopped and safely retryable");
    source.Stop();
  }
  std::printf("WASAPI capture contracts: %d checks PASS\n", checks);
}
