// Capture backend and JNI array adapters only; Capture state/nativeRead/trace are production.
#include <algorithm>
#include <array>
#include <atomic>
#include <chrono>
#include <condition_variable>
#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <initializer_list>
#include <mutex>
#include <new>
#include <thread>
#include <vector>

bool count_allocations = false;
size_t allocations = 0, allocated_bytes = 0, retained_bytes = 0, checks = 0, failures = 0;
// Keep malloc-compatible addresses: the Windows C++ runtime can destroy
// std::thread's private allocation in a DLL that does not call this delete.
struct Allocation { void* pointer; size_t bytes; };
std::array<Allocation, 1024> tracked{};
size_t tracked_count = 0;
void* operator new(size_t size) {
  void* pointer = std::malloc(size ? size : 1);
  if (pointer == nullptr) std::abort();
  if (count_allocations) {
    if (tracked_count == tracked.size()) std::abort();
    tracked[tracked_count++] = {pointer, size};
    ++allocations; allocated_bytes += size; retained_bytes += size;
  }
  return pointer;
}
void* operator new[](size_t size) { return ::operator new(size); }
void operator delete(void* ptr) noexcept {
  if (ptr == nullptr) return;
  for (size_t i = 0; i < tracked_count; ++i) {
    if (tracked[i].pointer == ptr) {
      retained_bytes -= tracked[i].bytes;
      tracked[i].pointer = nullptr;
      break;
    }
  }
  std::free(ptr);
}
void operator delete[](void* p) noexcept { ::operator delete(p); }
void operator delete(void* p, size_t) noexcept { ::operator delete(p); }
void operator delete[](void* p, size_t) noexcept { ::operator delete(p); }
using HRESULT = int32_t;
constexpr HRESULT S_OK = 0, E_INVALIDARG = static_cast<int32_t>(0x80070057u),
                  E_UNEXPECTED = static_cast<int32_t>(0x8000ffffu),
                  E_NOTIMPL = static_cast<int32_t>(0x80004001u);
bool SUCCEEDED(HRESULT value) { return value >= 0; }
using jint = int32_t;
using jsize = int32_t;
using jlong = int64_t;
using jbyte = int8_t;
using jclass = void*;
struct Array { std::vector<jbyte> bytes; };
using jbyteArray = Array*;
struct JNIEnv {
  int writes = 0;
  jsize GetArrayLength(jbyteArray array) { return static_cast<jsize>(array->bytes.size()); }
  void SetByteArrayRegion(jbyteArray array, jsize begin, jsize size, const jbyte* data) {
    ++writes;
    if (begin < 0 || size < 0 || static_cast<size_t>(begin) + size > array->bytes.size()) std::abort();
    std::memcpy(array->bytes.data() + begin, data, size);
  }
};
void Check(bool ok, const char* reason) {
  ++checks;
  if (!ok) { ++failures; if (failures < 12) std::fprintf(stderr, "FAIL capture: %s\n", reason); }
}
@TRACE@
namespace gesher::devices::camera {
@CAPTURE@
}
namespace cam = gesher::devices::camera;
@JNI@

class Source : public cam::Capture {
 public:
  Source(int w, int h) { width = w; height = h; }
  HRESULT Read(uint8_t* dst) override {
    uint32_t number = ++calls;
    size_t count = static_cast<size_t>(width) * height * 3 / 2;
    if (fail) count /= 2;  // A producer may have written a prefix before failing.
    std::memset(dst, static_cast<int>(number & 255), count);
    return fail ? E_UNEXPECTED : S_OK;
  }
  uint32_t calls = 0;
  bool fail = false;
};

void Single(int w, int h, bool gate) {
  Array array;
  size_t size = static_cast<size_t>(w) * h * 3 / 2;
  array.bytes.resize(size + 13, -1);
  JNIEnv env;
  {
    Source source(w, h);
    allocations = allocated_bytes = 0;
    count_allocations = true;
    HRESULT hr = WindowsCamera_read(&env, nullptr, reinterpret_cast<jlong>(&source), &array);
    count_allocations = false;
    Check(hr == S_OK && env.writes == 1, "first read publishes once");
    Check(std::all_of(array.bytes.begin(), array.bytes.begin() + size, [](jbyte b) { return b == 1; }),
          "first complete frame published");
    Check(std::all_of(array.bytes.begin() + size, array.bytes.end(), [](jbyte b) { return b == -1; }),
          "array suffix outside frame unchanged");
    if (gate) Check(allocations == 1 && allocated_bytes == size && retained_bytes == size,
                    "cold native storage is exactly one retained frame");
    allocations = allocated_bytes = 0;
    count_allocations = true;
    for (int call = 0; call < 100; ++call) {
      hr = WindowsCamera_read(&env, nullptr, reinterpret_cast<jlong>(&source), &array);
      if (hr != S_OK) std::abort();
    }
    count_allocations = false;
    if (gate) Check(allocations == 0 && allocated_bytes == 0 && retained_bytes == size,
                    "warmed reads perform no native storage allocations");
    Check(source.calls == 101 && env.writes == 101, "each read invokes capture once and publishes once");
    Check(std::all_of(array.bytes.begin(), array.bytes.begin() + size, [](jbyte b) { return b == 101; }),
          "reused scratch contains newest frame");
    const auto previous = array.bytes;
    source.fail = true;
    hr = WindowsCamera_read(&env, nullptr, reinterpret_cast<jlong>(&source), &array);
    Check(hr == E_UNEXPECTED && env.writes == 101 && array.bytes == previous,
          "failed partial capture preserves Java array and HRESULT");
    source.fail = false;
    hr = WindowsCamera_read(&env, nullptr, reinterpret_cast<jlong>(&source), &array);
    Check(hr == S_OK && env.writes == 102 &&
              std::all_of(array.bytes.begin(), array.bytes.begin() + size, [](jbyte b) { return b == 103; }),
          "successful read after failure replaces every frame byte");
    // A second open capture has independent scratch and frame sequence.
    Source other(w, h);
    Array second;
    second.bytes.resize(size, -1);
    JNIEnv second_env;
    Check(WindowsCamera_read(&second_env, nullptr, reinterpret_cast<jlong>(&other), &second) == S_OK &&
              second.bytes.front() == 1 && array.bytes.front() == 103,
          "different captures have independent frame storage");
  }
  Check(retained_bytes == 0, "closing capture releases all tracked frame storage");
}

void Invalid() {
  Array array;
  array.bytes.resize(24, 7);
  JNIEnv env;
  Check(WindowsCamera_read(&env, nullptr, 0, &array) == E_INVALIDARG, "null capture rejected");
  const int dims[][2] = {{0, 4}, {4, 0}, {-2, 4}, {4, -2}, {3, 4}, {4, 3},
                          {65536, 65536}, {INT32_MAX - 1, INT32_MAX - 1}, {8, 8}};
  for (const auto& d : dims) {
    Source source(d[0], d[1]);
    allocations = 0;
    count_allocations = true;
    HRESULT hr = WindowsCamera_read(&env, nullptr, reinterpret_cast<jlong>(&source), &array);
    count_allocations = false;
    Check(hr == E_INVALIDARG && source.calls == 0 && env.writes == 0 && allocations == 0,
          "invalid dimensions/truncated array rejected before allocation or capture");
  }
  Source source(4, 4);
  Check(WindowsCamera_read(&env, nullptr, reinterpret_cast<jlong>(&source), nullptr) == E_INVALIDARG &&
            source.calls == 0, "null frame rejected before capture");
}

class ConcurrentSource : public cam::Capture {
 public:
  ConcurrentSource() { width = 64; height = 48; }
  HRESULT Read(uint8_t* dst) override {
    int n = ++active;
    int maximum = peak.load();
    while (maximum < n && !peak.compare_exchange_weak(maximum, n)) {}
    uint32_t frame = ++calls;
    // Real capture can block; stretch the handoff to reveal sharing before publication.
    std::this_thread::sleep_for(std::chrono::microseconds(200));
    std::memset(dst, static_cast<int>(frame & 255), static_cast<size_t>(width) * height * 3 / 2);
    --active;
    return S_OK;
  }
  std::atomic<int> active{0}, peak{0};
  std::atomic<uint32_t> calls{0};
};

void Concurrent() {
  ConcurrentSource source;
  constexpr int count = 6, rounds = 12;
  std::array<Array, count> output;
  std::array<JNIEnv, count> env;
  std::array<std::thread, count> threads;
  std::array<bool, count> good;
  good.fill(true);
  for (auto& a : output) a.bytes.resize(64 * 48 * 3 / 2);
  std::atomic<int> ready{0};
  std::atomic<bool> start{false};
  for (int i = 0; i < count; ++i) {
    threads[i] = std::thread([&, i] {
      ++ready;
      while (!start.load()) std::this_thread::yield();
      for (int n = 0; n < rounds; ++n) {
        if (WindowsCamera_read(&env[i], nullptr, reinterpret_cast<jlong>(&source), &output[i]) != S_OK)
          good[i] = false;
        jbyte first = output[i].bytes.front();
        if (!std::all_of(output[i].bytes.begin(), output[i].bytes.end(),
                         [first](jbyte b) { return b == first; })) good[i] = false;
      }
    });
  }
  while (ready.load() < count) std::this_thread::yield();
  start = true;
  for (auto& t : threads) t.join();
  Check(source.peak == 1 && source.calls == count * rounds, "one backend reader at a time per capture");
  for (int i = 0; i < count; ++i)
    Check(good[i] && env[i].writes == rounds, "concurrent caller receives complete private Java frames");
}

void Measure(int w, int h) {
  Source source(w, h);
  Array output;
  output.bytes.resize(static_cast<size_t>(w) * h * 3 / 2);
  JNIEnv env;
  WindowsCamera_read(&env, nullptr, reinterpret_cast<jlong>(&source), &output);
  allocations = allocated_bytes = 0;
  const auto begin = std::chrono::steady_clock::now();
  count_allocations = true;
  for (int n = 0; n < 100; ++n) WindowsCamera_read(&env, nullptr, reinterpret_cast<jlong>(&source), &output);
  count_allocations = false;
  double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - begin).count();
  std::printf("Capture JNI %dx%d: 100 warm reads, %zu native allocations, %zu allocated bytes, %.3f ms\n",
              w, h, allocations, allocated_bytes, ms);
}

int main(int argc, char** argv) {
  bool gate = argc < 2 || std::strcmp(argv[1], "measure") != 0;
  for (auto size : {std::pair{2, 2}, std::pair{4, 6}, std::pair{640, 480}, std::pair{1280, 720}})
    Single(size.first, size.second, gate);
  if (gate && (argc < 2 || std::strcmp(argv[1], "valid-gate") != 0)) { Invalid(); Concurrent(); }
  Measure(1280, 720);
  Measure(1920, 1080);
  Check(retained_bytes == 0, "all capture buffers released at completion");
  std::printf("Camera capture: %zu checks, %zu failures\n", checks, failures);
  return failures != 0;
}
