// Production Win32Surface, LayeredBitmap, Window::PresentLayered, Window::PresentPixels,
// and PostWindowDirty compiled against declared Win32/GDI adapters and a pixel oracle.
#define GESHER_TEST_WINDOW_DIRTY 1
#define GESHER_HAS_DIRTY @HAS_DIRTY@

#include <algorithm>
#include <atomic>
#include <cerrno>
#include <chrono>
#include <climits>
#include <cstdarg>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <limits>
#include <memory>
#include <mutex>
#include <vector>

bool g_measure_mode = false;

struct FakeBitmap {
  int width = 0, height = 0;
  std::vector<uint8_t> pixels;
  std::vector<uint8_t> shadow;
};
struct FakeDC {
  void* selected = reinterpret_cast<void*>(1);
};
using HDC = FakeDC*;
using HBITMAP = FakeBitmap*;
using HGDIOBJ = void*;
using HWND = void*;
struct RECT { int left, top, right, bottom; };
struct SIZE { int cx, cy; };
struct POINT { int x, y; };
struct BITMAPINFOHEADER {
  uint32_t biSize;
  int biWidth, biHeight;
  uint16_t biPlanes, biBitCount;
  uint32_t biCompression;
};
struct BITMAPINFO { BITMAPINFOHEADER bmiHeader; };
struct BLENDFUNCTION { uint8_t BlendOp, BlendFlags, SourceConstantAlpha, AlphaFormat; };

constexpr unsigned BI_RGB = 0, DIB_RGB_COLORS = 0, RDW_INVALIDATE = 1, RDW_FRAME = 2,
                   RDW_ALLCHILDREN = 4, AC_SRC_OVER = 0, AC_SRC_ALPHA = 1;
#define ULW_ALPHA 2u
#define FALSE 0
constexpr unsigned kMsgPresentLayered = 0x8040;
const auto HGDI_ERROR = reinterpret_cast<void*>(-1);

struct HostMetrics {
  size_t dc_created = 0, dc_deleted = 0, dib_created = 0, dib_deleted = 0, gdi_flushes = 0;
  size_t invalidate_full = 0, invalidate_rect = 0;
  RECT last_invalidated = {0, 0, 0, 0};
  size_t layered_posts = 0, ulw_calls = 0, dib_bytes_mutated = 0;
} g_metrics;

HDC CreateCompatibleDC(HDC) {
  ++g_metrics.dc_created;
  return new FakeDC();
}
HBITMAP CreateDIBSection(HDC, const BITMAPINFO* info, unsigned, void** bits, void*, unsigned) {
  ++g_metrics.dib_created;
  auto* bmp = new FakeBitmap{info->bmiHeader.biWidth, -info->bmiHeader.biHeight, {}, {}};
  const size_t n = static_cast<size_t>(bmp->width) * bmp->height * 4;
  bmp->pixels.assign(n, 0xcc);
  if (!g_measure_mode) bmp->shadow = bmp->pixels;
  *bits = bmp->pixels.data();
  return bmp;
}
HGDIOBJ SelectObject(HDC dc, HGDIOBJ obj) {
  HGDIOBJ prev = dc->selected;
  dc->selected = obj;
  return prev;
}
int DeleteObject(HGDIOBJ obj) {
  ++g_metrics.dib_deleted;
  delete static_cast<FakeBitmap*>(obj);
  return 1;
}
int DeleteDC(HDC dc) {
  ++g_metrics.dc_deleted;
  delete dc;
  return 1;
}
int GdiFlush() {
  ++g_metrics.gdi_flushes;
  return 1;
}
HDC GetDC(HWND) { return nullptr; }
int ReleaseDC(HWND, HDC) { return 1; }
int RedrawWindow(HWND, const void*, const void*, unsigned) { return 1; }
int InvalidateRect(HWND, const RECT* rc, int) {
  if (rc == nullptr) {
    ++g_metrics.invalidate_full;
    g_metrics.last_invalidated = {0, 0, 0, 0};
  } else {
    ++g_metrics.invalidate_rect;
    g_metrics.last_invalidated = *rc;
  }
  return 1;
}
int PostMessageW(HWND, unsigned msg, uintptr_t, intptr_t) {
  if (msg == kMsgPresentLayered) ++g_metrics.layered_posts;
  return 1;
}
int UpdateLayeredWindow(HWND, HDC, const POINT*, const SIZE*, HDC src_dc, const POINT*,
                        unsigned, const BLENDFUNCTION*, unsigned) {
  ++g_metrics.ulw_calls;
  if (!g_measure_mode && src_dc != nullptr && src_dc->selected != reinterpret_cast<void*>(1)) {
    auto* bmp = static_cast<FakeBitmap*>(src_dc->selected);
    for (size_t i = 0; i < bmp->pixels.size(); ++i) {
      if (bmp->pixels[i] != bmp->shadow[i]) ++g_metrics.dib_bytes_mutated;
    }
    bmp->shadow = bmp->pixels;
  }
  return 1;
}

@CONSTANTS@
constexpr int ANDROID_NATIVE_WINDOW_MAGIC = 0x574e444f;
constexpr int HAL_PIXEL_FORMAT_RGBA_8888 = 1, HAL_PIXEL_FORMAT_RGBX_8888 = 2;
constexpr int HAL_PIXEL_FORMAT_BGRA_8888 = 5;
constexpr int64_t NATIVE_WINDOW_TIMESTAMP_AUTO = INT64_MIN;
struct ARect { int left, top, right, bottom; };
struct ANativeWindow_Buffer {
  int width = 0, height = 0, stride = 0, format = 0;
  void* bits = nullptr;
  uint32_t reserved[6] = {};
};
struct ANativeWindowBuffer {
  int width = 0, height = 0, stride = 0, format = 0;
  int usage_deprecated = 0, layerCount = 0;
  void* reserved[4] = {};
  void* handle = nullptr;
  uint64_t usage = 0;
};
struct ANativeWindow {
  struct { int magic = ANDROID_NATIVE_WINDOW_MAGIC; } common;
  float xdpi = 0, ydpi = 0;
  int minSwapInterval = 0, maxSwapInterval = 0;
  int (*setSwapInterval)(ANativeWindow*, int) = nullptr;
  int (*queueBuffer)(ANativeWindow*, ANativeWindowBuffer*, int) = nullptr;
  int (*cancelBuffer)(ANativeWindow*, ANativeWindowBuffer*, int) = nullptr;
  int (*dequeueBuffer)(ANativeWindow*, ANativeWindowBuffer**, int*) = nullptr;
  int (*query)(const ANativeWindow*, int, int*) = nullptr;
  int (*perform)(ANativeWindow*, int, ...) = nullptr;
  void *dequeueBuffer_DEPRECATED = nullptr, *lockBuffer_DEPRECATED = nullptr;
  void *queueBuffer_DEPRECATED = nullptr, *cancelBuffer_DEPRECATED = nullptr;
};
namespace android {
class RefBase {};
template <class Base, class Self, class Ref> class ANativeObjectBase : public Base {};
template <class T> class sp {
 public:
  sp() = default;
  sp(std::nullptr_t) {}
  template <class... A> static sp make(A&&... args) {
    sp r;
    r.ptr_ = std::make_shared<T>(std::forward<A>(args)...);
    return r;
  }
  T* get() const { return ptr_.get(); }
  T* operator->() const { return get(); }
  bool operator==(std::nullptr_t) const { return !ptr_; }
  bool operator!=(std::nullptr_t) const { return bool(ptr_); }
  bool operator!=(const sp& other) const { return ptr_ != other.ptr_; }
 private:
  std::shared_ptr<T> ptr_;
};
class Surface : public ANativeWindow {
 public:
  explicit Surface(std::nullptr_t) {
    ANativeWindow::perform = Perform;
    ANativeWindow::query = [](const ANativeWindow* w, int what, int* val) {
      return static_cast<const Surface*>(w)->query(what, val);
    };
    ANativeWindow::dequeueBuffer = [](ANativeWindow* w, ANativeWindowBuffer** out, int* fence) {
      return getSelf(w)->dequeueBuffer(out, fence);
    };
  }
  virtual ~Surface() = default;
  static int Perform(ANativeWindow* w, int op, ...) {
    va_list args;
    va_start(args, op);
    int r = getSelf(w)->perform(op, args);
    va_end(args);
    return r;
  }
  static Surface* getSelf(ANativeWindow* w) { return static_cast<Surface*>(w); }
  virtual int lock(ANativeWindow_Buffer*, ARect*) = 0;
  virtual int unlockAndPost() = 0;
  virtual int query(int, int*) const = 0;
  virtual int dequeueBuffer(ANativeWindowBuffer**, int*) = 0;
  virtual int cancelBuffer(ANativeWindowBuffer*, int) = 0;
  virtual int queueBuffer(ANativeWindowBuffer*, int) = 0;
  virtual int perform(int, va_list) = 0;
  virtual int setSwapInterval(int) = 0;
};
}  // namespace android

@LAYERED_HEADER@

namespace gesher {
class Window {
 public:
  Window(int w, int h)
      : client_width_(w), client_height_(h), buffer_width_(w), buffer_height_(h),
        pixels_(static_cast<size_t>(w) * h * 4, 0xff) {}
  ~Window() {
#if GESHER_HAS_DIRTY
    EraseLayeredDirty(this);
#endif
    layered_bitmap_.reset();
  }
  int width() const {
    std::lock_guard<std::mutex> lock(buffer_mutex_);
    return client_width_;
  }
  int height() const {
    std::lock_guard<std::mutex> lock(buffer_mutex_);
    return client_height_;
  }
  void* hwnd() const { return hwnd_; }
  bool translucent() const { return translucent_; }
  uint64_t frames() const { return frames_; }

  void ResizeClient(int w, int h) {
    std::lock_guard<std::mutex> lock(buffer_mutex_);
    client_width_ = w;
    client_height_ = h;
  }

  void SetTranslucentHost(bool t) {
    if (translucent_.exchange(t) == t) return;
#if GESHER_HAS_DIRTY
    RecordLayeredFull(this);
#endif
    PostMessageW(hwnd_, kMsgPresentLayered, 0, 0);
  }

  void SetDimHost(int d) {
    d = std::clamp(d, 0, 255);
    if (dim_.exchange(d) == d) return;
#if GESHER_HAS_DIRTY
    SetLayeredDimmed(this, d != 0);
#endif
    if (layered_) PostMessageW(hwnd_, kMsgPresentLayered, 0, 0);
    else InvalidateRect(hwnd_, nullptr, FALSE);
  }

  void OnDisplayChangeHost() {
#if GESHER_HAS_DIRTY
    RecordLayeredFull(this);
#endif
    layered_bitmap_.reset();
  }

  uint8_t* Lock(int* w, int* h, int* stride) {
    buffer_mutex_.lock();
    ResizeBuffer(client_width_, client_height_);
    *w = buffer_width_;
    *h = buffer_height_;
    *stride = buffer_width_;
    return pixels_.data();
  }
  void Unlock() { buffer_mutex_.unlock(); }
  void UnlockAndPost() {
    ++frames_;
    buffer_mutex_.unlock();
    if (translucent_) {
      PostMessageW(hwnd_, kMsgPresentLayered, 0, 0);
      return;
    }
    InvalidateRect(hwnd_, nullptr, FALSE);
  }

  void ApplyExStyle() { ++style_changes; }
  const uint8_t* DimmedPixels() {
    const int d = dim_;
    if (d == 0) return pixels_.data();
    dimmed_.resize(pixels_.size());
    const unsigned keep = 255u - static_cast<unsigned>(d);
    for (size_t i = 0; i < pixels_.size(); i += 4) {
      dimmed_[i] = static_cast<uint8_t>((pixels_[i] * keep + 127u) / 255u);
      dimmed_[i + 1] = static_cast<uint8_t>((pixels_[i + 1] * keep + 127u) / 255u);
      dimmed_[i + 2] = static_cast<uint8_t>((pixels_[i + 2] * keep + 127u) / 255u);
      dimmed_[i + 3] = pixels_[i + 3];
    }
    return dimmed_.data();
  }

  void PresentPixels(const uint32_t* argb, int width, int height, int sourceStride = 0);
  void PresentLayered();

  void ReadBackBuffer(std::vector<uint32_t>* out, int* w, int* h) {
    std::lock_guard<std::mutex> lock(buffer_mutex_);
    const auto* p = reinterpret_cast<const uint32_t*>(pixels_.data());
    out->assign(p, p + static_cast<size_t>(buffer_width_) * buffer_height_);
    *w = buffer_width_;
    *h = buffer_height_;
  }

  uint8_t* RawLayeredBytes() const {
    if (layered_bitmap_ == nullptr || layered_bitmap_->dc() == nullptr) return nullptr;
    auto* bmp = static_cast<FakeBitmap*>(layered_bitmap_->dc()->selected);
    return bmp->pixels.data();
  }

  void* hwnd_ = reinterpret_cast<void*>(0x1234);
  mutable std::mutex buffer_mutex_;
  int client_width_ = 0, client_height_ = 0;
  int buffer_width_ = 0, buffer_height_ = 0;
  std::vector<uint8_t> pixels_;
  std::vector<uint8_t> dimmed_;
  std::atomic<uint64_t> frames_{0};
  std::atomic<bool> translucent_{false};
  bool layered_ = false;
  std::atomic<int> dim_{0};
  int style_changes = 0;
  std::unique_ptr<LayeredBitmap> layered_bitmap_;

 private:
  void ResizeBuffer(int width, int height) {
    if (width < 1) width = 1;
    if (height < 1) height = 1;
    if (width == buffer_width_ && height == buffer_height_) return;
    std::vector<uint8_t> fresh(static_cast<size_t>(width) * height * 4, 0xff);
    for (int y = 0; y < height && y < buffer_height_; ++y) {
      std::memcpy(&fresh[static_cast<size_t>(y) * width * 4],
                  &pixels_[static_cast<size_t>(y) * buffer_width_ * 4],
                  static_cast<size_t>(std::min(width, buffer_width_)) * 4);
    }
    pixels_.swap(fresh);
    buffer_width_ = width;
    buffer_height_ = height;
  }
};
}  // namespace gesher

@SURFACE_HEADER@
@SURFACE_CC@
@POPUP_METHODS@

namespace {

size_t g_checks = 0, g_failures = 0;
void Check(bool ok, const char* msg) {
  ++g_checks;
  if (!ok) {
    ++g_failures;
    if (g_failures <= 16) std::fprintf(stderr, "FAIL dirty-present: %s\n", msg);
  }
}

void PaintRect(uint32_t* pixels, int stride, int l, int t, int r, int b, uint32_t seed) {
  for (int y = t; y < b; ++y) {
    for (int x = l; x < r; ++x) {
      pixels[static_cast<size_t>(y) * stride + x] =
          seed ^ (static_cast<uint32_t>(y) * 0x9e3779b1u + static_cast<uint32_t>(x) * 0x85ebca6bu);
    }
  }
}

#if GESHER_HAS_DIRTY
uint32_t ToBgraOracle(uint32_t p, int format) {
  if (format == HAL_PIXEL_FORMAT_BGRA_8888) return p;
  uint32_t q = (p & 0xff00ff00u) | ((p & 0xffu) << 16) | ((p >> 16) & 0xffu);
  return format == HAL_PIXEL_FORMAT_RGBX_8888 ? (q | 0xff000000u) : q;
}

std::vector<uint32_t> ExpectedWindowBuffer(const std::vector<uint32_t>& buf, int bw, int bh,
                                           int format, int ww, int wh,
                                           int il, int it, int ir, int ib,
                                           const std::vector<uint32_t>& prev) {
  std::vector<uint32_t> out = prev;
  out.resize(static_cast<size_t>(ww) * wh, 0xffffffffu);
  const int rows = static_cast<int>(std::max<int64_t>(0, std::min<int64_t>(wh, int64_t{bh} - it - ib)));
  const int cols = static_cast<int>(std::max<int64_t>(0, std::min<int64_t>(ww, int64_t{bw} - il - ir)));
  for (int y = 0; y < rows; ++y) {
    for (int x = 0; x < cols; ++x) {
      out[static_cast<size_t>(y) * ww + x] =
          ToBgraOracle(buf[static_cast<size_t>(y + it) * bw + il + x], format);
    }
  }
  return out;
}

void RunContractGate() {
  // 1. Normal window: first frame, valid partial CPU locks, canary non-overwrite proof,
  // negative/overflow/invalid edges, formats, resizes.
  {
    auto* win = new gesher::Window(64, 48);
    auto surface = android::sp<gesher::Win32Surface>::make(win);
    ANativeWindow* anw = surface.get();
    std::vector<uint32_t> shadow(64 * 48, 0xff000000u);
    std::vector<uint32_t> back(64 * 48, 0xffffffffu);

    g_metrics = {};
    ANativeWindow_Buffer b = {};
    ARect dirty = {10, 10, 20, 20};
    Check(surface->lock(&b, &dirty) == 0, "first lock succeeds");
    Check(dirty.left == 0 && dirty.top == 0 && dirty.right == 64 && dirty.bottom == 48,
          "first frame forces full dirty bounds");
    PaintRect(static_cast<uint32_t*>(b.bits), b.stride, 0, 0, 64, 48, 0x11223344u);
    PaintRect(shadow.data(), 64, 0, 0, 64, 48, 0x11223344u);
    Check(surface->unlockAndPost() == 0, "first unlockAndPost succeeds");
    Check(g_metrics.invalidate_full == 1 && g_metrics.invalidate_rect == 0,
          "first frame invalidates full window");

    back = ExpectedWindowBuffer(shadow, 64, 48, HAL_PIXEL_FORMAT_RGBA_8888, 64, 48, 0, 0, 0, 0, back);
    std::vector<uint32_t> actual;
    int aw = 0, ah = 0;
    win->ReadBackBuffer(&actual, &aw, &ah);
    Check(actual == back, "first frame pixels match RGBA->BGRA oracle");

    // Plant canary at pixel (0,0) in window back buffer to prove PresentLocked touches ONLY dirty rect!
    auto* win_words = reinterpret_cast<uint32_t*>(win->pixels_.data());
    const uint32_t saved_pixel0 = win_words[0];
    win_words[0] = 0xdeadc0deu;

    dirty = {12, 8, 28, 22};
    Check(surface->lock(&b, &dirty) == 0, "second partial lock succeeds");
    Check(dirty.left == 12 && dirty.top == 8 && dirty.right == 28 && dirty.bottom == 22,
          "preserved buffer keeps partial dirty rect");
    PaintRect(static_cast<uint32_t*>(b.bits), b.stride, 12, 8, 28, 22, 0x55667788u);
    PaintRect(shadow.data(), 64, 12, 8, 28, 22, 0x55667788u);
    g_metrics.invalidate_full = g_metrics.invalidate_rect = 0;
    Check(surface->unlockAndPost() == 0, "second partial unlockAndPost succeeds");
    Check(win_words[0] == 0xdeadc0deu, "partial PresentLocked does NOT touch pixels outside dirty rect");
    win_words[0] = saved_pixel0;
    Check(g_metrics.invalidate_full == 0 && g_metrics.invalidate_rect == 1 &&
              g_metrics.last_invalidated.left == 12 && g_metrics.last_invalidated.top == 8 &&
              g_metrics.last_invalidated.right == 28 && g_metrics.last_invalidated.bottom == 22,
          "partial CPU frame invalidates exact dirty RECT");
    back = ExpectedWindowBuffer(shadow, 64, 48, HAL_PIXEL_FORMAT_RGBA_8888, 64, 48, 0, 0, 0, 0, back);
    win->ReadBackBuffer(&actual, &aw, &ah);
    Check(actual == back, "partial CPU frame matches pixel oracle");

    // Negative / INT_MIN / INT_MAX clipped partial rect.
    dirty = {INT_MIN, -17, 19, 13};
    Check(surface->lock(&b, &dirty) == 0, "negative/INT_MIN partial lock");
    Check(dirty.left == 0 && dirty.top == 0 && dirty.right == 19 && dirty.bottom == 13,
          "negative/INT_MIN dirty rect clips cleanly to top-left");
    PaintRect(static_cast<uint32_t*>(b.bits), b.stride, 0, 0, 19, 13, 0x99aabbccu);
    PaintRect(shadow.data(), 64, 0, 0, 19, 13, 0x99aabbccu);
    g_metrics.invalidate_full = g_metrics.invalidate_rect = 0;
    Check(surface->unlockAndPost() == 0, "clipped top-left unlockAndPost");
    Check(g_metrics.invalidate_rect == 1 && g_metrics.last_invalidated.left == 0 &&
              g_metrics.last_invalidated.top == 0 && g_metrics.last_invalidated.right == 19 &&
              g_metrics.last_invalidated.bottom == 13,
          "clipped top-left dirty rect invalidates clipped region");

    dirty = {50, 35, INT_MAX, INT_MAX};
    Check(surface->lock(&b, &dirty) == 0, "INT_MAX partial lock");
    Check(dirty.left == 50 && dirty.top == 35 && dirty.right == 64 && dirty.bottom == 48,
          "INT_MAX dirty rect clips cleanly to bottom-right");
    PaintRect(static_cast<uint32_t*>(b.bits), b.stride, 50, 35, 64, 48, 0xddeeff11u);
    PaintRect(shadow.data(), 64, 50, 35, 64, 48, 0xddeeff11u);
    g_metrics.invalidate_full = g_metrics.invalidate_rect = 0;
    Check(surface->unlockAndPost() == 0, "clipped bottom-right unlockAndPost");
    Check(g_metrics.invalidate_rect == 1 && g_metrics.last_invalidated.left == 50 &&
              g_metrics.last_invalidated.top == 35 && g_metrics.last_invalidated.right == 64 &&
              g_metrics.last_invalidated.bottom == 48,
          "clipped bottom-right dirty rect invalidates clipped region");
    back = ExpectedWindowBuffer(shadow, 64, 48, HAL_PIXEL_FORMAT_RGBA_8888, 64, 48, 0, 0, 0, 0, back);
    win->ReadBackBuffer(&actual, &aw, &ah);
    Check(actual == back, "clipped edge frames match pixel oracle");

    // Invalid / inverted / disjoint dirty rects fall back to full-frame copy & invalidation.
    for (ARect bad : {ARect{30, 30, 10, 10}, ARect{-20, -20, -5, -5}, ARect{100, 100, 120, 120}}) {
      ARect d = bad;
      Check(surface->lock(&b, &d) == 0, "invalid/disjoint dirty lock");
      Check(d.left == 0 && d.top == 0 && d.right == 0 && d.bottom == 0, "disjoint/inverted returns empty intersection");
      PaintRect(static_cast<uint32_t*>(b.bits), b.stride, 0, 0, 64, 48, 0x33445566u + static_cast<uint32_t>(bad.left));
      PaintRect(shadow.data(), 64, 0, 0, 64, 48, 0x33445566u + static_cast<uint32_t>(bad.left));
      g_metrics.invalidate_full = g_metrics.invalidate_rect = 0;
      Check(surface->unlockAndPost() == 0, "invalid/disjoint fallback unlockAndPost");
      Check(g_metrics.invalidate_full == 1 && g_metrics.invalidate_rect == 0,
            "invalid/disjoint dirty rect falls back to full window invalidation");
      back = ExpectedWindowBuffer(shadow, 64, 48, HAL_PIXEL_FORMAT_RGBA_8888, 64, 48, 0, 0, 0, 0, back);
      win->ReadBackBuffer(&actual, &aw, &ah);
      Check(actual == back, "full fallback preserves every pixel");
    }

    // Format changes (RGBX_8888 and BGRA_8888) force full frame on first post, then partial on second.
    for (int fmt : {HAL_PIXEL_FORMAT_RGBX_8888, HAL_PIXEL_FORMAT_BGRA_8888}) {
      Check(anw->perform(anw, NATIVE_WINDOW_SET_BUFFERS_FORMAT, fmt) == 0, "set format");
      dirty = {4, 4, 12, 12};
      Check(surface->lock(&b, &dirty) == 0, "first lock after format change");
      Check(dirty.left == 0 && dirty.top == 0 && dirty.right == 64 && dirty.bottom == 48,
            "format change invalidates full buffer");
      PaintRect(static_cast<uint32_t*>(b.bits), b.stride, 0, 0, 64, 48, 0x0708090au * static_cast<uint32_t>(fmt));
      shadow.assign(static_cast<uint32_t*>(b.bits), static_cast<uint32_t*>(b.bits) + 64 * 48);
      g_metrics.invalidate_full = g_metrics.invalidate_rect = 0;
      Check(surface->unlockAndPost() == 0, "post full reformatted frame");
      Check(g_metrics.invalidate_full == 1 && g_metrics.invalidate_rect == 0,
            "format change triggers full invalidation");

      dirty = {6, 5, 20, 18};
      Check(surface->lock(&b, &dirty) == 0, "second lock in new format");
      PaintRect(static_cast<uint32_t*>(b.bits), b.stride, 6, 5, 20, 18, 0x22004411u * static_cast<uint32_t>(fmt));
      PaintRect(shadow.data(), 64, 6, 5, 20, 18, 0x22004411u * static_cast<uint32_t>(fmt));
      g_metrics.invalidate_full = g_metrics.invalidate_rect = 0;
      Check(surface->unlockAndPost() == 0, "post partial reformatted frame");
      Check(g_metrics.invalidate_full == 0 && g_metrics.invalidate_rect == 1,
            "second frame in new format uses partial dirty rect");
      back = ExpectedWindowBuffer(shadow, 64, 48, fmt, 64, 48, 0, 0, 0, 0, back);
      win->ReadBackBuffer(&actual, &aw, &ah);
      Check(actual == back, "reformatted partial frame matches pixel oracle (including RGBX alpha=0xff)");
    }

    // Window client resize invalidates full frame even if producer passes partial rect.
    Check(anw->perform(anw, NATIVE_WINDOW_SET_BUFFERS_FORMAT, HAL_PIXEL_FORMAT_RGBA_8888) == 0, "reset RGBA");
    win->ResizeClient(80, 52);
    dirty = {2, 2, 10, 10};
    Check(surface->lock(&b, &dirty) == 0 && b.width == 80 && b.height == 52, "lock after window resize");
    Check(dirty.left == 0 && dirty.top == 0 && dirty.right == 80 && dirty.bottom == 52,
          "window resize forces full dirty rect");
    PaintRect(static_cast<uint32_t*>(b.bits), b.stride, 0, 0, 80, 52, 0xabcdef01u);
    shadow.assign(static_cast<uint32_t*>(b.bits), static_cast<uint32_t*>(b.bits) + 80 * 52);
    g_metrics.invalidate_full = g_metrics.invalidate_rect = 0;
    Check(surface->unlockAndPost() == 0, "post resized window frame");
    Check(g_metrics.invalidate_full == 1 && g_metrics.invalidate_rect == 0,
          "window resize posts full invalidation");
    win->ReadBackBuffer(&back, &aw, &ah);
    back = ExpectedWindowBuffer(shadow, 80, 52, HAL_PIXEL_FORMAT_RGBA_8888, 80, 52, 0, 0, 0, 0, back);
    win->ReadBackBuffer(&actual, &aw, &ah);
    Check(actual == back, "resized window frame matches oracle");
  }

  // 2. NATIVE_WINDOW_SET_SURFACE_DAMAGE (bottom-left coordinates), insets, cancelBuffer, mid-dequeue resize.
  {
    auto* win = new gesher::Window(50, 40);
    auto surface = android::sp<gesher::Win32Surface>::make(win);
    ANativeWindow* anw = surface.get();
    surface->SetSurfaceInsets(4, 6, 4, 6);  // buffer is 58 x 52, visible crop [4..54) x [6..46)

    ANativeWindowBuffer* nb = nullptr;
    int fence = -1;
    Check(anw->dequeueBuffer(anw, &nb, &fence) == 0 && nb->width == 58 && nb->height == 52,
          "dequeue inset buffer");
    auto* pixels = static_cast<uint32_t*>(nb->reserved[0]);
    PaintRect(pixels, nb->stride, 0, 0, 58, 52, 0x10203040u);
    ARect bl_first = {10, 30, 20, 20};
    Check(anw->perform(anw, NATIVE_WINDOW_SET_SURFACE_DAMAGE, &bl_first, size_t{1}) == 0,
          "damage before first frame accepted");
    g_metrics.invalidate_full = g_metrics.invalidate_rect = 0;
    Check(anw->queueBuffer(anw, nb, -1) == 0, "queue first inset buffer");
    Check(g_metrics.invalidate_full == 1 && g_metrics.invalidate_rect == 0,
          "first queueBuffer ignores partial damage and posts full frame");

    std::vector<uint32_t> shadow(pixels, pixels + 58 * 52);
    std::vector<uint32_t> back(50 * 40, 0xffffffffu);
    back = ExpectedWindowBuffer(shadow, 58, 52, HAL_PIXEL_FORMAT_RGBA_8888, 50, 40, 4, 6, 4, 6, back);
    std::vector<uint32_t> actual;
    int aw = 0, ah = 0;
    win->ReadBackBuffer(&actual, &aw, &ah);
    Check(actual == back, "first queued inset buffer matches oracle");

    // Second frame: multi-rect bottom-left surface damage + empty rect ignored.
    Check(anw->dequeueBuffer(anw, &nb, &fence) == 0, "dequeue second inset buffer");
    pixels = static_cast<uint32_t*>(nb->reserved[0]);
    PaintRect(pixels, nb->stride, 8, 10, 24, 22, 0x778899aau);
    PaintRect(shadow.data(), 58, 8, 10, 24, 22, 0x778899aau);
    const ARect rects[3] = {
        {8, 42, 16, 36},   // tl: x=[8,16), y=[10,16)
        {12, 20, 12, 20},  // empty rect: ignored
        {14, 36, 24, 30},  // tl: x=[14,24), y=[16,22)
    };
    Check(anw->perform(anw, NATIVE_WINDOW_SET_SURFACE_DAMAGE, rects, size_t{3}) == 0,
          "multi-rect bottom-left damage accepted");
    g_metrics.invalidate_full = g_metrics.invalidate_rect = 0;
    Check(anw->queueBuffer(anw, nb, -1) == 0, "queue partial inset buffer");
    Check(g_metrics.invalidate_full == 0 && g_metrics.invalidate_rect == 1 &&
              g_metrics.last_invalidated.left == 4 && g_metrics.last_invalidated.top == 4 &&
              g_metrics.last_invalidated.right == 20 && g_metrics.last_invalidated.bottom == 16,
          "bottom-left multi-rect damage flips Y and translates by surface insets");
    back = ExpectedWindowBuffer(shadow, 58, 52, HAL_PIXEL_FORMAT_RGBA_8888, 50, 40, 4, 6, 4, 6, back);
    win->ReadBackBuffer(&actual, &aw, &ah);
    Check(actual == back, "queued partial inset buffer matches oracle");

    // Extreme INT_MIN / INT_MAX bottom-left coordinates (UBSan signed-overflow check).
    Check(anw->dequeueBuffer(anw, &nb, &fence) == 0, "dequeue extreme damage buffer");
    pixels = static_cast<uint32_t*>(nb->reserved[0]);
    PaintRect(pixels, nb->stride, 0, 0, 14, 16, 0x55aa33ccu);
    PaintRect(shadow.data(), 58, 0, 0, 14, 16, 0x55aa33ccu);
    const ARect extreme_bl = {INT_MIN, INT_MAX, 14, 52 - 16};
    Check(anw->perform(anw, NATIVE_WINDOW_SET_SURFACE_DAMAGE, &extreme_bl, size_t{1}) == 0,
          "INT_MIN/INT_MAX bottom-left damage accepted without overflow");
    g_metrics.invalidate_full = g_metrics.invalidate_rect = 0;
    Check(anw->queueBuffer(anw, nb, -1) == 0, "queue INT_MIN/INT_MAX clipped damage");
    Check(g_metrics.invalidate_rect == 1 && g_metrics.last_invalidated.left == 0 &&
              g_metrics.last_invalidated.top == 0 && g_metrics.last_invalidated.right == 10 &&
              g_metrics.last_invalidated.bottom == 10,
          "extreme bottom-left damage clips safely against buffer and insets");
    back = ExpectedWindowBuffer(shadow, 58, 52, HAL_PIXEL_FORMAT_RGBA_8888, 50, 40, 4, 6, 4, 6, back);
    win->ReadBackBuffer(&actual, &aw, &ah);
    Check(actual == back, "extreme clipped damage matches oracle");

    // cancelBuffer after modifying dequeued buffer must invalidate preserved state for next frame.
    Check(anw->dequeueBuffer(anw, &nb, &fence) == 0, "dequeue before cancel");
    pixels = static_cast<uint32_t*>(nb->reserved[0]);
    PaintRect(pixels, nb->stride, 0, 0, 58, 52, 0xdeadbeefu);
    shadow.assign(pixels, pixels + 58 * 52);
    Check(anw->cancelBuffer(anw, nb, -1) == 0, "cancel modified buffer");
    Check(anw->dequeueBuffer(anw, &nb, &fence) == 0, "dequeue after cancel");
    pixels = static_cast<uint32_t*>(nb->reserved[0]);
    PaintRect(pixels, nb->stride, 20, 20, 30, 30, 0x01020304u);
    PaintRect(shadow.data(), 58, 20, 20, 30, 30, 0x01020304u);
    const ARect small_bl = {20, 52 - 20, 30, 52 - 30};
    Check(anw->perform(anw, NATIVE_WINDOW_SET_SURFACE_DAMAGE, &small_bl, size_t{1}) == 0,
          "set partial damage after cancel");
    g_metrics.invalidate_full = g_metrics.invalidate_rect = 0;
    Check(anw->queueBuffer(anw, nb, -1) == 0, "queue after cancel");
    Check(g_metrics.invalidate_full == 1 && g_metrics.invalidate_rect == 0,
          "cancelBuffer forces full-frame fallback on subsequent queueBuffer");
    back = ExpectedWindowBuffer(shadow, 58, 52, HAL_PIXEL_FORMAT_RGBA_8888, 50, 40, 4, 6, 4, 6, back);
    win->ReadBackBuffer(&actual, &aw, &ah);
    Check(actual == back, "post-cancel frame has no stale unposted artifacts");
  }

  // 3. Layered translucent window: partial CopyRect, canary non-overwrite proof, coalescing,
  // PresentPixels/SetDim/WM_DISPLAYCHANGE/resize fallbacks.
  {
    g_metrics = {};
    {
      auto* win = new gesher::Window(60, 40);
      win->SetTranslucentHost(true);
      auto surface = android::sp<gesher::Win32Surface>::make(win);
      std::vector<uint32_t> shadow(60 * 40, 0xff000000u);
      std::vector<uint32_t> back(60 * 40, 0xffffffffu);

      // Frame 1: full layered upload.
      ANativeWindow_Buffer b = {};
      ARect dirty = {5, 5, 15, 15};
      Check(surface->lock(&b, &dirty) == 0, "layered first lock");
      PaintRect(static_cast<uint32_t*>(b.bits), b.stride, 0, 0, 60, 40, 0x80112233u);
      shadow.assign(static_cast<uint32_t*>(b.bits), static_cast<uint32_t*>(b.bits) + 60 * 40);
      Check(surface->unlockAndPost() == 0, "layered first post");
      win->PresentLayered();
      back = ExpectedWindowBuffer(shadow, 60, 40, HAL_PIXEL_FORMAT_RGBA_8888, 60, 40, 0, 0, 0, 0, back);
      Check(win->RawLayeredBytes() != nullptr &&
                std::memcmp(win->RawLayeredBytes(), back.data(), back.size() * 4) == 0,
            "layered first frame DIB matches oracle");

      // Plant canary at DIB pixel (0,0) outside unioned dirty region (10,6)-(35,28) to prove CopyRect leaves it untouched!
      auto* dib_words = reinterpret_cast<uint32_t*>(win->RawLayeredBytes());
      const uint32_t saved_dib0 = dib_words[0];
      dib_words[0] = 0xfeedfaceu;
      auto* bmp = static_cast<FakeBitmap*>(win->layered_bitmap_->dc()->selected);
      std::memcpy(bmp->shadow.data(), dib_words, 4);

      g_metrics.dib_bytes_mutated = 0;
      const size_t dib_before = g_metrics.dib_created;
      dirty = {10, 6, 20, 16};
      Check(surface->lock(&b, &dirty) == 0, "layered coalesced partial 1");
      PaintRect(static_cast<uint32_t*>(b.bits), b.stride, 10, 6, 20, 16, 0xa0445566u);
      PaintRect(shadow.data(), 60, 10, 6, 20, 16, 0xa0445566u);
      Check(surface->unlockAndPost() == 0, "post coalesced partial 1");

      dirty = {25, 18, 35, 28};
      Check(surface->lock(&b, &dirty) == 0, "layered coalesced partial 2");
      PaintRect(static_cast<uint32_t*>(b.bits), b.stride, 25, 18, 35, 28, 0xc0778899u);
      PaintRect(shadow.data(), 60, 25, 18, 35, 28, 0xc0778899u);
      Check(surface->unlockAndPost() == 0, "post coalesced partial 2");

      win->PresentLayered();
      Check(dib_words[0] == 0xfeedfaceu, "LayeredBitmap::CopyRect does NOT touch DIB pixels outside dirty union");
      dib_words[0] = saved_dib0;
      std::memcpy(bmp->shadow.data(), &saved_dib0, 4);

      back = ExpectedWindowBuffer(shadow, 60, 40, HAL_PIXEL_FORMAT_RGBA_8888, 60, 40, 0, 0, 0, 0, back);
      Check(g_metrics.dib_created == dib_before &&
                std::memcmp(win->RawLayeredBytes(), back.data(), back.size() * 4) == 0,
            "coalesced partial layered updates reuse DIB and match pixel oracle");
      Check(g_metrics.dib_bytes_mutated > 0 && g_metrics.dib_bytes_mutated <= 25u * 22u * 4u,
            "layered CopyRect updates only unioned dirty region");

      // Intervening Window::PresentPixels coalesced with a partial update must force full DIB copy
      // AND reset Win32Surface's same_window_frames check on the following software frame.
      std::vector<uint32_t> ext_frame(60 * 40, 0xe0335577u);
      win->PresentPixels(ext_frame.data(), 60, 40);
      dirty = {2, 2, 8, 8};
      Check(surface->lock(&b, &dirty) == 0, "lock after external PresentPixels");
      PaintRect(static_cast<uint32_t*>(b.bits), b.stride, 2, 2, 8, 8, 0xf0998877u);
      PaintRect(shadow.data(), 60, 2, 2, 8, 8, 0xf0998877u);
      Check(surface->unlockAndPost() == 0, "unlock after external PresentPixels");
      win->PresentLayered();
      back = ExpectedWindowBuffer(shadow, 60, 40, HAL_PIXEL_FORMAT_RGBA_8888, 60, 40, 0, 0, 0, 0, back);
      Check(std::memcmp(win->RawLayeredBytes(), back.data(), back.size() * 4) == 0,
            "intervening PresentPixels triggers full PresentLocked and full LayeredBitmap copy");

      // SetDim + translucency toggle + WM_DISPLAYCHANGE preserve pixel exactness.
      win->SetDimHost(128);
      win->SetTranslucentHost(false);
      win->PresentLayered();
      win->SetTranslucentHost(true);
      win->PresentLayered();
      win->SetDimHost(0);
      win->OnDisplayChangeHost();
      dirty = {4, 4, 10, 10};
      Check(surface->lock(&b, &dirty) == 0, "lock after display change");
      PaintRect(static_cast<uint32_t*>(b.bits), b.stride, 4, 4, 10, 10, 0xff123456u);
      PaintRect(shadow.data(), 60, 4, 4, 10, 10, 0xff123456u);
      Check(surface->unlockAndPost() == 0, "post after display change");
      win->PresentLayered();
      back = ExpectedWindowBuffer(shadow, 60, 40, HAL_PIXEL_FORMAT_RGBA_8888, 60, 40, 0, 0, 0, 0, back);
      Check(std::memcmp(win->RawLayeredBytes(), back.data(), back.size() * 4) == 0,
            "WM_DISPLAYCHANGE recreates DIB and falls back to full upload without stale pixels");

      // Direct LayeredBitmap::CopyRect & RecordLayeredPartial edge cases.
      gesher::LayeredBitmap direct;
      Check(!direct.CopyRect(nullptr, 10, 10, 0, 0, 5, 5) &&
                !direct.CopyRect(reinterpret_cast<const uint8_t*>(back.data()), 0, 10, 0, 0, 5, 5) &&
                !direct.CopyRect(reinterpret_cast<const uint8_t*>(back.data()), 10, -2, 0, 0, 5, 5),
            "CopyRect rejects null or non-positive dimensions");
      Check(direct.CopyRect(reinterpret_cast<const uint8_t*>(back.data()), 60, 40, -5, -5, 10, 10),
            "CopyRect on uninitialized cache or negative coords falls back to full Copy");
      gesher::RecordLayeredPartial(&direct, 60, 40, 5, 5, 10, 10);
      gesher::RecordLayeredPartial(&direct, 60, 40, 20, 20, 10, 10);  // invalid rect escalates to full
      int out_dirty[4] = {};
      Check(!gesher::TakeLayeredDirty(&direct, 60, 40, out_dirty),
            "invalid rect in RecordLayeredPartial escalates pending update to full");
      gesher::EraseLayeredDirty(&direct);
    }
    Check(g_metrics.dc_created == g_metrics.dc_deleted &&
              g_metrics.dib_created == g_metrics.dib_deleted,
          "all layered GDI DCs and DIBs released on teardown");
  }
}
#endif

struct BenchCase {
  const char* label;
  bool layered;
  bool full_frame;
  int rect_w;
  int rect_h;
};

void RunBenchmark() {
  g_measure_mode = true;
  constexpr int kWidth = 1920, kHeight = 1080, kWarmup = 30, kFrames = 400;
  const BenchCase cases[] = {
      {"normal_full_1920x1080", false, true, kWidth, kHeight},
      {"normal_dirty_160x90", false, false, 160, 90},
      {"normal_dirty_64x64", false, false, 64, 64},
      {"layered_full_1920x1080", true, true, kWidth, kHeight},
      {"layered_dirty_160x90", true, false, 160, 90},
      {"layered_dirty_64x64", true, false, 64, 64},
  };

  for (const BenchCase& c : cases) {
    auto* win = new gesher::Window(kWidth, kHeight);
    if (c.layered) win->SetTranslucentHost(true);
    auto surface = android::sp<gesher::Win32Surface>::make(win);

    ANativeWindow_Buffer b = {};
    Check(surface->lock(&b, nullptr) == 0, "bench initial lock");
    PaintRect(static_cast<uint32_t*>(b.bits), b.stride, 0, 0, kWidth, kHeight, 0xff102030u);
    Check(surface->unlockAndPost() == 0, "bench initial post");
    if (c.layered) win->PresentLayered();

    auto step = [&](int i) {
      const int x0 = c.full_frame ? 0 : ((i * 37) % (kWidth - c.rect_w));
      const int y0 = c.full_frame ? 0 : ((i * 23) % (kHeight - c.rect_h));
      ARect d = {x0, y0, x0 + c.rect_w, y0 + c.rect_h};
      ANativeWindow_Buffer buf = {};
      surface->lock(&buf, c.full_frame ? nullptr : &d);
      auto* row = static_cast<uint32_t*>(buf.bits) + static_cast<size_t>(y0) * buf.stride + x0;
      row[0] = 0xff000000u | static_cast<uint32_t>(i + 1);
      row[c.rect_w - 1] = 0xff800000u | static_cast<uint32_t>(i + 1);
      surface->unlockAndPost();
      if (c.layered) win->PresentLayered();
    };

    for (int i = 0; i < kWarmup; ++i) step(i);
    g_metrics = {};
    const auto t0 = std::chrono::steady_clock::now();
    for (int i = 0; i < kFrames; ++i) step(kWarmup + i);
    const double total_ms =
        std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();

    const size_t full_bytes = static_cast<size_t>(kWidth) * kHeight * 4;
    const size_t rect_bytes = static_cast<size_t>(c.rect_w) * c.rect_h * 4;
    const bool used_partial = !c.full_frame && (GESHER_HAS_DIRTY != 0);
    const size_t surface_bytes_per_frame = used_partial ? rect_bytes : full_bytes;
    const size_t layered_bytes_per_frame = c.layered ? (used_partial ? rect_bytes : full_bytes) : 0;
    const size_t total_copy_bytes_per_frame = surface_bytes_per_frame + layered_bytes_per_frame;

    std::printf("BENCH %s frames=%d total_ms=%.3f us_per_frame=%.2f copy_bytes_per_frame=%zu "
                "total_copy_mb=%.2f inv_full=%zu inv_rect=%zu\n",
                c.label, kFrames, total_ms, (total_ms * 1000.0) / kFrames,
                total_copy_bytes_per_frame,
                (static_cast<double>(total_copy_bytes_per_frame) * kFrames) / (1024.0 * 1024.0),
                g_metrics.invalidate_full, g_metrics.invalidate_rect);
    std::fflush(stdout);
  }
}

}  // namespace

int main(int argc, char** argv) {
  const bool measure = argc >= 2 && std::strcmp(argv[1], "measure") == 0;
  if (measure) {
    RunBenchmark();
    return g_failures != 0;
  }
#if GESHER_HAS_DIRTY
  RunContractGate();
#endif
  std::printf("surface dirty-present contracts: %zu checks, %zu failures\n", g_checks, g_failures);
  return g_failures != 0;
}
