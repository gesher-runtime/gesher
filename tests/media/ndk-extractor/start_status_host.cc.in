// Actual AospTrackReader, Select, Current and GetSampleFormat bodies, with
// explicit buffer-group, format storage, error translation and plugin seams.
#include <media/NdkMediaFormat.h>
#include <algorithm>
#include <cstdlib>
#include <cstdio>
#include <cstring>
#include <map>
#include <memory>
#include <mutex>
#include <string>
#include <variant>
#include <vector>
#include "@EXTRACTOR_HEADER@"

struct AMediaFormat {
  using Value=std::variant<int32_t,int64_t,float,std::string,std::vector<uint8_t>>;
  std::map<std::string,Value> values;
};
AMediaFormat* AMediaFormat_new() { return new AMediaFormat; }
media_status_t AMediaFormat_delete(AMediaFormat* f) { delete f; return 0; }
void AMediaFormat_clear(AMediaFormat* f) { f->values.clear(); }
media_status_t AMediaFormat_copy(AMediaFormat* to,const AMediaFormat* from) {
  to->values=from->values; return 0;
}
void AMediaFormat_setInt32(AMediaFormat* f,const char* k,int32_t v) { f->values[k]=v; }
void AMediaFormat_setInt64(AMediaFormat* f,const char* k,int64_t v) { f->values[k]=v; }
void AMediaFormat_setString(AMediaFormat* f,const char* k,const char* v) { f->values[k]=std::string(v); }
void AMediaFormat_setBuffer(AMediaFormat* f,const char* k,const void* v,size_t n) {
  auto p=static_cast<const uint8_t*>(v);
  f->values[k]=n?std::vector<uint8_t>(p,p+n):std::vector<uint8_t>{};
}
template<class T> bool Value(AMediaFormat* f,const char* k,T* out) {
  auto i=f->values.find(k); if(i==f->values.end())return false;
  auto v=std::get_if<T>(&i->second); if(!v)return false; *out=*v; return true;
}
bool AMediaFormat_getInt32(AMediaFormat* f,const char* k,int32_t* v) { return Value(f,k,v); }
bool AMediaFormat_getInt64(AMediaFormat* f,const char* k,int64_t* v) { return Value(f,k,v); }
// These startup fixtures do not publish rectangle metadata.
bool AMediaFormat_getRect(AMediaFormat*,const char*,int32_t*,int32_t*,int32_t*,int32_t*) { return false; }
bool AMediaFormat_getFloat(AMediaFormat* f,const char* k,float* v) { return Value(f,k,v); }
bool AMediaFormat_getString(AMediaFormat* f,const char* k,const char** out) {
  auto i=f->values.find(k);if(i==f->values.end())return false;
  auto v=std::get_if<std::string>(&i->second);if(!v)return false;*out=v->c_str();return true;
}
bool AMediaFormat_getBuffer(AMediaFormat* f,const char* k,void** out,size_t* n) {
  auto i=f->values.find(k);if(i==f->values.end())return false;
  auto v=std::get_if<std::vector<uint8_t>>(&i->second);if(!v)return false;
  *out=v->data();*n=v->size();return true;
}
const char* AMediaFormat_toString(AMediaFormat*) { return "observed-format-seam"; }


namespace android {
struct CMediaBuffer {
  void* handle;
  void (*release)(void*);
  void* (*data)(void*);
  size_t (*range_offset)(void*);
  size_t (*range_length)(void*);
  AMediaFormat* (*meta_data)(void*);
};
struct CMediaBufferGroup {};
class MediaBufferGroup {
 public: CMediaBufferGroup* wrap() { return &group_; }
 private: CMediaBufferGroup group_;
};
struct CMediaTrack {
  void* data;
  void (*free)(void*);
  media_status_t (*start)(void*, CMediaBufferGroup*);
  media_status_t (*stop)(void*);
  media_status_t (*read)(void*, CMediaBuffer**, uint32_t, int64_t);
};
enum CMediaTrackReadOptions : uint32_t { SEEK = 8, SEEK_FRAME_INDEX = 4 };
}

// The actual AOSP translators are executed in the independent full-adapter QA.
// These narrow host seams preserve only statuses used below, with the same
// native values; exact app-visible expected values remain literal assertions.
static int reverse_translate_error(media_status_t value) {
  if (value == AMEDIA_OK) return 0;
  if (value == AMEDIA_ERROR_IO) return -1004;
  if (value == AMEDIA_ERROR_MALFORMED) return -1007;
  return INT32_MIN;
}
static media_status_t translate_error(int value) {
  if (value == 0) return AMEDIA_OK;
  if (value == -1004) return AMEDIA_ERROR_IO;
  if (value == -1007) return AMEDIA_ERROR_MALFORMED;
  return AMEDIA_ERROR_UNKNOWN;
}

namespace gesher::media {
@FORMAT_METHODS@
using android::CMediaTrack;
using android::CMediaBuffer;
@TRACK_READER@
}

// Only the extractor state touched by the extracted methods is needed.
struct AMediaExtractor {
  struct Track {
    size_t index;
    std::unique_ptr<gesher::media::TrackReader> reader;
    std::string mime;
    gesher::media::Sample sample;
    bool pending = false;
    int result = AMEDIA_OK;
  };
  std::mutex mutex;
  std::unique_ptr<gesher::media::Extractor> extractor;
  std::vector<Track> selected;
  @CURRENT@
};
namespace gesher::media {
@SELECT@
@GET_SAMPLE_FORMAT@
}

struct StartFixture {
  media_status_t status = AMEDIA_OK;
  media_status_t read_status = AMEDIA_ERROR_END_OF_STREAM;
  int starts = 0, stops = 0, frees = 0, reads = 0;
  bool group_supplied = false;
};
class FixtureExtractor final : public gesher::media::Extractor {
 public:
  explicit FixtureExtractor(StartFixture& state) : state_(state) {}
  std::string Name() const override { return "start-operation-observer"; }
  size_t TrackCount() override { return 1; }
  gesher::media::Format TrackFormat(size_t) override {
    gesher::media::Format f;
    AMediaFormat_setString(f.get(), "mime", "audio/raw");
    return f;
  }
  gesher::media::Format FileFormat() override { return gesher::media::Format(); }
  std::unique_ptr<gesher::media::TrackReader> OpenTrack(size_t) override {
    auto* track = static_cast<android::CMediaTrack*>(std::calloc(1, sizeof(android::CMediaTrack)));
    if (track == nullptr) return nullptr;
    track->data = &state_;
    track->start = [](void* p, android::CMediaBufferGroup* group) {
      auto& state = *static_cast<StartFixture*>(p);
      ++state.starts;
      state.group_supplied = group != nullptr;
      return state.status;
    };
    track->stop = [](void* p) { ++static_cast<StartFixture*>(p)->stops; return AMEDIA_OK; };
    track->free = [](void* p) { ++static_cast<StartFixture*>(p)->frees; };
    track->read = [](void* p, android::CMediaBuffer**, uint32_t, int64_t) {
      auto& state = *static_cast<StartFixture*>(p);
      ++state.reads;
      return state.read_status;
    };
    return std::make_unique<gesher::media::AospTrackReader>(track);
  }
 private: StartFixture& state_;
};

static int checks, failures;
static void Check(const char* name, bool ok) {
  ++checks;
  if (!ok) ++failures;
  std::printf("%s %s\n", ok ? "PASS" : "FAIL", name);
}
int main() {
  StartFixture state;
  AMediaExtractor ex;
  ex.extractor = std::make_unique<FixtureExtractor>(state);
  state.status = AMEDIA_ERROR_IO;
  Check("I/O start failure is reported immediately", gesher::media::Select(&ex, 0) == -10007);
  Check("failed selection retains no reader", ex.selected.empty());
  Check("failed reader is freed without stop or read", state.starts == 1 && state.frees == 1 &&
        state.stops == 0 && state.reads == 0 && state.group_supplied);
  state.status = AMEDIA_ERROR_UNSUPPORTED;
  Check("unlisted start failure uses Android's unknown status", gesher::media::Select(&ex, 0) == -10000);
  Check("second failed reader is freed", ex.selected.empty() && state.frees == 2 && state.stops == 0);
  state.status = AMEDIA_OK;
  Check("selection can retry after a backend recovers", gesher::media::Select(&ex, 0) == 0);
  Check("successful reader is retained", ex.selected.size() == 1 && state.starts == 3 && state.frees == 2);
  Check("selecting an already selected track does not restart it", gesher::media::Select(&ex, 0) == 0 && state.starts == 3);
  ex.selected.clear();
  Check("successful reader stops and frees exactly once", state.stops == 1 && state.frees == 3 && state.reads == 0);
  gesher::media::Format sample_format;
  for (const auto& [backend, expected] :
       {std::pair{AMEDIA_ERROR_IO, -10007}, std::pair{AMEDIA_ERROR_MALFORMED, -10001},
        std::pair{AMEDIA_ERROR_UNSUPPORTED, -10000}, std::pair{AMEDIA_ERROR_END_OF_STREAM, -10006}}) {
    state.read_status = backend;
    Check("track can start before any sample error", gesher::media::Select(&ex, 0) == AMEDIA_OK);
    AMediaFormat_setInt32(sample_format.get(), "sentinel", 42);
    int32_t sentinel = 0;
    Check("sample format reports Android-mapped backend status",
          gesher::media::GetSampleFormat(&ex, sample_format.get()) == expected);
    Check("failed sample query leaves its destination format intact",
          sample_format.GetInt32("sentinel", &sentinel) && sentinel == 42);
    ex.selected.clear();
  }
  std::printf("Extractor start contracts: checks=%d failures=%d\n", checks, failures);
  return failures ? 1 : 0;
}
