// Host boundaries for whole SoundPool and MediaRecorder JNI production units.
// Decoding, tracks, recorder codecs, boot registration and Surface are observers;
// receiver ownership, Pool state, global refs and JNI entrypoints are real.
#pragma once
#include <jni.h>
#include <fcntl.h>
#include <unistd.h>
#include <algorithm>
#include <atomic>
#include <chrono>
#include <condition_variable>
#include <cstdio>
#include <cstdlib>
#include <deque>
#include <functional>
#include <map>
#include <memory>
#include <mutex>
#include <string>
#include <thread>
#include <vector>
#include "compat/media/jni/receiver_lease.h"
#define MEDIA_LOGE(...) ((void)0)
#define MEDIA_LOGW(...) ((void)0)
#define GESHER_NATIVE(fn) reinterpret_cast<void*>(&(fn))

namespace gesher::media {
inline JavaVM* host_vm;
inline JNIEnv* AttachedEnv(const char*) {
  struct Attachment {
    JNIEnv* env = nullptr;
    bool owned = false;
    Attachment() {
      if (host_vm->GetEnv(reinterpret_cast<void**>(&env), JNI_VERSION_1_6) != JNI_OK)
        owned = host_vm->AttachCurrentThreadAsDaemon(reinterpret_cast<void**>(&env), nullptr) == JNI_OK;
    }
    ~Attachment() { if (owned) host_vm->DetachCurrentThread(); }
  };
  thread_local Attachment attachment;
  return attachment.env;
}
inline void jniThrow(JNIEnv* env, const char* name, const char* message) {
  jclass cls = env->FindClass(name);
  if (cls != nullptr) { env->ThrowNew(cls, message); env->DeleteLocalRef(cls); }
}
inline bool CheckException(JNIEnv* env, const char*) {
  if (!env->ExceptionCheck()) return false;
  env->ExceptionClear(); return true;
}
inline std::string Utf8(JNIEnv* env, jstring value) {
  const char* chars = env->GetStringUTFChars(value, nullptr);
  if (chars == nullptr) return {};
  std::string result(chars); env->ReleaseStringUTFChars(value, chars); return result;
}
inline bool RegisterStandins(JNIEnv*, const char*) { return true; }
template <size_t N>
int RegisterMethods(JNIEnv* env, const char* name, const JNINativeMethod (&methods)[N]) {
  jclass cls = env->FindClass(name);
  if (cls == nullptr) return 0;
  int result = env->RegisterNatives(cls, methods, N);
  env->DeleteLocalRef(cls); return result == JNI_OK ? N : 0;
}
inline void EnsureAppName(JNIEnv*) {}
inline int LegacyStreamType(JNIEnv*, jobject) { return 3; }
inline bool MayRecordAudio(JNIEnv*) { return true; }
@GLOBAL_REFS@

struct Gate {
  std::mutex mutex;
  std::condition_variable changed;
  bool armed = false, entered = false, open = false;
  void Arm() { std::lock_guard<std::mutex> lock(mutex); armed = true; entered = open = false; }
  void Pass() {
    std::unique_lock<std::mutex> lock(mutex);
    if (!armed) return;
    entered = true; changed.notify_all();
    if (!changed.wait_for(lock, std::chrono::seconds(10), [this] { return open; })) std::_Exit(92);
    armed = false;
  }
  bool Await() {
    std::unique_lock<std::mutex> lock(mutex);
    return changed.wait_for(lock, std::chrono::seconds(5), [this] { return entered; });
  }
  void Open() { std::lock_guard<std::mutex> lock(mutex); open = true; changed.notify_all(); }
};
inline Gate source_gate, recorder_gate;
inline std::atomic<int> track_releases{0}, recorder_deletes{0}, resets{0}, surfaces{0};
inline std::atomic<int> recorder_event_mode{0};
inline std::atomic<float> last_left{0}, last_right{0};
enum class PcmFormat { kS16 };
inline size_t BytesPerSample(PcmFormat) { return 2; }
struct PcmInfo { uint32_t rate = 8000, channels = 1; PcmFormat format = PcmFormat::kS16; };
struct TrackParams {
  uint32_t sample_rate = 0, channels = 0;
  PcmFormat format = PcmFormat::kS16;
  int stream_type = 3; bool is_static = false; size_t capacity_frames = 0; std::string name;
};
struct TrackEvents { std::function<void()> end; };
struct Track {
  TrackParams p;
  explicit Track(TrackParams value) : p(std::move(value)) {}
  void Release() { ++track_releases; }
  void Write(const void*, size_t, bool) {}
  void SetEvents(TrackEvents) {}
  void SetLoop(uint32_t, uint32_t, int) {}
  void SetSampleRate(uint32_t) {}
  void SetVolume(float left, float right) { last_left = left; last_right = right; }
  void Start() {}
  void Pause() {}
  size_t static_frames() const { return p.capacity_frames; }
  const TrackParams& params() const { return p; }
};
inline std::shared_ptr<Track> CreateTrack(TrackParams p, std::string*) { return std::make_shared<Track>(p); }
struct DataSource {};
inline std::unique_ptr<DataSource> OpenFdSource(int, int64_t, int64_t, std::string*) {
  source_gate.Pass(); return std::make_unique<DataSource>();
}
inline bool DecodeFile(std::shared_ptr<DataSource>, size_t, std::vector<uint8_t>* pcm,
                       PcmInfo* info, std::string*) {
  *info = PcmInfo(); pcm->assign(16, 0); return true;
}
inline void PostEvent(std::function<void()> event) { std::thread(std::move(event)).detach(); }
constexpr int kInputDeviceId = 3;
@RECORDER_CONFIG@
struct InputSurface {
  jobject NewJavaSurface(JNIEnv* env) {
    ++surfaces;
    jclass cls = env->FindClass("java/lang/Object");
    jmethodID ctor = env->GetMethodID(cls, "<init>", "()V");
    jobject object = env->NewObject(cls, ctor);
    env->DeleteLocalRef(cls); return object;
  }
};
struct Recorder {
  using Listener = std::function<void(int, int)>;
  Listener listener;
  RecorderConfig settings;
  InputSurface surface;
  explicit Recorder(Listener value) : listener(std::move(value)) {}
  ~Recorder() { ++recorder_deletes; }
  RecorderConfig& config() { return settings; }
  bool CanConfigure() const { return true; }
  bool IsIdle() const { return true; }
  // These are operation observers for receiver ownership only. State/error
  // semantics are tested against the real Recorder in its separate gate.
  bool CanSetSource(bool) const { return true; }
  bool CanSetOutputFormat() const { return true; }
  bool IsConfigured() const { return true; }
  bool CanSetEncoder(bool) const { return true; }
  bool HasStarted() const { return true; }
  bool HasAudioInput() { return true; }
  bool InError() const { return false; }
  void EnterError() {}
  InputSurface* input_surface() { return &surface; }
  bool Prepare(std::string*, bool* = nullptr) { recorder_gate.Pass(); return true; }
  bool Start(std::string*, bool* = nullptr) {
    if (recorder_event_mode.load() != 0) listener(2, recorder_event_mode.load());
    return true;
  }
  bool Stop(std::string*, bool* = nullptr) { return true; }
  void Reset() { ++resets; }
  bool Pause(std::string* = nullptr, bool* = nullptr) { return true; }
  bool Resume(std::string* = nullptr, bool* = nullptr) { return true; }
  int MaxAmplitude() { return 0; }
};
}  // namespace gesher::media
