using gesher::media::VideoFrame;

thread_local bool count_allocations = false;
thread_local uint64_t native_allocated_bytes = 0, java_array_bytes = 0, java_copy_bytes = 0;
thread_local std::function<void(size_t)> allocation_hook;
[[gnu::noinline]] void* operator new(size_t size) {
  if (count_allocations) native_allocated_bytes += size;
  if (allocation_hook) allocation_hook(size);
  if (void* p = std::malloc(size ? size : 1)) return p;
  std::abort();
}
[[gnu::noinline]] void* operator new[](size_t size) { return ::operator new(size); }
[[gnu::noinline]] void operator delete(void* p) noexcept { std::free(p); }
[[gnu::noinline]] void operator delete[](void* p) noexcept { std::free(p); }
[[gnu::noinline]] void operator delete(void* p, size_t) noexcept { std::free(p); }
[[gnu::noinline]] void operator delete[](void* p, size_t) noexcept { std::free(p); }
struct Uncounted {
  bool old = count_allocations;
  Uncounted() { count_allocations = false; }
  ~Uncounted() { count_allocations = old; }
};
int checks = 0, failures = 0;
bool baseline = false;
void Check(bool ok, const char* reason) {
  ++checks;
  if (!ok) { ++failures; if (failures < 16) std::fprintf(stderr, "FAIL reader delivery: %s\n", reason); }
}
using jint = int32_t;
using jlong = int64_t;
using jsize = int32_t;
using jbyte = int8_t;
using jclass = void*;
using jmethodID = void*;
struct Object { jlong values[8]{}; };
using jobject = Object*;
struct Array { std::vector<jbyte> bytes; };
using jbyteArray = Array*;
constexpr int JNI_ABORT = 2;
struct JNIEnv {
  bool exception = false, fail_event = false;
  int local_refs = 0, events = 0, pins = 0, releases = 0;
  std::unique_ptr<Array> array;
  std::function<void()> event_hook;
  bool IsSameObject(jobject left, jobject right) { return left == right; }
  jobject NewLocalRef(jobject value) { if (value) ++local_refs; return value; }
  void DeleteLocalRef(jobject value) { if (value) --local_refs; }
  void DeleteGlobalRef(jobject) {}
  jlong GetLongField(jobject object, int field) { return object->values[field]; }
  void SetLongField(jobject object, int field, jlong value) { object->values[field] = value; }
  void SetIntField(jobject object, int field, jint value) { object->values[field] = value; }
  void CallStaticVoidMethod(int, int, jobject) {
    ++events;
    if (event_hook) event_hook();
    if (fail_event) exception = true;
  }
  int PushLocalFrame(int) { return 0; }
  jobject PopLocalFrame(jobject result) { array.reset(); return result; }
  jmethodID GetStaticMethodID(jclass, const char*, const char*) { return reinterpret_cast<void*>(1); }
  void ExceptionClear() { exception = false; }
  bool ExceptionCheck() { return exception; }
  jbyteArray NewByteArray(jsize size) {
    if (count_allocations) java_array_bytes += size;
    Uncounted uncounted;
    array = std::make_unique<Array>();
    array->bytes.resize(size);
    return array.get();
  }
  void SetByteArrayRegion(jbyteArray target, jsize start, jsize size, const jbyte* source) {
    if (count_allocations) java_copy_bytes += size;
    std::memcpy(target->bytes.data() + start, source, size);
  }
  jsize GetArrayLength(jbyteArray value) { return static_cast<jsize>(value->bytes.size()); }
  jbyte* GetByteArrayElements(jbyteArray value, void*) { ++pins; return value->bytes.data(); }
  void ReleaseByteArrayElements(jbyteArray, jbyte*, int mode) { Check(mode == JNI_ABORT, "input arrays are not written"); ++releases; }
  jint CallStaticIntMethod(jclass, jmethodID, jobject surface, jbyteArray value, jint w, jint h,
                          jlong timestamp, jbyteArray jpeg);
};
JNIEnv* current_env = nullptr;
JNIEnv* AttachedEnv(const char*) { return current_env; }
jclass CameraFramesClass(JNIEnv*) { return reinterpret_cast<void*>(1); }
bool CheckException(JNIEnv* env, const char*) {
  const bool failed = env->exception;
  env->exception = false;
  return failed;
}
void jniThrowException(JNIEnv* env, const char*, const char*) { env->exception = true; }
