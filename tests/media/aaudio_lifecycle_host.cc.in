// Complete production AAudio code at a deterministic device boundary. The
// independent expected states/masks come from Android 16r4, not the shim.
#include <algorithm>
#include <atomic>
#include <chrono>
#include <condition_variable>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <limits>
#include <memory>
#include <mutex>
#include <new>
#include <string>
#include <thread>
#include <unordered_map>
#include <vector>
#include <sys/types.h>
#include <time.h>
#define SYSV
template <class... T> void IgnoreLog(T&&...) {}
#define MEDIA_LOGE(...) IgnoreLog(__VA_ARGS__)
#define MEDIA_LOGI(...) IgnoreLog(__VA_ARGS__)
namespace gesher {
int AndroidClockGettime(clockid_t clock, timespec* value) { return clock_gettime(clock, value); }
}
namespace gesher::bionic {
std::unordered_map<std::string, void*> exports;
void EnterLoadedCode() {}
void AddBionicSymbol(const char*, const char* name, void* value) { exports[name] = value; }
}
namespace gesher::media {
void RaiseAudioThreadPriority(bool) {}
constexpr int kInputDeviceId = 3, kOutputDeviceId = 2;
enum class PcmFormat { kFloat, kS16, kS24Packed, kS32 };
size_t BytesPerSample(PcmFormat pcm) {
  return pcm == PcmFormat::kS16 ? 2 : pcm == PcmFormat::kS24Packed ? 3 : 4;
}
struct TrackParams {
  uint32_t sample_rate = 0, channels = 0; PcmFormat format = PcmFormat::kFloat;
  int stream_type = 0, session_id = 0; size_t capacity_frames = 0; std::string name;
};
struct CaptureParams {
  uint32_t sample_rate = 0, channels = 0; PcmFormat format = PcmFormat::kFloat;
  size_t capacity_frames = 0; std::string name;
};
struct OutputInfo { uint32_t sample_rate = 48000, period_frames = 480; };
struct InputInfo { uint32_t sample_rate = 48000; std::string description = "observer"; };
OutputInfo GetOutputInfo() { return {}; }
InputInfo GetInputInfo() { return {}; }
bool RecordingAllowed() { return true; }
int NewSessionId() { return 1234; }
struct CaptureStats {
  uint64_t captured_frames = 0, read_frames = 0;
  uint32_t lost_frames = 0, overruns = 0;
  int64_t timestamp_ns = 0;
};
struct Backend {
  std::atomic<int> starts{0}, pauses{0}, stops{0}, flushes{0}, releases{0}, writes{0}, reads{0};
  std::atomic<bool> released{false};
  std::atomic<int> start_result{0};
  std::atomic<ssize_t> write_limit{-1};
  size_t capacity = 0, frame_size = 0;
  uint32_t buffer_size = 0;
  int Start() { ++starts; return released ? -3 : start_result.load(); }
  void Pause() { ++pauses; }
  void Stop() { ++stops; }
  void Flush() { ++flushes; }
  void Release() { ++releases; released = true; }
  bool WaitForRoom(size_t, int) { return true; }
  bool WaitForData(size_t, int) { return true; }
  ssize_t Write(const void*, size_t size, bool) {
    ++writes;
    if (released) return -1;
    const ssize_t limit = write_limit;
    return limit < 0 ? static_cast<ssize_t>(size)
                     : std::min(limit, static_cast<ssize_t>(size));
  }
  ssize_t Read(void* data, size_t size, bool) {
    ++reads;
    if (released) return -1;
    std::memset(data, 0, size);
    return static_cast<ssize_t>(size);
  }
  uint32_t buffer_capacity_frames() const { return static_cast<uint32_t>(capacity); }
  uint32_t buffer_size_frames() const { return buffer_size; }
  int32_t SetBufferSizeFrames(uint32_t frames) {
    buffer_size = static_cast<uint32_t>(std::min<size_t>(capacity, frames));
    return static_cast<int32_t>(buffer_size);
  }
  size_t capacity_frames() const { return capacity; }
  bool Timestamp(int64_t*, int64_t*) const { return false; }
  uint32_t underrun_count() const { return 0; }
  uint32_t overrun_count() const { return 0; }
  int64_t Position() const { return 0; }
  uint64_t frames_captured() const { return 0; }
  uint64_t frames_read() const { return 0; }
  CaptureStats stats() const { return {}; }
};
struct Track : Backend {};
struct CaptureStream : Backend {};
std::shared_ptr<Backend> last_backend;
int factories = 0;
std::shared_ptr<Track> CreateTrack(const TrackParams& p, std::string*) {
  ++factories;
  auto value = std::make_shared<Track>();
  value->capacity = p.capacity_frames;
  value->buffer_size = static_cast<uint32_t>(p.capacity_frames);
  value->frame_size = p.channels * BytesPerSample(p.format);
  last_backend = value;
  return value;
}
std::shared_ptr<CaptureStream> OpenCapture(const CaptureParams& p, std::string*) {
  ++factories;
  auto value = std::make_shared<CaptureStream>();
  value->capacity = p.capacity_frames;
  value->buffer_size = static_cast<uint32_t>(p.capacity_frames);
  value->frame_size = p.channels * BytesPerSample(p.format);
  last_backend = value;
  return value;
}
}

@PRODUCTION_IMPLEMENTATION@

using namespace gesher::media;
int checks = 0, failures = 0;
void Check(bool ok, const char* text) {
  ++checks;
  if (!ok) { ++failures; std::fprintf(stderr, "FAIL %s\n", text); }
}
template <class Predicate> bool Await(Predicate condition) {
  const auto end = std::chrono::steady_clock::now() + std::chrono::seconds(2);
  while (!condition() && std::chrono::steady_clock::now() < end) {
    std::this_thread::sleep_for(std::chrono::milliseconds(1));
  }
  return condition();
}
template <class Function> Function Symbol(const char* name) {
  auto found = gesher::bionic::exports.find(name);
  return found == gesher::bionic::exports.end() ? nullptr : reinterpret_cast<Function>(found->second);
}
using MaskQuery = uint32_t (*)(AAudioStream*);
using DeviceQuery = int32_t (*)(AAudioStream*, int32_t*, int32_t*);

void Masks() {
  const auto mask = Symbol<MaskQuery>("AAudioStream_getChannelMask");
  Check(mask != nullptr, "channel-mask query is exported");
  if (mask == nullptr) return;
  for (int direction : {0, 1}) {
    for (int selection = 0; selection < 7; ++selection) {
      Builder b; SetDirection(&b, direction);
      uint32_t expected_mask = direction == 0 ? 3 : 1;
      int expected_channels = direction == 0 ? 2 : 1;
      switch (selection) {
        case 1: SetChannelMask(&b, 3); expected_mask = 3; expected_channels = 2; break;
        case 2: SetChannelMask(&b, 1); expected_mask = 1; expected_channels = 1; break;
        case 3: SetChannelMask(&b, 3); SetChannelCount(&b, 1);
          expected_mask = 0; expected_channels = 1; break;
        case 4: SetChannelCount(&b, 1); SetChannelMask(&b, 3);
          expected_mask = 3; expected_channels = 2; break;
        case 5: SetChannelMask(&b, 3); SetChannelCount(&b, 0); break;
        case 6: SetChannelCount(&b, 8); SetChannelMask(&b, 0); break;
      }
      AAudioStream* stream = nullptr;
      Check(OpenStream(&b, &stream) == 0 && stream != nullptr, "supported layout opens");
      if (stream == nullptr) continue;
      Check(mask(stream) == expected_mask, "explicit/default/index mask and setter ordering");
      Check(GetChannelCount(stream) == expected_channels, "mask and sample count agree");
      Close(stream);
    }
  }
  for (uint32_t layout : {0x7u, 0xfu, 0x3fu, 0x60fu, 0x63fu}) {
    Builder b; SetChannelMask(&b, layout);
    AAudioStream* stream = nullptr;
    Check(OpenStream(&b, &stream) == 0 && stream != nullptr, "standard mixer order remains supported");
    if (stream != nullptr) {
      Check(mask(stream) == layout && GetChannelCount(stream) == __builtin_popcount(layout),
            "standard positional mask survives open");
      Close(stream);
    }
  }
  struct BadMask { int direction; uint32_t mask; int error; };
  // Every newly unavailable Android layout within the old channel limit:
  // their sample order cannot be represented by the current backend mapping.
  for (auto entry : {BadMask{0, 0xb, -889}, BadMask{0, 0x103, -889},
                     BadMask{0, 0xc0003, -889}, BadMask{0, 0xc000b, -889},
                     BadMask{0, 0xc0007, -889}, BadMask{0, 0xc000f, -889},
                     BadMask{0, 0x33, -889}, BadMask{0, 0x603, -889},
                     BadMask{0, 0x107, -889}, BadMask{0, 0x37, -889},
                     BadMask{0, 0x13f, -889}, BadMask{0, 0xc003f, -889},
                     BadMask{0, 0x2d03f, -889}, BadMask{0, 0xc063f, -889},
                     BadMask{0, 0x2d63f, -889}, BadMask{1, 0x104, -889},
                     BadMask{1, 0xc0003, -889}, BadMask{1, 0xc000b, -889},
                     BadMask{1, 0xc0007, -889}, BadMask{1, 0xc000f, -889},
                     BadMask{1, 0x3f, -889}, BadMask{0, 0x104, -898},
                     BadMask{1, 0x7, -898}, BadMask{0, 0x10000000, -898}}) {
    Builder b; SetDirection(&b, entry.direction); SetChannelMask(&b, entry.mask);
    AAudioStream* stream = reinterpret_cast<AAudioStream*>(uintptr_t{1});
    const int before = factories;
    Check(OpenStream(&b, &stream) == entry.error, "unsupported versus invalid positional layout");
    Check(stream == nullptr && factories == before, "rejected layout never reaches a backend");
    if (stream != nullptr && stream != reinterpret_cast<AAudioStream*>(uintptr_t{1})) Close(stream);
  }
}

void DeviceIds() {
  const auto query = Symbol<DeviceQuery>("AAudioStream_getDeviceIds");
  Check(query != nullptr, "API36 device-ID array query is exported");
  if (query == nullptr) return;
  for (int direction : {0, 1}) {
    Builder b; SetDirection(&b, direction);
    AAudioStream* stream = nullptr;
    Check(OpenStream(&b, &stream) == 0 && stream != nullptr, "device-query stream opens");
    if (stream == nullptr) continue;
    int32_t ids[3] = {71, 72, 73}, count = 0;
    Check(query(stream, ids, nullptr) == -898 && ids[0] == 71, "null size pointer rejected without writes");
    Check(query(stream, nullptr, &count) == -882 && count == 1, "zero-capacity sizing precedes null array");
    count = 0;
    Check(query(stream, ids, &count) == -882 && count == 1 && ids[0] == 71, "insufficient capacity preserves array");
    count = 3;
    Check(query(stream, nullptr, &count) == -898 && count == 3, "null array with capacity preserves count");
    Check(query(stream, ids, &count) == 0 && count == 1 && ids[0] == GetDeviceId(stream)
          && ids[1] == 72 && ids[2] == 73, "single actual virtual device and untouched spare entries");
    Check(Release(stream) == 0, "release leaves device queries valid");
    count = 1;
    Check(query(stream, ids, &count) == 0 && ids[0] == (direction == 0 ? 2 : 3),
          "released stream retains device identity");
    Close(stream);
  }
}

void Lifecycle() {
  Check(Release(nullptr) == -886 && Close(nullptr) == -886, "null lifetime handles rejected");
  for (int direction : {0, 1}) {
    Builder b; SetDirection(&b, direction);
    AAudioStream* stream = nullptr;
    Check(OpenStream(&b, &stream) == 0 && stream != nullptr, "lifecycle stream opens");
    if (stream == nullptr) continue;
    auto backend = last_backend;
    Check(RequestStart(stream) == 0 && GetState(stream) == 4, "open to started");
    const int starts = backend->starts;
    Check(RequestStart(stream) == -895 && GetState(stream) == 4 && backend->starts == starts,
          "redundant start rejects before touching backend");
    if (direction == 0) {
      Check(RequestFlush(stream) == -895 && GetState(stream) == 4, "active stream cannot flush");
      Check(RequestPause(stream) == 0 && GetState(stream) == 6, "started to paused");
      const int pauses = backend->pauses;
      Check(RequestPause(stream) == 0 && backend->pauses == pauses, "redundant pause is idempotent");
      Check(RequestFlush(stream) == 0 && RequestFlush(stream) == 0 && GetState(stream) == 8,
            "already flushed may flush again");
      Check(RequestStart(stream) == 0 && GetState(stream) == 4, "flushed stream restarts");
    } else {
      Check(RequestPause(stream) == -890 && RequestFlush(stream) == -890 && GetState(stream) == 4,
            "input pause/flush report unsupported before lifecycle checks");
    }
    Check(RequestStop(stream) == 0 && GetState(stream) == 10, "started to stopped");
    const int stops = backend->stops;
    Check(RequestStop(stream) == 0 && backend->stops == stops, "redundant stop is idempotent");
    backend->start_result = -3;
    Check(RequestStart(stream) == -896 && GetState(stream) == 10, "failed backend start preserves state");
    backend->start_result = 0;
    Check(RequestStart(stream) == 0, "stopped stream restarts");
    Check(Release(stream) == 0 && GetState(stream) == 11 && backend->releases == 1,
          "release retires resources and publishes closing");
    float sample[2] = {};
    Check((direction == 0 ? Write(stream, sample, 1, 0) : Read(stream, sample, 1, 0)) == -895,
          "released stream rejects data transfer before touching backend");
    Check((direction == 0 ? Write(stream, sample, 0, 0) : Read(stream, sample, 0, 0)) == 0,
          "public zero-frame precedence remains valid after release");
    Check(RequestStart(stream) == -895 && GetState(stream) == 11, "released stream cannot restart");
    Check(RequestStop(stream) == -895 && GetState(stream) == 11, "stop cannot undo release");
    Check(RequestPause(stream) == (direction == 0 ? -895 : -890) && GetState(stream) == 11,
          "pause cannot undo release");
    Check(RequestFlush(stream) == (direction == 0 ? -895 : -890) && GetState(stream) == 11,
          "flush cannot undo release");
    Check(Release(stream) == 0 && backend->releases == 1, "release is idempotent");
    Check(GetSampleRate(stream) == 48000 && GetChannelCount(stream) > 0,
          "immutable queries remain usable after release");
    Check(Close(stream) == 0 && backend->releases == 1, "close after release destroys without releasing twice");
  }
}

struct CallbackGate {
  std::mutex mu;
  std::condition_variable cv;
  bool allow_first = false, allow_second = false;
  int calls = 0;
  int first_result = 0;
  int second_result = 1;
};
int32_t GatedCallback(AAudioStream*, void* opaque, void*, int32_t) {
  auto* gate = static_cast<CallbackGate*>(opaque);
  std::unique_lock<std::mutex> lock(gate->mu);
  const int call = ++gate->calls;
  gate->cv.notify_all();
  gate->cv.wait(lock, [&] { return call == 1 ? gate->allow_first : gate->allow_second; });
  return call == 1 ? gate->first_result : gate->second_result;
}
bool WaitCalls(CallbackGate& gate, int count) {
  std::unique_lock<std::mutex> lock(gate.mu);
  return gate.cv.wait_for(lock, std::chrono::seconds(2), [&] { return gate.calls >= count; });
}
void Permit(CallbackGate& gate, bool second = false) {
  std::lock_guard<std::mutex> lock(gate.mu);
  gate.allow_first = true;
  gate.allow_second |= second;
  gate.cv.notify_all();
}

void ReleaseDuringCallback(int direction) {
  CallbackGate gate;
  Builder b; SetDirection(&b, direction); SetDataCallback(&b, GatedCallback, &gate);
  AAudioStream* stream = nullptr;
  Check(OpenStream(&b, &stream) == 0 && stream != nullptr, "release-race callback stream opens");
  if (stream == nullptr) return;
  auto backend = last_backend;
  Check(RequestStart(stream) == 0 && WaitCalls(gate, 1), "callback admitted before release");
  std::atomic<bool> returned{false};
  std::thread release([&] { Release(stream); returned = true; });
  Check(Await([&] { return GetState(stream) == 11; }), "release publishes closing before joining callback");
  Check(!returned, "release waits for already admitted callback");
  Check(RequestStart(stream) == -895 && GetState(stream) == 11, "concurrent start cannot revive closing stream");
  Check(RequestStop(stream) == -895 && GetState(stream) == 11, "concurrent stop cannot overwrite closing");
  Permit(gate, true);
  Check(Await([&] { return returned.load(); }), "release finishes after callback exits");
  release.join();
  Check(GetState(stream) == 11 && backend->releases == 1, "late callback cannot resurrect released state");
  Check(Close(stream) == 0 && backend->releases == 1, "released worker closes once");
  // Close joins even the old-source worker, making this observation independent
  // of how quickly its already admitted callback returns after Permit.
  Check(backend->writes == 0, "retired output callback cannot commit audio after release");
}

void RestartDuringCallback(int direction) {
  CallbackGate gate; gate.first_result = 1;
  Builder b; SetDirection(&b, direction); SetDataCallback(&b, GatedCallback, &gate);
  AAudioStream* stream = nullptr;
  Check(OpenStream(&b, &stream) == 0 && stream != nullptr, "restart-race callback stream opens");
  if (stream == nullptr) return;
  auto backend = last_backend;
  Check(RequestStart(stream) == 0 && WaitCalls(gate, 1), "old generation callback is admitted");
  Check(RequestStop(stream) == 0 && RequestStart(stream) == 0, "stop followed by start creates fresh generation");
  Permit(gate);
  Check(WaitCalls(gate, 2) && GetState(stream) == 4, "old callback STOP cannot cancel a new start");
  Check(backend->writes == 0, "old callback PCM is discarded after restart");
  Permit(gate, true);
  Check(Await([&] { return GetState(stream) == 10; }), "current callback STOP stops its own generation");
  Close(stream);
}

struct GuardResult { std::atomic<int> calls{0}, failures{0}; };
int32_t GuardCallback(AAudioStream* stream, void* opaque, void*, int32_t) {
  auto* result = static_cast<GuardResult*>(opaque);
  const int pause = GetDirection(stream) == 0 ? -895 : -890;
  if (RequestStart(stream) != -895 || RequestStop(stream) != -895
      || RequestPause(stream) != pause || RequestFlush(stream) != pause
      || Release(stream) != -895 || Close(stream) != -895) ++result->failures;
  ++result->calls;
  return 1;
}
void CallbackGuards(int direction) {
  GuardResult result;
  Builder b; SetDirection(&b, direction); SetDataCallback(&b, GuardCallback, &result);
  AAudioStream* stream = nullptr;
  Check(OpenStream(&b, &stream) == 0 && stream != nullptr, "callback-guard stream opens");
  if (stream == nullptr) return;
  Check(RequestStart(stream) == 0 && Await([&] { return result.calls.load() != 0; }),
        "public lifecycle calls return from callback without joining or locking themselves");
  Check(result.failures == 0, "callback lifecycle calls obey Android error precedence");
  Check(Await([&] { return GetState(stream) == 10; }), "callback return STOP remains valid");
  Close(stream);
}

void ConcurrentRelease(int direction) {
  CallbackGate gate;
  Builder b; SetDirection(&b, direction); SetDataCallback(&b, GatedCallback, &gate);
  AAudioStream* stream = nullptr;
  Check(OpenStream(&b, &stream) == 0 && stream != nullptr, "parallel-release stream opens");
  if (stream == nullptr) return;
  auto backend = last_backend;
  Check(RequestStart(stream) == 0 && WaitCalls(gate, 1), "parallel-release callback is admitted");
  std::atomic<int> entered{0}, returned{0};
  int results[2] = {-1, -1};
  auto release = [&](int index) {
    ++entered;
    results[index] = Release(stream);
    ++returned;
  };
  std::thread first(release, 0), second(release, 1);
  Check(Await([&] { return entered == 2 && GetState(stream) == 11; }),
        "both release callers enter while callback remains admitted");
  Check(returned == 0, "neither parallel release finishes before callback retires");
  Permit(gate, true);
  Check(Await([&] { return returned == 2; }), "both parallel releases finish after callback retires");
  first.join(); second.join();
  Check(results[0] == 0 && results[1] == 0 && backend->releases == 1,
        "parallel releases succeed and release backend exactly once");
  Check(GetState(stream) == 11, "parallel release retains closing state");
  Close(stream);
}

void PartialCallbackWrite() {
  CallbackGate gate;
  Builder b; SetDataCallback(&b, GatedCallback, &gate);
  AAudioStream* stream = nullptr;
  Check(OpenStream(&b, &stream) == 0 && stream != nullptr, "partial-write stream opens");
  if (stream == nullptr) return;
  auto backend = last_backend;
  backend->write_limit = static_cast<ssize_t>(backend->frame_size);
  Check(RequestStart(stream) == 0 && WaitCalls(gate, 1), "partial-write callback is admitted");
  Permit(gate);
  Check(WaitCalls(gate, 2), "first callback committed before second callback is held");
  Check(backend->writes == 1 && GetFramesWritten(stream) == 1,
        "frame count includes only accepted PCM, not the whole requested callback");
  Permit(gate, true);
  Close(stream);
}

struct OtherStreamResult {
  AAudioStream* other = nullptr;
  std::atomic<int> calls{0}, failures{0};
};
int32_t OtherStreamCallback(AAudioStream*, void* opaque, void*, int32_t) {
  auto* result = static_cast<OtherStreamResult*>(opaque);
  AAudioStream* other = result->other;
  if (RequestStart(other) != 0 || RequestPause(other) != 0 || RequestFlush(other) != 0
      || RequestStop(other) != 0 || Release(other) != 0 || Close(other) != 0) {
    ++result->failures;
  }
  ++result->calls;
  return 1;
}
void OtherStreamLifecycle() {
  OtherStreamResult result;
  Builder other_builder;
  Check(OpenStream(&other_builder, &result.other) == 0 && result.other != nullptr,
        "second stream opens for callback collision isolation");
  if (result.other == nullptr) return;
  Builder callback_builder; SetDataCallback(&callback_builder, OtherStreamCallback, &result);
  AAudioStream* stream = nullptr;
  Check(OpenStream(&callback_builder, &stream) == 0 && stream != nullptr,
        "callback stream opens for collision isolation");
  if (stream == nullptr) { Close(result.other); return; }
  Check(RequestStart(stream) == 0 && Await([&] { return result.calls == 1; }),
        "callback may control and close a different stream");
  Check(result.failures == 0, "callback guard applies only to its own stream");
  Close(stream);
}

int main(int argc, char**) {
  Masks();
  DeviceIds();
  Lifecycle();
  for (int direction : {0, 1}) {
    ReleaseDuringCallback(direction);
    RestartDuringCallback(direction);
    ConcurrentRelease(direction);
    if (argc == 1) CallbackGuards(direction);
  }
  PartialCallbackWrite();
  OtherStreamLifecycle();
  std::printf("AAudio lifecycle contracts: %d checks, %d failures\n", checks, failures);
  return failures == 0 ? 0 : 1;
}
