import android.os.IBinder;
import android.os.IInterface;
import android.os.RemoteException;
import android.view.KeyEvent;
import java.util.List;
public interface ISessionManager extends IInterface {
    ISession createSession(String packageName, ISessionCallback cb, String tag, Bundle sessionInfo,
            int userId) throws RemoteException;
    List<MediaSession.Token> getSessions(ComponentName compName, int userId) throws RemoteException;
    MediaSession.Token getMediaKeyEventSession(String packageName) throws RemoteException;
    String getMediaKeyEventSessionPackageName(String packageName) throws RemoteException;
    void addSessionsListener(IActiveSessionsListener listener, ComponentName compName, int userId)
            throws RemoteException;
    void removeSessionsListener(IActiveSessionsListener listener) throws RemoteException;
    void addOnMediaKeyEventSessionChangedListener(
            IOnMediaKeyEventSessionChangedListener listener, String packageName)
            throws RemoteException;
    void removeOnMediaKeyEventSessionChangedListener(
            IOnMediaKeyEventSessionChangedListener listener) throws RemoteException;
    void addOnMediaKeyEventDispatchedListener(IOnMediaKeyEventDispatchedListener listener)
            throws RemoteException;
    void removeOnMediaKeyEventDispatchedListener(IOnMediaKeyEventDispatchedListener listener)
            throws RemoteException;
    boolean isGlobalPriorityActive() throws RemoteException;
    void dispatchMediaKeyEvent(String packageName, boolean asSystemService, KeyEvent keyEvent,
            boolean needWakeLock) throws RemoteException;
    boolean dispatchMediaKeyEventToSessionAsSystemService(String packageName, KeyEvent keyEvent,
            MediaSession.Token sessionToken) throws RemoteException;
    void dispatchVolumeKeyEvent(String packageName, String opPackageName, boolean asSystemService,
            KeyEvent keyEvent, int stream, boolean musicOnly) throws RemoteException;
    void dispatchVolumeKeyEventToSessionAsSystemService(String packageName, String opPackageName,
            KeyEvent keyEvent, MediaSession.Token sessionToken) throws RemoteException;
    void dispatchAdjustVolume(String packageName, String opPackageName, int suggestedStream,
            int delta, int flags) throws RemoteException;

    class Default implements ISessionManager {
        @Override public IBinder asBinder() { return null; }
        @Override public ISession createSession(String packageName, ISessionCallback cb, String tag,
                Bundle sessionInfo, int userId) throws RemoteException { return null; }
        @Override public List<MediaSession.Token> getSessions(ComponentName compName, int userId)
                throws RemoteException { return null; }
        @Override public MediaSession.Token getMediaKeyEventSession(String packageName)
                throws RemoteException { return null; }
        @Override public String getMediaKeyEventSessionPackageName(String packageName)
                throws RemoteException { return null; }
        @Override public void addSessionsListener(IActiveSessionsListener listener,
                ComponentName compName, int userId) throws RemoteException {}
        @Override public void removeSessionsListener(IActiveSessionsListener listener)
                throws RemoteException {}
        @Override public void addOnMediaKeyEventSessionChangedListener(
                IOnMediaKeyEventSessionChangedListener listener, String packageName)
                throws RemoteException {}
        @Override public void removeOnMediaKeyEventSessionChangedListener(
                IOnMediaKeyEventSessionChangedListener listener) throws RemoteException {}
        @Override public void addOnMediaKeyEventDispatchedListener(
                IOnMediaKeyEventDispatchedListener listener) throws RemoteException {}
        @Override public void removeOnMediaKeyEventDispatchedListener(
                IOnMediaKeyEventDispatchedListener listener) throws RemoteException {}
        @Override public boolean isGlobalPriorityActive() throws RemoteException { return false; }
        @Override public void dispatchMediaKeyEvent(String packageName, boolean asSystemService,
                KeyEvent keyEvent, boolean needWakeLock) throws RemoteException {}
        @Override public boolean dispatchMediaKeyEventToSessionAsSystemService(String packageName,
                KeyEvent keyEvent, MediaSession.Token sessionToken) throws RemoteException {
            return false;
        }
        @Override public void dispatchVolumeKeyEvent(String packageName, String opPackageName,
                boolean asSystemService, KeyEvent keyEvent, int stream, boolean musicOnly)
                throws RemoteException {}
        @Override public void dispatchVolumeKeyEventToSessionAsSystemService(String packageName,
                String opPackageName, KeyEvent keyEvent, MediaSession.Token sessionToken)
                throws RemoteException {}
        @Override public void dispatchAdjustVolume(String packageName, String opPackageName,
                int suggestedStream, int delta, int flags) throws RemoteException {}
    }

    abstract class Stub extends Binder implements ISessionManager {
        public static final String DESCRIPTOR = "android.media.session.ISessionManager";
        @Override public IBinder asBinder() { return this; }
    }
}

// FILE: com/gesher/server/AudioService.java
package com.gesher.server;
import android.media.AudioManager;
import android.media.AudioSystem;
import java.util.ArrayList;
import java.util.List;
/** Controlled host AudioService boundary: records suggested/stream volume operations. */
public final class AudioService {
    static final int[] MAX = {5, 7, 7, 15, 7, 7, 15, 7, 15, 15, 15, 15};
    private final int[] mVolumes = {3, 4, 4, 8, 4, 4, 8, 4, 8, 8, 8, 8};
    public final List<String> calls = new ArrayList<>();

    public int getStreamMaxVolume(int stream) {
        return stream >= 0 && stream < MAX.length ? MAX[stream] : 15;
    }

    public int getStreamVolume(int stream) {
        return stream >= 0 && stream < mVolumes.length ? mVolumes[stream] : 0;
    }

    public void adjustStreamVolume(int stream, int direction, int flags, String callingPackage) {
        calls.add("adjustStream:" + stream + ":" + direction + ":" + flags + ":" + callingPackage);
        if (stream >= 0 && stream < mVolumes.length) {
            if (direction == AudioManager.ADJUST_RAISE) mVolumes[stream] = Math.min(MAX[stream], mVolumes[stream] + 1);
            else if (direction == AudioManager.ADJUST_LOWER) mVolumes[stream] = Math.max(0, mVolumes[stream] - 1);
        }
    }

    public void setStreamVolume(int stream, int index, int flags, String callingPackage) {
        calls.add("setStream:" + stream + ":" + index + ":" + flags + ":" + callingPackage);
        if (stream >= 0 && stream < mVolumes.length) mVolumes[stream] = index;
    }

    public void adjustSuggestedStreamVolume(int direction, int suggestedStreamType, int flags) {
        calls.add("adjustSuggested:" + direction + ":" + suggestedStreamType + ":" + flags);
        int target = suggestedStreamType >= 0 && suggestedStreamType < MAX.length
                ? suggestedStreamType : AudioSystem.STREAM_MUSIC;
        adjustStreamVolume(target, direction, flags, null);
    }

    public void clear() { calls.clear(); }
}

// FILE: com/gesher/server/MediaSessionHost.java
package com.gesher.server;

import android.content.Intent;
import android.media.AudioManager;
import android.media.AudioSystem;
import android.media.MediaMetadata;
import android.media.Rating;
import android.media.VolumeProvider;
import android.media.session.IActiveSessionsListener;
import android.media.session.IOnMediaKeyEventDispatchedListener;
import android.media.session.IOnMediaKeyEventSessionChangedListener;
import android.media.session.ISession;
import android.media.session.ISessionCallback;
import android.media.session.ISessionController;
import android.media.session.ISessionControllerCallback;
import android.media.session.MediaController;
import android.media.session.MediaSession;
import android.media.session.PlaybackState;
import android.net.Uri;
import android.os.Binder;
import android.os.Bundle;
import android.os.DeadObjectException;
import android.os.IBinder;
import android.os.RemoteCallbackList;
import android.os.RemoteException;
import android.os.ResultReceiver;
import android.os.UserHandle;
import android.view.KeyEvent;
import java.lang.management.ManagementFactory;
import java.lang.reflect.Field;
import java.lang.reflect.InvocationHandler;
import java.lang.reflect.Proxy;
import java.util.ArrayList;
import java.util.Collections;
import java.util.List;

/** Host contract and steady-state allocation tests for production MediaSessionService. */
public final class MediaSessionHost {
    private static int checks;

    private static void check(boolean ok, String reason) {
        if (!ok) throw new AssertionError(reason);
        checks++;
    }

    private static class SessionCallbackStub implements ISessionCallback {
        final Binder binder = new Binder();
        final List<KeyEvent> mediaButtons = new ArrayList<>();
        final List<Integer> volumeDirections = new ArrayList<>();
        boolean deadRemote;
        RemoteException transientFailure;

        private void ensureAlive() throws RemoteException {
            if (deadRemote || binder.isDead()) throw new DeadObjectException("remote session owner died");
            if (transientFailure != null) throw transientFailure;
        }

        @Override public IBinder asBinder() { return binder; }
        @Override public void onMediaButtonFromController(String pkg, int pid, int uid, Intent intent)
                throws RemoteException {
            ensureAlive();
            mediaButtons.add((KeyEvent) intent.getExtra(Intent.EXTRA_KEY_EVENT));
        }
        @Override public void onAdjustVolume(String pkg, int pid, int uid, int direction)
                throws RemoteException {
            ensureAlive();
            volumeDirections.add(direction);
        }
        @Override public void onSetVolumeTo(String pkg, int pid, int uid, int value)
                throws RemoteException { ensureAlive(); }
        @Override public void onCommand(String pkg, int pid, int uid, String command, Bundle args,
                ResultReceiver cb) throws RemoteException { ensureAlive(); }
        @Override public void onPrepare(String pkg, int pid, int uid) throws RemoteException { ensureAlive(); }
        @Override public void onPrepareFromMediaId(String pkg, int pid, int uid, String id, Bundle extras)
                throws RemoteException { ensureAlive(); }
        @Override public void onPrepareFromSearch(String pkg, int pid, int uid, String q, Bundle extras)
                throws RemoteException { ensureAlive(); }
        @Override public void onPrepareFromUri(String pkg, int pid, int uid, Uri uri, Bundle extras)
                throws RemoteException { ensureAlive(); }
        @Override public void onPlay(String pkg, int pid, int uid) throws RemoteException { ensureAlive(); }
        @Override public void onPlayFromMediaId(String pkg, int pid, int uid, String id, Bundle extras)
                throws RemoteException { ensureAlive(); }
        @Override public void onPlayFromSearch(String pkg, int pid, int uid, String q, Bundle extras)
                throws RemoteException { ensureAlive(); }
        @Override public void onPlayFromUri(String pkg, int pid, int uid, Uri uri, Bundle extras)
                throws RemoteException { ensureAlive(); }
        @Override public void onSkipToTrack(String pkg, int pid, int uid, long id) throws RemoteException { ensureAlive(); }
        @Override public void onPause(String pkg, int pid, int uid) throws RemoteException { ensureAlive(); }
        @Override public void onStop(String pkg, int pid, int uid) throws RemoteException { ensureAlive(); }
        @Override public void onNext(String pkg, int pid, int uid) throws RemoteException { ensureAlive(); }
        @Override public void onPrevious(String pkg, int pid, int uid) throws RemoteException { ensureAlive(); }
        @Override public void onFastForward(String pkg, int pid, int uid) throws RemoteException { ensureAlive(); }
        @Override public void onRewind(String pkg, int pid, int uid) throws RemoteException { ensureAlive(); }
        @Override public void onSeekTo(String pkg, int pid, int uid, long pos) throws RemoteException { ensureAlive(); }
        @Override public void onRate(String pkg, int pid, int uid, Rating rating) throws RemoteException { ensureAlive(); }
        @Override public void onSetPlaybackSpeed(String pkg, int pid, int uid, float speed) throws RemoteException { ensureAlive(); }
        @Override public void onCustomAction(String pkg, int pid, int uid, String action, Bundle args) throws RemoteException { ensureAlive(); }
    }

    private static final class ControllerObserver implements ISessionControllerCallback {
        final Binder binder = new Binder();
        int destroyedCount, metadataCount, playbackCount;
        @Override public IBinder asBinder() { return binder; }
        @Override public void onSessionDestroyed() { destroyedCount++; }
        @Override public void onMetadataChanged(MediaMetadata metadata) { metadataCount++; }
        @Override public void onPlaybackStateChanged(PlaybackState state) { playbackCount++; }
        @Override public void onEvent(String event, Bundle extras) {}
        @Override public void onQueueChanged(android.content.pm.ParceledListSlice queue) {}
        @Override public void onQueueTitleChanged(CharSequence title) {}
        @Override public void onExtrasChanged(Bundle extras) {}
        @Override public void onVolumeInfoChanged(MediaController.PlaybackInfo info) {}
    }

    private static final class DispatchedRecorder implements IOnMediaKeyEventDispatchedListener {
        final Binder binder = new Binder();
        final List<String> packages = new ArrayList<>();
        final List<MediaSession.Token> tokens = new ArrayList<>();
        @Override public IBinder asBinder() { return binder; }
        @Override public void onMediaKeyEventDispatched(KeyEvent event, String pkg,
                MediaSession.Token token) {
            packages.add(pkg);
            tokens.add(token);
        }
    }

    private static final class ActiveRecorder implements IActiveSessionsListener {
        final Binder binder = new Binder();
        int calls;
        List<MediaSession.Token> latest = Collections.emptyList();
        @Override public IBinder asBinder() { return binder; }
        @Override public void onActiveSessionsChanged(List<MediaSession.Token> sessions) {
            calls++;
            latest = new ArrayList<>(sessions);
        }
    }

    private static final class KeySessionRecorder implements IOnMediaKeyEventSessionChangedListener {
        final Binder binder = new Binder();
        int calls;
        String latestPkg;
        MediaSession.Token latestToken;
        @Override public IBinder asBinder() { return binder; }
        @Override public void onMediaKeyEventSessionChanged(String pkg, MediaSession.Token token) {
            calls++;
            latestPkg = pkg;
            latestToken = token;
        }
    }

    private static MediaSessionService.Session unwrapSession(ISession owner) throws Exception {
        InvocationHandler handler = Proxy.getInvocationHandler(owner);
        Field impl = StandIn.class.getDeclaredField("mImpl");
        impl.setAccessible(true);
        return (MediaSessionService.Session) impl.get(handler);
    }

    private static void testNullGuards() throws Exception {
        AudioService audio = new AudioService();
        MediaSessionService service = new MediaSessionService(audio);
        // Null listener with no active session and with an active session must not NPE.
        service.addOnMediaKeyEventSessionChangedListener(null, "com.example.caller");

        SessionCallbackStub cb = new SessionCallbackStub();
        ISession session = service.createSession("com.example.player", cb, "main", null, 0);
        session.setActive(true);
        service.addOnMediaKeyEventSessionChangedListener(null, "com.example.caller");

        ISessionController controller = session.getController();
        // Null callback on active session must not NPE.
        controller.registerCallback("com.example.ui", null);

        // Null callback on destroyed session must not NPE on ended -> cb.onSessionDestroyed().
        session.destroySession();
        controller.registerCallback("com.example.ui", null);
        checks += 4;
    }

    private static void testDeadMediaKeyDispatchAndFailover() throws Exception {
        AudioService audio = new AudioService();
        MediaSessionService service = new MediaSessionService(audio);
        DispatchedRecorder dispatched = new DispatchedRecorder();
        ActiveRecorder activeListener = new ActiveRecorder();
        KeySessionRecorder keySessionListener = new KeySessionRecorder();
        service.addOnMediaKeyEventDispatchedListener(dispatched);
        service.addSessionsListener(activeListener, null, UserHandle.USER_ALL);
        service.addOnMediaKeyEventSessionChangedListener(keySessionListener, "com.example.sysui");

        SessionCallbackStub liveCb = new SessionCallbackStub();
        ISession liveSession = service.createSession("com.example.live", liveCb, "live", null, 0);
        liveSession.setActive(true);
        MediaSession.Token liveToken = service.getMediaKeyEventSession("com.example.sysui");

        SessionCallbackStub deadTopCb = new SessionCallbackStub();
        ISession deadTopSession = service.createSession("com.example.deadtop", deadTopCb, "top", null, 0);
        ControllerObserver deadTopObserver = new ControllerObserver();
        deadTopSession.getController().registerCallback("com.example.sysui", deadTopObserver);
        deadTopSession.setActive(true);

        check(service.getSessions(null, UserHandle.USER_ALL).size() == 2, "two active sessions before death");
        check("com.example.deadtop".equals(service.getMediaKeyEventSessionPackageName("caller")),
                "top session selected before death");

        // Owner dies before async binderDied arrives; media key dispatch hits DeadObjectException.
        deadTopCb.deadRemote = true;
        KeyEvent play = new KeyEvent(KeyEvent.ACTION_DOWN, KeyEvent.KEYCODE_MEDIA_PLAY_PAUSE);
        service.dispatchMediaKeyEvent("com.example.caller", false, play, false);

        check(deadTopCb.mediaButtons.isEmpty(), "dead top session did not receive button");
        check(deadTopObserver.destroyedCount == 1, "dead top session notified controller onSessionDestroyed");
        check(deadTopCb.binder.deathRecipientCount() == 0, "dead top session unlinked death recipient");
        check(liveCb.mediaButtons.size() == 1 && liveCb.mediaButtons.get(0) == play,
                "dispatchMediaKeyEvent automatically failed over to live session underneath");
        check(dispatched.packages.equals(Collections.singletonList("com.example.live"))
                && dispatched.tokens.equals(Collections.singletonList(liveToken)),
                "mKeyEvents fired only for live session, never for dead session");
        check(service.getSessions(null, UserHandle.USER_ALL).equals(Collections.singletonList(liveToken)),
                "dead top session removed from active sessions");
        check("com.example.live".equals(keySessionListener.latestPkg)
                && liveToken.equals(keySessionListener.latestToken),
                "key-event session listener updated to surviving live session");

        // Non-media key and null event on a live session return cleanly without retiring it.
        service.dispatchMediaKeyEvent("com.example.caller", false,
                new KeyEvent(KeyEvent.ACTION_DOWN, KeyEvent.KEYCODE_A), false);
        service.dispatchMediaKeyEvent("com.example.caller", false, null, false);
        check(service.getSessions(null, UserHandle.USER_ALL).size() == 1 && liveCb.mediaButtons.size() == 1,
                "non-media/null key events leave live session intact");

        // Dead targeted session on dispatchMediaKeyEventToSessionAsSystemService retires and returns false.
        SessionCallbackStub targetedDeadCb = new SessionCallbackStub();
        ISession targetedDead = service.createSession("com.example.targeted", targetedDeadCb, "targeted", null, 0);
        targetedDead.setActive(true);
        MediaSession.Token targetedToken = service.getMediaKeyEventSession("caller");
        targetedDeadCb.deadRemote = true;
        dispatched.packages.clear();
        boolean delivered = service.dispatchMediaKeyEventToSessionAsSystemService(
                "com.example.sysui", play, targetedToken);
        check(!delivered, "dead targeted session returns false without throwing");
        check(dispatched.packages.isEmpty(), "dead targeted session did not emit mKeyEvents");
        check(service.getSessions(null, UserHandle.USER_ALL).equals(Collections.singletonList(liveToken)),
                "dead targeted session retired from active sessions");

        // Live targeted session returns true and emits mKeyEvents.
        boolean liveDelivered = service.dispatchMediaKeyEventToSessionAsSystemService(
                "com.example.sysui", play, liveToken);
        check(liveDelivered && liveCb.mediaButtons.size() == 2 && dispatched.packages.size() == 1,
                "live targeted session receives media key and emits mKeyEvents");
    }

    private static void testDeadRemoteVolumeFailoverAndAudioFallback() throws Exception {
        AudioService audio = new AudioService();
        MediaSessionService service = new MediaSessionService(audio);
        KeyEvent volUp = new KeyEvent(KeyEvent.ACTION_DOWN, KeyEvent.KEYCODE_VOLUME_UP);
        KeyEvent volDown = new KeyEvent(KeyEvent.ACTION_DOWN, KeyEvent.KEYCODE_VOLUME_DOWN);

        // Case A: Dead remote-volume top session fails over to live remote-volume session underneath.
        SessionCallbackStub liveRemoteCb = new SessionCallbackStub();
        ISession liveRemote = service.createSession("com.example.liveremote", liveRemoteCb, "r1", null, 0);
        liveRemote.setPlaybackToRemote(VolumeProvider.VOLUME_CONTROL_RELATIVE, 20, "cast-1");
        liveRemote.setActive(true);

        SessionCallbackStub deadRemoteCb = new SessionCallbackStub();
        ISession deadRemote = service.createSession("com.example.deadremote", deadRemoteCb, "r2", null, 0);
        deadRemote.setPlaybackToRemote(VolumeProvider.VOLUME_CONTROL_ABSOLUTE, 20, "cast-dead");
        deadRemote.setActive(true);
        deadRemoteCb.deadRemote = true;

        audio.clear();
        service.dispatchVolumeKeyEvent("com.example.caller", "com.example.caller", false,
                volUp, AudioSystem.STREAM_RING, false);
        check(deadRemoteCb.volumeDirections.isEmpty(), "dead remote session did not receive volume key");
        check(liveRemoteCb.volumeDirections.equals(Collections.singletonList(AudioManager.ADJUST_RAISE)),
                "dispatchVolumeKeyEvent retired dead top session and adjusted next live session");
        check(audio.calls.isEmpty(), "live session handled volume without falling through to AudioService");
        check(service.getSessions(null, UserHandle.USER_ALL).size() == 1,
                "dead remote session removed from active sessions");

        // Case B: When the remaining remote session also dies, dispatchVolumeKeyEvent falls back to AudioService.
        liveRemoteCb.deadRemote = true;
        audio.clear();
        service.dispatchVolumeKeyEvent("com.example.caller", "com.example.caller", false,
                volDown, AudioSystem.STREAM_ALARM, false);
        check(service.getSessions(null, UserHandle.USER_ALL).isEmpty(),
                "last dead remote session retired on volume key");
        check(audio.calls.size() == 2
                && ("adjustSuggested:" + AudioManager.ADJUST_LOWER + ":" + AudioSystem.STREAM_ALARM + ":0")
                        .equals(audio.calls.get(0)),
                "dispatchVolumeKeyEvent fell back to mAudio.adjustSuggestedStreamVolume with requested stream");

        // Case C: dispatchAdjustVolume retires dead top session -> next live session -> AudioService fallback.
        SessionCallbackStub liveAdjustCb = new SessionCallbackStub();
        ISession liveAdjust = service.createSession("com.example.liveadj", liveAdjustCb, "a1", null, 0);
        liveAdjust.setPlaybackToRemote(VolumeProvider.VOLUME_CONTROL_RELATIVE, 10, "adj-live");
        liveAdjust.setActive(true);

        SessionCallbackStub deadAdjustCb = new SessionCallbackStub();
        ISession deadAdjust = service.createSession("com.example.deadadj", deadAdjustCb, "a2", null, 0);
        deadAdjust.setPlaybackToRemote(VolumeProvider.VOLUME_CONTROL_RELATIVE, 10, "adj-dead");
        deadAdjust.setActive(true);
        deadAdjustCb.deadRemote = true;

        audio.clear();
        service.dispatchAdjustVolume("pkg", "opPkg", AudioSystem.STREAM_MUSIC, AudioManager.ADJUST_RAISE, 4);
        check(liveAdjustCb.volumeDirections.equals(Collections.singletonList(AudioManager.ADJUST_RAISE))
                && audio.calls.isEmpty()
                && service.getSessions(null, UserHandle.USER_ALL).size() == 1,
                "dispatchAdjustVolume retired dead top session and dispatched to next live session");

        liveAdjustCb.deadRemote = true;
        audio.clear();
        service.dispatchAdjustVolume("pkg", "opPkg", AudioSystem.STREAM_RING, AudioManager.ADJUST_LOWER, 7);
        check(service.getSessions(null, UserHandle.USER_ALL).isEmpty()
                && audio.calls.size() == 2
                && ("adjustSuggested:" + AudioManager.ADJUST_LOWER + ":" + AudioSystem.STREAM_RING + ":7")
                        .equals(audio.calls.get(0)),
                "dispatchAdjustVolume fell back to mAudio.adjustSuggestedStreamVolume with stream and flags");

        // Case D: dispatchVolumeKeyEventToSessionAsSystemService targeting a dead remote session
        // retires that session and falls back to STREAM_MUSIC (not another session).
        SessionCallbackStub bystanderCb = new SessionCallbackStub();
        ISession bystander = service.createSession("com.example.bystander", bystanderCb, "b", null, 0);
        bystander.setPlaybackToRemote(VolumeProvider.VOLUME_CONTROL_RELATIVE, 10, "bystander");
        bystander.setActive(true);

        SessionCallbackStub targetedVolCb = new SessionCallbackStub();
        ISession targetedVol = service.createSession("com.example.targetvol", targetedVolCb, "tv", null, 0);
        targetedVol.setPlaybackToRemote(VolumeProvider.VOLUME_CONTROL_RELATIVE, 10, "target");
        targetedVol.setActive(true);
        MediaSession.Token targetedToken = service.getMediaKeyEventSession("caller");
        targetedVolCb.deadRemote = true;

        audio.clear();
        service.dispatchVolumeKeyEventToSessionAsSystemService("pkg", "opPkg", volUp, targetedToken);
        check(bystanderCb.volumeDirections.isEmpty(), "targeted volume dispatch did not hit unrelated session");
        check(service.getSessions(null, UserHandle.USER_ALL).size() == 1,
                "dead targeted volume session retired");
        check(audio.calls.size() == 2
                && ("adjustSuggested:" + AudioManager.ADJUST_RAISE + ":" + AudioSystem.STREAM_MUSIC + ":0")
                        .equals(audio.calls.get(0)),
                "dead targeted volume dispatch fell back to STREAM_MUSIC with flags=0");
    }

    private static void testLiveSessionSurvivesTransactionFailure() throws Exception {
        AudioService audio = new AudioService();
        MediaSessionService service = new MediaSessionService(audio);
        SessionCallbackStub bystanderCb = new SessionCallbackStub();
        ISession bystander = service.createSession("com.example.bystander", bystanderCb,
                "bystander", null, 0);
        bystander.setPlaybackToRemote(VolumeProvider.VOLUME_CONTROL_RELATIVE, 20, "bystander");
        bystander.setActive(true);
        SessionCallbackStub liveCb = new SessionCallbackStub();
        ISession live = service.createSession("com.example.live", liveCb, "live", null, 0);
        live.setPlaybackToRemote(VolumeProvider.VOLUME_CONTROL_RELATIVE, 20, "live");
        live.setActive(true);
        MediaSession.Token token = service.getMediaKeyEventSession("caller");
        ControllerObserver observer = new ControllerObserver();
        live.getController().registerCallback("caller", observer);
        // RemoteException also represents a failed transaction to a still-live owner.
        // It must not destroy the session or deliver an uncertain operation elsewhere.
        RemoteException failure = new RemoteException("temporary transaction failure");
        liveCb.transientFailure = failure;
        KeyEvent media = new KeyEvent(KeyEvent.ACTION_DOWN, KeyEvent.KEYCODE_MEDIA_PLAY_PAUSE);
        KeyEvent volume = new KeyEvent(KeyEvent.ACTION_DOWN, KeyEvent.KEYCODE_VOLUME_UP);
        for (int route = 0; route < 5; route++) {
            boolean propagated = false;
            try {
                switch (route) {
                    case 0: service.dispatchMediaKeyEvent("caller", false, media, false); break;
                    case 1: service.dispatchMediaKeyEventToSessionAsSystemService("caller", media, token); break;
                    case 2: service.dispatchVolumeKeyEvent("caller", "caller", false, volume,
                            AudioSystem.STREAM_MUSIC, false); break;
                    case 3: service.dispatchVolumeKeyEventToSessionAsSystemService("caller", "caller",
                            volume, token); break;
                    default: service.dispatchAdjustVolume("caller", "caller", AudioSystem.STREAM_MUSIC,
                            AudioManager.ADJUST_RAISE, 0); break;
                }
            } catch (RemoteException expected) {
                propagated = expected == failure;
            }
            check(propagated, "non-death transaction failure is preserved for route " + route);
            check(service.getSessions(null, UserHandle.USER_ALL).size() == 2
                    && token.equals(service.getMediaKeyEventSession("caller"))
                    && observer.destroyedCount == 0,
                    "still-live session survives transaction failure for route " + route);
            check(bystanderCb.mediaButtons.isEmpty() && bystanderCb.volumeDirections.isEmpty()
                    && audio.calls.isEmpty(), "failed transaction is not redirected for route " + route);
        }
        liveCb.transientFailure = null;
        service.dispatchMediaKeyEvent("caller", false, media, false);
        check(liveCb.mediaButtons.size() == 1, "same session resumes after transaction recovers");
    }

    @SuppressWarnings("unchecked")
    private static void testBroadcastFinallyBalance() throws Exception {
        AudioService audio = new AudioService();
        MediaSessionService service = new MediaSessionService(audio);
        ActiveRecorder listener = new ActiveRecorder();
        service.addSessionsListener(listener, null, UserHandle.USER_ALL);

        Field listenersField = MediaSessionService.class.getDeclaredField("mListeners");
        listenersField.setAccessible(true);
        Object callbacksBox = listenersField.get(service);
        Field listField = callbacksBox.getClass().getDeclaredField("mList");
        listField.setAccessible(true);
        RemoteCallbackList<IActiveSessionsListener> rcl =
                (RemoteCallbackList<IActiveSessionsListener>) listField.get(callbacksBox);

        SessionCallbackStub cb = new SessionCallbackStub();
        ISession session = service.createSession("com.example.broadcast", cb, "b", null, 0);

        rcl.failBroadcastItem = new IllegalStateException("simulated getBroadcastItem failure");
        boolean threw = false;
        try {
            session.setActive(true);
        } catch (IllegalStateException expected) {
            threw = "simulated getBroadcastItem failure".equals(expected.getMessage());
        }
        check(threw, "injected getBroadcastItem runtime exception propagated");

        // If finishBroadcast() was balanced in finally, the next broadcast succeeds cleanly.
        session.setActive(false);
        session.setActive(true);
        check(listener.calls == 2 && listener.latest.size() == 1,
                "finishBroadcast() remained balanced after getBroadcastItem exception");
    }

    private static void measureZeroListenerSteadyState(boolean gate) throws Exception {
        AudioService audio = new AudioService();
        MediaSessionService service = new MediaSessionService(audio);
        SessionCallbackStub cb = new SessionCallbackStub();
        ISession owner = service.createSession("com.example.steady", cb, "steady", null, 0);
        MediaSessionService.Session session = unwrapSession(owner);
        MediaMetadata metadata = new MediaMetadata();
        PlaybackState state = new PlaybackState();

        com.sun.management.ThreadMXBean bean =
                (com.sun.management.ThreadMXBean) ManagementFactory.getThreadMXBean();
        if (!bean.isThreadAllocatedMemorySupported()) {
            throw new AssertionError("Thread allocation accounting unsupported");
        }
        bean.setThreadAllocatedMemoryEnabled(true);

        for (int i = 0; i < 500; i++) {
            session.setMetadata(metadata, 180_000L, "track");
            session.setPlaybackState(state);
            session.setActive(true);
        }

        final int iterations = 2000;
        long before = bean.getCurrentThreadAllocatedBytes();
        long startNs = System.nanoTime();
        for (int i = 0; i < iterations; i++) {
            session.setMetadata(metadata, 180_000L, "track");
            session.setPlaybackState(state);
            session.setActive(true);
        }
        long elapsedNs = System.nanoTime() - startNs;
        long allocated = bean.getCurrentThreadAllocatedBytes() - before;

        System.out.println("MediaSession zero-listener steady state: iterations=" + iterations
                + " allocated_bytes=" + allocated + " elapsed_ns=" + elapsedNs);
        if (gate) {
            check(allocated <= 4096,
                    "Zero-listener setMetadata/setPlaybackState/setActive allocated " + allocated + " bytes");
        }
    }

    public static void main(String[] args) throws Exception {
        boolean measureOnly = args.length > 0 && "--measure-only".equals(args[0]);
        if (measureOnly) {
            measureZeroListenerSteadyState(false);
            return;
        }
        testNullGuards();
        testDeadMediaKeyDispatchAndFailover();
        testDeadRemoteVolumeFailoverAndAudioFallback();
        testLiveSessionSurvivesTransactionFailure();
        testBroadcastFinallyBalance();
        measureZeroListenerSteadyState(true);
        System.out.println("MediaSessionHost all passed: " + checks + " checks");
        System.out.flush();
    }
}
