// FILE: android/media/AudioAttributes.java
package android.media;
public final class AudioAttributes {
    public static final int USAGE_MEDIA = 1;
    public static final int USAGE_VOICE_COMMUNICATION = 2;
    public static final int USAGE_ALARM = 4;
    public static final int USAGE_NOTIFICATION = 5;
    private final int mUsage;
    private AudioAttributes(int usage) { mUsage = usage; }
    public int getUsage() { return mUsage; }
    public static int toLegacyStreamType(AudioAttributes aa) {
        if (aa == null) return AudioSystem.STREAM_MUSIC;
        switch (aa.mUsage) {
            case USAGE_VOICE_COMMUNICATION: return AudioSystem.STREAM_VOICE_CALL;
            case USAGE_ALARM: return AudioSystem.STREAM_ALARM;
            case USAGE_NOTIFICATION: return AudioSystem.STREAM_NOTIFICATION;
            default: return AudioSystem.STREAM_MUSIC;
        }
    }
    public static final class Builder {
        private int mUsage = USAGE_MEDIA;
        public Builder setUsage(int usage) { mUsage = usage; return this; }
        public AudioAttributes build() { return new AudioAttributes(mUsage); }
    }
}

