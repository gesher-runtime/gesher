        @Override public void sendCustomAction(String packageName, String action, Bundle args)
                throws RemoteException {}
        @Override public void adjustVolume(String packageName, String opPackageName, int direction,
                int flags) throws RemoteException {}
        @Override public void setVolumeTo(String packageName, String opPackageName, int value,
                int flags) throws RemoteException {}
    }

    abstract class Stub extends Binder implements ISessionController {
        public static final String DESCRIPTOR = "android.media.session.ISessionController";
        @Override public IBinder asBinder() { return this; }
    }
}

