// FILE: android/os/RemoteCallbackList.java
package android.os;
import java.util.LinkedHashMap;
import java.util.Map;
public class RemoteCallbackList<E extends IInterface> {
    private final Map<IBinder, Entry> mCallbacks = new LinkedHashMap<>();
    private Object[] mActiveBroadcast;
    private int mBroadcastCount = -1;
    public RuntimeException failBroadcastItem;

    private final class Entry implements IBinder.DeathRecipient {
        final E callback;
        Entry(E callback) { this.callback = callback; }
        @Override public void binderDied() {
            synchronized (mCallbacks) { mCallbacks.remove(callback.asBinder()); }
            onCallbackDied(callback);
        }
    }

    public void onCallbackDied(E callback) {}

    public boolean register(E callback) {
        if (callback == null) throw new NullPointerException("callback");
        IBinder binder = callback.asBinder();
        synchronized (mCallbacks) {
            Entry entry = new Entry(callback);
            try {
                binder.linkToDeath(entry, 0);
            } catch (RemoteException e) {
                return false;
            }
            Entry previous = mCallbacks.put(binder, entry);
            if (previous != null) {
                try { binder.unlinkToDeath(previous, 0); } catch (RuntimeException ignored) {}
            }
            return true;
        }
    }

    public boolean unregister(E callback) {
        if (callback == null) return false;
        IBinder binder = callback.asBinder();
        synchronized (mCallbacks) {
            Entry entry = mCallbacks.remove(binder);
            if (entry != null) {
                try { binder.unlinkToDeath(entry, 0); } catch (RuntimeException ignored) {}
                return true;
            }
            return false;
        }
    }

    public int getRegisteredCallbackCount() {
        synchronized (mCallbacks) { return mCallbacks.size(); }
    }

    public int beginBroadcast() {
        synchronized (mCallbacks) {
            if (mBroadcastCount > 0 || mActiveBroadcast != null) {
                throw new IllegalStateException("beginBroadcast() called while already in a broadcast");
            }
            int count = mCallbacks.size();
            Object[] active = new Object[count];
            int i = 0;
            for (Entry entry : mCallbacks.values()) active[i++] = entry.callback;
            mActiveBroadcast = active;
            mBroadcastCount = count;
            return count;
        }
    }

    @SuppressWarnings("unchecked")
    public E getBroadcastItem(int index) {
        RuntimeException failure = failBroadcastItem;
        if (failure != null) {
            failBroadcastItem = null;
            throw failure;
        }
        return (E) mActiveBroadcast[index];
    }

    public void finishBroadcast() {
        synchronized (mCallbacks) {
            if (mBroadcastCount < 0 && mActiveBroadcast == null) {
                throw new IllegalStateException("finishBroadcast() called outside of a broadcast");
            }
            mActiveBroadcast = null;
            mBroadcastCount = -1;
        }
    }
}

// FILE: android/view/KeyEvent.java
package android.view;
public final class KeyEvent {
    public static final int ACTION_DOWN = 0;
    public static final int ACTION_UP = 1;
    public static final int KEYCODE_VOLUME_UP = 24;
    public static final int KEYCODE_VOLUME_DOWN = 25;
    public static final int KEYCODE_A = 29;
    public static final int KEYCODE_HEADSETHOOK = 79;
    public static final int KEYCODE_MEDIA_PLAY_PAUSE = 85;
    public static final int KEYCODE_MEDIA_STOP = 86;
    public static final int KEYCODE_MEDIA_NEXT = 87;
    public static final int KEYCODE_MEDIA_PREVIOUS = 88;
    public static final int KEYCODE_MEDIA_REWIND = 89;
    public static final int KEYCODE_MEDIA_FAST_FORWARD = 90;
    public static final int KEYCODE_MEDIA_PLAY = 126;
    public static final int KEYCODE_MEDIA_PAUSE = 127;
    public static final int KEYCODE_VOLUME_MUTE = 164;
    private final int mAction, mKeyCode;
    public KeyEvent(int action, int code) { mAction = action; mKeyCode = code; }
    public int getAction() { return mAction; }
    public int getKeyCode() { return mKeyCode; }
    public static boolean isMediaSessionKey(int keyCode) {
        switch (keyCode) {
            case KEYCODE_HEADSETHOOK:
            case KEYCODE_MEDIA_PLAY:
            case KEYCODE_MEDIA_PAUSE:
            case KEYCODE_MEDIA_PLAY_PAUSE:
            case KEYCODE_MEDIA_STOP:
            case KEYCODE_MEDIA_NEXT:
            case KEYCODE_MEDIA_PREVIOUS:
            case KEYCODE_MEDIA_REWIND:
            case KEYCODE_MEDIA_FAST_FORWARD:
                return true;
            default:
                return false;
        }
    }
}

// FILE: android/media/session/MediaSession.java
package android.media.session;
import java.util.Objects;
public final class MediaSession {
    public static final class Token {
        private final int mUid;
        private final ISessionController mBinder;
        public Token(int uid, ISessionController binder) { mUid = uid; mBinder = binder; }
        public int getUid() { return mUid; }
        public ISessionController getBinder() { return mBinder; }
        @Override public boolean equals(Object obj) {
            if (this == obj) return true;
            if (!(obj instanceof Token)) return false;
            Token other = (Token) obj;
            return mUid == other.mUid && Objects.equals(
                    mBinder != null ? mBinder.asBinder() : null,
                    other.mBinder != null ? other.mBinder.asBinder() : null);
        }
        @Override public int hashCode() {
            return Objects.hash(mUid, mBinder != null ? mBinder.asBinder() : null);
        }
    }
    public static final class QueueItem {}
}

