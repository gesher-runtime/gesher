// FILE: android/os/IBinder.java
package android.os;
public interface IBinder {
    int FIRST_CALL_TRANSACTION = 1;
    interface DeathRecipient {
        void binderDied();
    }
    void linkToDeath(DeathRecipient recipient, int flags) throws RemoteException;
    boolean unlinkToDeath(DeathRecipient recipient, int flags);
}

// FILE: android/os/Binder.java
package android.os;
import java.util.ArrayList;
import java.util.List;
import java.util.NoSuchElementException;
public class Binder implements IBinder {
    public static int sCallingPid = 1000;
    public static int sCallingUid = 10000;
    private final List<DeathRecipient> mDeaths = new ArrayList<>();
    private boolean mDead;
    public static int getCallingPid() { return sCallingPid; }
    public static int getCallingUid() { return sCallingUid; }
    public void attachInterface(IInterface owner, String descriptor) {}
    @Override
    public synchronized void linkToDeath(DeathRecipient recipient, int flags) throws RemoteException {
        if (mDead) throw new DeadObjectException("Binder already dead");
        mDeaths.add(recipient);
    }
    @Override
    public synchronized boolean unlinkToDeath(DeathRecipient recipient, int flags) {
        if (!mDeaths.remove(recipient)) throw new NoSuchElementException("DeathRecipient not linked");
        return true;
    }
    public synchronized boolean isDead() { return mDead; }
    public synchronized int deathRecipientCount() { return mDeaths.size(); }
    public synchronized void markDeadWithoutCallback() { mDead = true; }
    public void dieNow() {
        List<DeathRecipient> snapshot;
        synchronized (this) {
            mDead = true;
            snapshot = new ArrayList<>(mDeaths);
            mDeaths.clear();
        }
        for (DeathRecipient d : snapshot) d.binderDied();
    }
}

