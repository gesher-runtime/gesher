public interface ISession extends IInterface {
    ISessionController getController() throws RemoteException;
    void setFlags(int flags) throws RemoteException;
    void setActive(boolean active) throws RemoteException;
    void destroySession() throws RemoteException;
    void sendEvent(String event, Bundle data) throws RemoteException;
    void setLaunchPendingIntent(PendingIntent pi) throws RemoteException;
    void setMetadata(MediaMetadata metadata, long duration, String mediaDescription)
            throws RemoteException;
    void setPlaybackState(PlaybackState state) throws RemoteException;
    void resetQueue() throws RemoteException;
    IBinder getBinderForSetQueue() throws RemoteException;
    void setQueueTitle(CharSequence title) throws RemoteException;
    void setExtras(Bundle extras) throws RemoteException;
    void setRatingType(int type) throws RemoteException;
    void setPlaybackToLocal(AudioAttributes attributes) throws RemoteException;
    void setPlaybackToRemote(int control, int max, String controlId) throws RemoteException;
    void setCurrentVolume(int currentVolume) throws RemoteException;

    class Default implements ISession {
        @Override public IBinder asBinder() { return null; }
        @Override public ISessionController getController() throws RemoteException { return null; }
        @Override public void setFlags(int flags) throws RemoteException {}
        @Override public void setActive(boolean active) throws RemoteException {}
        @Override public void destroySession() throws RemoteException {}
        @Override public void sendEvent(String event, Bundle data) throws RemoteException {}
        @Override public void setLaunchPendingIntent(PendingIntent pi) throws RemoteException {}
        @Override public void setMetadata(MediaMetadata metadata, long duration,
                String mediaDescription) throws RemoteException {}
        @Override public void setPlaybackState(PlaybackState state) throws RemoteException {}
        @Override public void resetQueue() throws RemoteException {}
        @Override public IBinder getBinderForSetQueue() throws RemoteException { return null; }
        @Override public void setQueueTitle(CharSequence title) throws RemoteException {}
        @Override public void setExtras(Bundle extras) throws RemoteException {}
        @Override public void setRatingType(int type) throws RemoteException {}
        @Override public void setPlaybackToLocal(AudioAttributes attributes) throws RemoteException {}
        @Override public void setPlaybackToRemote(int control, int max, String controlId)
                throws RemoteException {}
        @Override public void setCurrentVolume(int currentVolume) throws RemoteException {}
    }

    abstract class Stub extends Binder implements ISession {
        public static final String DESCRIPTOR = "android.media.session.ISession";
        @Override public IBinder asBinder() { return this; }
    }
}

