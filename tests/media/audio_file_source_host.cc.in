// Positive valid-WAV tests: source API, pacing and FileSource are production.
#include <algorithm>
#include <array>
#include <chrono>
#include <cmath>
#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <string>
#include <thread>
#include <vector>

bool count_fill_copies = false;
size_t fill_copies = 0, fill_copy_bytes = 0;
void* FileSourceCopy(void* dst, const void* src, size_t bytes) {
  if (count_fill_copies) { ++fill_copies; fill_copy_bytes += bytes; }
  return std::memcpy(dst, src, bytes);
}

namespace gesher::media {
// The Win32 clock seam is covered by the dedicated clock-domain suite.
static int64_t MonotonicNs() {
  return std::chrono::duration_cast<std::chrono::nanoseconds>(
      std::chrono::steady_clock::now().time_since_epoch()).count();
}
@API@
@PACING@
@FILE@
class FileProbe final : public FileSource {
 public:
  using FileSource::Fill;
};
}  // namespace gesher::media

namespace {
size_t checks = 0, files = 0;
void Check(bool ok, const char* message) {
  ++checks;
  if (!ok) {
    std::fprintf(stderr, "audio file source check %zu failed: %s\n", checks, message);
    std::exit(1);
  }
}
void U16(std::vector<uint8_t>& out, uint32_t value) {
  out.push_back(static_cast<uint8_t>(value));
  out.push_back(static_cast<uint8_t>(value >> 8));
}
void U32(std::vector<uint8_t>& out, uint32_t value) {
  U16(out, value); U16(out, value >> 16);
}
void Tag(std::vector<uint8_t>& out, const char* tag) { out.insert(out.end(), tag, tag + 4); }
void Chunk(std::vector<uint8_t>& out, const char* tag, const std::vector<uint8_t>& bytes) {
  Tag(out, tag); U32(out, static_cast<uint32_t>(bytes.size()));
  out.insert(out.end(), bytes.begin(), bytes.end());
  if (bytes.size() & 1) out.push_back(0);  // RIFF pad is outside the chunk's size.
}

struct Format { uint32_t tag, bits; };
constexpr size_t kFrames = 17;
float Sample(Format format, size_t index, std::vector<uint8_t>* encoded) {
  // Integer samples and their normalization are independent of the production
  // byte decoder. Include both extrema, unit steps, zero and asymmetric values.
  constexpr std::array<int32_t, 9> s8{0, 1, 64, 127, 128, 129, 192, 254, 255};
  constexpr std::array<int32_t, 9> s16{-32768, -30001, -16384, -1, 0, 1, 12345, 16384, 32767};
  constexpr std::array<int32_t, 9> s24{-8388608, -7654321, -4194304, -1, 0, 1, 3456789, 4194304, 8388607};
  constexpr std::array<int32_t, 9> s32{INT32_MIN, -2000000001, -1073741824, -1, 0, 1, 715827883, 1073741824, INT32_MAX};
  constexpr std::array<float, 9> fp{-1.0f, -0.75f, -0x1p-25f, -0.0f, 0.0f, 0x1p-25f, 0.25f, 0.75f, 1.0f};
  index %= 9;
  if (format.tag == 3) {
    uint32_t bits;
    std::memcpy(&bits, &fp[index], sizeof(bits));
    U32(*encoded, bits);
    return fp[index];
  }
  const int32_t value = format.bits == 8 ? s8[index] : format.bits == 16 ? s16[index] :
                        format.bits == 24 ? s24[index] : s32[index];
  const uint32_t word = static_cast<uint32_t>(value);
  for (uint32_t byte = 0; byte < format.bits / 8; ++byte)
    encoded->push_back(static_cast<uint8_t>(word >> (byte * 8)));
  if (format.bits == 8) return static_cast<float>((value - 128) / 128.0);
  const double divisor = format.bits == 16 ? 32768.0 : format.bits == 24 ? 8388608.0 : 2147483648.0;
  return static_cast<float>(value / divisor);
}
bool Equal(float a, float b) { return std::memcmp(&a, &b, sizeof(a)) == 0; }

void Case(Format format, uint32_t channels, uint32_t rate, uint32_t format_size) {
  std::vector<uint8_t> data;
  std::vector<float> expected;
  for (size_t frame = 0; frame < kFrames; ++frame)
    for (uint32_t channel = 0; channel < channels; ++channel)
      expected.push_back(Sample(format, frame * 5 + channel * 2, &data));
  const bool extended = format_size == 40;
  std::vector<uint8_t> fmt;
  U16(fmt, extended ? 0xfffe : format.tag); U16(fmt, channels); U32(fmt, rate);
  const uint32_t block = channels * format.bits / 8;
  U32(fmt, rate * block); U16(fmt, block); U16(fmt, format.bits);
  if (format_size > 16) U16(fmt, extended ? 22 : 0);
  if (extended) {
    U16(fmt, format.bits);
    U32(fmt, channels == 1 ? 4 : channels == 2 ? 3 : channels == 3 ? 7 : 0x3f);
    U32(fmt, format.tag); U16(fmt, 0); U16(fmt, 0x10);
    for (uint8_t byte : {0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71}) fmt.push_back(byte);
  }
  Check(fmt.size() == format_size, "positive format fixture size");
  std::vector<uint8_t> wave;
  Tag(wave, "WAVE");
  Chunk(wave, "JUNK", {1, 2, 3});
  Chunk(wave, "fmt ", fmt);
  Chunk(wave, "JUNK", {4, 5, 6, 7, 8});
  if (format.tag == 3) {
    std::vector<uint8_t> fact;
    U32(fact, static_cast<uint32_t>(kFrames)); Chunk(wave, "fact", fact);
  }
  Chunk(wave, "data", data);
  Chunk(wave, "JUNK", {9});
  std::vector<uint8_t> riff;
  Tag(riff, "RIFF"); U32(riff, static_cast<uint32_t>(wave.size()));
  riff.insert(riff.end(), wave.begin(), wave.end());
  const std::string path = "positive-" + std::to_string(files++) + ".wav";
  FILE* output = std::fopen(path.c_str(), "wb");
  Check(output != nullptr, "open positive WAV");
  Check(std::fwrite(riff.data(), 1, riff.size(), output) == riff.size(), "write positive WAV");
  Check(std::fclose(output) == 0, "close positive WAV");

  gesher::media::FileProbe source;
  std::string error;
  Check(source.Load(path, &error) && error.empty(), "load supported normal/extensible WAV");
  Check(source.rate() == rate && source.channels() == channels, "preserve sample rate and channel count");
  Check(source.DeviceName() == "Gesher audio source", "file source device identity");
  Check(source.Describe().find(path) != std::string::npos && source.Describe().find("looping") != std::string::npos,
        "file source description");
  Check(source.Start(), "start file source");
  constexpr size_t wanted = kFrames * 3 + 5;
  std::vector<float> samples(wanted * channels + 2, 123.0f);
  source.Fill(samples.data() + 1, wanted);
  Check(samples.front() == 123.0f && samples.back() == 123.0f, "Fill writes exactly the requested samples");
  for (size_t at = 0; at < wanted * channels; ++at)
    Check(Equal(samples[at + 1], expected[at % expected.size()]), "interleaved conversion and loop sample");
  std::vector<float> continuation(7 * channels);
  source.Fill(continuation.data(), 7);
  for (size_t at = 0; at < continuation.size(); ++at)
    Check(Equal(continuation[at], expected[(wanted * channels + at) % expected.size()]), "consecutive Fill retains loop position");
  source.Stop();
  Check(source.Start(), "restart file source");
  source.Fill(continuation.data(), 7);
  for (size_t at = 0; at < continuation.size(); ++at)
    Check(Equal(continuation[at], expected[at]), "restart begins at first frame");
  const float sentinel = 321.0f;
  float untouched = sentinel;
  source.Fill(&untouched, 0);
  Check(Equal(untouched, sentinel), "zero-frame Fill preserves destination");
  Check(std::remove(path.c_str()) == 0, "Load releases its file handle");
}

void Measure(bool gate) {
  constexpr size_t frames = 48000, channels = 2;
  std::vector<uint8_t> wave;
  Tag(wave, "RIFF"); U32(wave, static_cast<uint32_t>(36 + frames * channels * 2)); Tag(wave, "WAVE");
  std::vector<uint8_t> fmt;
  U16(fmt, 1); U16(fmt, channels); U32(fmt, 48000); U32(fmt, 192000); U16(fmt, 4); U16(fmt, 16);
  Chunk(wave, "fmt ", fmt);
  std::vector<uint8_t> data;
  for (size_t sample = 0; sample < frames * channels; ++sample) U16(data, static_cast<uint16_t>(sample));
  Chunk(wave, "data", data);
  FILE* output = std::fopen("measure.wav", "wb");
  Check(output != nullptr, "create measured WAV");
  Check(std::fwrite(wave.data(), 1, wave.size(), output) == wave.size(), "write measured WAV");
  Check(std::fclose(output) == 0, "close measured WAV");
  gesher::media::FileProbe source;
  std::string error;
  Check(source.Load("measure.wav", &error) && source.Start(), "start measured file source");
  std::vector<float> samples(480 * channels);
  fill_copies = fill_copy_bytes = 0;
  for (size_t block = 0; block < 100; ++block) {
    count_fill_copies = true;
    source.Fill(samples.data(), 480);
    count_fill_copies = false;
    for (size_t i = 0; i < samples.size(); ++i) {
      const size_t at = (block * 480 * channels + i) % (frames * channels);
      Check(Equal(samples[i], static_cast<int16_t>(at) / 32768.0f), "measured source samples match integer oracle");
    }
  }
  Check(fill_copy_bytes == frames * channels * sizeof(float), "file Fill copies exactly one second of samples");
  if (gate) Check(fill_copies == 100, "one contiguous copy per nonwrapping source block");
  std::printf("File Fill: 100 stereo 480-frame blocks, %zu copies, %zu bytes\n", fill_copies, fill_copy_bytes);
  // End near the loop boundary and request a block crossing it.
  for (size_t block = 0; block < 99; ++block) source.Fill(samples.data(), 480);
  source.Fill(samples.data(), 470);
  fill_copies = 0;
  count_fill_copies = true;
  source.Fill(samples.data(), 480);
  count_fill_copies = false;
  if (gate) Check(fill_copies == 2, "wrapping source block needs two spans");
  for (size_t i = 0; i < samples.size(); ++i) {
    const size_t at = (47990 * channels + i) % (frames * channels);
    Check(Equal(samples[i], static_cast<int16_t>(at) / 32768.0f), "continuation after complete loop matches oracle");
  }
  Check(std::remove("measure.wav") == 0, "measured source closes file handle");
}
}  // namespace

int main(int argc, char** argv) {
  for (Format format : {Format{1, 8}, Format{1, 16}, Format{1, 24}, Format{1, 32}, Format{3, 32}})
    for (uint32_t channels : {1u, 2u, 3u, 6u})
      for (uint32_t rate : {8000u, 11025u, 44100u, 48000u, 96000u}) {
        if (format.tag == 1) Case(format, channels, rate, 16);
        Case(format, channels, rate, 18);
        Case(format, channels, rate, 40);
      }
  Measure(argc < 2 || std::strcmp(argv[1], "measure") != 0);
  std::printf("Audio file source valid WAV: %zu files, %zu checks PASS\n", files, checks);
}
