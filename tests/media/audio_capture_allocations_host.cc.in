// All CaptureStream methods and PCM conversion are real; Engine attachment alone is adapted.
#include <sys/types.h>
#include <algorithm>
#include <array>
#include <atomic>
#include <chrono>
#include <cmath>
#include <condition_variable>
#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <functional>
#include <memory>
#include <mutex>
#include <new>
#include <optional>
#include <string>
#include <thread>
#include <vector>

thread_local bool count_allocations = false;
thread_local size_t allocations = 0, allocated_bytes = 0;
thread_local bool count_read_copies = false;
thread_local size_t read_copies = 0, read_copy_bytes = 0;
void* CaptureReadCopy(void* dst, const void* src, size_t bytes) {
  if (count_read_copies) { ++read_copies; read_copy_bytes += bytes; }
  return std::memcpy(dst, src, bytes);
}
void* operator new(size_t size) {
  if (count_allocations) { ++allocations; allocated_bytes += size; }
  if (void* p = std::malloc(size ? size : 1)) return p;
  std::abort();
}
void* operator new[](size_t size) { return ::operator new(size); }
void operator delete(void* p) noexcept { std::free(p); }
void operator delete[](void* p) noexcept { std::free(p); }
void operator delete(void* p, size_t) noexcept { std::free(p); }
void operator delete[](void* p, size_t) noexcept { std::free(p); }
namespace gesher::media {
@TYPES@
@STATUSES@
}
@HEADER@
namespace gesher::media {
class CaptureEngine { public: int StartStream(CaptureStream*, uint64_t); void Wake() { ++wakes; } size_t wakes = 0; };
@BYTES@
@MEMBERS@
template<class Stream> int ActivateHostStream(Stream* stream, uint64_t generation) {
  if constexpr (requires { stream->Activate(generation); }) return stream->Activate(generation);
  else return kOk; // Older-source controls start directly and never call this boundary.
}
int CaptureEngine::StartStream(CaptureStream* stream, uint64_t generation) { ++wakes; return ActivateHostStream(stream, generation); }
@PCM@
}

namespace {
using namespace gesher::media;
size_t checks = 0, failures = 0;
CaptureEngine engine;
void Check(bool ok, const char* reason) {
  ++checks;
  if (!ok) { ++failures; if (failures < 12) std::fprintf(stderr, "FAIL audio capture: %s\n", reason); }
}
void Write(FILE* file, const void* data, size_t size) {
  // Empty vectors may return nullptr; a zero-length record has no bytes to write.
  if (size == 0) return;
  if (std::fwrite(data, 1, size, file) != size) std::abort();
}
template<class T> void Field(FILE* file, const T& value) { Write(file, &value, sizeof(value)); }
void Record(FILE* file, CaptureStream& stream) {
  Field(file, stream.written_); Field(file, stream.read_); Field(file, stream.overruns_);
  Field(file, stream.overrun_count_); Field(file, stream.was_overrun_); Field(file, stream.last_ns_);
  Field(file, stream.phase_); Field(file, stream.primed_); Field(file, stream.started_);
  Field(file, stream.released_); Field(file, stream.marker_reached_); Field(file, stream.next_update_);
  Write(file, stream.last_.data(), stream.last_.size() * sizeof(float));
  const size_t available = static_cast<size_t>(stream.written_ - stream.read_);
  Field(file, available);
  // Only unread bytes are observable; comparing the whole allocated ring would
  // repeatedly write stale storage after every drained block.
  for (size_t frame = 0; frame < available; ++frame) {
    size_t slot = static_cast<size_t>((stream.read_ + frame) % stream.params_.capacity_frames);
    Write(file, stream.ring_.data() + slot * stream.frame_size_, stream.frame_size_);
  }
}
std::vector<float> Input(size_t first, size_t frames, uint32_t channels) {
  std::vector<float> input(frames * channels);
  for (size_t frame = 0; frame < frames; ++frame)
    for (uint32_t c = 0; c < channels; ++c)
      input[frame * channels + c] = -0.75f + static_cast<float>(first + frame) / 4096.f + c / 64.f;
  return input;
}
double Decode(const uint8_t* bytes, PcmFormat format) {
  switch (format) {
    case PcmFormat::kU8: return (int(bytes[0]) - 128) / 127.0;
    case PcmFormat::kS16: { int16_t n; std::memcpy(&n, bytes, 2); return n / 32767.0; }
    case PcmFormat::kS24Packed: {
      uint32_t bits = bytes[0] | uint32_t{bytes[1]} << 8 | uint32_t{bytes[2]} << 16;
      int32_t n = bits & 0x800000u ? static_cast<int32_t>(bits | 0xff000000u) : static_cast<int32_t>(bits);
      return n / 8388607.0;
    }
    case PcmFormat::kS32: { int32_t n; std::memcpy(&n, bytes, 4); return n / 2147483647.0; }
    case PcmFormat::kFloat: { float n; std::memcpy(&n, bytes, 4); return n; }
  }
  std::abort();
}
double Tolerance(PcmFormat format) {
  return format == PcmFormat::kU8 ? 1.0 / 127 + 1e-6 : format == PcmFormat::kS16 ? 1.0 / 32767 + 1e-6 : 2e-6;
}

void Samples(PcmFormat format, uint32_t source_rate, uint32_t rate, uint32_t source_channels,
             uint32_t channels, FILE* file) {
  CaptureParams p;
  p.sample_rate = rate; p.channels = channels; p.format = format; p.capacity_frames = 16384;
  CaptureStream stream(&engine, p);
  std::vector<uint64_t> callbacks;
  stream.SetMarker(17);
  stream.SetUpdatePeriod(31);
  stream.SetEvents({
      [&](uint32_t n) { callbacks.push_back(0x100000000ull | n); Check(stream.Available() > 0, "marker callback outside stream mutex"); },
      [&](uint32_t n) { callbacks.push_back(0x200000000ull | n); Check(stream.frames_captured() >= n, "position callback outside stream mutex"); },
      [&] { callbacks.push_back(0x300000000ull); Check(stream.Available() > 0, "data callback outside stream mutex"); }});
  Check(stream.Start() == kOk, "capture starts");
  uint64_t captured = 0, emitted = 0, next_period = 31;
  size_t source_at = 0;
  bool marker = false;
  for (size_t frames : {size_t{0}, size_t{1}, size_t{2}, size_t{7}, size_t{31}, size_t{128}, size_t{3}, size_t{0}, size_t{17}}) {
    auto input = Input(source_at, frames, source_channels);
    callbacks.clear();
    int64_t timestamp = static_cast<int64_t>(100000 + source_at);
    stream.Push(input.data(), frames, source_rate, source_channels, timestamp);
    std::vector<uint64_t> expected_callbacks;
    uint64_t after = stream.frames_captured();
    if (!marker && captured < 17 && after >= 17) { marker = true; expected_callbacks.push_back(0x100000011ull); }
    while (after >= next_period) { expected_callbacks.push_back(0x200000000ull | next_period); next_period += 31; }
    if (after > captured) expected_callbacks.push_back(0x300000000ull);
    Check(callbacks == expected_callbacks, "marker, crossed periods and data callbacks preserve order");
    Field(file, callbacks.size());
    Write(file, callbacks.data(), callbacks.size() * sizeof(uint64_t));
    size_t available = stream.Available();
    std::vector<uint8_t> bytes(available * stream.frame_size());
    Check(stream.Read(bytes.data(), bytes.size(), false) == static_cast<ssize_t>(bytes.size()), "complete available frame read");
    for (size_t f = 0; f < available; ++f) {
      // A linear source ramp has a closed-form interpolation oracle, with the
      // initial source frame extending left through the resampler's first frame.
      double position = static_cast<double>(emitted + f) * source_rate / rate;
      double ramp = -0.75 + std::max(0.0, position - 1.0) / 4096.0;
      for (uint32_t c = 0; c < channels; ++c) {
        double source_channel = channels == 1 ? (source_channels - 1) / 2.0 : std::min(c, source_channels - 1) * 1.0;
        double expected = ramp + source_channel / 64.0;
        double actual = Decode(bytes.data() + (f * channels + c) * BytesPerSample(format), format);
        Check(std::abs(actual - expected) <= Tolerance(format), "PCM matches independent linear-ramp/channel oracle");
      }
    }
    emitted += available;
    captured = after;
    source_at += frames;
    Check(stream.frames_read() == emitted && after == emitted && stream.overrun_frames() == 0,
          "chunked resampling/read positions coherent without overrun");
    Field(file, bytes.size()); Write(file, bytes.data(), bytes.size()); Record(file, stream);
  }
  // Zero-length and zero-channel input must not change interpolation or callbacks.
  auto before = stream.stats();
  double phase = stream.phase_;
  stream.Push(nullptr, 0, source_rate, source_channels, 999999);
  stream.Push(nullptr, 10, source_rate, 0, 999999);
  Check(stream.stats().captured_frames == before.captured_frames && stream.phase_ == phase,
        "empty/zero-channel input is a state-preserving no-op");
}

void Boundaries(FILE* file) {
  CaptureParams p;
  p.sample_rate = 48000; p.channels = 2; p.capacity_frames = 7;
  CaptureStream stream(&engine, p);
  auto source = Input(0, 12, 2);
  stream.Push(source.data(), 12, 48000, 2, 1);
  Check(stream.Available() == 0, "stopped recorder ignores input");
  stream.Start();
  stream.Push(source.data(), 12, 48000, 2, 2);
  Check(stream.Available() == 7 && stream.overrun_frames() == 5 && stream.overrun_count() == 1,
        "overflow keeps first available frames and counts discarded input");
  std::array<uint8_t, 32> out{};
  Check(stream.Read(out.data(), 5, false) == 4 && stream.Available() == 6, "partial-byte read copies whole frames only");
  stream.Push(source.data(), 12, 48000, 2, 3);
  Check(stream.Available() == 7 && stream.overrun_frames() == 16 && stream.overrun_count() == 1,
        "continuing overflow counts frames without another transition");
  Check(stream.Read(out.data(), out.size(), false) == 28, "ring wrap read drains available frames");
  stream.Push(source.data(), 2, 48000, 2, 4);
  Check(stream.overrun_count() == 1 && !stream.was_overrun_, "room recovery leaves overflow state");
  stream.Push(source.data(), 12, 48000, 2, 5);
  Check(stream.overrun_count() == 2 && stream.Available() == 7, "later overflow starts another transition");
  Record(file, stream);
  stream.Stop();
  auto written = stream.frames_captured();
  stream.Push(source.data(), 12, 48000, 2, 6);
  Check(stream.frames_captured() == written, "stopped stream rejects further data");
  stream.Start();
  Check(stream.Available() == 0 && !stream.primed_ && stream.phase_ == 0, "restart drops queued frames and resets interpolation");
  stream.Push(source.data(), 2, 48000, 2, 7);
  Check(stream.Available() == 2, "restart accepts a fresh frame history");
  stream.Release();
  stream.Push(source.data(), 12, 48000, 2, 8);
  Check(stream.Start() == kInvalidOperation && stream.Available() == 2, "released stream refuses new input/start");
  Record(file, stream);

  CaptureStream callback_stream(&engine, p);
  bool notified = false;
  callback_stream.SetEvents({{}, {}, [&] { notified = true; callback_stream.Stop(); }});
  callback_stream.Start();
  callback_stream.Push(source.data(), 2, 48000, 2, 9);
  Check(notified && !callback_stream.started(), "callback may synchronously stop its stream");
}

void WrapAndFull(PcmFormat format, uint32_t channels, FILE* file) {
  CaptureParams p;
  p.format = format; p.channels = channels; p.capacity_frames = 5;
  CaptureStream stream(&engine, p);
  stream.Start();
  auto first = Input(0, 4, 2), second = Input(4, 3, 2);
  std::vector<uint8_t> bytes(5 * stream.frame_size());
  stream.Push(first.data(), 4, 48000, 2, 1);
  Check(stream.Read(bytes.data(), 3 * stream.frame_size(), false) == static_cast<ssize_t>(3 * stream.frame_size()),
        "odd-channel wrap setup drains three complete frames");
  stream.Push(second.data(), 3, 48000, 2, 2);
  Check(stream.Available() == 4 && stream.overrun_frames() == 0, "converted PCM wraps without losing frames");
  Record(file, stream);
  ssize_t got = stream.Read(bytes.data(), bytes.size(), false);
  Check(got == static_cast<ssize_t>(4 * stream.frame_size()), "wrapped PCM read returns all four frames");
  Field(file, got); Write(file, bytes.data(), static_cast<size_t>(got));
  auto fill = Input(7, 5, 2), discarded = Input(12, 3, 2);
  stream.Push(fill.data(), 5, 48000, 2, 3);
  auto ring = stream.ring_;
  stream.Push(discarded.data(), 3, 48000, 2, 4);
  Check(stream.ring_ == ring && stream.overrun_frames() == 3 && stream.Available() == 5,
        "zero-room conversion leaves ring bytes intact while advancing overrun state");
  Record(file, stream);
  stream.Read(bytes.data(), bytes.size(), false);
  // API capacity zero chooses a default at construction. Exercise a no-storage
  // boundary directly to prove that zero take cannot reach modulo-by-capacity.
  stream.params_.capacity_frames = 0;
  stream.ring_.clear();
  stream.Push(discarded.data(), 3, 48000, 2, 5);
  Check(stream.Available() == 0 && stream.overrun_frames() == 6, "zero take needs no storage or modulo");
  Record(file, stream);
}

// Independent QA: consume a wrapped publication in its callback, synchronously
// push another block, then release from the nested callback. Both invocations
// may reuse conversion scratch only after ring publication, and must invoke
// events outside the mutex with invocation-local callback storage.
void ReentrantReadAndPush(PcmFormat format, uint32_t channels, FILE* file) {
  CaptureParams p;
  p.format = format; p.channels = channels; p.capacity_frames = 5;
  CaptureStream stream(&engine, p);
  stream.Start();
  auto initial = Input(0, 4, 2), outer = Input(4, 2, 2), inner = Input(6, 3, 2);
  std::vector<uint8_t> bytes(5 * stream.frame_size());
  stream.Push(initial.data(), 4, 48000, 2, 1);
  Check(stream.Read(bytes.data(), 3 * stream.frame_size(), false) ==
            static_cast<ssize_t>(3 * stream.frame_size()), "reentrant wrapped-ring setup");
  std::vector<uint64_t> callbacks;
  bool nested = false;
  stream.SetMarker(6);
  stream.SetUpdatePeriod(2);
  stream.SetEvents({
      [&](uint32_t frame) { callbacks.push_back(0x100000000ull | frame); },
      [&](uint32_t frame) { callbacks.push_back(0x200000000ull | frame); },
      [&] {
        const bool inner_call = nested;
        callbacks.push_back(inner_call ? 0x300000002ull : 0x300000001ull);
        const ssize_t got = stream.Read(bytes.data(), bytes.size(), false);
        Check(got == static_cast<ssize_t>(3 * stream.frame_size()),
              "reentrant callback reads complete wrapped or nested frames");
        for (size_t frame = 0; frame < 3; ++frame) {
          const size_t source_frame = (inner_call ? 5 : 2) + frame;
          for (uint32_t c = 0; c < channels; ++c) {
            const double expected = -0.75 + source_frame / 4096.0 + std::min(c, 1u) / 64.0;
            const double actual = Decode(bytes.data() + (frame * channels + c) * BytesPerSample(format), format);
            Check(std::abs(actual - expected) <= Tolerance(format),
                  "reentrant publication matches independent ramp/channel coordinates");
          }
        }
        Field(file, got); Write(file, bytes.data(), static_cast<size_t>(got)); Record(file, stream);
        if (!inner_call) {
          nested = true;
          stream.Push(inner.data(), 3, 48000, 2, 3);
        } else {
          stream.Release();
        }
      }});
  stream.Push(outer.data(), 2, 48000, 2, 2);
  const std::vector<uint64_t> expected{0x100000006ull, 0x200000006ull, 0x300000001ull,
                                       0x200000008ull, 0x300000002ull};
  Check(callbacks == expected, "nested marker/period/data event order is preserved");
  Check(stream.frames_captured() == 9 && stream.frames_read() == 9 && stream.Available() == 0 &&
            stream.released_ && !stream.started(), "nested callback release preserves final stream positions");
  Field(file, callbacks.size()); Write(file, callbacks.data(), callbacks.size() * sizeof(uint64_t));
  Record(file, stream);
}

void Measure(uint32_t channels, uint32_t rate, bool gate) {
  CaptureParams p;
  p.channels = channels; p.sample_rate = rate; p.capacity_frames = 4096;
  CaptureStream stream(&engine, p);
  stream.Start();
  auto source = Input(0, 480, 2);
  std::vector<uint8_t> bytes(4096 * stream.frame_size());
  stream.Push(source.data(), 480, 48000, 2, 1);
  stream.Read(bytes.data(), bytes.size(), false);
  allocations = allocated_bytes = 0;
  auto begin = std::chrono::steady_clock::now();
  count_allocations = true;
  for (int i = 0; i < 100; ++i) {
    stream.Push(source.data(), 480, 48000, 2, 2 + i);
    stream.Read(bytes.data(), bytes.size(), false);
  }
  count_allocations = false;
  double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - begin).count();
  if (gate) Check(allocations == 0, "warmed capture Push/Read must not allocate without callbacks");
  std::printf("Capture Push 48k stereo -> %uHz %uch: 100 blocks, %zu allocations, %zu bytes, %.3f ms\n",
              rate, channels, allocations, allocated_bytes, ms);
}

template<class Stream> void ScratchBound(Stream& stream, bool released, bool gate) {
  if constexpr (requires { stream.converted_; }) {
    if (gate) Check(released ? stream.converted_.capacity() == 0
                            : stream.converted_.capacity() <= stream.capacity_frames() * stream.params().channels,
                    released ? "Release returns conversion scratch storage" : "conversion scratch exceeds ring capacity");
  }
}

void LargeBlockAndRateChanges(FILE* file, bool gate) {
  CaptureParams p;
  p.sample_rate = 44100; p.channels = 8; p.capacity_frames = 37;
  CaptureStream stream(&engine, p);
  stream.Start();
  auto source = Input(0, 8192, 2);
  std::vector<uint8_t> bytes(37 * stream.frame_size());
  for (uint32_t rate : {4000u, 48000u, 192000u, 44100u}) {
    stream.Push(source.data(), 8192, rate, 2, rate);
    Check(stream.Available() == 37 && stream.overrun_frames() > 0, "large source preserves ring limit and overflow accounting");
    ScratchBound(stream, false, gate);
    Record(file, stream);
    ssize_t got = stream.Read(bytes.data(), bytes.size(), false);
    Field(file, got); Write(file, bytes.data(), static_cast<size_t>(got));
  }
  stream.Stop(); stream.Start();
  stream.Push(source.data(), 8192, 48000, 2, 999);
  Record(file, stream);
  stream.Release();
  ScratchBound(stream, true, gate);
  Record(file, stream);
}

void ReadSpans(bool gate) {
  // The scalar oracle reads individual bytes. Include every start slot, partial
  // frames and unaligned destinations for all supported PCM storage widths.
  for (PcmFormat format : {PcmFormat::kU8, PcmFormat::kS16, PcmFormat::kS24Packed, PcmFormat::kS32, PcmFormat::kFloat}) {
    for (uint32_t channels : {1u, 2u, 3u, 8u}) {
      for (size_t cap = 1; cap <= 17; ++cap) {
        CaptureParams p;
        p.format = format; p.channels = channels; p.capacity_frames = cap;
        CaptureStream stream(&engine, p);
        for (size_t i = 0; i < stream.ring_.size(); ++i) stream.ring_[i] = static_cast<uint8_t>(i * 71 + 19);
        // Independent QA: the counter wraps modulo 2^64 before ring modulo.
        // Seed the rare boundary rather than requiring centuries of capture.
        for (uint64_t distance = 0; distance <= cap; ++distance) {
          const size_t frame = stream.frame_size();
          stream.read_ = UINT64_MAX - distance;
          stream.written_ = stream.read_ + cap;
          const uint64_t before = stream.read_;
          std::vector<uint8_t> actual(cap * frame + 2, 0xad), expected = actual;
          for (size_t byte = 0; byte < cap * frame; ++byte) {
            const uint64_t position = before + byte / frame;
            const size_t at = static_cast<size_t>(position % cap) * frame + byte % frame;
            expected[byte + 1] = stream.ring_[at];
          }
          Check(stream.Read(actual.data() + 1, cap * frame, false) == static_cast<ssize_t>(cap * frame),
                "counter-wrap read drains all available frames");
          Check(actual == expected && stream.read_ == before + cap,
                "counter-wrap read matches scalar unsigned-position oracle");
        }
        for (size_t slot = 0; slot < cap; ++slot) {
          for (size_t available = 0; available <= cap; ++available) {
            for (size_t requested : {size_t{0}, size_t{1}, cap / 2, cap, cap + 3}) {
              const size_t frame = stream.frame_size();
              stream.read_ = cap * 3 + slot;
              stream.written_ = stream.read_ + available;
              const uint64_t before = stream.read_;
              const size_t bytes = requested * frame + frame - 1;
              const size_t wanted = std::min(available, bytes / frame) * frame;
              std::vector<uint8_t> actual(bytes + 2, 0xad), expected = actual;
              for (size_t byte = 0; byte < wanted; ++byte) {
                const size_t at = ((slot + byte / frame) % cap) * frame + byte % frame;
                expected[byte + 1] = stream.ring_[at];
              }
              Check(stream.Read(actual.data() + 1, bytes, false) == static_cast<ssize_t>(wanted), "span read returns whole available frames");
              Check(actual == expected && stream.read_ == before + wanted / frame,
                    "span read equals independent byte oracle and preserves destination suffix");
            }
          }
        }
      }
    }
  }

  CaptureParams p;
  p.channels = 2; p.capacity_frames = 1024;
  CaptureStream stream(&engine, p);
  std::vector<uint8_t> out(480 * stream.frame_size());
  read_copies = read_copy_bytes = 0;
  for (size_t block = 0; block < 100; ++block) {
    stream.read_ = block * 480;
    stream.written_ = stream.read_ + 480;
    count_read_copies = true;
    const ssize_t got = stream.Read(out.data(), out.size(), false);
    count_read_copies = false;
    Check(got == static_cast<ssize_t>(out.size()), "measured read drains a 10ms stereo block");
  }
  Check(read_copy_bytes == 100 * out.size(), "span reads copy exactly the admitted bytes");
  if (gate) Check(read_copies <= 200, "at most two contiguous copies per available read block");
  std::printf("Capture Read: 100 stereo 480-frame blocks, %zu copies, %zu bytes\n", read_copies, read_copy_bytes);
}
}

int main(int argc, char** argv) {
  if (argc < 2) return 2;
  FILE* file = std::fopen(argv[1], "wb");
  if (file == nullptr) return 2;
  bool gate = argc < 3 || std::strcmp(argv[2], "measure") != 0;
  for (PcmFormat format : {PcmFormat::kU8, PcmFormat::kS16, PcmFormat::kS24Packed, PcmFormat::kS32, PcmFormat::kFloat})
    for (uint32_t src_rate : {4000u, 44100u, 48000u, 96000u})
      for (uint32_t rate : {8000u, 44100u, 48000u, 192000u})
        for (uint32_t src_channels : {1u, 2u, 8u})
          for (uint32_t channels : {1u, 2u, 3u, 5u, 8u}) Samples(format, src_rate, rate, src_channels, channels, file);
  Boundaries(file);
  for (PcmFormat format : {PcmFormat::kU8, PcmFormat::kS16, PcmFormat::kS24Packed, PcmFormat::kS32, PcmFormat::kFloat})
    for (uint32_t channels : {1u, 3u, 5u, 8u}) WrapAndFull(format, channels, file);
  for (PcmFormat format : {PcmFormat::kU8, PcmFormat::kS16, PcmFormat::kS24Packed, PcmFormat::kS32, PcmFormat::kFloat})
    for (uint32_t channels : {3u, 5u}) ReentrantReadAndPush(format, channels, file);
  for (uint32_t channels : {1u, 2u, 8u})
    for (uint32_t rate : {44100u, 48000u}) Measure(channels, rate, gate);
  LargeBlockAndRateChanges(file, gate);
  ReadSpans(gate);
  std::fclose(file);
  std::printf("Audio capture: %zu checks, %zu failures\n", checks, failures);
  return failures != 0;
}
