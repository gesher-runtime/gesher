// Host contracts for com.gesher.server.CredentialManagerService (docs/passkeys.md, ADR 0092).
// The production PasskeyJson, PasskeyBackend, PasskeyRequests, AssetLinks and
// CredentialManagerService are inserted unchanged apart from their package, imports and
// public class visibility. Everything else is a boundary stand-in with
// android-16.0.0_r4's and androidx.credentials' constant values, written out again here
// rather than taken from the production classes.
//
// TestAuthenticator is an isolated test double of Windows' WebAuthn API: a software
// authenticator with real keys, so that the responses the service builds are verified
// cryptographically. Production has one backend, WindowsWebAuthn, and no fake.
// The asset links come from a local HTTP server through the production fetcher.
import com.sun.net.httpserver.HttpServer;

import java.io.ByteArrayOutputStream;
import java.io.IOException;
import java.io.InputStream;
import java.net.HttpURLConnection;
import java.net.InetSocketAddress;
import java.net.URI;
import java.net.URL;
import java.nio.charset.StandardCharsets;
import java.security.KeyFactory;
import java.security.KeyPair;
import java.security.KeyPairGenerator;
import java.security.MessageDigest;
import java.security.NoSuchAlgorithmException;
import java.security.PublicKey;
import java.security.SecureRandom;
import java.security.interfaces.ECPublicKey;
import java.security.interfaces.RSAPublicKey;
import java.security.spec.ECGenParameterSpec;
import java.security.spec.X509EncodedKeySpec;
import java.util.*;
import java.util.concurrent.ConcurrentHashMap;
import java.util.concurrent.CountDownLatch;
import java.util.concurrent.TimeUnit;
import java.util.concurrent.atomic.AtomicInteger;

public final class CredentialManagerContracts {
    private static int failures, checks;

    static void check(boolean condition, String description) {
        checks++;
        System.out.println((condition ? "PASS " : "FAIL ") + description);
        if (!condition) failures++;
    }

    static boolean throwsType(Class<? extends RuntimeException> type, String fragment, Runnable call) {
        try {
            call.run();
            return false;
        } catch (RuntimeException thrown) {
            return type.isInstance(thrown)
                    && (fragment == null || String.valueOf(thrown.getMessage()).contains(fragment));
        }
    }

    // --- constants written out independently of the production classes ---------------------

    static final String PUBLIC_KEY = "androidx.credentials.TYPE_PUBLIC_KEY_CREDENTIAL";
    static final String PASSWORD = "android.credentials.TYPE_PASSWORD_CREDENTIAL";
    static final String REQUEST_JSON = "androidx.credentials.BUNDLE_KEY_REQUEST_JSON";
    static final String REGISTRATION_JSON = "androidx.credentials.BUNDLE_KEY_REGISTRATION_RESPONSE_JSON";
    static final String AUTHENTICATION_JSON = "androidx.credentials.BUNDLE_KEY_AUTHENTICATION_RESPONSE_JSON";
    static final String CREATE_DOM = "androidx.credentials.TYPE_CREATE_PUBLIC_KEY_CREDENTIAL_DOM_EXCEPTION/";
    static final String GET_DOM = "androidx.credentials.TYPE_GET_PUBLIC_KEY_CREDENTIAL_DOM_EXCEPTION/";
    static final String CREATE_NO_OPTIONS = "android.credentials.CreateCredentialException.TYPE_NO_CREATE_OPTIONS";
    static final String CREATE_CANCELED = "android.credentials.CreateCredentialException.TYPE_USER_CANCELED";
    static final String CREATE_UNKNOWN = "android.credentials.CreateCredentialException.TYPE_UNKNOWN";
    static final String GET_NO_CREDENTIAL = "android.credentials.GetCredentialException.TYPE_NO_CREDENTIAL";
    static final String GET_CANCELED = "android.credentials.GetCredentialException.TYPE_USER_CANCELED";
    static final String GET_UNKNOWN = "android.credentials.GetCredentialException.TYPE_UNKNOWN";

    static final int NTE_EXISTS = 0x8009000F, NTE_NOT_FOUND = 0x80090011, NTE_INVALID_PARAMETER = 0x80090027,
            NTE_NOT_SUPPORTED = 0x80090029, NTE_DEVICE_NOT_FOUND = 0x80090030, NTE_USER_CANCELLED = 0x80090036,
            E_CANCELLED = 0x800704C7, E_TIMEOUT = 0x800705B4, E_FAIL = 0x80004005;

    /** WebAuthNGetErrorName's table, from webauthn.h's comment on it. */
    static String windowsErrorName(int hr) {
        switch (hr) {
            case 0: return "Success";
            case NTE_EXISTS: return "InvalidStateError";
            case NTE_NOT_SUPPORTED: case 0x80070032: case 0x80090023: return "ConstraintError";
            case NTE_INVALID_PARAMETER: return "NotSupportedError";
            case NTE_DEVICE_NOT_FOUND: case NTE_NOT_FOUND: case E_CANCELLED: case NTE_USER_CANCELLED:
            case E_TIMEOUT: return "NotAllowedError";
            default: return "UnknownError";
        }
    }

    static byte[] sha256(byte[] data) {
        try {
            return MessageDigest.getInstance("SHA-256").digest(data);
        } catch (NoSuchAlgorithmException e) {
            throw new AssertionError(e);
        }
    }

    static String b64(byte[] data) {
        return Base64.getUrlEncoder().withoutPadding().encodeToString(data);
    }

    static byte[] unb64(Object text) {
        return Base64.getUrlDecoder().decode((String) text);
    }

    // --- the system server boundary --------------------------------------------------------

    static final String BANK = "com.example.bank", SHOP = "com.example.shop";
    static final int BANK_UID = 10123, BANK_PID = 4321, SHOP_UID = 10124, SHOP_PID = 4400;
    static final byte[] BANK_CERT = "bank signing certificate (DER stand-in)".getBytes(StandardCharsets.UTF_8);
    static final byte[] SHOP_CERT = "shop signing certificate (DER stand-in)".getBytes(StandardCharsets.UTF_8);

    static final class TestHost implements CredentialManagerService.Host {
        int uid = BANK_UID, pid = BANK_PID;
        final Set<String> granted = new HashSet<>();
        final Map<String, Integer> uids = new HashMap<>(Map.of(BANK, BANK_UID, SHOP, SHOP_UID));
        final Map<String, byte[][]> certificates = new HashMap<>();
        boolean threads;
        final ArrayDeque<Runnable> queue = new ArrayDeque<>();
        final List<Thread> started = new ArrayList<>();
        TestHost() {
            certificates.put(BANK, new byte[][] {BANK_CERT});
            certificates.put(SHOP, new byte[][] {SHOP_CERT});
        }
        public int callingUid() { return uid; }
        public int callingPid() { return pid; }
        public int packageUid(String packageName) { return uids.getOrDefault(packageName, -1); }
        public boolean hasPermission(String permission, int p, int u) {
            return p == pid && u == uid && granted.contains(permission);
        }
        public byte[][] signingCertificates(String packageName) { return certificates.get(packageName); }
        public synchronized void execute(Runnable ceremony) {
            if (!threads) {
                queue.add(ceremony);
                return;
            }
            Thread thread = new Thread(ceremony, "ceremony-" + started.size());
            thread.setDaemon(true);
            started.add(thread);
            thread.start();
        }
        void drain() {
            for (Runnable r; (r = poll()) != null; ) r.run();
        }
        synchronized Runnable poll() { return queue.poll(); }
        void join() throws InterruptedException {
            List<Thread> all;
            synchronized (this) { all = new ArrayList<>(started); }
            for (Thread thread : all) thread.join(10_000);
        }
    }

    // --- an isolated software authenticator behind PasskeyBackend ---------------------------

    static final class StoredCredential {
        byte[] id, userId;
        String rpId;
        KeyPair keys;
        int algorithm;
        int counter;
    }

    static final class TestAuthenticator implements PasskeyBackend {
        int apiVersion = 9;
        boolean cancellable = true;
        /** Scripted failure for the next ceremonies: 0 runs the authenticator. */
        int failWith;
        boolean notForeground;
        boolean returnNull;
        /** Transports/resident-key reporting of older Windows versions when false. */
        boolean reportsDetails = true;
        int usedTransport = TRANSPORT_INTERNAL;
        byte[] corruptAuthenticatorData;
        /** When set, a ceremony blocks until canceled (then answers as Windows does) or released. */
        volatile CountDownLatch entered, release;
        final List<StoredCredential> credentials = new ArrayList<>();
        final List<MakeCredential> makes = Collections.synchronizedList(new ArrayList<>());
        final List<GetAssertion> gets = Collections.synchronizedList(new ArrayList<>());
        final AtomicInteger cancellations = new AtomicInteger(), cancels = new AtomicInteger();
        final SecureRandom random = new SecureRandom();

        final class Token implements Cancellation {
            final CountDownLatch canceled = new CountDownLatch(1);
            public void cancel() {
                cancels.incrementAndGet();
                canceled.countDown();
            }
        }

        public int apiVersion() { return apiVersion; }

        public Cancellation newCancellation() {
            cancellations.incrementAndGet();
            return cancellable ? new Token() : null;
        }

        /** Whether the ceremony was canceled while Windows' dialog was up. */
        private boolean waitForUser(Cancellation cancellation) {
            CountDownLatch enter = entered, go = release;
            if (go == null) return false;
            if (enter != null) enter.countDown();
            try {
                Token token = (Token) cancellation;
                long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(10);
                while (System.nanoTime() < deadline) {
                    if (token != null && token.canceled.await(2, TimeUnit.MILLISECONDS)) return true;
                    if (go.await(2, TimeUnit.MILLISECONDS)) return false;
                }
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
            }
            return false;
        }

        private boolean fail(Outcome outcome, Cancellation cancellation) {
            if (notForeground) {
                outcome.notForeground = true;
                return true;
            }
            int hr = failWith;
            if (waitForUser(cancellation)) hr = NTE_USER_CANCELLED;
            if (hr == 0) return false;
            outcome.hresult = hr;
            outcome.errorName = windowsErrorName(hr);
            return true;
        }

        public Attestation makeCredential(MakeCredential request, Cancellation cancellation) {
            makes.add(request);
            if (returnNull) return null;
            Attestation out = new Attestation();
            if (fail(out, cancellation)) return out;
            try {
                StoredCredential stored = new StoredCredential();
                stored.rpId = request.rpId;
                stored.userId = request.userId;
                stored.id = new byte[32];
                random.nextBytes(stored.id);
                byte[] cose = null;
                for (int algorithm : request.algorithms) {
                    if (algorithm == -7) {
                        KeyPairGenerator generator = KeyPairGenerator.getInstance("EC");
                        generator.initialize(new ECGenParameterSpec("secp256r1"));
                        stored.keys = generator.generateKeyPair();
                        ECPublicKey key = (ECPublicKey) stored.keys.getPublic();
                        cose = Cbor.map(Cbor.integer(1), Cbor.integer(2), Cbor.integer(3), Cbor.integer(-7),
                                Cbor.integer(-1), Cbor.integer(1),
                                Cbor.integer(-2), Cbor.bytes(fixed(key.getW().getAffineX().toByteArray(), 32)),
                                Cbor.integer(-3), Cbor.bytes(fixed(key.getW().getAffineY().toByteArray(), 32)));
                    } else if (algorithm == -257) {
                        KeyPairGenerator generator = KeyPairGenerator.getInstance("RSA");
                        generator.initialize(2048);
                        stored.keys = generator.generateKeyPair();
                        RSAPublicKey key = (RSAPublicKey) stored.keys.getPublic();
                        cose = Cbor.map(Cbor.integer(1), Cbor.integer(3), Cbor.integer(3), Cbor.integer(-257),
                                Cbor.integer(-1), Cbor.bytes(fixed(key.getModulus().toByteArray(), 256)),
                                Cbor.integer(-2), Cbor.bytes(key.getPublicExponent().toByteArray()));
                    } else if (algorithm == -8) {
                        // A key type the service does not encode as SubjectPublicKeyInfo (OKP).
                        stored.keys = null;
                        cose = Cbor.map(Cbor.integer(1), Cbor.integer(1), Cbor.integer(3), Cbor.integer(-8),
                                Cbor.integer(-1), Cbor.integer(6), Cbor.integer(-2), Cbor.bytes(new byte[32]));
                    } else {
                        continue;
                    }
                    stored.algorithm = algorithm;
                    break;
                }
                if (cose == null) {
                    out.hresult = NTE_NOT_SUPPORTED;
                    out.errorName = windowsErrorName(out.hresult);
                    return out;
                }
                credentials.add(stored);
                ByteArrayOutputStream data = new ByteArrayOutputStream();
                data.write(sha256(request.rpId.getBytes(StandardCharsets.UTF_8)));
                data.write(0x45);  // UP | UV | AT
                data.write(new byte[] {0, 0, 0, 0});
                data.write(new byte[16]);  // aaguid
                data.write(new byte[] {0, (byte) stored.id.length});
                data.write(stored.id);
                data.write(cose);
                out.authenticatorData = corruptAuthenticatorData != null ? corruptAuthenticatorData
                        : data.toByteArray();
                out.credentialId = stored.id;
                out.attestationObject = Cbor.map(Cbor.text("fmt"), Cbor.text("none"),
                        Cbor.text("attStmt"), Cbor.map(), Cbor.text("authData"), Cbor.bytes(out.authenticatorData));
                out.usedTransport = usedTransport;
                if (reportsDetails) {
                    out.transports = TRANSPORT_INTERNAL | TRANSPORT_HYBRID;
                    out.residentKey = request.residentKey == RESIDENT_KEY_DISCOURAGED ? 0 : 1;
                }
                out.hresult = S_OK;
                return out;
            } catch (Exception e) {
                throw new AssertionError(e);
            }
        }

        public Assertion getAssertion(GetAssertion request, Cancellation cancellation) {
            gets.add(request);
            if (returnNull) return null;
            Assertion out = new Assertion();
            if (fail(out, cancellation)) return out;
            StoredCredential found = null;
            for (StoredCredential stored : credentials) {
                if (!stored.rpId.equals(request.rpId)) continue;
                boolean allowed = request.allow.length == 0;
                for (Descriptor descriptor : request.allow) allowed |= Arrays.equals(descriptor.id, stored.id);
                if (allowed) found = stored;
            }
            if (found == null) {
                out.hresult = NTE_NOT_FOUND;
                out.errorName = windowsErrorName(out.hresult);
                return out;
            }
            try {
                ByteArrayOutputStream data = new ByteArrayOutputStream();
                data.write(sha256(request.rpId.getBytes(StandardCharsets.UTF_8)));
                data.write(0x05);  // UP | UV
                data.write(new byte[] {0, 0, 0, (byte) ++found.counter});
                out.authenticatorData = data.toByteArray();
                java.security.Signature signer = java.security.Signature.getInstance(
                        found.algorithm == -7 ? "SHA256withECDSA" : "SHA256withRSA");
                signer.initSign(found.keys.getPrivate());
                signer.update(out.authenticatorData);
                signer.update(sha256(request.clientDataJson));  // as Windows hashes pbClientDataJSON
                out.signature = signer.sign();
                out.credentialId = found.id;
                out.userId = found.userId;
                out.usedTransport = usedTransport;
                out.hresult = S_OK;
                return out;
            } catch (Exception e) {
                throw new AssertionError(e);
            }
        }

        static byte[] fixed(byte[] big, int length) {
            byte[] out = new byte[length];
            int count = Math.min(big.length, length);
            System.arraycopy(big, big.length - count, out, length - count, count);
            return out;
        }
    }

    /** A CBOR writer for the test authenticator. */
    static final class Cbor {
        static byte[] head(int major, long value) {
            ByteArrayOutputStream out = new ByteArrayOutputStream();
            if (value < 24) {
                out.write(major << 5 | (int) value);
            } else if (value < 0x100) {
                out.write(major << 5 | 24);
                out.write((int) value);
            } else {
                out.write(major << 5 | 25);
                out.write((int) (value >> 8));
                out.write((int) value);
            }
            return out.toByteArray();
        }
        static byte[] join(byte[]... parts) {
            ByteArrayOutputStream out = new ByteArrayOutputStream();
            for (byte[] part : parts) out.write(part, 0, part.length);
            return out.toByteArray();
        }
        static byte[] integer(long value) { return value >= 0 ? head(0, value) : head(1, -1 - value); }
        static byte[] bytes(byte[] value) { return join(head(2, value.length), value); }
        static byte[] text(String value) {
            byte[] utf8 = value.getBytes(StandardCharsets.UTF_8);
            return join(head(3, utf8.length), utf8);
        }
        static byte[] map(byte[]... keysAndValues) {
            return join(head(5, keysAndValues.length / 2), join(keysAndValues));
        }
    }

    // --- a local server for asset links, reached through the production fetcher ------------

    static HttpServer server;
    static final Map<String, Object[]> sites = new ConcurrentHashMap<>();  // host -> {status, type, body, location}
    static final List<String> fetchedUrls = Collections.synchronizedList(new ArrayList<>());
    static final AtomicInteger served = new AtomicInteger();

    static void site(String host, int status, String type, String body) {
        sites.put(host, new Object[] {status, type, body, null});
    }

    static String statement(String packageName, byte[] certificate, String... relations) {
        StringBuilder hex = new StringBuilder();
        for (byte b : sha256(certificate)) {
            if (hex.length() > 0) hex.append(':');
            hex.append(String.format("%02X", b));
        }
        return "{\"relation\":[\"" + String.join("\",\"", relations) + "\"],\"target\":{\"namespace\":\"android_app\","
                + "\"package_name\":\"" + packageName + "\",\"sha256_cert_fingerprints\":[\"" + hex + "\"]}}";
    }

    static final String LOGIN = "delegate_permission/common.get_login_creds";
    static final String URLS = "delegate_permission/common.handle_all_urls";

    static AssetLinks.Fetcher fetcher;

    static void startServer() throws IOException {
        server = HttpServer.create(new InetSocketAddress("127.0.0.1", 0), 0);
        server.createContext("/", exchange -> {
            served.incrementAndGet();
            String[] parts = exchange.getRequestURI().getPath().split("/", 3);  // "", host, rest
            Object[] site = parts.length == 3 && parts[2].equals(".well-known/assetlinks.json")
                    ? sites.get(parts[1]) : null;
            if (site == null) {
                exchange.sendResponseHeaders(404, -1);
                exchange.close();
                return;
            }
            byte[] body = ((String) site[2]).getBytes(StandardCharsets.UTF_8);
            if (site[1] != null) exchange.getResponseHeaders().add("Content-Type", (String) site[1]);
            if (site[3] != null) exchange.getResponseHeaders().add("Location", (String) site[3]);
            exchange.sendResponseHeaders((Integer) site[0], body.length == 0 ? -1 : body.length);
            if (body.length > 0) exchange.getResponseBody().write(body);
            exchange.close();
        });
        server.start();
        int port = server.getAddress().getPort();
        // The production fetcher asks for https://<host>/.well-known/assetlinks.json. This
        // connector records that URL and serves it from the local server (plain HTTP: TLS
        // and the Windows trust store are not exercised on a host JVM).
        fetcher = new AssetLinks.Https(url -> {
            fetchedUrls.add(url.toString());
            return (HttpURLConnection) URI.create("http://127.0.0.1:" + port + "/" + url.getHost()
                    + url.getPath()).toURL().openConnection();
        });
    }

    // --- callbacks -------------------------------------------------------------------------

    static class Client implements IBinder {
        final List<String> calls = Collections.synchronizedList(new ArrayList<>());
        IBinder.DeathRecipient recipient;
        boolean dead;
        int links, unlinks;
        volatile String errorType, errorMessage;
        final CountDownLatch done = new CountDownLatch(1);
        public synchronized void linkToDeath(IBinder.DeathRecipient r, int flags) throws RemoteException {
            if (dead) throw new RemoteException();
            links++;
            recipient = r;
        }
        public synchronized boolean unlinkToDeath(IBinder.DeathRecipient r, int flags) {
            unlinks++;
            boolean was = recipient == r;
            recipient = null;
            return was;
        }
        void die() {
            IBinder.DeathRecipient r;
            synchronized (this) {
                dead = true;
                r = recipient;
            }
            if (r != null) r.binderDied();
        }
        void error(String type, String message) {
            errorType = type;
            errorMessage = message;
            calls.add("error:" + type);
            done.countDown();
        }
    }

    static final class GetClient extends Client implements IGetCredentialCallback {
        volatile GetCredentialResponse response;
        public void onResponse(GetCredentialResponse r) {
            response = r;
            calls.add("response");
            done.countDown();
        }
        public void onError(String type, String message) { error(type, message); }
        public IBinder asBinder() { return this; }
        String json() { return response.getCredential().getData().getString(AUTHENTICATION_JSON); }
    }

    static final class CreateClient extends Client implements ICreateCredentialCallback {
        volatile CreateCredentialResponse response;
        public void onResponse(CreateCredentialResponse r) {
            response = r;
            calls.add("response");
            done.countDown();
        }
        public void onError(String type, String message) { error(type, message); }
        public IBinder asBinder() { return this; }
        String json() { return response.getData().getString(REGISTRATION_JSON); }
    }

    // --- requests --------------------------------------------------------------------------

    static final byte[] CHALLENGE = "a server challenge of 32 bytes!!".getBytes(StandardCharsets.UTF_8);
    static final byte[] USER_ID = {1, 2, 3, 4, 5, 6, 7, 8};

    static String creationJson(String rpId, String extra) {
        return "{\"rp\":{\"id\":\"" + rpId + "\",\"name\":\"Example Bank\"},"
                + "\"user\":{\"id\":\"" + b64(USER_ID) + "\",\"name\":\"dana@example.com\",\"displayName\":\"Dana\"},"
                + "\"challenge\":\"" + b64(CHALLENGE) + "\","
                + "\"pubKeyCredParams\":[{\"type\":\"public-key\",\"alg\":-7},{\"type\":\"public-key\",\"alg\":-257}]"
                + (extra == null ? "" : "," + extra) + "}";
    }

    static String requestJson(String rpId, String extra) {
        return "{\"challenge\":\"" + b64(CHALLENGE) + "\",\"rpId\":\"" + rpId + "\""
                + (extra == null ? "" : "," + extra) + "}";
    }

    static CreateCredentialRequest createRequest(String type, String json) {
        Bundle data = new Bundle();
        if (json != null) data.putString(REQUEST_JSON, json);
        return new CreateCredentialRequest(type, data, null);
    }

    static GetCredentialRequest getRequest(String type, String json) {
        Bundle data = new Bundle();
        if (json != null) data.putString(REQUEST_JSON, json);
        return new GetCredentialRequest(List.of(new CredentialOption(type, data, null)), null);
    }

    static TestHost host;
    static TestAuthenticator authenticator;
    static CredentialManagerService service;

    static void fresh(boolean withBackend) {
        host = new TestHost();
        authenticator = withBackend ? new TestAuthenticator() : null;
        service = new CredentialManagerService(host, authenticator, fetcher);
        sites.clear();
        fetchedUrls.clear();
        site("bank.example", 200, "application/json", "[" + statement(BANK, BANK_CERT, URLS, LOGIN) + "]");
    }

    static CreateClient create(String json) {
        CreateClient client = new CreateClient();
        service.executeCreateCredential(createRequest(PUBLIC_KEY, json), client, BANK);
        host.drain();
        return client;
    }

    static GetClient get(String json) {
        GetClient client = new GetClient();
        service.executeGetCredential(getRequest(PUBLIC_KEY, json), client, BANK);
        host.drain();
        return client;
    }

    static Map<String, Object> parsed(String json) {
        return PasskeyJson.parseObject(json);
    }

    @SuppressWarnings("unchecked")
    static Map<String, Object> member(Map<String, Object> object, String name) {
        return (Map<String, Object>) object.get(name);
    }

    // --- no Windows WebAuthn: AOSP's answers for a device without a provider ----------------

    static void unavailable() {
        for (int mode = 0; mode < 2; mode++) {
            fresh(mode == 1);
            String name = mode == 0 ? "no natives" : "no webauthn.dll (API version 0)";
            if (authenticator != null) authenticator.apiVersion = 0;
            CreateClient created = new CreateClient();
            ICancellationSignal transport = service.executeCreateCredential(
                    createRequest(PUBLIC_KEY, creationJson("bank.example", null)), created, BANK);
            host.drain();
            check(transport != null && CREATE_NO_OPTIONS.equals(created.errorType)
                    && "No create options available.".equals(created.errorMessage) && created.calls.size() == 1,
                    name + ": createCredential is TYPE_NO_CREATE_OPTIONS, AOSP's answer without a provider");
            GetClient got = new GetClient();
            transport = service.executeGetCredential(
                    getRequest(PUBLIC_KEY, requestJson("bank.example", null)), got, BANK);
            host.drain();
            check(transport != null && GET_NO_CREDENTIAL.equals(got.errorType)
                    && "No credentials available on this device.".equals(got.errorMessage) && got.calls.size() == 1,
                    name + ": getCredential is TYPE_NO_CREDENTIAL, AOSP's answer without a provider");
            check(fetchedUrls.isEmpty() && (authenticator == null || authenticator.makes.isEmpty()
                    && authenticator.gets.isEmpty() && authenticator.cancellations.get() == 0),
                    name + ": nothing is fetched and no ceremony is attempted");
            List<String> cleared = new ArrayList<>();
            service.clearCredentialState(new ClearCredentialStateRequest(), new IClearCredentialStateCallback() {
                public void onSuccess() { cleared.add("success"); }
                public void onError(String type, String message) { cleared.add(type + ":" + message); }
            }, BANK);
            check(cleared.equals(List.of("UNKNOWN:No credentials available on this device")),
                    name + ": clearCredentialState is AOSP's no-provider error");
            check(service.isServiceEnabled(), name + ": isServiceEnabled stays DeviceConfig's default, true");
        }
    }

    // --- caller identity and permissions, before anything else -----------------------------

    static void identity() {
        fresh(true);
        CreateClient created = new CreateClient();
        GetClient got = new GetClient();
        String creation = creationJson("bank.example", null), request = requestJson("bank.example", null);
        check(throwsType(SecurityException.class, SHOP + " does not belong to uid " + BANK_UID,
                () -> service.executeCreateCredential(createRequest(PUBLIC_KEY, creation), created, SHOP)),
                "create: another package's name is a SecurityException (enforceCallingPackage)");
        check(throwsType(SecurityException.class, "com.example.absent not found",
                () -> service.executeGetCredential(getRequest(PUBLIC_KEY, request), got, "com.example.absent")),
                "get: an unknown package is a SecurityException");
        check(throwsType(SecurityException.class, "null not found",
                () -> service.executeGetCredential(getRequest(PUBLIC_KEY, request), got, null)),
                "get: a null package is a SecurityException");

        CreateCredentialRequest withOrigin = new CreateCredentialRequest(PUBLIC_KEY,
                createRequest(PUBLIC_KEY, creation).getCredentialData(), "https://bank.example");
        GetCredentialRequest getWithOrigin = new GetCredentialRequest(
                getRequest(PUBLIC_KEY, request).getCredentialOptions(), "https://bank.example");
        check(throwsType(SecurityException.class, "android.permission.CREDENTIAL_MANAGER_SET_ORIGIN",
                () -> service.executeCreateCredential(withOrigin, created, BANK)),
                "create: setOrigin without CREDENTIAL_MANAGER_SET_ORIGIN is a SecurityException");
        check(throwsType(SecurityException.class, "android.permission.CREDENTIAL_MANAGER_SET_ORIGIN",
                () -> service.executeGetCredential(getWithOrigin, got, BANK)),
                "get: setOrigin without CREDENTIAL_MANAGER_SET_ORIGIN is a SecurityException");
        check(throwsType(SecurityException.class, "android.permission.CREDENTIAL_MANAGER_SET_ORIGIN",
                () -> service.executePrepareGetCredential(getWithOrigin, null, got, BANK)),
                "prepare: setOrigin without CREDENTIAL_MANAGER_SET_ORIGIN is a SecurityException");

        host.granted.add("android.permission.CREDENTIAL_MANAGER_SET_ORIGIN");
        service.executeCreateCredential(withOrigin, created, BANK);
        service.executeGetCredential(getWithOrigin, got, BANK);
        host.drain();
        check(CREATE_NO_OPTIONS.equals(created.errorType) && GET_NO_CREDENTIAL.equals(got.errorType),
                "a permitted caller-set origin is declined: no provider takes it (no browser allowlist)");
        check(authenticator.makes.isEmpty() && authenticator.gets.isEmpty() && fetchedUrls.isEmpty(),
                "a caller-set origin never reaches Windows or the network");
        host.granted.clear();

        GetCredentialRequest allowed = new GetCredentialRequest(List.of(new CredentialOption(PUBLIC_KEY,
                new Bundle(), Set.of(new ComponentName("com.example.provider", "Service")))), null);
        check(throwsType(SecurityException.class, "android.permission.CREDENTIAL_MANAGER_SET_ALLOWED_PROVIDERS",
                () -> service.executeGetCredential(allowed, got, BANK)),
                "get: allowed providers without CREDENTIAL_MANAGER_SET_ALLOWED_PROVIDERS is a SecurityException");
        check(created.calls.size() == 1 && got.calls.size() == 1, "refused calls invoke no callback");
    }

    // --- other credential types: no provider -----------------------------------------------

    static void otherTypes() {
        fresh(true);
        CreateClient created = new CreateClient();
        service.executeCreateCredential(createRequest(PASSWORD, null), created, BANK);
        GetClient got = new GetClient();
        service.executeGetCredential(getRequest(PASSWORD, null), got, BANK);
        GetClient empty = new GetClient();
        service.executeGetCredential(new GetCredentialRequest(List.of(), null), empty, BANK);
        GetClient noJson = new GetClient();
        service.executeGetCredential(getRequest(PUBLIC_KEY, null), noJson, BANK);
        host.drain();
        check(CREATE_NO_OPTIONS.equals(created.errorType), "a password create request has no create options");
        check(GET_NO_CREDENTIAL.equals(got.errorType), "a password get request has no credential");
        check(GET_NO_CREDENTIAL.equals(empty.errorType), "a request without options has no credential");
        check(GET_NO_CREDENTIAL.equals(noJson.errorType), "a public-key option without request JSON has no credential");
        check(authenticator.makes.isEmpty() && authenticator.gets.isEmpty() && fetchedUrls.isEmpty(),
                "other credential types never reach Windows or the network");

        // A password option next to a passkey option: the passkey ceremony runs.
        GetCredentialRequest mixed = new GetCredentialRequest(List.of(
                new CredentialOption(PASSWORD, new Bundle(), null),
                getRequest(PUBLIC_KEY, requestJson("bank.example", null)).getCredentialOptions().get(0)), null);
        GetClient both = new GetClient();
        service.executeGetCredential(mixed, both, BANK);
        host.drain();
        check(authenticator.gets.size() == 1 && GET_NO_CREDENTIAL.equals(both.errorType),
                "a mixed request runs the public-key option (here: Windows has no credential)");
    }

    // --- registration ----------------------------------------------------------------------

    static String bankOrigin() {
        return "android:apk-key-hash:" + b64(sha256(BANK_CERT));
    }

    static void registration() throws Exception {
        fresh(true);
        byte[] excluded = {9, 8, 7};
        CreateClient client = create(creationJson("bank.example",
                "\"timeout\":120000,\"attestation\":\"direct\","
                + "\"excludeCredentials\":[{\"type\":\"public-key\",\"id\":\"" + b64(excluded)
                + "\",\"transports\":[\"usb\",\"internal\",\"future\"]},{\"type\":\"other\",\"id\":\"AA\"}],"
                + "\"authenticatorSelection\":{\"authenticatorAttachment\":\"platform\",\"residentKey\":\"required\","
                + "\"userVerification\":\"required\"},\"extensions\":{\"credProps\":true}"));
        check(client.calls.equals(List.of("response")), "create: one onResponse and nothing else");
        check(fetchedUrls.equals(List.of("https://bank.example/.well-known/assetlinks.json")),
                "create: the relying party's asset links are fetched once, over https, from its own host");

        PasskeyBackend.MakeCredential sent = authenticator.makes.get(0);
        check(sent.pid == BANK_PID, "create: the dialog owner is the calling process");
        check("bank.example".equals(sent.rpId) && "Example Bank".equals(sent.rpName), "create: rp id and name reach Windows");
        check(Arrays.equals(sent.userId, USER_ID) && "dana@example.com".equals(sent.userName)
                && "Dana".equals(sent.userDisplayName), "create: the user entity reaches Windows");
        check(Arrays.equals(sent.algorithms, new int[] {-7, -257}), "create: algorithms keep the relying party's order");
        check(sent.timeoutMs == 120000 && sent.attestation == 3 && sent.attachment == 1 && sent.residentKey == 2
                && sent.userVerification == 1,
                "create: timeout, direct attestation, platform attachment, required resident key and UV");
        check(sent.exclude.length == 1 && Arrays.equals(sent.exclude[0].id, excluded)
                && sent.exclude[0].transports == (0x1 | 0x10),
                "create: the exclude list keeps public-key entries and known transports (usb | internal)");

        String expectedClientData = "{\"type\":\"webauthn.create\",\"challenge\":\"" + b64(CHALLENGE)
                + "\",\"origin\":\"" + bankOrigin() + "\",\"crossOrigin\":false}";
        check(new String(sent.clientDataJson, StandardCharsets.UTF_8).equals(expectedClientData),
                "create: clientDataJSON is the specification's serialization with the app's apk-key-hash origin");

        Map<String, Object> json = parsed(client.json());
        Map<String, Object> response = member(json, "response");
        PasskeyBackend.Attestation made = null;
        StoredCredential stored = authenticator.credentials.get(0);
        check(json.keySet().equals(new LinkedHashSet<>(List.of("id", "rawId", "type", "authenticatorAttachment",
                "response", "clientExtensionResults"))), "create: RegistrationResponseJSON's members");
        check(b64(stored.id).equals(json.get("id")) && json.get("id").equals(json.get("rawId"))
                && "public-key".equals(json.get("type")), "create: id and rawId are Windows' credential id");
        check("platform".equals(json.get("authenticatorAttachment")),
                "create: attachment is platform because Windows used the internal transport");
        check(Arrays.equals(unb64(response.get("clientDataJSON")), sent.clientDataJson),
                "create: response.clientDataJSON is the bytes Windows hashed");
        byte[] authData = unb64(response.get("authenticatorData"));
        check(Arrays.equals(Arrays.copyOf(authData, 32), sha256("bank.example".getBytes(StandardCharsets.UTF_8))),
                "create: response.authenticatorData is the authenticator's");
        byte[] attestationObject = unb64(response.get("attestationObject"));
        check(indexOf(attestationObject, authData) > 0, "create: attestationObject is returned unchanged");
        check(response.get("transports").equals(List.of("hybrid", "internal")),
                "create: transports are the ones Windows reports, sorted");
        check(Double.valueOf(-7).equals(response.get("publicKeyAlgorithm")),
                "create: publicKeyAlgorithm is read from the credential's COSE key");
        PublicKey key = KeyFactory.getInstance("EC").generatePublic(
                new X509EncodedKeySpec(unb64(response.get("publicKey"))));
        check(key.equals(stored.keys.getPublic()), "create: publicKey is the credential key as SubjectPublicKeyInfo");
        check(member(member(json, "clientExtensionResults"), "credProps").equals(Map.of("rk", true)),
                "create: credProps.rk is what Windows reports for the credential");

        // --- authentication with that credential, verified with the registered key
        GetClient got = get(requestJson("bank.example", "\"userVerification\":\"discouraged\",\"timeout\":1,"
                + "\"allowCredentials\":[{\"type\":\"public-key\",\"id\":\"" + b64(stored.id)
                + "\",\"transports\":[\"hybrid\",\"smart-card\"]}]"));
        check(got.calls.equals(List.of("response")), "get: one onResponse and nothing else");
        check(PUBLIC_KEY.equals(got.response.getCredential().getType()), "get: the credential type is the public-key type");
        PasskeyBackend.GetAssertion asked = authenticator.gets.get(0);
        check(asked.pid == BANK_PID && "bank.example".equals(asked.rpId) && asked.userVerification == 3
                && asked.timeoutMs == 10000, "get: rp id, discouraged UV and a time-out raised to the minimum");
        check(asked.allow.length == 1 && Arrays.equals(asked.allow[0].id, stored.id)
                && asked.allow[0].transports == (0x20 | 0x40), "get: the allow list reaches Windows");
        String getClientData = "{\"type\":\"webauthn.get\",\"challenge\":\"" + b64(CHALLENGE)
                + "\",\"origin\":\"" + bankOrigin() + "\",\"crossOrigin\":false}";
        check(new String(asked.clientDataJson, StandardCharsets.UTF_8).equals(getClientData),
                "get: clientDataJSON has type webauthn.get and the same origin");
        Map<String, Object> assertion = parsed(got.json());
        Map<String, Object> assertionResponse = member(assertion, "response");
        check(assertion.keySet().equals(new LinkedHashSet<>(List.of("id", "rawId", "type",
                "authenticatorAttachment", "response", "clientExtensionResults")))
                && assertionResponse.keySet().equals(new LinkedHashSet<>(List.of("clientDataJSON",
                "authenticatorData", "signature", "userHandle"))), "get: AuthenticationResponseJSON's members");
        check(b64(stored.id).equals(assertion.get("id")) && assertion.get("id").equals(assertion.get("rawId")),
                "get: id is the credential Windows used");
        check(Arrays.equals(unb64(assertionResponse.get("userHandle")), USER_ID), "get: userHandle is the stored user id");
        java.security.Signature verifier = java.security.Signature.getInstance("SHA256withECDSA");
        verifier.initVerify(key);
        verifier.update(unb64(assertionResponse.get("authenticatorData")));
        verifier.update(sha256(unb64(assertionResponse.get("clientDataJSON"))));
        check(verifier.verify(unb64(assertionResponse.get("signature"))),
                "get: the signature verifies over authenticatorData and SHA-256(clientDataJSON) with the registered key");
        check(member(assertion, "clientExtensionResults").isEmpty(), "get: no extension results are invented");

        // --- defaults, an RSA key, and an older Windows that reports fewer details
        fresh(true);
        authenticator.reportsDetails = false;
        authenticator.usedTransport = PasskeyBackend.TRANSPORT_USB;
        client = create("{\"rp\":{\"id\":\"bank.example\",\"name\":\"Bank\"},\"user\":{\"id\":\"AQ\",\"name\":\"n\","
                + "\"displayName\":\"d\"},\"challenge\":\"" + b64(CHALLENGE) + "\",\"pubKeyCredParams\":"
                + "[{\"type\":\"future\",\"alg\":1},{\"type\":\"public-key\",\"alg\":-257}],"
                + "\"attestation\":\"enterprise\",\"authenticatorSelection\":{\"requireResidentKey\":true},"
                + "\"extensions\":{\"credProps\":true}}");
        sent = authenticator.makes.get(0);
        check(Arrays.equals(sent.algorithms, new int[] {-257}) && sent.timeoutMs == 300000 && sent.attestation == 1
                && sent.attachment == 0 && sent.residentKey == 2 && sent.userVerification == 2 && sent.exclude.length == 0,
                "create defaults: 5 min time-out, no attestation, any attachment, preferred UV; requireResidentKey honored");
        json = parsed(client.json());
        response = member(json, "response");
        check("cross-platform".equals(json.get("authenticatorAttachment"))
                && response.get("transports").equals(List.of("usb")),
                "create: with only the used transport known, that is the transport list and attachment");
        check(Double.valueOf(-257).equals(response.get("publicKeyAlgorithm")), "create: RS256 algorithm is reported");
        key = KeyFactory.getInstance("RSA").generatePublic(new X509EncodedKeySpec(unb64(response.get("publicKey"))));
        check(key.equals(authenticator.credentials.get(0).keys.getPublic()),
                "create: an RSA credential key is encoded as SubjectPublicKeyInfo");
        check(member(member(json, "clientExtensionResults"), "credProps").isEmpty(),
                "create: credProps.rk is omitted when Windows does not report it");
        got = get(requestJson("bank.example", null));
        assertionResponse = member(parsed(got.json()), "response");
        verifier = java.security.Signature.getInstance("SHA256withRSA");
        verifier.initVerify(key);
        verifier.update(unb64(assertionResponse.get("authenticatorData")));
        verifier.update(sha256(unb64(assertionResponse.get("clientDataJSON"))));
        check(verifier.verify(unb64(assertionResponse.get("signature"))), "get: an RS256 assertion verifies");
        check(authenticator.gets.get(0).allow.length == 0 && authenticator.gets.get(0).timeoutMs == 300000
                && authenticator.gets.get(0).userVerification == 2, "get defaults: no allow list, 5 min, preferred UV");

        // --- a key type without a SubjectPublicKeyInfo encoding here, no transport, no user handle
        fresh(true);
        authenticator.reportsDetails = false;
        authenticator.usedTransport = 0;
        client = create(creationJson("bank.example", null).replace("\"alg\":-7", "\"alg\":-8"));
        json = parsed(client.json());
        response = member(json, "response");
        check(!response.containsKey("publicKey") && Double.valueOf(-8).equals(response.get("publicKeyAlgorithm"))
                && !json.containsKey("authenticatorAttachment") && response.get("transports").equals(List.of())
                && member(json, "clientExtensionResults").isEmpty(),
                "create: unknown key encodings, attachment and transports are omitted, not guessed");

        // --- Windows answered S_OK with data that holds no credential key
        fresh(true);
        authenticator.corruptAuthenticatorData = new byte[37];
        client = create(creationJson("bank.example", null));
        check(CREATE_UNKNOWN.equals(client.errorType) && client.calls.size() == 1,
                "create: an unreadable attestation is TYPE_UNKNOWN, never a made-up response");
        fresh(true);
        authenticator.returnNull = true;
        client = create(creationJson("bank.example", null));
        got = get(requestJson("bank.example", null));
        check(CREATE_UNKNOWN.equals(client.errorType) && GET_UNKNOWN.equals(got.errorType),
                "a backend without an answer is TYPE_UNKNOWN");
    }

    static int indexOf(byte[] haystack, byte[] needle) {
        outer:
        for (int i = 0; i + needle.length <= haystack.length; i++) {
            for (int j = 0; j < needle.length; j++) if (haystack[i + j] != needle[j]) continue outer;
            return i;
        }
        return -1;
    }

    // --- the relying party must have delegated to this application --------------------------

    static void association() {
        String good = "[" + statement(BANK, BANK_CERT, LOGIN) + "]";
        Object[][] cases = {
            {"no asset links file (404)", 404, "application/json", ""},
            {"a statement for another package", 200, "application/json", "[" + statement(SHOP, BANK_CERT, LOGIN) + "]"},
            {"a statement for another certificate", 200, "application/json", "[" + statement(BANK, SHOP_CERT, LOGIN) + "]"},
            {"only handle_all_urls is granted", 200, "application/json", "[" + statement(BANK, BANK_CERT, URLS) + "]"},
            {"a web target", 200, "application/json", "[{\"relation\":[\"" + LOGIN
                    + "\"],\"target\":{\"namespace\":\"web\",\"site\":\"https://bank.example\"}}]"},
            {"a wrong content type", 200, "text/html", good},
            {"no content type", 200, null, good},
            {"malformed JSON", 200, "application/json", good.substring(0, good.length() - 1)},
            {"lenient JSON (a comment)", 200, "application/json", "/* links */" + good},
            {"a JSON object instead of a list", 200, "application/json", statement(BANK, BANK_CERT, LOGIN)},
            {"an empty list", 200, "application/json", "[]"},
            {"a server error", 500, "application/json", good},
        };
        for (Object[] c : cases) {
            fresh(true);
            site("bank.example", (Integer) c[1], (String) c[2], (String) c[3]);
            CreateClient created = create(creationJson("bank.example", null));
            GetClient got = get(requestJson("bank.example", null));
            check((CREATE_DOM + "androidx.credentials.TYPE_SECURITY_ERROR").equals(created.errorType)
                    && (GET_DOM + "androidx.credentials.TYPE_SECURITY_ERROR").equals(got.errorType)
                    && "The incoming request cannot be validated".equals(created.errorMessage)
                    && authenticator.makes.isEmpty() && authenticator.gets.isEmpty()
                    && authenticator.cancellations.get() == 0 && created.calls.size() == 1 && got.calls.size() == 1,
                    "refused with SecurityError before any ceremony: " + c[0]);
        }

        // A redirect to a host with a valid statement is not followed.
        fresh(true);
        site("other.example", 200, "application/json", good);
        sites.put("bank.example", new Object[] {302, "application/json", "",
                "http://127.0.0.1:" + server.getAddress().getPort() + "/other.example/.well-known/assetlinks.json"});
        int before = served.get();
        CreateClient created = create(creationJson("bank.example", null));
        check((CREATE_DOM + "androidx.credentials.TYPE_SECURITY_ERROR").equals(created.errorType)
                && served.get() == before + 1 && authenticator.makes.isEmpty(),
                "refused with SecurityError: a redirect is not followed");

        // An oversized document is not read to its end.
        fresh(true);
        char[] padding = new char[(1 << 20) + 1];
        Arrays.fill(padding, ' ');
        site("bank.example", 200, "application/json", new String(padding) + good);
        check((CREATE_DOM + "androidx.credentials.TYPE_SECURITY_ERROR").equals(
                create(creationJson("bank.example", null)).errorType), "refused with SecurityError: a document over 1 MiB");

        // No verified signing certificate: there is no identity to associate.
        fresh(true);
        host.certificates.remove(BANK);
        created = create(creationJson("bank.example", null));
        check((CREATE_DOM + "androidx.credentials.TYPE_SECURITY_ERROR").equals(created.errorType)
                && fetchedUrls.isEmpty() && authenticator.makes.isEmpty(),
                "refused with SecurityError: an application without a verified signature");

        // The statement of the caller's own package only: another app's grant does not help.
        fresh(true);
        site("bank.example", 200, "application/json", "[" + statement(SHOP, SHOP_CERT, LOGIN) + "]");
        check((GET_DOM + "androidx.credentials.TYPE_SECURITY_ERROR").equals(
                get(requestJson("bank.example", null)).errorType), "refused: the site delegates to a different app");

        // Relying party ids that are not plain host names never reach the network.
        for (String id : new String[] {"bank.example/x", "bank.example:443", "user@bank.example", "BANK.example",
                "bank..example", ".bank.example", "bank.example.", "-bank.example", "bank.example?x=1",
                "bank.example#f", "127.0.0.1:" + server.getAddress().getPort() + "/other.example", "", "b\u00e4nk.example",
                "https://bank.example"}) {
            fresh(true);
            int servedBefore = served.get();
            CreateClient c = create(creationJson(id, null));
            GetClient g = get(requestJson(id, null));
            check((CREATE_DOM + "androidx.credentials.TYPE_SECURITY_ERROR").equals(c.errorType)
                    && (GET_DOM + "androidx.credentials.TYPE_SECURITY_ERROR").equals(g.errorType)
                    && fetchedUrls.isEmpty() && served.get() == servedBefore && authenticator.makes.isEmpty(),
                    "refused with SecurityError and no request: rp id '" + id + "'");
        }

        // Fingerprints are compared whatever their letter case; a second signer also matches.
        fresh(true);
        site("bank.example", 200, "application/json; charset=utf-8",
                "[" + statement(SHOP, SHOP_CERT, LOGIN) + "," + statement(BANK, BANK_CERT, LOGIN).toLowerCase(Locale.ROOT)
                        .replace("android_app", "android_app").replace("delegate_permission", "delegate_permission")
                + "]");
        check(create(creationJson("bank.example", null)).response != null,
                "accepted: a lower-case fingerprint among several statements");
        fresh(true);
        host.certificates.put(BANK, new byte[][] {SHOP_CERT, BANK_CERT});
        CreateClient two = create(creationJson("bank.example", null));
        check(two.response != null && new String(authenticator.makes.get(0).clientDataJson, StandardCharsets.UTF_8)
                .contains("android:apk-key-hash:" + b64(sha256(SHOP_CERT))),
                "accepted: any current signer may be granted; the origin is the first signer's");
    }

    // --- malformed requests ----------------------------------------------------------------

    static void malformed() {
        String good = creationJson("bank.example", null);
        Object[][] creations = {
            {"not JSON", "rp=bank", "DATA"},
            {"single-quoted JSON", good.replace('"', '\''), "DATA"},
            {"trailing text", good + "x", "DATA"},
            {"a duplicate member", good.replace("{\"rp\"", "{\"challenge\":\"AA\",\"rp\""), "DATA"},
            {"a JSON array", "[]", "DATA"},
            {"no rp", good.replace("\"rp\"", "\"pr\""), "DATA"},
            {"no rp.id", good.replace("\"id\":\"bank.example\",", ""), "DATA"},
            {"no user", good.replace("\"user\"", "\"resu\""), "DATA"},
            {"a user id over 64 bytes", good.replace(b64(USER_ID), b64(new byte[65])), "DATA"},
            {"no challenge", good.replace("\"challenge\"", "\"egnellahc\""), "DATA"},
            {"an empty challenge", good.replace(b64(CHALLENGE), ""), "DATA"},
            {"a challenge in standard base64", good.replace(b64(CHALLENGE), "ab+/"), "DATA"},
            {"a numeric challenge", good.replace("\"" + b64(CHALLENGE) + "\"", "17"), "DATA"},
            {"no pubKeyCredParams", good.replace("\"pubKeyCredParams\"", "\"params\""), "DATA"},
            {"a fractional algorithm", good.replace("\"alg\":-7", "\"alg\":-7.5"), "DATA"},
            {"no public-key parameter", good.replace("\"type\":\"public-key\"", "\"type\":\"other\""), "NOT_SUPPORTED"},
            {"a negative timeout", creationJson("bank.example", "\"timeout\":-1"), "DATA"},
        };
        for (Object[] c : creations) {
            fresh(true);
            CreateClient client = create((String) c[1]);
            check((CREATE_DOM + "androidx.credentials.TYPE_" + c[2] + "_ERROR").equals(client.errorType)
                    && client.calls.size() == 1 && authenticator.makes.isEmpty() && fetchedUrls.isEmpty(),
                    "create refused before the network and Windows: " + c[0] + " is " + c[2] + "_ERROR");
        }
        String request = requestJson("bank.example", null);
        Object[][] requests = {
            {"not JSON", "{", "DATA"},
            {"no rpId", request.replace("\"rpId\"", "\"rp\""), "DATA"},
            {"no challenge", request.replace("\"challenge\"", "\"c\""), "DATA"},
            {"allowCredentials that is not a list", requestJson("bank.example", "\"allowCredentials\":{}"), "DATA"},
            {"an allow entry without id", requestJson("bank.example", "\"allowCredentials\":[{\"type\":\"public-key\"}]"), "DATA"},
        };
        for (Object[] c : requests) {
            fresh(true);
            GetClient client = get((String) c[1]);
            check((GET_DOM + "androidx.credentials.TYPE_" + c[2] + "_ERROR").equals(client.errorType)
                    && client.calls.size() == 1 && authenticator.gets.isEmpty() && fetchedUrls.isEmpty(),
                    "get refused before the network and Windows: " + c[0] + " is " + c[2] + "_ERROR");
        }
        // Escapes in clientDataJSON follow CCDToString.
        check(PasskeyJson.quote(new StringBuilder(), "a\"b\\c\u0001\u001f/\u00e9").toString()
                .equals("\"a\\\"b\\\\c\\u0001\\u001f/\u00e9\""), "CCDToString escapes quote, backslash and controls only");
        check(new String(PasskeyRequests.clientData("webauthn.get", new byte[] {(byte) 0xfb, (byte) 0xff}, "o"),
                StandardCharsets.UTF_8).equals("{\"type\":\"webauthn.get\",\"challenge\":\"-_8\",\"origin\":\"o\",\"crossOrigin\":false}"),
                "the challenge is unpadded base64url");
    }

    // --- what Windows answered is what the application gets --------------------------------

    static void errors() {
        Object[][] table = {
            // HRESULT, create type, get type
            {NTE_USER_CANCELLED, CREATE_CANCELED, GET_CANCELED, "NTE_USER_CANCELLED: user canceled"},
            {E_CANCELLED, CREATE_CANCELED, GET_CANCELED, "ERROR_CANCELLED: user canceled"},
            {NTE_NOT_FOUND, CREATE_DOM + "androidx.credentials.TYPE_NOT_ALLOWED_ERROR", GET_NO_CREDENTIAL,
                    "NTE_NOT_FOUND: no credential (get), NotAllowedError (create)"},
            {NTE_DEVICE_NOT_FOUND, CREATE_NO_OPTIONS, GET_NO_CREDENTIAL,
                    "NTE_DEVICE_NOT_FOUND: no authenticator is no create option / no credential"},
            {NTE_EXISTS, CREATE_DOM + "androidx.credentials.TYPE_INVALID_STATE_ERROR",
                    GET_DOM + "androidx.credentials.TYPE_INVALID_STATE_ERROR", "NTE_EXISTS: InvalidStateError"},
            {NTE_NOT_SUPPORTED, CREATE_DOM + "androidx.credentials.TYPE_CONSTRAINT_ERROR",
                    GET_DOM + "androidx.credentials.TYPE_CONSTRAINT_ERROR", "NTE_NOT_SUPPORTED: ConstraintError"},
            {NTE_INVALID_PARAMETER, CREATE_DOM + "androidx.credentials.TYPE_NOT_SUPPORTED_ERROR",
                    GET_DOM + "androidx.credentials.TYPE_NOT_SUPPORTED_ERROR", "NTE_INVALID_PARAMETER: NotSupportedError"},
            {E_TIMEOUT, CREATE_DOM + "androidx.credentials.TYPE_NOT_ALLOWED_ERROR",
                    GET_DOM + "androidx.credentials.TYPE_NOT_ALLOWED_ERROR", "ERROR_TIMEOUT: NotAllowedError"},
            {E_FAIL, CREATE_DOM + "androidx.credentials.TYPE_UNKNOWN_ERROR",
                    GET_DOM + "androidx.credentials.TYPE_UNKNOWN_ERROR", "E_FAIL: UnknownError"},
        };
        for (Object[] row : table) {
            fresh(true);
            authenticator.failWith = (Integer) row[0];
            CreateClient created = create(creationJson("bank.example", null));
            GetClient got = get(requestJson("bank.example", null));
            check(row[1].equals(created.errorType) && row[2].equals(got.errorType) && created.response == null
                    && got.response == null && created.calls.size() == 1 && got.calls.size() == 1
                    && created.errorMessage.contains(String.format("0x%08X", (Integer) row[0])),
                    "Windows " + row[3]);
        }
        fresh(true);
        authenticator.notForeground = true;
        CreateClient created = create(creationJson("bank.example", null));
        GetClient got = get(requestJson("bank.example", null));
        check(CREATE_UNKNOWN.equals(created.errorType) && GET_UNKNOWN.equals(got.errorType),
                "a caller that does not own the foreground window gets TYPE_UNKNOWN (the selector cannot start)");
        // An error name outside Windows' documented set, or none: the framework's unknown type.
        fresh(true);
        PasskeyBackend scripted = new PasskeyBackend() {
            public int apiVersion() { return 1; }
            public Cancellation newCancellation() { return null; }
            public Attestation makeCredential(MakeCredential request, Cancellation c) {
                Attestation out = new Attestation();
                out.hresult = E_FAIL;
                out.errorName = "SurpriseError";
                return out;
            }
            public Assertion getAssertion(GetAssertion request, Cancellation c) {
                return new Assertion();  // E_FAIL and no name, as before Windows answers
            }
        };
        service = new CredentialManagerService(host, scripted, fetcher);
        created = create(creationJson("bank.example", null));
        got = get(requestJson("bank.example", null));
        check(CREATE_UNKNOWN.equals(created.errorType) && GET_UNKNOWN.equals(got.errorType),
                "an unnamed or unexpected Windows error is TYPE_UNKNOWN");
        // A get on Windows without a credential for the site.
        fresh(true);
        got = get(requestJson("bank.example", null));
        check(GET_NO_CREDENTIAL.equals(got.errorType) && got.response == null,
                "no matching credential is NoCredentialException's type");
    }

    // --- cancellation, client death, exactly-once callbacks --------------------------------

    static void cancellation() throws Exception {
        // The application cancels while Windows' dialog is up.
        fresh(true);
        host.threads = true;
        authenticator.entered = new CountDownLatch(1);
        authenticator.release = new CountDownLatch(1);
        CreateClient created = new CreateClient();
        ICancellationSignal signal = service.executeCreateCredential(
                createRequest(PUBLIC_KEY, creationJson("bank.example", null)), created, BANK);
        check(authenticator.entered.await(10, TimeUnit.SECONDS), "create: the ceremony runs off the Binder thread");
        check(created.calls.isEmpty() && created.links == 1, "create: no callback while the user decides; death is watched");
        signal.cancel();
        signal.cancel();
        host.join();
        check(authenticator.cancels.get() == 1, "app cancel: Windows' operation is canceled once");
        check(created.calls.isEmpty(), "app cancel: no callback at all, as AOSP's canceled session");
        check(authenticator.credentials.isEmpty(), "app cancel: no credential was made");

        // The same for get, by client death.
        fresh(true);
        host.threads = true;
        authenticator.entered = new CountDownLatch(1);
        authenticator.release = new CountDownLatch(1);
        GetClient got = new GetClient();
        service.executeGetCredential(getRequest(PUBLIC_KEY, requestJson("bank.example", null)), got, BANK);
        authenticator.entered.await(10, TimeUnit.SECONDS);
        got.die();
        host.join();
        check(authenticator.cancels.get() == 1 && got.calls.isEmpty(),
                "client death: Windows' operation is canceled and nothing is delivered");

        // Canceled before the ceremony starts: Windows is never asked.
        fresh(true);
        created = new CreateClient();
        signal = service.executeCreateCredential(createRequest(PUBLIC_KEY, creationJson("bank.example", null)),
                created, BANK);
        signal.cancel();
        host.drain();
        check(authenticator.makes.isEmpty() && authenticator.cancels.get() == 0 && created.calls.isEmpty(),
                "canceled before the ceremony: Windows is never asked and nothing is delivered");

        // A client that is already dead.
        fresh(true);
        got = new GetClient();
        got.dead = true;
        service.executeGetCredential(getRequest(PUBLIC_KEY, requestJson("bank.example", null)), got, BANK);
        host.drain();
        check(authenticator.gets.isEmpty() && got.calls.isEmpty(), "a dead client: Windows is never asked");

        // Cancel after completion does nothing; the death link is released.
        fresh(true);
        created = new CreateClient();
        signal = service.executeCreateCredential(createRequest(PUBLIC_KEY, creationJson("bank.example", null)),
                created, BANK);
        host.drain();
        signal.cancel();
        created.die();
        check(created.calls.equals(List.of("response")) && authenticator.cancels.get() == 0 && created.unlinks == 1,
                "after completion: cancel and death do nothing, the death link is released, one callback");

        // The user cancels in Windows' dialog: that is a result, delivered once.
        fresh(true);
        authenticator.failWith = NTE_USER_CANCELLED;
        created = create(creationJson("bank.example", null));
        check(created.calls.equals(List.of("error:" + CREATE_CANCELED)) && authenticator.cancels.get() == 0,
                "user cancel in Windows' dialog: TYPE_USER_CANCELED once, and Gesher cancels nothing");

        // Windows gives no cancellation id: the ceremony still runs and still answers once.
        fresh(true);
        authenticator.cancellable = false;
        created = create(creationJson("bank.example", null));
        check(created.calls.equals(List.of("response")), "without a cancellation id the ceremony still completes");
    }

    static void concurrent() throws Exception {
        fresh(true);
        host.threads = true;
        site("shop.example", 200, "application/json", "[" + statement(SHOP, SHOP_CERT, LOGIN) + "]");
        authenticator.entered = new CountDownLatch(2);
        authenticator.release = new CountDownLatch(1);
        CreateClient bank = new CreateClient(), shop = new CreateClient();
        ICancellationSignal bankSignal = service.executeCreateCredential(
                createRequest(PUBLIC_KEY, creationJson("bank.example", null)), bank, BANK);
        host.uid = SHOP_UID;
        host.pid = SHOP_PID;
        service.executeCreateCredential(createRequest(PUBLIC_KEY, creationJson("shop.example", null)), shop, SHOP);
        check(authenticator.entered.await(10, TimeUnit.SECONDS), "two ceremonies are in Windows at the same time");
        bankSignal.cancel();
        authenticator.release.countDown();
        host.join();
        check(shop.done.await(10, TimeUnit.SECONDS) && shop.calls.equals(List.of("response")),
                "canceling one request leaves the other, which completes once");
        check(bank.calls.isEmpty() && authenticator.cancels.get() == 1, "only the canceled request's operation is canceled");
        Set<Integer> pids = new HashSet<>();
        synchronized (authenticator.makes) {
            for (PasskeyBackend.MakeCredential make : authenticator.makes) pids.add(make.pid);
        }
        check(pids.equals(Set.of(BANK_PID, SHOP_PID)), "each ceremony is owned by its own caller's window");
        Map<String, Object> json = parsed(shop.json());
        String clientData = new String(unb64(member(json, "response").get("clientDataJSON")), StandardCharsets.UTF_8);
        check(clientData.contains("android:apk-key-hash:" + b64(sha256(SHOP_CERT))) && !clientData.contains(b64(sha256(BANK_CERT))),
                "each response carries its own caller's origin");

        // Many at once: every request gets exactly one answer of its own.
        fresh(true);
        host.threads = true;
        authenticator.entered = null;
        authenticator.release = null;
        List<CreateClient> clients = new ArrayList<>();
        for (int i = 0; i < 12; i++) {
            CreateClient client = new CreateClient();
            clients.add(client);
            service.executeCreateCredential(createRequest(PUBLIC_KEY, creationJson("bank.example", null)), client, BANK);
        }
        host.join();
        Set<Object> ids = new HashSet<>();
        boolean once = true;
        for (CreateClient client : clients) {
            once &= client.calls.equals(List.of("response"));
            if (client.response != null) ids.add(parsed(client.json()).get("id"));
        }
        check(once && ids.size() == 12, "twelve concurrent requests: one response each, twelve distinct credentials");
    }

    // --- the rest of ICredentialManager -----------------------------------------------------

    static void otherMethods() {
        fresh(true);
        List<Object> prepared = new ArrayList<>();
        IPrepareGetCredentialCallback prepare = new IPrepareGetCredentialCallback() {
            public void onResponse(PrepareGetCredentialResponseInternal response) { prepared.add(response); }
            public void onError(String type, String message) { prepared.add(type); }
        };
        GetClient got = new GetClient();
        ICancellationSignal transport = service.executePrepareGetCredential(
                getRequest(PUBLIC_KEY, requestJson("bank.example", null)), prepare, got, BANK);
        PrepareGetCredentialResponseInternal response = (PrepareGetCredentialResponseInternal) prepared.get(0);
        check(transport != null && prepared.size() == 1 && !response.hasQueryApiPermission && response.types == null
                && !response.hasAuthenticationResults && !response.hasRemoteResults && response.pendingIntent == null
                && got.calls.isEmpty() && authenticator.gets.isEmpty(),
                "prepareGetCredential: AOSP's response without results or a PendingIntent; no ceremony");
        check(throwsType(SecurityException.class, "does not belong to uid",
                () -> service.executePrepareGetCredential(getRequest(PUBLIC_KEY, "{}"), prepare, got, SHOP)),
                "prepareGetCredential: enforces the calling package");
        host.granted.add("android.permission.CREDENTIAL_MANAGER_QUERY_CANDIDATE_CREDENTIALS");
        service.executePrepareGetCredential(getRequest(PUBLIC_KEY, "{}"), prepare, got, BANK);
        check(((PrepareGetCredentialResponseInternal) prepared.get(1)).hasQueryApiPermission,
                "prepareGetCredential: reports the caller's query permission");
        host.granted.clear();

        check(throwsType(SecurityException.class, "Credential Autofill service does not exist on this device.",
                () -> service.getCandidateCredentials(null, null, null, BANK)),
                "getCandidateCredentials: no credential autofill service is a SecurityException");
        check(throwsType(UnsupportedOperationException.class, "Feature not supported",
                () -> service.registerCredentialDescription(null, BANK))
                && throwsType(UnsupportedOperationException.class, "Feature not supported",
                () -> service.unregisterCredentialDescription(null, BANK)),
                "credential descriptions: the feature is off, UnsupportedOperationException");

        List<String> cleared = new ArrayList<>();
        IClearCredentialStateCallback clear = new IClearCredentialStateCallback() {
            public void onSuccess() { cleared.add("success"); }
            public void onError(String type, String message) { cleared.add(type); }
        };
        check(service.clearCredentialState(new ClearCredentialStateRequest(), clear, BANK) != null
                && cleared.equals(List.of("success")), "clearCredentialState: the provider keeps no state to clear");
        check(throwsType(SecurityException.class, "does not belong to uid",
                () -> service.clearCredentialState(new ClearCredentialStateRequest(), clear, SHOP)),
                "clearCredentialState: enforces the calling package");

        check(!service.isEnabledCredentialProviderService(new ComponentName(BANK, "Provider"), BANK)
                && !service.isEnabledCredentialProviderService(null, BANK),
                "isEnabledCredentialProviderService: no provider service is enabled");
        check(throwsType(IllegalArgumentException.class, "does not match",
                () -> service.isEnabledCredentialProviderService(new ComponentName(SHOP, "Provider"), BANK)),
                "isEnabledCredentialProviderService: another package's component is an IllegalArgumentException");
        check(throwsType(SecurityException.class, "LIST_ENABLED_CREDENTIAL_PROVIDERS",
                () -> service.getCredentialProviderServices(0, 0))
                && throwsType(SecurityException.class, "QUERY_ALL_PACKAGES",
                () -> service.getCredentialProviderServicesForTesting(0)),
                "getCredentialProviderServices: needs QUERY_ALL_PACKAGES or LIST_ENABLED_CREDENTIAL_PROVIDERS");
        host.granted.add("android.permission.LIST_ENABLED_CREDENTIAL_PROVIDERS");
        check(service.getCredentialProviderServices(0, 0).isEmpty()
                && service.getCredentialProviderServicesForTesting(0).isEmpty(),
                "getCredentialProviderServices: no provider services are hosted");
        List<String> enabled = new ArrayList<>();
        ISetEnabledProvidersCallback set = new ISetEnabledProvidersCallback() {
            public void onResponse() { enabled.add("response"); }
            public void onError(String type, String message) { enabled.add(type + ":" + message); }
        };
        service.setEnabledProviders(List.of(), List.of(), 0, set);
        host.granted.add("android.permission.WRITE_SECURE_SETTINGS");
        service.setEnabledProviders(List.of(), List.of(), 0, set);
        check(enabled.equals(List.of("permission_denied:Caller is missing WRITE_SECURE_SETTINGS permission",
                "failed_setting_store:Failed to store setting containing enabled or primary providers")),
                "setEnabledProviders: permission_denied, else the store fails; never a success");
        check(service.isServiceEnabled(), "isServiceEnabled: true");
    }

    // --- the strict JSON reader ------------------------------------------------------------

    static void json() {
        Map<String, Object> value = parsed(" {\"a\":[1,-2.5e1,true,false,null,\"x\\u0041\\n\\/\"],\"b\":{}} ");
        check(value.get("a").equals(Arrays.asList(1.0, -25.0, true, false, PasskeyJson.NULL, "xA\n/"))
                && ((Map<?, ?>) value.get("b")).isEmpty(), "JSON: values, escapes and null are read");
        for (String bad : new String[] {"", "{", "{\"a\":1,}", "[1,]", "{a:1}", "{'a':1}", "01", "1.", "+1", "tru",
                "\"\t\"", "\"\\x\"", "{\"a\":1}{}", "// c\n{}", "{\"a\":1,\"a\":2}", "NaN", "\"\\u12\""}) {
            check(throwsType(IllegalArgumentException.class, null, () -> PasskeyJson.parse(bad)),
                    "JSON: refuses " + bad.replace("\n", "\\n").replace("\t", "\\t"));
        }
        StringBuilder deep = new StringBuilder();
        for (int i = 0; i < 100; i++) deep.append('[');
        check(throwsType(IllegalArgumentException.class, "nested", () -> PasskeyJson.parse(deep.toString())),
                "JSON: refuses deep nesting");
        check(throwsType(IllegalArgumentException.class, null, () -> PasskeyJson.parse(null)), "JSON: refuses no text");
    }

    public static void main(String[] args) throws Exception {
        startServer();
        try {
            unavailable();
            identity();
            otherTypes();
            registration();
            association();
            malformed();
            errors();
            cancellation();
            concurrent();
            otherMethods();
            json();
        } finally {
            server.stop(0);
        }
        System.out.println("credential manager contracts: " + (checks - failures) + "/" + checks + " passed");
        if (failures != 0) System.exit(1);
    }
}

// --- android.* boundary stand-ins (android-16.0.0_r4 shapes and values) ---------------------

class RemoteException extends Exception {
    private static final long serialVersionUID = 1;
}

interface IBinder {
    interface DeathRecipient {
        void binderDied();
    }
    void linkToDeath(DeathRecipient recipient, int flags) throws RemoteException;
    boolean unlinkToDeath(DeathRecipient recipient, int flags);
}

interface ICancellationSignal {
    void cancel();
}

/** android.os.CancellationSignal: its transport cancels the signal, which tells its listener once. */
final class CancellationSignal {
    interface OnCancelListener {
        void onCancel();
    }
    private boolean mCanceled;
    private OnCancelListener mListener;
    private static final class Transport implements ICancellationSignal {
        final CancellationSignal signal = new CancellationSignal();
        public void cancel() { signal.cancel(); }
    }
    static ICancellationSignal createTransport() { return new Transport(); }
    static CancellationSignal fromTransport(ICancellationSignal transport) { return ((Transport) transport).signal; }
    void cancel() {
        OnCancelListener listener;
        synchronized (this) {
            if (mCanceled) return;
            mCanceled = true;
            listener = mListener;
        }
        if (listener != null) listener.onCancel();
    }
    void setOnCancelListener(OnCancelListener listener) {
        synchronized (this) {
            mListener = listener;
            if (!mCanceled || listener == null) return;
        }
        listener.onCancel();
    }
}

final class Bundle {
    private final Map<String, String> mStrings = new HashMap<>();
    void putString(String key, String value) { mStrings.put(key, value); }
    String getString(String key) { return mStrings.get(key); }
}

final class ComponentName {
    private final String mPackage, mClass;
    ComponentName(String packageName, String className) {
        mPackage = packageName;
        mClass = className;
    }
    String getPackageName() { return mPackage; }
    String getClassName() { return mClass; }
}

final class PendingIntent {
}

final class CredentialOption {
    private final String mType;
    private final Bundle mData;
    private final Set<ComponentName> mAllowed;
    CredentialOption(String type, Bundle data, Set<ComponentName> allowedProviders) {
        mType = type;
        mData = data;
        mAllowed = allowedProviders == null ? new HashSet<>() : allowedProviders;
    }
    String getType() { return mType; }
    Bundle getCredentialRetrievalData() { return mData; }
    Set<ComponentName> getAllowedProviders() { return mAllowed; }
}

final class GetCredentialRequest {
    private final List<CredentialOption> mOptions;
    private final String mOrigin;
    GetCredentialRequest(List<CredentialOption> options, String origin) {
        mOptions = options;
        mOrigin = origin;
    }
    List<CredentialOption> getCredentialOptions() { return mOptions; }
    String getOrigin() { return mOrigin; }
}

final class CreateCredentialRequest {
    private final String mType, mOrigin;
    private final Bundle mData;
    CreateCredentialRequest(String type, Bundle data, String origin) {
        mType = type;
        mData = data;
        mOrigin = origin;
    }
    String getType() { return mType; }
    Bundle getCredentialData() { return mData; }
    String getOrigin() { return mOrigin; }
}

final class Credential {
    private final String mType;
    private final Bundle mData;
    Credential(String type, Bundle data) {
        mType = type;
        mData = data;
    }
    String getType() { return mType; }
    Bundle getData() { return mData; }
}

final class GetCredentialResponse {
    private final Credential mCredential;
    GetCredentialResponse(Credential credential) { mCredential = credential; }
    Credential getCredential() { return mCredential; }
}

final class CreateCredentialResponse {
    private final Bundle mData;
    CreateCredentialResponse(Bundle data) { mData = data; }
    Bundle getData() { return mData; }
}

final class GetCredentialException {
    static final String TYPE_UNKNOWN = "android.credentials.GetCredentialException.TYPE_UNKNOWN";
    static final String TYPE_NO_CREDENTIAL = "android.credentials.GetCredentialException.TYPE_NO_CREDENTIAL";
    static final String TYPE_USER_CANCELED = "android.credentials.GetCredentialException.TYPE_USER_CANCELED";
    static final String TYPE_INTERRUPTED = "android.credentials.GetCredentialException.TYPE_INTERRUPTED";
}

final class CreateCredentialException {
    static final String TYPE_UNKNOWN = "android.credentials.CreateCredentialException.TYPE_UNKNOWN";
    static final String TYPE_NO_CREATE_OPTIONS = "android.credentials.CreateCredentialException.TYPE_NO_CREATE_OPTIONS";
    static final String TYPE_USER_CANCELED = "android.credentials.CreateCredentialException.TYPE_USER_CANCELED";
    static final String TYPE_INTERRUPTED = "android.credentials.CreateCredentialException.TYPE_INTERRUPTED";
}

final class PrepareGetCredentialResponseInternal {
    final boolean hasQueryApiPermission, hasAuthenticationResults, hasRemoteResults;
    final Set<String> types;
    final PendingIntent pendingIntent;
    PrepareGetCredentialResponseInternal(boolean hasQueryApiPermission, Set<String> credentialResultTypes,
            boolean hasAuthenticationResults, boolean hasRemoteResults, PendingIntent pendingIntent) {
        this.hasQueryApiPermission = hasQueryApiPermission;
        this.types = credentialResultTypes;
        this.hasAuthenticationResults = hasAuthenticationResults;
        this.hasRemoteResults = hasRemoteResults;
        this.pendingIntent = pendingIntent;
    }
}

final class ClearCredentialStateRequest {
}

final class RegisterCredentialDescriptionRequest {
}

final class UnregisterCredentialDescriptionRequest {
}

final class CredentialProviderInfo {
}

interface IGetCredentialCallback {
    void onResponse(GetCredentialResponse response) throws RemoteException;
    void onError(String errorType, String message) throws RemoteException;
    IBinder asBinder();
}

interface ICreateCredentialCallback {
    void onResponse(CreateCredentialResponse response) throws RemoteException;
    void onError(String errorType, String message) throws RemoteException;
    IBinder asBinder();
}

interface IPrepareGetCredentialCallback {
    void onResponse(PrepareGetCredentialResponseInternal response) throws RemoteException;
    void onError(String errorType, String message) throws RemoteException;
}

interface IClearCredentialStateCallback {
    void onSuccess() throws RemoteException;
    void onError(String errorType, String message) throws RemoteException;
}

interface ISetEnabledProvidersCallback {
    void onResponse() throws RemoteException;
    void onError(String errorType, String message) throws RemoteException;
}

interface IGetCandidateCredentialsCallback {
}

/** android.credentials.ICredentialManager (android-16.0.0_r4 AIDL) and its generated Default. */
interface ICredentialManager {
    ICancellationSignal executeGetCredential(GetCredentialRequest request, IGetCredentialCallback callback,
            String callingPackage);
    ICancellationSignal executePrepareGetCredential(GetCredentialRequest request,
            IPrepareGetCredentialCallback prepareGetCredentialCallback, IGetCredentialCallback getCredentialCallback,
            String callingPackage);
    ICancellationSignal executeCreateCredential(CreateCredentialRequest request, ICreateCredentialCallback callback,
            String callingPackage);
    ICancellationSignal getCandidateCredentials(GetCredentialRequest request, IGetCandidateCredentialsCallback callback,
            IBinder clientCallback, String callingPackage);
    ICancellationSignal clearCredentialState(ClearCredentialStateRequest request, IClearCredentialStateCallback callback,
            String callingPackage);
    void setEnabledProviders(List<String> primaryProviders, List<String> providers, int userId,
            ISetEnabledProvidersCallback callback);
    void registerCredentialDescription(RegisterCredentialDescriptionRequest request, String callingPackage);
    void unregisterCredentialDescription(UnregisterCredentialDescriptionRequest request, String callingPackage);
    boolean isEnabledCredentialProviderService(ComponentName componentName, String callingPackage);
    List<CredentialProviderInfo> getCredentialProviderServices(int userId, int providerFilter);
    List<CredentialProviderInfo> getCredentialProviderServicesForTesting(int providerFilter);
    boolean isServiceEnabled();

    class Default implements ICredentialManager {
        public ICancellationSignal executeGetCredential(GetCredentialRequest request, IGetCredentialCallback callback,
                String callingPackage) { return null; }
        public ICancellationSignal executePrepareGetCredential(GetCredentialRequest request,
                IPrepareGetCredentialCallback prepareGetCredentialCallback,
                IGetCredentialCallback getCredentialCallback, String callingPackage) { return null; }
        public ICancellationSignal executeCreateCredential(CreateCredentialRequest request,
                ICreateCredentialCallback callback, String callingPackage) { return null; }
        public ICancellationSignal getCandidateCredentials(GetCredentialRequest request,
                IGetCandidateCredentialsCallback callback, IBinder clientCallback, String callingPackage) { return null; }
        public ICancellationSignal clearCredentialState(ClearCredentialStateRequest request,
                IClearCredentialStateCallback callback, String callingPackage) { return null; }
        public void setEnabledProviders(List<String> primaryProviders, List<String> providers, int userId,
                ISetEnabledProvidersCallback callback) { }
        public void registerCredentialDescription(RegisterCredentialDescriptionRequest request,
                String callingPackage) { }
        public void unregisterCredentialDescription(UnregisterCredentialDescriptionRequest request,
                String callingPackage) { }
        public boolean isEnabledCredentialProviderService(ComponentName componentName, String callingPackage) {
            return false;
        }
        public List<CredentialProviderInfo> getCredentialProviderServices(int userId, int providerFilter) {
            return null;
        }
        public List<CredentialProviderInfo> getCredentialProviderServicesForTesting(int providerFilter) {
            return null;
        }
        public boolean isServiceEnabled() { return false; }
    }
}

