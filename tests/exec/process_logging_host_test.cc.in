// The complete production waiter and exit mapper are inserted below. Win32
// child handles and CRT descriptors are controlled boundaries. The sink models
// each OS write as one operation and schedules a real competing app thread
// after its first operation, reproducing the observed stdio-prefix interleave.
#include <algorithm>
#include <climits>
#include <condition_variable>
#include <cstdarg>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <map>
#include <memory>
#include <mutex>
#include <string>
#include <thread>
#include <vector>

using DWORD = uint32_t;
using HANDLE = void*;
using jint = int32_t;
using jobject = void*;
struct JNIEnv {};
#define JNICALL
constexpr DWORD INFINITE = 0xffffffffu;
constexpr DWORD WAIT_OBJECT_0 = 0, ERROR_SUCCESS = 0;
constexpr DWORD PROCESS_QUERY_LIMITED_INFORMATION = 0x1000, SYNCHRONIZE = 0x100000;
[[maybe_unused]] constexpr bool FALSE = false;
constexpr bool kHasDuplicateWait = @HAS_DUPLICATE_WAIT@;
constexpr bool kHasSharedOwner = @HAS_SHARED_OWNER@;

namespace gesher::child_usage {
using Token = uint64_t;
struct Cpu { uint64_t user_100ns = 0, kernel_100ns = 0; };
DWORD Collect(Token token, Cpu* cpu, bool* consumed = nullptr) {
  if (!token || !cpu) std::abort();
  if (consumed) *consumed = true;
  return ERROR_SUCCESS;
}
DWORD AbandonReaped(Token) { std::abort(); }
}
bool CloseHandle(HANDLE handle);
struct ChildProcess {
  HANDLE process;
  gesher::child_usage::Token usage_token = 1;
  ChildProcess(HANDLE handle) : process(handle) {}
  ~ChildProcess() { if (kHasSharedOwner) CloseHandle(process); }
  operator HANDLE() const { return process; }
};
struct ChildRef : std::shared_ptr<ChildProcess> {
  ChildRef(HANDLE h) : std::shared_ptr<ChildProcess>(std::make_shared<ChildProcess>(h)) {}
  operator HANDLE() const { return get()->process; }
};

std::mutex g_mutex;
std::map<jint, ChildRef> g_children;
const HANDLE kChild = reinterpret_cast<HANDLE>(uintptr_t{0x101});
const HANDLE kOtherChild = reinterpret_cast<HANDLE>(uintptr_t{0x102});
const HANDLE kChildWait = reinterpret_cast<HANDLE>(uintptr_t{0x103});
const intptr_t kRedirectedSink = 0x201;
const char kAppRecord[] = "gesher-app: window \"GamePlay\": Win32 popup, input attached\n";

int checks = 0;
int failures = 0;
void Check(bool ok, const char* what) {
  ++checks;
  if (!ok) {
    ++failures;
    std::printf("FAIL process logging: %s\n", what);
  }
}

DWORD exit_code = 0;
int waits = 0;
int exit_queries = 0;
std::vector<HANDLE> closed;
int descriptor = 19;  // Deliberately not 2: a redirected CRT stream.
intptr_t sink_handle = kRedirectedSink;
int descriptor_queries = 0;
int handle_queries = 0;
int write_calls = 0;
int stdio_calls = 0;
bool sink_fails = false;
bool sink_short_write = false;
std::vector<std::string> writes;
std::mutex sink_mutex;
std::string combined_log;
std::mutex schedule_mutex;
std::condition_variable schedule_cv;
bool compete = false;
bool first_write = false;
bool app_done = false;

void Append(const std::string& text) {
  std::lock_guard<std::mutex> guard(sink_mutex);
  combined_log += text;
}

void AppWriter() {
  std::unique_lock<std::mutex> lock(schedule_mutex);
  schedule_cv.wait(lock, [] { return first_write; });
  lock.unlock();
  Append(kAppRecord);
  lock.lock();
  app_done = true;
  schedule_cv.notify_all();
}

void SinkWrite(const std::string& text) {
  writes.push_back(text);
  Append(text);
  std::unique_lock<std::mutex> lock(schedule_mutex);
  if (compete && !first_write) {
    first_write = true;
    schedule_cv.notify_all();
    schedule_cv.wait(lock, [] { return app_done; });
  }
}

HANDLE GetCurrentProcess() { return reinterpret_cast<HANDLE>(uintptr_t{0x99}); }
bool DuplicateHandle(HANDLE, HANDLE source, HANDLE, HANDLE* duplicate, DWORD rights, bool, DWORD) {
  Check(source == kChild && rights == (PROCESS_QUERY_LIMITED_INFORMATION | SYNCHRONIZE),
        "retains only wait/query access to the actual child");
  *duplicate = kChildWait;
  return true;
}
DWORD WaitForSingleObject(HANDLE handle, DWORD timeout) {
  Check(handle == (kHasDuplicateWait ? kChildWait : kChild) && timeout == INFINITE, "waits for the actual child");
  ++waits;
  return 0;
}

bool GetExitCodeProcess(HANDLE handle, DWORD* code) {
  Check(handle == (kHasDuplicateWait ? kChildWait : kChild) && waits == 1, "reads status after the child wait");
  ++exit_queries;
  *code = exit_code;
  return true;
}

bool CloseHandle(HANDLE handle) {
  closed.push_back(handle);
  return true;
}

[[maybe_unused]] int _fileno(FILE* stream) {
  Check(stream == stderr, "uses the actual CRT stderr stream");
  ++descriptor_queries;
  return descriptor;
}

[[maybe_unused]] intptr_t _get_osfhandle(int fd) {
  Check(fd == descriptor && fd >= 0, "uses the redirected descriptor, never an invalid descriptor");
  ++handle_queries;
  return sink_handle;
}

[[maybe_unused]] bool WriteFile(HANDLE handle, const void* data, DWORD count,
                               DWORD* written, void* overlapped) {
  Check(handle == reinterpret_cast<HANDLE>(kRedirectedSink), "writes to the redirected CRT handle");
  Check(overlapped == nullptr && written != nullptr, "uses a synchronous sink write");
  ++write_calls;
  *written = 0;
  if (sink_fails) return false;
  *written = sink_short_write ? std::min<DWORD>(count, 6) : count;
  SinkWrite(std::string(static_cast<const char*>(data), *written));
  return true;
}

// A single formatted stdio call need not be one OS write. It does not share a
// lock with the Java stdout writer. This split is the one observed in E2E:
// "gesher" + app record + ": exec pid ...".
[[maybe_unused]] int FragmentedFprintf(FILE* stream, const char* format, ...) {
  Check(stream == stderr, "legacy stdio also targets stderr");
  ++stdio_calls;
  char record[256];
  va_list args;
  va_start(args, format);
  int count = vsnprintf(record, sizeof(record), format, args);
  va_end(args);
  Check(count >= 6 && static_cast<size_t>(count) < sizeof(record), "legacy record fits fixture");
  SinkWrite(std::string(record, 6));
  SinkWrite(std::string(record + 6, static_cast<size_t>(count - 6)));
  return count;
}

[[maybe_unused]] int FixtureFlush(FILE*) { return 0; }

namespace ex {
@EXIT_STATUS@
}

#define fprintf FragmentedFprintf
#define fflush FixtureFlush
@WAIT_FOR_PROCESS_EXIT@
#undef fflush
#undef fprintf

void Reset() {
  g_children.clear();
  closed.clear();
  writes.clear();
  combined_log.clear();
  waits = exit_queries = descriptor_queries = handle_queries = write_calls = stdio_calls = 0;
  descriptor = 19;
  sink_handle = kRedirectedSink;
  sink_fails = sink_short_write = compete = first_write = app_done = false;
}

void CheckCleanup(jint pid, int status, int expected) {
  Check(status == expected, "returns the actual mapped status");
  Check(waits == 1 && exit_queries == 1, "waits and queries exactly once");
  Check(g_children.count(pid) == 0 && g_children.size() == 1 && g_children.at(7) == kOtherChild,
        "removes only the waited child");
  Check(closed.size() == (kHasDuplicateWait ? 2u : 1u) && closed[0] == kChild &&
        (!kHasDuplicateWait || closed[1] == kChildWait), "closes only owned child handles, never the borrowed sink");
}

void Case(jint pid, DWORD code, int expected) {
  Reset();
  g_children.emplace(pid, kChild);
  g_children.emplace(7, kOtherChild);
  exit_code = code;
  compete = true;
  std::thread app(AppWriter);
  int status = WaitForProcessExit(nullptr, nullptr, pid);
  // Release the fixture thread even if a producer regression emitted nothing.
  {
    std::lock_guard<std::mutex> lock(schedule_mutex);
    first_write = true;
    schedule_cv.notify_all();
  }
  app.join();
  CheckCleanup(pid, status, expected);
  std::string marker = "gesher: exec pid " + std::to_string(pid) + " exited with status "
                       + std::to_string(expected) + "\n";
  Check(combined_log.find(marker) != std::string::npos, "exact exit marker survives competing app output");
  Check(combined_log == marker + kAppRecord, "both full records survive without interleaving or truncation");
  Check(writes.size() == 1 && writes[0] == marker, "submits the whole newline-terminated record in one write");
  Check(write_calls == 1 && stdio_calls == 0, "avoids fragmented CRT formatting");
  Check(descriptor_queries == 1 && handle_queries == 1, "resolves the current redirected stderr sink");
}

int main() {
  Case(9180, 0, 0);
  Case(9181, 37, 37);
  Case(9182, 143, 143);
  Case(9183, 0xC0000005u, 139);
  Case(9184, 0x80000003u, 133);
  Case(INT_MAX, 0x7fffffffu, INT_MAX);
  Case(INT_MAX, 0x80000000u, INT_MIN);

  Reset();
  g_children.emplace(7, kOtherChild);
  Check(WaitForProcessExit(nullptr, nullptr, 9180) == 0, "preserves missing-child return");
  Check(waits == 0 && exit_queries == 0 && closed.empty() && writes.empty() &&
        descriptor_queries == 0 && handle_queries == 0 && g_children.size() == 1,
        "missing child performs no wait, close, diagnostic or map change");

  // A missing stream (-1), GUI process without a console (-2), invalid/null
  // native handle, failed write and short write remain best-effort diagnostics.
  for (int mode = 0; mode < 7; ++mode) {
    Reset();
    g_children.emplace(9180, kChild);
    g_children.emplace(7, kOtherChild);
    exit_code = 37;
    if (mode == 0) descriptor = -1;
    if (mode == 1) descriptor = -2;
    if (mode == 2) sink_handle = -1;
    if (mode == 3) sink_handle = -2;
    if (mode == 4) sink_handle = 0;
    if (mode == 5) sink_fails = true;
    if (mode == 6) sink_short_write = true;
    int status = WaitForProcessExit(nullptr, nullptr, 9180);
    CheckCleanup(9180, status, 37);
    Check(descriptor_queries == 1 && handle_queries == (mode < 2 ? 0 : 1),
          "guards a missing CRT stream before resolving its native handle");
    Check(write_calls == (mode < 5 ? 0 : 1), "skips invalid handles and never retries a failed or short write");
    Check(mode == 6 ? combined_log == "gesher" : combined_log.empty(),
          "sink errors never add a duplicate or fabricated success record");
  }

  std::printf("process logging: %d checks, %d failed\n", checks, failures);
  g_children.clear();  // Retire test-owned handles before the recording vector's destructor.
  return failures ? 1 : 0;
}
