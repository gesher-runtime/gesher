// Production mapping bookkeeping and admission with recording Win32 calls.
// Only the whole native reservation is retained; logical page ownership is
// decided by extracted production code. No bytes or file views are simulated.
#include <algorithm>
#include <cerrno>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <iterator>
#include <map>
#include <mutex>
#include <set>
#include <sstream>
#include <string>
#include <vector>

namespace {
using DWORD = uint32_t;
using ULONG = uint32_t;
using HANDLE = void*;
constexpr DWORD PAGE_NOACCESS = 1, PAGE_READONLY = 2, PAGE_READWRITE = 4,
    PAGE_EXECUTE_READ = 32, PAGE_EXECUTE_READWRITE = 64;
constexpr DWORD MEM_COMMIT = 0x1000, MEM_RESERVE = 0x2000, MEM_DECOMMIT = 0x4000, MEM_RELEASE = 0x8000,
    MEM_REPLACE_PLACEHOLDER = 0x4000, MEM_RESERVE_PLACEHOLDER = 0x40000,
    MEM_PRESERVE_PLACEHOLDER = 2, MEM_COALESCE_PLACEHOLDERS = 1;
constexpr int PROT_NONE = 0, PROT_READ = 1, PROT_WRITE = 2, PROT_EXEC = 4;
constexpr int MAP_SHARED = 1, MAP_PRIVATE = 2, MAP_FIXED = 0x10,
    MAP_ANONYMOUS = 0x20, MAP_FIXED_NOREPLACE = 0x100000;
void* const MAP_FAILED = reinterpret_cast<void*>(~uintptr_t{0});
constexpr size_t kPage = 4096;
constexpr uintptr_t kBase = 0x10000000;
int checks = 0, failures = 0;
void Check(bool value, const char* name) {
  ++checks;
  if (!value) { ++failures; std::fprintf(stderr, "FAIL %s\n", name); }
}
struct SYSTEM_INFO { DWORD dwPageSize; DWORD dwAllocationGranularity; };
void GetSystemInfo(SYSTEM_INFO* info) { *info = {kPage, 65536}; }
int GetCurrentProcess() { return 1; }
struct NativeCall {
  std::string operation;
  uintptr_t address;
  size_t length;
  DWORD flags;
  DWORD protection;
};
std::vector<NativeCall> calls;
bool fail_reserve = false, fail_replace = false, fail_commit = false, placeholders = true;
uintptr_t failing_unmap_address = 0;
DWORD native_error = 0;
std::map<uintptr_t, size_t> plain_reservations;
void* VirtualAlloc(void* address, size_t length, DWORD flags, DWORD protection) {
  const uintptr_t at = address == nullptr ? kBase : reinterpret_cast<uintptr_t>(address);
  calls.push_back({"plain-alloc", at, length, flags, protection});
  if ((flags & MEM_RESERVE) != 0) {
    if (fail_reserve) return nullptr;
    for (const auto& [start, size] : plain_reservations) {
      if (at < start + size && start < at + length) return nullptr;
    }
    plain_reservations.emplace(at, length);
    return reinterpret_cast<void*>(at);
  }
  if (fail_commit) return nullptr;
  for (const auto& [start, size] : plain_reservations) {
    if (at >= start && at + length <= start + size) return reinterpret_cast<void*>(at);
  }
  return nullptr;
}
bool VirtualFree(void* address, size_t length, DWORD flags) {
  calls.push_back({"free", reinterpret_cast<uintptr_t>(address), length, flags, 0});
  if (reinterpret_cast<uintptr_t>(address) == failing_unmap_address &&
      flags == (MEM_RELEASE | MEM_PRESERVE_PLACEHOLDER)) {
    native_error = EACCES;
    return false;
  }
  if (flags == MEM_RELEASE) plain_reservations.erase(reinterpret_cast<uintptr_t>(address));
  return true;
}
bool VirtualProtect(void* address, size_t length, DWORD protection, DWORD* old) {
  calls.push_back({"protect", reinterpret_cast<uintptr_t>(address), length, 0, protection});
  *old = PAGE_READWRITE;
  return true;
}
bool UnmapViewOfFile(void* address) {
  calls.push_back({"unmap", reinterpret_cast<uintptr_t>(address), 0, 0, 0});
  return true;
}
bool CloseHandle(HANDLE handle) {
  calls.push_back({"close", reinterpret_cast<uintptr_t>(handle), 0, 0, 0});
  return true;
}
struct PlaceholderBoundary {
  bool available() const { return placeholders; }
  void* alloc2(int, void* address, size_t length, DWORD flags, DWORD protection, void*, int) const {
    calls.push_back({"alloc", reinterpret_cast<uintptr_t>(address), length, flags, protection});
    bool replacement = (flags & MEM_REPLACE_PLACEHOLDER) != 0;
    if (replacement ? fail_replace : fail_reserve) return nullptr;
    return address != nullptr ? address : reinterpret_cast<void*>(kBase);
  }
  bool unmap2(int, void* address, DWORD flags) const {
    calls.push_back({"unmap", reinterpret_cast<uintptr_t>(address), 0, flags, 0});
    return true;
  }
};
const PlaceholderBoundary& Placeholders() { static PlaceholderBoundary boundary; return boundary; }
// MapAnonymous reports a plain MAP_FIXED that already decommitted its pages
// (the loader's shared-copy bookkeeping reads it) and maps Win32 errors.
thread_local bool g_mmap_replaced_private_pages = false;
DWORD GetLastError() { return native_error; }
namespace gesher {
int ErrnoFromWin32(DWORD error) { return error == 0 ? EINVAL : static_cast<int>(error); }
inline int FailWithLastError() { errno = ErrnoFromWin32(GetLastError()); return -1; }
}  // namespace gesher

@TYPES@

// Route the extracted public munmap to each fixture's isolated registry.
State* active_state = nullptr;
State& state() { return *active_state; }
#define TRACE(...) ((void)0)

// Partial file-view remapping is outside this anonymous fixture. A NOREPLACE
// collision must fail admission before this boundary can ever be reached.
std::map<uintptr_t, Region>::iterator PunchView(State& s,
    std::map<uintptr_t, Region>::iterator, uintptr_t, uintptr_t) {
  Check(false, "NOREPLACE cannot punch a partial live file view");
  return s.regions.end();
}

// Unmap's locked-file-view rollback is also outside this anonymous fixture.
// Fail if a test reaches it; do not simulate successful file locking/unlocking.
struct MEMORY_BASIC_INFORMATION { DWORD Protect; };
template <typename Fn>
bool ForEachRun(void*, size_t, Fn) {
  Check(false, "NOREPLACE fixture cannot query partial locked file views");
  return false;
}
inline bool UnlockGuestPages(State&, uintptr_t, uintptr_t) {
  Check(false, "NOREPLACE fixture cannot unlock partial file views");
  return false;
}
inline bool LockNewPages(State&, std::set<uintptr_t>&) {
  Check(false, "NOREPLACE fixture cannot restore file-view locks");
  return false;
}

@PRODUCTION@

std::string Snapshot(const State& state) {
  std::ostringstream out;
  for (const auto& [address, region] : state.regions) {
    out << address << ':' << region.size << ':' << static_cast<int>(region.kind)
        << ':' << region.group << ':' << region.live_pages << ':' << region.offset << ':';
    for (bool live : region.live) out << live;
    out << ':';
    for (Origin origin : region.origins) out << static_cast<int>(origin) << ',';
    out << ';';
  }
  for (const auto& [address, length] : state.groups) out << 'g' << address << ':' << length << ';';
  return out.str();
}
void ResetBoundary() {
  calls.clear(); plain_reservations.clear();
  fail_reserve = fail_replace = fail_commit = false;
  failing_unmap_address = 0; native_error = 0;
  placeholders = true; errno = 0;
}
void Prepare(State& state, int protection = PROT_READ | PROT_WRITE) {
  ResetBoundary();
  void* value = GroupAnonymous(state, reinterpret_cast<void*>(kBase), 4 * kPage,
                              protection, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE);
  Check(value == reinterpret_cast<void*>(kBase), "initial exact placeholder group created");
  calls.clear();
}
bool AllPages(const Region& region, bool live, Origin origin) {
  return region.live.size() == region.origins.size() &&
      std::all_of(region.live.begin(), region.live.end(), [live](bool value) { return value == live; }) &&
      std::all_of(region.origins.begin(), region.origins.end(), [origin](Origin value) { return value == origin; });
}
void RejectUnchanged(State& state, uintptr_t address, size_t length, int flags, const char* name) {
  const std::string before = Snapshot(state);
  calls.clear(); errno = 0;
  void* value = GroupAnonymous(state, reinterpret_cast<void*>(address), length, PROT_NONE, flags);
  Check(value == MAP_FAILED && errno == EEXIST, name);
  Check(Snapshot(state) == before && calls.empty(), "collision rejects entire request before native or registry mutation");
}
void ArtFallback() {
  State state;
  Prepare(state);
  // mremap without DONTUNMAP retires a prefix; its group's live tail remains.
  // munmap uses this exact production Punch operation for grouped allocations.
  Punch(state, kBase, kBase + 2 * kPage);
  Check(state.regions.at(kBase).kind == Kind::kHole &&
        state.regions.at(kBase + 2 * kPage).kind == Kind::kAnon,
        "partial retirement leaves logical hole and live group tail");
  const Region tail = state.regions.at(kBase + 2 * kPage);
  calls.clear(); errno = 0;
  void* restored = GroupAnonymous(state, reinterpret_cast<void*>(kBase), 2 * kPage, PROT_NONE,
                                  MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE);
  Check(restored == reinterpret_cast<void*>(kBase), "ART fallback reserves vacated source exactly");
  Check(calls.size() == 1 && calls[0].operation == "alloc" && calls[0].address == kBase &&
        calls[0].length == 2 * kPage && calls[0].flags == (MEM_RESERVE | MEM_REPLACE_PLACEHOLDER) &&
        calls[0].protection == PAGE_NOACCESS, "vacated source becomes reserved PROT_NONE without a new allocation");
  const Region& replacement = state.regions.at(kBase);
  Check(replacement.kind == Kind::kAnon && AllPages(replacement, true, Origin::kPrivateAnonymous),
        "PROT_NONE replacement is a live anonymous Linux mapping");
  const Region& retained = state.regions.at(kBase + 2 * kPage);
  Check(retained.kind == tail.kind && retained.size == tail.size && retained.live == tail.live &&
        retained.origins == tail.origins, "ART fallback preserves remaining group tail");
  RejectUnchanged(state, kBase, 2 * kPage, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE,
                  "newly reserved PROT_NONE mapping prevents a second NOREPLACE");
}
void Collisions() {
  for (int protection : {PROT_NONE, PROT_READ | PROT_WRITE}) {
    for (int fixed : {MAP_FIXED_NOREPLACE, MAP_FIXED | MAP_FIXED_NOREPLACE}) {
      State state; Prepare(state, protection);
      RejectUnchanged(state, kBase, 2 * kPage, MAP_PRIVATE | MAP_ANONYMOUS | fixed,
                      "live mapping rejects NOREPLACE including combined FIXED flags");
      Punch(state, kBase, kBase + kPage);
      RejectUnchanged(state, kBase, 2 * kPage, MAP_PRIVATE | MAP_ANONYMOUS | fixed,
                      "mixed hole/live range rejects atomically");
      RejectUnchanged(state, kBase + kPage, 3 * kPage, MAP_PRIVATE | MAP_ANONYMOUS | fixed,
                      "live suffix rejects NOREPLACE");
    }
  }
  State view; Prepare(view);
  view.regions.at(kBase).kind = Kind::kView;
  RejectUnchanged(view, kBase + kPage, kPage, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE,
                  "live file-view collision rejects before PunchView");
}
void FragmentedHoles() {
  for (int fixed : {MAP_FIXED_NOREPLACE, MAP_FIXED | MAP_FIXED_NOREPLACE}) {
    State state; Prepare(state);
    Punch(state, kBase, kBase + kPage);
    Punch(state, kBase + kPage, kBase + 2 * kPage);
    calls.clear();
    void* value = GroupAnonymous(state, reinterpret_cast<void*>(kBase), 2 * kPage, PROT_READ,
                                MAP_PRIVATE | MAP_ANONYMOUS | fixed);
    Check(value == reinterpret_cast<void*>(kBase), "adjacent unmapped fragments accept exact NOREPLACE");
    Check(state.regions.size() == 2 && state.regions.at(kBase).size == 2 * kPage,
          "actual Punch coalesces accepted hole fragments");
    Check(calls.size() == 2 && calls[0].operation == "free" &&
          calls[0].flags == (MEM_RELEASE | MEM_COALESCE_PLACEHOLDERS) &&
          calls[1].operation == "alloc", "coalesce precedes replacement only after complete admission");
  }
  State inside; Prepare(inside);
  Punch(inside, kBase, kBase + 3 * kPage);
  void* value = GroupAnonymous(inside, reinterpret_cast<void*>(kBase + kPage), kPage, PROT_READ,
                              MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE);
  Check(value == reinterpret_cast<void*>(kBase + kPage), "interior portion of a hole maps at the requested address");
  Check(inside.regions.at(kBase).kind == Kind::kHole &&
        inside.regions.contains(kBase + 2 * kPage) &&
        inside.regions.at(kBase + 2 * kPage).kind == Kind::kHole &&
        inside.regions.at(kBase + 3 * kPage).kind == Kind::kAnon,
        "interior hole split preserves both unmapped neighbors and live tail");
}
void ExistingBehaviorAndFailure() {
  State replace; Prepare(replace, PROT_NONE);
  calls.clear();
  void* value = GroupAnonymous(replace, reinterpret_cast<void*>(kBase), 2 * kPage,
                              PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED);
  Check(value == reinterpret_cast<void*>(kBase) && calls.size() == 2 &&
        calls[0].operation == "free" && calls[1].operation == "alloc",
        "ordinary MAP_FIXED still replaces existing live pages");

  State external;
  ResetBoundary(); fail_reserve = true;
  value = GroupAnonymous(external, reinterpret_cast<void*>(kBase), kPage, PROT_READ,
                         MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE);
  Check(value == MAP_FAILED && errno == EEXIST && external.regions.empty(),
        "native reservation collision returns EEXIST without publication");
  Check(calls.size() == 1 && calls[0].address == kBase,
        "native reservation collision cannot fall back to another address");

  State failure; Prepare(failure);
  Punch(failure, kBase, kBase + 2 * kPage);
  const std::string before = Snapshot(failure);
  calls.clear(); fail_replace = true;
  value = GroupAnonymous(failure, reinterpret_cast<void*>(kBase), 2 * kPage, PROT_READ,
                         MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE);
  Check(value == MAP_FAILED && errno == ENOMEM && Snapshot(failure) == before,
        "failed replacement retains hole and live group tail without publication");
  Check(calls.size() == 1 && calls[0].operation == "alloc", "failed replacement cannot release a live group");
  ResetBoundary();
}

void PreparePlain(State& value, int protection = PROT_READ | PROT_WRITE) {
  ResetBoundary();
  placeholders = false;
  active_state = &value;
  void* mapped = MapAnonymous(value, reinterpret_cast<void*>(kBase), 8 * kPage,
                              protection, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE);
  Check(mapped == reinterpret_cast<void*>(kBase) && value.regions.at(kBase).group == 0,
        "plain reservation created through production MapAnonymous");
  calls.clear();
}

void RetirePlain(State& value, size_t first, size_t pages) {
  active_state = &value;
  calls.clear();
  Check(munmap(reinterpret_cast<void*>(kBase + first * kPage), pages * kPage) == 0,
        "production munmap retires a plain subrange");
  Check(calls.size() == 1 && calls[0].operation == "free" &&
        calls[0].address == kBase + first * kPage && calls[0].length == pages * kPage &&
        calls[0].flags == MEM_DECOMMIT && plain_reservations.at(kBase) == 8 * kPage,
        "partial plain unmap decommits only requested pages and keeps native reservation");
  const Region& region = value.regions.at(kBase);
  Check(std::none_of(region.live.begin() + first, region.live.begin() + first + pages,
                     [](bool live) { return live; }),
        "production munmap records logical holes independently of native reservation");
  calls.clear();
}

void RejectPlainUnchanged(State& value, uintptr_t address, size_t length, int flags,
                          const char* label) {
  const std::string before = Snapshot(value);
  const auto native_before = plain_reservations;
  calls.clear(); errno = 0;
  void* mapped = MapAnonymous(value, reinterpret_cast<void*>(address), length,
                              PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | flags);
  Check(mapped == MAP_FAILED && errno == EEXIST, label);
  Check(Snapshot(value) == before && plain_reservations == native_before && calls.empty(),
        "plain collision rejects the whole range without native or registry mutation");
}

void PlainHoleReuse() {
  for (bool api_available : {false, true}) {
    for (int fixed : {MAP_FIXED_NOREPLACE, MAP_FIXED | MAP_FIXED_NOREPLACE}) {
      for (int protection : {PROT_NONE, PROT_READ | PROT_WRITE}) {
        State value; PreparePlain(value);
        RetirePlain(value, 0, 2);
        const auto reservation = plain_reservations;
        placeholders = api_available;
        void* mapped = MapAnonymous(value, reinterpret_cast<void*>(kBase), 2 * kPage,
                                    protection, MAP_PRIVATE | MAP_ANONYMOUS | fixed);
        Check(mapped == reinterpret_cast<void*>(kBase),
              "plain logical hole reused exactly with either fixed flag and API availability");
        const bool expected_calls = protection == PROT_NONE ? calls.empty() :
            calls.size() == 1 && calls[0].operation == "plain-alloc" &&
            calls[0].address == kBase && calls[0].length == 2 * kPage &&
            calls[0].flags == MEM_COMMIT && calls[0].protection == PAGE_READWRITE;
        Check(expected_calls && plain_reservations == reservation,
              "plain hole reuse only commits its pages without releasing or replacing the reservation");
        const Region& region = value.regions.at(kBase);
        Check(region.live_pages == 8 && AllPages(region, true, Origin::kPrivateAnonymous) &&
              value.regions.size() == 1 && value.groups.empty(),
              "plain hole reuse publishes liveness and origin while retaining the live tail");
        RejectPlainUnchanged(value, kBase, kPage, fixed,
                             "reused PROT_NONE or accessible plain page blocks a second NOREPLACE");
      }
    }
  }
}

void PlainCollisionsAndFailure() {
  for (bool api_available : {false, true}) {
    for (int fixed : {MAP_FIXED_NOREPLACE, MAP_FIXED | MAP_FIXED_NOREPLACE}) {
      for (int protection : {PROT_NONE, PROT_READ | PROT_WRITE}) {
        State value; PreparePlain(value, protection);
        placeholders = api_available;
        RejectPlainUnchanged(value, kBase, 2 * kPage, fixed,
                             "live plain pages including PROT_NONE reject NOREPLACE");
        RetirePlain(value, 1, 2);
        RejectPlainUnchanged(value, kBase + kPage, 3 * kPage, fixed,
                             "plain hole followed by a live page rejects atomically");
        RejectPlainUnchanged(value, kBase, 3 * kPage, fixed,
                             "plain live page followed by holes rejects atomically");
        const std::string before = Snapshot(value);
        const auto native_before = plain_reservations;
        calls.clear(); fail_commit = true; errno = 0;
        void* mapped = MapAnonymous(value, reinterpret_cast<void*>(kBase + kPage), 2 * kPage,
                                    PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | fixed);
        Check(mapped == MAP_FAILED && errno == ENOMEM && Snapshot(value) == before &&
              plain_reservations == native_before,
              "failed plain recommit leaves holes and all live neighbours unchanged");
        Check(calls.size() == 1 && calls[0].operation == "plain-alloc" &&
              calls[0].address == kBase + kPage && calls[0].length == 2 * kPage &&
              calls[0].flags == MEM_COMMIT,
              "failed plain recommit never decommits, releases or relocates any page");
        fail_commit = false;
      }
    }
  }

  State adjacent; PreparePlain(adjacent);
  RetirePlain(adjacent, 1, 1);
  RetirePlain(adjacent, 2, 2);
  void* joined = MapAnonymous(adjacent, reinterpret_cast<void*>(kBase + kPage), 3 * kPage,
                              PROT_READ, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE);
  Check(joined == reinterpret_cast<void*>(kBase + kPage) && adjacent.regions.at(kBase).live_pages == 8,
        "adjacent plain holes are reusable in one exact mapping");
  Check(calls.size() == 1 && calls[0].operation == "plain-alloc" &&
        calls[0].address == kBase + kPage && calls[0].length == 3 * kPage &&
        calls[0].flags == MEM_COMMIT && calls[0].protection == PAGE_READONLY,
        "adjacent plain hole reuse preserves both live neighbours and requested protection");

  State replace; PreparePlain(replace);
  void* mapped = MapAnonymous(replace, reinterpret_cast<void*>(kBase + kPage), kPage,
                              PROT_READ, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED);
  Check(mapped == reinterpret_cast<void*>(kBase + kPage) && calls.size() == 2 &&
        calls[0].operation == "free" && calls[0].flags == MEM_DECOMMIT &&
        calls[1].operation == "plain-alloc" && calls[1].flags == MEM_COMMIT,
        "ordinary plain MAP_FIXED retains existing page replacement behavior");
  ResetBoundary();
  active_state = nullptr;
}
void UnmapFailureCleanup() {
  State value;
  Prepare(value);
  // A separate new placeholder reservation starts at allocation granularity.
  const uintptr_t second = kBase + value.granularity;
  Check(GroupAnonymous(value, reinterpret_cast<void*>(second), 4 * kPage,
          PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE)
      == reinterpret_cast<void*>(second), "second unmap group created");
  active_state = &value;
  failing_unmap_address = second;
  Check(munmap(reinterpret_cast<void*>(kBase), second - kBase + 4 * kPage) == -1 && errno == EACCES,
        "later native unmap failure and its errno reach the caller");
  Check(!value.groups.contains(kBase),
        "later failure still releases an earlier successfully emptied group");
  Check(value.regions.at(second).kind == Kind::kAnon && value.regions.at(second).live_pages == 4,
        "failed unmap retains the later mapping and its bookkeeping");
  failing_unmap_address = 0;
  Check(munmap(reinterpret_cast<void*>(second), 4 * kPage) == 0 && value.groups.empty(),
        "retry releases the remaining group without leaking reservations");
  active_state = nullptr;

  State holes;
  Prepare(holes);
  Punch(holes, kBase, kBase + 4 * kPage);
  active_state = &holes;
  Check(munmap(reinterpret_cast<void*>(kBase), 4 * kPage) == 0 && holes.groups.empty(),
        "unmapping an all-hole group releases its empty reservation");
  active_state = nullptr;
}

template <typename Registry>
void LockedViewPreflight() {
  Registry value;
  if constexpr (requires { value.locked_pages; }) {
    Prepare(value);
    value.regions.at(kBase).kind = Kind::kView;
    value.locked_pages.insert(kBase);
    const std::string before = Snapshot(value);
    calls.clear(); errno = 0;
    Check(Punch(value, kBase + 3 * kPage, kBase + 4 * kPage) == value.regions.end()
              && errno == EOPNOTSUPP,
          "unsupported partial view replacement reports failure before touching retained locks");
    Check(Snapshot(value) == before && value.locked_pages.contains(kBase) && calls.empty(),
          "partial view rejection leaves retained mapping and locks unchanged");
  }
}

}  // namespace

int main() {
  UnmapFailureCleanup();
  LockedViewPreflight<State>();
  ArtFallback();
  Collisions();
  FragmentedHoles();
  ExistingBehaviorAndFailure();
  PlainHoleReuse();
  PlainCollisionsAndFailure();
  std::printf("mmap NOREPLACE contracts: %d checks, %d failures\n", checks, failures);
  return failures == 0 ? 0 : 1;
}
