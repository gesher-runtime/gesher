  JavaSelf object;
  JavaSelf* self_ = &object;
  struct { int width = 1, height = 1; } enc_params_;
  std::mutex mu_;
  std::condition_variable cv_;
  bool started_ = true, surface_eos_ = false;
  std::deque<std::shared_ptr<VideoFrame>> surface_frames_;
@CODEC_RENDER@
@CODEC_INPUT@
};
class VideoClock {
