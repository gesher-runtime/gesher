namespace media {
using jobject = void*;
static std::map<std::string, int64_t> posted;
static int events;
struct JNIEnv {
  jobject NewLocalRef(jobject value) { return value; }
  void DeleteLocalRef(jobject) {}
  void CallVoidMethod(jobject, int, int, int, int, jobject) { ++events; }
};
static JNIEnv env;
static JNIEnv* AttachedEnv(const char*) { return &env; }
static void CheckException(JNIEnv*, const char*) {}
static struct { int post_event = 1; } gJ;
static constexpr int kEventFrameRendered = 3;
struct JavaMap {
  std::map<std::string, int64_t> longs;
  jobject Make(JNIEnv*) { posted = longs; return this; }
};
struct JavaSelf { jobject get() { return this; } };
struct VideoFrame {
  int64_t time_us;
  void Allocate(int, int) {}
};
static void RgbaToI420(const uint32_t*, int, int, VideoFrame*) {}
class CodecProbe {
