  bool clock_running_ = true;
  float speed_ = 1.5f;
@PLAYER_ANCHOR@
  VideoClock() { @PLAYER_START@ }
@PLAYER_CLOCK@
};
}

static void Reset() {
  awake = 10000000000LL; suspended = 40000000000LL; wall = 1700000000000000000LL;
  waits.clear(); actions.clear(); errno = EDOM;
}
static int64_t GuestTime(int id) {
  guest::LinuxTimespec value{};
  Check("guest clock read succeeds", guest::ClockGettime(id, &value) == 0);
  return value.tv_sec * 1000000000 + value.tv_nsec;
}
static void Readers() {
  Reset();
  Check("Win32 units are converted without losing the epoch", gesher::MonotonicNanos() == awake);
  Check("BOOTTIME includes historical suspend", gesher::BoottimeNanos() == awake + suspended);
  for (int id : {1, 4, 6}) Check("all guest monotonic clocks share awake domain", GuestTime(id) == awake);
  Check("guest BOOTTIME uses biased interrupt time", GuestTime(7) == awake + suspended);
  Check("guest wall and CPU domains remain distinct", GuestTime(0) == wall && GuestTime(2) == 300 && GuestTime(3) == 200);
  const int64_t original_mono = GuestTime(1), original_boot = GuestTime(7);
  suspended += 3600000000000LL; wall -= 9000000000000LL;
  Check("system suspend leaves uptime unchanged", GuestTime(1) == original_mono);
  Check("system suspend advances BOOTTIME independently of UTC", GuestTime(7) - original_boot == 3600000000000LL);
  Check("ART nanoseconds use Android uptime", art::NanoTime() == static_cast<uint64_t>(awake));
  Check("ART milliseconds and microseconds retain units", art::MicroTime() == static_cast<uint64_t>(awake / 1000) &&
        art::MilliTime() == static_cast<uint64_t>(awake / 1000000));
  Check("libutils uptime agrees with ART and guest", systemTime(SYSTEM_TIME_MONOTONIC) == awake);
  Check("libutils elapsedRealtime includes suspend", systemTime(SYSTEM_TIME_BOOTTIME) == awake + suspended);
  Check("SystemClock JNI uptime reaches the correct domain", android::uptimeNanos() == awake &&
        android::uptimeMillis() == awake / 1000000);
  Check("SystemClock JNI elapsedRealtime reaches the correct domain", android::elapsedRealtimeNano() == awake + suspended &&
        android::elapsedRealtime() == (awake + suspended) / 1000000);
  Check("libutils realtime and CPU clocks are unchanged", systemTime(SYSTEM_TIME_REALTIME) == wall &&
        systemTime(SYSTEM_TIME_PROCESS) == 300 && systemTime(SYSTEM_TIME_THREAD) == 200);
  timespec native{}; HostClock(CLOCK_MONOTONIC, &native);
  Check("host winpthreads keeps its independent epoch", Nanos(native) == host_epoch + awake + suspended);
  timespec invalid{12, 34}; errno = 0;
  Check("explicit adapter validates null output", gesher::AndroidClockGettime(CLOCK_MONOTONIC, nullptr) == -1 && errno == EFAULT);
  Check("explicit adapter preserves unsupported clock behavior", gesher::AndroidClockGettime(999, &invalid) == -1 &&
        errno == EINVAL && invalid.tv_sec == 12 && invalid.tv_nsec == 34);
  Check("100ns conversion saturates before signed overflow", gesher::InterruptTicksToNanos(UINT64_MAX) == INT64_MAX);
}
static void Deadlines() {
  Reset();
  timespec expected; art::InitTimeSpec(true, CLOCK_MONOTONIC, 1234, 567890, &expected);
  Check("ART absolute deadline shares reader origin", Nanos(expected) == awake + 1234567890);
  guest::LinuxTimespec guest_deadline{expected.tv_sec, expected.tv_nsec};
  Check("guest pthread absolute deadline shares ART origin", guest::MillisUntil(&guest_deadline, true) == 1235);
  futex::Deadline deadline;
  Check("futex accepts ART absolute deadline", futex::SetDeadline(&expected, FUTEX_WAIT_BITSET, false, &deadline));
  Check("futex has correct initial remaining time", futex::Remaining(deadline) == 1235);
  const auto native_deadline = gesher::DeadlineAfter(1234);
  suspended += 600000000000LL; wall += 600000000000LL;
  Check("guest pthread timeout ignores suspend", guest::MillisUntil(&guest_deadline, true) == 1235);
  Check("futex timeout ignores suspend", futex::Remaining(deadline) == 1235);
  Check("internal poll/sleep budget ignores suspend", gesher::MillisUntil(native_deadline) == 1234);
  awake += 1000000000;
  Check("futex deadline advances with awake time", futex::Remaining(deadline) == 235);
  Check("internal poll/sleep budget advances with awake time", gesher::MillisUntil(native_deadline) == 234);
  art::InitTimeSpec(true, CLOCK_REALTIME, 3, 0, &expected);
  Check("absolute realtime deadlines preserve wall origin", Nanos(expected) == wall + 3000000);
}
static void Sleeps() {
  for (int clock : {0, 1, 7}) {
    Reset();
    guest::LinuxTimespec request{1, 0}, remain{99, 99};
    actions = {{0, 0, 0, 0, false, ENOMEM}};
    Check("wait registration failure preserves error, errno and remainder",
          guest::ClockNanosleep(clock, 0, &request, &remain) == ENOMEM && errno == EDOM &&
          remain.tv_sec == 99 && remain.tv_nsec == 99 && waits.size() == 1);
  }
  for (int clock : {0, 1, 7}) {
    Reset();
    guest::LinuxTimespec request{3, 0}, remain{99, 99};
    actions = {{1000000000, 10000000000LL, -30000000000LL, 0, false}};
    Check("relative sleep succeeds across simulated suspend", guest::ClockNanosleep(clock, 0, &request, &remain) == 0);
    Check("relative sleep preserves errno and untouched remainder", errno == EDOM && remain.tv_sec == 99 && remain.tv_nsec == 99);
    Check("BOOTTIME completes after resume while uptime waits awake remainder",
          clock == 7 ? waits.size() == 1 : waits == std::vector<uint32_t>{3000, 2000});
  }
  Reset();
  guest::LinuxTimespec request{10, 0}, remain{};
  actions = {{500000000, 3000000000LL, 0, 2000000000, true}};
  Check("interrupted BOOTTIME sleep reports EINTR", guest::ClockNanosleep(7, 0, &request, &remain) == EINTR);
  Check("BOOTTIME remainder uses its own domain before the handler", remain.tv_sec == 6 && remain.tv_nsec == 500000000);
  Reset(); request = {awake / 1000000000 + 2, 0};
  actions = {{0, 60000000000LL, 0, 0, false}};
  Check("absolute uptime ignores suspend", guest::ClockNanosleep(1, 1, &request, nullptr) == 0 &&
        waits == std::vector<uint32_t>{2000, 2000});
}
static void AudioPacing() {
  Reset(); audio::Probe source; audio::Clock sink; std::vector<float> samples;
  Check("paced source starts", source.Start());
  awake += 20000000;
  Check("source produces known awake interval", source.Pull(&samples) && samples.size() == 20);
  Check("sink consumes known awake interval", sink.Due(1000) == 20);
  Check("audio timestamp is in the Android monotonic domain", audio::MonotonicNs() == awake);
  suspended += 3600000000000LL; wall += 3600000000000LL;
  Check("source does not allocate an hour of suspended samples", source.Pull(&samples) && samples.size() == 20);
  Check("sink does not consume suspended audio", sink.Due(1000) == 20);
  awake += 5000000;
  Check("source resumes its awake timeline", source.Pull(&samples) && samples.size() == 25);
  Check("sink resumes its awake timeline", sink.Due(1000) == 25);
}
static void MediaClocks() {
  Reset(); media::CodecProbe codec; media::VideoClock video;
  codec.PostFrameRendered(12345);
  Check("frame callback preserves the media timestamp", media::events == 1 && media::posted["0-media-time-us"] == 12345);
  Check("frame callback system-nano agrees with ART", media::posted["0-system-nano"] == static_cast<int64_t>(art::NanoTime()));
  codec.OnSurfaceFrame(nullptr, 1, 1, 0);
  Check("missing input timestamp uses Android monotonic time", codec.surface_frames_.back()->time_us == awake / 1000);
  codec.OnSurfaceFrame(nullptr, 1, 1, 9123456789LL);
  Check("explicit input timestamp remains untouched", codec.surface_frames_.back()->time_us == 9123456);
  awake += 20000000;
  Check("video-only media clock advances with speed", video.WallClockLocked() == 130000);
  suspended += 3600000000000LL; wall -= 9000000000000LL;
  codec.PostFrameRendered(54321);
  codec.OnSurfaceFrame(nullptr, 1, 1, -1);
  Check("frame callback excludes suspend", media::posted["0-system-nano"] == awake);
  Check("input fallback excludes suspend", codec.surface_frames_.back()->time_us == awake / 1000);
  Check("video-only clock does not skip suspended playback", video.WallClockLocked() == 130000);
  awake += 10000000;
  Check("video-only clock resumes awake playback", video.WallClockLocked() == 145000);
  video.clock_running_ = false;
  Check("paused media clock retains its stored position", video.WallClockLocked() == 100000);
}
int main() {
  Readers(); Deadlines(); Sleeps(); AudioPacing(); MediaClocks();
  std::printf("clock domains: %d assertions, %d failures\n", checks, failures);
  return failures != 0;
}
