using DWORD = uint32_t;
using LONGLONG = int64_t;
using ULONGLONG = unsigned long long;
struct LARGE_INTEGER { int64_t QuadPart; };
static constexpr DWORD INFINITE = 0xffffffff;
static int64_t awake = 10000000000LL, suspended = 40000000000LL;
static int64_t wall = 1700000000000000000LL;
static constexpr int64_t host_epoch = 700000000000LL;
struct HostSteadyClock {
  using duration = std::chrono::nanoseconds;
  using time_point = std::chrono::time_point<HostSteadyClock, duration>;
  static time_point now() { return time_point(duration(host_epoch + awake + suspended)); }
};
static void QueryUnbiasedInterruptTimePrecise(ULONGLONG* value) { *value = awake / 100; }
static void QueryInterruptTimePrecise(ULONGLONG* value) { *value = (awake + suspended) / 100; }
static bool QueryPerformanceFrequency(LARGE_INTEGER* value) { value->QuadPart = 1000000000; return true; }
static bool QueryPerformanceCounter(LARGE_INTEGER* value) {
  value->QuadPart = host_epoch + awake + suspended; return true;
}
static int HostClock(clockid_t clock, timespec* value) {
  if (!value) return errno = EFAULT, -1;
  int64_t now;
  if (clock == CLOCK_MONOTONIC) now = host_epoch + awake + suspended;
  else if (clock == CLOCK_REALTIME) now = wall;
  else if (clock == CLOCK_PROCESS_CPUTIME_ID) now = 300;
  else if (clock == CLOCK_THREAD_CPUTIME_ID) now = 200;
  else return errno = EINVAL, -1;
  *value = {now / 1000000000, static_cast<long>(now % 1000000000)};
  return 0;
}
#define clock_gettime HostClock
#include <gesher/clocks.h>
#define BIONIC_SYSV

static int checks, failures;
static void Check(const char* name, bool ok) {
  ++checks;
  if (!ok) { ++failures; std::printf("FAIL clock domains: %s\n", name); }
}
static int64_t Nanos(timespec value) { return value.tv_sec * 1000000000 + value.tv_nsec; }
struct Action { int64_t awake_ns, suspend_ns, wall_step_ns, handler_ns; bool interrupted; int error = 0; };
static std::vector<Action> actions;
static std::vector<uint32_t> waits;

namespace guest {
struct LinuxTimespec { int64_t tv_sec, tv_nsec; };
static constexpr int kEINVAL = EINVAL, kEFAULT = EFAULT, kEINTR = EINTR, kEOPNOTSUPP = EOPNOTSUPP;
static LinuxTimespec RealtimeNow() { return {wall / 1000000000, wall % 1000000000}; }
static int64_t ThreadCpuNanos() { return 200; }
static int64_t ProcessCpuNanos() { return 300; }
static int ReadPthreadCpuClock(int, int64_t*) { return EINVAL; }
static void DeliverPendingSignals() {}
static bool InterruptibleSleepObserved(uint32_t milliseconds, void (*observe)(void*), void* context,
                                       int* error = nullptr) {
  if (error != nullptr) *error = 0;
  const size_t index = waits.size();
  if (index > 10) { std::fputs("unbounded sleep in clock fixture\n", stderr); std::abort(); }
  waits.push_back(milliseconds);
  const Action action = index < actions.size() ? actions[index] :
      Action{static_cast<int64_t>(milliseconds) * 1000000, 0, 0, 0, false};
  if (action.error != 0) {
    if (error != nullptr) *error = action.error;
    return false;
  }
  awake += action.awake_ns; suspended += action.suspend_ns;
  wall += action.awake_ns + action.suspend_ns + action.wall_step_ns;
  if (action.interrupted && observe) observe(context);
  awake += action.handler_ns; wall += action.handler_ns;
  errno = ERANGE;
  return action.interrupted;
}
static int InterruptibleBoottimeSleepObserved(int64_t deadline, void (*observe)(void*), void* context) {
  const int64_t left = deadline - gesher::BoottimeNanos();
  if (left <= 0) return 0;
  int error = 0;
  const bool interrupted = InterruptibleSleepObserved(static_cast<uint32_t>(std::min<int64_t>(
      left / 1000000 + (left % 1000000 != 0), 0x7ffffffe)), observe, context, &error);
  return error != 0 ? error : interrupted ? EINTR : 0;
}
@BIONIC_READER@
@BIONIC_DEADLINE@
@SLEEP_HELPERS@
@CLOCK_SLEEP@
}

// Evaluate AOSP's actual Windows/GESHER preprocessor paths after host includes.
#undef __linux__
#define UNLIKELY(x) (x)
#define LOG(level) std::cerr
namespace art {
@ART_CLOCKS@
}
using nsecs_t = int64_t;
enum { SYSTEM_TIME_REALTIME, SYSTEM_TIME_MONOTONIC, SYSTEM_TIME_PROCESS,
       SYSTEM_TIME_THREAD, SYSTEM_TIME_BOOTTIME };
#define arraysize(a) (sizeof(a) / sizeof((a)[0]))
#define LOG_ALWAYS_FATAL_IF(condition, message) do { if (condition) std::abort(); } while (false)
@UTILS_CLOCKS@
static int64_t nanoseconds_to_milliseconds(int64_t ns) { return ns / 1000000; }
namespace android { int64_t uptimeNanos(); int64_t elapsedRealtimeNano(); }
@SYSTEM_CLOCK@
