<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Text_cp_title}"
        Width="920" Height="960" MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{DynamicResource PanelFlowDirection}"
        FontFamily="Segoe UI, Tahoma, Arial"
        Background="#F5F6F8"
        AllowDrop="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#344054"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F2F4F7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1570EF"/>
            <Setter Property="BorderBrush" Value="#1570EF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#175CD3"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FFF1F3"/>
            <Setter Property="BorderBrush" Value="#FDA29B"/>
            <Setter Property="Foreground" Value="#B42318"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FEE4E2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- The default template mirrors its check mark in right-to-left layouts; the
             box follows the flow direction while the mark always reads left to right. -->
        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Name="FocusRing" CornerRadius="6" BorderThickness="2" Padding="1"
                                    BorderBrush="Transparent" Margin="-3" VerticalAlignment="Center">
                                <Border Name="Box" Width="16" Height="16" CornerRadius="4" BorderThickness="1"
                                        BorderBrush="#98A2B3" Background="#FFFFFF">
                                    <Path Name="Mark" FlowDirection="LeftToRight" Data="M 3,7.5 L 6,10.5 L 11.5,4"
                                          Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                                </Border>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#1570EF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#1570EF"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#1570EF"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="BorderBrush" Value="#84ADFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <ScrollViewer Name="PanelScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <!-- Bound the first measure too, before SizeChanged adjusts the viewport. -->
    <Grid Name="PanelLayout" Margin="24" MinHeight="740" Height="740">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- The cards above the applications: the splitter below resizes this row
                 (in pixels) and the applications row takes the rest. -->
            <RowDefinition Name="UpperCardsRow" Height="Auto" MinHeight="0"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="230"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Text_cp_title}" FontSize="20" FontWeight="Bold" Foreground="#101828"/>
                    <TextBlock Text="{DynamicResource Text_cp_subtitle}" FontSize="13" Foreground="#667085" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Name="DeviceIndicator" Width="12" Height="12" CornerRadius="6" Background="#98A2B3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Name="DeviceStatusText" Text="{DynamicResource Text_cp_device_stopped}" FontSize="13" FontWeight="SemiBold" Foreground="#344054" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Name="BtnToggleDevice" Content="{DynamicResource Text_cp_btn_start}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Name="UpperCardsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Name="UpperCards">
        <!-- Services Cards (Google Play & Aurora Store) -->
        <Grid Name="ServicesCards" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Google Play (microG) -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Text_cp_microg_title}" FontSize="15" FontWeight="Bold" Foreground="#101828"/>
                        <Border Grid.Column="1" Name="MicrogBadge" CornerRadius="12" Padding="8,2" Background="#F2F4F7">
                            <TextBlock Name="MicrogBadgeText" Text="{DynamicResource Text_cp_microg_disabled}" FontSize="11" FontWeight="SemiBold" Foreground="#475467"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="{DynamicResource Text_cp_microg_desc}" TextWrapping="Wrap" FontSize="12" Foreground="#667085" Margin="0,0,0,16"/>
                    <WrapPanel Orientation="Horizontal">
                        <Button Name="BtnEnableMicrog" Style="{StaticResource PrimaryButton}" Content="{DynamicResource Text_cp_btn_enable_microg}" Margin="0,0,8,8"/>
                        <Button Name="BtnGoogleLogin" Content="{DynamicResource Text_cp_btn_google_login}" Margin="0,0,8,8"/>
                        <Button Name="BtnMicrogSettings" Content="{DynamicResource Text_cp_btn_microg_settings}" Margin="0,0,8,8"/>
                        <Button Name="BtnManageAccounts" Content="{DynamicResource Text_cp_btn_manage_accounts}" Margin="0,0,8,8"/>
                        <Button Name="BtnDisableMicrog" Style="{StaticResource DangerButton}" Content="{DynamicResource Text_cp_btn_disable_microg}" Margin="0,0,8,8"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Card 2: App Store (Aurora Store) -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Text_cp_store_title}" FontSize="15" FontWeight="Bold" Foreground="#101828"/>
                        <Border Grid.Column="1" Name="StoreBadge" CornerRadius="12" Padding="8,2" Background="#F2F4F7">
                            <TextBlock Name="StoreBadgeText" Text="{DynamicResource Text_cp_store_not_installed}" FontSize="11" FontWeight="SemiBold" Foreground="#475467"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="{DynamicResource Text_cp_store_desc}" TextWrapping="Wrap" FontSize="12" Foreground="#667085" Margin="0,0,0,16"/>
                    <WrapPanel Orientation="Horizontal">
                        <Button Name="BtnInstallStore" Style="{StaticResource PrimaryButton}" Content="{DynamicResource Text_cp_btn_install_store}" Margin="0,0,8,8"/>
                        <Button Name="BtnOpenStore" Content="{DynamicResource Text_cp_btn_open_store}" Margin="0,0,8,8"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Runtime updates: network work never runs on the WPF dispatcher. -->
        <Border Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="{DynamicResource Text_cp_update_title}" FontSize="15" FontWeight="Bold" Foreground="#101828"/>
                    <TextBlock Name="UpdateVersionText" FontSize="12" Foreground="#667085" Margin="0,4,0,0"/>
                    <TextBlock Name="UpdateStatusText" TextWrapping="Wrap" FontSize="12" Foreground="#475467" Margin="0,5,0,0"/>
                    <CheckBox Name="AutomaticUpdateChecks" Content="{DynamicResource Text_cp_update_automatic}" ToolTip="{DynamicResource Text_cp_update_automatic_hint}" FontSize="12" Foreground="#475467" Margin="0,9,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <WrapPanel HorizontalAlignment="Right" MaxWidth="330">
                        <Button Name="BtnCheckUpdate" Content="{DynamicResource Text_cp_update_check}" Margin="0,0,8,6"/>
                        <Button Name="BtnInstallUpdate" Content="{DynamicResource Text_cp_update_download_install}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,6" Visibility="Collapsed"/>
                        <Button Name="BtnCancelUpdate" Content="{DynamicResource Text_cp_update_cancel}" Margin="0,0,0,6" Visibility="Collapsed"/>
                        <Button Name="BtnReopenPanel" Content="{DynamicResource Text_cp_update_reopen}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,6" Visibility="Collapsed"/>
                    </WrapPanel>
                    <Button Name="BtnUpdateNotes" Content="{DynamicResource Text_cp_update_notes}" HorizontalAlignment="Right" Padding="8,3" FontSize="12" BorderThickness="0" Foreground="#175CD3" Visibility="Collapsed"/>
                    <ProgressBar Name="UpdateProgress" Height="4" IsIndeterminate="True" Margin="0,8,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Camera -->
        <Border Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="10" Padding="18,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource Text_cp_camera_title}" FontSize="15" FontWeight="Bold" Foreground="#101828"/>
                <CheckBox Name="CameraImagePickerFallback" Content="{DynamicResource Text_cp_camera_image_picker}" ToolTip="{DynamicResource Text_cp_camera_image_picker_hint}" FontSize="12" Foreground="#475467" Margin="0,9,0,0"/>
            </StackPanel>
        </Border>
        </StackPanel>
        </ScrollViewer>

        <!-- Drag to give the applications more or less room; double-click restores. -->
        <GridSplitter Name="AppsSplitter" Grid.Row="2" Height="16" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                      Cursor="SizeNS" Focusable="True" KeyboardIncrement="24" FocusVisualStyle="{x:Null}"
                      AutomationProperties.Name="{DynamicResource Text_cp_apps_splitter_tip}"
                      ToolTip="{DynamicResource Text_cp_apps_splitter_tip}">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Name="Track" Background="Transparent">
                        <Border Name="Grip" Width="48" Height="4" CornerRadius="2" Background="#D0D5DD"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="#1570EF"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="#1570EF"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="#1570EF"/>
                            <Setter TargetName="Grip" Property="Height" Value="6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- Installed Applications Section -->
        <Border Name="ApplicationsSection" Grid.Row="3" Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="10" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Text_cp_apps_title}" FontSize="16" FontWeight="Bold" Foreground="#101828"/>
                        <TextBlock Text="{DynamicResource Text_cp_drag_drop_hint}" FontSize="12" Foreground="#667085" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Name="BtnProxyAll" Content="{DynamicResource Text_cp_btn_proxy_all}" ToolTip="{DynamicResource Text_cp_proxy_desc}" Margin="0,0,8,0"/>
                        <Button Name="BtnInstallApk" Style="{StaticResource PrimaryButton}" Content="{DynamicResource Text_cp_btn_install_apk}"/>
                    </StackPanel>
                </Grid>

                <!-- Filters the list by application name or package as the user types. -->
                <Grid Grid.Row="1" Margin="0,0,0,10" Width="280" HorizontalAlignment="Left">
                    <TextBox Name="AppSearch" Padding="30,6,28,6" FontSize="13" VerticalContentAlignment="Center"
                             BorderBrush="#D0D5DD" Foreground="#101828"
                             AutomationProperties.Name="{DynamicResource Text_cp_apps_search_placeholder}"/>
                    <Path Data="M 6,1 A 5,5 0 1 1 5.99,1 M 9.6,9.6 L 13,13" Stroke="#98A2B3" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14"
                          HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock Name="AppSearchPlaceholder" Text="{DynamicResource Text_cp_apps_search_placeholder}"
                               FontSize="13" Foreground="#98A2B3" VerticalAlignment="Center" Margin="32,0,30,0" IsHitTestVisible="False"/>
                    <Button Name="BtnClearAppSearch" Content="&#x2715;" ToolTip="{DynamicResource Text_cp_apps_search_clear}"
                            AutomationProperties.Name="{DynamicResource Text_cp_apps_search_clear}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Padding="6,2"
                            FontSize="11" BorderThickness="0" Background="Transparent" Foreground="#667085" Visibility="Collapsed"/>
                </Grid>

                <TextBlock Name="AppSearchNoMatches" Grid.Row="2" Text="{DynamicResource Text_cp_apps_search_no_matches}"
                           FontSize="13" Foreground="#667085" HorizontalAlignment="Center" Margin="0,24,0,0" Visibility="Collapsed"/>
                    <ItemsControl Name="AppsList" Grid.Row="2"
                                  ScrollViewer.CanContentScroll="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer Name="AppsViewport" CanContentScroll="True"
                                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter Name="ItemsPresenter"/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F2F4F7" BorderThickness="0,0,0,1" Padding="12,10" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Source="{Binding IconImage}" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                                            <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" Foreground="#101828"/>
                                            <TextBlock Text="{Binding Package}" FontSize="12" Foreground="#667085" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding ProxyText}" Visibility="{Binding ProxyVisibility}" FontSize="12" Foreground="#175CD3" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="{DynamicResource Text_cp_separate_windows}" ToolTip="{DynamicResource Text_cp_separate_windows_tip}" IsChecked="{Binding SeparateWindows, Mode=OneWay}" Tag="{Binding Package}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <Button Content="{DynamicResource Text_cp_btn_proxy}" ToolTip="{DynamicResource Text_cp_btn_proxy_tip}" Tag="{Binding Package}" Margin="0,0,8,0"/>
                                            <Button Content="{DynamicResource Text_cp_btn_launch}" Tag="{Binding Package}" Visibility="{Binding LaunchVisibility}" Margin="0,0,8,0"/>
                                            <Button Content="{DynamicResource Text_cp_btn_app_info}" Tag="{Binding Package}" Margin="0,0,8,0"/>
                                            <Button Style="{StaticResource DangerButton}" Content="{DynamicResource Text_cp_btn_uninstall}" Tag="{Binding Package}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
            </Grid>
        </Border>

        <!-- Status & Progress Footer -->
        <Border Grid.Row="4" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="StatusMessage" Grid.Column="0" Text="{DynamicResource Text_cp_status_ready}" FontSize="12" Foreground="#475467" VerticalAlignment="Center"/>
                <ProgressBar Name="ActivityBar" Grid.Column="1" Width="140" Height="6" IsIndeterminate="False" Visibility="Hidden" VerticalAlignment="Center"/>
                <Button Name="BtnOpenLogs" Grid.Column="2" Content="{DynamicResource Text_cp_btn_open_logs}" Padding="8,3" FontSize="12" BorderThickness="0" Foreground="#175CD3" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</Window>
