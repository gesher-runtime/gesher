+    unsigned i;
+    int result = EINVAL;
+    AcquireSRWLockExclusive(&gesher_cpu_clock_lock);
+    gesher_cpu_clock_reap();
+    for (i = 0; i < 256; ++i) {
+        FILETIME created, exited, kernel, user;
+        uint64_t ticks;
+        if (!gesher_cpu_clocks[i].handle || gesher_cpu_clocks[i].id != id) continue;
+        if (resolution) {
+            DWORD adjustment, increment;
+            BOOL disabled;
+            /* Match this provider's fixed thread CPU clock resolution.
+               FILETIME's 100-ns representation is not clock precision. */
+            if (!GetSystemTimeAdjustment(&adjustment, &increment, &disabled)) break;
