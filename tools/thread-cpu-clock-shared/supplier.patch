+int pthread_getcpuclockid(pthread_t thread, clockid_t *out)
+{
+    void *owned = NULL;
+    unsigned long long generation = 0;
+    unsigned i;
+    int result, saved_errno = errno;
+    if (!out) return EINVAL;
+    result = gesher_winpthread_dup_cpu_handle_v1(thread, &owned, &generation);
+    if (result) { errno = saved_errno; return result; }
+    AcquireSRWLockExclusive(&gesher_cpu_clock_lock);
+    gesher_cpu_clock_reap();
+    if (WaitForSingleObject(owned, 0) != WAIT_TIMEOUT) {
+        result = ESRCH;
+        goto done;
+    }
+    for (i = 0; i < 256; ++i) {
+        if (gesher_cpu_clocks[i].handle && gesher_cpu_clocks[i].generation == generation) {
+            *out = gesher_cpu_clocks[i].id;
+            result = 0;
+            goto done;
+        }
+    }
+    result = EAGAIN;
+    if (gesher_cpu_clock_next >= INT_MIN) {
+        for (i = 0; i < 256; ++i) {
+            if (!gesher_cpu_clocks[i].handle) {
+                gesher_cpu_clocks[i] = (gesher_cpu_clock_slot){owned, generation, (clockid_t)gesher_cpu_clock_next};
+                gesher_cpu_clock_next -= 8;
