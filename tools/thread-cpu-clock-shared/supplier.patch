+/* N28 component: one shared winpthread DLL owns both pthread identities and
+   dynamic clock IDs. This is not enabled in the Gesher product build yet. */
+typedef struct {
+    HANDLE handle;
+    unsigned long long generation;
+    clockid_t id;
+} gesher_cpu_clock_slot;
+
+static SRWLOCK gesher_cpu_clock_lock = SRWLOCK_INIT;
+static gesher_cpu_clock_slot gesher_cpu_clocks[256];
+/* Opaque host clock IDs keep Linux's per-thread/SCHED low bits, but do not
+   encode a reusable Windows TID. They never overlap fixed clocks or recycle. */
+#define GESHER_CPU_CLOCK_FIRST (-1073741818)
+static int64_t gesher_cpu_clock_next = GESHER_CPU_CLOCK_FIRST;
+
+static void gesher_cpu_clock_reap(void)
+{
+    unsigned i;
+    for (i = 0; i < 256; ++i) {
+        gesher_cpu_clock_slot *slot = &gesher_cpu_clocks[i];
+        if (slot->handle && WaitForSingleObject(slot->handle, 0) == WAIT_OBJECT_0) {
+            CloseHandle(slot->handle);
+            *slot = (gesher_cpu_clock_slot){0};
+        }
+    }
+}
