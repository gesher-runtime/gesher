+/* Versioned atomic capability acquisition. Invalid pthread_t values are
+   map keys only: never dereference a caller-supplied integer as a pointer.
+   cpu_handle cannot be closed/reused until push_pthread_mem takes this lock. */
+int
+gesher_winpthread_dup_cpu_handle_v1 (pthread_t thread, void **owned_handle,
+                                     unsigned long long *generation)
+{
+  _pthread_v *record;
+  HANDLE duplicate = NULL;
+  int result = ESRCH;
+  if (owned_handle == NULL || generation == NULL)
+    return EINVAL;
+  pthread_mutex_lock (&mtx_pthr_locked);
+  record = __pthread_get_pointer (thread);
+  if (record != NULL && record->cpu_handle != NULL
+      && record->cpu_generation != 0
+      && WaitForSingleObject (record->cpu_handle, 0) == WAIT_TIMEOUT)
+    {
+      if (DuplicateHandle (GetCurrentProcess (), record->cpu_handle,
+                           GetCurrentProcess (), &duplicate,
+                           THREAD_QUERY_LIMITED_INFORMATION | SYNCHRONIZE,
+                           FALSE, 0))
+        {
+          *owned_handle = duplicate;
+          *generation = record->cpu_generation;
+          result = 0;
+        }
+      else
+        result = EAGAIN;
+    }
+  pthread_mutex_unlock (&mtx_pthr_locked);
+  return result;
 }
 
