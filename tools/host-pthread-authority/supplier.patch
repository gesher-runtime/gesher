+/* Provider-owned clock identities: never recycle an issued ID. */
+typedef struct { HANDLE handle; unsigned long long generation; clockid_t id; } cpu_clock_slot;
+static SRWLOCK cpu_clock_lock = SRWLOCK_INIT;
+static cpu_clock_slot cpu_clock_slots[256];
+static int64_t cpu_clock_next = -1073741824;
+
+static void cpu_clock_reap(void)
+{
+    unsigned i;
+    for (i = 0; i < 256; ++i)
+        if (cpu_clock_slots[i].handle && WaitForSingleObject(cpu_clock_slots[i].handle, 0) == WAIT_OBJECT_0) {
+            CloseHandle(cpu_clock_slots[i].handle);
+            cpu_clock_slots[i] = (cpu_clock_slot){0};
+        }
+}
+
+int pthread_getcpuclockid(pthread_t thread, clockid_t *out)
+{
+    void *owned = NULL;
+    unsigned long long generation = 0;
+    unsigned i;
+    int result;
+    if (!out) return EINVAL;
+    (void)pthread_self();
+    result = gesher_winpthread_dup_cpu_handle_v1(thread, &owned, &generation);
+    if (result) return result;
+    AcquireSRWLockExclusive(&cpu_clock_lock);
+    if (WaitForSingleObject(owned, 0) != WAIT_TIMEOUT) {
+        CloseHandle(owned); cpu_clock_reap(); result = ESRCH; goto done;
+    }
+    for (i = 0; i < 256; ++i)
+        if (cpu_clock_slots[i].handle && cpu_clock_slots[i].generation == generation) {
+            CloseHandle(owned); *out = cpu_clock_slots[i].id; result = 0; goto done;
+        }
+    cpu_clock_reap();
+    if (WaitForSingleObject(owned, 0) != WAIT_TIMEOUT) {
+        CloseHandle(owned); result = ESRCH; goto done;
+    }
+    if (cpu_clock_next >= INT_MIN)
+        for (i = 0; i < 256; ++i)
+            if (!cpu_clock_slots[i].handle) {
+                cpu_clock_slots[i] = (cpu_clock_slot){owned, generation, (clockid_t)cpu_clock_next--};
+                *out = cpu_clock_slots[i].id; result = 0; goto done;
+            }
+    CloseHandle(owned); result = EAGAIN;
+done:
+    ReleaseSRWLockExclusive(&cpu_clock_lock);
+    return result;
+}
+
+static int cpu_clock_read(clockid_t id, struct _timespec64 *out, int resolution)
+{
+    unsigned i;
+    int result = EINVAL;
+    AcquireSRWLockExclusive(&cpu_clock_lock);
+    cpu_clock_reap();
+    for (i = 0; i < 256; ++i) {
+        FILETIME created, exited, kernel, user;
+        uint64_t ticks;
+        if (!cpu_clock_slots[i].handle || cpu_clock_slots[i].id != id) continue;
+        if (resolution) {
+            if (out) { out->tv_sec = 0; out->tv_nsec = 100; }
+            result = 0; break;
+        }
+        if (!out) { result = EFAULT; break; }
+        if (!GetThreadTimes(cpu_clock_slots[i].handle, &created, &exited, &kernel, &user)) break;
+        ticks = ((uint64_t)kernel.dwHighDateTime << 32) | kernel.dwLowDateTime;
+        ticks += ((uint64_t)user.dwHighDateTime << 32) | user.dwLowDateTime;
+        out->tv_sec = ticks / POW10_7; out->tv_nsec = (long)((ticks % POW10_7) * 100);
+        result = 0; break;
+    }
+    ReleaseSRWLockExclusive(&cpu_clock_lock);
+    return lc_set_errno(result);
 }
 
