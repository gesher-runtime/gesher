+static void cpu_clock_reap(void)
+{
+    unsigned i;
+    for (i = 0; i < 256; ++i)
+        if (cpu_clock_slots[i].handle && WaitForSingleObject(cpu_clock_slots[i].handle, 0) == WAIT_OBJECT_0) {
+            CloseHandle(cpu_clock_slots[i].handle);
+            cpu_clock_slots[i] = (cpu_clock_slot){0};
