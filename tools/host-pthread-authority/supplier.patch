+        if (!cpu_clock_slots[i].handle) continue;
+        SetLastError(ERROR_SUCCESS);
+        if (compare(cpu_clock_slots[i].handle, owned)) {
+            CloseHandle(owned); *out = cpu_clock_slots[i].id; result = 0; goto done;
+        }
+        if (GetLastError() != ERROR_NOT_SAME_OBJECT) {
+            CloseHandle(owned); result = EAGAIN; goto done;
+        }
