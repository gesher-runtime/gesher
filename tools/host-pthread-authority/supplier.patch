+/* Provider-owned clock identities: never recycle an issued ID. */
+typedef struct { HANDLE handle; unsigned long long generation; clockid_t id; } cpu_clock_slot;
+static SRWLOCK cpu_clock_lock = SRWLOCK_INIT;
+static cpu_clock_slot cpu_clock_slots[256];
+static int64_t cpu_clock_next = -1073741824;
