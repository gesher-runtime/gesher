+/* Caller holds the recursive thread registry. This checks the validated
+   record's existing native object, never attaches the calling thread and never
+   creates a duplicate handle. A numeric TID match alone is insufficient: an old
+   signaled thread object can retain a TID which Windows later reuses. */
+static int
+is_current_native_thread_locked (_pthread_v *target, pthread_t id)
+{
+  DWORD current=GetCurrentThreadId ();
+  if (!target || __pthread_get_pointer(id)!=target || target->x!=id ||
+      target->tid!=current || !TEST_HANDLE(target->h))
+    return 0;
+  HANDLE native=target->h;
+  DWORD actual=GetThreadId (native);
+  return actual!=0 && actual==current &&
+      WaitForSingleObject(native,0)==WAIT_TIMEOUT;
+}
