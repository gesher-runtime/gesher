+/* No environment or runtime hook exists in the production supplier. */
+int
+gesher_winpthread_cpu_test_control_v1 (unsigned int action, unsigned long long value)
+{
+  int result = EINVAL;
+  pthread_mutex_lock (&mtx_pthr_locked);
+  if (action == 1 && value <= 1)
+    {
+      cpu_test_duplicate_failure = (int) value;
+      result = 0;
+    }
+  else if (action == 2 && value == 0)
+    {
+      cpu_generation_next = 0; /* irreversible exhaustion */
+      result = 0;
+    }
+  else if (action == 3 && value <= 1)
+    {
+      cpu_test_tls_clear_failure = (int) value;
+      result = 0;
+    }
+  pthread_mutex_unlock (&mtx_pthr_locked);
+  return result;
+}
