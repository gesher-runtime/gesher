++  using namespace gesher::stdio;
++  if (registry == nullptr) return true;
++  if (!registry->mutex.try_lock()) return false;
++  g_stdio_fork_thread = GetCurrentThreadId();
++  return true;
++}
++void StdioUnlock(void*) {
++  using namespace gesher::stdio;
++  if (registry != nullptr) registry->mutex.unlock();
