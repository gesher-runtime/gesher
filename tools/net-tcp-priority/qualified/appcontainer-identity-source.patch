+  const ULONGLONG deadline = GetTickCount64() + 5000;
+  const std::wstring name = PipeName();
+  if (name.empty()) return false;
+  HANDLE pipe = ConnectPipe(name);
+  if (pipe == INVALID_HANDLE_VALUE) return false;
+  struct OwnedPipe {
+    HANDLE handle;
+    ~OwnedPipe() { CloseHandle(handle); }
