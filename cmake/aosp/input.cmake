# Input (docs/input.md, roadmap phase 3): libinput's event and transport
# classes (frameworks/native/libs/input), libandroid_runtime's input natives,
# and Gesher's translation of a Win32 window's messages into Android input
# events published on an InputChannel (compat/input).
#
# Included after graphics.cmake: the natives use hwui's headers (FrameInfo,
# FrameMetricsObserver, AMatrix) and the window (compat/hwui/window).

set(_native "${AOSP_DIR}/frameworks/native")
set(_input "${_native}/libs/input")
set(_fwbase "${AOSP_DIR}/frameworks/base")
set(_cin "${CMAKE_SOURCE_DIR}/compat/input")
set(_gen_input "${CMAKE_BINARY_DIR}/gen/input")

# --- libinput's aconfig flags (com.android.input.flags-aconfig-cc) -------------
add_custom_command(
  OUTPUT "${_gen_input}/aconfig/com_android_input_flags.h"
  COMMAND ${CMAKE_COMMAND} -E make_directory "${_gen_input}/aconfig"
  COMMAND ${Python3_EXECUTABLE} "${CMAKE_SOURCE_DIR}/tools/gen/aconfig_header.py"
          "${_input}/input_flags.aconfig" "${CMAKE_SOURCE_DIR}/config/aconfig/input.values"
          > "${_gen_input}/aconfig/com_android_input_flags.h"
  DEPENDS "${CMAKE_SOURCE_DIR}/tools/gen/aconfig_header.py" "${_input}/input_flags.aconfig"
          "${CMAKE_SOURCE_DIR}/config/aconfig/input.values"
  COMMENT "aconfig: com_android_input_flags.h")

# --- libinput's AIDL types (inputconstants, InputChannelCore) --------------------
set(_input_aidl_srcs)
aidl_cpp(_input_aidl_srcs "${_input}"
  ${_input}/android/os/IInputConstants.aidl
  ${_input}/android/os/InputChannelCore.aidl
  ${_input}/android/os/InputConfig.aidl
  ${_input}/android/os/MotionEventFlag.aidl
  ${_input}/android/os/PointerCaptureMode.aidl
  ${_input}/android/os/PointerIconType.aidl)

# --- libinput (frameworks/native/libs/input: libinput, host) ----------------------
# The events (Input.cpp), the transport (InputChannel, InputPublisher,
# InputConsumer), devices and key maps (InputDevice, KeyCharacterMap,
# KeyLayoutMap, Keyboard, PropertyMap) and VelocityTracker. Left out: what
# needs Rust (the cxx bridge; InputVerifier is compat/input/libinput's, which
# accepts every stream), TensorFlow Lite (MotionPredictor) and the window
# flags (InputFlags). compat/input/libinput/include goes first: its
# input/Input.h includes the AIDL constants Input.h includes only under
# __linux__, and rust/cxx.h is the little of cxx InputVerifier.h uses.
add_library(android_input STATIC
  ${_input}/Input.cpp ${_input}/InputConsumer.cpp ${_input}/InputDevice.cpp
  ${_input}/InputEventLabels.cpp ${_input}/InputTransport.cpp ${_input}/KeyCharacterMap.cpp
  ${_input}/KeyLayoutMap.cpp ${_input}/Keyboard.cpp ${_input}/PrintTools.cpp
  ${_input}/PropertyMap.cpp ${_input}/VelocityTracker.cpp
  ${_cin}/libinput/InputVerifier.cc
  ${_input_aidl_srcs}
  "${_gen_input}/aconfig/com_android_input_flags.h")
target_include_directories(android_input BEFORE PUBLIC ${_cin}/libinput/include)
target_include_directories(android_input PUBLIC ${_native}/include "${_gen_input}/aconfig")
# Windows has no evdev: the labels of evdev's event types only (compat/input/libinput/evdev).
set_source_files_properties(${_input}/InputEventLabels.cpp PROPERTIES
  INCLUDE_DIRECTORIES ${_cin}/libinput/evdev)
target_link_libraries(android_input PUBLIC ui_types graphics_native_headers binder utils cutils
  log base)
target_compile_definitions(android_input PUBLIC ANDROID_UTILS_REF_BASE_DISABLE_IMPLICIT_CONSTRUCTION)
gesher_graphics_cxx(android_input)
# libinput's cflags are -Wall -Wextra -Werror; AOSP code is built here without -Werror.
target_compile_options(android_input PRIVATE -Wall -Wextra -Wno-unused-parameter -Wno-error
  "$<$<COMPILE_LANGUAGE:CXX>:SHELL:-include ${_cin}/libinput/chrono_literals.h>")

# --- The virtual keyboard's map, built in ------------------------------------------
# compat/input/keychars/Generic.kcm is frameworks/base/data/keyboards/Generic.kcm
# at android-16.0.0_r4, kept here so that aosp.lock's frameworks/base line (part
# of framework.yml's host-tools cache key) need not change.
file(READ "${_cin}/keychars/Generic.kcm" _generic_kcm)
file(WRITE "${_gen_input}/generic_kcm.cc.new"
  "// Generated by cmake/aosp/input.cmake from compat/input/keychars/Generic.kcm.\n"
  "extern \"C\" const char gesher_generic_kcm[];\n"
  "extern \"C\" const char gesher_generic_kcm[] = R\"gesherkcm(${_generic_kcm})gesherkcm\";\n")
configure_file("${_gen_input}/generic_kcm.cc.new" "${_gen_input}/generic_kcm.cc" COPYONLY)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_cin}/keychars/Generic.kcm")

# --- Gesher's input: Win32 window messages to Android events ---------------------
# translate.cc (the translation), connection.cc (an InputPublisher fed from a
# window's queue, the C API of gesher_input.h), win32.cc (the Windows calls),
# keymap.cc (Generic.kcm), ime.cc (the window's input method side: text,
# IMM32 compositions, the caret; docs/input.md "Text input", ADR 0039).
add_library(gesher_input STATIC
  ${_cin}/translate.cc ${_cin}/connection.cc ${_cin}/win32.cc ${_cin}/keymap.cc ${_cin}/ime.cc
  ${_cin}/touch_keyboard.cc
  "${_gen_input}/generic_kcm.cc")
target_include_directories(gesher_input PUBLIC ${_cin}/include ${_cin})
target_link_libraries(gesher_input PUBLIC android_input gesher_window user32 imm32)
gesher_graphics_cxx(gesher_input)
# -Werror for Gesher's code; what AOSP's headers trip under -Wextra is let through
# as in framework.cmake.
target_compile_options(gesher_input PRIVATE -Wall -Wextra -Werror -Wno-unused-parameter
  -Wno-deprecated-copy -Wno-deprecated-anon-enum-enum-conversion -Wno-non-virtual-dtor
  -Wno-inconsistent-missing-override)

# --- libandroid_runtime's input natives ---------------------------------------------
# core/jni's sources, copied into the build tree with System V JNI tables
# (compat/input/gen_jni_sources.py, as frameworks/base patch 0002 does for
# framework.cmake's sources), and compat/input/input_jni.cc, whose
# register_gesher_input libandroid_runtime's table calls.
set(_input_jni_files
  core/jni/android_view_InputChannel.cpp
  core/jni/android_view_InputEventReceiver.cpp
  core/jni/android_view_InputEventSender.cpp
  core/jni/android_view_KeyCharacterMap.cpp
  core/jni/android_view_KeyEvent.cpp
  core/jni/android_view_MotionEvent.cpp
  core/jni/android_view_VelocityTracker.cpp)
set(_input_jni_srcs)
set(_input_jni_inputs)
foreach(_f ${_input_jni_files})
  get_filename_component(_n "${_f}" NAME)
  list(APPEND _input_jni_srcs "${_gen_input}/jni/${_n}")
  list(APPEND _input_jni_inputs "${_fwbase}/${_f}")
endforeach()
add_custom_command(
  OUTPUT ${_input_jni_srcs}
  COMMAND ${Python3_EXECUTABLE} "${_cin}/gen_jni_sources.py" "${_gen_input}/jni" "${_fwbase}"
          ${_input_jni_files}
  DEPENDS "${_cin}/gen_jni_sources.py" "${CMAKE_SOURCE_DIR}/tools/jni-sysv-patch.py"
          ${_input_jni_inputs}
  COMMENT "System V copies of libandroid_runtime's input natives")

# core_jni_helpers.cpp: GetReferent (InputEventReceiver/Sender), which no
# source framework.cmake compiles needed before.
add_library(input_jni STATIC ${_input_jni_srcs} ${_cin}/input_jni.cc
  ${_fwbase}/core/jni/core_jni_helpers.cpp)
target_include_directories(input_jni PRIVATE
  ${_fwbase}/core/jni ${_fwbase}/core/jni/include ${CMAKE_SOURCE_DIR}/compat/framework/include
  ${_native}/libs/binderthreadstate/include
  # FrameInfo.h, FrameMetricsObserver.h; android/graphics/matrix.h (AMatrix).
  ${_fwbase}/libs/hwui ${_fwbase}/libs/hwui/apex/include)
target_link_libraries(input_jni PUBLIC gesher_input android_input hwui nativehelper androidfw
  binder utils cutils log base)
gesher_graphics_cxx(input_jni)
# Like libinput's, these sources lean on what Android's headers bring in:
# chrono literals, and utils/Trace.h's ATRACE_* (InputEventReceiver).
target_compile_options(input_jni PRIVATE -Wall -Wno-unused-parameter -Wno-error
  "$<$<COMPILE_LANGUAGE:CXX>:SHELL:-include ${_cin}/libinput/chrono_literals.h>"
  "$<$<COMPILE_LANGUAGE:CXX>:SHELL:-include utils/Trace.h>")

target_link_libraries(dalvikvm PRIVATE input_jni)

# The input probe (probes/input/input_probe.cc), run in CI on Windows
# (tests/windows/tracks/33-input.ps1).
add_executable(input_probe ${CMAKE_SOURCE_DIR}/probes/input/input_probe.cc
  ${CMAKE_SOURCE_DIR}/probes/input/touch_inject.cc)
target_link_libraries(input_probe PRIVATE gesher_input)
target_compile_options(input_probe PRIVATE -Wall -Wextra -Werror -Wno-unused-parameter
  -Wno-deprecated-copy -Wno-deprecated-anon-enum-enum-conversion -Wno-non-virtual-dtor
  -Wno-inconsistent-missing-override)
gesher_graphics_cxx(input_probe)
