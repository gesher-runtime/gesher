{
  "manifest_version": 3,
  "name": "Gesher HTTP Authentication",
  "version": "1.0.0",
  "key": "",
  "permissions": [
    "webRequest",
    "webRequestAuthProvider",
    "debugger"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "worker.js"
  }
}
