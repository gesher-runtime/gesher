<?xml version="1.0" encoding="utf-8"?>
<!-- Gesher Camera (hwsvc2 track, docs/devices.md, ADR 0051): the system camera app that
     MediaStore.ACTION_IMAGE_CAPTURE resolves to on the Gesher device when the PC has a
     camera. The device installs it at its start when Camera2 has cameras (and removes it
     when there are none, as a device without a camera has no camera app). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gesher.camera"
    android:versionCode="1"
    android:versionName="1.0">
    <uses-permission android:name="android.permission.CAMERA" />
    <application
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity
            android:name=".CaptureActivity"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.action.IMAGE_CAPTURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
