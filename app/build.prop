# System properties for gesher-app, as /system/build.prop gives them on a device.
# android-16.0.0_r4 is build BP4A.251205.006 (build/make core/build_id.mk). Enough for
# android.os.Build's static initializer and the framework's version checks.
ro.build.id=BP4A.251205.006
ro.build.display.id=BP4A.251205.006
