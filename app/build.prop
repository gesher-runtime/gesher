ro.build.tags=release-keys
# Gesher's own device identity (docs/device-identity.md). The fingerprint is
# $(BRAND)/$(PRODUCT)/$(DEVICE):$(VERSION.RELEASE)/$(ID)/$(VERSION.INCREMENTAL):$(TYPE)/$(TAGS)
# of the values in this file; tests/windows/tracks/43-exec2.ps1 checks that.
# ro.product.manufacturer and ro.product.model are not set here: they are the
# PC's own (SMBIOS), set when the property area is created
# (compat/posix/include/gesher/device_identity.h).
ro.build.flavor=gesher-user
ro.build.fingerprint=gesher/gesher/gesher:16/BP4A.251205.006/11252199:user/release-keys
ro.product.brand=gesher
ro.product.name=gesher
ro.product.device=gesher
ro.product.board=gesher
ro.product.cpu.abi=x86_64
ro.product.cpu.abilist=x86_64,arm64-v8a
ro.product.cpu.abilist64=x86_64,arm64-v8a
ro.product.cpu.abilist32=
ro.product.first_api_level=34
ro.product.locale=en-US
ro.hardware=gesher
ro.bootloader=gesher
ro.debuggable=0
ro.secure=1
ro.sf.lcd_density=420
# ro.opengles.version is not set here: the system server sets it at boot from the
# device the default EGL display runs on (ES 3.0 only on a hardware Direct3D 11
# device, ES 2.0 on WARP; PackageManagerService.glEsVersion, docs/system-features.md).
ro.dalvik.vm.native.bridge=0
persist.sys.locale=en-US
persist.sys.timezone=UTC
